{"id":1030904,"name":"格芮芙·审查Ⅳ","type":"trial","scenes":[{"id":1,"name":"格芮芙·审查Ⅳ","code_name":"","dialogue_ids":[1030904]}],"trial":{"trial_id":30904,"stage":"阶段4","unlock_time":"2025-05-27 14:00:00","diary1":"因体力不支而晕倒的格芮芙被送回管理局，不知沉睡了多久，她脸上的微笑逐渐消散，眉头紧蹙，仿佛深陷无尽的梦魇。","diary2":"你与格芮芙一同醒来，她的体力恢复得不错，眼中重拾光彩。她说，是你的力量帮她击败了恶龙。可你清楚，那场胜利属于她自己。\n　　真爱给予人勇气，今后无论前方有何阻碍，你都会与她并肩同行。若她仍心存不安，你便一遍遍，用行动践行自己的誓言。","evidence":[{"ID":260735,"Num":1}],"usable_items":[{"ID":260736,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":130904001,"next":null},{"step":2,"course":2,"dialogue_id":130904002,"next":null},{"step":3,"course":2,"dialogue_id":130904003,"next":null},{"step":4,"course":2,"dialogue_id":130904004,"next":null},{"step":5,"course":2,"dialogue_id":130904005,"next":null},{"step":6,"course":2,"dialogue_id":130904006,"next":null},{"step":7,"course":2,"dialogue_id":130904007,"next":null},{"step":8,"course":2,"dialogue_id":130904008,"next":null},{"step":9,"course":2,"dialogue_id":130904009,"next":null},{"step":10,"course":2,"dialogue_id":130904010,"next":null},{"step":11,"course":2,"dialogue_id":130904011,"next":null},{"step":12,"course":2,"dialogue_id":130904012,"next":null},{"step":13,"course":2,"dialogue_id":130904013,"next":null},{"step":14,"course":2,"dialogue_id":130904014,"next":null},{"step":15,"course":2,"dialogue_id":130904015,"next":null},{"step":16,"course":2,"dialogue_id":130904016,"next":null},{"step":17,"course":2,"dialogue_id":130904017,"next":null},{"step":18,"course":2,"dialogue_id":130904018,"next":null},{"step":19,"course":2,"dialogue_id":130904019,"next":null},{"step":20,"course":2,"dialogue_id":130904020,"next":null},{"step":21,"course":2,"dialogue_id":130904021,"next":null},{"step":22,"course":2,"dialogue_id":130904022,"next":null},{"step":23,"course":2,"dialogue_id":130904023,"next":null},{"step":24,"course":2,"dialogue_id":130904024,"next":null},{"step":25,"course":2,"dialogue_id