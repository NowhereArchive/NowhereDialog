{"id":1050801,"name":"蓝鹫·审查Ⅰ","type":"Interrogation","scenes":[{"id":1,"name":"蓝鹫·审查Ⅰ","code_name":"","dialogue_ids":[1050801]}],"trial":{"trial_id":50801,"stage":"阶段1","unlock_time":"2024-12-31 14:00:00","diary1":"你收到了来自砂海的一个大包裹，和一封来自老朋友的信。\n　　包裹里是特色艺术品，而信里，是老朋友的交易定金，关于一个偷渡者的情报。","diary2":"离开迪希尔重回砂海的蓝鹫似乎过得不错，她重拾商队旧业，依然有声有色。可这更加无法解释她为何要送情报给你了——\n　　商人不做亏本买卖，她想通过和你的交易，获得什么呢？你收下了这份定金，也做出了相应处置，但心中，却依旧残留疑问。","evidence":[{"ID":260673,"Num":1},{"ID":260675,"Num":1}],"usable_items":[{"ID":260674,"Num":1},{"ID":260676,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":150801001,"next":null},{"step":2,"course":2,"dialogue_id":150801002,"next":null},{"step":3,"course":2,"dialogue_id":150801003,"next":null},{"step":4,"course":2,"dialogue_id":150801004,"next":null},{"step":5,"course":2,"dialogue_id":150801005,"next":null},{"step":6,"course":2,"dialogue_id":150801006,"next":null},{"step":7,"course":2,"dialogue_id":150801007,"next":null},{"step":8,"course":2,"dialogue_id":150801008,"next":null},{"step":9,"course":2,"dialogue_id":150801009,"next":null},{"step":10,"course":2,"dialogue_id":150801010,"next":null},{"step":11,"course":2,"dialogue_id":150801011,"next":null},{"step":12,"course":2,"dialogue_id":150801012,"next":null},{"step":13,"course":2,"dialogue_id":150801013,"next":null},{"step":14,"course":2,"dialogue_id":150801014,"next":null},{"step":15,"course":2,"dialogue_id":150801015,"next":null},{"step":16,"course":2,"dialogue_id":150801016,"next":null},{"step":17,"course":2,"dialogue_id":150801017,"next":null},{"step":18,"course":2,"dialogue_id":150801018,"next":null},{"step":19,"course":2,"dialogue_id":150801019,"next":null},{"step":20,"course":2,"dialogue_id":150801020,"next":null},{"step":21,"course":2,"dialogue_id":150801021,"next":null},{"step":22,"course":2,"dialogue_id":150801022,"next":null},{"step":23,"course":2,"dialogue_id":150801023,"next":null},{"step":24,"course":2,"dialogue_id