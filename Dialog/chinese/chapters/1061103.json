{"id":1061103,"name":"伊蕾娅·审查Ⅲ","type":"trial","scenes":[{"id":1,"name":"伊蕾娅·审查Ⅲ","code_name":"","dialogue_ids":[1061103]}],"trial":{"trial_id":61103,"stage":"阶段3","unlock_time":"2026-01-15 14:00:00","diary1":"又一次失败让你清楚意识到，现在的努力方向出了差错，你必须重新梳理思路。也许伊蕾娅想要的，并不是一个超越她过去的“更好”结局吗？\n　　于是你选择顺从，按部就班过起日复一日的普通上班族生活，期待自己反其道而行之的做法，能激出伊蕾娅。","diary2":"出乎伊蕾娅的意料，你选择的破局法是对她认输，告诉她根本不存在什么更好的结局，她已经做到了最好。尽管她不愿承认，幻境的破碎却已经证实了你的策略正确。\n　　成功回到审查室，局势似乎已然分明。伊蕾娅的态度缓和，一切都在走向团圆收场——直到你用枷锁击破幻境，也击破这整个她为你编织的剧本。","evidence":[{"ID":260841,"Num":1}],"usable_items":[{"ID":260842,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":161103001,"next":null},{"step":2,"course":2,"dialogue_id":161103002,"next":null},{"step":3,"course":2,"dialogue_id":161103003,"next":null},{"step":4,"course":2,"dialogue_id":161103004,"next":null},{"step":5,"course":2,"dialogue_id":161103005,"next":null},{"step":6,"course":2,"dialogue_id":161103006,"next":null},{"step":7,"course":2,"dialogue_id":161103007,"next":null},{"step":8,"course":2,"dialogue_id":161103008,"next":null},{"step":9,"course":2,"dialogue_id":161103009,"next":null},{"step":10,"course":2,"dialogue_id":161103010,"next":null},{"step":11,"course":3,"dialogue_id":161103011,"next":[12]},{"step":12,"course":2,"dialogue_id":161103012,"next":null},{"step":13,"course":2,"dialogue_id":161103013,"next":null},{"step":14,"course":2,"dialogue_id":161103014,"next":null},{"step":15,"course":2,"dialogue_id":161103015,"next":null},{"step":16,"course":2,"dialogue_id":161103016,"next":null},{"step":17,"course":2,"dialogue_id":161103017,"next":null},{"step":18,"course":2,"dialogue_id":161103018,"next":null},{"step":19,"course":2,"dialogue_id":161103019,"next":null},{"step":20,"course":2,"dialogue_id":161103020,"next":null},{"step":21,"course":2,"dialogue_id":161103021,"next":null},{"step":22,"course":2,"dialogue_id":161103022,"next":null},{"step":23,"course":2,"dialogue_id":161103023,"next":null},{"step