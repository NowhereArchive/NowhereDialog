{"id":1010203,"name":"嗷呜·审查Ⅲ","type":"Interrogation","scenes":[{"id":1,"name":"嗷呜·审查Ⅲ","code_name":"","dialogue_ids":[1010203]}],"trial":{"trial_id":10203,"stage":"阶段3","unlock_time":"2023-04-11 14:00:00","diary1":"你开车载着男孩和嗷呜一路驶向主城区外的未知村落。两个年龄相仿的小孩在后座叽叽喳喳地吵闹着，聊得热火朝天。","diary2":"一路上嗷呜给贝格利分享了自己获得狮头力量的经过，家乡的文化以及给狮头点睛的习俗。\n　　贝格利对此很是羡慕，询问既然她的家乡这么好，为什么还要回到狄斯。嗷呜似乎被问住了，正值她迷惑之际，贝格利在路边发现了一朵故乡的小花。","evidence":[{"ID":260339,"Num":1}],"usable_items":[{"ID":260340,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":110203001,"next":null},{"step":2,"course":2,"dialogue_id":110203002,"next":null},{"step":3,"course":2,"dialogue_id":110203003,"next":null},{"step":4,"course":2,"dialogue_id":110203004,"next":null},{"step":5,"course":2,"dialogue_id":110203005,"next":null},{"step":6,"course":2,"dialogue_id":110203006,"next":null},{"step":7,"course":2,"dialogue_id":110203007,"next":null},{"step":8,"course":2,"dialogue_id":110203008,"next":null},{"step":9,"course":2,"dialogue_id":110203009,"next":null},{"step":10,"course":2,"dialogue_id":110203010,"next":null},{"step":11,"course":2,"dialogue_id":110203011,"next":null},{"step":12,"course":2,"dialogue_id":110203012,"next":null},{"step":13,"course":2,"dialogue_id":110203013,"next":null},{"step":14,"course":2,"dialogue_id":110203014,"next":null},{"step":15,"course":2,"dialogue_id":110203015,"next":null},{"step":16,"course":2,"dialogue_id":110203016,"next":null},{"step":17,"course":2,"dialogue_id":110203017,"next":null},{"step":18,"course":2,"dialogue_id":110203018,"next":null},{"step":19,"course":2,"dialogue_id":110203019,"next":null},{"step":20,"course":2,"dialogue_id":110203020,"next":null},{"step":21,"course":2,"dialogue_id":110203021,"next":null},{"step":22,"course":2,"dialogue_id":110203022,"next":null},{"step":23,"course":2,"dialogue_id":110203023,"next":null},{"step":24,"course":2,"dialogue_id":110203024,"next":null},{"step":25,"course":2,"dialogue_id"