{"id":6091,"chapter_id":6,"scene_id":610,"steps":[{"step":1,"speaker":"赫卡蒂","content":"这力量是……？","voice":["vo_cgplot_6091001"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":2,"content":"枷锁另一头传来强大的力量，你的手中迸发光芒，映照之处，紫色的锈蚀开始溶解扭曲，成为保护你们的力量。","style":3,"background":511,"log_type":1},{"step":3,"speaker":"海拉","content":"呜，虽然头还是很疼。但……不停扒拉我脑子的手好像消失了。","voice":["vo_cgplot_6091003"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":4,"speaker":"赫卡蒂","content":"枷锁发生了变化？局长，你能影响这些污染吗？","voice":["vo_cgplot_6091004"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":5,"options":["不是我，是卓娅"],"jump":[6],"style":6,"background":511,"log_type":1},{"step":6,"content":"从枷锁的另一头，传来了卓娅的意志。","style":2,"background":511,"log_type":1},{"step":7,"speaker":"海拉","content":"她还活着？","voice":["vo_cgplot_6091007"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"她还有意识吗？","voice":["vo_cgplot_6091008"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":9,"content":"你并不知道卓娅经历了什么，但一股力量传递到枷锁之上，你感受到了决心和战斗的意志。","style":3,"background":511,"log_type":1},{"step":10,"options":["卓娅还在战斗，我们也不能输"],"jump":[11],"style":6,"background":511,"log_type":1},{"step":11,"content":"无论黑环是什么，都必须在这里破坏它！","style":3,"background":511,"log_type":1}]}