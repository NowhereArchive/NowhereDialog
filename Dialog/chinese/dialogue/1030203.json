{"id":1030203,"chapter_id":1030203,"scene_id":1,"steps":[{"step":1,"content":"黑漆漆的房间里，星光透过窗户洒在地上。","style":3,"background":1053,"log_type":1,"src_id":130203001,"trial_step":1},{"step":2,"content":"两个孩子都没有睡着，桑蒂正喋喋不休地说着什么。","style":3,"background":1053,"log_type":1,"src_id":130203002,"trial_step":2},{"step":3,"speaker":"桑蒂","content":"说起来这个什么局长，也没你说得那么厉害嘛，感觉不太聪明，哈哈。","voice":["vo_trial_30203_1_1"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203003,"trial_step":3},{"step":4,"speaker":"桑蒂","content":"稍微说两句好话就，好吃好喝供着，我说什么都信，还允许咱俩住一个屋……","voice":["vo_trial_30203_1_2"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203004,"trial_step":4},{"step":5,"speaker":"桑蒂","content":"我说不跟你睡一个屋就睡不着都信，太好骗了哈哈哈哈。","voice":["vo_trial_30203_1_3"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203005,"trial_step":5},{"step":6,"speaker":"科希","content":"……","voice":["vo_trial_30203_1_4"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203006,"trial_step":6},{"step":7,"content":"与欢声笑语的桑蒂不同，黑暗中科希的脸色却不怎么好看。","style":3,"background":1053,"log_type":1,"src_id":130203007,"trial_step":7},{"step":8,"speaker":"科希","content":"我也很好骗，是么？","voice":["vo_trial_30203_1_5"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203008,"trial_step":8},{"step":9,"speaker":"桑蒂","content":"什么？你在说什么蠢话？我怎么可能……","voice":["vo_trial_30203_1_6"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203009,"trial_step":9},{"step":10,"speaker":"科希","content":"别转移话题，那些狂厄结晶到底怎么回事？","voice":["vo_trial_30203_1_7"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203010,"trial_step":10},{"step":11,"speaker":"桑蒂","content":"我说了嘛，是万灵会弄的，他们内部黑吃黑，被骗了。","voice":["vo_trial_30203_1_8"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203011,"trial_step":11},{"step":12,"speaker":"科希","content":"被谁骗了？你吗？用你最擅长的“对付大人的方法”吗？","voice":["vo_trial_30203_1_9"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203012,"trial_step":12},{"step":13,"speaker":"桑蒂","content":"科希！你怀疑我！","voice":["vo_trial_30203_1_10"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203013,"trial_step":13},{"step":14,"content":"桑蒂佯装愤怒，接着又装起了可怜。","style":3,"background":1053,"log_type":1,"src_id":130203014,"trial_step":14},{"step":15,"speaker":"桑蒂","content":"是不是那个局长对你说什么了？唔啊啊啊科希因为别的大人怀疑我啦我的心碎啦～！","voice":["vo_trial_30203_1_11"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203015,"trial_step":15},{"step":16,"content":"她假哭又憋笑地闹着，伸手要挠科希的痒痒，迎面却看到了冰冷的眼神。","style":3,"background":1053,"log_type":1,"src_id":130203016,"trial_step":16},{"step":17,"speaker":"科希","content":"我不关心他说什么。我只想知道，你，碰没碰那些东西。","female_content":"我不关心她说什么。我只想知道，你，碰没碰那些东西。","voice":["vo_trial_30203_1_12","vo_trial_30203_1_12f"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203017,"trial_step":17},{"step":18,"speaker":"科希","content":"流浪儿们碰没碰那些东西。","voice":["vo_trial_30203_1_13"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203018,"trial_step":18},{"step":19,"speaker":"科希","content":"回答我！","voice":["vo_trial_30203_1_14"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203019,"trial_step":19},{"step":20,"content":"科希隐在阴影中，桑蒂却敏锐地察觉到挚友的怒火。","style":3,"background":1053,"log_type":1,"src_id":130203020,"trial_step":20},{"step":21,"speaker":"桑蒂","content":"科希……科希，别生气……我就是好久没见你了，太高兴了，闹过头了。","voice":["vo_trial_30203_1_15"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203021,"trial_step":21},{"step":22,"speaker":"桑蒂","content":"我、我向你保证！那些坏大人搞的脏东西，我才不要碰，我们有你呢！你知道的，流浪儿永远在一起，我骗谁都不会骗你！","voice":["vo_trial_30203_1_16"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203022,"trial_step":22},{"step":23,"speaker":"科希","content":"……","voice":["vo_trial_30203_1_17"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203023,"trial_step":23},{"step":24,"content":"见科希没说话，桑蒂小心地伸手拉了拉科希。","style":3,"background":1053,"log_type":1,"src_id":130203024,"trial_step":24},{"step":25,"speaker":"桑蒂","content":"我知道你是因为担心流浪儿才着急，我们都好好的，我们没碰危险的东西，大家都没事。","voice":["vo_trial_30203_1_18"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203025,"trial_step":25},{"step":26,"speaker":"桑蒂","content":"所以……你别生气了好不好？看你生气，我好害怕……","voice":["vo_trial_30203_1_19"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203026,"trial_step":26},{"step":27,"speaker":"科希","content":"……我不生气。","voice":["vo_trial_30203_1_20"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203027,"trial_step":27},{"step":28,"speaker":"科希","content":"我只是……想确定你们没事。","voice":["vo_trial_30203_1_21"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203028,"trial_step":28},{"step":29,"content":"科希的声音软了下来，桑蒂听出来了，笑得很开心。拉着她的手晃着。","style":3,"background":1053,"log_type":1,"src_id":130203029,"trial_step":29},{"step":30,"speaker":"桑蒂","content":"嘿嘿，真的好久没见了。我们好像还没分开过这么久。从小到大，我跟你一直在一起。","voice":["vo_trial_30203_1_22"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203030,"trial_step":30},{"step":31,"speaker":"桑蒂","content":"你不在的这段时间真的好吓人，好像又回到了好久以前在柳生那儿混饭吃的日子。","voice":["vo_trial_30203_1_23"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203031,"trial_step":31},{"step":32,"speaker":"桑蒂","content":"那时候好可怜啊，你没有力量，我们也没有“守护神”可以帮忙。整天被那群人渣呼来喝去，就因为我们没有力量，因为孩子最弱小……","voice":["vo_trial_30203_1_24"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203032,"trial_step":32},{"step":33,"speaker":"桑蒂","content":"现在你回来了，一切都没事了。我们找机会逃出去吧！回去跟流浪儿们一起。","voice":["vo_trial_30203_1_25"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203033,"trial_step":33},{"step":34,"speaker":"桑蒂","content":"或者，我不欺负那个局长了，就当他是个好人。他会放我们走的对吧？","female_content":"或者，我不欺负那个局长了，就当她是个好人。她会放我们走的对吧？","voice":["vo_trial_30203_1_26","vo_trial_30203_1_26f"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203034,"trial_step":34},{"step":35,"speaker":"科希","content":"……他是一个好人。虽然蠢了点，但……是真心想帮我们。","female_content":"……她是一个好人。虽然蠢了点，但……是真心想帮我们。","voice":["vo_trial_30203_1_27","vo_trial_30203_1_27f"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203035,"trial_step":35},{"step":36,"speaker":"科希","content":"他现在也在到处打听狂厄结晶的事，他告诉我，有孩子被万灵会带走了。","female_content":"她现在也在到处打听狂厄结晶的事，她告诉我，有孩子被万灵会带走了。","voice":["vo_trial_30203_1_28","vo_trial_30203_1_28f"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203036,"trial_step":36},{"step":37,"speaker":"科希","content":"所以，桑蒂，告诉我实话。","voice":["vo_trial_30203_1_29"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203037,"trial_step":37},{"step":38,"speaker":"科希","content":"如果你从来没有碰过那些货，万灵会为什么要找你麻烦？","voice":["vo_trial_30203_1_30"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203038,"trial_step":38},{"step":39,"speaker":"科希","content":"他们为什么要带走我们的同伴？","voice":["vo_trial_30203_1_31"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203039,"trial_step":39},{"step":40,"speaker":"桑蒂","content":"唔……","voice":["vo_trial_30203_1_32"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203040,"trial_step":40},{"step":41,"speaker":"桑蒂","content":"我说了，你不能生气。","voice":["vo_trial_30203_1_33"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203041,"trial_step":41},{"step":42,"speaker":"科希","content":"你说，我不生气。","voice":["vo_trial_30203_1_34"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203042,"trial_step":42},{"step":43,"speaker":"桑蒂","content":"说实话……你被那什么局长抓走那会儿，我……动过心思。听说狂厄结晶也能把人，变成禁闭者……","voice":["vo_trial_30203_1_35"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203043,"trial_step":43},{"step":44,"speaker":"科希","content":"你！","voice":["vo_trial_30203_1_36"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203044,"trial_step":44},{"step":45,"speaker":"桑蒂","content":"唔啊啊别生气别生气！你不是不在吗！我就想变得像你一样保护大家。","voice":["vo_trial_30203_1_37"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203045,"trial_step":45},{"step":46,"speaker":"科希","content":"你们处理不了那种东西！禁闭者又不是想当就当的，更多的人直接就变成怪物了！死了！","voice":["vo_trial_30203_1_38"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203046,"trial_step":46},{"step":47,"speaker":"科希","content":"就算成了禁闭者也一样，我说不定哪天也会——！","voice":["vo_trial_30203_1_39"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203047,"trial_step":47},{"step":48,"speaker":"桑蒂","content":"不不不没有没有没有我没碰！我最后不还是没那个胆子吗，你最了解我了对不对！","voice":["vo_trial_30203_1_40"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203048,"trial_step":48},{"step":49,"speaker":"桑蒂","content":"我就是问了问，我只是问了万灵会的人一下，就被他们惦记上了，自己把货弄丢了就全怪我！","voice":["vo_trial_30203_1_41"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203049,"trial_step":49},{"step":50,"speaker":"桑蒂","content":"那些大人不都是这样！说我们是小偷是坏蛋，把坏事都甩到我们头上！你要相信我！","voice":["vo_trial_30203_1_42"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203050,"trial_step":50},{"step":51,"speaker":"科希","content":"你还有什么瞒着我的？","voice":["vo_trial_30203_1_43"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203051,"trial_step":51},{"step":52,"speaker":"桑蒂","content":"没有了没有了真的没有了。","voice":["vo_trial_30203_1_44"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203052,"trial_step":52},{"step":53,"speaker":"桑蒂","content":"大家不会有事的，他们都不知道结晶的事嘛。再说，那个局长不也来帮咱们了吗？","voice":["vo_trial_30203_1_45"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203053,"trial_step":53},{"step":54,"speaker":"桑蒂","content":"我明天就带他去万灵会那个据点，他会打垮那些坏家伙的。只要万灵会倒掉，流浪儿就真的安全了。","female_content":"我明天就带她去万灵会那个据点，她会打垮那些坏家伙的。只要万灵会倒掉，流浪儿就真的安全了。","voice":["vo_trial_30203_1_46","vo_trial_30203_1_46f"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203054,"trial_step":54},{"step":55,"speaker":"桑蒂","content":"没事的，科希，大家都没事的。有你保护我们呢。","voice":["vo_trial_30203_1_47"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203055,"trial_step":55},{"step":56,"speaker":"科希","content":"……啧，自己也学乖点，少惹点麻烦，我又不是随时随地都在。","voice":["vo_trial_30203_1_48"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203056,"trial_step":56},{"step":57,"speaker":"科希","content":"睡吧，明天我会跟你一起去的。","voice":["vo_trial_30203_1_49"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203057,"trial_step":57},{"step":58,"speaker":"桑蒂","content":"嗯！我就知道你放心不下，科希最好了！","voice":["vo_trial_30203_1_50"],"voice_bank":"vo_crache_trial","style":1,"background":1053,"log_type":1,"src_id":130203058,"trial_step":58},{"step":59,"content":"管理局的车内，科希趴在窗边一言不发看着风景。","style":3,"background":1018,"log_type":1,"src_id":130203059,"trial_step":59},{"step":60,"content":"与之相对的，桑蒂则一直说个没完。","style":3,"background":1018,"log_type":1,"src_id":130203060,"trial_step":60},{"step":61,"speaker":"桑蒂","content":"我说，局长，这次你可欠我一个人情。","voice":["vo_trial_30203_1_51"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203061,"trial_step":61},{"step":62,"content":"哦？为什么？","style":2,"background":1018,"log_type":1,"src_id":130203062,"trial_step":62},{"step":63,"speaker":"桑蒂","content":"别装蒜啊，是我告诉了你万灵会老巢的位置。抓到他们，找到那个什么狂厄结晶对你来说肯定是大功一件吧？","voice":["vo_trial_30203_1_53"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203063,"trial_step":63},{"step":64,"speaker":"桑蒂","content":"等拿到奖赏了，你可得分我点好处。","voice":["vo_trial_30203_1_54"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203064,"trial_step":64},{"step":65,"content":"桑蒂一边说着一边朝科希挤眉弄眼，似乎是希望科希帮帮腔。","style":3,"background":1018,"log_type":1,"src_id":130203065,"trial_step":65},{"step":66,"content":"那就得看你给我的情报属不属实了。","style":2,"background":1018,"log_type":1,"src_id":130203066,"trial_step":66},{"step":67,"speaker":"桑蒂","content":"怎么还怀疑我呢？你这人疑心病怎么这么重呢？你不相信我，难道还不相信科希吗？","voice":["vo_trial_30203_1_57"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203067,"trial_step":67},{"step":68,"content":"要是你连科希也骗了呢？","style":2,"background":1018,"log_type":1,"src_id":130203068,"trial_step":68},{"step":69,"speaker":"桑蒂","content":"科希，你看看！都这种时候了还挑拨离间。","voice":["vo_trial_30203_1_58"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203069,"trial_step":69},{"step":70,"content":"桑蒂大声嚷嚷着。科希此刻也偏过头来，神情有些不悦。","style":3,"background":1018,"log_type":1,"src_id":130203070,"trial_step":70},{"step":71,"content":"你叹了口气，转而问道：","style":3,"background":1018,"log_type":1,"src_id":130203071,"trial_step":71},{"step":72,"content":"其他流浪儿怎么样了？","style":2,"background":1018,"log_type":1,"src_id":130203072,"trial_step":72},{"step":73,"speaker":"桑蒂","content":"都跟你说了，去了秘密据点，谁都找不到的地方。","voice":["vo_trial_30203_1_59"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203073,"trial_step":73},{"step":74,"content":"谁都找不到……不会刚好也是你们存储赃物的地方吧？","style":2,"background":1018,"log_type":1,"src_id":130203074,"trial_step":74},{"step":75,"speaker":"桑蒂","content":"要你管。你是打算事情结束之后让执委会来秋后算账吗？果然大人没一个好东西！","voice":["vo_trial_30203_1_60"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203075,"trial_step":75},{"step":76,"content":"说着，桑蒂有些心虚地看向窗外。","style":3,"background":1018,"log_type":1,"src_id":130203076,"trial_step":76},{"step":77,"speaker":"桑蒂","content":"怎么回事，你们走错道了吧？","voice":["vo_trial_30203_1_61"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203077,"trial_step":77},{"step":78,"speaker":"司机","content":"OO路最近发生了暴力冲突，道路被破坏，走不了了。","voice":["vo_trial_30203_1_62"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203078,"trial_step":78},{"step":79,"speaker":"桑蒂","content":"……好吧。","voice":["vo_trial_30203_1_63"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203079,"trial_step":79},{"step":80,"speaker":"桑蒂","content":"总觉得你这家伙满肚子坏水，不会是打算做什么见不得人的事吧？","voice":["vo_trial_30203_1_64"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203080,"trial_step":80},{"step":81,"speaker":"桑蒂","content":"算了，我也不怕你。科希，要是这家伙真有什么坏心眼，你可得保护我。","voice":["vo_trial_30203_1_65"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203081,"trial_step":81},{"step":82,"speaker":"科希","content":"嗯。","voice":["vo_trial_30203_1_66"],"voice_bank":"vo_crache_trial","style":1,"background":1018,"log_type":1,"src_id":130203082,"trial_step":82},{"step":83,"speaker":"桑蒂","content":"他……他……","female_content":"她……她……","voice":["vo_trial_30203_1_67","vo_trial_30203_1_67f"],"voice_bank":"vo_crache_trial","style":1,"background":10000,"log_type":1,"src_id":130203083,"trial_step":83},{"step":84,"content":"即便已经来到了这里，桑蒂依旧在嘴硬。","style":3,"background":10000,"log_type":1,"src_id":130203084,"trial_step":84},{"step":85,"content":"既然我费尽心思找到了你们的秘密据点，你也应该知道意味着什么。","style":2,"background":10000,"log_type":1,"src_id":130203085,"trial_step":85},{"step":86,"content":"狂厄结晶就在里面，对吧？","style":2,"background":10000,"log_type":1,"src_id":130203086,"trial_step":86},{"step":87,"speaker":"桑蒂","content":"没……没有！","voice":["vo_trial_30203_1_68"],"voice_bank":"vo_crache_trial","style":1,"background":10000,"log_type":1,"src_id":130203087,"trial_step":87},{"step":88,"content":"面对桑蒂的矢口否认，你叹了口气。","style":3,"background":10000,"log_type":1,"src_id":130203088,"trial_step":88},{"step":89,"content":"我已经给过你机会了，桑蒂，给过你很多次机会。","style":2,"background":10000,"log_type":1,"src_id":130203089,"trial_step":89},{"step":90,"content":"不用你多说，行动人员们便已默契地走上前去，打开了厂房的铁门。","style":3,"background":10000,"log_type":1,"src_id":130203090,"trial_step":90},{"step":91,"content":"然而，进入厂房后你才发现，事态可能比你想象得更糟。","style":3,"background":1009,"log_type":1,"src_id":130203091,"trial_step":91},{"step":92,"content":"这里没有流浪儿，也没有狂厄结晶。","style":3,"background":1009,"log_type":1,"src_id":130203092,"trial_step":92},{"step":93,"content":"简陋的床铺和桌椅都已被掀翻，货架被推倒，可疑的血迹随处可见。","style":3,"background":1009,"log_type":1,"src_id":130203093,"trial_step":93},{"step":94,"speaker":"桑蒂","content":"怎……怎么会这样？！","voice":["vo_trial_30203_1_69"],"voice_bank":"vo_crache_trial","style":1,"background":1009,"log_type":1,"src_id":130203094,"trial_step":94},{"step":95,"content":"你最担心的事情还是发生了。","style":3,"background":1009,"log_type":1,"src_id":130203095,"trial_step":95},{"step":96,"content":"虽然万灵会在之前的行动中无论是情报还是反应速度都比你们慢了不止一筹，仅靠着庞大的数量对抗着调查。","style":3,"background":1009,"log_type":1,"src_id":130203096,"trial_step":96},{"step":97,"content":"但偏偏在这件最重要的事上，他们快了你一步，","style":3,"background":1009,"log_type":1,"src_id":130203097,"trial_step":97},{"step":98,"speaker":"行动人员","content":"局长，我们调取了执委会那边的监控，万灵会在六个小时前来过这里。","voice":["vo_trial_30203_1_70"],"voice_bank":"vo_crache_trial","style":1,"background":1009,"log_type":1,"src_id":130203098,"trial_step":98},{"step":99,"speaker":"行动人员","content":"他们劫走了这里的狂厄结晶，还有……孩子们。","voice":["vo_trial_30203_1_71"],"voice_bank":"vo_crache_trial","style":1,"background":1009,"log_type":1,"src_id":130203099,"trial_step":99},{"step":100,"content":"为什么？！","style":2,"background":1009,"log_type":1,"src_id":130203100,"trial_step":100},{"step":101,"speaker":"行动人员","content":"可能是出于报复，也有可能是……他们想把狂厄结晶用在孩子们身上……毕竟失去理智的怪物同样也有战斗力。","voice":["vo_trial_30203_1_73"],"voice_bank":"vo_crache_trial","style":1,"background":1009,"log_type":1,"src_id":130203101,"trial_step":101},{"step":102,"content":"持续追查万灵会的动向，一有消息立刻告诉我。另外，通知行动部门全体人员结束休假，我需要他们随时待命。","style":2,"background":1009,"log_type":1,"src_id":130203102,"trial_step":102},{"step":103,"content":"事情滑向了最糟糕的场面，你揉了揉眉心，忽然想到了什么，转向桑蒂。","style":3,"background":1009,"log_type":1,"src_id":130203103,"trial_step":103},{"step":104,"content":"桑蒂……你知道……","style":2,"background":1009,"log_type":1,"src_id":130203104,"trial_step":104},{"step":105,"content":"你暂时没有心思追究桑蒂的责任，只想从她那里获取任何可能有效的情报。","style":3,"background":1009,"log_type":1,"src_id":130203105,"trial_step":105},{"step":106,"content":"然而她却犹如惊弓之鸟，面对你的提问逃也似的奔向科希。","style":3,"background":1009,"log_type":1,"src_id":130203106,"trial_step":106},{"step":107,"speaker":"桑蒂","content":"科希！救救我！","voice":["vo_trial_30203_1_74"],"voice_bank":"vo_crache_trial","style":1,"background":1009,"log_type":1,"src_id":130203107,"trial_step":107},{"step":108,"content":"她握住科希的手，祈求这位一直以来的挚友和保护神能再一次伸出援手，将她从这地狱般的场景中救出。","style":3,"background":1009,"log_type":1,"src_id":130203108,"trial_step":108},{"step":109,"content":"可是这一次，科希甩开了她的手。","style":3,"background":1009,"log_type":1,"src_id":130203109,"trial_step":109},{"step":110,"speaker":"桑蒂","content":"科……希……","voice":["vo_trial_30203_1_75"],"voice_bank":"vo_crache_trial","style":1,"background":1009,"log_type":1,"src_id":130203110,"trial_step":110},{"step":111,"content":"面前的人显得那么陌生。她的脸上露出了自己从未见过的表情，这种表情令她害怕。她忍不住哭了起来。","style":3,"background":1009,"log_type":1,"src_id":130203111,"trial_step":111},{"step":112,"content":"这种状况下，也问不出什么东西了。","style":3,"background":1009,"log_type":1,"src_id":130203112,"trial_step":112},{"step":113,"content":"就在这时，个人终端里传来了新的讯息。","style":3,"background":1009,"log_type":1,"src_id":130203113,"trial_step":113},{"step":114,"content":"找到位置了……通知行动部门，立即出动。","style":2,"background":1009,"log_type":1,"src_id":130203114,"trial_step":114},{"step":115,"content":"另外向执委会和FAC求援，尽可能多找些人来，我希望这次行动不出一点差错。","style":2,"background":1009,"log_type":1,"src_id":130203115,"trial_step":115},{"step":116,"content":"你没有任何犹豫，向门外走去。与此同时，科希一言不发地跟上了你。","style":3,"background":1009,"log_type":1,"src_id":130203116,"trial_step":116},{"step":117,"content":"她的状态令你颇为担心，你伸出手，却又收了回去。","style":3,"background":1009,"log_type":1,"src_id":130203117,"trial_step":117},{"step":118,"content":"不用担心，他们会没事的。","style":2,"background":1009,"log_type":1,"src_id":130203118,"trial_step":118},{"step":119,"content":"你绞尽脑汁，也没想出更多安慰她的话。只能再一次重复，仿佛也是在说服自己相信：","style":3,"background":1009,"log_type":1,"src_id":130203119,"trial_step":119},{"step":120,"content":"……他们一定会没事的。","style":2,"background":1009,"log_type":1,"src_id":130203120,"trial_step":120}]}