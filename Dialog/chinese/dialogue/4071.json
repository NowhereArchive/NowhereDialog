{"id":4071,"chapter_id":4,"scene_id":407,"steps":[{"step":1,"speaker":"赫罗","content":"…………呜……我在……哪儿？","voice":["vo_cgplot_4071001"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":2,"content":"她正被你背着，一步步向石坛所在的深处走去。","style":3,"background":402,"log_type":1},{"step":3,"speaker":"赫罗","content":"卓娅老大呢……","voice":["vo_cgplot_4071003"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":4,"options":["在来找你的路上"],"jump":[5],"style":6,"background":402,"log_type":1},{"step":5,"content":"你指指上方，贯穿整个地窟的震动还在继续，不断靠近着。这对你来说是倒计时，对赫罗却是希望与安慰。","style":3,"background":402,"log_type":1},{"step":6,"speaker":"玩家","content":"等你好起来，收拾了遗产，她会夸你的。","style":2,"background":402,"log_type":1},{"step":7,"speaker":"赫罗","content":"……呜…………好……","voice":["vo_cgplot_4071007"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":8,"speaker":"赫罗","content":"放我下来……我能走，我……重，你，都喘不上气了……","voice":["vo_cgplot_4071008"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":9,"content":"我背得动，你个子小……","options":["我背得动，你个子小……"],"jump":[10],"style":6,"background":402,"log_type":1},{"step":10,"speaker":"赫罗","content":"我——个——子——不——小————","voice":["vo_cgplot_4071010"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":11,"content":"环在你脖子上的小胳膊突然使劲，差点把你背摔过去。好在只是一瞬间，比起动了气，这更像是某种条件反射。","style":3,"background":402,"log_type":1},{"step":12,"content":"因为失血过多，她的身体有些凉，软软地趴在你背上，不时哼几声，像个生病的小兽。","style":3,"background":402,"log_type":1},{"step":13,"speaker":"赫罗","content":"……谢谢你……","voice":["vo_cgplot_4071013"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":14,"speaker":"海拉","content":"<size=30>心——机——鬼————人快醒了才来背——</size>","voice":["vo_cgplot_4071014"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":15,"content":"海拉撇了撇嘴，摆着嘴型，用几不可闻的声音朝你嘟囔着。她背了赫罗一路，刚刚换到你身上，确实累坏了。","style":3,"background":402,"log_type":1},{"step":16,"content":"梦魇提着那把重得离谱的巨斧，摇摇晃晃地跟在队伍最后。","style":3,"background":402,"log_type":1},{"step":17,"speaker":"赫卡蒂","content":"她醒了。可以问话了吗？","voice":["vo_cgplot_4071017"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":18,"content":"可以。赫罗的气息轻轻呼在你颈边，虚弱，和缓，毫无防备——这就是最好的时机。","style":3,"background":402,"log_type":1},{"step":19,"options":["这段时间，你都经历了什么？"],"jump":[20],"style":6,"background":402,"log_type":1},{"step":20,"speaker":"赫罗","content":"嗯……","voice":["vo_cgplot_4071020"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":21,"speaker":"赫罗","content":"年初，黑帮把我坑进了局子……呆了十几天，结果发现是禁闭者，又转送到MBCC，一呆……就是半年……","voice":["vo_cgplot_4071021"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":22,"options":["管理局暴动时，你在干什么？"],"jump":[23],"style":6,"background":402,"log_type":1},{"step":23,"speaker":"赫罗","content":"……不知道，我不知道发生了什么……门开了，我就一路跑一路打，逃了出来……我还有很重要的事要做。","voice":["vo_cgplot_4071023"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":24,"options":["我知道，你去了彼岸"],"jump":[25],"style":6,"background":402,"log_type":1},{"step":25,"speaker":"赫罗","content":"不……不是彼岸。我第一时间来了<color=#fb9259>这里</color>……","voice":["vo_cgplot_4071025"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":26,"speaker":"赫罗","content":"因为“<color=#fb9259>遗产</color>”就在这里……","voice":["vo_cgplot_4071026"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":27,"content":"！？","style":3,"background":402,"log_type":1},{"step":28,"speaker":"赫罗","content":"我被关着的时候，有天夜里醒了，听到有人在外面说话……","voice":["vo_cgplot_4071028"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":29,"speaker":"赫罗","content":"他说……锈河的<color=#fb9259>遗产</color>转移了，在南边沙漠的一个废坑里……继续生产力量……要尽快对付军团……","voice":["vo_cgplot_4071029"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":30,"speaker":"赫罗","content":"这很重要……我一逃出来，就来确认这件事……结果在这里，我看到……","voice":["vo_cgplot_4071030"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":32,"content":"我看到巨大的石坛，异色的结晶，还有一大堆武器。","voice":["vo_cgplot_4071032"],"voice_bank":"vo_cgplot_04","style":3,"background":405,"log_type":1},{"step":33,"content":"有人在制造怪异的能量。我躲在角落里，想看清到底是什么。","voice":["vo_cgplot_4071033"],"voice_bank":"vo_cgplot_04","style":3,"background":405,"log_type":1},{"step":34,"speaker":"研究员","content":"这里的条件太差了……没法制造出最佳品质的结晶……","voice":["vo_cgplot_4071034"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":35,"speaker":"研究员","content":"来不及，禁闭者也不够，这样下去，黑帮就算拿了武器，也赢不了军团啊！","voice":["vo_cgplot_4071035"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":36,"speaker":"？？","content":"那就使用遗产吧。","voice":["vo_cgplot_4071036"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":37,"speaker":"？？","content":"客户希望得到力量，希望战胜军团……我们就该帮他实现。","voice":["vo_cgplot_4071037"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":38,"speaker":"？？","content":"<color=#fb9259>遗产</color>就是为回应愿望而存在的。","voice":["vo_cgplot_4071038"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":39,"speaker":"研究员","content":"你……难道想……","voice":["vo_cgplot_4071039"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":40,"speaker":"？？","content":"把库存都拿出来，邀请所有人，我们给他们准备了更强的力量，足以战胜军团的力量。","voice":["vo_cgplot_4071040"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":41,"speaker":"？？","content":"他们一定会很高兴的……","voice":["vo_cgplot_4071041"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":42,"speaker":"被实验者","content":"啊啊啊啊啊啊啊啊啊——！！！","voice":["vo_cgplot_4071042"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":43,"speaker":"赫罗","content":"唔——","voice":["vo_cgplot_4071043"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":44,"speaker":"研究员","content":"谁？！找出来，干掉！！","voice":["vo_cgplot_4071044"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":45,"speaker":"研究员","content":"这里绝不能被暴露！！","voice":["vo_cgplot_4071045"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":46,"content":"我看到了地狱般的景象，也必须把这些告诉团长。狂厄武器，那些黑衣人，还有遗产……","voice":["vo_cgplot_4071046"],"voice_bank":"vo_cgplot_04","style":3,"background":405,"log_type":1},{"step":47,"content":"我很久没怕过什么了，可那东西……那种力量……","voice":["vo_cgplot_4071047"],"voice_bank":"vo_cgplot_04","style":3,"background":405,"log_type":1},{"step":48,"content":"看到它后，我满脑子想的全是逃出去，一定要离开这里，把消息告诉团长。","voice":["vo_cgplot_4071048"],"voice_bank":"vo_cgplot_04","style":3,"background":405,"log_type":1},{"step":49,"content":"那种力量绝不能落到黑帮手中，不能让它威胁军团。","voice":["vo_cgplot_4071049"],"voice_bank":"vo_cgplot_04","style":3,"background":405,"log_type":1},{"step":50,"speaker":"赫罗","content":"站起来，赫罗……不能输…………","voice":["vo_cgplot_4071050"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":51,"speaker":"赫罗","content":"团长还在等我……军团还在……","voice":["vo_cgplot_4071051"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":52,"speaker":"赫罗","content":"一定要逃出去……一定……","voice":["vo_cgplot_4071052"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":54,"speaker":"？？","content":"……哪儿来的矮子？","voice":["vo_cgplot_4071054"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":55,"speaker":"？？","content":"……喂，还活着吗？","voice":["vo_cgplot_4071055"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":56,"speaker":"赫罗","content":"<size=30><color=#dde2ed>我……不是……矮子……</size></color>","voice":["vo_cgplot_4071056"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":57,"speaker":"？？","content":"我在找一个绿头发小赌棍，跟你差不多大的小鬼，疯疯癫癫要跑来报仇。你见过她吗？","voice":["vo_cgplot_4071057"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":58,"speaker":"赫罗","content":"<size=30><color=#dde2ed>我…不是小鬼……我……长大了……</size></color>","voice":["vo_cgplot_4071058"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":59,"speaker":"？？","content":"………………唉，小屁孩真是麻烦死了。","voice":["vo_cgplot_4071059"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":60,"content":"我感到黑暗包裹了我，像被托在空中，飘浮着游动。","voice":["vo_cgplot_4071060"],"voice_bank":"vo_cgplot_04","style":3,"background":403,"log_type":1},{"step":61,"speaker":"？？","content":"……到诊所前……撑着点，别死在我影子里头……","voice":["vo_cgplot_4071061"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":63,"content":"艾恩说过，赫罗被送到彼岸时，已经奄奄一息。至于救她的人是谁……也许彼岸知道答案。","style":3,"background":402,"log_type":1},{"step":64,"options":["你差点死在这里","等等，你看到的遗产究竟是……"],"jump":[65,65],"style":6,"background":402,"log_type":1},{"step":65,"speaker":"赫罗","content":"那个力量……不能交给黑帮，他们要对军团不利……","voice":["vo_cgplot_4071065"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":66,"speaker":"赫罗","content":"……我一定要……亲手……","voice":["vo_cgplot_4071066"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":67,"speaker":"赫罗","content":"……","style":1,"background":402,"log_type":1},{"step":68,"speaker":"赫卡蒂","content":"她失去意识了。","voice":["vo_cgplot_4071068"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":69,"speaker":"海拉","content":"唔嗯……总结一下，有人想用“遗产”造狂厄武器对付军团，却被赫罗无意中偷听到遗产的情报。","voice":["vo_cgplot_4071069"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":70,"speaker":"海拉","content":"她趁百变怪炸管理局的空档，逃到地窟确认了遗产情况，也被打个半死。随后她被某人救走，送去彼岸抢救。","voice":["vo_cgplot_4071070"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":71,"speaker":"海拉","content":"结果这事儿被谣传成“MBCC逃犯带走引发狂厄的力量”，引来泰德这群疯子，最后真的在彼岸引爆狂厄。","voice":["vo_cgplot_4071071"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":72,"speaker":"海拉","content":"也就是说，根本没有嫌疑人R。从头到尾都是黑帮内斗惹的祸，却因为一条错误情报，把我们也卷了进来。","voice":["vo_cgplot_4071072"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":73,"speaker":"海拉","content":"…………*礼貌问候*治安局的废物东西！","voice":["vo_cgplot_4071073"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":74,"speaker":"赫卡蒂","content":"调查狂厄真相也是管理局的任务，而且，危机还没有解除。","voice":["vo_cgplot_4071074"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":75,"content":"赫卡蒂说得对。行动还没结束，任务还在继续。军团的威胁还在紧追不舍，有更多疑点需要揭开。","style":3,"background":402,"log_type":1},{"step":76,"content":"可在内心深处，某根一直抓着你的线彻底断掉了——","style":3,"background":402,"log_type":1},{"step":77,"content":"你深入险境、穷追不舍的人是赫罗，不是“她”。","style":3,"background":10000,"log_type":1},{"step":78,"speaker":"赫卡蒂","content":"……局长，提高警惕。敌人来了。","voice":["vo_cgplot_4071078"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":79,"content":"污染从下方的深坑涌出，渐渐包围你们。这个地窟并不打算给你后退的机会。","style":3,"background":402,"log_type":1}]}