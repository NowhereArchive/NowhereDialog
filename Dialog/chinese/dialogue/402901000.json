{"id":402901000,"chapter_id":70045,"scene_id":74501,"steps":[{"step":2,"speaker":"？？？","content":"——我得带你们看看这场独属于砂海的大冒险！","voice":["vo_event_402901000_02"],"voice_bank":"vo_event_29100","style":1,"background":10000,"log_type":1},{"step":3,"voice":["vo_event_402901000_04"],"voice_bank":"vo_event_29100","style":18,"background":2007,"log_type":1},{"step":4,"speaker":"？？？","content":"滚烫的沙地、晴空、毒辣辣的阳光！","voice":["vo_event_402901000_04"],"voice_bank":"vo_event_29100","style":1,"background":2007,"log_type":1},{"step":5,"speaker":"？？？","content":"换个新发型，穿身轻便的衣服，坐上车，再把油门踩爆——！","voice":["vo_event_402901000_05"],"voice_bank":"vo_event_29100","style":1,"background":2007,"log_type":1},{"step":6,"speaker":"？？？","content":"和亡命之徒打得你死我活？这可是冒险故事中最常见的展开！","voice":["vo_event_402901000_07"],"voice_bank":"vo_event_29100","style":1,"background":2007,"log_type":1},{"step":7,"speaker":"？？？","content":"当然了，还会有赏金猎人！他们都一样，又狡猾又豁达，笑嘻嘻地一打一个十环~","voice":["vo_event_402901000_08"],"voice_bank":"vo_event_29100","style":1,"background":2007,"log_type":1},{"step":8,"speaker":"？？？","content":"吹风、飙车、哈哈大笑，再把哈哈大笑时掉进嘴里的沙子吐出去……","voice":["vo_event_402901000_06"],"voice_bank":"vo_event_29100","style":1,"background":2007,"log_type":1},{"step":9,"speaker":"？？？","content":"爆炸、爆炸、爆炸，炸晕所有人的脑袋，让他们晕乎乎地看着主角帅气登场，大杀四方！","voice":["vo_event_402901000_09"],"voice_bank":"vo_event_29100","style":1,"background":2007,"log_type":1},{"step":10,"speaker":"？？？","content":"主角是谁？","voice":["vo_event_402901000_10"],"voice_bank":"vo_event_29100","style":1,"background":2007,"log_type":1},{"step":11,"speaker":"？？？","content":"……哈，这还用问吗？","voice":["vo_event_402901000_11"],"voice_bank":"vo_event_29100","style":1,"background":2007,"log_type":1},{"step":12,"speaker":"？？？","content":"当然是推翻砂盗，让赏金猎人心悦诚服，打败所有傻瓜的大英雄——","voice":["vo_event_402901000_12"],"voice_bank":"vo_event_29100","style":1,"background":2007,"log_type":1},{"step":13,"speaker":"海拉","content":"赏你个头啊？！先保住自己的脑袋别吹*了过来开车我没驾照啊啊啊啊——！！","voice":["vo_event_402901000_14"],"voice_bank":"vo_event_29100","style":1,"background":2007,"log_type":1},{"step":15,"content":"引擎轰鸣，子弹的破空声不断炸响。海拉紧紧扣住沙地车的方向盘，尖叫出声。","style":3,"background":4364,"log_type":1},{"step":16,"speaker":"海拉","content":"别说考了，我连驾驶座都没坐过几次！等下我们要是撞到了什么，就全*文明狄斯*完了——！","voice":["vo_event_402901000_17"],"voice_bank":"vo_event_29100","style":1,"background":4364,"log_type":1},{"step":17,"content":"海拉一旁的人影悠闲自得，轻轻弹起滑落的帽檐，笑眯眯看向后方穷追不舍的追兵。","style":3,"background":4364,"log_type":1},{"step":18,"speaker":"？？？","content":"别担心，都是小问题~","voice":["vo_event_402901000_19"],"voice_bank":"vo_event_29100","style":1,"background":4364,"log_type":1},{"step":19,"speaker":"？？？","content":"我第一次开车的时候也没经验。哦，还刚好和你差不多大呢？","voice":["vo_event_402901000_20"],"voice_bank":"vo_event_29100","style":1,"background":4364,"log_type":1},{"step":20,"speaker":"？？？","content":"这是方向盘，这是油门，都找到了对吧，就这么开！","voice":["vo_event_402901000_21"],"voice_bank":"vo_event_29100","style":1,"background":4364,"log_type":1},{"step":22,"speaker":"海拉","content":"——啊啊啊啊！翻车！要翻车了！！！！！","voice":["vo_event_402901000_23"],"voice_bank":"vo_event_29100","style":1,"background":4366,"log_type":1}]}