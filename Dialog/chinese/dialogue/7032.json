{"id":7032,"chapter_id":7,"scene_id":704,"steps":[{"step":1,"speaker":"海拉","content":"你们快看，那些人偶——！","voice":["vo_cgplot_7042001"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":2,"content":"被击败的人偶化作彩色的泡沫，溶解在空中，消散在欢乐里……但在泡沫里，你看到了它们原本的样子。","style":3,"background":704,"log_type":1},{"step":3,"speaker":"海拉","content":"所以这些家伙……全都是死役变的吗？","voice":["vo_cgplot_7042003"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":4,"speaker":"赫卡蒂","content":"果然都是幻觉，是禁闭者哈梅尔的能力。","voice":["vo_cgplot_7042004"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":5,"speaker":"选项","options":["这不仅是幻觉"],"jump":[6],"style":6,"background":704,"log_type":1},{"step":6,"content":"世界是真实的，死役也是真实的，看不到的污染和黑环也一定存在着。","style":3,"background":704,"log_type":1},{"step":7,"content":"但有一个更盛大的幻觉覆盖了一切，控制了一切，营造出一个明媚的假象。","style":3,"background":704,"log_type":1},{"step":8,"speaker":"玩偶们","content":"回去！回去！这是我们的游行，你不属于这里！","voice":["vo_cgplot_7042008"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":9,"content":"你们打败了那些玩偶，可还是被它们推搡到了游乐园的门口。游行队伍恢复了原样，欢呼着哈梅尔的名字，继续前行。","style":3,"background":702,"log_type":1},{"step":10,"speaker":"海拉","content":"啧，怎么还有不带我们玩的东西。要再试一次吗？","voice":["vo_cgplot_7042010"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":11,"speaker":"？？？","content":"回去吧，这不是你能来的地方。","voice":["vo_cgplot_7042012"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":12,"content":"一个声音响起，你转身看到一位老人正坐在乐园入口隐蔽的台阶上。","style":3,"background":702,"log_type":1},{"step":13,"speaker":"老人","content":"这个乐园不属于人类……不属于你。","voice":["vo_cgplot_7042013"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1}]}