{"id":7082,"chapter_id":7,"scene_id":709,"steps":[{"step":1,"content":"苦痛傀儡化作一阵白色的烟雾消失了。你们也再一次被放逐到乐园入口。","style":3,"background":702,"log_type":1},{"step":2,"content":"一切都回归到了原点。","style":3,"background":702,"log_type":1},{"step":3,"content":"你还握着赫卡蒂的手，但她已经不在这里了。","style":3,"background":702,"log_type":1},{"step":4,"speaker":"选项","options":["赫卡蒂……？"],"jump":[5],"style":6,"background":702,"log_type":1},{"step":5,"content":"无论怎么呼唤，她都不会回答。","style":3,"background":702,"log_type":1},{"step":8,"content":"枷锁找不到她的所在，那失神的眼睛已经看不到你的身影。","style":3,"background":702,"log_type":1},{"step":9,"content":"她不在了，只有老人的声音回荡在你耳边。","style":3,"background":702,"log_type":1},{"step":10,"speaker":"老人","content":"回去吧……","voice":["vo_cgplot_7092009"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":11,"speaker":"老人","content":"乐园不属于人类，停留只会迷失……","voice":["vo_cgplot_7092010"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":12,"speaker":"老人","content":"迷失在去见她的路上，而你永远见不到她……","voice":["vo_cgplot_7092011"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":13,"content":"他倚在石阶上，重复着嘉年华无尽的诅咒。","style":3,"background":702,"log_type":1}]}