le":3,"background":10000,"log_type":1,"src_id":240701087,"trial_step":87},{"step":118,"content":"与锈河接触的新城边陲突然出现了死役，治安局为阻止死役继续前进便选择与其进行接触。","style":3,"background":1045,"log_type":1,"src_id":240701088,"trial_step":88},{"step":119,"content":"虽然在反狂厄基站的加持下，治安局的装备对付零星的死役不成问题。但还是出了纰漏，多位治安官负伤，你及时出手才制服了死役。","style":3,"background":1045,"log_type":1,"src_id":240701089,"trial_step":89},{"step":120,"content":"老朋友道尔为了感谢你，特意塞给了你一张治安局食堂的餐券，让你想吃什么就点什么，一副“我们治安局的伙食不比MBCC差”的样子。","style":3,"background":1045,"log_type":1,"src_id":240701090,"trial_step":90},{"step":121,"content":"盛情难却，你只好让温蒂在治安局门口等MBCC的人来接，顺便给夜莺留了个言说有“应酬”。","style":3,"background":1045,"log_type":1,"src_id":240701091,"trial_step":91},{"step":122,"content":"虽说是什么都能点，你还是走向食堂窗口，只点了几样自己平时还算爱吃的东西。","style":3,"background":1045,"log_type":1,"src_id":240701092,"trial_step":92},{"step":123,"content":"在结账的时候，食堂阿姨看到餐券愣了愣，然后匆忙给你塞了几个刚烤好的蓝莓蛋挞，说是用这券的人还没有点过这么少的，多吃点，不然良心过意不去。","style":3,"background":1045,"log_type":1,"src_id":240701093,"trial_step":93},{"step":124,"content":"你看了一眼蛋挞，蓝莓用料很足，金黄色的酥皮也是恰到好处，应该会很好吃。你点头谢过后便端着盘子前往用餐区。","style":3,"background":1045,"log_type":1,"src_id":240701094,"trial_step":94},{"step":125,"content":"治安局食堂人满为患，但让人疑惑的是，靠近走廊一侧的餐桌却是空着的，桌上或者椅子上也没有放什么占座的东西，其他治安官经过也不会坐在这里。","style":3,"background":1045,"log_type":1,"src_id":240701095,"trial_step":95},{"step":126,"content":"你在桌上放下端了快有几分钟的餐盘，想着看看有没有别的座位时，却看到迎面走来的一位治安官将满满一餐盘的食物放在了面前的桌子上。","style":3,"background":1045,"log_type":1,"src_id":240701096,"trial_step":96},{"step":127,"speaker":"治安官","content":"请坐。","style":1,"background":1045,"log_type":1,"src_id":240701097,"trial_step":97},{"step":128,"content":"她用勺柄轻轻敲了敲你的餐盘，仿佛是餐桌的主人向你发出了邀请。","style":1,"background":1045,"log_type":1,"src_id":240701098,"trial_step":98},{"step":129,"content":"你仔细观察面前的治安官，是你今天从死役手里救下来的那位。","style":3,"background":1045,"log_type":1,"src_id":240701099,"trial_step":99},{"step":130,"speaker":"选项","options":["你伤好了？"],"style":6,"background":1045,"log_type":1,"src_id":240701100,"trial_step":100,"course":3,"choices":[{"text":"你伤好了？","goto":101}]},{"step":131,"content":"你看向少女的腹部，上面绑了厚厚一层绷带，但看起来并无大碍。","style":3,"background":1045,"log_type":1,"src_id":240701101,"trial_step":101},{"step":132,"speaker":"治安官","content":"这种程度对我来说……不算什么。我受过比这还严重得多的伤。","style":1,"background":1045,"log_type":1,"src_id":240701102,"trial_step":102},{"step":133,"speaker":"治安官","content":"但，今天还是谢谢你。","style":1,"background":1045,"log_type":1,"src_id":240701103,"trial_step":103},{"step":134,"content":"少女一边回答着你的问题，一边进行着规律的动作。","style":1,"background":1045,"log_type":1,"src_id":240701104,"trial_step":104},{"step":135,"content":"她用勺子舀了三茶匙白糖，一茶匙奶精，正着搅拌了30下后，又反着搅拌了30下。","style":3,"background":1045,"log_type":1,"src_id":240701105,"trial_step":105},{"step":136,"content":"擦拭过餐刀后，她快速地将牛角餐包切成六等份，又在其上均匀地涂满了黄油。","style":3,"background":1045,"log_type":1,"src_id":240701106,"trial_step":106},{"step":137,"content":"餐盘中的所有食物，她似乎都有一套自己的处理方法。","style":3,"background":1045,"log_type":1,"src_id":240701107,"trial_step":107},{"step":138,"speaker":"选项","options":["……这是什么仪式吗？"],"style":6,"background":1045,"log_type":1,"src_id":240701108,"trial_step":108,"course":3,"choices":[{"text":"……这是什么仪式吗？","goto":109}]},{"step":139,"speaker":"治安官","content":"这是人体摄入的必要营养，晚餐需要600卡路里。","style":1,"background":1045,"log_type":1,"src_id":240701109,"trial_step":109},{"step":140,"content":"她一边说着，一边将手边空的脱脂牛奶盒折叠压平，整齐地放在一侧。","style":3,"background":1045,"log_type":1,"src_id":240701110,"trial_step":110},{"step":141,"content":"但她作为一个伤员，应该再多摄入一点营养才行。你看着面前的咖啡面包，感觉相比正餐更像是减脂餐。","style":3,"background":1045,"log_type":1,"src_id":240701111,"trial_step":111},{"step":142,"speaker":"选项","options":["这些给你"],"style":6,"background":1045,"log_type":1,"src_id":240701112,"trial_step":112,"course":3,"choices":[{"text":"这些给你","goto":113}]},{"step":143,"content":"你将食堂阿姨赠送的蓝莓蛋挞推到她的面前。","style":3,"background":1045,"log_type":1,"src_id":240701113,"trial_step":113},{"step":144,"speaker":"玩家","content":"如果不够的话，这张餐券也给你，可以加点肉。","style":2,"background":1045,"log_type":1,"src_id":240701114,"trial_step":114},{"step":145,"speaker":"治安官","content":"……","style":1,"background":1045,"log_type":1,"src_id":240701115,"trial_step":115},{"step":146,"content":"眼前的治安官沉默着，摇了摇头。","style":3,"background":1045,"log_type":1,"src_id":240701116,"trial_step":116},{"step":147,"options":["你不喜欢？","应该不会变胖的"],"style":6,"background":1045,"log_type":1,"src_id":240701117,"trial_step":117,"course":3,"choices":[{"text":"你不喜欢？","goto":118},{"text":"应该不会变胖的","goto":null}]},{"step":148,"speaker":"治安官","content":"我不喜欢那种……掌控不了局势的感觉……","style":1,"background":1045,"log_type":1,"src_id":240701118,"trial_step":118},{"step":149,"speaker":"治安官","content":"工作也是一样的，我很喜欢缉捕那些罪犯，但……死役的话……","style":1,"background":1045,"log_type":1,"src_id":240701119,"trial_step":119},{"step":150,"speaker":"玩家","content":"处理不了？","style":2,"background":1045,"log_type":1,"src_id":240701120,"trial_step":120},{"step":151,"speaker":"治安官","content":"嗯。","style":1,"background":1045,"log_type":1,"src_id":240701121,"trial_step":121},{"step":152,"speaker":"治安官","content":"虽然在电视上看过几次，但真正要打的时候，我还是不知道怎么办才好。","style":1,"background":1045,"log_type":1,"src_id":240701122,"trial_step":122},{"step":153,"speaker":"治安官","content":"……要是我再厉害一点，再强一点就好了。","style":1,"background":1045,"log_type":1,"src_id":240701123,"trial_step":123},{"step":154,"content":"面前的治安官有些沮丧。","style":3,"background":1045,"log_type":1,"src_id":240701124,"trial_step":124},{"step":155,"speaker":"选项","options":["这和你的心态有关","放轻松"],"style":6,"background":1045,"log_type":1,"src_id":240701125,"trial_step":125,"course":3,"choices":[{"text":"这和你的心态有关","goto":126},{"text":"放轻松","goto":null}]},{"step":156,"speaker":"玩家","content":"人面对未知的危险，都会害怕，都会迷茫……我也一样。","style":2,"background":1045,"log_type":1,"src_id":240701126,"trial_step":126},{"step":157,"speaker":"玩家","content":"但身处我们这样位置的人，总是需要勇敢地去试一试的。","style":2,"background":1045,"log_type":1,"src_id":240701127,"trial_step":127},{"step":158,"speaker":"治安官","content":"那，要是试过，或者试过很多次都失败了呢？","style":1,"background":1045,"log_type":1,"src_id":240701128,"trial_step":128},{"step":159,"speaker":"选项","options":["还会有机会的"],"style":6,"background":1045,"log_type":1,"src_id":240701129,"trial_step":129,"course":3,"choices":[{"text":"还会有机会的","goto":130}]},{"step":160,"speaker":"治安官","content":"即使情况像今天这么危险，或者比今天还要危险？","style":1,"background":1045,"log_type":1,"src_id":240701130,"trial_step":130},{"step":161,"speaker":"玩家","content":"……","style":2,"background":1045,"log_type":1,"src_id":240701131,"trial_step":131},{"step":162,"content":"你给不出她答案。让她不要放弃？实力悬殊的情况下，和送死没有任何区别。","style":3,"background":1045,"log_type":1,"src_id":240701132,"trial_step":132},{"step":163,"speaker":"治安官","content":"这么让你为难的话，不如把那个“枷锁”给我就好了。这样我就……","style":1,"background":1045,"log_type":1,"src_id":240701133,"trial_step":133},{"step":164,"speaker":"玩家","content":"咳咳咳……","style":2,"background":1045,"log_type":1,"src_id":240701134,"trial_step":134},{"step":165,"content":"突如其来的“问题发言”让你差点呛到。在环顾四周发现没人看向这边后，你连忙比了个手势让她小点声。","style":3,"background":1045,"log_type":1,"src_id":240701135,"trial_step":135},{"step":166,"speaker":"玩家","content":"<size=35>枷锁的事别在这里讨论。再说了，枷锁对普通人也没用……这是不能碰的话题……</size>","style":2,"background":1045,"log_type":1,"src_id":240701136,"trial_step":136},{"step":167,"speaker":"治安官","content":"噗……我知道的。","style":1,"background":1045,"log_type":1,"src_id":240701137,"trial_step":137},{"step":168,"content":"她紧绷的脸上终于露出了一点笑容，是恶作剧成功的笑容。","style":3,"background":1045,"log_type":1,"src_id":240701138,"trial_step":138},{"step":169,"speaker":"治安官","content":"……那。","style":1,"background":1045,"log_type":1,"src_id":240701139,"trial_step":139},{"step":170,"speaker":"治安官","content":"以后的行动，你会来么？","style":1,"background":1045,"log_type":1,"src_id":240701140,"trial_step":140},{"step":171,"speaker":"玩家","content":"以后？","style":2,"background":1045,"log_type":1,"src_id":240701141,"trial_step":141},{"step":172,"speaker":"治安官","content":"治安局偶尔也会有关于禁闭者的行动。","style":1,"background":1045,"log_type":1,"src_id":240701142,"trial_step":142},{"step":173,"speaker":"玩家","content":"……","style":2,"background":1045,"log_type":1,"src_id":240701143,"trial_step":143},{"step":174,"speaker":"治安官","content":"你要是不来，我可是会去找你的。就当是……还你那身大衣的情吧。","style":1,"background":1045,"log_type":1,"src_id":240701144,"trial_step":144},{"step":175,"speaker":"选项","options":["……你这像是治安官说的话吗"],"style":6,"background":1045,"log_type":1,"src_id":240701145,"trial_step":145,"course":3,"choices":[{"text":"……你这像是治安官说的话吗","goto":146}]},{"step":176,"content":"夕阳的余晖透过病房的窗户，洒下一片温暖的金色光芒。柔和的光线斜斜地照在洁白的床单上，给原本冰冷的病房增添了一丝温馨的气息。","style":3,"background":2107,"log_type":1,"src_id":240701147,"trial_step":147},{"step":177,"content":"拉得细长的影子轻轻地叩了两下门后，轻轻地推开。","style":3,"background":2107,"log_type":1,"src_id":240701148,"trial_step":148},{"step":178,"content":"陪床的护士看清来人后，点了点头便离开了病房。","style":3,"background":2107,"log_type":1,"src_id":240701149,"trial_step":149},{"step":179,"content":"进入病房后，少女先检查了窗户上夹着的纸条，在发现没有人动过后，又继续打开送来的几样慰问品开始检查，查看是否有监听设备。","style":3,"background":2107,"log_type":1,"src_id":240701150,"trial_step":150},{"step":180,"content":"在确认无虞后，她才放松下来，将花瓶中有些枯萎的茉莉花收下，又放上新的。","style":3,"background":2107,"log_type":1,"src_id":240701151,"trial_step":151},{"step":181,"content":"少女看向花瓶旁有些褪色的全家福，上面记录着一家三口最开心的模样。","style":3,"background":2107,"log_type":1,"src_id":240701152,"trial_step":152},{"step":182,"content":"她将手伸到照片背面，拧了几圈后取下了支撑着相框的东西。","style":3,"background":2107,"log_type":1,"src_id":240701153,"trial_step":153},{"step":183,"content":"——那是一颗子弹，一颗手枪的子弹。","style":3,"background":2107,"log_type":1,"src_id":240701154,"trial_step":154},{"step":184,"speaker":"简","content":"每天我都会梦到同样的东西。梦见被谁推着走，推到悬崖边上……然后掉下去。","style":1,"background":2107,"log_type":1,"src_id":240701155,"trial_step":155},{"step":185,"speaker":"简","content":"我今天做完梦之后，吃了蓝莓蛋挞。","style":1,"background":2107,"log_type":1,"src_id":240701156,"trial_step":156},{"step":186,"speaker":"简","content":"它比我想象中的要甜很多，比你做过的任何一样食物都甜。","style":1,"background":2107,"log_type":1,"src_id":240701157,"trial_step":157},{"step":187,"speaker":"简","content":"但，很好吃。","style":1,"background":2107,"log_type":1,"src_id":240701158,"trial_step":158},{"step":188,"content":"她慢慢站起身来。","style":3,"background":2107,"log_type":1,"src_id":240701159,"trial_step":159},{"step":189,"speaker":"简","content":"……","style":1,"background":2107,"log_type":1,"src_id":240701160,"trial_step":160},{"step":190,"speaker":"简","content":"妈妈，我想再试一次。我现在是治安局的治安官，不是<color=#fb9259>幽灵</color>。","style":1,"background":2107,"log_type":1,"src_id":240701161,"trial_step":161},{"step":191,"speaker":"简","content":"给你们治病的钱，还有很多……但，我不想这样下去了……","style":1,"background":2107,"log_type":1,"src_id":240701162,"trial_step":162},{"step":192,"speaker":"简","content":"我遇到MBCC的局长了，他很厉害。","female_content":"我遇到MBCC的局长了，她很厉害。","style":1,"background":2107,"log_type":1,"src_id":240701163,"trial_step":163},{"step":193,"speaker":"简","content":"我要是能像他那样就好了……你们也不会变成这种模样。","female_content":"我要是能像她那样就好了……你们也不会变成这种模样。","style":1,"background":2107,"log_type":1,"src_id":240701164,"trial_step":164},{"step":194,"content":"结束了单方面的倾诉后，简走出病房，准备离开时，却看到陪床的护士拿着张纸条急匆匆地向自己走来。","style":3,"background":2107,"log_type":1,"src_id":240701165,"trial_step":165},{"step":195,"speaker":"护士","content":"简小姐……不好意思不好意思，刚刚有一位带着兜帽的先生过来，说是要把这个交给您，还好您没走！","style":1,"background":2107,"log_type":1,"src_id":240701166,"trial_step":166},{"step":196,"content":"简拿起纸条，看清上面的字后，先前手中紧紧地握着的那颗子弹便滑出她的手心。","style":3,"background":2107,"log_type":1,"src_id":240701167,"trial_step":167},{"step":197,"content":"叮零——","style":3,"background":2107,"log_type":1,"src_id":240701168,"trial_step":168},{"step":198,"content":"到底要逃到哪里才行呢？简不知道。","style":3,"background":2107,"log_type":1,"src_id":240701169,"trial_step":169},{"step":199,"content":"到底要怎么样才能不做噩梦呢？简不知道。","style":1,"background":2107,"log_type":1,"src_id":240701170,"trial_step":170},{"step":200,"content":"到底要怎么才能杀死那个恶魔呢？简不知道。","style":3,"background":2107,"log_type":1,"src_id":240701171,"trial_step":171},{"step":201,"content":"简只知道子弹掉到了地上，弹了几下后，滚到了墙边。","style":3,"background":2107,"log_type":1,"src_id":240701172,"trial_step":172},{"step":202,"speaker":"护士","content":"简小姐，简小姐……你这是怎么了？","style":1,"background":2107,"log_type":1,"src_id":240701173,"trial_step":173},{"step":203,"speaker":"简","content":"……没事。没事，我……很好。","style":1,"background":2107,"log_type":1,"src_id":240701174,"trial_step":174},{"step":204,"content":"亲爱的简：\n\n抱歉打扰你们母女见面的温馨时刻，虽然你从来没告诉过我医院的地址。\n过家家游戏开心吗？这一年你抓住了多少“罪犯”？\n对了，医药费是不是要花光了？给你爸爸找律师的钱是不是也快不够了？","style":14,"background":10000,"log_type":1,"src_id":240701175,"trial_step":175},{"step":205,"content":"时间差不多了，该回来咯。这次要干票大的。\n\n这次可不止3700万。老规矩，新城银行见。\n\n——科尔曼","style":14,"background":10000,"log_type":1,"src_id":240701176,"trial_step":176}]}