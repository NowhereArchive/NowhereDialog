_id":150403094,"trial_step":94},{"step":95,"speaker":"艾米潘","content":"啥？！这不是作弊吗？！","voice":["vo_trial_50403_1_95"],"voice_bank":"vo_etti_trial","style":1,"background":2016,"log_type":1,"src_id":150403095,"trial_step":95},{"step":96,"speaker":"爱缇","content":"这是命运，亲爱的~","voice":["vo_trial_50403_1_96"],"voice_bank":"vo_etti_trial","style":1,"background":2016,"log_type":1,"src_id":150403096,"trial_step":96},{"step":97,"speaker":"爱缇","content":"九十九！使用狂暴技能！","voice":["vo_trial_50403_1_97"],"voice_bank":"vo_etti_trial","style":1,"background":2016,"log_type":1,"src_id":150403097,"trial_step":97},{"step":98,"speaker":"爱缇","content":"然后……哼哼~海拉，你的偷盗技能可以开始使用了，去把线索弄过来~","voice":["vo_trial_50403_1_98"],"voice_bank":"vo_etti_trial","style":1,"background":2016,"log_type":1,"src_id":150403098,"trial_step":98},{"step":99,"content":"爱缇安排好了先后手技能，把你带来场中央，开始投掷骰子。","style":3,"background":2016,"log_type":1,"src_id":150403099,"trial_step":99},{"step":100,"content":"骰子轻飘飘地在地上滚了一圈，不偏不倚地停在了1上。","style":3,"background":2016,"log_type":1,"src_id":150403101,"trial_step":101},{"step":101,"speaker":"爱缇","content":"……","style":1,"background":2016,"log_type":1,"src_id":150403102,"trial_step":102},{"step":102,"speaker":"九十九","content":"……","style":1,"background":2016,"log_type":1,"src_id":150403103,"trial_step":103},{"step":103,"speaker":"艾米潘","content":"……这是，这是大失败啊？！","voice":["vo_trial_50403_1_104"],"voice_bank":"vo_etti_trial","style":1,"background":2016,"log_type":1,"src_id":150403104,"trial_step":104},{"step":104,"content":"<i>“这……这……呃……野蛮人九十九用力朝艾米潘发起攻击，可是艾米潘使出浑身解数，躲过了那柄巨剑！”</i>","style":2,"background":2016,"log_type":1,"src_id":150403105,"trial_step":105},{"step":105,"content":"<i>“并且，艾米潘利用巨剑反弹回来的力道，朝着冒险家小队的各位发起了攻击——她的真正身份是一位吟游诗人！”</i>","style":2,"background":2016,"log_type":1,"src_id":150403106,"trial_step":106},{"step":106,"content":"艾米潘拿出自己的弓箭，往前一跨扎了个马步，她挽起弓指向天空，大声喊道——","style":3,"background":2016,"log_type":1,"src_id":150403107,"trial_step":107},{"step":107,"speaker":"艾米潘","content":"这是你们逼我的！