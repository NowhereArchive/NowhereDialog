{"id":402401401,"chapter_id":21000104,"scene_id":402,"steps":[{"step":1,"speaker":"怪物","content":"<color=#dg1f1f><i>呃呃……呜呜呜……嗷……</color></i>","voice":["vo_event_402401401_1"],"voice_bank":"vo_event_24014","style":1,"background":2226,"log_type":1},{"step":2,"content":"你们在狭长的山谷中穿行，怪物在身后如影随形，凄厉的怪吼声从未停止过。","style":3,"background":2226,"log_type":1},{"step":3,"content":"沉重的脚步震颤着地面，碎石土块不断掉落，砸在你们身上。","style":3,"background":2226,"log_type":1},{"step":4,"speaker":"选项","options":["回头查看"],"jump":[5],"style":6,"background":2226,"log_type":1},{"step":5,"content":"你回过头，那怪物庞大的身躯夹在山谷当中翻滚逼近。犹如黑色的洪流，扯下山壁上突出的草木土石，淹没来时的每一寸土地，朝你们奔腾而来。","style":3,"background":2226,"log_type":1},{"step":6,"content":"在混沌无光的黑暗当中，唯独那红色的眼睛时隐时现，始终盯着你们所在的位置。","style":3,"background":2226,"log_type":1},{"step":7,"speaker":"${PlayerName}","content":"真是个不得了的家伙。","style":2,"background":2226,"log_type":1},{"step":8,"content":"怪物发出的动静越来越近。它迟早会追上。可你们无暇思考，能做的唯有竭力奔逃。","style":3,"background":2226,"log_type":1}]}