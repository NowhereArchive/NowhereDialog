{"id":403904501,"chapter_id":21000106,"scene_id":603,"steps":[{"step":2,"content":"规律的敲击声持续着，莱德轻松了不少，甚至有心情开起了玩笑。","style":3,"background":2307,"log_type":1},{"step":3,"speaker":"警卫莱德","content":"听起来，他们心情不错。","voice":["vo_event_403904003_03"],"voice_bank":"vo_event_39043","style":1,"background":2307,"log_type":1},{"step":4,"content":"但通讯员的神情却逐渐僵硬。","style":3,"background":2307,"log_type":1},{"step":5,"speaker":"通讯员特图","content":"按照刚才的测算，他们应该早就回来了才对……","voice":["vo_event_403904003_05"],"voice_bank":"vo_event_39043","style":1,"background":2307,"log_type":1},{"step":6,"content":"乓——乓——","style":3,"background":2307,"log_type":1},{"step":7,"content":"乓乓——乓——","style":3,"background":2307,"log_type":1},{"step":8,"content":"你闭上眼，静听着金属管敲击的节奏。","style":3,"background":2307,"log_type":1},{"step":9,"content":"乓乓乓乓——","style":3,"background":2307,"log_type":1},{"step":10,"content":"那声音一声比一声重，频率也越来越快。","style":3,"background":2307,"log_type":1},{"step":11,"content":"乓——","style":3,"background":2307,"log_type":1},{"step":12,"content":"突兀而尖锐的一声后，敲击戛然而止。","style":3,"background":2307,"log_type":1},{"step":13,"content":"<i><color=#dg1f1f>从那里出来……不要躲藏……</i></color>","voice":["vo_event_403904003_13"],"voice_bank":"vo_event_39043","style":1,"background":2307,"log_type":1},{"step":14,"content":"<i><color=#dg1f1f>直面……黑暗……恐惧……直面……你自己……</i></color>","voice":["vo_event_403904003_14"],"voice_bank":"vo_event_39043","style":1,"background":2307,"log_type":1},{"step":15,"content":"你猛地打了个寒颤，身体下意识挡在源津与劳拉身前。","style":3,"background":2307,"log_type":1},{"step":16,"content":"驾驶室内的光线仿佛瞬间被抽空。","style":3,"background":10000,"log_type":1},{"step":17,"content":"黑暗中，熟悉而令人作呕的气息翻涌而来。粘稠的液体蠕动声响起，隐约有无数眼睛在暗处窥伺。","style":3,"background":10000,"log_type":1},{"step":18,"content":"你无暇细想，冰冷滑腻的触感已悄无声息地缠住你的四肢，把你拖进了黑暗的深渊……","style":3,"background":10000,"log_type":1}]}