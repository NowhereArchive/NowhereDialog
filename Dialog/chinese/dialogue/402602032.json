{"id":402602032,"chapter_id":50070,"scene_id":57008,"steps":[{"step":1,"speaker":"000","content":"真厉害，能撑这么久。让让我嘛，你就这么不想输吗？","voice":["vo_event_402602032_01"],"voice_bank":"vo_event_26203","style":1,"background":2269,"log_type":1},{"step":2,"speaker":"选项","options":["开什么玩笑？"],"jump":[3],"style":6,"background":2269,"log_type":1},{"step":3,"speaker":"${PlayerName}","content":"既然知道这只——这个东西能有什么力量，那绝对不能让给你。","style":2,"background":2269,"log_type":1},{"step":4,"content":"也许在她看来，这只是一个超级简单的游戏，但你知道刚刚摩尔做了多少努力——难得会见到她那么严肃认真。","style":3,"background":2269,"log_type":1},{"step":5,"speaker":"000","content":"这么较真啊……我还是希望你把它当一场游戏，至少还能开心点。","voice":["vo_event_402602032_02"],"voice_bank":"vo_event_26203","style":1,"background":2269,"log_type":1},{"step":6,"content":"她突然扬手，你所在的终端不受控制地飞向她手里。","style":3,"background":2269,"log_type":1},{"step":7,"speaker":"000","content":"真要较真的话，你可是一点胜算都没有的。","voice":["vo_event_402602032_07"],"voice_bank":"vo_event_26203","style":1,"background":2269,"log_type":1},{"step":8,"speaker":"选项","options":["等等？！"],"jump":[9],"style":6,"background":2269,"log_type":1},{"step":9,"content":"【啪——黑屏，关机】","style":18,"background":10000,"log_type":1},{"step":10,"speaker":"${PlayerName}","content":"000？！你在干什么？！不是说好公平对决的吗？这是作弊。","style":2,"background":10000,"log_type":1},{"step":11,"content":"【释放枷锁】XN","style":22,"background":10000,"log_type":1},{"step":14,"content":"你拼命挣扎，但毫无用处。","style":3,"background":10000,"log_type":1},{"step":15,"speaker":"000","content":"哈哈哈刺杀游戏已经结束了，是你赢啦，回头给你结算奖励吧。","voice":["vo_event_402602032_08"],"voice_bank":"vo_event_26203","style":1,"background":10000,"log_type":1},{"step":16,"speaker":"000","content":"接下来的场面可能有点血腥，就不给你看了，我知道你不喜欢。","voice":["vo_event_402602032_09"],"voice_bank":"vo_event_26203","style":1,"background":10000,"log_type":1},{"step":17,"speaker":"000","content":"有一点你说的对，我尤其需要它的力量，抱歉啦局长。","voice":["vo_event_402602032_11"],"voice_bank":"vo_event_26203","style":1,"background":10000,"log_type":1},{"step":18,"speaker":"选项","options":["快住手！！"],"jump":[19],"style":6,"background":10000,"log_type":1},{"step":20,"speaker":"赫卡蒂","content":"梦魇！！","voice":["vo_event_402602032_17"],"voice_bank":"vo_event_26203","style":1,"background":2261,"log_type":1},{"step":21,"content":"（龙的咆哮，少女拦在你面前，拦在“手机屏幕”之外）","style":18,"background":2261,"log_type":1},{"step":22,"speaker":"000","content":"？！","style":1,"background":2261,"log_type":1},{"step":23,"speaker":"赫卡蒂","content":"对不起，局长，我们来晚了。这里的战斗交给我。","voice":["vo_event_402602032_19"],"voice_bank":"vo_event_26203","style":1,"background":2261,"log_type":1}]}