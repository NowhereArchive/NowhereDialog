,"drawing":1161200},{"step":75,"content":"福伦辛卡神色复杂，有对不公权力的愤怒，也有对含冤亡者的悲悯。","style":3,"log_type":1,"src_id":261201077,"trial_step":77,"drawing":1161203},{"step":76,"content":"她厌恶死板的规则和冗杂的司法程序，可她并没有放弃“法医”的工作，她依旧在用自己的规则，去帮助一切需要“法医”的人。","style":3,"log_type":1,"src_id":261201078,"trial_step":78,"drawing":1161203},{"step":77,"content":"这说明在她心中，有高于一切的存在，让她无论如何都要坚持下去。","style":3,"log_type":1,"src_id":261201079,"trial_step":79,"drawing":1161203},{"step":78,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":80,"course":6,"drawing":1161203},{"step":79,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":80,"course":6,"drawing":1161203},{"step":80,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":80,"course":6,"drawing":1161203},{"step":81,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":80,"course":6,"drawing":1161203},{"step":82,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":80,"course":6,"drawing":1161203},{"step":83,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":80,"course":6,"drawing":1161203},{"step":84,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":80,"course":6,"drawing":1161203},{"step":85,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":80,"course":6,"drawing":1161203},{"step":86,"content":"是因为这个案件吗？让你决定不再信任司法的公正。","style":2,"log_type":1,"src_id":261201081,"trial_step":81,"drawing":1161203},{"step":87,"content":"福伦辛卡的表情瞬间变了。","style":3,"log_type":1,"src_id":261201082,"trial_step":82,"drawing":1161202},{"step":88,"content":"她盯着那份文件，像是看到了什么令人痛恨的东西。","style":3,"log_type":1,"src_id":261201083,"trial_step":83,"drawing":1161202},{"step":89,"content":"你偷的那具尸体，案发现场的布置与“折纸杀手”旧案的手法一模一样。","style":2,"log_type":1,"src_id":261201084,"trial_step":84,"drawing":1161202},{"step":90,"content":"当初你怀疑一桩案子是“折纸杀手”所为，但得不到机构和家属的支持，想要违规解剖，结果被发现了。","style":2,"log_type":1,"src_id":261201085,"trial_st