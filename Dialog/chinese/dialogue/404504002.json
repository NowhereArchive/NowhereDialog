{"id":404504002,"chapter_id":60005,"scene_id":60515,"steps":[{"step":1,"speaker":"系统提示","content":"情境同步完成。","style":14,"background":10000,"is_centered":true,"log_type":1},{"step":2,"content":"随着你拿到模拟中的宝物后，眼前的光幕轻轻震动了一下，随即便黯淡下去。","style":3,"background":1014,"log_type":1},{"step":3,"content":"刚才那条路径被你彻底复现，许多疑点也跟着浮出水面。","style":3,"background":1014,"log_type":1},{"step":4,"speaker":"玩家","content":"……原来她们是这样进来的。","style":2,"background":1014,"log_type":1},{"step":5,"speaker":"玩家","content":"那后面的区域呢？还能继续模拟吗？","style":2,"background":1014,"log_type":1},{"step":6,"content":"你摘下头盔，身边的小文早已雀跃不已。","style":3,"background":1014,"log_type":1},{"step":7,"speaker":"小文","content":"当然可以！不过局长您最好休息一下，说明书上说……最好不要连续进行模拟，长时间使用的话可能会对视网膜造成伤害。","style":1,"background":1014,"log_type":1},{"step":8,"content":"确实有点费眼睛。","style":3,"background":1014,"log_type":1},{"step":9,"content":"你眨了几下有些干涩的眼睛，将模拟的各种细节记下，上传至云端。","style":3,"background":1014,"log_type":1}]}