{"id":1020401,"chapter_id":1020401,"scene_id":1,"steps":[{"step":1,"content":"█月12日，12:35，MBCC食堂。","style":9,"background":1014,"log_type":1,"src_id":120401001,"trial_step":1},{"step":2,"content":"你没想到，再次与唐见面会是在这种场合——","style":3,"background":1014,"log_type":1,"src_id":120401002,"trial_step":2},{"step":3,"speaker":"唐","content":"早就听外面的禁闭者说你们MBCC伙食好，还真是名不虚传啊……","voice":["vo_trial_20401_1_3"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401003,"trial_step":3},{"step":4,"content":"唐一只手拿着烤猪肘，另一只手抓着整扎的现打果汁，满嘴油光。","style":3,"background":1014,"log_type":1,"src_id":120401004,"trial_step":4},{"step":5,"speaker":"唐","content":"真的，你们这儿大厨的手艺……宣传一下，哪儿还用什么追缉队……外面的禁闭者还不排着队地来啊。","voice":["vo_trial_20401_1_5"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401005,"trial_step":5},{"step":6,"content":"说着，唐朝不远处后厨的开尔文和伊格尼比了个拇指。","style":3,"background":1014,"log_type":1,"src_id":120401006,"trial_step":6},{"step":7,"content":"眼见唐三下五除二解决了手上的猪肘，又朝着后厨叫唤道：","style":3,"background":1014,"log_type":1,"src_id":120401007,"trial_step":7},{"step":8,"speaker":"唐","content":"再给来碗面应该就差不多了，然后餐后甜品有啥上啥，我溜溜缝。","voice":["vo_trial_20401_1_8"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401008,"trial_step":8},{"step":9,"speaker":"唐","content":"冰淇淋肯定也得来点，你们MBCC的冰淇淋最出名了……","voice":["vo_trial_20401_1_9"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401009,"trial_step":9},{"step":10,"content":"开尔文将“客人”点的菜肴端上后，一溜烟逃回了后厨，又偷偷探出头看向你们这边。","style":3,"background":1014,"log_type":1,"src_id":120401010,"trial_step":10},{"step":11,"content":"显然，其他禁闭者们也都对这个明目张胆上管理局蹭饭的金发佬颇感好奇，三五成群地在不远处对他指指点点。","style":3,"background":1014,"log_type":1,"src_id":120401011,"trial_step":11},{"step":12,"content":"而等你回头看向唐时，却见桌上的饭菜已经清空，他正心满意足地瘫坐在椅子上，剃起了牙。","style":3,"background":1014,"log_type":1,"src_id":120401012,"trial_step":12},{"step":13,"content":"堂堂西区的大英雄怎么饿成这样？不会是有人欺负你吧？","style":2,"background":1014,"log_type":1,"src_id":120401013,"trial_step":13},{"step":14,"speaker":"唐","content":"嗐，哪儿能呢。这不最近东奔西走的，一堆事儿要忙，就没顾着吃饭。","voice":["vo_trial_20401_1_14"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401014,"trial_step":14},{"step":15,"speaker":"唐","content":"还得是你仗义啊……以后有用得着的地方尽管提。做不做得到两说，哥们儿的心永远和你在一起。","voice":["vo_trial_20401_1_15"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401015,"trial_step":15},{"step":16,"content":"免了免了，一顿饭而已。","style":2,"background":1014,"log_type":1,"src_id":120401016,"trial_step":16},{"step":17,"options":["话说"],"style":6,"background":1014,"log_type":1,"src_id":120401017,"trial_step":17,"course":3,"choices":[{"text":"话说","goto":18}]},{"step":18,"content":"你这么一个大忙人，应该不至于专程来我这儿，就为了蹭个饭吧？","style":2,"background":1014,"log_type":1,"src_id":120401018,"trial_step":18},{"step":19,"speaker":"唐","content":"嗝……还得是你了解我。","voice":["vo_trial_20401_1_19"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401019,"trial_step":19},{"step":20,"content":"唐随手将牙签扔进垃圾桶，站起了身。","style":3,"background":1014,"log_type":1,"src_id":120401020,"trial_step":20},{"step":21,"speaker":"唐","content":"找你当然是有正事要聊。","voice":["vo_trial_20401_1_21"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401021,"trial_step":21},{"step":22,"content":"什么正事？","style":2,"background":1014,"log_type":1,"src_id":120401022,"trial_step":22},{"step":23,"content":"唐环顾四周，压低声音朝你凑了过来。","style":3,"background":1014,"log_type":1,"src_id":120401023,"trial_step":23},{"step":24,"speaker":"唐","content":"人多耳杂，咱们找个僻静地儿聊。","voice":["vo_trial_20401_1_24"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401024,"trial_step":24},{"step":25,"content":"……行。我去安排个地方。","style":2,"background":1014,"log_type":1,"src_id":120401025,"trial_step":25},{"step":26,"content":"你跟我来。","style":2,"background":1014,"log_type":1,"src_id":120401026,"trial_step":26},{"step":27,"speaker":"唐","content":"……","voice":["vo_trial_20401_1_28"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401028,"trial_step":28,"drawing":1020401},{"step":28,"content":"……","style":2,"log_type":1,"src_id":120401029,"trial_step":29,"drawing":1020401},{"step":29,"speaker":"唐","content":"不是……","voice":["vo_trial_20401_1_30"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401030,"trial_step":30,"drawing":1020401},{"step":30,"speaker":"唐","content":"你们管理局聊正事都在这种地方啊？","voice":["vo_trial_20401_1_31"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401031,"trial_step":31,"drawing":1020401},{"step":31,"options":["对啊。"],"style":6,"log_type":1,"src_id":120401032,"trial_step":32,"course":3,"drawing":1020401,"choices":[{"text":"对啊。","goto":33}]},{"step":32,"content":"这地方平时绝对不会有人来。","style":2,"log_type":1,"src_id":120401033,"trial_step":33,"drawing":1020401},{"step":33,"speaker":"唐","content":"嗯，可不是么？谁精神正常吃饱了撑的要来这种地方啊？","voice":["vo_trial_20401_1_34"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401034,"trial_step":34,"drawing":1020401},{"step":34,"speaker":"唐","content":"而且别以为我不知道，你们MBCC审查禁闭者都是有录像备份的。","voice":["vo_trial_20401_1_35"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401035,"trial_step":35,"drawing":1020401},{"step":35,"content":"放心，我提前把摄像头都掐了。","style":2,"log_type":1,"src_id":120401036,"trial_step":36,"drawing":1020401},{"step":36,"speaker":"唐","content":"我是不是还得夸你啊……谢谢嗷，你想得真周到。","voice":["vo_trial_20401_1_37"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401037,"trial_step":37,"drawing":1020401},{"step":37,"content":"不用谢。","style":2,"log_type":1,"src_id":120401038,"trial_step":38,"drawing":1020401},{"step":38,"speaker":"唐","content":"说你胖你还喘上了……其实吧，我说的事儿也没那么见不得人，咱没必要整这些……","voice":["vo_trial_20401_1_39"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401039,"trial_step":39,"drawing":1020402},{"step":39,"content":"是谁让我找个僻静的地方来着？","style":2,"log_type":1,"src_id":120401040,"trial_step":40,"drawing":1020402},{"step":40,"content":"哦，你选的嘛，唐sir。","style":2,"log_type":1,"src_id":120401041,"trial_step":41,"drawing":1020402},{"step":41,"content":"而且别忘了，你现在的身份还真就“见不得人”。涅槃的悬赏还挂在你身上呢。","style":2,"log_type":1,"src_id":120401042,"trial_step":42,"drawing":1020402},{"step":42,"speaker":"唐","content":"我……唉……你说得对。但我感觉类似的事情一定不是第一次发生了。","voice":["vo_trial_20401_1_43"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401043,"trial_step":43,"drawing":1020402},{"step":43,"speaker":"唐","content":"……其实吧，这个“正事儿”还真就跟涅槃他们有关系。","voice":["vo_trial_20401_1_44"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401044,"trial_step":44,"drawing":1020405},{"step":44,"options":["发生什么事了？"],"style":6,"log_type":1,"src_id":120401045,"trial_step":45,"course":3,"drawing":1020405,"choices":[{"text":"发生什么事了？","goto":46}]},{"step":45,"speaker":"唐","content":"当然是那个天杀的悬赏啦。涅槃手眼通天，找到我头上了。我现在形单影只无依无靠，只能到你这儿求援啦……","voice":["vo_trial_20401_1_46"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401046,"trial_step":46,"drawing":1020404},{"step":46,"content":"开玩笑。凭你的本事和人脉，涅槃没可能抓得住。","style":2,"log_type":1,"src_id":120401047,"trial_step":47,"drawing":1020404},{"step":47,"speaker":"唐","content":"我没开玩笑……不过你说得对，只要我想躲，他们是抓不到我的。","voice":["vo_trial_20401_1_48"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401048,"trial_step":48,"drawing":1020405},{"step":48,"speaker":"唐","content":"但是，怎么说呢，情况有些复杂……他们的确是“找上”我了。","voice":["vo_trial_20401_1_49"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401049,"trial_step":49,"drawing":1020405},{"step":49,"content":"找上你？你的意思是……","style":2,"log_type":1,"src_id":120401050,"trial_step":50,"drawing":1020405},{"step":50,"speaker":"唐","content":"首先我得跟你解释清楚一件事——","voice":["vo_trial_20401_1_51"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401051,"trial_step":51,"drawing":1020405},{"step":51,"content":"唐略微坐正了一些，表情难得的严肃。","style":3,"log_type":1,"src_id":120401052,"trial_step":52,"drawing":1020400},{"step":52,"speaker":"唐","content":"最近这半年，西区出现了一批“精神病人”，你知道么？","voice":["vo_trial_20401_1_53"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401053,"trial_step":53,"drawing":1020400},{"step":53,"content":"你摇了摇头。","style":3,"log_type":1,"src_id":120401054,"trial_step":54,"drawing":1020400},{"step":54,"speaker":"唐","content":"你毕竟刚醒来没多久，不知道也很正常。","voice":["vo_trial_20401_1_55"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401055,"trial_step":55,"drawing":1020400},{"step":55,"speaker":"唐","content":"简而言之，这半年来BR-002一直散发狂厄，西区不少人都受到了影响。","voice":["vo_trial_20401_1_56"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401056,"trial_step":56,"drawing":1020400},{"step":56,"speaker":"唐","content":"好消息是，和之前的狂厄病患者不一样，这些人的症状要轻得多，主要表现偏向于重度精神衰弱，短期内还危及不到生命。","voice":["vo_trial_20401_1_57"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401057,"trial_step":57,"drawing":1020400},{"step":57,"speaker":"唐","content":"只要及时医治，就能痊愈，基本不会影响以后正常生活……","voice":["vo_trial_20401_1_58"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401058,"trial_step":58,"drawing":1020400},{"step":58,"content":"但是现在的西区，没有医治他们的条件，对么？","style":2,"log_type":1,"src_id":120401059,"trial_step":59,"drawing":1020400},{"step":59,"speaker":"唐","content":"你说得没错，西区现在暂时解决不了这个麻烦。","voice":["vo_trial_20401_1_60"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401060,"trial_step":60,"drawing":1020400},{"step":60,"speaker":"唐","content":"城区刚刚开始重建，唯一靠谱的医疗机构就是彼岸诊所。但是这些病人的数量实在是太多了……","voice":["vo_trial_20401_1_61"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401061,"trial_step":61,"drawing":1020400},{"step":61,"speaker":"唐","content":"现阶段光是已确诊的严重患者就有两千多，这远远超出了彼岸能承受的极限。","voice":["vo_trial_20401_1_62"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401062,"trial_step":62,"drawing":1020400},{"step":62,"speaker":"唐","content":"更别说受到狂厄影响的轻度患者……我们现在没能力做大规模普查，但保守估计得有好几万。","voice":["vo_trial_20401_1_63"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401063,"trial_step":63,"drawing":1020400},{"step":63,"content":"唐这席话让你心中一凛。","style":3,"log_type":1,"src_id":120401064,"trial_step":64,"drawing":1020400},{"step":64,"content":"有些棘手……这个数量，管理局也吃不下来。","style":2,"log_type":1,"src_id":120401065,"trial_step":65,"drawing":1020400},{"step":65,"content":"不过，或许我可以利用下现有的政治影响力，呼吁新城的政客商人们捐款。再以人道主义救援的名义组织一批医护过去……","style":2,"log_type":1,"src_id":120401066,"trial_step":66,"drawing":1020400},{"step":66,"content":"看着你真心实意地提供帮助，唐摆了摆手。","style":3,"log_type":1,"src_id":120401067,"trial_step":67,"drawing":1020405},{"step":67,"speaker":"唐","content":"你为西区做的事大家有目共睹。不过这件事儿，还用不着你出马。","voice":["vo_trial_20401_1_68"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401068,"trial_step":68,"drawing":1020405},{"step":68,"speaker":"唐","content":"西区穷归穷，但异方晶贸易启动之后，也不会缺那些家底。这个问题，我们自己能解决。","voice":["vo_trial_20401_1_69"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401069,"trial_step":69,"drawing":1020405},{"step":69,"speaker":"唐","content":"真正需要你帮忙的，反倒是另一件麻烦事。","voice":["vo_trial_20401_1_70"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401070,"trial_step":70,"drawing":1020405},{"step":70,"content":"需要我做什么？","style":2,"log_type":1,"src_id":120401071,"trial_step":71,"drawing":1020405},{"step":71,"speaker":"唐","content":"说来话长……","voice":["vo_trial_20401_1_72"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401072,"trial_step":72,"drawing":1020405},{"step":72,"content":"唐顿了顿，继续解释着：","style":3,"log_type":1,"src_id":120401073,"trial_step":73,"drawing":1020405},{"step":73,"speaker":"唐","content":"你也知道，最近新城的人一批接着一批地来，有谈生意的，有作秀的，自然也有西区人请来治疗狂厄精神病的。","voice":["vo_trial_20401_1_74"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401074,"trial_step":74,"drawing":1020400},{"step":74,"speaker":"唐","content":"问题就出在这儿了。有几个自称“医生”的家伙，在回新城之前，带走了一个“典型病例”……","voice":["vo_trial_20401_1_75"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401075,"trial_step":75,"drawing":1020400},{"step":75,"content":"说到这里，唐的眼神中带上了一丝无奈与恳求。","style":3,"log_type":1,"src_id":120401076,"trial_step":76,"drawing":1020405},{"step":76,"speaker":"唐","content":"她的名字叫……玛格丽，是我的姨妈。","voice":["vo_trial_20401_1_77"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401077,"trial_step":77,"drawing":1020405},{"step":77,"speaker":"唐","content":"我想请你帮我把她带回来。","voice":["vo_trial_20401_1_78"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401078,"trial_step":78,"drawing":1020405},{"step":78,"content":"在唐的描述下，你回忆起了玛格丽的身份。","style":3,"log_type":1,"src_id":120401079,"trial_step":79,"drawing":1020405},{"step":79,"content":"在这个时间节点，能做出这种事的，几乎就只剩下一种可能了。","style":3,"log_type":1,"src_id":120401080,"trial_step":80,"drawing":1020405},{"step":80,"content":"涅槃……","style":2,"log_type":1,"src_id":120401081,"trial_step":81,"drawing":1020405},{"step":81,"speaker":"唐","content":"没错，是涅槃的人。","voice":["vo_trial_20401_1_82"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401082,"trial_step":82,"drawing":1020400},{"step":82,"speaker":"唐","content":"准确地说，他们隶属于新城的班彦四院，一家专门收治精神病患的医院。","voice":["vo_trial_20401_1_83"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401083,"trial_step":83,"drawing":1020400},{"step":83,"content":"嗯……","style":2,"log_type":1,"src_id":120401084,"trial_step":84,"drawing":1020400},{"step":84,"content":"他们的目的，是打算用玛格丽作为人质，逼迫你现身，对么？","style":2,"log_type":1,"src_id":120401085,"trial_step":85,"drawing":1020400},{"step":85,"speaker":"唐","content":"除此之外，我想不到别的可能。","voice":["vo_trial_20401_1_86"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401086,"trial_step":86,"drawing":1020400},{"step":86,"speaker":"唐","content":"不然怎么解释他们能在两千多个病患里精准地找到我的姨妈，还特意花大力气骗过流民寨的街坊邻居、以治疗的名义把她接走呢？","voice":["vo_trial_20401_1_87"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401087,"trial_step":87,"drawing":1020400},{"step":87,"content":"这些家伙还真是不消停……","style":2,"log_type":1,"src_id":120401088,"trial_step":88,"drawing":1020400},{"step":88,"content":"不过，还真是有些难办。","style":2,"log_type":1,"src_id":120401089,"trial_step":89,"drawing":1020400},{"step":89,"content":"如果我直接找上层施压，很有可能会打草惊蛇。到时候他们会用出什么龌龊手段，可就不知道了。","style":2,"log_type":1,"src_id":120401090,"trial_step":90,"drawing":1020400},{"step":90,"speaker":"唐","content":"这个我自然清楚。不过我既然都来找你了，当然也是想到办法了。","voice":["vo_trial_20401_1_91"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401091,"trial_step":91,"drawing":1020405},{"step":91,"speaker":"唐","content":"班彦四院虽然背后受涅槃控制，但也不是人人都是狗腿子。","voice":["vo_trial_20401_1_92"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401092,"trial_step":92,"drawing":1020405},{"step":92,"speaker":"唐","content":"我认识一个四院的医生——刚巧他也是可以解决现阶段西区问题的最佳人选……","voice":["vo_trial_20401_1_93"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401093,"trial_step":93,"drawing":1020405},{"step":93,"content":"你立刻反应过来唐的意图。","style":3,"log_type":1,"src_id":120401094,"trial_step":94,"drawing":1020405},{"step":94,"content":"你的意思是，我可以用邀请治疗西区病人的名义去接近他，顺带打探玛格丽的消息，对么？","style":2,"log_type":1,"src_id":120401095,"trial_step":95,"drawing":1020405},{"step":95,"speaker":"唐","content":"哈哈，跟你说话就是省事儿！","voice":["vo_trial_20401_1_96"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401096,"trial_step":96,"drawing":1020403},{"step":96,"content":"可靠么？","style":2,"log_type":1,"src_id":120401097,"trial_step":97,"drawing":1020403},{"step":97,"speaker":"唐","content":"放心，这个人我熟得很。这么多年了都不愿意和四院的那些渣滓沆瀣一气，一直被涅槃的人排挤。","voice":["vo_trial_20401_1_98"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401098,"trial_step":98,"drawing":1020405},{"step":98,"speaker":"唐","content":"医术医德都可以完全信任，找他准没错。","voice":["vo_trial_20401_1_99"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401099,"trial_step":99,"drawing":1020405},{"step":99,"content":"唐一副胸有成竹的模样。","style":3,"log_type":1,"src_id":120401100,"trial_step":100,"drawing":1020405},{"step":100,"content":"好，我这就去联系他……他叫什么名字？","style":2,"log_type":1,"src_id":120401101,"trial_step":101,"drawing":1020405},{"step":101,"speaker":"唐","content":"达斯·阿尔兹，他现在是班彦四院的精神科主治医生。工作日估计挂个号就能找到他。","voice":["vo_trial_20401_1_102"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401102,"trial_step":102,"drawing":1020405},{"step":102,"content":"你记录下这位医生的信息后，抬头看了唐一眼。","style":3,"log_type":1,"src_id":120401103,"trial_step":103,"drawing":1020405},{"step":103,"content":"说起来，一个新城精神病院……还是涅槃控制下的精神病院医生，你到底是怎么跟他搭上线的？","style":2,"log_type":1,"src_id":120401104,"trial_step":104,"drawing":1020405},{"step":104,"speaker":"唐","content":"你唐sir神通广大，朋友遍布五湖四海，认识个精神病院的医生有什么大不了的。","voice":["vo_trial_20401_1_105"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401105,"trial_step":105,"drawing":1020401},{"step":105,"content":"唐想了想，又说道：","style":3,"log_type":1,"src_id":120401106,"trial_step":106,"drawing":1020401},{"step":106,"speaker":"唐","content":"对了，他这人性格不太好，说话相当不中听……你别在意，他人其实还挺好的……","voice":["vo_trial_20401_1_107"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401107,"trial_step":107,"drawing":1020405},{"step":107,"content":"嗯，这个我心里有数。","style":2,"log_type":1,"src_id":120401108,"trial_step":108,"drawing":1020405},{"step":108,"speaker":"唐","content":"你有数就好……","voice":["vo_trial_20401_1_109"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401109,"trial_step":109,"drawing":1020405},{"step":109,"content":"唐张开嘴，似乎还想说什么，却表现得有些踌躇。","style":3,"log_type":1,"src_id":120401110,"trial_step":110,"drawing":1020402},{"step":110,"content":"有话直说。","style":2,"log_type":1,"src_id":120401111,"trial_step":111,"drawing":1020402},{"step":111,"speaker":"唐","content":"哈哈……也对，跟你倒也没必要搞得婆婆妈妈的。","voice":["vo_trial_20401_1_112"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401112,"trial_step":112,"drawing":1020404},{"step":112,"speaker":"唐","content":"总之，虽然我不常求人，但这件事……我真的需要你的帮助。","voice":["vo_trial_20401_1_113"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401113,"trial_step":113,"drawing":1020404},{"step":113,"speaker":"唐","content":"拜托你了。","voice":["vo_trial_20401_1_114"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401114,"trial_step":114,"drawing":1020404}]}