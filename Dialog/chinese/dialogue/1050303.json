{"id":1050303,"chapter_id":1050303,"scene_id":1,"steps":[{"step":1,"content":"这是一幅奇异的景象。若不是你与观星者之间的氛围太过剑拔弩张，那么一定会有脾气古怪的艺术家，愿意为你们画下这样的场面。","style":3,"background":1037,"log_type":1,"src_id":150303001,"trial_step":1},{"step":2,"content":"岌岌可危的基站前，一帮人举着刀枪，声音嘶哑，试图冲破那道屏障，而在这附近的废弃雕像上，一场对峙也正在悄然进行。","style":3,"background":1037,"log_type":1,"src_id":150303002,"trial_step":2},{"step":3,"speaker":"观星者","content":"在你面前有两条路，我的小怪物。","voice":["vo_trial_50303_1_3"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303003,"trial_step":3},{"step":4,"content":"观星者笑着，语气里却充满着温和的“威胁”感。","style":3,"background":1037,"log_type":1,"src_id":150303004,"trial_step":4},{"step":5,"speaker":"观星者","content":"我的预言已经开始一一应验，迷途，小人，灾难，接下来可就是死亡了……你可以选择求助我，也可以选择……尝试反抗，","voice":["vo_trial_50303_1_5"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303005,"trial_step":5},{"step":6,"speaker":"观星者","content":"比如说……你完全可以用枷锁控制住我，让我解决掉那些已经变成怪物的家伙，让你不会死在这里。","voice":["vo_trial_50303_1_6"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303006,"trial_step":6},{"step":7,"options":["这是你的预言，还是计谋？"],"style":6,"background":1037,"log_type":1,"src_id":150303007,"trial_step":7,"course":3,"choices":[{"text":"这是你的预言，还是计谋？","goto":8}]},{"step":8,"content":"你应该知道我如果使用枷锁的话……会被内海吞噬吧，内海的防护罩，被那些人和你这么折腾，已经快到极限了。","style":2,"background":1037,"log_type":1,"src_id":150303008,"trial_step":8},{"step":9,"content":"观星者笑了笑，把你更进一步地搂入怀里。","style":3,"background":1037,"log_type":1,"src_id":150303009,"trial_step":9},{"step":10,"speaker":"观星者","content":"这不是很好吗？","voice":["vo_trial_50303_1_10"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303010,"trial_step":10},{"step":11,"speaker":"观星者","content":"笊篱困不住细腻的沙子，这个世界困不住你和我，我们……可以一起走进最真实的梦境中去。","voice":["vo_trial_50303_1_11"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303011,"trial_step":11},{"step":12,"speaker":"观星者","content":"你已经回不去了，小怪物。","voice":["vo_trial_50303_1_12"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303012,"trial_step":12},{"step":13,"content":"观星者贴在你的耳畔，温热的气息落在你的发丝尖儿上，让人一阵颤栗。","style":3,"background":1037,"log_type":1,"src_id":150303013,"trial_step":13},{"step":14,"speaker":"观星者","content":"不管怎么挣扎，这都是会降临的。","voice":["vo_trial_50303_1_14"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303014,"trial_step":14},{"step":15,"options":["这不是挣扎"],"style":6,"background":1037,"log_type":1,"src_id":150303015,"trial_step":15,"course":3,"choices":[{"text":"这不是挣扎","goto":16}]},{"step":16,"content":"我只是不相信被预言出来的命运，并且接受人为的安排。","style":2,"background":1037,"log_type":1,"src_id":150303016,"trial_step":16},{"step":17,"content":"我会解决这一切，不管是他们……还是你。","style":2,"background":1037,"log_type":1,"src_id":150303017,"trial_step":17},{"step":18,"content":"像是听到什么好笑的事，观星者微微低头，埋在你的颈侧笑了起来。","style":3,"background":1037,"log_type":1,"src_id":150303018,"trial_step":18},{"step":19,"speaker":"观星者","content":"哈哈哈……我的小怪物啊，你这是在逗我开心吗？","voice":["vo_trial_50303_1_19"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303019,"trial_step":19},{"step":20,"speaker":"观星者","content":"这个世界里，所有人都沉溺在虚假的狂欢之中，打着各种各样的幌子，抛弃弱者，贪图财富，最终在自己营造的现实中溺毙。","voice":["vo_trial_50303_1_20"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303020,"trial_step":20},{"step":21,"speaker":"观星者","content":"而唯有你，出现在我的梦境之中，最纯净纯粹的地方，你拨开了这一切……拥有窥探真实的欲望。","voice":["vo_trial_50303_1_21"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303021,"trial_step":21},{"step":22,"content":"观星者看着你，像是要从你的眼中看到通往真实的道路。","style":3,"background":1037,"log_type":1,"src_id":150303022,"trial_step":22},{"step":23,"content":"你为什么会选择我？","style":2,"background":1037,"log_type":1,"src_id":150303023,"trial_step":23},{"step":24,"content":"就因为我出现在你的梦境里？还是因为我和你一起见证了幻花的沉睡？","style":2,"background":1037,"log_type":1,"src_id":150303024,"trial_step":24},{"step":25,"speaker":"观星者","content":"我认为这足够了……小怪物，你是特别的。","voice":["vo_trial_50303_1_25"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303025,"trial_step":25},{"step":26,"content":"这样的理由我并不接受。","style":2,"background":1037,"log_type":1,"src_id":150303026,"trial_step":26},{"step":27,"content":"哪怕这个世界是虚假的，它赋予了我责任——那我不会抛下不管。","style":2,"background":1037,"log_type":1,"src_id":150303027,"trial_step":27},{"step":28,"speaker":"观星者","content":"……","voice":["vo_trial_50303_1_28"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303028,"trial_step":28},{"step":29,"speaker":"观星者","content":"每天……每天……你都被谎言所围绕。","voice":["vo_trial_50303_1_29"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303029,"trial_step":29},{"step":30,"speaker":"观星者","content":"你以为你的同伴，都对你毫无保留吗？","voice":["vo_trial_50303_1_30"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303030,"trial_step":30},{"step":31,"content":"观星者转起手中的水晶球，里面如黑雾一般的物质扭曲着，渐渐地蔓延开来，形成一片荒芜。","style":3,"background":1037,"log_type":1,"src_id":150303031,"trial_step":31},{"step":32,"speaker":"奇怪的吼叫声","content":"吼——！！啊————！！","voice":["vo_trial_50303_1_32"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303032,"trial_step":32},{"step":33,"content":"那些异方晶的走私犯，眼见得不到屏障后的财宝，急得大吼大叫。","style":3,"background":1037,"log_type":1,"src_id":150303033,"trial_step":33},{"step":34,"speaker":"科尔","content":"滚开！！你们这些渣滓！！傻*！！！","voice":["vo_trial_50303_1_34"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303034,"trial_step":34},{"step":35,"speaker":"科尔","content":"你**的没有老子你们能得到这些吗！！！","voice":["vo_trial_50303_1_35"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303035,"trial_step":35},{"step":36,"speaker":"科尔","content":"这些都是我一个人的！！！你们连我的**都碰不到！","voice":["vo_trial_50303_1_36"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303036,"trial_step":36},{"step":37,"speaker":"走私犯A","content":"***！！这是我的！！谁都不能抢走！你**的也不能！！","voice":["vo_trial_50303_1_37"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303037,"trial_step":37},{"step":38,"speaker":"走私犯B","content":"不能！！！！","voice":["vo_trial_50303_1_38"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303038,"trial_step":38},{"step":39,"content":"你被钳制着，只能眼睁睁地看着这些人愈发的狂暴。","style":3,"background":1037,"log_type":1,"src_id":150303039,"trial_step":39},{"step":40,"content":"你在使用异能？！他们本不会自相残杀！","style":2,"background":1037,"log_type":1,"src_id":150303040,"trial_step":40},{"step":41,"speaker":"观星者","content":"的确，也许是上天垂怜，我们这一族或多或少能窥探人心……","voice":["vo_trial_50303_1_41"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303041,"trial_step":41},{"step":42,"speaker":"观星者","content":"这让我确实通过窥探虚空一隅，获得了某种力量。","voice":["vo_trial_50303_1_42"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303042,"trial_step":42},{"step":43,"speaker":"观星者","content":"可是……人类心底的欲望实在是太容易暴露了。","voice":["vo_trial_50303_1_43"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303043,"trial_step":43},{"step":44,"speaker":"观星者","content":"你说……我使用异能让他们打起来的？","voice":["vo_trial_50303_1_44"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303044,"trial_step":44},{"step":45,"content":"观星者把水晶球捧到你面前，你看到水晶球里的黑雾翻滚，却感受不到异能的波动。","style":3,"background":1037,"log_type":1,"src_id":150303045,"trial_step":45},{"step":46,"speaker":"观星者","content":"我根本不需要使用异能……这些人……只消对他们低语两句，就能暴露出他们最一目了然，最原始的欲望。","voice":["vo_trial_50303_1_46"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303046,"trial_step":46},{"step":47,"speaker":"观星者","content":"你的身边，这个世界里，到处都是这样的人！你以为……为什么他们要害怕我，让你来镇压我？","voice":["vo_trial_50303_1_47"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303047,"trial_step":47},{"step":48,"speaker":"观星者","content":"那些围绕在你身边的人，想想吧，亲爱的，他们为什么会倒下？为什么不敢直视我？","voice":["vo_trial_50303_1_48"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303048,"trial_step":48},{"step":49,"content":"你回想起在砂海的避难所里，在辛迪加的黑市里，那些人看向你和观星者的眼神，害怕，畏惧……却又仇恨。","style":3,"background":1037,"log_type":1,"src_id":150303049,"trial_step":49},{"step":50,"speaker":"观星者","content":"他们心中有鬼，向你隐瞒了诸多事情。","voice":["vo_trial_50303_1_50"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303050,"trial_step":50},{"step":51,"speaker":"观星者","content":"你该不会天真的以为……那座城市，那些建筑里，都是你的伙伴吧？","voice":["vo_trial_50303_1_51"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303051,"trial_step":51},{"step":52,"options":["我相信他们","我确实不相信他们"],"style":6,"background":1037,"log_type":1,"src_id":150303052,"trial_step":52,"course":3,"choices":[{"text":"我相信他们","goto":53},{"text":"我确实不相信他们","goto":59}]},{"step":53,"speaker":"观星者","content":"人类的相信总是盲目的，一旦知晓所信仰的来源不过是虚假的造神，这个世界终将走向毁灭。","voice":["vo_trial_50303_1_53"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303053,"trial_step":53},{"step":54,"speaker":"观星者","content":"神的破灭会带来毁灭性的伤害，小怪物，你会遍体鳞伤的。","voice":["vo_trial_50303_1_54"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303054,"trial_step":54},{"step":55,"content":"没有人能完整地活在这个世界上，观星者小姐。","style":2,"background":1037,"log_type":1,"src_id":150303055,"trial_step":55},{"step":56,"content":"你无法向我保证，即使是在真实之地，我也能全须全尾。","style":2,"background":1037,"log_type":1,"src_id":150303056,"trial_step":56},{"step":57,"speaker":"观星者","content":"不，你可以相信我！","voice":["vo_trial_50303_1_57"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303057,"trial_step":57},{"step":58,"content":"你无条件地相信幻花，又何尝不是一种盲目的信任？","style":2,"background":1037,"log_type":1,"src_id":150303058,"trial_step":58,"next":[66]},{"step":59,"speaker":"观星者","content":"真是出乎我意料的回答。","voice":["vo_trial_50303_1_59"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303059,"trial_step":59},{"step":60,"content":"世界上没有坚不可摧的信任。","style":2,"background":1037,"log_type":1,"src_id":150303060,"trial_step":60},{"step":61,"speaker":"观星者","content":"是的，没有。","voice":["vo_trial_50303_1_61"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303061,"trial_step":61},{"step":62,"content":"但有坚不可摧的情感。","style":2,"background":1037,"log_type":1,"src_id":150303062,"trial_step":62},{"step":63,"speaker":"观星者","content":"……","voice":["vo_trial_50303_1_63"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303063,"trial_step":63},{"step":64,"content":"这份情感或许是人与人之间的，又或者是人与事物之间的。","style":2,"background":1037,"log_type":1,"src_id":150303064,"trial_step":64},{"step":65,"content":"他们确实并不完全对我忠诚，但在“守护”这一件事上，我们可以暂时收起对彼此的怀疑、利用、不屑，成为牢不可破的“信任”。","style":2,"background":1037,"log_type":1,"src_id":150303065,"trial_step":65},{"step":66,"content":"观星者低下了头，一时之间看不清她的表情。","style":3,"background":1037,"log_type":1,"src_id":150303066,"trial_step":66},{"step":67,"speaker":"观星者","content":"你还真是会说啊……尽管字句里，充满了被虚与委蛇填满的盲目。","voice":["vo_trial_50303_1_67"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303067,"trial_step":67},{"step":68,"content":"我不管幻花选择我是为了什么，但我知道这里，这个现实中，命运为什么要选择我。","style":2,"background":1037,"log_type":1,"src_id":150303068,"trial_step":68},{"step":69,"speaker":"观星者","content":"被蒙蔽之人啊……","voice":["vo_trial_50303_1_69"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303069,"trial_step":69},{"step":70,"speaker":"观星者","content":"你就没有想过……被这个世界创造的你，也是虚假的吗？","voice":["vo_trial_50303_1_70"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303070,"trial_step":70},{"step":71,"content":"你说什么？","style":2,"background":1037,"log_type":1,"src_id":150303071,"trial_step":71},{"step":72,"content":"观星者的脸上是从未见过的严肃表情，冰冷地如同沙海夜晚升起的月亮。","style":3,"background":1037,"log_type":1,"src_id":150303072,"trial_step":72},{"step":73,"speaker":"观星者","content":"我的小怪物……我的MBCC的局长大人……","voice":["vo_trial_50303_1_73"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303073,"trial_step":73},{"step":74,"speaker":"观星者","content":"你……是真实存在于此的人吗？","voice":["vo_trial_50303_1_74"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303074,"trial_step":74},{"step":75,"content":"低沉的话语敲打在你的耳畔，但你还未来得及问她是什么意思，却被她松开了钳制你的双手。","style":3,"background":1037,"log_type":1,"src_id":150303075,"trial_step":75},{"step":76,"content":"呼吸骤然顺畅，可内海阴霾的天气之下，微风扬起的刺鼻的空气灌入你的鼻腔，引起一阵咳嗽。","style":3,"background":1037,"log_type":1,"src_id":150303076,"trial_step":76},{"step":77,"content":"咳咳……","style":2,"background":1037,"log_type":1,"src_id":150303077,"trial_step":77},{"step":78,"speaker":"观星者","content":"既然如此，我就再问你一次吧。","voice":["vo_trial_50303_1_78"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303078,"trial_step":78},{"step":79,"content":"观星者轻轻一挥手，右手出现了在审查室中抽出的最后一张星牌。","style":3,"background":1037,"log_type":1,"src_id":150303079,"trial_step":79},{"step":80,"speaker":"观星者","content":"你是要继续背负这虚假无形的宿命，还是与我一起踏上真实之路？","voice":["vo_trial_50303_1_80"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303080,"trial_step":80},{"step":81,"content":"观星者举着一张卡牌，一步步朝你紧逼，周身无意之间散发出的威压让你不由地往后退去一步——","style":3,"background":1037,"log_type":1,"src_id":150303081,"trial_step":81},{"step":82,"content":"糟……！","style":2,"background":1037,"log_type":1,"src_id":150303082,"trial_step":82},{"step":83,"content":"废墟雕像的站立位置比你想象的要小，你一脚踏空，整个人往后倒去，即将坠落。","style":3,"background":1037,"log_type":1,"src_id":150303083,"trial_step":83},{"step":84,"speaker":"观星者","content":"不要跑，我的小怪物。","voice":["vo_trial_50303_1_84"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303084,"trial_step":84},{"step":85,"content":"面前的人伸出一只手来，一把抓住了你的衣领，让你整个人悬空在了废墟之上。","style":3,"background":1037,"log_type":1,"src_id":150303085,"trial_step":85},{"step":86,"content":"尖锐的指甲划过脸颊，刺痛感袭来，你感受到一小股液体在脸上缓缓流下。","style":3,"background":1037,"log_type":1,"src_id":150303086,"trial_step":86},{"step":87,"speaker":"观星者","content":"你厌恶我的预言游戏，想要亲手打破我的结论，但现在，你的生死掌握在我的手里。","voice":["vo_trial_50303_1_87"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303087,"trial_step":87},{"step":88,"content":"破碎防线的防护罩破裂，本身已经感染的人们，直面着内海的污染，飞速感染成了死役。他……它们的意识散去，异方晶似乎已经无法吸引它们了，转头往你的方向走来。","style":3,"background":1037,"log_type":1,"src_id":150303088,"trial_step":88},{"step":89,"content":"疯狂压过了欲望，比起异方晶，它们似乎对你的血液更加感兴趣。","style":3,"background":1037,"log_type":1,"src_id":150303089,"trial_step":89},{"step":90,"speaker":"观星者","content":"它们过来了……如果我放手，你将被它们吞噬。如果你动用枷锁……那便正合我意，我们一起……回应内海的呼唤。它们和幻花一样……会接纳最真实的我们。","voice":["vo_trial_50303_1_90"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303090,"trial_step":90},{"step":91,"speaker":"观星者","content":"所以，你要不要成为我的同伴？","voice":["vo_trial_50303_1_91"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303091,"trial_step":91},{"step":92,"speaker":"观星者","content":"我会保护你，不被蚂蚁啃噬，不被挂在枝丫上……","voice":["vo_trial_50303_1_92"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303092,"trial_step":92},{"step":93,"content":"谢谢你的好意，但是……","style":2,"background":1037,"log_type":1,"src_id":150303093,"trial_step":93},{"step":94,"content":"你身上的外套掉落下去，而一直藏在外套下的手里，出现了一把简单的手枪。","style":3,"background":1037,"log_type":1,"src_id":150303094,"trial_step":94},{"step":95,"content":"我选择自己打破预言。","style":2,"background":1037,"log_type":1,"src_id":150303095,"trial_step":95},{"step":96,"speaker":"观星者","content":"你想做什么？！","voice":["vo_trial_50303_1_96"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303096,"trial_step":96},{"step":97,"content":"你紧握住那只抓着你的手，把枪口抵在了她的手背中央。","style":3,"background":1037,"log_type":1,"src_id":150303097,"trial_step":97},{"step":98,"options":["开枪","不开枪"],"style":6,"background":1037,"log_type":1,"src_id":150303098,"trial_step":98,"course":3,"choices":[{"text":"开枪","goto":99},{"text":"不开枪","goto":103}]},{"step":99,"content":"你毫不犹豫地扣动扳机，这样的果决让观星者飞快地松开了手。","style":3,"background":1037,"log_type":1,"src_id":150303099,"trial_step":99},{"step":100,"content":"子弹炸开的声音让你的大脑和耳朵一起嗡鸣，你看着周围的景色在瞬间划走，死役们的声音则愈发的清晰起来。","style":3,"background":1037,"log_type":1,"src_id":150303100,"trial_step":100},{"step":101,"content":"我赢了。","style":2,"background":1037,"log_type":1,"src_id":150303101,"trial_step":101},{"step":102,"content":"你不知道自己是否发出了声音，但你尽了自己最大的努力，在坠落中表达。","style":3,"background":1037,"log_type":1,"src_id":150303102,"trial_step":102,"next":[111]},{"step":103,"speaker":"观星者","content":"这就是你的答案吗？","voice":["vo_trial_50303_1_103"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303103,"trial_step":103},{"step":104,"content":"面对禁闭者的威胁，我有权利开枪。","style":2,"background":1037,"log_type":1,"src_id":150303104,"trial_step":104},{"step":105,"speaker":"观星者","content":"你……不是还有更便利的方法吗？","voice":["vo_trial_50303_1_105"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303105,"trial_step":105},{"step":106,"content":"你在指引我使用枷锁？","style":2,"background":1037,"log_type":1,"src_id":150303106,"trial_step":106},{"step":107,"content":"我不知道你在盘算什么，但我有属于我自己的原则……或者说，我认为还不到使用枷锁的时候。","style":2,"background":1037,"log_type":1,"src_id":150303107,"trial_step":107},{"step":108,"content":"观星者一直以来的微笑不见了，她冷冷地看着你，轻轻开口道。","style":3,"background":1037,"log_type":1,"src_id":150303108,"trial_step":108},{"step":109,"speaker":"观星者","content":"既然如此……永别了，我的小怪物。","voice":["vo_trial_50303_1_109"],"voice_bank":"vo_anarkia_trial","style":1,"background":1037,"log_type":1,"src_id":150303109,"trial_step":109},{"step":110,"content":"观星者松开了手，坠落的失重感一瞬间朝你袭来","style":3,"background":1037,"log_type":1,"src_id":150303110,"trial_step":110},{"step":111,"content":"你撞上那些快速腐烂的肉体，在视线被汹涌而来的死役完全遮挡前，你看到观星者的眼睛。","style":3,"background":10000,"log_type":1,"src_id":150303111,"trial_step":111},{"step":112,"content":"深邃得发狂一般的紫色，像通往真实之境那条路上，尽头的门扉的颜色。","style":3,"background":10000,"log_type":1,"src_id":150303112,"trial_step":112}]}