{"id":400301401,"chapter_id":50014,"scene_id":51404,"steps":[{"step":1,"speaker":"莎夏","content":"诶——你们怎么都不说话了？","voice":["vo_event_03014_1"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":2,"speaker":"莎夏","content":"是真的吵架了么？","voice":["vo_event_03014_2"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":3,"content":"没有回答，禁闭者们只是一前一后地默默地向前走着，而莎夏则被晾在队伍的后面。","style":3,"background":2025,"log_type":1},{"step":4,"speaker":"莎夏","content":"啊——？为什么啊！这样好无聊啊……比之前还要无聊——","voice":["vo_event_03014_4"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":5,"speaker":"雷比尼斯","content":"尝试，失败。记录次数，31。","voice":["vo_event_03014_5"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":6,"content":"走在后方的赫卡蒂也在自己的画册上又标注了一条错误路线。","style":3,"background":2025,"log_type":1},{"step":7,"speaker":"莎夏","content":"诶！！这幅画……好奇怪啊！","voice":["vo_event_03014_7"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":8,"content":"走在前面的莎夏一边端详着一副空空如也的画作，一边向后面的二人招手。","style":3,"background":2025,"log_type":1},{"step":9,"content":"赫卡蒂只是看了她一眼，便继续赶路。对她来说，尽快找到局长才是最重要的事。","style":3,"background":2025,"log_type":1},{"step":10,"content":"直到雷比尼斯经过那副画。","style":3,"background":2025,"log_type":1},{"step":11,"content":"空白的画作突然像是有了生命一般，自己涂抹了起来。","style":3,"background":2025,"log_type":1},{"step":12,"speaker":"雷比尼斯","content":"疑惑，难道这是AI作画？","voice":["vo_event_03014_14"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":13,"content":"雷比尼斯一脸疑惑地看着墙上刚画好的画作，是一幅猫咪和主人的画像，画像的阴暗角落里，还散落着像是机器人的零件。","style":3,"background":2025,"log_type":1},{"step":14,"speaker":"大丽花导览","content":"它的名字是《失去》。","voice":["vo_event_03014_16"],"voice_bank":"vo_event_03_p1b","style":11,"background":2025,"log_type":1},{"step":15,"content":"“恩菲尔”的声音适时响起，像在回答雷比尼斯的问题，又像意有所指。","style":3,"background":2025,"log_type":1},{"step":16,"content":"雷比尼斯并不理会导览员，她只想尽快完成任务。","style":3,"background":2025,"log_type":1},{"step":17,"speaker":"雷比尼斯","content":"现在，主人还在等我。Ⅲ型智能女仆会一直执行指令。除非，确认任务目标死亡。","voice":["vo_event_03014_20"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":18,"speaker":"大丽花导览","content":"真是个冷酷无情的机器人。","voice":["vo_event_03014_21"],"voice_bank":"vo_event_03_p1b","style":11,"background":2025,"log_type":1},{"step":19,"speaker":"大丽花导览","content":"你说对吗？","voice":["vo_event_03014_22"],"voice_bank":"vo_event_03_p1b","style":11,"background":2025,"log_type":1},{"step":20,"content":"随着AI的一声叹息，画作开始发生了变化。","style":3,"background":2025,"log_type":1},{"step":21,"speaker":"？？","content":"喵——","style":1,"background":2025,"log_type":1},{"step":22,"speaker":"雷比尼斯","content":"？","style":1,"background":2025,"log_type":1},{"step":23,"content":"猫的叫声让雷比尼斯停下了脚步，甚至……她也不清楚为什么要停下脚步。","style":3,"background":2025,"log_type":1},{"step":24,"speaker":"？？","content":"喵——","style":1,"background":2025,"log_type":1},{"step":25,"content":"雷比尼斯回过头，目睹了不可能发生的一幕——","style":3,"background":2025,"log_type":1},{"step":26,"content":"有一只猫正挣扎着，爬出画作。","style":3,"background":2025,"log_type":1},{"step":27,"content":"这场面本应无比陌生……可她却又对这一幕无比熟悉。","style":3,"background":2025,"log_type":1},{"step":28,"content":"那好像是一个晚上，她失去一切的……一个晚上。","style":3,"background":2025,"log_type":1},{"step":29,"speaker":"莎夏","content":"嘿！你们在看什么呢？看画？","voice":["vo_event_03014_26"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":30,"speaker":"莎夏","content":"这里的猫猫好好看啊！看起来就很好rua——","voice":["vo_event_03014_28"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":31,"content":"莎夏的嗅觉一直很灵敏，她不愿意错过任何有意思的东西，举着自拍杆飞奔而来。","style":3,"background":2025,"log_type":1},{"step":32,"speaker":"赫卡蒂","content":"别碰它！","voice":["vo_event_03014_29"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":33,"content":"显然警告没有跟上莎夏的速度，当莎夏的手触及这幅画时，浓郁的黑雾喷薄而出。","style":3,"background":2025,"log_type":1},{"step":34,"content":"坏掉的人，发狂的猫，还有残破的机器人……一个又一个地钻出了画作，缓缓向你们走来。","style":3,"background":2025,"log_type":1}]}