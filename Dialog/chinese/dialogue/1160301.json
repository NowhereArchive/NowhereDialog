ing":1160304},{"step":120,"content":"结束测试。","style":18,"log_type":1,"src_id":2,"trial_step":109,"course":6,"drawing":1160304},{"step":121,"content":"安，其实今天的审查，还有别的目的……","style":2,"log_type":1,"src_id":260301110,"trial_step":110,"drawing":1160304},{"step":122,"content":"FAC要求，必须处理这些污染样本，解除狂厄传播风险。","style":2,"log_type":1,"src_id":260301111,"trial_step":111,"drawing":1160304},{"step":123,"speaker":"安","content":"处……理？","style":1,"log_type":1,"src_id":260301113,"trial_step":113,"drawing":1160301},{"step":124,"content":"她抬起头，不可置信的望向你，声音有些干涩。","style":3,"log_type":1,"src_id":260301114,"trial_step":114,"drawing":1160301},{"step":125,"content":"嗯……择日销毁。","style":2,"log_type":1,"src_id":260301115,"trial_step":115,"drawing":1160301},{"step":126,"speaker":"安","content":"……","style":1,"log_type":1,"src_id":260301116,"trial_step":116,"drawing":1160301},{"step":127,"content":"她有些脱力地靠在椅背上，说不出话。","style":3,"log_type":1,"src_id":260301117,"trial_step":117,"drawing":1160301},{"step":128,"content":"我一开始没有告诉你，因为在彼岸就能看出，这些死役对你而言有很深的意义。","style":2,"log_type":1,"src_id":260301118,"trial_step":118,"drawing":1160301},{"step":129,"content":"我本来是想通过这次审查，调查你和它们之间的联系，但我没想到……抱歉。","style":2,"log_type":1,"src_id":260301119,"trial_step":119,"drawing":1160301},{"step":130,"speaker":"安","content":"您……也支持销毁吗？","style":1,"log_type":1,"src_id":260301120,"trial_step":120,"drawing":1160304},{"step":131,"content":"她努力克制着抽噎的冲动，呼吸明显颤抖着。","style":3,"log_type":1,"src_id":260301121,"trial_step":121,"drawing":1160304},{"step":132,"content":"彼岸地下的隔离区已经遭到破坏，污染风险已经暴露，必须得到控制。","style":2,"log_type":1,"src_id":260301122,"trial_step":122,"drawing":1160304},{"step":133,"content":"安……它们对你而言，或许还“活着”，但对于其他人而言，只是潜在的危险。","style":2,"log_type":1,"src_id":260301123,"trial_step":123,"drawing":1160304},{"step":134,"speaker":"安","content":"……","style":1,"log_type":1,"src_id":260301124,"trial_step":124,"drawing":1160304},{"step":135,"speaker":"安","content":"当我的患者、同事正被狂厄折磨时，就是FAC拿起武器守在防控点外，切断了我们所有的生路。","style":1,"log_type":1,"src_id":260301125,"trial_step":125,"drawing":1160304},{"step":136,"speaker":"安","content":"现在又要用一样的理由，让我再次抛弃这些患者？","style":1,"log_type":1,"src_id":260301126,"trial_step":126,"drawing":1160304},{"step":137,"content":"这怎么能算抛弃呢？","style":2,"log_type":1,"src_id":260301127,"trial_step":127,"drawing":1160304},{"step":138,"speaker":"安","content":"对，是我忘了……您已经不是我的病人了，而是FAC的下属，MBCC的局长，您和FAC是一样的。","style":1,"log_type":1,"src_id":260301128,"trial_step":128,"drawing":1160304},{"step":139,"content":"她捧起那本写满冰冷数据的笔记，像是怀抱着易碎的珍宝。","style":3,"log_type":1,"src_id":260301129,"trial_step":129,"drawing":1160304},{"step":140,"speaker":"安","content":"放心，佩儿，姐姐不会把你交出去的。","style":1,"log_type":1,"src_id":260301130,"trial_step":130,"drawing":1160304},{"step":141,"speaker":"安","content":"赫罗","style":1,"log_type":1,"src_id":260301131,"trial_step":131,"drawing":1160304},{"step":142,"content":"她不顾你的阻拦，起身离开了审查室，脚步有些虚浮。","style":3,"background":10000,"log_type":1,"src_id":260301132,"trial_step":132,"drawing":1160304},{"step":143,"speaker":"安","content":"你们的精神还活着，我能听见……一定是这样……一定……","style":1,"background":10000,"log_type":1,"src_id":260301133,"trial_step":133},{"step":144,"content":"喃喃自语的声音在门外，一点点远去。","style":3,"background":10000,"log_type":1,"src_id":260301134,"trial_step":134},{"step":145,"content":"审查室只剩下你一人，夜莺的通讯打断了这份无奈的沉寂——","style":3,"background":1000,"log_type":1,"src_id":260301135,"trial_step":135},{"step":146,"speaker":"夜莺","content":"局长，她这样真的没问题吗？","style":11,"background":1000,"log_type":1,"src_id":260301136,"trial_step":136},{"step":147,"content":"……你觉得安是个什么样的人？","style":2,"background":1000,"log_type":1,"src_id":260301137,"trial_step":137},{"step":148,"speaker":"夜莺","content":"根据彼岸这次行动传回的报告和她在管理局内的表现，是个沉稳可靠的护理长，医疗部的工作人员都很依赖她。","style":11,"background":1000,"log_type":1,"src_id":260301138,"trial_step":138},{"step":149,"content":"是的，安的职业素养决定了她不是冲动行事的人，也正因为如此，她看似幼稚的坚持，可能已经经历过了无数次挣扎。","style":2,"background":1000,"log_type":1,"src_id":260301139,"trial_step":139},{"step":150,"content":"要想让她放下这份坚持，只靠我的劝说是没有用的。","style":2,"background":1000,"log_type":1,"src_id":260301140,"trial_step":140},{"step":151,"speaker":"夜莺","content":"局长觉得她能自己想明白？","style":11,"background":1000,"log_type":1,"src_id":260301141,"trial_step":141},{"step":152,"options":["我相信她","我不想逼她"],"style":6,"background":1000,"log_type":1,"src_id":260301142,"trial_step":142,"course":3,"choices":[{"text":"我相信她","goto":143},{"text":"我不想逼她","goto":144}]},{"step":153,"content":"安连已故患者的性命都无法放弃，她不会真的任由污染扩散。","style":2,"background":1000,"log_type":1,"src_id":260301143,"trial_step":143,"next":[145]},{"step":154,"content":"我希望和禁闭者成为相互信赖的朋友。逼迫只会适得其反。","style":2,"background":1000,"log_type":1,"src_id":260301144,"trial_step":144,"next":[145]},{"step":155,"content":"暂时先将彼岸地下隔离区包围保护起来，在安做出决定前，禁止一般民众靠近。","style":2,"background":1000,"log_type":1,"src_id":260301145,"trial_step":145},{"step":156,"speaker":"夜莺","content":"FAC那边……","style":11,"background":1000,"log_type":1,"src_id":260301146,"trial_step":146},{"step":157,"content":"我会向上沟通，尽快推进清理工作。她现在是我的禁闭者，任何问题，我来承担。","style":2,"background":1000,"log_type":1,"src_id":260301147,"trial_step":147},{"step":158,"content":"是选择她曾亲如一家、在梦中日日呼救的89组污染样本，还是选择清除潜在风险，安必须做出取舍。","style":3,"background":1000,"log_type":1,"src_id":260301148,"trial_step":148},{"step":159,"content":"而这一步，由她自己迈出，才有意义。她只是需要一个契机。","style":3,"background":1000,"log_type":1,"src_id":260301149,"trial_step":149},{"step":160,"content":"谁能成为这个重要契机呢？一个名字脱口而出——","style":3,"background":1000,"log_type":1,"src_id":260301150,"trial_step":150},{"step":161,"content":"佩儿？","style":2,"background":1000,"log_type":1,"src_id":260301151,"trial_step":151}]}