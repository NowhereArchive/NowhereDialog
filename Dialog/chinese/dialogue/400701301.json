{"id":400701301,"chapter_id":50019,"scene_id":51904,"steps":[{"step":1,"content":"能见度不超过10米，那些怪物徘徊在浓雾中，随时准备吞噬掉下一个受害者。","style":3,"background":10000,"log_type":1},{"step":2,"speaker":"%u","content":"哈、哈…………","style":2,"background":10000,"log_type":1},{"step":3,"content":"你脚下一绊，跌入道边一条狭窄的暗巷，融进暗巷的阴影中。","style":3,"background":10000,"log_type":1},{"step":5,"content":"巷中的怪物并未直接对你发起进攻，反而颇为忌惮地与你拉开距离。","style":3,"background":2080,"log_type":1},{"step":6,"options":["抬手"],"jump":[7],"style":6,"background":2080,"log_type":1},{"step":7,"content":"看到你的动作，它们又远了几分，嫌弃又憎恶，仿佛拥有灵智，又像是本能地趋吉避凶——它们在避着你，出于某种未知或是被忘记的原因。","style":3,"background":2080,"log_type":1},{"step":8,"options":["找个安全的地方躲起来"],"jump":[9],"style":6,"background":2080,"log_type":1},{"step":9,"content":"怪物后退，你得以朝小巷更深处撤退。这里雾气潮湿冰冷，将小巷衬得更加危险阴暗。","style":3,"background":2080,"log_type":1},{"step":10,"content":"——但这条暗巷让你感到熟悉。","style":3,"background":2080,"log_type":1},{"step":11,"content":"突然。","style":3,"background":2080,"log_type":1},{"step":12,"content":"——嚓——","voice":["vo_event_400701301_12"],"voice_bank":"vo_event_07013","style":3,"background":4115,"log_type":1},{"step":14,"content":"——咔嚓、咔嚓——","voice":["vo_event_400701301_12"],"voice_bank":"vo_event_07013","style":3,"background":4116,"log_type":1},{"step":15,"content":"熟悉而冰冷的感觉顺着脊骨迅速蔓延到后脑，声音来自浓雾深处，也来自你的记忆深处。","style":3,"background":10000,"log_type":1},{"step":16,"content":"你来过这里，你跟谁战斗过。","style":3,"background":10000,"log_type":1},{"step":17,"content":"记忆碎片搅拌着头痛在大脑中翻滚，暗巷、浓雾、钟声、无法停止的……咔嚓声？","style":3,"background":10000,"log_type":1},{"step":18,"speaker":"居民","content":"疯剪子？！不要、不要过来！！","voice":["vo_event_400701201_18"],"voice_bank":"vo_event_07012","style":1,"background":2080,"log_type":1},{"step":19,"content":"咔嚓。","style":3,"background":2080,"log_type":1},{"step":20,"content":"记忆与现实重叠，剪刀声渐近。","style":3,"background":2080,"log_type":1},{"step":21,"content":"浓雾深处，某个身影被雾气遮挡，隐约显现的四肢纤细柔弱——而那只巨形剪刀正划过墙壁，发出饥饿的咀嚼声。","style":3,"background":2080,"log_type":1},{"step":22,"speaker":"疯剪子","content":"……找到了……","voice":["vo_event_400701301_20"],"voice_bank":"vo_event_07013","style":1,"background":2080,"log_type":1},{"step":23,"speaker":"疯剪子","content":"找到你了！！！！！","voice":["vo_event_400701301_21"],"voice_bank":"vo_event_07013","style":1,"background":2080,"log_type":1}]}