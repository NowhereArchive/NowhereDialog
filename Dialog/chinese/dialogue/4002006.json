{"id":4002006,"chapter_id":50003,"scene_id":5304,"steps":[{"step":1,"content":"10月1日 凌晨03:23\n新城14区 - 街道","style":9,"background":1001,"log_type":1},{"step":2,"content":"新城仍旧喧闹，你跟着杜走在路旁，后面不远处跟着两个蹑手蹑脚的禁闭者。","style":3,"background":1001,"log_type":1},{"step":3,"speaker":"杜","content":"梦露……梦露……甘多那狗东西，不*文明*早说。","voice":["vo_event2_401_1"],"voice_bank":"vo_event_02","style":1,"background":1001,"log_type":1},{"step":4,"speaker":"选项","options":["甘多医师挺想帮你振作的"],"jump":[5],"style":6,"background":1001,"log_type":1},{"step":5,"speaker":"杜","content":"喝——呸！多管闲事，来看我笑话罢了！","voice":["vo_event2_401_2"],"voice_bank":"vo_event_02","style":1,"background":1001,"log_type":1},{"step":6,"content":"继续聊老朋友只会继续点燃他的火气，你适时地转换话题。","style":3,"background":1001,"log_type":1},{"step":7,"speaker":"选项","options":["所以梦露到底是什么？"],"jump":[8],"style":6,"background":1001,"log_type":1},{"step":8,"speaker":"杜","content":"不知道，我对这名字有印象，这两天一定在哪儿听到过……*文明*怎么就记不起来！","voice":["vo_event2_401_3"],"voice_bank":"vo_event_02","style":1,"background":1001,"log_type":1},{"step":9,"content":"你叹了口气。","style":3,"background":1001,"log_type":1},{"step":10,"speaker":"选项","options":["先回我们见面的地方看看吧"],"jump":[11],"style":6,"background":1001,"log_type":1},{"step":11,"speaker":"${PlayerName}","content":"去唤夏公馆后门。当时你身边还有两个梦游者，他俩肯定是直接服用过梦露才会变成那个样子。","style":2,"background":1001,"log_type":1},{"step":12,"content":"杜瞪了你一眼。","style":3,"background":1001,"log_type":1},{"step":13,"speaker":"杜","content":"你是探长我是探长？过来！","voice":["vo_event2_401_4"],"voice_bank":"vo_event_02","style":1,"background":1001,"log_type":1},{"step":14,"speaker":"选项","options":["……","绕开"],"jump":[15,15],"style":6,"background":1001,"log_type":1},{"step":15,"content":"眼看这人还在犯迷糊，你叹了口气，考虑联系夜莺——从刚刚袭击你们的两个“梦游者”入手调查，或者找第九机关弄点街道摄像看看。","style":3,"background":1001,"log_type":1},{"step":16,"content":"就在这时，一个漆黑的薄片被吹到你面前，风一吹，薄片转了90度，竟是一个长着四叶草头的怪异身影。","style":3,"background":1001,"log_type":1},{"step":17,"speaker":"黑色四叶草","content":"<i><color=#7683a2>想成为幸运星吗？</i></color>","voice":["vo_event2_401_5"],"voice_bank":"vo_event_02","style":1,"background":1001,"log_type":1},{"step":18,"speaker":"黑色四叶草","content":"<i><color=#7683a2>想要我的好运吗？</i></color>","voice":["vo_event2_401_6"],"voice_bank":"vo_event_02","style":1,"background":1001,"log_type":1},{"step":19,"speaker":"黑色四叶草","content":"<i><color=#7683a2>都给你都给你都给你都给你都给你都给你都给你都给你都给你都给你都给你都给你都给你都给你都给你都给你都给你都给你！！！</i></color>","voice":["vo_event2_401_7"],"voice_bank":"vo_event_02","style":1,"background":1001,"log_type":1},{"step":20,"speaker":"杜","content":"是黑泥？附近有梦游者！","voice":["vo_event2_401_8"],"voice_bank":"vo_event_02","style":1,"background":1001,"log_type":1},{"step":21,"speaker":"赫卡蒂","content":"海拉，隐蔽行动，不要暴露——","voice":["vo_event2_401_9"],"voice_bank":"vo_event_02","style":1,"background":1001,"log_type":1},{"step":22,"speaker":"海拉","content":"这*文明狄斯*都已经在大街上开打了，还隐蔽个锤子啊？！","voice":["vo_event2_401_10"],"voice_bank":"vo_event_02","style":1,"background":1001,"log_type":1}]}