{"id":1120101,"chapter_id":1120101,"scene_id":1,"steps":[{"step":1,"content":"通往审查室的走廊里，只有警示灯机械地闪烁着。","style":3,"background":10000,"log_type":1,"src_id":220101001,"trial_step":1},{"step":2,"content":"九十九跟在你的身后，沉重的呼吸声伴随着特制锁链拖过地面的摩擦声，让人起了一身鸡皮。","style":3,"background":10000,"log_type":1,"src_id":220101002,"trial_step":2},{"step":3,"content":"你能明显地感受到，身后的人即便是被剥夺了视觉与行动能力，依然是一个极度危险的人。","style":3,"background":10000,"log_type":1,"src_id":220101003,"trial_step":3},{"step":4,"speaker":"九十九","content":"是你？","voice":["vo_trial_120101_1_5"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101005,"trial_step":5,"drawing":1120104},{"step":5,"options":["你认出我了？","嗯，我们见过面。"],"style":6,"log_type":1,"src_id":220101006,"trial_step":6,"course":3,"drawing":1120104,"choices":[{"text":"你认出我了？","goto":7},{"text":"嗯，我们见过面。","goto":null}]},{"step":6,"speaker":"九十九","content":"我认得你的气味。","voice":["vo_trial_120101_1_7"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101007,"trial_step":7,"drawing":1120104},{"step":7,"content":"九十九端坐在你面前，安静得仿佛之前发生的一切都是梦境。","style":3,"log_type":1,"src_id":220101008,"trial_step":8,"drawing":1120104},{"step":8,"content":"但尽管如此，你依旧感受到她的身上充斥着野兽的本能，就算是深陷黑暗，感官也依旧敏锐，让你不由得坐直身子。","style":3,"log_type":1,"src_id":220101009,"trial_step":9,"drawing":1120104},{"step":9,"options":["询问追杀。"],"style":6,"log_type":1,"src_id":220101010,"trial_step":10,"course":3,"drawing":1120104,"choices":[{"text":"询问追杀。","goto":11}]},{"step":10,"content":"毕竟几天前的现在，你正拿着刀追着我砍……FAC对你的定义是高级别危险人员。","style":2,"log_type":1,"src_id":220101011,"trial_step":11,"drawing":1120104},{"step":11,"speaker":"九十九","content":"军团让我活捉你。","voice":["vo_trial_120101_1_12"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101012,"trial_step":12,"drawing":1120104},{"step":12,"speaker":"九十九","content":"收了他们的钱，就要做对应的事。","voice":["vo_trial_120101_1_13"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101013,"trial_step":13,"drawing":1120104},{"step":13,"content":"你经常做这些事情？","style":2,"log_type":1,"src_id":220101014,"trial_step":14,"drawing":1120104},{"step":14,"speaker":"九十九","content":"什么事情？","voice":["vo_trial_120101_1_15"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101015,"trial_step":15,"drawing":1120104},{"step":15,"content":"追砍你的目标。","style":2,"log_type":1,"src_id":220101016,"trial_step":16,"drawing":1120104},{"step":16,"speaker":"九十九","content":"嗯，因为他们会给钱，我们需要钱。","voice":["vo_trial_120101_1_17"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101017,"trial_step":17,"drawing":1120104},{"step":17,"speaker":"九十九","content":"把人解决掉的任务是最简单的。","voice":["vo_trial_120101_1_18"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101018,"trial_step":18,"drawing":1120104},{"step":18,"content":"九十九回答得轻而易举，仿佛在说着一件极为寻常的事情。","style":3,"log_type":1,"src_id":220101019,"trial_step":19,"drawing":1120104},{"step":19,"content":"可在你的心底，恐惧的预感不安地蔓延，枷锁在跳动着，提醒着你。","style":3,"log_type":1,"src_id":220101020,"trial_step":20,"drawing":1120104},{"step":20,"content":"——这个女人，与其他任何一个被你束缚的禁闭者……都不一样。","style":3,"log_type":1,"src_id":220101021,"trial_step":21,"drawing":1120104},{"step":21,"content":"就算你是自愿归入MBCC，我们依然需要对你例行询问，以确定你的威胁性。","style":2,"log_type":1,"src_id":220101022,"trial_step":22,"drawing":1120104},{"step":22,"content":"希望你能配合我。","style":2,"log_type":1,"src_id":220101023,"trial_step":23,"drawing":1120104},{"step":23,"speaker":"九十九","content":"我会回答任何问题。","voice":["vo_trial_120101_1_24"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101024,"trial_step":24,"drawing":1120104},{"step":24,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":25,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":26,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":27,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":28,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":29,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":30,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":31,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":32,"options":["军团的任务。"],"style":6,"log_type":1,"src_id":220101026,"trial_step":26,"course":3,"drawing":1120104,"choices":[{"text":"军团的任务。","goto":27}]},{"step":33,"speaker":"九十九","content":"我刚才已经回答过了。","voice":["vo_trial_120101_1_27"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101027,"trial_step":27,"drawing":1120104},{"step":34,"speaker":"九十九","content":"他们让我活捉你。","voice":["vo_trial_120101_1_28"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101028,"trial_step":28,"drawing":1120104},{"step":35,"content":"你确定你当时的举动，是想活捉我吗？","style":2,"log_type":1,"src_id":220101029,"trial_step":29,"drawing":1120104},{"step":36,"speaker":"九十九","content":"是的，我总是会努力达到任务要求，不然他们会克扣结算。","voice":["vo_trial_120101_1_30"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101030,"trial_step":30,"drawing":1120104},{"step":37,"content":"他们下达的是<color=#fb9259>活捉</color>我。","style":2,"log_type":1,"src_id":220101031,"trial_step":31,"drawing":1120104},{"step":38,"content":"但我认为，那时的你，确实是想要我的命。","style":2,"log_type":1,"src_id":220101032,"trial_step":32,"drawing":1120104},{"step":39,"content":"九十九抬起头，明明眼睛被遮住，却给你一种被眼神洞穿的感觉。","style":3,"log_type":1,"src_id":220101033,"trial_step":33,"drawing":1120104},{"step":40,"speaker":"九十九","content":"我只是在执行我的任务。","voice":["vo_trial_120101_1_34"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101034,"trial_step":34,"drawing":1120104},{"step":41,"options":["……"],"style":6,"log_type":1,"src_id":220101035,"trial_step":35,"course":3,"drawing":1120104,"choices":[{"text":"……","goto":36}]},{"step":42,"speaker":"九十九","content":"他们提供了坐标和解决方案，我会按照他们的要求，对目标进行追杀……或者抓捕。","voice":["vo_trial_120101_1_36"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101036,"trial_step":36,"drawing":1120104},{"step":43,"speaker":"九十九","content":"但你……也很厉害，毕竟你现在还好好地站在这里。","voice":["vo_trial_120101_1_37"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101037,"trial_step":37,"drawing":1120104},{"step":44,"content":"九十九十分配合地回答着你的问题，根本不像一个随时随地会把人砍碎的残暴怪物。","style":3,"log_type":1,"src_id":220101038,"trial_step":38,"drawing":1120104},{"step":45,"content":"可就是这样，反而更让人害怕，你不知道面前的人究竟是真的没动杀心……还是静待时机而已。","style":3,"log_type":1,"src_id":220101039,"trial_step":39,"drawing":1120104},{"step":46,"content":"你集中精力，压抑下枷锁的不安，鼓起勇气继续向九十九提问。","style":3,"log_type":1,"src_id":220101040,"trial_step":40,"drawing":1120104},{"step":47,"options":["地窟怪物"],"style":6,"log_type":1,"src_id":220101041,"trial_step":41,"course":3,"drawing":1120104,"choices":[{"text":"地窟怪物","goto":42}]},{"step":48,"content":"你还记得地窟里那些怪物吗？","style":2,"log_type":1,"src_id":220101042,"trial_step":42,"drawing":1120104},{"step":49,"speaker":"九十九","content":"记得。","voice":["vo_trial_120101_1_43"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101043,"trial_step":43,"drawing":1120104},{"step":50,"speaker":"九十九","content":"它们很强，它们不怕我的刀，不管被打倒多少次，也会继续爬上来。","voice":["vo_trial_120101_1_44"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101044,"trial_step":44,"drawing":1120104},{"step":51,"content":"没错，是很可怕的存在。","style":2,"log_type":1,"src_id":220101045,"trial_step":45,"drawing":1120104},{"step":52,"content":"但我很好奇……那些怪物跟你很相似。","style":2,"log_type":1,"src_id":220101046,"trial_step":46,"drawing":1120104},{"step":53,"content":"你静静地看着九十九，希望能得到一点她不一样的反应。","style":3,"log_type":1,"src_id":220101047,"trial_step":47,"drawing":1120104},{"step":54,"speaker":"九十九","content":"你想问什么。","voice":["vo_trial_120101_1_48"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101048,"trial_step":48,"drawing":1120104},{"step":55,"content":"九十九冷不丁地出声，毫无波澜的声音吓了你一跳。","style":3,"log_type":1,"src_id":220101049,"trial_step":49,"drawing":1120104},{"step":56,"content":"好奇而已。","style":2,"log_type":1,"src_id":220101050,"trial_step":50,"drawing":1120104},{"step":57,"speaker":"九十九","content":"相似是因为它们是从我身上来的。","voice":["vo_trial_120101_1_51"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101051,"trial_step":51,"drawing":1120104},{"step":58,"content":"什么意思？它们是你的克隆体？","style":2,"log_type":1,"src_id":220101052,"trial_step":52,"drawing":1120104},{"step":59,"speaker":"九十九","content":"不，我不知道是什么。","voice":["vo_trial_120101_1_53"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101053,"trial_step":53,"drawing":1120104},{"step":60,"speaker":"九十九","content":"但在我意识模糊的时候，总是会出现了很多长得和我一样的……怪物。","voice":["vo_trial_120101_1_54"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101054,"trial_step":54,"drawing":1120104},{"step":61,"speaker":"九十九","content":"在地窟里，也是一样。","voice":["vo_trial_120101_1_55"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101055,"trial_step":55,"drawing":1120104},{"step":62,"content":"难道是狂厄结晶？！你心里不安的感觉再次扩大。","style":3,"log_type":1,"src_id":220101056,"trial_step":56,"drawing":1120104},{"step":63,"content":"资料确实显示帕尔马实验室确实在进行一些令人不齿的非法实验，并利用狂厄结晶制作狂厄武器。","style":3,"log_type":1,"src_id":220101057,"trial_step":57,"drawing":1120104},{"step":64,"content":"你的感染程度很高……失去意识的时候应当是陷入狂化状态了。","style":2,"log_type":1,"src_id":220101058,"trial_step":58,"drawing":1120104},{"step":65,"content":"按照你所说的，你应该不是第一次出现这样的状况……那么，在帕尔马实验室的时候，就已经是这样了吗？","style":2,"log_type":1,"src_id":220101059,"trial_step":59,"drawing":1120104},{"step":66,"content":"你小心翼翼地说出那个名字，话音未落，你明显感受到审查室的温度猛地提升，九十九的眉骨扬起，即使被黑布遮住，那双眼睛依旧死死地盯着你。","style":3,"log_type":1,"src_id":220101060,"trial_step":60,"drawing":1120104},{"step":67,"speaker":"九十九","content":"是的，我在那里，必须遵从他们说的话，然后，什么都不记得了。","voice":["vo_trial_120101_1_61"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101061,"trial_step":61,"drawing":1120104},{"step":68,"speaker":"九十九","content":"我的体温会变得很高，就像开水一样。","voice":["vo_trial_120101_1_62"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101062,"trial_step":62,"drawing":1120104},{"step":69,"speaker":"九十九","content":"然后，破坏，破坏我看到的一切……","voice":["vo_trial_120101_1_63"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101063,"trial_step":63,"drawing":1120104},{"step":70,"content":"九十九平静地说着她在实验室的遭遇，眼神却一刻没有从你身上移开，像一头随时准备攫取猎物的猛兽。","style":3,"log_type":1,"src_id":220101064,"trial_step":64,"drawing":1120104},{"step":71,"speaker":"九十九","content":"我不清楚为什么，但是，在那个地方……","voice":["vo_trial_120101_1_65"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101065,"trial_step":65,"drawing":1120104},{"step":72,"speaker":"九十九","content":"有很多因我而成的九十九，它们都是那样的怪物。","voice":["vo_trial_120101_1_66"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101066,"trial_step":66,"drawing":1120104},{"step":73,"content":"他们……真的在利用你的狂厄结晶来制作武器？！","style":2,"log_type":1,"src_id":220101067,"trial_step":67,"drawing":1120104},{"step":74,"content":"九十九的话语让你逐渐认清帕尔马实验室的所作所为，你看着九十九，她的眼里明显地流露出让人颤抖的愤恨。","style":3,"log_type":1,"src_id":220101068,"trial_step":68,"drawing":1120104},{"step":75,"content":"可事已至此，你不能放弃深入了解帕尔马实验室的机会，你静下心来，拿起FAC递交给你的另一份资料……","style":3,"log_type":1,"src_id":220101069,"trial_step":69,"drawing":1120104},{"step":76,"content":"测试音效的打断逻辑","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":77,"content":"播放一个长音效，会有个前奏，稍等一会儿。","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":78,"content":"播放相同音效，会继续延续。","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":79,"content":"暂停配置音效，这里测试一下打断。","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":80,"content":"播放一个稍短的音效，在这里等待它结束。","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":81,"content":"配置同名音效，看能否再次播放。","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":82,"content":"结束测试。","style":18,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":83,"options":["深入聊聊吧。"],"style":6,"log_type":1,"src_id":220101071,"trial_step":71,"course":3,"drawing":1120104,"choices":[{"text":"深入聊聊吧。","goto":72}]},{"step":84,"content":"除了进行研究，他们还对你做了什么？","style":2,"log_type":1,"src_id":220101072,"trial_step":72,"drawing":1120104},{"step":85,"speaker":"九十九","content":"这里，那里……适配、对照……我不知道他们在干什么，但是，很疼。","voice":["vo_trial_120101_1_73"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101073,"trial_step":73,"drawing":1120104},{"step":86,"speaker":"九十九","content":"让我去打架……但是一不小心，对面就死掉了。","voice":["vo_trial_120101_1_74"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101074,"trial_step":74,"drawing":1120104},{"step":87,"speaker":"九十九","content":"那个角斗场，墙上的凹痕里，已经被染成黑色，有的时候，还有碎掉的骨头，和粘稠的东西，像泥一样。","voice":["vo_trial_120101_1_75"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101075,"trial_step":75,"drawing":1120104},{"step":88,"content":"九十九的声音里染上了一丝狂热，听她的意思，似乎是想让你也和她打上一架。","style":3,"log_type":1,"src_id":220101076,"trial_step":76,"drawing":1120104},{"step":89,"speaker":"九十九","content":"害怕了吗？因为……我也是怪物。","voice":["vo_trial_120101_1_77"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101077,"trial_step":77,"drawing":1120104},{"step":90,"content":"审查室里，那股无形的压迫感在步步向你紧逼，毫无疑问，你正在和一只“怪物”对话。","style":3,"log_type":1,"src_id":220101078,"trial_step":78,"drawing":1120104},{"step":91,"options":["你到底是什么人？","你是怪物？"],"style":6,"log_type":1,"src_id":220101079,"trial_step":79,"course":3,"drawing":1120104,"choices":[{"text":"你到底是什么人？","goto":80},{"text":"你是怪物？","goto":82}]},{"step":92,"speaker":"九十九","content":"我是九十九。","voice":["vo_trial_120101_1_80"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101080,"trial_step":80,"drawing":1120104},{"step":93,"speaker":"九十九","content":"但我也是一只怪物。","voice":["vo_trial_120101_1_81"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101081,"trial_step":81,"drawing":1120104,"next":[84]},{"step":94,"speaker":"九十九","content":"是的。","voice":["vo_trial_120101_1_82"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101082,"trial_step":82,"drawing":1120104},{"step":95,"speaker":"九十九","content":"帕尔马实验室里的……都是怪物。","voice":["vo_trial_120101_1_83"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101083,"trial_step":83,"drawing":1120104,"next":[84]},{"step":96,"options":["难道海拉也是怪物？"],"style":6,"log_type":1,"src_id":220101084,"trial_step":84,"course":3,"drawing":1120104,"choices":[{"text":"难道海拉也是怪物？","goto":85}]},{"step":97,"speaker":"九十九","content":"……","style":1,"log_type":1,"src_id":220101085,"trial_step":85,"drawing":1120104},{"step":98,"content":"生物的本能让你察觉到危险，面前的九十九虽然没有发出任何声音，却能让你明显感觉到她的越来越沉重的压迫感，一度让人喘不过气来。","style":3,"log_type":1,"src_id":220101086,"trial_step":86,"drawing":1120104},{"step":99,"content":"你……认识她。","style":2,"log_type":1,"src_id":220101087,"trial_step":87,"drawing":1120104},{"step":100,"speaker":"九十九","content":"嗯，我认识她，我不只是认识她。","voice":["vo_trial_120101_1_88"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101088,"trial_step":88,"drawing":1120104},{"step":101,"speaker":"九十九","content":"她不是怪物，她是照亮我的太阳。","voice":["vo_trial_120101_1_89"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101089,"trial_step":89,"drawing":1120104},{"step":102,"speaker":"九十九","content":"她牵着我的手，带我离开了地下，让我获得了……自由。","voice":["vo_trial_120101_1_90"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101090,"trial_step":90,"drawing":1120104},{"step":103,"speaker":"九十九","content":"我会……我会一直，一直保护她。","voice":["vo_trial_120101_1_91"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101091,"trial_step":91,"drawing":1120104},{"step":104,"content":"你着实吃了一惊，在审查海拉时，她丝毫不愿意谈论和九十九有关的消息，你一直以为海拉对九十九极为厌恶——她确实是个分外记仇的小姑娘。","style":3,"log_type":1,"src_id":220101092,"trial_step":92,"drawing":1120104},{"step":105,"content":"可九十九的话让你完全颠覆了这个想法。","style":3,"log_type":1,"src_id":220101093,"trial_step":93,"drawing":1120104},{"step":106,"content":"九十九的呼吸愈发急促，连带着整个审查室都要成为蒸笼。可一阵冷意爬上了你的背脊——那是九十九同时释放的缕缕杀意。","style":3,"log_type":1,"src_id":220101094,"trial_step":94,"drawing":1120104},{"step":107,"speaker":"九十九","content":"……你问完了吗？","voice":["vo_trial_120101_1_95"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101095,"trial_step":95,"drawing":1120104},{"step":108,"content":"什么？","style":2,"log_type":1,"src_id":220101096,"trial_step":96,"drawing":1120104},{"step":109,"content":"只有两人所在的审查室里，九十九第一次开口向你询问事情。明明被束缚住行动，你却依然对她的这句话感到恐慌。","style":3,"log_type":1,"src_id":220101097,"trial_step":97,"drawing":1120104},{"step":110,"content":"九十九默默地坐直起来，遮住警戒照明的灯光。","style":3,"log_type":1,"src_id":220101098,"trial_step":98,"drawing":1120104},{"step":111,"speaker":"九十九","content":"该我问你了。","voice":["vo_trial_120101_1_99"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101099,"trial_step":99,"drawing":1120104},{"step":112,"speaker":"九十九","content":"前不久，MBCC发生了暴动，大家都在讨论这件事。","voice":["vo_trial_120101_1_100"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101100,"trial_step":100,"drawing":1120104},{"step":113,"speaker":"九十九","content":"他们说，禁闭者都逃到了辛迪加……但我没找到她。","voice":["vo_trial_120101_1_101"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101101,"trial_step":101,"drawing":1120104},{"step":114,"speaker":"九十九","content":"我找了很多天，很多地方，都没找到……","voice":["vo_trial_120101_1_102"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101102,"trial_step":102,"drawing":1120104},{"step":115,"speaker":"九十九","content":"你知道……海拉去哪里了吗？","voice":["vo_trial_120101_1_103"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101103,"trial_step":103,"drawing":1120104},{"step":116,"content":"海拉还在MBCC。","style":2,"log_type":1,"src_id":220101105,"trial_step":105,"drawing":1120104},{"step":117,"content":"她本意是想混入暴动趁机逃走，但并没有成功逃脱。","style":2,"log_type":1,"src_id":220101106,"trial_step":106,"drawing":1120104},{"step":118,"speaker":"九十九","content":"没有逃脱成功？","voice":["vo_trial_120101_1_107"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101107,"trial_step":107,"drawing":1120104},{"step":119,"content":"她没能成功破坏牢门，虽然出来之后依然尝试逃走……","style":2,"log_type":1,"src_id":220101108,"trial_step":108,"drawing":1120104},{"step":120,"content":"但她是禁闭者……身为局长我不能放任她就这么溜走。","style":2,"log_type":1,"src_id":220101109,"trial_step":109,"drawing":1120104},{"step":121,"speaker":"九十九","content":"所以……你把她困住了？","voice":["vo_trial_120101_1_110"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101110,"trial_step":110,"drawing":1120104},{"step":122,"content":"或许吧……","style":2,"log_type":1,"src_id":220101111,"trial_step":111,"drawing":1120104},{"step":123,"content":"等我清醒时，枷锁已经套在了她的身上。","style":2,"log_type":1,"src_id":220101112,"trial_step":112,"drawing":1120104},{"step":124,"speaker":"九十九","content":"原来如此。","voice":["vo_trial_120101_1_113"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101113,"trial_step":113,"drawing":1120104},{"step":125,"content":"九十九点点头，像是认可了你的说法一般，然而——","style":3,"log_type":1,"src_id":220101114,"trial_step":114,"drawing":1120104},{"step":126,"speaker":"九十九","content":"可海拉是辛迪加最自由的小老鼠……","voice":["vo_trial_120101_1_115"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101115,"trial_step":115,"drawing":1120104},{"step":127,"speaker":"九十九","content":"黑帮的密室，治安局的笼子……连帕尔马的实验室都关不住她。","voice":["vo_trial_120101_1_116"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101116,"trial_step":116,"drawing":1120104},{"step":128,"speaker":"九十九","content":"怎么会甘心被你束缚……","voice":["vo_trial_120101_1_117"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101117,"trial_step":117,"drawing":1120104},{"step":129,"content":"九十九的语气依旧平静，可是室内不断攀升的温度却明确地告诉你九十九正在暴走。","style":3,"log_type":1,"src_id":220101119,"trial_step":119,"drawing":1120105},{"step":130,"content":"她的皮肤上开始冒出蒸汽，骤然升高的温度将锁链的结构破坏。","style":3,"log_type":1,"src_id":220101120,"trial_step":120,"drawing":1120105},{"step":131,"content":"巨大的黑影在她的身后不断延展，已经变异得漆黑的双手，毫不费力地摘下了防咬器与眼罩。","style":3,"log_type":1,"src_id":220101121,"trial_step":121,"drawing":1120105},{"step":132,"speaker":"九十九","content":"我听说……","voice":["vo_trial_120101_1_120"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101122,"trial_step":122,"drawing":1120100},{"step":133,"speaker":"九十九","content":"局长的枷锁一旦套在了禁闭者的身上，只有一方死亡，枷锁才能斩断……","voice":["vo_trial_120101_1_121"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101123,"trial_step":123,"drawing":1120100},{"step":134,"content":"你忽然意识到，九十九或许并没有单纯到会来主动自首。\n她比你们想象的要更加聪明，或者说，更具有野性的直觉一点——她是来除掉你，营救海拉的。","style":3,"log_type":1,"src_id":220101124,"trial_step":124,"drawing":1120100},{"step":135,"content":"昏暗的审查室里，她的眼睛犹如血红色的卡门·露西娅，紧盯着你的脖颈，那里有最脆弱最致命的动脉。","style":3,"log_type":1,"src_id":220101125,"trial_step":125,"drawing":1120100},{"step":136,"content":"危险铺天盖地的涌来，你发觉自己竟然连一步都无法迈出。","style":3,"log_type":1,"src_id":220101126,"trial_step":126,"drawing":1120100},{"step":137,"speaker":"九十九","content":"你在骗我，局长。","voice":["vo_trial_120101_1_125"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101127,"trial_step":127,"drawing":1120103},{"step":138,"content":"一瞬间，九十九从座椅上向你扑来，周围的空气被她烫出热浪，像顶级掠食者对食物链底端的猎物捕食一般。","style":3,"log_type":1,"src_id":220101128,"trial_step":128,"drawing":1120103},{"step":139,"content":"惊恐促使你本能地释放出枷锁能力，对九十九下达了禁止伤害你的命令。","style":3,"log_type":1,"src_id":220101129,"trial_step":129,"drawing":1120103},{"step":140,"speaker":"九十九","content":"这就是枷锁，这就是你困住我们的工具吗！？","voice":["vo_trial_120101_1_128"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101130,"trial_step":130,"drawing":1120103},{"step":141,"speaker":"九十九","content":"她就是因为这个……才没办法回到我的身边！","voice":["vo_trial_120101_1_129"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101131,"trial_step":131,"drawing":1120103},{"step":142,"content":"九十九被枷锁压制跪地，却完全没有屈服在你的能力之下，一切疼痛都让她变得更加愤怒与狂暴。","style":3,"log_type":1,"src_id":220101132,"trial_step":132,"drawing":1120103},{"step":143,"speaker":"九十九","content":"你们这些……恶心、卑鄙的人！","voice":["vo_trial_120101_1_131"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101133,"trial_step":133,"drawing":1120103},{"step":144,"speaker":"九十九","content":"我要让你们也感受到……我体会过的滋味！","voice":["vo_trial_120101_1_132"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101134,"trial_step":134,"drawing":1120103},{"step":145,"content":"她不顾枷锁的禁令，一次次地试图尝试对你发起攻击，虽然速度变得让你能够完全躲避，但整个审查室也因此开始摇摇欲坠。","style":3,"log_type":1,"src_id":220101135,"trial_step":135,"drawing":1120103},{"step":146,"speaker":"九十九","content":"杀掉你……杀掉你就能让海拉彻底解放！","voice":["vo_trial_120101_1_134"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101136,"trial_step":136,"drawing":1120103},{"step":147,"speaker":"九十九","content":"我们……都能获得自由！！！","voice":["vo_trial_120101_1_135"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101137,"trial_step":137,"drawing":1120103},{"step":148,"content":"链接你们的枷锁发出嗡鸣，似乎下一秒就要被强行挣断；九十九的异能飞溅起雾气，灼伤了你的手臂。","style":3,"log_type":1,"src_id":220101138,"trial_step":138,"drawing":1120103},{"step":149,"speaker":"九十九","content":"你压制不住我的！！你……必须死在我手里！","voice":["vo_trial_120101_1_137"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101139,"trial_step":139,"drawing":1120103},{"step":150,"content":"住手吧，九十九！再这样下去，你会死！","style":2,"log_type":1,"src_id":220101140,"trial_step":140,"drawing":1120103},{"step":151,"speaker":"九十九","content":"我不怕，我只要她，只要我们不再受被人束缚的痛苦！","voice":["vo_trial_120101_1_139"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101141,"trial_step":141,"drawing":1120103},{"step":152,"content":"咳咳……！","style":2,"log_type":1,"src_id":220101142,"trial_step":142,"drawing":1120103},{"step":153,"content":"枷锁的震动越来越强烈，反噬的力量震得你喉头一阵腥甜。","style":3,"log_type":1,"src_id":220101143,"trial_step":143,"drawing":1120103},{"step":154,"content":"那……那你就这么甘愿……让她一个人……留在这个世上……吗？","style":2,"log_type":1,"src_id":220101144,"trial_step":144,"drawing":1120103},{"step":155,"content":"九十九的攻击并没停下，颇为不甘地咬牙切齿后，挤出了几个词。","style":3,"log_type":1,"src_id":220101145,"trial_step":145,"drawing":1120103},{"step":156,"speaker":"九十九","content":"只要她……活着，自由……我，不后悔。","voice":["vo_trial_120101_1_144"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101146,"trial_step":146,"drawing":1120103},{"step":157,"content":"夜莺发现了审查室的异常，迅速介入并喊来了支援进行协助，但你必须保持着对九十九的束缚，否则他们都将在九十九的攻击下丧生。","style":3,"log_type":1,"src_id":220101147,"trial_step":147,"drawing":1120103},{"step":158,"content":"九十九，你不能再使用能力了！你的狂厄在暴走！呃……！哪怕你要变成真的怪物……也无所谓吗？！","style":2,"log_type":1,"src_id":220101148,"trial_step":148,"drawing":1120103},{"step":159,"speaker":"九十九","content":"我就是怪物！把海拉放了！！","voice":["vo_trial_120101_1_147"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101149,"trial_step":149,"drawing":1120103},{"step":160,"content":"十分明显，九十九的异变在加重，狂厄还在继续侵蚀她。对她使用了枷锁的你，精神上也承受了巨大负担。","style":3,"log_type":1,"src_id":220101150,"trial_step":150,"drawing":1120103},{"step":161,"content":"而九十九像是对这样的痛苦极为习惯——她挣扎着，一步步走到你面前，狠狠地掐住了你的脖子。","style":3,"log_type":1,"src_id":220101151,"trial_step":151,"drawing":1120103},{"step":162,"speaker":"九十九","content":"我再说一次，把海拉还给我！","voice":["vo_trial_120101_1_150"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101152,"trial_step":152,"drawing":1120103},{"step":163,"content":"夜莺和支援队员朝她射击，可子弹被她的异能阻挡，推出体外，掐着你脖子的手始终没有松开。你感到自己意识渐渐模糊。","style":3,"log_type":1,"src_id":220101153,"trial_step":153,"drawing":1120103},{"step":164,"speaker":"夜莺","content":"啧，开通信——！","style":1,"log_type":1,"src_id":220101154,"trial_step":154,"drawing":1120103},{"step":165,"speaker":"审讯通讯","content":"不要，九十九！！！别杀他！！！","female_content":"不要，九十九！！！别杀她！！！","style":11,"log_type":1,"src_id":220101155,"trial_step":155,"drawing":1120103},{"step":166,"speaker":"九十九","content":"？！","style":1,"log_type":1,"src_id":220101156,"trial_step":156,"drawing":1120102},{"step":167,"content":"通讯机口传来的声音，让九十九停下了攻击，愣在原地，你感觉到束缚住自己的力量松懈下来。","style":3,"log_type":1,"src_id":220101157,"trial_step":157,"drawing":1120102},{"step":168,"speaker":"九十九","content":"你在……你在哪里？","voice":["vo_trial_120101_1_156"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101158,"trial_step":158,"drawing":1120102},{"step":169,"content":"听到熟悉的声音，迷茫地朝声音源头走去，而夜莺抓住九十九这一破绽，将其制服，并将强力的麻醉剂注入了九十九的颈间。","style":3,"log_type":1,"src_id":220101159,"trial_step":159,"drawing":1120102},{"step":170,"content":"九十九倒下时，撞倒了金属制的椅子，巨大的声响传到通讯的另一边，顿时，对面传来了气急败坏的叫声。","style":3,"log_type":1,"src_id":220101160,"trial_step":160},{"step":171,"speaker":"审讯通讯","content":"九十九？九十九你怎么了？混账东西你们对她做了什么？！！放开我，放开、九十九——！","style":11,"log_type":1,"src_id":220101161,"trial_step":161},{"step":172,"content":"夜莺掐断了通信。但你听出了那个声音，是海拉。","style":3,"log_type":1,"src_id":220101162,"trial_step":162},{"step":173,"content":"九十九的温度渐渐平息，昏睡过去，在向上级报告之后，九十九被关押进了更加严酷的禁闭室。","style":3,"log_type":1,"src_id":220101163,"trial_step":163},{"step":174,"content":"夜莺！结果如何？！","style":2,"background":1017,"log_type":1,"src_id":220101164,"trial_step":164},{"step":175,"speaker":"夜莺","content":"由于禁闭者九十九的暴走，FAC介入了她的审查。","style":1,"background":1017,"log_type":1,"src_id":220101165,"trial_step":165},{"step":176,"speaker":"夜莺","content":"九十九长期接受实验改造，以及在上次的行动中受到了黑水地窟的异变影响。","style":1,"background":1017,"log_type":1,"src_id":220101166,"trial_step":166},{"step":177,"speaker":"夜莺","content":"她的四肢已经异化成了死役状态，并且在逐步扩散到整个身体。","style":1,"background":1017,"log_type":1,"src_id":220101167,"trial_step":167},{"step":178,"speaker":"夜莺","content":"她被捕时已经超过了一级感染阶段，正在向二级感染发展。","style":1,"background":1017,"log_type":1,"src_id":220101168,"trial_step":168},{"step":179,"speaker":"夜莺","content":"您应该感受到了，枷锁已经没有办法停滞她的异变进程。","style":1,"background":1017,"log_type":1,"src_id":220101169,"trial_step":169},{"step":180,"speaker":"夜莺","content":"她很快就会完全成为死役，届时会更加严重地反噬污染你的精神。","style":1,"background":1017,"log_type":1,"src_id":220101170,"trial_step":170},{"step":181,"speaker":"夜莺","content":"FAC不允许你的生命受到任何威胁。","style":1,"background":1017,"log_type":1,"src_id":220101171,"trial_step":171},{"step":182,"content":"他们打算怎么做……","style":2,"background":1017,"log_type":1,"src_id":220101172,"trial_step":172},{"step":183,"speaker":"夜莺","content":"……处死堕化禁闭者九十九。","style":1,"background":1017,"log_type":1,"src_id":220101173,"trial_step":173},{"step":184,"content":"抱歉，当时卷入暴动的人非常多。","style":2,"log_type":1,"src_id":220101177,"trial_step":177,"drawing":1120104},{"step":185,"content":"我们暂时还未筛查出海拉逃去了哪里。","style":2,"log_type":1,"src_id":220101178,"trial_step":178,"drawing":1120104},{"step":186,"speaker":"九十九","content":"……","style":1,"log_type":1,"src_id":220101179,"trial_step":179,"drawing":1120104},{"step":187,"speaker":"九十九","content":"…………","style":1,"log_type":1,"src_id":220101180,"trial_step":180,"drawing":1120104},{"step":188,"speaker":"九十九","content":"不，是你困住了她。","voice":["vo_trial_120101_1_179"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101181,"trial_step":181,"drawing":1120104},{"step":189,"speaker":"九十九","content":"海拉……是辛迪加最自由的小老鼠……从不甘心被束缚。","voice":["vo_trial_120101_1_180"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101182,"trial_step":182,"drawing":1120104},{"step":190,"content":"你的回答很明显刺激到了九十九，她的情绪急剧恶化，变得非常愤怒。","style":3,"log_type":1,"src_id":220101183,"trial_step":183,"drawing":1120104},{"step":191,"content":"她周身的温度不断攀升，挣脱掉了束缚她的锁链。","style":3,"log_type":1,"src_id":220101185,"trial_step":185,"drawing":1120105},{"step":192,"speaker":"九十九","content":"她回不来的原因……只可能是你！","voice":["vo_trial_120101_1_183"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101186,"trial_step":186,"drawing":1120105},{"step":193,"content":"巨大的黑影在她的身后不断延展，已经变异得漆黑的双手，毫不费力地摘下了防咬器与眼罩——","style":3,"log_type":1,"src_id":220101187,"trial_step":187,"drawing":1120105},{"step":194,"speaker":"九十九","content":"你的枷锁，把她困住了。","voice":["vo_trial_120101_1_185"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101188,"trial_step":188,"drawing":1120103},{"step":195,"speaker":"九十九","content":"我只能解决你。","voice":["vo_trial_120101_1_186"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101189,"trial_step":189,"drawing":1120103}]}