{"id":1122,"chapter_id":1,"scene_id":105,"steps":[{"step":1,"speaker":"艾米潘","content":"我投降！大人，投降！赫卡蒂大人别打了——","voice":["vo_cgplot_1122001"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1},{"step":2,"speaker":"赫卡蒂","content":"……局长，还要继续攻击吗？请下命令。","voice":["vo_cgplot_1122002"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1},{"step":3,"speaker":"艾米潘","content":"局——长——啊————！！！","voice":["vo_cgplot_1122003"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1},{"step":4,"content":"她竟直接跳下屋顶，扑通一声拜倒在你面前，就差抱住你的大腿号啕大哭。","style":3,"background":119,"log_type":1},{"step":5,"speaker":"艾米潘","content":"米诺斯危机管理局新任局长大人竟是如此勇猛无比气度不凡！是我有眼不识泰山了，您大人有大量原谅我吧！","voice":["vo_cgplot_1122005"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1},{"step":6,"speaker":"选项","options":["是谁把我打得满地找牙来着？"],"jump":[7],"style":6,"background":119,"log_type":1},{"step":7,"speaker":"艾米潘","content":"没有没有没有不敢不敢不敢！就我那点电量，电麻可以，电死属实不行，您的队友都没事啊局长！","voice":["vo_cgplot_1122007"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1},{"step":8,"speaker":"艾米潘","content":"人在辛迪加身不由己，要生存都得拿出气势装装逼。但、但我这就改邪归正！","voice":["vo_cgplot_1122008"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1},{"step":9,"speaker":"海拉","content":"哇——好丢人的“弓箭死神”，要给管理局当狗了吗？！","voice":["vo_cgplot_1122009"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1},{"step":10,"speaker":"艾米潘","content":"呸，本大爷好歹拥抱过自由，你呢？听说困在里头，连笼子都出不来吧？","voice":["vo_cgplot_1122010"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1},{"step":11,"speaker":"海拉","content":"闭嘴，辛迪加之耻！","voice":["vo_cgplot_1122011"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1},{"step":12,"speaker":"艾米潘","content":"我呸，米诺斯之屑！","voice":["vo_cgplot_1122012"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1},{"step":13,"speaker":"选项","options":["别废话，抓了再说","如果你能为我而战"],"jump":[14,14],"style":6,"background":119,"log_type":1},{"step":14,"speaker":"艾米潘","content":"诶？不不不我就是个没本事的废物，一碰就碎一打就跪，帮不上您忙，您别动手，诶诶，别这样，别、别——","voice":["vo_cgplot_1122014"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1},{"step":15,"speaker":"艾米潘","content":"至少打架别把我放前排啊————","voice":["vo_cgplot_1122015"],"voice_bank":"vo_cgplot_01","style":1,"background":119,"log_type":1}]}