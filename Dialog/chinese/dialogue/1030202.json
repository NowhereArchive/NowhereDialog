{"id":1030202,"chapter_id":1030202,"scene_id":1,"steps":[{"step":1,"speaker":"帮派成员","content":"别跑！","voice":["vo_trial_30202_1_1"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202001,"trial_step":1},{"step":2,"content":"逼仄的小巷中，高大的男人扯住了男孩的袖子，并将他狠狠地掼倒在地。","style":3,"background":1029,"log_type":1,"src_id":130202002,"trial_step":2},{"step":3,"speaker":"帮派成员","content":"把东西交出来！","voice":["vo_trial_30202_1_2"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202003,"trial_step":3},{"step":4,"speaker":"男孩","content":"我没偷你东西……","voice":["vo_trial_30202_1_3"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202004,"trial_step":4},{"step":5,"speaker":"帮派成员","content":"**！臭小鬼嘴里没一句实话！","voice":["vo_trial_30202_1_4"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202005,"trial_step":5},{"step":6,"content":"男人一拳结结实实地打了上去。","style":3,"background":1029,"log_type":1,"src_id":130202006,"trial_step":6},{"step":7,"speaker":"帮派成员","content":"你的同伙呢？你们这些小**把偷来的东西藏到哪儿去了？！","voice":["vo_trial_30202_1_5"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202007,"trial_step":7},{"step":8,"content":"凄厉的尖叫在小巷中显得尤为刺耳。","style":3,"background":1029,"log_type":1,"src_id":130202008,"trial_step":8},{"step":9,"speaker":"男孩","content":"我不知道……我不知道！","voice":["vo_trial_30202_1_6"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202009,"trial_step":9},{"step":10,"content":"男孩上气不接下气地哭喊着，但面前的男人却没有表现出丝毫的心慈手软。","style":3,"background":1029,"log_type":1,"src_id":130202010,"trial_step":10},{"step":11,"speaker":"帮派成员","content":"小兔崽子嘴还挺硬的，那你没用了……","voice":["vo_trial_30202_1_7"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202011,"trial_step":11},{"step":12,"content":"男人将匕首高高举起。","style":3,"background":1029,"log_type":1,"src_id":130202012,"trial_step":12},{"step":13,"options":["挡住匕首"],"style":6,"background":1029,"log_type":1,"src_id":130202013,"trial_step":13,"course":3,"choices":[{"text":"挡住匕首","goto":14}]},{"step":14,"content":"你的手上没有足以抵挡匕首的武器，情急之下，你用手接住了匕首。","style":3,"background":1029,"log_type":1,"src_id":130202014,"trial_step":14},{"step":15,"content":"男人似乎被不知道从哪里冒出来的你吓住了，片刻后才破口大骂道：","style":3,"background":1029,"log_type":1,"src_id":130202015,"trial_step":15},{"step":16,"speaker":"帮派成员","content":"你**的是谁？！","voice":["vo_trial_30202_1_8"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202016,"trial_step":16},{"step":17,"content":"他再一次高举匕首，打算连同你这个碍事的家伙一起解决。可突然间，一股极其可怖的寒意自背后钻入了他每一个毛孔。","style":3,"background":1029,"log_type":1,"src_id":130202017,"trial_step":17},{"step":18,"content":"寒意自脊背一路延伸至后脑。男人手中的匕首悬在了半空，他机械而缓慢地转过头，映入眼帘的是一个小小的、晦暗的身影。","style":3,"background":1029,"log_type":1,"src_id":130202018,"trial_step":18},{"step":19,"content":"下一刻，地面蠕动的影子凝结为实体，狠狠刺进了男人的腹腔。男人被这股巨大的力量掀翻在地，活像个被淘气小孩撕扯玩弄的布娃娃。","style":3,"background":1029,"log_type":1,"src_id":130202019,"trial_step":19},{"step":20,"options":["阻止科希"],"style":6,"background":1029,"log_type":1,"src_id":130202020,"trial_step":20,"course":3,"choices":[{"text":"阻止科希","goto":21}]},{"step":21,"content":"等等，科希！","style":2,"background":1029,"log_type":1,"src_id":130202021,"trial_step":21},{"step":22,"content":"我们可以从他身上找到那些黑帮的情报。","style":2,"background":1029,"log_type":1,"src_id":130202022,"trial_step":22},{"step":23,"content":"你伸出手，被匕首割出的伤口正流着血，但你顾不得这些。","style":3,"background":1029,"log_type":1,"src_id":130202023,"trial_step":23},{"step":24,"content":"如果不加制止，单凭他对那个孩子的所作所为，接下来科希一定会要这个男人的命。","style":3,"background":1029,"log_type":1,"src_id":130202024,"trial_step":24},{"step":25,"speaker":"科希","content":"……多管闲事。","voice":["vo_trial_30202_1_9"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202025,"trial_step":25},{"step":26,"content":"巷口守着的那两个黑帮成员也已倒在地上没了声响。若非那两个人拖延了科希的脚步，大概也轮不到你挡下那一刀。","style":3,"background":1029,"log_type":1,"src_id":130202026,"trial_step":26},{"step":27,"content":"他们没死吧？","style":2,"background":1029,"log_type":1,"src_id":130202027,"trial_step":27},{"step":28,"speaker":"科希","content":"没死，但一时半会儿也动不了。","voice":["vo_trial_30202_1_10"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202028,"trial_step":28},{"step":29,"content":"科希的回答没什么好气。她没再看你，而是径直走向那个男孩身前，影子轻轻将男孩托了起来。","style":3,"background":1029,"log_type":1,"src_id":130202029,"trial_step":29},{"step":30,"speaker":"男孩","content":"科……科希？你回来了？！","voice":["vo_trial_30202_1_11"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202030,"trial_step":30},{"step":31,"speaker":"科希","content":"唔……嗯。","voice":["vo_trial_30202_1_12"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202031,"trial_step":31},{"step":32,"content":"科希嘴里咕哝了两声，算是回答了男孩的问题。","style":3,"background":1029,"log_type":1,"src_id":130202032,"trial_step":32},{"step":33,"speaker":"男孩","content":"你终于回来了！大家都不知道你去哪里了，很担心你呢！","voice":["vo_trial_30202_1_13"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202033,"trial_step":33},{"step":34,"content":"男孩睁大了眼睛，露出缺了两颗门牙的笑容。","style":3,"background":1029,"log_type":1,"src_id":130202034,"trial_step":34},{"step":35,"speaker":"科希","content":"嗯，我没事。","voice":["vo_trial_30202_1_131"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202035,"trial_step":35},{"step":36,"content":"男孩似乎习惯了科希的“冷淡”，面色并没有改变——直到他看见了科希身后的你。","style":3,"background":1029,"log_type":1,"src_id":130202036,"trial_step":36},{"step":37,"speaker":"男孩","content":"这个……大叔是谁？","female_content":"这个……阿姨是谁？","voice":["vo_trial_30202_1_14","vo_trial_30202_1_14f"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202037,"trial_step":37},{"step":38,"content":"男孩的脸上浮现出一种天然的警惕。即便你刚刚救了他，那种对成年人的不信任也无法简简单单地被消弭。","style":3,"background":1029,"log_type":1,"src_id":130202038,"trial_step":38},{"step":39,"content":"你正思考着该如何解释，却没想到科希看了看你手上的伤口，居然替你开口了。","style":3,"background":1029,"log_type":1,"src_id":130202039,"trial_step":39},{"step":40,"speaker":"科希","content":"不用管他，跟我一起过来的，没什么危险。","female_content":"不用管她，跟我一起过来的，没什么危险。","voice":["vo_trial_30202_1_15","vo_trial_30202_1_15f"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202040,"trial_step":40},{"step":41,"speaker":"科希","content":"去据点那边吧，我有事要找他们。","voice":["vo_trial_30202_1_16"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202041,"trial_step":41},{"step":42,"speaker":"男孩","content":"科希也要一起去游乐园吗？太好了！","voice":["vo_trial_30202_1_17"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202042,"trial_step":42},{"step":43,"content":"男孩欢呼着，似乎已经完全忘记了刚刚的惊险。","style":3,"background":1029,"log_type":1,"src_id":130202043,"trial_step":43},{"step":44,"speaker":"男孩","content":"你好久没有回去了，大家都很想你呢！","voice":["vo_trial_30202_1_18"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202044,"trial_step":44},{"step":45,"content":"在男孩的带领下，你们在辛迪加错综复杂的街道中绕行了很久。","style":3,"background":1028,"log_type":1,"src_id":130202045,"trial_step":45},{"step":46,"content":"最后，你们终于停留在了一个小小的“游乐园”之前。","style":3,"background":1028,"log_type":1,"src_id":130202046,"trial_step":46},{"step":47,"content":"那是一个无比简陋的场地，除了秋千和滑梯外什么设施都没有。四周，高大的烂尾楼遮蔽了阳光，为这片年久失修的乐园盖上一层厚厚的阴影。","style":3,"background":1028,"log_type":1,"src_id":130202047,"trial_step":47},{"step":48,"speaker":"男孩","content":"看看是谁回来了？","voice":["vo_trial_30202_1_19"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202048,"trial_step":48},{"step":49,"content":"滑梯之下，许多个小小的“蘑菇”探了出来。","style":3,"background":1028,"log_type":1,"src_id":130202049,"trial_step":49},{"step":50,"speaker":"流浪儿成员","content":"科希？","voice":["vo_trial_30202_1_20"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202050,"trial_step":50},{"step":51,"speaker":"流浪儿成员","content":"科希回来了！","voice":["vo_trial_30202_1_21"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202051,"trial_step":51},{"step":52,"content":"乌泱泱十几个小“蘑菇”一股脑奔着科希涌了过来。他们围在科希身边，又蹦又跳，热闹得仿佛过节。","style":3,"background":1028,"log_type":1,"src_id":130202052,"trial_step":52},{"step":53,"speaker":"流浪儿成员","content":"科希大明神！","voice":["vo_trial_30202_1_22"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202053,"trial_step":53},{"step":54,"speaker":"流浪儿成员","content":"我好想你啊呜呜呜呜……","voice":["vo_trial_30202_1_23"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202054,"trial_step":54},{"step":55,"speaker":"流浪儿成员","content":"你不在的时候那些坏蛋又开始欺负我们了。","voice":["vo_trial_30202_1_24"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202055,"trial_step":55},{"step":56,"content":"流浪儿们把科希围得水泄不通，叽叽喳喳地说个不停。但也有些机警的孩子注意到了你的存在。","style":3,"background":1028,"log_type":1,"src_id":130202056,"trial_step":56},{"step":57,"speaker":"流浪儿成员","content":"怎么有大人跟来了？","voice":["vo_trial_30202_1_25"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202057,"trial_step":57},{"step":58,"content":"几个孩子一边小声咕哝着，一边摸向了腰间的武器。","style":3,"background":1028,"log_type":1,"src_id":130202058,"trial_step":58},{"step":59,"speaker":"科希","content":"他跟别人不一样，姑且算……来帮忙的。","female_content":"她跟别人不一样，姑且算……来帮忙的。","voice":["vo_trial_30202_1_26","vo_trial_30202_1_26f"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202059,"trial_step":59},{"step":60,"speaker":"流浪儿成员","content":"大人？来帮忙的？！","voice":["vo_trial_30202_1_27"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202060,"trial_step":60},{"step":61,"content":"虽然流浪儿们对这个说法感到难以置信，但毕竟是绝对信任的“科希大明神”说的，他们也就没有怀疑。","style":3,"background":1028,"log_type":1,"src_id":130202061,"trial_step":61},{"step":62,"speaker":"流浪儿成员","content":"对了对了，我捡了这个，你一定会喜欢的！","voice":["vo_trial_30202_1_28"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202062,"trial_step":62},{"step":63,"content":"人群中有一只小手举着一根竖笛，拼命地朝着科希的脸怼了上去。","style":3,"background":1028,"log_type":1,"src_id":130202063,"trial_step":63},{"step":64,"speaker":"流浪儿成员","content":"快住手，要捅进她鼻孔里了……","voice":["vo_trial_30202_1_29"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202064,"trial_step":64},{"step":65,"speaker":"流浪儿成员","content":"这是我捡的画片，我自己都没舍得玩，送给你了！","voice":["vo_trial_30202_1_30"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202065,"trial_step":65},{"step":66,"speaker":"流浪儿成员","content":"还有我的！","voice":["vo_trial_30202_1_31"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202066,"trial_step":66},{"step":67,"content":"孩子们七手八脚向科希塞着礼物，而最初遇到的那个男孩更是不知从哪里搬出了一个球形的糖果贩卖机。","style":3,"background":1028,"log_type":1,"src_id":130202067,"trial_step":67},{"step":68,"speaker":"男孩","content":"豆子上个月撬的，我们特意把蓝莓味的都留给你了。","voice":["vo_trial_30202_1_32"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202068,"trial_step":68},{"step":69,"speaker":"科希","content":"我讨厌棒棒糖……呜……","voice":["vo_trial_30202_1_33"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202069,"trial_step":69},{"step":70,"content":"一根蓝紫色棒棒糖被塞进了科希的嘴里。她皱了皱眉，刚想发牢骚，但似乎发现味道还不错。","style":3,"background":1028,"log_type":1,"src_id":130202070,"trial_step":70},{"step":71,"speaker":"科希","content":"下次递给我就行，别直接塞过来……","voice":["vo_trial_30202_1_34"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202071,"trial_step":71},{"step":72,"content":"话说了一半，科希发现你正盯着她看，有些恼怒地瞪了你一眼，没再继续说下去。","style":3,"background":1028,"log_type":1,"src_id":130202072,"trial_step":72},{"step":73,"content":"十几分钟后，流浪儿的孩子们才总算安静下来。","style":3,"background":1028,"log_type":1,"src_id":130202073,"trial_step":73},{"step":74,"options":["询问狂厄结晶的事情"],"style":6,"background":1028,"log_type":1,"src_id":130202074,"trial_step":74,"course":3,"choices":[{"text":"询问狂厄结晶的事情","goto":75}]},{"step":75,"content":"你看向科希，科希一下子就明白了你想做什么。她皱了皱眉，却也没有阻止。","style":3,"background":1028,"log_type":1,"src_id":130202075,"trial_step":75},{"step":76,"content":"得到了科希的默许，你走向了糖果贩卖机旁的男孩。","style":3,"background":1028,"log_type":1,"src_id":130202076,"trial_step":76},{"step":77,"content":"我想问你几个问题，可以吗？","style":2,"background":1028,"log_type":1,"src_id":130202077,"trial_step":77},{"step":78,"content":"男孩本能地抱紧了糖果贩卖机，向后缩了缩。他看了看科希，又看向你，犹豫了片刻才回应道：","style":3,"background":1028,"log_type":1,"src_id":130202078,"trial_step":78},{"step":79,"speaker":"男孩","content":"你想问什么？","voice":["vo_trial_30202_1_35"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202079,"trial_step":79},{"step":80,"content":"孩子们的注意力都集中了过来。看起来，和大人说话对他们而言并不是什么常见的状况。","style":3,"background":1028,"log_type":1,"src_id":130202080,"trial_step":80},{"step":81,"content":"你知道狂厄结晶吗？","style":2,"background":1028,"log_type":1,"src_id":130202081,"trial_step":81},{"step":82,"content":"听到这个问题，男孩的表情有些困惑，其他的孩子们多数也只是面面相觑。只有极少数几个似乎有些反应。","style":3,"background":1028,"log_type":1,"src_id":130202082,"trial_step":82},{"step":83,"content":"见状，你继续补充：","style":3,"background":1028,"log_type":1,"src_id":130202083,"trial_step":83},{"step":84,"content":"就是一种红色半透明、形状不规则的石头。","style":2,"background":1028,"log_type":1,"src_id":130202084,"trial_step":84},{"step":85,"speaker":"流浪儿成员","content":"我听说过，那种石头可厉害了，能卖好多钱。一颗就能换一百块糖。","voice":["vo_trial_30202_1_36"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202085,"trial_step":85},{"step":86,"content":"听到如此直白的将狂厄结晶和钱联系起来的话，科希的脸上闪过一丝阴霾。","style":3,"background":1028,"log_type":1,"src_id":130202086,"trial_step":86},{"step":87,"speaker":"流浪儿成员","content":"那有什么用，我们流浪儿吃糖从来不花钱。我当初就是冲着这个加入的。","voice":["vo_trial_30202_1_37"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202087,"trial_step":87},{"step":88,"speaker":"流浪儿成员","content":"是不是桑蒂他们最近找到的那种红色石头？我好像见到过……","voice":["vo_trial_30202_1_38"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202088,"trial_step":88},{"step":89,"content":"当提到“桑蒂”这个名字的时候，科希的脸色彻底变了。","style":3,"background":1028,"log_type":1,"src_id":130202089,"trial_step":89},{"step":90,"content":"但孩子们没有察觉到科希表情的变化，而是继续七嘴八舌地讨论着。","style":3,"background":1028,"log_type":1,"src_id":130202090,"trial_step":90},{"step":91,"options":["桑蒂是谁？"],"style":6,"background":1028,"log_type":1,"src_id":130202091,"trial_step":91,"course":3,"choices":[{"text":"桑蒂是谁？","goto":92}]},{"step":92,"speaker":"流浪儿成员","content":"桑蒂是我们的二号首领。","voice":["vo_trial_30202_1_39"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202092,"trial_step":92},{"step":93,"speaker":"流浪儿成员","content":"对，她是我们流浪儿的军师，可厉害了，是科希大明神的左膀右臂！大人看到她都得客客气气的。","voice":["vo_trial_30202_1_40"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202093,"trial_step":93},{"step":94,"content":"那你们知道她现在在哪儿吗？","style":2,"background":1028,"log_type":1,"src_id":130202094,"trial_step":94},{"step":95,"speaker":"流浪儿成员","content":"上个月还回来过一次，说要干票大的……好像就是去弄那个红石头了吧？","voice":["vo_trial_30202_1_41"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202095,"trial_step":95},{"step":96,"speaker":"科希","content":"够了！","voice":["vo_trial_30202_1_42"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202096,"trial_step":96},{"step":97,"content":"科希突然打断了对话。孩子们这才注意到科希的表情。","style":3,"background":1028,"log_type":1,"src_id":130202097,"trial_step":97},{"step":98,"content":"他们看看彼此，又看看你，终于意识到自己可能说了不该说的事情。","style":3,"background":1028,"log_type":1,"src_id":130202098,"trial_step":98},{"step":99,"speaker":"流浪儿成员","content":"对不起科希，我忘了有个大人在这儿……","voice":["vo_trial_30202_1_43"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202099,"trial_step":99},{"step":100,"speaker":"科希","content":"我不是因为这个生气。","voice":["vo_trial_30202_1_44"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202100,"trial_step":100},{"step":101,"content":"气氛依旧有些紧绷，孩子们都不敢再继续说下去了。","style":3,"background":1028,"log_type":1,"src_id":130202101,"trial_step":101},{"step":102,"content":"你不想让我知道这个桑蒂的事，是吗？","style":2,"background":1028,"log_type":1,"src_id":130202102,"trial_step":102},{"step":103,"speaker":"科希","content":"跟你没关系。","voice":["vo_trial_30202_1_45"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202103,"trial_step":103},{"step":104,"content":"但刚刚那边的孩子都说了，桑蒂最近找到了“红色石头”……那你是因为她真的碰了狂厄结晶才生气的，对不对？","style":2,"background":1028,"log_type":1,"src_id":130202104,"trial_step":104},{"step":105,"content":"当务之急是解决问题，我们必须找到桑蒂。","style":2,"background":1028,"log_type":1,"src_id":130202105,"trial_step":105},{"step":106,"speaker":"科希","content":"……","voice":["vo_trial_30202_1_46"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202106,"trial_step":106},{"step":107,"content":"科希紧绷着脸，表情很复杂，似乎在焦急地思索着什么，根本没有心思搭理你。","style":3,"background":1028,"log_type":1,"src_id":130202107,"trial_step":107},{"step":108,"content":"你们就一直这么僵持着。过了好一会儿，其中一个孩子突然怯生生地问道：","style":3,"background":1028,"log_type":1,"src_id":130202108,"trial_step":108},{"step":109,"speaker":"流浪儿成员","content":"那个红石头，很危险吗？","voice":["vo_trial_30202_1_47"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202109,"trial_step":109},{"step":110,"content":"嗯，非常非常危险。普通人只是接触都会受到伤害。","style":2,"background":1028,"log_type":1,"src_id":130202110,"trial_step":110},{"step":111,"content":"这种伤害很难治愈，绝大多数人甚至会因此变成怪物。","style":2,"background":1028,"log_type":1,"src_id":130202111,"trial_step":111},{"step":112,"speaker":"流浪儿成员","content":"那，那可怎么办啊……桑蒂她从上个月底开始就再没来过了，不会是……","voice":["vo_trial_30202_1_48"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202112,"trial_step":112},{"step":113,"speaker":"流浪儿成员","content":"别说这种话！桑蒂不会有事的。","voice":["vo_trial_30202_1_49"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202113,"trial_step":113},{"step":114,"speaker":"流浪儿成员","content":"可……可豆子和阿瓜也跟去了，现在也联系不上了啊。","voice":["vo_trial_30202_1_50"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202114,"trial_step":114},{"step":115,"content":"等等，你是说，除了桑蒂之外，流浪儿还有其他成员也失去联系了吗？","style":2,"background":1028,"log_type":1,"src_id":130202115,"trial_step":115},{"step":116,"speaker":"流浪儿成员","content":"嗯……大家平常每过几天都会回来一次的。","voice":["vo_trial_30202_1_52"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202116,"trial_step":116},{"step":117,"speaker":"流浪儿成员","content":"但是豆子、阿瓜他们，还有其他好几个人，已经好久没有回来过了……","voice":["vo_trial_30202_1_53"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202117,"trial_step":117},{"step":118,"content":"一种莫名的危机感突然击中了你，你转向那个糖果机旁的男孩。","style":3,"background":1028,"log_type":1,"src_id":130202118,"trial_step":118},{"step":119,"content":"今天追你的那个家伙，你是怎么惹到他的？和他发生过什么冲突吗？","style":2,"background":1028,"log_type":1,"src_id":130202119,"trial_step":119},{"step":120,"speaker":"男孩","content":"啊？","voice":["vo_trial_30202_1_54"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202120,"trial_step":120},{"step":121,"speaker":"男孩","content":"我不知道啊？我最近什么都没干，糖果机也不是我撬的……","voice":["vo_trial_30202_1_55"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202121,"trial_step":121},{"step":122,"speaker":"男孩","content":"那个家伙也不知道为什么就要打我，我根本不认识他啊。","voice":["vo_trial_30202_1_56"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202122,"trial_step":122},{"step":123,"content":"迟迟未归的流浪儿、暴走的黑帮残党、失窃的狂厄结晶……","style":3,"background":1028,"log_type":1,"src_id":130202123,"trial_step":123},{"step":124,"content":"一个可怕的推论在你的脑内产生。你快步走向科希。","style":3,"background":1028,"log_type":1,"src_id":130202124,"trial_step":124},{"step":125,"content":"万灵会的人袭击流浪儿不是偶然，他们很可能已经盯上你们了。","style":2,"background":1028,"log_type":1,"src_id":130202125,"trial_step":125},{"step":126,"content":"科希面色僵硬，她也已经意识到了问题的严重性。","style":3,"background":1028,"log_type":1,"src_id":130202126,"trial_step":126},{"step":127,"content":"桑蒂她……恐怕就是他们的首要目标。她有什么藏身处吗？或者只有你们知道的地方？","style":2,"background":1028,"log_type":1,"src_id":130202127,"trial_step":127},{"step":128,"speaker":"科希","content":"……我不知道。","voice":["vo_trial_30202_1_59"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202128,"trial_step":128},{"step":129,"content":"是我糊涂了，如果是在逃亡的话，大概率不会待在固定的地点……我们得尽快找到她。","style":2,"background":1028,"log_type":1,"src_id":130202129,"trial_step":129},{"step":130,"options":["联系管理局求助"],"style":6,"background":1028,"log_type":1,"src_id":130202130,"trial_step":130,"course":3,"choices":[{"text":"联系管理局求助","goto":131}]},{"step":131,"content":"你以最快的速度拨通了夜莺的电话。","style":3,"background":1028,"log_type":1,"src_id":130202131,"trial_step":131},{"step":132,"content":"通知情报部门，定位流浪儿的成员，还有任何疑似万灵会成员的人。我需要他们的实时位置。","style":2,"background":1028,"log_type":1,"src_id":130202132,"trial_step":132},{"step":133,"content":"要快！","style":2,"background":1028,"log_type":1,"src_id":130202133,"trial_step":133},{"step":134,"speaker":"夜莺","content":"明白。","voice":["vo_trial_30202_1_60"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202134,"trial_step":134},{"step":135,"content":"五分钟后，一张动态地图发送到了你的个人终端上。","style":3,"background":1028,"log_type":1,"src_id":130202135,"trial_step":135},{"step":136,"content":"密密麻麻的绿点令你头痛不已。这样的数量，就算让MBCC倾巢而出，也没办法在短时间内排查完毕。","style":3,"background":1028,"log_type":1,"src_id":130202136,"trial_step":136},{"step":137,"content":"科希，你的能力可以触及辛迪加的每一片阴影，这件事只有你能做到了……","style":2,"background":1028,"log_type":1,"src_id":130202137,"trial_step":137},{"step":138,"content":"我可以相信你，对吧？","style":2,"background":1028,"log_type":1,"src_id":130202138,"trial_step":138},{"step":139,"content":"你将个人终端递到了科希的手上。她飞快地瞥了一眼终端屏幕，接着毫不犹豫地发动了能力。","style":3,"background":1028,"log_type":1,"src_id":130202139,"trial_step":139},{"step":140,"content":"小小的身体顷刻间融入了阴影，消失于无形。","style":3,"background":1028,"log_type":1,"src_id":130202140,"trial_step":140},{"step":141,"content":"堆满垃圾的后巷，一个粉色头发的少女正大口喘着粗气。她躲在铁皮垃圾箱里，耳边那些可怕大人的狞笑挥之不去。","style":3,"background":1029,"log_type":1,"src_id":130202141,"trial_step":141},{"step":142,"speaker":"黑帮成员","content":"小畜生别躲了！把狂厄结晶交出来！","voice":["vo_trial_30202_1_61"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202142,"trial_step":142},{"step":143,"content":"她在内心拼命祈祷着，希望那些可怕的大人不要找到自己。可事与愿违，少女听到脚步声越来越近，她的心脏也几乎提到了嗓子眼。","style":3,"background":1029,"log_type":1,"src_id":130202143,"trial_step":143},{"step":144,"content":"嘎吱——","style":3,"background":1029,"log_type":1,"src_id":130202144,"trial_step":144},{"step":145,"content":"粉发少女愣了一下，随即从垃圾箱里跳了起来，用尽全身的力气抱住了面前的人。眼前的人不是追杀她的万灵会，而是失踪了很久的挚友。","style":3,"background":1029,"log_type":1,"src_id":130202145,"trial_step":145},{"step":146,"speaker":"桑蒂","content":"科——希——","voice":["vo_trial_30202_1_62"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202146,"trial_step":146},{"step":147,"speaker":"桑蒂","content":"你终于回来救我了，我差点就被杀了……","voice":["vo_trial_30202_1_63"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202147,"trial_step":147},{"step":148,"speaker":"桑蒂","content":"不过以后不用担心了，我赚了票大的。以后不用你我也能保护流浪儿啦。","voice":["vo_trial_30202_1_64"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202148,"trial_step":148},{"step":149,"content":"桑蒂松开了自己朝思暮想的挚友。然而，面前的科希，此刻的面色却阴沉得有些吓人。","style":3,"background":1029,"log_type":1,"src_id":130202149,"trial_step":149},{"step":150,"speaker":"桑蒂","content":"你一直不出现……我还以为你……","voice":["vo_trial_30202_1_65"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202150,"trial_step":150},{"step":151,"speaker":"科希","content":"只是遇到了一些小麻烦，不用管。","voice":["vo_trial_30202_1_66"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202151,"trial_step":151},{"step":152,"speaker":"科希","content":"你是不是偷了狂厄结晶？","voice":["vo_trial_30202_1_67"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202152,"trial_step":152},{"step":153,"content":"桑蒂愣了一下，旋即又露出一个大大的笑容。","style":3,"background":1029,"log_type":1,"src_id":130202153,"trial_step":153},{"step":154,"speaker":"桑蒂","content":"没有，怎么会呢，我怎么敢碰那么危险的东西。","voice":["vo_trial_30202_1_68"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202154,"trial_step":154},{"step":155,"speaker":"科希","content":"是吗，可万灵会不那么认为。","voice":["vo_trial_30202_1_69"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202155,"trial_step":155},{"step":156,"content":"听到“万灵会”两个字，桑蒂下意识地抖了抖，探头看向巷口。","style":3,"background":1029,"log_type":1,"src_id":130202156,"trial_step":156},{"step":157,"speaker":"桑蒂","content":"那些人呢？","voice":["vo_trial_30202_1_70"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202157,"trial_step":157},{"step":158,"speaker":"科希","content":"解决掉了。","voice":["vo_trial_30202_1_71"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202158,"trial_step":158},{"step":159,"speaker":"桑蒂","content":"哈哈，我就知道！","voice":["vo_trial_30202_1_72"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202159,"trial_step":159},{"step":160,"content":"桑蒂重新露出笑容。她掸了掸身上的垃圾，从垃圾箱里翻了出来。","style":3,"background":1029,"log_type":1,"src_id":130202160,"trial_step":160},{"step":161,"speaker":"桑蒂","content":"……误会而已，我只是偷了他们一批货，但绝对不是狂厄结晶。不知道为什么他们非要追着我不放。","voice":["vo_trial_30202_1_73"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202161,"trial_step":161},{"step":162,"speaker":"科希","content":"真的？","voice":["vo_trial_30202_1_74"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202162,"trial_step":162},{"step":163,"content":"感受到挚友的不信任，桑蒂立刻解释道：","style":3,"background":1029,"log_type":1,"src_id":130202163,"trial_step":163},{"step":164,"speaker":"桑蒂","content":"真的，特别真，我骗谁也不会骗你的。","voice":["vo_trial_30202_1_75"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202164,"trial_step":164},{"step":165,"speaker":"桑蒂","content":"怎么一脸担心的样子？你这不是回来了吗，区区万灵会的残党，敢招惹我们流浪儿，你出手解决掉不就得了。","voice":["vo_trial_30202_1_76"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202165,"trial_step":165},{"step":166,"speaker":"桑蒂","content":"就像以前一样，不是吗？","voice":["vo_trial_30202_1_77"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202166,"trial_step":166},{"step":167,"content":"出乎桑蒂意料的是，科希没有像往常那样立刻给出肯定的答复，她的面色依旧十分严峻。","style":3,"background":1029,"log_type":1,"src_id":130202167,"trial_step":167},{"step":168,"speaker":"科希","content":"你真的没有碰狂厄结晶？","voice":["vo_trial_30202_1_78"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202168,"trial_step":168},{"step":169,"speaker":"桑蒂","content":"要我说多少遍啊，真的没有啦。","voice":["vo_trial_30202_1_79"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202169,"trial_step":169},{"step":170,"speaker":"桑蒂","content":"怎么感觉你这么容易慌啊，难道这次你搞不定了吗？","voice":["vo_trial_30202_1_80"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202170,"trial_step":170},{"step":171,"content":"科希没有心思回答她这种问题，而是追问了其他流浪儿的情况。","style":3,"background":1029,"log_type":1,"src_id":130202171,"trial_step":171},{"step":172,"speaker":"科希","content":"跟着你的那些人去哪里了？他们也被追杀了？","voice":["vo_trial_30202_1_81"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202172,"trial_step":172},{"step":173,"content":"科希没有正面回应桑蒂让桑蒂有些慌了神，她连忙回答道：","style":3,"background":1029,"log_type":1,"src_id":130202173,"trial_step":173},{"step":174,"speaker":"桑蒂","content":"没有没有，我让他们去老仓库躲起来了。阿瓜也去通知据点的人了，不要紧的。","voice":["vo_trial_30202_1_82"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202174,"trial_step":174},{"step":175,"speaker":"桑蒂","content":"……事情有这么严重吗？","voice":["vo_trial_30202_1_83"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202175,"trial_step":175},{"step":176,"speaker":"科希","content":"你觉得呢？","voice":["vo_trial_30202_1_84"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202176,"trial_step":176},{"step":177,"speaker":"科希","content":"赶紧离开这里，有个难缠的家伙可能会跟过来。","voice":["vo_trial_30202_1_85"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202177,"trial_step":177},{"step":178,"speaker":"桑蒂","content":"谁？万灵会？","voice":["vo_trial_30202_1_86"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202178,"trial_step":178},{"step":179,"speaker":"科希","content":"……管理局的局长。","voice":["vo_trial_30202_1_87"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202179,"trial_step":179},{"step":180,"speaker":"桑蒂","content":"管理局的局长，就是抓你的那个？听说他是个滥好人……","female_content":"管理局的局长，就是抓你的那个？听说她是个滥好人……","voice":["vo_trial_30202_1_88","vo_trial_30202_1_88f"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202180,"trial_step":180},{"step":181,"content":"桑蒂的眼睛忽地亮了起来。","style":3,"background":1029,"log_type":1,"src_id":130202181,"trial_step":181},{"step":182,"content":"虽然科希拿走了你的终端独自离去，但你还是一直循着枷锁的感应寻找着她的去向。","style":3,"background":10000,"log_type":1,"src_id":130202182,"trial_step":182},{"step":183,"content":"终于，你在一处暗巷找到了科希。","style":3,"background":1029,"log_type":1,"src_id":130202183,"trial_step":183},{"step":184,"speaker":"局长","content":"科希，找到桑蒂了吗？","style":2,"background":1029,"log_type":1,"src_id":130202184,"trial_step":184},{"step":185,"content":"科希发现了你，下意识地挡在了桑蒂的身前。","style":3,"background":1029,"log_type":1,"src_id":130202185,"trial_step":185},{"step":186,"speaker":"科希","content":"不要过来！","voice":["vo_trial_30202_1_89"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202186,"trial_step":186},{"step":187,"content":"别紧张科希，我不是来兴师问罪的。我会给桑蒂提供庇护，然后我们再弄清楚狂厄结晶的事情。","style":2,"background":1029,"log_type":1,"src_id":130202187,"trial_step":187},{"step":188,"speaker":"科希","content":"我会保护她，用不着你插手。","voice":["vo_trial_30202_1_90"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202188,"trial_step":188},{"step":189,"content":"出乎意料的是，桑蒂此时居然主动问道：","style":3,"background":1029,"log_type":1,"src_id":130202189,"trial_step":189},{"step":190,"speaker":"桑蒂","content":"你就是那个局长？","voice":["vo_trial_30202_1_91"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202190,"trial_step":190},{"step":191,"content":"是的。","style":2,"background":1029,"log_type":1,"src_id":130202191,"trial_step":191},{"step":192,"speaker":"桑蒂","content":"你说你能保护我？那太好了，快带我走吧。","voice":["vo_trial_30202_1_92"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202192,"trial_step":192},{"step":193,"content":"桑蒂的话令你和科希同时感到有些错愕，但你很快反应过来。","style":3,"background":1029,"log_type":1,"src_id":130202193,"trial_step":193},{"step":194,"content":"没问题，不过……","style":2,"background":1029,"log_type":1,"src_id":130202194,"trial_step":194},{"step":195,"speaker":"桑蒂","content":"我知道你在想什么，我没偷万灵会的狂厄结晶，但我知道是谁干的。八成是他们黑吃黑赖到我们头上了。","voice":["vo_trial_30202_1_93"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202195,"trial_step":195},{"step":196,"speaker":"桑蒂","content":"我们做个交易怎么样？你不是想找到狂厄结晶吗，我可以帮你，前提是你得保证我的安全。","voice":["vo_trial_30202_1_94"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202196,"trial_step":196},{"step":197,"content":"只保护你吗？那其他的流浪儿怎么办？","style":2,"background":1029,"log_type":1,"src_id":130202197,"trial_step":197},{"step":198,"speaker":"桑蒂","content":"放心，他们没事。我让他们去了一个万无一失的藏身所，只要熬过这一阵子，你把那些万灵会的人都抓起来就好了。","voice":["vo_trial_30202_1_95"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202198,"trial_step":198},{"step":199,"content":"万无一失的藏身所？","style":2,"background":1029,"log_type":1,"src_id":130202199,"trial_step":199},{"step":200,"content":"你有些狐疑地询问。看到你的反应，桑蒂有些不耐烦地解释道：","style":3,"background":1029,"log_type":1,"src_id":130202200,"trial_step":200},{"step":201,"speaker":"桑蒂","content":"啊呀，笨。他们的主要目标是我，我怎么可能在这种时候跑过去，不是暴露位置吗？","voice":["vo_trial_30202_1_96"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202201,"trial_step":201},{"step":202,"speaker":"桑蒂","content":"我不管，总之你不同意的话，科希就不会帮你！我们是最好的朋友，我说的话她都会听的！","voice":["vo_trial_30202_1_97"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202202,"trial_step":202},{"step":203,"content":"说着，桑蒂扯了扯科希的袖子。","style":3,"background":1029,"log_type":1,"src_id":130202203,"trial_step":203},{"step":204,"content":"科希，你确定那个藏身处是安全的吗？其他被牵扯进来的流浪儿不会有问题吗？需不需要我的帮助？","style":2,"background":1029,"log_type":1,"src_id":130202204,"trial_step":204},{"step":205,"content":"科希犹豫了一会儿，最终还是选择了相信挚友，给予了你肯定的答复。","style":3,"background":1029,"log_type":1,"src_id":130202205,"trial_step":205},{"step":206,"content":"那好吧。","style":2,"background":1029,"log_type":1,"src_id":130202206,"trial_step":206},{"step":207,"options":["同意桑蒂的请求"],"style":6,"background":1029,"log_type":1,"src_id":130202207,"trial_step":207,"course":3,"choices":[{"text":"同意桑蒂的请求","goto":208}]},{"step":208,"content":"行，我答应你。","style":2,"background":1029,"log_type":1,"src_id":130202208,"trial_step":208},{"step":209,"content":"MBCC会派人来这一带搜捕万灵会的人，你也可以暂且跟着我回管理局。","style":2,"background":1029,"log_type":1,"src_id":130202209,"trial_step":209},{"step":210,"content":"但你要信守约定，帮助我找到失窃的狂厄结晶……","style":2,"background":1029,"log_type":1,"src_id":130202210,"trial_step":210},{"step":211,"speaker":"桑蒂","content":"没问题！","voice":["vo_trial_30202_1_98"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202211,"trial_step":211},{"step":212,"content":"桑蒂满口答应。","style":3,"background":1029,"log_type":1,"src_id":130202212,"trial_step":212}]}