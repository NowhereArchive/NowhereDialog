{"id":8032,"chapter_id":8,"scene_id":803,"steps":[{"step":1,"content":"虚影逐渐溃散，它仍旧愤恨地瞪视着你。","style":3,"background":509,"log_type":1},{"step":2,"speaker":"FAC队员","content":"下地狱吧……你这种怪物……就该永远留在黑环……","voice":["vo_cgplot_8032002"],"voice_bank":"vo_cgplot_08","style":1,"background":509,"log_type":1},{"step":3,"speaker":"选项","options":["我不会被困在这里"],"jump":[4],"style":6,"background":509,"log_type":1},{"step":4,"speaker":"${PlayerName}","content":"回到现实，战胜黑环才是对你们的吊唁。让环的主人出来见我。","style":2,"background":509,"log_type":1},{"step":5,"content":"它消失了，没有回答。幻境渐渐扭曲模糊，四周一片死寂。","style":3,"background":509,"log_type":1},{"step":6,"content":"直到你听到子弹上膛的声音，冰冷的枪口抵住你的后脑。","style":3,"background":10000,"log_type":1},{"step":7,"speaker":"${PlayerName}","content":"……兰利？","style":2,"background":10000,"log_type":1},{"step":8,"speaker":"“兰利”","content":"整个狄斯城都乱了套，因为你唤起了一个沉睡的黑环……干得漂亮。","voice":["vo_cgplot_8032008"],"voice_bank":"vo_cgplot_08","style":1,"background":703,"log_type":1},{"step":9,"speaker":"“兰利”","content":"我给你机会，就是在等叛徒自己露出马脚。","voice":["vo_cgplot_8032009"],"voice_bank":"vo_cgplot_08","style":1,"background":703,"log_type":1},{"step":10,"speaker":"“兰利”","content":"考核结束了，新人。","voice":["vo_cgplot_8032010"],"voice_bank":"vo_cgplot_08","style":1,"background":703,"log_type":1},{"step":11,"content":"砰——！","style":3,"background":10000,"log_type":1}]}