{"id":402801072,"chapter_id":30001,"scene_id":30021,"steps":[{"step":1,"content":"【小cg1】","style":18,"background":50861,"log_type":1},{"step":2,"speaker":"海拉","content":"@#￥#！%！@##￥@#%？？？！！！！","style":1,"background":50861,"log_type":1},{"step":3,"speaker":"海拉","content":"你干嘛你干嘛你干嘛有你这么逮人的吗放手放手放手不害臊吗有人看着呢！","style":1,"background":50861,"log_type":1},{"step":4,"content":"【小cg2】","style":18,"background":50862,"log_type":1},{"step":5,"speaker":"赫卡蒂","content":"没人在看，放心吧。","style":1,"background":50862,"log_type":1},{"step":6,"speaker":"赫卡蒂","content":"我明白的。为了重要的东西，海拉也想变强，我都明白。","style":1,"background":50862,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"这些是你教给我的东西，在我迷失自己时，是你推了我一把，让我看到更多人，让我回到局长身边。","style":1,"background":50862,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"所以，在海拉需要时，我也会支持你。加油。","style":1,"background":50862,"log_type":1},{"step":9,"speaker":"海拉","content":"那你任务怎么办？","style":1,"background":50862,"log_type":1},{"step":10,"speaker":"赫卡蒂","content":"“监督海拉”的任务吗？没关系，我不要了，局长会帮我们的，你比那些任务都重要。","style":1,"background":50862,"log_type":1},{"step":11,"content":"【小cg3】","style":18,"background":50863,"log_type":1},{"step":12,"speaker":"赫卡蒂","content":"因为海拉是我的朋友，是我自己选择的第一个朋友。","style":1,"background":50863,"log_type":1},{"step":13,"speaker":"赫卡蒂","content":"要常回来看大家哦，我会很想念你的。","style":1,"background":50863,"log_type":1},{"step":15,"speaker":"选项","options":["在看书吗？"],"jump":[16],"style":6,"background":1040,"log_type":1},{"step":16,"speaker":"赫卡蒂","content":"嗯。","style":1,"background":1040,"log_type":1},{"step":17,"speaker":"选项","options":["书名是什么？"],"jump":[18],"style":6,"background":1040,"log_type":1},{"step":18,"speaker":"赫卡蒂","content":"永远的朋友。","style":1,"background":1040,"log_type":1}]}