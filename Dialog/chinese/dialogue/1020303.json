{"id":1020303,"chapter_id":1020303,"scene_id":1,"steps":[{"step":1,"content":"嗯？黛伦被带走了？","style":2,"background":1040,"log_type":1,"src_id":120303001,"trial_step":1},{"step":2,"content":"谁带走的？除了我还有谁能“带走”黛伦？","style":2,"background":1040,"log_type":1,"src_id":120303002,"trial_step":2},{"step":3,"content":"这几天，你私心将黛伦的手札扣着，美其名曰需要进一步了解禁闭者，并研究了好几晚。","style":3,"background":1040,"log_type":1,"src_id":120303003,"trial_step":3},{"step":4,"content":"本来顶着黑眼圈睡眠不足来上班就颇为疲惫了，没想到坐下处理的第一条消息，居然是这个。","style":3,"background":1040,"log_type":1,"src_id":120303004,"trial_step":4},{"step":5,"speaker":"夜莺","content":"是新城的议员点名将她带走的，那位大人的职级比您要高不少，所以……我们拦不下来。","voice":["vo_trial_20303_1_5"],"voice_bank":"vo_deren_trial","style":1,"background":1040,"log_type":1,"src_id":120303005,"trial_step":5},{"step":6,"speaker":"夜莺","content":"况且MBCC-S-014号禁闭者本身也属于“精英禁闭者”范围之内，确实有暂停收容的权利。","voice":["vo_trial_20303_1_6"],"voice_bank":"vo_deren_trial","style":1,"background":1040,"log_type":1,"src_id":120303006,"trial_step":6},{"step":7,"content":"夜莺抱歉地朝你笑笑，将手中的平板终端递给了你。","style":3,"background":1040,"log_type":1,"src_id":120303007,"trial_step":7},{"step":8,"content":"你拿起终端，上面正在直播一场采访会，标题后面火焰的标记，显示出了这场采访会的火爆。","style":3,"background":1040,"log_type":1,"src_id":120303008,"trial_step":8},{"step":9,"speaker":"记者A","content":"黛伦导演！您许久不参加狄斯卡，这次回来参加狄斯卡的理由是什么呢？","voice":["vo_trial_20303_1_9"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303009,"trial_step":9},{"step":10,"speaker":"黛伦","content":"他们邀请我，我就答应了嘛。","voice":["vo_trial_20303_1_10"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303010,"trial_step":10},{"step":11,"speaker":"记者A","content":"那对于这届狄斯卡最后延迟举办，您有什么理解和看法吗？","voice":["vo_trial_20303_1_11"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303011,"trial_step":11},{"step":12,"speaker":"黛伦","content":"延迟举办又不是不办，到头来还是会办的嗯嗯。","voice":["vo_trial_20303_1_12"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303012,"trial_step":12},{"step":13,"speaker":"记者B","content":"那您这次为什么没有新剧放映呢？","voice":["vo_trial_20303_1_13"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303013,"trial_step":13},{"step":14,"speaker":"黛伦","content":"因为没有拍啊~所以就没有新剧啦~","voice":["vo_trial_20303_1_14"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303014,"trial_step":14},{"step":15,"speaker":"记者B","content":"为什么不拍呢？我们都很喜欢你怪诞浪漫风格的电影！","voice":["vo_trial_20303_1_15"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303015,"trial_step":15},{"step":16,"speaker":"黛伦","content":"为什么啊……哈哈哈哈……可能是还没拍的原因吧！","voice":["vo_trial_20303_1_16"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303016,"trial_step":16},{"step":17,"speaker":"记者C","content":"请问您对于自己以前的作品满意吗？","voice":["vo_trial_20303_1_17"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303017,"trial_step":17},{"step":18,"speaker":"黛伦","content":"你们喜欢就好。","voice":["vo_trial_20303_1_18"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303018,"trial_step":18},{"step":19,"speaker":"记者C","content":"那对于您在怪诞领域风格称王有什么看法吗？","voice":["vo_trial_20303_1_19"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303019,"trial_step":19},{"step":20,"speaker":"黛伦","content":"这王呢，通常是指一位领袖或者是君主的称号，所以……","voice":["vo_trial_20303_1_20"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303020,"trial_step":20},{"step":21,"speaker":"记者D","content":"那么请问……","voice":["vo_trial_20303_1_21"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303021,"trial_step":21},{"step":22,"speaker":"黛伦","content":"哎您说。","voice":["vo_trial_20303_1_22"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303022,"trial_step":22},{"step":23,"speaker":"记者D","content":"请问您之前五年消失这么久，是去取材了吗？","voice":["vo_trial_20303_1_23"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303023,"trial_step":23},{"step":24,"speaker":"记者E","content":"这届狄斯卡终于又请到您但是延期了，您对导致延期的“异常事件”有什么独到看法吗？会想办法拍成电影吗？","voice":["vo_trial_20303_1_24"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303024,"trial_step":24},{"step":25,"speaker":"记者F","content":"您会继续参加延期后的狄斯卡吗？","voice":["vo_trial_20303_1_25"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303025,"trial_step":25},{"step":26,"speaker":"记者","content":"黛伦导演！请回答一下我的问题！黛伦导演！","voice":["vo_trial_20303_1_26"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303026,"trial_step":26},{"step":27,"speaker":"黛伦","content":"慢点，慢点……一个个来……","voice":["vo_trial_20303_1_27"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303027,"trial_step":27},{"step":28,"content":"黛伦维持着脸上的笑容，眼睛轻轻睁开，看着眼前的人潮。","style":3,"background":2041,"log_type":1,"src_id":120303028,"trial_step":28},{"step":29,"content":"黑色的话筒挂着它们的所属名牌，像一根根刻着自己消灭过多少人的武器，汹涌而来。","style":3,"background":2041,"log_type":1,"src_id":120303029,"trial_step":29},{"step":30,"speaker":"黛伦","content":"我会尽量回答……","voice":["vo_trial_20303_1_30"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303030,"trial_step":30},{"step":31,"content":"即便身后是万丈深渊，面对此情此景，也只能往后退了吧？","style":3,"background":2041,"log_type":1,"src_id":120303031,"trial_step":31},{"step":32,"content":"黛伦叹了口气，一点点往后挪着。","style":3,"background":2041,"log_type":1,"src_id":120303032,"trial_step":32},{"step":33,"speaker":"记者","content":"您为什么要叹气呢？是觉得现在的电影行业无药可救了吗？","voice":["vo_trial_20303_1_33"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303033,"trial_step":33},{"step":34,"speaker":"记者","content":"是因为现在的电影行业无药可救您才这么久都不出现吗？","voice":["vo_trial_20303_1_34"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303034,"trial_step":34},{"step":35,"speaker":"记者","content":"那您现在出现在这里是不是代表着您要为这个行业带来新的生机？","voice":["vo_trial_20303_1_35"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303035,"trial_step":35},{"step":36,"speaker":"黛伦","content":"哈哈哈……您真看得起我。","voice":["vo_trial_20303_1_36"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303036,"trial_step":36},{"step":37,"content":"心中莫名的情绪开始收紧，黛伦的脸色开始变得有些阴沉，精神意识之中，似乎有什么在叫嚣着，想要冲破身体本能带给它的束缚。","style":3,"background":2041,"log_type":1,"src_id":120303037,"trial_step":37},{"step":38,"speaker":"？？？","content":"别被它们迷惑了。","style":2,"background":2041,"log_type":1,"src_id":120303039,"trial_step":39},{"step":39,"speaker":"黛伦","content":"谁？","voice":["vo_trial_20303_1_40"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303040,"trial_step":40},{"step":40,"speaker":"？？？","content":"我数到三，你转身往西南方向跑。","style":2,"background":2041,"log_type":1,"src_id":120303041,"trial_step":41},{"step":41,"content":"脑海里回荡着熟悉的声音，黛伦笑了笑，重新抬头，面对前面无数的话筒。","style":3,"background":2041,"log_type":1,"src_id":120303042,"trial_step":42},{"step":42,"speaker":"黛伦","content":"不好意思，我宣布个事儿啊。","voice":["vo_trial_20303_1_43"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303043,"trial_step":43},{"step":43,"speaker":"？？？","content":"一。","style":2,"background":2041,"log_type":1,"src_id":120303044,"trial_step":44},{"step":44,"speaker":"黛伦","content":"就是呢……","voice":["vo_trial_20303_1_45"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303045,"trial_step":45},{"step":45,"speaker":"？？？","content":"二。","style":2,"background":2041,"log_type":1,"src_id":120303046,"trial_step":46},{"step":46,"speaker":"黛伦","content":"怎么说……","voice":["vo_trial_20303_1_47"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303047,"trial_step":47},{"step":47,"speaker":"？？？","content":"三！！！","style":2,"background":2041,"log_type":1,"src_id":120303048,"trial_step":48},{"step":48,"speaker":"黛伦","content":"回见了各位！！！","voice":["vo_trial_20303_1_49"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303049,"trial_step":49},{"step":49,"content":"上一刻还在挠头傻笑的人，这一刻一溜烟地穿过身后无数的路牌路障，钻进了新城的小巷之中。","style":3,"background":2041,"log_type":1,"src_id":120303050,"trial_step":50},{"step":50,"content":"那些记者沉默了三秒，突然之间又沸腾了起来。","style":3,"background":2041,"log_type":1,"src_id":120303051,"trial_step":51},{"step":51,"speaker":"记者们","content":"黛伦导演这是什么意思？！","voice":["vo_trial_20303_1_52"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303052,"trial_step":52},{"step":52,"speaker":"记者们","content":"她是要去拯救电影界了吗？！","voice":["vo_trial_20303_1_53"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303053,"trial_step":53},{"step":53,"speaker":"记者们","content":"不不不我觉得她的意思是现在的电影界无人能望其项背！","voice":["vo_trial_20303_1_54"],"voice_bank":"vo_deren_trial","style":1,"background":2041,"log_type":1,"src_id":120303054,"trial_step":54},{"step":54,"speaker":"黛伦","content":"局长，觉不觉得这个画面有点眼熟？","voice":["vo_trial_20303_1_55"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303055,"trial_step":55},{"step":55,"speaker":"黛伦","content":"用术语来说，可以叫回忆或者闪回吧？","voice":["vo_trial_20303_1_56"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303056,"trial_step":56},{"step":56,"content":"你拉着黛伦，穿梭在房屋之间的小巷里，见那些记者和保镖都没有再跟上来，便放慢了速度。","style":3,"background":2015,"log_type":1,"src_id":120303057,"trial_step":57},{"step":57,"content":"那这么说，我可以算是电影的主角吗？","style":2,"background":2015,"log_type":1,"src_id":120303058,"trial_step":58},{"step":58,"speaker":"黛伦","content":"当然，在我眼里，你永远都是主角。","voice":["vo_trial_20303_1_59"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303059,"trial_step":59},{"step":59,"content":"那黛伦导演给我讲讲戏吧，有些地方，我不太明白。","style":2,"background":2015,"log_type":1,"src_id":120303060,"trial_step":60},{"step":60,"content":"你将黛伦塞进一条小路，小路的尽头是围墙。","style":3,"background":2015,"log_type":1,"src_id":120303061,"trial_step":61},{"step":61,"speaker":"黛伦","content":"哎哟，这么大阵仗？","voice":["vo_trial_20303_1_62"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303062,"trial_step":62},{"step":62,"speaker":"黛伦","content":"你的问题我会好好回答的，刚才只是为了应付那些无聊的家伙罢了。","voice":["vo_trial_20303_1_63"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303063,"trial_step":63},{"step":63,"options":["带你走的人是谁？"],"style":6,"background":2015,"log_type":1,"src_id":120303064,"trial_step":64,"course":3,"choices":[{"text":"带你走的人是谁？","goto":65}]},{"step":64,"speaker":"黛伦","content":"你啊。","voice":["vo_trial_20303_1_65"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303065,"trial_step":65},{"step":65,"content":"……","style":2,"background":2015,"log_type":1,"src_id":120303066,"trial_step":66},{"step":66,"speaker":"黛伦","content":"开玩笑开玩笑……我知道，你问的是带我离开MBCC的那个人吧。","voice":["vo_trial_20303_1_67"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303067,"trial_step":67},{"step":67,"content":"黛伦抱着手臂，往墙上一靠，灰尘落在她的肩膀上，看上去，她整个人都像一个尘封已久的记忆匣子。","style":3,"background":2015,"log_type":1,"src_id":120303068,"trial_step":68},{"step":68,"speaker":"黛伦","content":"他啊——老朋友了……","voice":["vo_trial_20303_1_69"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303069,"trial_step":69},{"step":69,"speaker":"铃声","content":"叮铃铃——！！！！！","style":1,"background":2015,"log_type":1,"src_id":120303070,"trial_step":70},{"step":70,"content":"一阵尖锐的电话铃声打断了黛伦的话，她掏出通讯器，看见上面大咧咧地显示着助理小姐的名字，朝你憨憨一笑。","style":3,"background":2015,"log_type":1,"src_id":120303071,"trial_step":71},{"step":71,"options":["……接听吧。"],"style":6,"background":2015,"log_type":1,"src_id":120303072,"trial_step":72,"course":3,"choices":[{"text":"……接听吧。","goto":73}]},{"step":72,"content":"黛伦刚一按下接听键，助理小姐具有穿透力的声音便从通讯器里刺了过来。","style":3,"background":2015,"log_type":1,"src_id":120303073,"trial_step":73},{"step":73,"speaker":"助理小姐","content":"我的黛伦大导演啊啊啊啊啊啊啊！！！你这是在做什么！！你怎么能从现场逃跑啊我的祖宗！！！","voice":["vo_trial_20303_1_74"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303074,"trial_step":74},{"step":74,"speaker":"助理小姐","content":"你不知道是谁把你从局子里弄出来的吗？！是沃尔特议员啊！！！！","voice":["vo_trial_20303_1_75"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303075,"trial_step":75},{"step":75,"speaker":"黛伦","content":"我知道啊，是他说只要我露面就行，怎么说怎么做都随我。","voice":["vo_trial_20303_1_76"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303076,"trial_step":76},{"step":76,"speaker":"助理小姐","content":"你……你们之前不是还合作过？怎么这么不给人面子？！你不是知道他商政都挺有手段吗？","voice":["vo_trial_20303_1_77"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303077,"trial_step":77},{"step":77,"speaker":"助理小姐","content":"这次的狄斯卡可是他投资的！当心搞砸了他又不让你上……","voice":["vo_trial_20303_1_78"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303078,"trial_step":78},{"step":78,"content":"黛伦皱着眉头掏了掏耳朵，把通讯器拉开，远离自己的耳朵。","style":3,"background":2015,"log_type":1,"src_id":120303079,"trial_step":79},{"step":79,"speaker":"黛伦","content":"哎哎，我知道，我知道，我会听话的，放心吧，我会参加的。","voice":["vo_trial_20303_1_80"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303080,"trial_step":80},{"step":80,"content":"黛伦安抚好咋咋呼呼的助理小姐，关闭了通讯器。","style":3,"background":2015,"log_type":1,"src_id":120303081,"trial_step":81},{"step":81,"content":"一瞬间，似乎连小巷的砖块，都还在嗡鸣，等待着刚才的声波散去。","style":3,"background":2015,"log_type":1,"src_id":120303082,"trial_step":82},{"step":82,"content":"所以……如果你不接受采访，不去参加狄斯卡……","style":2,"background":2015,"log_type":1,"src_id":120303083,"trial_step":83},{"step":83,"content":"他会撤资？","style":2,"background":2015,"log_type":1,"src_id":120303084,"trial_step":84},{"step":84,"speaker":"黛伦","content":"嗯，正如你所听见的，大概就是这么个意思吧。","voice":["vo_trial_20303_1_85"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303085,"trial_step":85},{"step":85,"speaker":"黛伦","content":"虽然很早之前我就对这东西没什么兴趣了，但我知道……","voice":["vo_trial_20303_1_86"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303086,"trial_step":86},{"step":86,"speaker":"黛伦","content":"很多人都靠这个活着呢，反正我也不损失什么，去就去吧，由他们安排。","voice":["vo_trial_20303_1_87"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303087,"trial_step":87},{"step":87,"content":"那……当初你的那部电影，也是因为这个原因，才答应让别人来重新剪辑吗？","style":2,"background":2015,"log_type":1,"src_id":120303088,"trial_step":88},{"step":88,"content":"听到你的话，黛伦明显愣了一下。随即便开怀大笑起来。","style":3,"background":2015,"log_type":1,"src_id":120303089,"trial_step":89},{"step":89,"speaker":"黛伦","content":"哈哈哈哈哈~！你果然很不一样啊，你是看出了些什么吗？","voice":["vo_trial_20303_1_90"],"voice_bank":"vo_deren_trial","style":1,"background":2015,"log_type":1,"src_id":120303090,"trial_step":90},{"step":90,"content":"你耸耸肩，示意黛伦继续跟你走。","style":3,"background":2015,"log_type":1,"src_id":120303091,"trial_step":91},{"step":91,"content":"你们穿过小巷，豁然开朗处是一处热闹非凡的工厂。","style":3,"background":1048,"log_type":1,"src_id":120303092,"trial_step":92},{"step":92,"speaker":"黛伦","content":"这里是……？","voice":["vo_trial_20303_1_93"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303093,"trial_step":93},{"step":93,"content":"黛伦看着眼前的景色，有点不解。","style":3,"background":1048,"log_type":1,"src_id":120303094,"trial_step":94},{"step":94,"speaker":"黛伦","content":"怎么……不跟局长打招呼就离开MBCC，是要被扔进黑工厂做苦工的？","voice":["vo_trial_20303_1_95"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303095,"trial_step":95},{"step":95,"options":["想象力真丰富。"],"style":6,"background":1048,"log_type":1,"src_id":120303096,"trial_step":96,"course":3,"choices":[{"text":"想象力真丰富。","goto":97}]},{"step":96,"content":"真不愧是狄斯卡最佳导演。","style":2,"background":1048,"log_type":1,"src_id":120303097,"trial_step":97},{"step":97,"speaker":"黛伦","content":"一人一句，够了够了，再多就过了啊。","voice":["vo_trial_20303_1_98"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303098,"trial_step":98},{"step":98,"speaker":"黛伦","content":"所以你带我来这里，是想干什么？","voice":["vo_trial_20303_1_99"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303099,"trial_step":99},{"step":99,"content":"你对着黛伦扬了扬手里的手札。","style":3,"background":1048,"log_type":1,"src_id":120303100,"trial_step":100},{"step":100,"speaker":"黛伦","content":"……","voice":["vo_trial_20303_1_101"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303101,"trial_step":101},{"step":101,"speaker":"黛伦","content":"你研究得还挺深入啊。","voice":["vo_trial_20303_1_102"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303102,"trial_step":102},{"step":102,"content":"你现在是我的禁闭者，身为MBCC的局长，我有责任对每一位禁闭者……","style":2,"background":1048,"log_type":1,"src_id":120303103,"trial_step":103},{"step":103,"content":"深入了解。","style":2,"background":1048,"log_type":1,"src_id":120303104,"trial_step":104},{"step":104,"content":"黛伦眯着眼睛看了看你，似乎一副不相信的样子。","style":3,"background":1048,"log_type":1,"src_id":120303105,"trial_step":105},{"step":105,"content":"你打开手札，念起了上面的一段话。","style":3,"background":1048,"log_type":1,"src_id":120303106,"trial_step":106},{"step":106,"content":"“门后面的舞者们，悲哀过，挣扎过，但最终都接受了现实。”","style":2,"background":1048,"log_type":1,"src_id":120303107,"trial_step":107},{"step":107,"content":"“可能是出于无奈，也可能没有任何原因，又或者，他们自己本身也无所谓。”","style":2,"background":1048,"log_type":1,"src_id":120303108,"trial_step":108},{"step":108,"content":"“然而，他们都没想到，接受现实的代价，带来的是自我的消亡。”","style":2,"background":1048,"log_type":1,"src_id":120303109,"trial_step":109},{"step":109,"content":"“那么……他们藏在心底的声音，该由谁来呐喊呢？”","style":2,"background":1048,"log_type":1,"src_id":120303110,"trial_step":110},{"step":110,"speaker":"黛伦","content":"哎呀，被你这么念出来，还怪羞耻的。","voice":["vo_trial_20303_1_111"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303111,"trial_step":111},{"step":111,"content":"那部电影，被剪辑的感觉太重了。","style":2,"background":1048,"log_type":1,"src_id":120303112,"trial_step":112},{"step":112,"content":"剪辑手法能骗人，导演的真实意图，始终能从演员的眼神中透露出来。","style":2,"background":1048,"log_type":1,"src_id":120303113,"trial_step":113},{"step":113,"content":"——这本手札，你是故意留给我的吧？","style":2,"background":1048,"log_type":1,"src_id":120303114,"trial_step":114},{"step":114,"speaker":"黛伦","content":"我只是想看看，你能意识到多少。但我感觉你了解得比我想象的要多。","voice":["vo_trial_20303_1_115"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303115,"trial_step":115},{"step":115,"speaker":"黛伦","content":"真不愧MBCC的局长，果然是有两把刷子的。","voice":["vo_trial_20303_1_116"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303116,"trial_step":116},{"step":116,"content":"黛伦接过你递过来的手札，轻轻地抚摸着封面，眼神像在看从前的自己。","style":3,"background":1048,"log_type":1,"src_id":120303117,"trial_step":117},{"step":117,"content":"那些网络和媒体每天吹鼓的，拼命贴给你的标签，其实仅仅只是一面。","style":2,"background":1048,"log_type":1,"src_id":120303118,"trial_step":118},{"step":118,"content":"只是你和你的电影的其中一面。","style":2,"background":1048,"log_type":1,"src_id":120303119,"trial_step":119},{"step":119,"content":"黛伦导演的怪诞电影，并不是浪漫的戏剧或者合家欢。","style":2,"background":1048,"log_type":1,"src_id":120303120,"trial_step":120},{"step":120,"content":"而是一部令人震耳发聩，让人聆听被命运束缚之人在挣脱束缚时的怒吼的电影。","style":2,"background":1048,"log_type":1,"src_id":120303121,"trial_step":121},{"step":121,"content":"可惜的是，这部电影和导演本人一样，被人剪辑，被人贴上标签，被永远束缚。","style":2,"background":1048,"log_type":1,"src_id":120303122,"trial_step":122},{"step":122,"content":"面前的工厂传来机械关闭的轰鸣，围绕在沉默的黛伦和你之间。","style":3,"background":1048,"log_type":1,"src_id":120303123,"trial_step":123},{"step":123,"content":"大门打开，工人们涌出来，你们二人站在川流不止的人群中，像没入海洋中的水滴。","style":3,"background":1048,"log_type":1,"src_id":120303124,"trial_step":124},{"step":124,"speaker":"黛伦","content":"对，就是这样，但……又有什么办法呢？","voice":["vo_trial_20303_1_125"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303125,"trial_step":125},{"step":125,"content":"隔着数个人，黛伦憨厚地朝你一笑，就像你第一次见到她的时候那样。","style":3,"background":1048,"log_type":1,"src_id":120303126,"trial_step":126},{"step":126,"speaker":"黛伦","content":"拍电影需要钱呀，那部电影有很多人投资。","voice":["vo_trial_20303_1_127"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303127,"trial_step":127},{"step":127,"speaker":"黛伦","content":"我也想要全世界看到我的电影，我的想法。","voice":["vo_trial_20303_1_128"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303128,"trial_step":128},{"step":128,"speaker":"黛伦","content":"可是没办法，如果用原来的版本，根本没法参加片选……不参加片选，所有人都会失败。","voice":["vo_trial_20303_1_129"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303129,"trial_step":129},{"step":129,"speaker":"黛伦","content":"我不能这么做。","voice":["vo_trial_20303_1_130"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303130,"trial_step":130},{"step":130,"content":"太阳快要落下，附近的温度变得有些低，呼吸之中依稀看见一点稀薄的白雾。","style":3,"background":1048,"log_type":1,"src_id":120303131,"trial_step":131},{"step":131,"speaker":"黛伦","content":"那部电影在狄斯卡上播出后，大家都在叫好，大家都在庆祝。","voice":["vo_trial_20303_1_132"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303132,"trial_step":132},{"step":132,"speaker":"黛伦","content":"只有我在愤怒——我不是愤怒现实，因为所有人都没错。","voice":["vo_trial_20303_1_133"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303133,"trial_step":133},{"step":133,"speaker":"黛伦","content":"我只是在……愤怒自己吧，可能。","voice":["vo_trial_20303_1_134"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303134,"trial_step":134},{"step":134,"speaker":"黛伦","content":"在不断的愤怒和自我劝解之中，好像有什么东西从我的意识里炸开，它们化身成无数道阴影，可能是五十道？呵呵，它们绑架了我的一切想象，在我的眼前上演。","voice":["vo_trial_20303_1_135"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303135,"trial_step":135},{"step":135,"content":"黛伦张开双手，学着自己电影中起舞的舞者们，绕着你转了一圈。","style":3,"background":1048,"log_type":1,"src_id":120303136,"trial_step":136},{"step":136,"speaker":"黛伦","content":"那场舞会在我面前上演了一次又一次，它们在我眼前死了一次又一次。","voice":["vo_trial_20303_1_137"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303137,"trial_step":137},{"step":137,"speaker":"黛伦","content":"我想要再为它们做些什么，又去拍了些短片，去上了一些我从前一直都不愿意去的访谈节目。","voice":["vo_trial_20303_1_138"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303138,"trial_step":138},{"step":138,"speaker":"黛伦","content":"可是那些话语，就像萤火虫飞入霓虹灯的魔爪，就算发光，依旧还是被掩盖。","voice":["vo_trial_20303_1_139"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303139,"trial_step":139},{"step":139,"content":"旋转的角度，让黛伦正好背对着你，你看不清她的表情，只能听到她无奈，无谓，无因的声音。","style":3,"background":1048,"log_type":1,"src_id":120303140,"trial_step":140},{"step":140,"speaker":"黛伦","content":"所以啊，那就算了吧。","voice":["vo_trial_20303_1_141"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303141,"trial_step":141},{"step":141,"speaker":"黛伦","content":"我也接受现实吧，我接受现实并不会死。","voice":["vo_trial_20303_1_142"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303142,"trial_step":142},{"step":142,"speaker":"黛伦","content":"他们该狂欢的狂欢，该贩卖的贩卖，我息影前的那些东西，够我吃一辈子了。","voice":["vo_trial_20303_1_143"],"voice_bank":"vo_deren_trial","style":1,"background":1048,"log_type":1,"src_id":120303143,"trial_step":143},{"step":143,"content":"你看着黛伦的背影，她的肩膀微微耸起，像胜利的意志一般往自己的腮骨聚集。","style":3,"background":1048,"log_type":1,"src_id":120303144,"trial_step":144},{"step":144,"content":"你走上前去，站在她的身边，学着她漫不经心的慵懒语调。","style":3,"background":1048,"log_type":1,"src_id":120303145,"trial_step":145},{"step":145,"content":"谁说都接受了现实？或者……接受了现实，就不能再改变了吗？就算是……认命了吗？","style":2,"background":1048,"log_type":1,"src_id":120303146,"trial_step":146}]}