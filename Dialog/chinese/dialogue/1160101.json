":51,"drawing":1160115},{"step":49,"content":"艾瑞尔低着头，像是个做错事被家长抓包的孩子，等待你的斥责。","style":3,"log_type":1,"src_id":260101052,"trial_step":52,"drawing":1160115},{"step":50,"content":"她不像在撒谎，可是她对待狂厄的立场和她的家族有明显的矛盾。","style":3,"log_type":1,"src_id":260101053,"trial_step":53,"drawing":1160115},{"step":51,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":52,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":53,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":54,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":55,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":56,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":57,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":58,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":59,"content":"我们已经查到了你的身份，你是斯宾塞家的大小姐，对吗？","style":2,"log_type":1,"src_id":260101055,"trial_step":55,"drawing":1160128},{"step":60,"speaker":"艾瑞尔","content":"您知道了？","voice":["vo_trial_160101_1_54"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101056,"trial_step":56,"drawing":1160128},{"step":61,"content":"这是新城商界很有名望的家族，并且一直为清除新城狂厄提供了很多经济支持。","style":2,"log_type":1,"src_id":260101057,"trial_step":57,"drawing":1160128},{"step":62,"content":"虽然不排除同名同姓的可能，但你身上这件礼服，应该不是普通家庭能够负担得起的吧？","style":2,"log_type":1,"src_id":260101058,"trial_step":58,"drawing":1160128},{"step":63,"speaker":"艾瑞尔","content":"我不是故意要隐瞒的！","voice":["vo_trial_160101_1_57"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101059,"trial_step":59,"drawing