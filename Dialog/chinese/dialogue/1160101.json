{"id":1160101,"chapter_id":1160101,"scene_id":1,"steps":[{"step":1,"speaker":"艾瑞尔","content":"这里是……什么地方？","voice":["vo_trial_160101_1_1"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101002,"trial_step":2,"drawing":1160118},{"step":2,"content":"女孩极力压抑着自己的不安，声音有些发抖。","style":3,"log_type":1,"src_id":260101003,"trial_step":3,"drawing":1160118},{"step":3,"content":"这里是审查室，审问你罪行的地方。","style":2,"log_type":1,"src_id":260101004,"trial_step":4,"drawing":1160118},{"step":4,"speaker":"艾瑞尔","content":"啊……","voice":["vo_trial_160101_1_5"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101006,"trial_step":6,"drawing":1160118},{"step":5,"content":"突然亮起的强光似乎吓到了她。","style":3,"log_type":1,"src_id":260101007,"trial_step":7,"drawing":1160118},{"step":6,"options":["温和宽慰","严厉逼供"],"style":6,"log_type":1,"src_id":260101008,"trial_step":8,"course":3,"drawing":1160118,"choices":[{"text":"温和宽慰","goto":13},{"text":"严厉逼供","goto":9}]},{"step":7,"content":"说！叫什么名字，犯过什么罪，为什么犯罪？","style":2,"log_type":1,"src_id":260101009,"trial_step":9,"drawing":1160118},{"step":8,"speaker":"艾瑞尔","content":"我叫艾瑞尔，我……对不起！都是我的错！是我给您添麻烦了……","voice":["vo_trial_160101_1_9"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101010,"trial_step":10,"drawing":1160118},{"step":9,"content":"她急得快哭出来了，但只是一味地道歉，根本无法冷静回答你的问题。看来得换一种交流方式。","style":3,"log_type":1,"src_id":260101011,"trial_step":11,"drawing":1160118},{"step":10,"options":["温和宽慰"],"style":6,"log_type":1,"src_id":260101012,"trial_step":12,"course":3,"drawing":1160118,"choices":[{"text":"温和宽慰","goto":13}]},{"step":11,"content":"别怕，艾瑞尔，只是口头审问。MBCC会保障你作为狄斯公民的人格尊严。","style":2,"log_type":1,"src_id":260101013,"trial_step":13,"drawing":1160118},{"step":12,"speaker":"艾瑞尔","content":"好……","voice":["vo_trial_160101_1_13"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101014,"trial_step":14,"drawing":1160124},{"step":13,"content":"她双手紧攥，似乎还没能完全放松下来，你继续放缓态度。","style":3,"log_type":1,"src_id":260101016,"trial_step":16,"drawing":1160124},{"step":14,"content":"我接下来会跟你确认一下基本信息，作为进一步的了解，可以吗？","style":2,"log_type":1,"src_id":260101017,"trial_step":17,"drawing":1160124},{"step":15,"content":"她战战兢兢地点点头。","style":3,"log_type":1,"src_id":260101018,"trial_step":18,"drawing":1160124},{"step":16,"content":"你知道自己为什么会在这里吗？","style":2,"log_type":1,"src_id":260101019,"trial_step":19,"drawing":1160124},{"step":17,"speaker":"艾瑞尔","content":"嗯……我在FAC警员面前使用了禁闭者的能力……","voice":["vo_trial_160101_1_18"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101020,"trial_step":20,"drawing":1160124},{"step":18,"speaker":"艾瑞尔","content":"我伤到了那些警员，也影响了清理狂厄的工作……","voice":["vo_trial_160101_1_19"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101021,"trial_step":21,"drawing":1160124},{"step":19,"options":["为什么要阻碍FAC？"],"style":6,"log_type":1,"src_id":260101022,"trial_step":22,"course":3,"drawing":1160124,"choices":[{"text":"为什么要阻碍FAC？","goto":23}]},{"step":20,"speaker":"艾瑞尔","content":"我真的不是故意的……我，我只是想保护那个女孩……我不知道会这样……","voice":["vo_trial_160101_1_21"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101023,"trial_step":23,"drawing":1160113},{"step":21,"speaker":"艾瑞尔","content":"对不起！真的对不起！","voice":["vo_trial_160101_1_22"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101024,"trial_step":24,"drawing":1160113},{"step":22,"content":"她似乎真的不太适应这种形式的问话，逼仄的氛围使她有些语无伦次。","style":3,"log_type":1,"src_id":260101025,"trial_step":25,"drawing":1160113},{"step":23,"options":["你冷静一点，慢慢说"],"style":6,"log_type":1,"src_id":260101026,"trial_step":26,"course":3,"drawing":1160113,"choices":[{"text":"你冷静一点，慢慢说","goto":27}]},{"step":24,"content":"你刚刚提到要保护的那个女孩，她是谁？","style":2,"log_type":1,"src_id":260101027,"trial_step":27,"drawing":1160124},{"step":25,"speaker":"艾瑞尔","content":"我……我不认识她。","voice":["vo_trial_160101_1_26"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101028,"trial_step":28,"drawing":1160124},{"step":26,"conten