{"id":402401601,"chapter_id":21000104,"scene_id":404,"steps":[{"step":1,"content":"笼罩一切的黑暗当中，两个小小的人儿手牵着手，一前一后行走在大地上。","style":3,"background":2228,"log_type":1},{"step":2,"content":"在火光的指引下，不管黑暗有多大，都不再害怕。","style":3,"background":2228,"log_type":1},{"step":3,"speaker":"选项","options":["害怕吗？"],"jump":[4],"style":6,"background":2228,"log_type":1},{"step":4,"content":"小火炬轻轻戳了你一下。","style":3,"background":2228,"log_type":1},{"step":5,"speaker":"赫斯提亚","content":"怕的人是你吧？手凉成这样。好了，抓紧点，我的手热乎呢。","voice":["vo_event_402401601_5"],"voice_bank":"vo_event_24016","style":1,"background":2228,"log_type":1},{"step":6,"speaker":"赫斯提亚","content":"我给你勇气。","voice":["vo_event_402401601_6"],"voice_bank":"vo_event_24016","style":1,"background":2228,"log_type":1},{"step":7,"content":"你牵着她的手，两人伴着火苗的弱光，行走在黑暗中，却再也没有胆怯。","style":3,"background":2228,"log_type":1}]}