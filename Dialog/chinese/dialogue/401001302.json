{"id":401001302,"chapter_id":50025,"scene_id":52507,"steps":[{"step":1,"speaker":"罗睺","content":"想把我困在那个破落花店吗？那你的机关还太嫩了点。","voice":["vo_event_401001301_14"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":2,"speaker":"罗睺","content":"但我要谢谢你……帮我争取进这门的资格！","voice":["vo_event_401001301_15"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":3,"content":"在面罩的遮蔽下，罗睺放肆地笑着，两眼放光，狂厄的灼痕浮现。重盾展开成利剑，她冲向那个刺客，一击击碎了整个大门。","style":3,"background":2094,"log_type":1},{"step":5,"content":"她用力压制住那个刺客，低声说着。","style":3,"background":2094,"log_type":1},{"step":6,"speaker":"罗睺","content":"我没想今天要你的命，但再缠着不放可就难说了。","voice":["vo_event_401001302_2"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":7,"speaker":"罗睺","content":"滚，别再碍事！","voice":["vo_event_401001302_3"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":8,"speaker":"阴影中的刺客","content":"啧……","voice":["vo_event_401001302_4"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":9,"content":"刺客小指一动，扯动看不见的丝线，一道寒光应声向罗睺刺来。罗睺后撤半步避开，也顺势松开了对刺客的桎梏。那人便挣扎冲破围障，消失在围墙之后。","style":3,"background":2094,"log_type":1},{"step":11,"content":"待外面惊呼的警卫声音渐渐远去，屋里的人才缓过神来。","style":3,"background":2094,"log_type":1},{"step":12,"speaker":"怯懦的警卫","content":"……赢、赢了？","voice":["vo_event_401001302_7"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":13,"speaker":"焦躁的警卫","content":"还愣着干什么？快去追！","voice":["vo_event_401001302_8"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":14,"content":"罗睺捡起刚刚袭来的银针，其后果然挂着一根细线，银线的另一头，她找到了一封花笺。端详一会儿，收入衣袋。","style":3,"background":2094,"log_type":1},{"step":15,"speaker":"罗睺","content":"敌人闯入太深，也擅长使用狂厄力量。当务之急是重新检查别墅内部，排除污染的可能，确保对象安全。","voice":["vo_event_401001302_10"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":16,"speaker":"罗睺","content":"让开，我要进去检查。","voice":["vo_event_401001302_11"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":17,"content":"警卫们反应过来，立刻上前拦住罗睺。","style":3,"background":2094,"log_type":1},{"step":18,"speaker":"怯懦的警卫","content":"不行！那位女士受伤正在静养，不能被打扰。","voice":["vo_event_401001302_13"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":19,"speaker":"罗睺","content":"动静这么大，她早该起来了。","voice":["vo_event_401001302_14"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":20,"speaker":"怯懦的警卫","content":"可你是禁闭者，上庭不会愿意的，上庭不接受禁闭者，你、你不能威胁她的安全！","voice":["vo_event_401001302_15"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":21,"content":"通往目标的门近在眼前，却还要被一群蠢货阻拦。罗睺逐渐失去耐心。","style":3,"background":2094,"log_type":1},{"step":22,"speaker":"罗睺","content":"拦不住狂厄刺客，却只在这儿浪费我的时间，一群废物。滚开！","voice":["vo_event_401001302_17"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":23,"speaker":"罗睺","content":"告诉那个装模作样的上庭人：她的命是我保下来的，还想要的话，就把门打开，出来见我！","voice":["vo_event_401001302_18"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":24,"speaker":"怯懦的警卫","content":"你——","voice":["vo_event_401001302_19"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":25,"speaker":"？？","content":"让她进来吧。","voice":["vo_event_401001302_20"],"voice_bank":"vo_event_10013","style":11,"background":2094,"log_type":1},{"step":26,"content":"警卫通信器传来一个轻柔的声音。所有人愣了一下，随即，一个女仆走出长廊，示意带路。","style":3,"background":2094,"log_type":1},{"step":27,"content":"罗睺的目光死死盯着长廊的尽头，握着盾的手攥紧又放松，面罩微微起伏着。许久，她才迈出步子。","style":3,"background":2094,"log_type":1},{"step":28,"content":"走过玄关，穿过长廊，推开卧室门，当走到那个上庭女人床边时，罗睺已经恢复镇定。她看向卧床的女人。","style":3,"background":2096,"log_type":1},{"step":29,"speaker":"罗睺","content":"初次见面，女士。我是你的临时护卫，罗睺。","voice":["vo_event_401001302_24"],"voice_bank":"vo_event_10013","style":1,"background":2096,"log_type":1},{"step":31,"speaker":"？？","content":"你好，罗睺。","voice":["vo_event_401001302_25"],"voice_bank":"vo_event_10013","style":1,"background":2096,"log_type":1},{"step":32,"speaker":"？？","content":"我是<color=#fb9259>瑟琳</color>。我想见你很久了。","voice":["vo_event_401001302_26"],"voice_bank":"vo_event_10013","style":1,"background":2096,"log_type":1}]}