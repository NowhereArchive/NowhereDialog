{"id":1041103,"chapter_id":1041103,"scene_id":1,"steps":[{"step":1,"content":"欢闹的脚步声由远及近。","style":3,"background":1052,"log_type":1,"src_id":141103001,"trial_step":1},{"step":2,"content":"孩子们笑着、推搡着跑过孤儿院的走廊。戴着老花镜的婆婆端着一大盘刚发酵好的面团路过，差点儿被脚下的捣蛋鬼们撞到。","style":3,"background":1052,"log_type":1,"src_id":141103002,"trial_step":2},{"step":3,"content":"好在身后有人快步上前，稳稳扶住她。","style":3,"background":1052,"log_type":1,"src_id":141103004,"trial_step":4},{"step":4,"speaker":"克莱门汀","content":"小心！安妮，别带着大家疯跑，还有你们这些小鬼，算术作业做完了吗？","voice":["vo_trial_41101_3_4"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103005,"trial_step":5},{"step":5,"speaker":"小男孩A","content":"早做完了，克莱门汀姐姐，安妮垫底，赛尔又是第一。","voice":["vo_trial_41101_3_5"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103006,"trial_step":6},{"step":6,"speaker":"克莱门汀","content":"我就知道。安妮快把你的小熊拿回去，赛尔不会因为多玩了一会儿小熊就帮你写作业的。","voice":["vo_trial_41101_3_6"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103007,"trial_step":7},{"step":7,"speaker":"小女孩A","content":"那就过来还给我啊！","voice":["vo_trial_41101_3_7"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103008,"trial_step":8},{"step":8,"speaker":"小男孩B","content":"别跑！","voice":["vo_trial_41101_3_8"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103009,"trial_step":9},{"step":9,"content":"孩子们叫起来一个比一个声大，克莱门汀抱着双臂，只能无奈耸肩。","style":3,"background":1052,"log_type":1,"src_id":141103010,"trial_step":10},{"step":10,"content":"突然，一只粗粝有力的大手从天而降，捉住小熊然后高高举起。","style":3,"background":1052,"log_type":1,"src_id":141103011,"trial_step":11},{"step":11,"speaker":"小女孩A","content":"还给我！——？！威廉叔叔！","voice":["vo_trial_41101_3_11"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103012,"trial_step":12},{"step":12,"speaker":"威廉","content":"闹够了没？不许在屋里跑，再吵，就让小熊换一个好主人学学规矩。","voice":["vo_trial_41101_3_12"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103013,"trial_step":13},{"step":13,"speaker":"孩子们","content":"我们再也不敢了！","voice":["vo_trial_41101_3_13"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103014,"trial_step":14},{"step":14,"speaker":"小女孩A","content":"我……我也再也不敢了！","voice":["vo_trial_41101_3_14"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103015,"trial_step":15},{"step":15,"content":"小孩们被冷面威廉吓得不行，眼看眼泪就要冒出来。但很快，边上冒出来另一个调侃的声音。","style":3,"background":1052,"log_type":1,"src_id":141103016,"trial_step":16},{"step":16,"speaker":"艾莉森","content":"哟！大家都在啊。威廉不是今天就准备跟我姐告白吗，怎么还在这儿教育小朋友，不会……这回又要打退堂鼓吧？","voice":["vo_trial_41101_3_16"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103017,"trial_step":17},{"step":17,"speaker":"威廉","content":"什么，你们怎么知道——","voice":["vo_trial_41101_3_18"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103018,"trial_step":18},{"step":18,"content":"艾莉森早已作为砂船乘务员出门工作赚钱，平日并不着家，难得出现一次，就笑嘻嘻地接过婆婆手中的托盘，一句话瞬间让威廉脸色爆红。","style":3,"background":1052,"log_type":1,"src_id":141103019,"trial_step":19},{"step":19,"content":"而更让他绝望的是，边上的琼斯婆婆也露出了然的笑容。","style":3,"background":1052,"log_type":1,"src_id":141103020,"trial_step":20},{"step":20,"speaker":"琼斯婆婆","content":"是啊，这都排练过多少回了。这些天伊丽莎白不在，你瞧他，每天脸都快拉到地上了。","voice":["vo_trial_41101_3_20"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103021,"trial_step":21},{"step":21,"speaker":"艾莉森","content":"哦~原来如此，你是差点<color=#fb9259>鼓励</color>啊。这时候应该怎么做呀？","voice":["vo_trial_41101_3_21"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103022,"trial_step":22},{"step":22,"speaker":"小女孩A","content":"嗷！我知道了！我们要说——","voice":["vo_trial_41101_3_22"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103023,"trial_step":23},{"step":23,"speaker":"孩子们","content":"加油威廉！","voice":["vo_trial_41101_3_23"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103024,"trial_step":24},{"step":24,"content":"一阵哄笑下，威廉终于红着脸压了压帽檐。","style":3,"background":1052,"log_type":1,"src_id":141103025,"trial_step":25},{"step":25,"speaker":"威廉","content":"拜托，艾莉森，这本来是一个惊喜！还有你们——","voice":["vo_trial_41101_3_25"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103026,"trial_step":26},{"step":26,"content":"他假装板起脸，双指指了指眼睛，又指了指孩子们。小机灵鬼们瞬间捂住嘴，手牵着手，乖乖排成一排去阅读室。","style":3,"background":1052,"log_type":1,"src_id":141103027,"trial_step":27},{"step":27,"speaker":"艾莉森","content":"需要我帮忙吗？三百狄斯币，情话支持加氛围担当一条龙服务哦~","voice":["vo_trial_41101_3_27"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103028,"trial_step":28},{"step":28,"speaker":"威廉","content":"别！你们别添乱啊，看到人我更紧张……","voice":["vo_trial_41101_3_28"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103029,"trial_step":29},{"step":29,"content":"威廉视线在屋里转了一圈，最终落在克莱门汀身上。克莱门汀摊手，一副“别看我我很无辜”的样子。","style":3,"background":1052,"log_type":1,"src_id":141103030,"trial_step":30},{"step":30,"speaker":"威廉","content":"克莱门汀！你最靠谱，帮帮忙，快去讲个好故事让孩子们转移注意力。好不容易等到伊丽莎白进城的空档，我要再练习几遍。千万别让他们说漏嘴！","voice":["vo_trial_41101_3_30"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103031,"trial_step":31},{"step":31,"speaker":"克莱门汀","content":"好啊，我不打扰，你自己慢慢练。","voice":["vo_trial_41101_3_31"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103032,"trial_step":32},{"step":32,"speaker":"克莱门汀","content":"不过……炉子下面那束花我帮你先拿出来了，再熏一会儿，都要变得和烤鸡一个味道了。","voice":["vo_trial_41101_3_32"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103033,"trial_step":33},{"step":33,"speaker":"威廉","content":"你什么时候发现的？！","voice":["vo_trial_41101_3_33"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103034,"trial_step":34},{"step":34,"content":"察觉到威廉的恼怒，孩子们瞬间一哄而散。","style":3,"background":1052,"log_type":1,"src_id":141103035,"trial_step":35},{"step":35,"content":"走廊里的阳光温暖，炫光的粒子飞散开去。孩子们嬉闹着跑过走廊，他们在门框处比身高，却怎么也高不过最上方的克莱门汀。","style":3,"background":1052,"log_type":1,"src_id":141103036,"trial_step":36},{"step":36,"content":"——这里并不宽敞，也并不富裕，但它干净而温暖。这里就是所有人的家。","style":3,"background":1052,"log_type":1,"src_id":141103037,"trial_step":37},{"step":37,"content":"【转场】","style":18,"background":1052,"log_type":1,"src_id":141103038,"trial_step":38},{"step":38,"content":"空气中满是苦荞花的香气，孩子们乖乖围绕着坐在沙发上的克莱门汀。","style":3,"background":1052,"log_type":1,"src_id":141103039,"trial_step":39},{"step":39,"speaker":"克莱门汀","content":"那……谁记得，我们上次读到哪里了？","voice":["vo_trial_41101_3_42"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103040,"trial_step":40},{"step":40,"speaker":"小女孩A","content":"讲到我们去红杉木国探险，却被森林里的恶魔小熊设计关在了蜘蛛窝里——","voice":["vo_trial_41101_3_43"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103041,"trial_step":41},{"step":41,"speaker":"小男孩B","content":"我们都被蜘蛛丝吊起来了，可艾莉森魔法师还在等探险小队的消息呢！","voice":["vo_trial_41101_3_44"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103042,"trial_step":42},{"step":42,"speaker":"克莱门汀","content":"不错。看来听得很认真嘛，勇敢的探险家们。","voice":["vo_trial_41101_3_45"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103043,"trial_step":43},{"step":43,"content":"少女捧着手写的本子，给孩子们描绘出一个光怪离奇的世界。","style":3,"background":1052,"log_type":1,"src_id":141103044,"trial_step":44},{"step":44,"speaker":"克莱门汀","content":"那天之后——","voice":["vo_trial_41101_3_47"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103045,"trial_step":45},{"step":45,"speaker":"克莱门汀","content":"当朝阳穿过薄雾照入岩洞，你们终于拿艾莉森扔进来的魔晶小刀割开了结实的蜘蛛茧。天光翠绿，林木不再鬼气森森，蜘蛛们似乎瞌睡起来，缩回巢穴。","voice":["vo_trial_41101_3_48"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103046,"trial_step":46},{"step":46,"speaker":"克莱门汀","content":"安妮抓着毛绒绒的熊爪向它们飞了个吻。探险家们迎着阳光再度启程。","voice":["vo_trial_41101_3_49"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1052,"log_type":1,"src_id":141103047,"trial_step":47},{"step":47,"content":"琼斯婆婆是红杉木国的女王、臭脸的威廉是不善言辞但心地善良的警察、调皮的艾莉森是神出鬼没的魔法师，探险的孩子们各个身怀绝技。","style":3,"background":1052,"log_type":1,"src_id":141103048,"trial_step":48},{"step":48,"content":"孩子们沉浸其中，惊叫连连，陷入困境时还会讨论一番。","style":3,"background":1052,"log_type":1,"src_id":141103050,"trial_step":50},{"step":49,"content":"在克莱门汀的故事里，主角战胜坏蛋，正义必将胜利，这点倒是与她之后的作品一脉相承。","style":3,"background":1052,"log_type":1,"src_id":141103051,"trial_step":51},{"step":50,"content":"如果……能就这样一直讲下去……","style":3,"background":1052,"log_type":1,"src_id":141103052,"trial_step":52},{"step":51,"content":"【转场】","style":18,"background":10006,"log_type":1,"src_id":141103053,"trial_step":53},{"step":52,"content":"大火很快吞没了一切。","style":3,"background":1062,"log_type":1,"src_id":141103054,"trial_step":54},{"step":53,"content":"火不知是从哪里烧起来的，起先是堆满了杂物的储藏室，那些旧到无法使用的家具和孤儿院刚收到的捐赠物一起引燃了整个大楼。","style":3,"background":1062,"log_type":1,"src_id":141103055,"trial_step":55},{"step":54,"content":"火势缓慢地蚕食着一切可燃物，直到厨房。燃气轰然爆炸，那棵巨大的老树被卷入火海，火光映红了天空的月亮。","style":3,"background":1062,"log_type":1,"src_id":141103056,"trial_step":56},{"step":55,"content":"克莱门汀绝望地冲入火海，又反复被爆炸产生的火焰推出来。","style":3,"background":1062,"log_type":1,"src_id":141103057,"trial_step":57},{"step":56,"speaker":"克莱门汀","content":"安妮、赛尔？娜娜、薇奥拉——咳咳，你们在哪儿？","voice":["vo_trial_41101_3_61"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1062,"log_type":1,"src_id":141103058,"trial_step":58},{"step":57,"content":"孩子们在浓烟密布的房间内发出哭喊。克莱门汀裹着浸满冰水的毛毯，寻找着可以进入的地方。警车和消防队的鸣笛声显得异常遥远和缓慢。","style":3,"background":1062,"log_type":1,"src_id":141103059,"trial_step":59},{"step":58,"content":"恍惚之间，一个陌生的人影在围墙边踌躇，看到克莱门汀，立刻转身跨过砸下来的梁木，拔腿就往森林里跑。","style":3,"background":1062,"log_type":1,"src_id":141103060,"trial_step":60},{"step":59,"speaker":"克莱门汀","content":"喂，那边危险——！","voice":["vo_trial_41101_3_64"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1062,"log_type":1,"src_id":141103061,"trial_step":61},{"step":60,"content":"一个可怕的念头突然出现在她脑海，像是重锤敲打着她濒临崩溃的神经。","style":3,"background":1062,"log_type":1,"src_id":141103062,"trial_step":62},{"step":61,"speaker":"克莱门汀","content":"等等，站住……站住！你是谁？为什么会在那里？！","voice":["vo_trial_41101_3_66"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1062,"log_type":1,"src_id":141103063,"trial_step":63},{"step":62,"content":"愤怒几乎冲昏她的理智，她紧紧跟上那个身影。就在这时，细弱的哭声从那根砸下来的木头后方传来。","style":3,"background":1062,"log_type":1,"src_id":141103064,"trial_step":64},{"step":63,"speaker":"？？","content":"姐姐……我的身上好痛、好……痛……","voice":["vo_trial_41101_3_68"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1062,"log_type":1,"src_id":141103065,"trial_step":65},{"step":64,"content":"克莱门汀脚下一滞，她左右无措，慌乱地折返回去，再回头，那身影已消失在视线中。","style":3,"background":1062,"log_type":1,"src_id":141103066,"trial_step":66},{"step":65,"content":"【继续火场】","style":18,"background":503,"log_type":1,"src_id":141103067,"trial_step":67},{"step":66,"content":"眼前墙面早已被熏黑，火势越来越大。这下她听清楚了，声音来自那扇小小的窗口，太小的孩子绝对爬不上那扇窗口，有谁在下面推了她一把。","style":3,"background":503,"log_type":1,"src_id":141103068,"trial_step":68},{"step":67,"speaker":"克莱门汀","content":"别怕！姐姐在这儿，抓住我的手！！","voice":["vo_trial_41101_3_72"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":503,"log_type":1,"src_id":141103069,"trial_step":69},{"step":68,"content":"克莱门汀使出全身力气，搬动那根着火的木头，踩着还没烧起来的部分，终于握住了那只小手。","style":3,"background":503,"log_type":1,"src_id":141103070,"trial_step":70},{"step":69,"content":"火焰燃烧的声音混合着尖啸与悲鸣，又是一阵爆炸。她抱着孩子摔倒在地，滚出很远才熄灭身上的火。","style":3,"background":503,"log_type":1,"src_id":141103071,"trial_step":71},{"step":70,"speaker":"克莱门汀","content":"唔啊……咳、咳咳…………","voice":["vo_trial_41101_3_75"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":503,"log_type":1,"src_id":141103072,"trial_step":72},{"step":71,"content":"小小的孤儿院，承载着欢笑和幻想的家，在夜里燃烧成一抹冲天火柱……一棵“燃烧的红杉木”。","style":3,"background":503,"log_type":1,"src_id":141103073,"trial_step":73},{"step":72,"content":"【转场】","style":18,"background":2322,"log_type":1,"src_id":141103074,"trial_step":74},{"step":73,"speaker":"电视台主持人","content":"震惊新城的红杉木案发生后，新城治安局立刻响应调查，并于本月二十三号逮捕纵火嫌疑人。","voice":["vo_trial_41101_3_81"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":2322,"log_type":1,"src_id":141103075,"trial_step":75},{"step":74,"speaker":"电视台主持人","content":"犯罪嫌疑人声称只是醉酒，并无犯罪印象。本案的公开审理将于本月三十号在新城人民法院进行。","voice":["vo_trial_41101_3_82"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":2322,"log_type":1,"src_id":141103076,"trial_step":76},{"step":75,"speaker":"热心人士","content":"哎呀……那孤儿院的墙都被烧透了，一推就倒。造孽呀，不知道在火里没了的到底有多少个……","voice":["vo_trial_41101_3_83"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":2101,"log_type":1,"src_id":141103077,"trial_step":77},{"step":76,"speaker":"热心人士","content":"我听说最小的才只有五六岁呢……有一个孩子被救了出来，但同间房里还有好几个都没能……","voice":["vo_trial_41101_3_84"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":2101,"log_type":1,"src_id":141103078,"trial_step":78},{"step":77,"speaker":"小报记者","content":"犯人？早判了，全程稀里糊涂的，我看根本就不是他的问题，那就是个被推出来挡刀的。","voice":["vo_trial_41101_3_85"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":2101,"log_type":1,"src_id":141103079,"trial_step":79},{"step":78,"speaker":"小报记者","content":"这还不常见吗？快年底了，都是大事化小小事化了，治安局可急着结案呢。啧啧啧，这里面，水可深哪……","voice":["vo_trial_41101_3_86"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":2101,"log_type":1,"src_id":141103080,"trial_step":80},{"step":79,"content":"【一段演出。用几张不同背景图示意克莱门汀曾去过的不同地方。】","style":18,"background":2101,"log_type":1,"src_id":141103081,"trial_step":81},{"step":80,"content":"<i>之后的日子像是按下了加速键。\n\n孤儿院自然也不复存在，火灾调查以意外结束，但那天的身影始终出现在克莱门汀脑海中，让她日日失眠难耐。\n\n人们带着不同的目光涌来，愤怒的、怜悯的、猎奇的，那些目光总会有意无意扫到她，对上她的视线后再抱歉地移开。","style":14,"background":2108,"log_type":1,"src_id":141103082,"trial_step":82},{"step":81,"content":"<i>她好像一夜之间就长大了，却还是太小，太无能为力。\n\n大人们则为了大火的真相奔走着，踏上了一艘名为“普瑞瓦”号的砂船，然后……一去无归。\n\n克莱门汀重新变回一个孤儿。","style":14,"background":2000,"log_type":1,"src_id":141103083,"trial_step":83},{"step":82,"content":"<i>正义与法律不再可靠。为了公道，她必须得另寻他法。\n\n于是她又编起了故事。\n\n她为自己创造出无数的假名字假身份：落魄的新城贵族、专门处理黑活的私家侦探，或是曾插手过走私贸易的蛇头。\n\n通过伪装，她混迹在黑暗里，竟真的逐渐寻找出些线索。","style":14,"background":100,"log_type":1,"src_id":141103084,"trial_step":84},{"step":83,"content":"<i>一个名字，来自曾经孤儿院赞助人的名单。\n\n一个组织，藏着新城最深处最黑暗的肮脏。\n\n他们互相交换利益、遮掩罪恶。人命和金钱一样不过是个数字，像红杉木一样被压下的悲剧数不胜数。","style":14,"background":2020,"log_type":1,"src_id":141103085,"trial_step":85},{"step":84,"content":"<i>只是那些势力盘根错节，以她这样的蚍蜉根本无法撼动真凶，甚至差点丢了小命。\n\n在绝望的时刻，有人向她伸出了手。\n\n她已经失去了所有，接下来……即使是以命交换，也是稳赚不亏的，对吧？","style":14,"background":2408,"log_type":1,"src_id":141103086,"trial_step":86},{"step":85,"content":"【背景可以试试那个蓝色梦境的动态背景，或者看看有没有更合适的】","style":18,"background":10002,"log_type":1,"src_id":141103087,"trial_step":87},{"step":86,"content":"她再次拿起笔，不过这次不是给孩子们编织童话，而是为了复仇。她扮演着自己笔下的角色，用自己的笔罗织诱惑害虫的网。","style":3,"background":10002,"log_type":1,"src_id":141103088,"trial_step":88},{"step":87,"content":"只是有时，在她的梦境里会出现一条没有终点的路。","style":3,"background":10002,"log_type":1,"src_id":141103089,"trial_step":89},{"step":88,"content":"起初周围还是她熟悉的一切，常来往的几位朋友师长、出版社的编辑，熟悉的街道和住处、常去的店铺餐馆。","style":3,"background":10002,"log_type":1,"src_id":141103090,"trial_step":90},{"step":89,"content":"她越走越快，几乎要跑了起来，一个遥远的声音始终在她脑海中的角落里重复着。","style":3,"background":10002,"log_type":1,"src_id":141103091,"trial_step":91},{"step":90,"speaker":"？？","content":"跑快一点，再快一点！","voice":["vo_trial_41101_3_98"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":10002,"log_type":1,"src_id":141103092,"trial_step":92},{"step":91,"content":"直到四下皆静，黑暗无边，这声音越来越大，越来越清晰。这是克莱门汀自己的声音。","style":3,"background":10002,"log_type":1,"src_id":141103093,"trial_step":93},{"step":92,"speaker":"？？","content":"跑快一点，赶在火舌吞没走廊前，救出那些被困在房间里的孩子。","voice":["vo_trial_41101_3_101"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":10002,"log_type":1,"src_id":141103094,"trial_step":94},{"step":93,"speaker":"？？","content":"再快一点，在大火旁的围墙边追上去，明明那个时候就可以抓住凶手。","voice":["vo_trial_41101_3_102"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":10002,"log_type":1,"src_id":141103095,"trial_step":95},{"step":94,"speaker":"？？","content":"跑快一点，再快一点。在码头拽住院长婆婆的衣角，鼓起勇气再多问一句，你们要去哪，要去做什么？","voice":["vo_trial_41101_3_103"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":10002,"log_type":1,"src_id":141103096,"trial_step":96},{"step":95,"speaker":"？？","content":"哪怕……让我偷偷跟上去也好。","voice":["vo_trial_41101_3_104"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":10002,"log_type":1,"src_id":141103097,"trial_step":97},{"step":96,"content":"她不止一次懊悔，如果当时没有去救人，而是追上那个真凶，是不是一切就会不一样？","style":3,"background":10002,"log_type":1,"src_id":141103098,"trial_step":98},{"step":97,"speaker":"琼斯婆婆","content":"克莱门汀，你是最让人放心的孩子……就算我们不在身边，也要照顾好自己……","voice":["vo_trial_41101_3_106"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":10002,"log_type":1,"src_id":141103099,"trial_step":99},{"step":98,"speaker":"？？","content":"只有我被留下……只有我是一个人……","voice":["vo_trial_41101_3_107"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":10002,"log_type":1,"src_id":141103100,"trial_step":100},{"step":99,"content":"可是哪有什么如果，结局已经注定，属于红杉木孤儿院的故事注定无法继续下去。时光像是黏腻的潮水，将她反复推上岸，又从不肯放她走。","style":3,"background":10002,"log_type":1,"src_id":141103101,"trial_step":101},{"step":100,"content":"克莱门汀深一脚浅一脚地走，直到愤怒烧成灰烬，愧疚风化成沙，最后连痛感都麻木了，只剩下一点燃烧后的余烬和火星。","style":3,"background":10002,"log_type":1,"src_id":141103102,"trial_step":102},{"step":101,"content":"她不甘地燃烧着，行走着，世界变得虚无而纯粹。","style":3,"background":10002,"log_type":1,"src_id":141103103,"trial_step":103},{"step":102,"content":"——直到仇恨也得以被纾解。她蓦然回首，却发现周身一片虚无。","style":3,"background":10002,"log_type":1,"src_id":141103104,"trial_step":104},{"step":103,"speaker":"克莱门汀","content":"…………","style":1,"background":10002,"log_type":1,"src_id":141103105,"trial_step":105},{"step":104,"speaker":"克莱门汀","content":"我……是要去哪来着？","voice":["vo_trial_41101_3_113"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":10002,"log_type":1,"src_id":141103106,"trial_step":106},{"step":105,"speaker":"克莱门汀","content":"……我……还能去哪呢……？","voice":["vo_trial_41101_3_114"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":10002,"log_type":1,"src_id":141103107,"trial_step":107},{"step":106,"content":"虚无中，似乎有人在喊什么。","style":3,"background":10002,"log_type":1,"src_id":141103108,"trial_step":108},{"step":107,"speaker":"局长","content":"——克莱门汀，回来！","style":2,"background":10002,"log_type":1,"src_id":141103109,"trial_step":109},{"step":108,"content":"有手伸过来想拽住她，却从她逐渐透明的身体穿过。","style":3,"background":10002,"log_type":1,"src_id":141103110,"trial_step":110},{"step":109,"speaker":"局长","content":"克莱门汀，不要再继续走了！你的复仇已经完成了，可以不用再继续了！","style":2,"background":10002,"log_type":1,"src_id":141103111,"trial_step":111},{"step":110,"content":"克莱门汀的身影逐渐变淡，变得透明，感觉也要随那些记忆去了。那人急切地出声叫她，她却像没听见一样，继续麻木地前进。","style":3,"background":10002,"log_type":1,"src_id":141103112,"trial_step":112},{"step":111,"content":"一只手靠近，轻轻将海拉的手拉开。","female_content":"那人越来越急，终于，她似乎下定决心。下一刻，尖刺从肢体相接的地方刺出——","style":3,"background":10002,"log_type":1,"src_id":141103113,"trial_step":113},{"step":112,"content":"【释放枷锁效果】","style":18,"background":10000,"log_type":1,"src_id":141103114,"trial_step":114},{"step":113,"content":"【转场，回现实】","style":18,"background":1055,"log_type":1,"src_id":141103115,"trial_step":115},{"step":114,"speaker":"局长","content":"克莱门汀！！","style":2,"background":1055,"log_type":1,"src_id":141103116,"trial_step":116},{"step":115,"content":"你猛然惊醒。右手掌心传来人类皮肤的温度与触感。","style":3,"background":1055,"log_type":1,"src_id":141103117,"trial_step":117},{"step":116,"speaker":"克莱门汀","content":"放心……我现在哪儿也去不了了。","voice":["vo_trial_41101_3_125"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141103118,"trial_step":118},{"step":117,"speaker":"克莱门汀","content":"劲儿真大啊。我的胳膊都被你抓痛了。","voice":["vo_trial_41101_3_126"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141103119,"trial_step":119},{"step":118,"options":["克莱门汀？你还好吗？"],"style":6,"background":1055,"log_type":1,"src_id":141103120,"trial_step":120,"course":3,"choices":[{"text":"克莱门汀？你还好吗？","goto":121}]},{"step":119,"content":"战斗已经结束了，遍地是战斗的痕迹。你在幻境中恍惚见证了克莱门汀的十年，而现实中度过的可能不过数十秒。","style":3,"background":1055,"log_type":1,"src_id":141103121,"trial_step":121},{"step":120,"content":"克莱门汀没有力气说话，也没有笑，只剩满满的疲惫。她一脚深一脚浅，状若无事拖着你走了几步，就像在幻境里那样。","style":3,"background":1055,"log_type":1,"src_id":141103122,"trial_step":122},{"step":121,"speaker":"克莱门汀","content":"嘘，别说话。护着人打架可比一个人单挑累多了，让我休息会儿吧。","voice":["vo_trial_41101_3_130"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141103123,"trial_step":123},{"step":122,"speaker":"克莱门汀","content":"……善后工作，就交给你了。","voice":["vo_trial_41101_3_131"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141103124,"trial_step":124},{"step":123,"content":"终于，她失去力气，一头栽倒下去。","style":3,"background":1055,"log_type":1,"src_id":141103125,"trial_step":125}]}