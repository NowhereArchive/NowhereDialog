{"id":400704501,"chapter_id":50019,"scene_id":51912,"steps":[{"step":1,"content":"你又回到了昨天遇袭的雾巷。","style":3,"background":2080,"log_type":1},{"step":2,"content":"与先前不同的是，雾墙早已消逝，还有几个镇民聚在一起聊着近日的经历。","style":3,"background":2080,"log_type":1},{"step":3,"speaker":"镇民A","content":"唉，你们这两天遇到过没有？就……那个灯……有个说话断断续续的灯？","voice":["vo_event_400704501_3"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":4,"speaker":"镇民A","content":"听说传得还挺玄乎的？什么“斯洛恩的提灯幽灵”？","voice":["vo_event_400704501_4"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":5,"speaker":"镇民C","content":"*文明雾巷*大晚上怎么还说这事……怪吓人的……","voice":["vo_event_400704501_5"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":6,"speaker":"镇民B","content":"真的，我朋友还碰见了。听他说*文明雾巷*突然出来个灯，说话还断断续续……还要跟它玩……","voice":["vo_event_400704501_6"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":7,"content":"旁边两人的心提到了嗓子眼。","style":3,"background":2080,"log_type":1},{"step":8,"speaker":"镇民B","content":"虽然他靠灯光走出了雾，但他前一阵子不知道怎么就进了精神病院……","voice":["vo_event_400704501_8"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":9,"content":"说话的镇民脸色铁青。","style":3,"background":2080,"log_type":1},{"step":10,"speaker":"镇民C","content":"千万别去暗巷知道么！千万别去！听到有人在雾里说话也千万别回应！一定要扭头就跑知道么！","voice":["vo_event_400704501_10"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":11,"speaker":"镇民A","content":"这……这么严重？","voice":["vo_event_400704501_11"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":12,"speaker":"镇民C","content":"你要是不跑，就等着被它折磨吧……网上那些视频没看过么？","voice":["vo_event_400704501_12"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":13,"speaker":"镇民B","content":"是啊……你只能在大雾里听它的笑声，听它杂乱的脚步声……每分每秒都在折磨着你……","voice":["vo_event_400704501_13"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":14,"speaker":"镇民A","content":"噫……","voice":["vo_event_400704501_14"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":15,"content":"几个镇民越说越邪乎，仿佛那个提灯就是街区的恶魔一般。看来你的经历比起这些镇民们来说还算好，至少它也算救了你一命。","style":3,"background":2080,"log_type":1},{"step":16,"content":"就在你要出声分享自己的经历时，你发现地上正放着一盏古朴的提灯。","style":3,"background":2080,"log_type":1},{"step":17,"content":"你将它提起，走向人群，想照亮这昏暗的空间。","style":3,"background":2080,"log_type":1},{"step":18,"content":"可提灯却抢先一步说了话。","style":3,"background":2080,"log_type":1},{"step":19,"speaker":"？？","content":"你们……好……","voice":["vo_event_400704501_19"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":20,"content":"提灯从你的手中脱离，漂浮在半空，传来断断续续的声音。和你那天在雾里听到的一模一样。","style":3,"background":2080,"log_type":1},{"step":21,"speaker":"？？","content":"有人……陪……","voice":["vo_event_400704501_21"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":22,"speaker":"镇民A","content":"这……是不是……","voice":["vo_event_400704501_22"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":23,"speaker":"镇民C","content":"*文明雾巷*！别发呆了！快*文明雾巷*给我跑！","voice":["vo_event_400704501_23"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":24,"speaker":"镇民B","content":"千万别回头！不然就再也回不来了！","voice":["vo_event_400704501_24"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":25,"content":"镇民们一溜烟地从你的面前消失。","style":3,"background":2080,"log_type":1},{"step":26,"speaker":"？？","content":"……","voice":["vo_event_400704501_26"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":27,"content":"漂浮在空中的提灯转了转，似乎注意到了还留在原地的你。","style":3,"background":2080,"log_type":1},{"step":28,"speaker":"？？","content":"是……你？","voice":["vo_event_400704501_28"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":29,"speaker":"？？","content":"太好了！","voice":["vo_event_400704501_29"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":30,"content":"它好像认出了你。","style":3,"background":2080,"log_type":1},{"step":31,"speaker":"？？","content":"你……能陪我玩么？","voice":["vo_event_400704501_31"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":32,"content":"提灯向你发出了邀请，并绕着你一圈一圈地缓慢旋转，像是在端详着你。","style":3,"background":2080,"log_type":1},{"step":33,"options":["抱歉","我还有别的事"],"jump":[34,34],"style":6,"background":2080,"log_type":1},{"step":34,"content":"你还要查清那个雾夜的真相，现在不是什么玩乐的时候，更何况它还是传闻中的恐怖幽灵。","style":3,"background":2080,"log_type":1},{"step":35,"speaker":"？？","content":"那……那……","voice":["vo_event_400704501_35"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":36,"speaker":"她早已原地开始踱起步来，掏出零零碎碎的东西，嘴里兴奋地碎碎念着什么，根本没在意你的问题。","content":"给你钱的话……可以陪我玩么……","voice":["vo_event_400704501_36"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":37,"options":["……"],"jump":[38],"style":6,"background":2080,"log_type":1},{"step":38,"speaker":"？？","content":"还是不行么……","voice":["vo_event_400704501_39"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":39,"speaker":"？？","content":"明明爸爸说……这世界上没有用钱解决不了的事情……","voice":["vo_event_400704501_40"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":40,"content":"这也不像是什么可怕的提灯幽灵啊……按理来说这里不是要进行精神攻击了么？","style":3,"background":2080,"log_type":1},{"step":41,"content":"不过……既然它能在雾中随意移动，它应该很熟悉那个疯剪子。","style":3,"background":2080,"log_type":1},{"step":42,"options":["你了解昨天的那个怪人么？"],"jump":[43],"style":6,"background":2080,"log_type":1},{"step":43,"speaker":"？？","content":"……怪人？","voice":["vo_event_400704501_43"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":44,"content":"提灯晃了两晃，似乎是理解了你的意思。","style":3,"background":2080,"log_type":1},{"step":45,"speaker":"？？","content":"哦！你是说……那个带着剪子的大姐姐么！她确实是个特别的人哦！","voice":["vo_event_400704501_45"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":46,"speaker":"？？","content":"不过要说是“怪人”可能还不够格呢。","voice":["vo_event_400704501_46"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":47,"content":"果然，它是知道什么的。","style":3,"background":2080,"log_type":1},{"step":48,"content":"虽然这话从一盏提灯里传出来怪不是滋味。","style":3,"background":2080,"log_type":1},{"step":49,"options":["我陪你玩。"],"jump":[50],"style":6,"background":2080,"log_type":1},{"step":50,"speaker":"提灯","content":"你答应我了？嘿嘿，好耶！","voice":["vo_event_400704501_50"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":51,"speaker":"玩家","content":"作为交换，你要告诉我那个疯剪子的，你所知道的一切。","style":2,"background":2080,"log_type":1},{"step":52,"speaker":"提灯","content":"嘿嘿，这当然陪我玩完才能告诉你了呀~","voice":["vo_event_400704501_52"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":53,"content":"灯火闪烁，一道黑影飘出，汇聚成一个实体。","style":3,"background":2080,"log_type":1},{"step":54,"options":["要玩什么？"],"jump":[55],"style":6,"background":2080,"log_type":1},{"step":55,"speaker":"黑影","content":"就玩捉迷藏吧！你能抓到我就算你赢！","voice":["vo_event_400704501_56"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":56,"content":"看来又要重复昨天的戏码了，但为了那剪刀的情报，你决定尽力一试。","style":3,"background":2080,"log_type":1},{"step":57,"speaker":"黑影","content":"数到五就开始，准备好哦！","voice":["vo_event_400704501_58"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":58,"content":"你点点头，做好了起跑的预备姿势。","style":3,"background":2080,"log_type":1},{"step":59,"speaker":"黑影","content":"一……","voice":["vo_event_400704501_60"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":60,"speaker":"黑影","content":"二……","voice":["vo_event_400704501_61"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":61,"speaker":"黑影","content":"五！","voice":["vo_event_400704501_62"],"voice_bank":"vo_event_07045","style":1,"background":2080,"log_type":1},{"step":62,"content":"随着光芒一闪，提灯便与你拉开了距离。你只得在惊诧中被迫开始了这场追逐。","style":3,"background":2080,"log_type":1}]}