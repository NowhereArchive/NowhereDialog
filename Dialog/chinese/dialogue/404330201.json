{"id":404330201,"chapter_id":50088,"scene_id":58862,"steps":[{"step":1,"content":"砰——！","style":18,"background":2511,"log_type":1},{"step":2,"content":"鲜血从海伦娜的胸口喷涌而出。","style":3,"background":2511,"log_type":1},{"step":3,"content":"砰砰——！","style":18,"background":2511,"log_type":1},{"step":4,"content":"接着是更多的枪响，飞舞的鸽子也飘然坠落。","style":3,"background":2511,"log_type":1},{"step":5,"speaker":"海伦娜","content":"……不……","voice":["vo_event_404330201_01"],"voice_bank":"vo_event_43302","style":1,"background":2511,"log_type":1},{"step":6,"speaker":"海伦娜","content":"……我不想……死……","voice":["vo_event_404330201_02"],"voice_bank":"vo_event_43302","style":1,"background":2511,"log_type":1},{"step":7,"content":"她用尽最后一丝残存的生命力，向你伸手，手指在冰冷的地上徒劳地抓挠了一下，留下几道浅痕。","style":3,"background":2511,"log_type":1},{"step":8,"speaker":"海伦娜","content":"我又…………选…………错了吗………………","voice":["vo_event_404330201_04"],"voice_bank":"vo_event_43302","style":1,"background":2511,"log_type":1},{"step":9,"content":"【黑屏】","style":18,"background":10000,"log_type":1},{"step":10,"content":"几分钟后，希露妲来到了海伦娜的尸体旁。","style":3,"background":10000,"log_type":1},{"step":11,"content":"在她拾起鸽子身上的纸卷同时，发现了一封被海伦娜贴身藏着的信件，你的身份由此曝光。","style":3,"background":10000,"log_type":1},{"step":12,"content":"随后你被诺兰押往了拷问室，等待你的，将是无穷无尽的折磨。","style":3,"background":10000,"log_type":1}]}