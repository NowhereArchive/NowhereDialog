{"id":4012,"chapter_id":4,"scene_id":401,"steps":[{"step":1,"speaker":"死役","content":"呜，呜呜——给我——给我————","voice":["vo_cgplot_4012001"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":2,"speaker":"海拉","content":"给我滚开！","voice":["vo_cgplot_4012002"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":3,"content":"她挥动水管，击飞一只爬上来的死役。","style":3,"background":401,"log_type":1},{"step":4,"speaker":"海拉","content":"动起来，动起来！这个破电梯，偏偏卡在这种不上不下的地方，逃都逃不掉！","voice":["vo_cgplot_4012004"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":5,"speaker":"海拉","content":"再这样下去，我们迟早会被它们生吞了的！\n——啊！","voice":["vo_cgplot_4012005"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":6,"content":"升降台猛地下坠一节，晃动两下，停住了。","style":3,"background":401,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"上面有什么东西。缆绳上——","voice":["vo_cgplot_4012007"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":8,"content":"升降梯的顶部已被掀飞，缆绳的顶端悬挂着几个扭曲的阴影，他们手中的狂厄大刀正前后摩擦着绳索。","style":3,"background":401,"log_type":1},{"step":9,"speaker":"死役","content":"喝哈——————喝哈————","voice":["vo_cgplot_4012009"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":10,"speaker":"海拉","content":"它们想切断缆绳！？","voice":["vo_cgplot_4012010"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":11,"content":"一瞬间，你从那没有灵魂的眼瞳中看到了赤裸裸的杀意、恶意。你从未在别的死役身上感受过。","style":3,"background":401,"log_type":1},{"step":12,"content":"刀光一闪，粗壮紧绷的绳索被锯断。你们脚下地面一沉，整个升降梯以意想不到的速度向下坠落。","style":3,"background":401,"log_type":1}]}