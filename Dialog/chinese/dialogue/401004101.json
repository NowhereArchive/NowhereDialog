{"id":401004101,"chapter_id":50025,"scene_id":52517,"steps":[{"step":1,"content":"N.F. 113年7月23日 10:30\n新城埃丽卡山庄 瑟琳宅","style":12,"background":2096,"log_type":1},{"step":2,"content":"这是个无梦的夜晚。将罗睺唤醒的是一阵清淡的花香。","style":3,"background":2096,"log_type":1},{"step":3,"content":"睁开眼，那个女人在不远处，轻轻摆弄着床头的插花。她摘掉了一些绷带，又缠上了新的。","style":3,"background":2096,"log_type":1},{"step":4,"speaker":"瑟琳","content":"吵醒你了？","voice":["vo_event_401004101_4"],"voice_bank":"vo_event_10041","style":1,"background":2096,"log_type":1},{"step":5,"speaker":"罗睺","content":"……你身体怎么样了。昨晚也淋了雨，而且……我不太记得了，昨晚我有没有攻击你？","voice":["vo_event_401004101_5"],"voice_bank":"vo_event_10041","style":1,"background":2096,"log_type":1},{"step":6,"speaker":"瑟琳","content":"我还好，伤得重的人是你。","voice":["vo_event_401004101_6"],"voice_bank":"vo_event_10041","style":1,"background":2096,"log_type":1},{"step":7,"speaker":"瑟琳","content":"回来后一整夜都醒不过来，他们都担心FAC尖兵出什么事了。","voice":["vo_event_401004101_7"],"voice_bank":"vo_event_10041","style":1,"background":2096,"log_type":1},{"step":8,"speaker":"罗睺","content":"我没什么事，睡得沉罢了。","voice":["vo_event_401004101_8"],"voice_bank":"vo_event_10041","style":1,"background":2096,"log_type":1},{"step":9,"speaker":"瑟琳","content":"没事就起来吧。","voice":["vo_event_401004101_9"],"voice_bank":"vo_event_10041","style":1,"background":2096,"log_type":1},{"step":10,"speaker":"瑟琳","content":"你昨晚还急着往前冲。怎么，现在开始犯懒了吗？","voice":["vo_event_401004101_10"],"voice_bank":"vo_event_10041","style":1,"background":2096,"log_type":1},{"step":11,"content":"罗睺没有立刻起身，她陷在温暖的床褥中，像花了些时间分辨现实和梦境。","style":3,"background":2096,"log_type":1},{"step":12,"speaker":"罗睺","content":"没什么，只是有点惊讶。","voice":["vo_event_401004101_12"],"voice_bank":"vo_event_10041","style":1,"background":2096,"log_type":1},{"step":13,"speaker":"罗睺","content":"我好像很久没有睡得这么沉了……","voice":["vo_event_401004101_13"],"voice_bank":"vo_event_10041","style":1,"background":2096,"log_type":1},{"step":14,"content":"瑟琳笑了。她拉开窗帘，阳光顷刻洒满卧室。","style":3,"background":2096,"log_type":1},{"step":16,"speaker":"瑟琳","content":"都要睡过头了。时间不等人，走吧，我们还有重要的事要办。","voice":["vo_event_401004101_15"],"voice_bank":"vo_event_10041","style":1,"background":2096,"log_type":1}]}