{"id":1030103,"chapter_id":1030103,"scene_id":1,"steps":[{"step":1,"content":"这就是你的计划？","style":2,"background":10000,"log_type":1,"src_id":130103001,"trial_step":1},{"step":2,"content":"你和白逸趴窝在通风管道里。这里又窄又闷，而且气味相当难闻。","style":3,"background":10000,"log_type":1,"src_id":130103002,"trial_step":2},{"step":3,"speaker":"白逸","content":"放心，我以前都是这么干的，从来没失过手。","voice":["vo_trial_30103_1_3"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103003,"trial_step":3},{"step":4,"content":"白逸的脸凑得很近，上面满是自信的表情。","style":3,"background":10000,"log_type":1,"src_id":130103004,"trial_step":4},{"step":5,"content":"真的吗……","style":2,"background":10000,"log_type":1,"src_id":130103005,"trial_step":5},{"step":6,"speaker":"白逸","content":"等等……哕……咕……","voice":["vo_trial_30103_1_6"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103006,"trial_step":6},{"step":7,"speaker":"白逸","content":"呼，好险。","voice":["vo_trial_30103_1_7"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103007,"trial_step":7},{"step":8,"speaker":"白逸","content":"……你刚说什么来着？","voice":["vo_trial_30103_1_8"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103008,"trial_step":8},{"step":9,"content":"什么都没说。","style":2,"background":10000,"log_type":1,"src_id":130103009,"trial_step":9},{"step":10,"speaker":"白逸","content":"哦，那继续爬吧。这里已经是三楼了，没多远了。","voice":["vo_trial_30103_1_10"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103010,"trial_step":10},{"step":11,"content":"……","style":2,"background":10000,"log_type":1,"src_id":130103011,"trial_step":11},{"step":12,"content":"你和白逸继续在管道里爬行。即便环境恶劣，身下游荡着敌人，这依旧是看上去最好的方法。","style":3,"background":10000,"log_type":1,"src_id":130103012,"trial_step":12},{"step":13,"content":"你之前判断，强攻无法估量损失，更不能保证蔻蔻和澈的安全。有了白逸便利的能力，即便营救失败，带你逃离也不难。","style":3,"background":10000,"log_type":1,"src_id":130103013,"trial_step":13},{"step":14,"content":"但现在，白逸这副模样让你不禁怀疑起自己是不是做出了错误的选择。","style":3,"background":10000,"log_type":1,"src_id":130103014,"trial_step":14},{"step":15,"speaker":"守卫A","content":"你闻没闻到有股臭味？","voice":["vo_trial_30103_1_15"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103015,"trial_step":15},{"step":16,"speaker":"守卫B","content":"……好像真有。*文明*的，真晦气，把排风打开吧。","voice":["vo_trial_30103_1_16"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103016,"trial_step":16},{"step":17,"speaker":"守卫A","content":"行。","voice":["vo_trial_30103_1_17"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103017,"trial_step":17},{"step":18,"speaker":"白逸","content":"放屁，老娘身上哪里有臭味？","voice":["vo_trial_30103_1_18"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103018,"trial_step":18},{"step":19,"content":"白逸异常激愤地凑到你跟前，仿佛要验证一下。","style":3,"background":10000,"log_type":1,"src_id":130103019,"trial_step":19},{"step":20,"options":["推开她"],"style":6,"background":10000,"log_type":1,"src_id":130103020,"trial_step":20,"course":3,"choices":[{"text":"推开她","goto":21}]},{"step":21,"content":"你推开了白逸的脸。与此同时，下面的守卫打开了排风。随着几声怪响，老旧的通风系统开始不住抖动。","style":3,"background":10000,"log_type":1,"src_id":130103021,"trial_step":21},{"step":22,"speaker":"守卫B","content":"我怎么感觉味道更大了？","voice":["vo_trial_30103_1_22"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103022,"trial_step":22},{"step":23,"speaker":"守卫A","content":"谁知道……再等会儿应该就好。","voice":["vo_trial_30103_1_23"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103023,"trial_step":23},{"step":24,"content":"排风被打开后发出了很大的噪音，这反而掩护了你们的行动。忍受着剧烈的颠簸，你们的前进速度变快了许多。","style":3,"background":10000,"log_type":1,"src_id":130103024,"trial_step":24},{"step":25,"content":"你们四肢并用地爬了很长一段距离，白逸的脸色却越来越难看了。","style":3,"background":10000,"log_type":1,"src_id":130103025,"trial_step":25},{"step":26,"speaker":"白逸","content":"……局长……","voice":["vo_trial_30103_1_26"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103026,"trial_step":26},{"step":27,"content":"怎么了？","style":2,"background":10000,"log_type":1,"src_id":130103027,"trial_step":27},{"step":28,"speaker":"白逸","content":"你也不想我吐你身上吧……","voice":["vo_trial_30103_1_28"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103028,"trial_step":28},{"step":29,"content":"你在说什么？！","style":2,"background":10000,"log_type":1,"src_id":130103029,"trial_step":29},{"step":30,"speaker":"白逸","content":"……憋不住了……","voice":["vo_trial_30103_1_30"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103030,"trial_step":30},{"step":31,"content":"还没等你反应过来，白逸踹开了通风口，径直翻身下去。","style":3,"background":10000,"log_type":1,"src_id":130103031,"trial_step":31},{"step":32,"content":"砰！啪！","style":3,"background":10000,"log_type":1,"src_id":130103032,"trial_step":32},{"step":33,"speaker":"白逸","content":"哕——","voice":["vo_trial_30103_1_33"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103033,"trial_step":33},{"step":34,"content":"几秒钟后，你从通风口探出头，发现白逸已经一脸神清气爽地朝你比V字了。","style":3,"background":10000,"log_type":1,"src_id":130103034,"trial_step":34},{"step":35,"speaker":"白逸","content":"我没事了，局长，你也下来吧。","voice":["vo_trial_30103_1_35"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103035,"trial_step":35},{"step":36,"content":"没事？！你脚下面踩着个人呢，而且你都吐他身上了！","style":2,"background":1038,"log_type":1,"src_id":130103036,"trial_step":36},{"step":37,"content":"等等，这不是之前厕所里那个人吗？","style":2,"background":1038,"log_type":1,"src_id":130103037,"trial_step":37},{"step":38,"speaker":"白逸","content":"哈？你认识这个胖子？","voice":["vo_trial_30103_1_38"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103038,"trial_step":38},{"step":39,"content":"不认识，但上次是他报的信。","style":2,"background":1038,"log_type":1,"src_id":130103039,"trial_step":39},{"step":40,"content":"你同样从通风口翻了下去，环顾四周，发现这里是一间办公室，空间宽敞，装潢精美。","style":3,"background":1038,"log_type":1,"src_id":130103040,"trial_step":40},{"step":41,"speaker":"白逸","content":"这胖子的身份不简单啊，一个人享受这么大一个地方。","voice":["vo_trial_30103_1_41"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103041,"trial_step":41},{"step":42,"speaker":"白逸","content":"好在我刚下来就把他打晕了。","voice":["vo_trial_30103_1_42"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103042,"trial_step":42},{"step":43,"content":"嗯，你做得对。他嗓门很大。","style":2,"background":1038,"log_type":1,"src_id":130103043,"trial_step":43},{"step":44,"content":"现在你打算怎么办？","style":2,"background":1038,"log_type":1,"src_id":130103044,"trial_step":44},{"step":45,"speaker":"白逸","content":"难得抓到个看上去管事儿的，说不定他知道澈和蔻蔻在哪儿。","voice":["vo_trial_30103_1_45"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103045,"trial_step":45},{"step":46,"speaker":"白逸","content":"反正我是不想再上去了，太折磨人了。","voice":["vo_trial_30103_1_46"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103046,"trial_step":46},{"step":47,"content":"是你提议走通风管的……","style":2,"background":1038,"log_type":1,"src_id":130103047,"trial_step":47},{"step":48,"speaker":"白逸","content":"哈哈。","voice":["vo_trial_30103_1_48"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103048,"trial_step":48},{"step":49,"speaker":"白逸","content":"欸你看，这胖子真有钱啊，名片夹都是镶金的。","voice":["vo_trial_30103_1_49"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103049,"trial_step":49},{"step":50,"content":"白逸岔开话题，一把拿起办公桌上奢华的名片夹。","style":3,"background":1038,"log_type":1,"src_id":130103050,"trial_step":50},{"step":51,"content":"应该有他们交易对象的信息，打开看看。","style":2,"background":1038,"log_type":1,"src_id":130103051,"trial_step":51},{"step":52,"options":["看看里面的名片"],"style":6,"background":1038,"log_type":1,"src_id":130103052,"trial_step":52,"course":3,"choices":[{"text":"看看里面的名片","goto":54}]},{"step":53,"content":"白逸打开名片夹，抽出里面的一沓名片，然后把这个镶金的名片夹无比顺手地塞进了自己的腰包里。","style":3,"background":1038,"log_type":1,"src_id":130103053,"trial_step":53},{"step":54,"speaker":"白逸","content":"豺哥……不认识，宇佐美达也，看这名字应该是柳生的残党……","voice":["vo_trial_30103_1_54"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103054,"trial_step":54},{"step":55,"speaker":"白逸","content":"白逸……？！","voice":["vo_trial_30103_1_55"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103055,"trial_step":55},{"step":56,"content":"白逸不住翻动，发现后面的名片上都印着自己的名字。","style":3,"background":1038,"log_type":1,"src_id":130103056,"trial_step":56},{"step":57,"speaker":"白逸","content":"原来是你啊——","voice":["vo_trial_30103_1_57"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103057,"trial_step":57},{"step":58,"content":"白逸慢慢转了过去，满是不怀好意的眼神死死盯住了这个昏迷的胖子。","style":3,"background":1038,"log_type":1,"src_id":130103058,"trial_step":58},{"step":59,"speaker":"白逸","content":"就是你小子冒充……还抓了澈和蔻蔻是吧……","voice":["vo_trial_30103_1_59"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103059,"trial_step":59},{"step":60,"content":"啪——","style":1,"background":1038,"log_type":1,"src_id":130103060,"trial_step":60},{"step":61,"speaker":"“白老板”","content":"啊！","voice":["vo_trial_30103_1_61"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103061,"trial_step":61},{"step":62,"content":"白逸一点没惯着这个李鬼，清脆响亮的巴掌糊在他脸上。","style":3,"background":1038,"log_type":1,"src_id":130103062,"trial_step":62},{"step":63,"content":"这下，这位“白老板”终于悠悠转醒。","style":3,"background":1038,"log_type":1,"src_id":130103063,"trial_step":63},{"step":64,"speaker":"白逸","content":"别叫唤！否则拿你身上的肥膘喂狗。","voice":["vo_trial_30103_1_64"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103064,"trial_step":64},{"step":65,"speaker":"“白老板”","content":"呜呜！呜呜呜呜！","voice":["vo_trial_30103_1_65"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103065,"trial_step":65},{"step":66,"content":"白逸麻利地用胶带封住“白老板”的嘴，又顺手将他反捆在了椅子上。","style":3,"background":1038,"log_type":1,"src_id":130103066,"trial_step":66},{"step":67,"content":"做完这一切，白逸露出一副凶神恶煞的表情，抽出短刀架在了“白老板”脖子上。","style":3,"background":1038,"log_type":1,"src_id":130103067,"trial_step":67},{"step":68,"speaker":"白逸","content":"说，你把那两个小鬼绑到哪儿去了？","voice":["vo_trial_30103_1_68"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103068,"trial_step":68},{"step":69,"speaker":"“白老板”","content":"呜呜呜呜……","voice":["vo_trial_30103_1_69"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103069,"trial_step":69},{"step":70,"content":"他嘴还堵着。","style":2,"background":1038,"log_type":1,"src_id":130103070,"trial_step":70},{"step":71,"speaker":"白逸","content":"哦……绑票的生意做顺手了。","voice":["vo_trial_30103_1_71"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103071,"trial_step":71},{"step":72,"speaker":"白逸","content":"咳咳……“白老板”是吧，我接下来要问你几个问题，你可要老老实实回答哦。","voice":["vo_trial_30103_1_72"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103072,"trial_step":72},{"step":73,"speaker":"白逸","content":"我不是白天那两个小鬼。而且我今天头有点疼，情绪也不太好，万一你不配合，我一激动伤到你可就不好了呢。","voice":["vo_trial_30103_1_73"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103073,"trial_step":73},{"step":74,"speaker":"白逸","content":"还有，外面那些人跟着你的时间应该不长吧？","voice":["vo_trial_30103_1_74"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103074,"trial_step":74},{"step":75,"speaker":"白逸","content":"他们知道我们是差佬，你猜他们进来的时候看到我拿你挡箭牌，会不会开枪？","voice":["vo_trial_30103_1_75"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103075,"trial_step":75},{"step":76,"speaker":"“白老板”","content":"呜呜呜！","voice":["vo_trial_30103_1_76"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103076,"trial_step":76},{"step":77,"speaker":"白逸","content":"所以，老实点，别耍花招，知道了吗？","voice":["vo_trial_30103_1_77"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103077,"trial_step":77},{"step":78,"speaker":"“白老板”","content":"呜呜。","voice":["vo_trial_30103_1_78"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103078,"trial_step":78},{"step":79,"content":"白逸揭下了他嘴上的胶带，并把他一把从地上拎了起来。","style":3,"background":1038,"log_type":1,"src_id":130103079,"trial_step":79},{"step":80,"speaker":"“白老板”","content":"怎么又是你……我招你惹你们了……","voice":["vo_trial_30103_1_80"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103080,"trial_step":80},{"step":81,"content":"“白老板”一脸怨妇的表情看向你。","style":3,"background":1038,"log_type":1,"src_id":130103081,"trial_step":81},{"step":82,"speaker":"白逸","content":"别废话。你把白天那几个小鬼绑哪儿去了？","voice":["vo_trial_30103_1_82"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103082,"trial_step":82},{"step":83,"speaker":"“白老板”","content":"会客室。","voice":["vo_trial_30103_1_83"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103083,"trial_step":83},{"step":84,"speaker":"白逸","content":"没说实话。","voice":["vo_trial_30103_1_84"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103084,"trial_step":84},{"step":85,"content":"白逸朝着“白老板”的小腿胫骨就是一脚，当即痛得他浑身肥肉直打颤，却没敢叫出声。","style":3,"background":1038,"log_type":1,"src_id":130103085,"trial_step":85},{"step":86,"speaker":"“白老板”","content":"没有！你，当时你不是跑了吗，我担心差佬后面来算账，就没敢动他们。","voice":["vo_trial_30103_1_86"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103086,"trial_step":86},{"step":87,"speaker":"“白老板”","content":"而且我就一做生意的，哪儿有专门绑人的地方。也就会客室平时没人……","voice":["vo_trial_30103_1_87"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103087,"trial_step":87},{"step":88,"speaker":"白逸","content":"……嗯。","voice":["vo_trial_30103_1_88"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103088,"trial_step":88},{"step":89,"content":"睁开眼睛，映入眼帘的是盛放的玫瑰。望着这遍地的鲜红，你确信现在自己正处于梦境之中。","style":3,"background":1038,"log_type":1,"src_id":130103089,"trial_step":89},{"step":90,"content":"先别急，我再问他几个问题。","style":2,"background":1038,"log_type":1,"src_id":130103090,"trial_step":90},{"step":91,"speaker":"“白老板”","content":"你说你说，我绝对不隐瞒。","voice":["vo_trial_30103_1_91"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103091,"trial_step":91},{"step":92,"content":"你是从哪儿来的。","style":2,"background":1038,"log_type":1,"src_id":130103092,"trial_step":92},{"step":93,"speaker":"“白老板”","content":"新城。","voice":["vo_trial_30103_1_93"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103093,"trial_step":93},{"step":94,"speaker":"白逸","content":"新城人来辛迪加做生意？你脑子坏了？","voice":["vo_trial_30103_1_94"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103094,"trial_step":94},{"step":95,"speaker":"“白老板”","content":"这不是新城的生意破产了吗……正巧有冤大头给我钱，还跟我说有很稀缺的货源。","voice":["vo_trial_30103_1_95"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103095,"trial_step":95},{"step":96,"speaker":"“白老板”","content":"那边债主追得紧，我一咬牙就过来了。","voice":["vo_trial_30103_1_96"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103096,"trial_step":96},{"step":97,"speaker":"白逸","content":"还真有冤大头？他图什么？","voice":["vo_trial_30103_1_97"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103097,"trial_step":97},{"step":98,"speaker":"“白老板”","content":"我哪知道，那人神神秘秘的，脸都没露过。"