],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103146,"trial_step":146},{"step":147,"content":"……把这人处理一下，别被发现。","style":2,"background":120,"log_type":1,"src_id":130103147,"trial_step":147},{"step":148,"content":"这种时候你也没空跟白逸计较。你们将晕倒的守卫扔进垃圾箱，接着回到了会客室门前。","style":3,"background":120,"log_type":1,"src_id":130103148,"trial_step":148},{"step":149,"content":"隔着会客室的门，你就听到了里面的声音。","style":3,"background":120,"log_type":1,"src_id":130103149,"trial_step":149},{"step":150,"speaker":"守卫A","content":"葫芦！我赢了！","voice":["vo_trial_30103_1_151"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103150,"trial_step":150},{"step":151,"speaker":"澈","content":"嗐……我还以为我两对能赢呢。","voice":["vo_trial_30103_1_152"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103151,"trial_step":151},{"step":152,"speaker":"守卫A","content":"你小子还嫩了点儿……不过你打牌水平确实可以，要不是你是差佬，说不定我们还真能玩到一块儿去。","voice":["vo_trial_30103_1_153"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103152,"trial_step":152},{"step":153,"speaker":"澈","content":"哎呀都说了我不是差佬，我也是被胁迫的啊……","voice":["vo_trial_30103_1_154"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103153,"trial_step":153},{"step":154,"speaker":"守卫A","content":"管他呢，总之等这周的工钱结完我就不干了。你要真不是差佬，以后常来。","voice":["vo_trial_30103_1_155"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103154,"trial_step":154},{"step":155,"speaker":"澈","content":"行，下次我一定赢回来。","voice":["vo_trial_30103_1_156"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103155,"trial_step":155},{"step":156,"content":"怎么感觉他们现在挺安全的？","style":2,"background":120,"log_type":1,"src_id":130103156,"trial_step":156},{"step":157,"speaker":"白逸","content":"他一直是这样，到哪儿都混得开……","voice":["vo_trial_30103_1_158"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103157,"trial_step":157},{"step":158,"speaker":"白逸","content":"等等，他们刚刚说什么来着？要散了？","voice":["vo_trial_30103_1_159"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103158,"trial_step":158},{"step":159,"content":"如果他们说的是真的，那现在强攻恐怕就不太合适了。","style":2,"background":120,"log_type":1,"src_id":130103159,"trial_step":159},{"step":160,"content":"先别轻举妄动，我让行动部门的人再等等。","style":2,"background":120,"log_type":1,"src_id":130103160,"trial_step":160},{"step":161,"content":"你掏出终端，打算用讯息软件通知行动部门。然而，在打开终端的那一刹那，你误触到了另一个图标上——","style":3,"background":120,"log_type":1,"src_id":130103161,"trial_step":161},{"step":162,"speaker":"广告词","content":"锈河偷渡，单次10万，人满发车！","voice":["vo_trial_30103_1_163"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103162,"trial_step":162},{"step":163,"content":"广告词配上刺耳的辛迪加特色土味音乐吓了你一大跳。","style":3,"background":120,"log_type":1,"src_id":130103163,"trial_step":163},{"step":164,"content":"毫无疑问，这是昨天白逸骗你下载的流氓app。","style":3,"background":120,"log_type":1,"src_id":130103164,"trial_step":164},{"step":165,"speaker":"守卫A","content":"外面的是谁？！杰森！人呢？","voice":["vo_trial_30103_1_166"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103165,"trial_step":165},{"step":166,"speaker":"白逸","content":"你什么情况！","voice":["vo_trial_30103_1_167"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103166,"trial_step":166},{"step":167,"content":"你还问我什么情况？","style":2,"background":120,"log_type":1,"src_id":130103167,"trial_step":167},{"step":168,"speaker":"白逸","content":"不是，流氓软件你下完了不删的吗？","voice":["vo_trial_30103_1_169"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103168,"trial_step":168},{"step":169,"content":"……","style":2,"background":120,"log_type":1,"src_id":130103169,"trial_step":169},{"step":170,"content":"你不想告诉她你是觉得这个流氓软件有一定的情报价值才没有删了。","style":3,"background":120,"log_type":1,"src_id":130103170,"trial_step":170},{"step":171,"speaker":"白逸","content":"……算了，现在说什么都晚了，直接上吧！","voice":["vo_trial_30103_1_172"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103171,"trial_step":171},{"step":172,"speaker":"白逸","content":"哈！","voice":["vo_trial_30103_1_173"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103172,"trial_step":172},{"step":173,"content":"砰——","style":1,"background":120,"log_type":1,"src_id":130103173,"trial_step":173},{"step":174,"content":"白逸踹开会客室的门，手起刀落砍翻最靠近的两个守卫。","style":3,"background":1045,"log_type":1,"src_id":130103174,"trial_step":174},{"step":175,"content":"会客室里十几个人——包括澈和蔻蔻，一时间都愣住了，看着白逸不知道该说些什么。","style":3,"background":1045,"log_type":1,"src_id":130103175,"trial_step":175},{"step":176,"speaker":"白逸","content":"愣着干嘛？动手！","voice":["vo_trial_30103_1_177"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130103176,"trial_step":176},{"step":177,"content":"不远处的澈率先反应过来，趁着守卫分神，一拳打在刚刚还约打牌的人脸上，然后一把夺过他手里的武器。","style":3,"background":1045,"log_type":1,"src_id":130103177,"trial_step":177},{"step":178,"content":"你则赶紧走到角落里的蔻蔻身旁，替她解开了身上的绳子。","style":3,"background":1045,"log_type":1,"src_id":130103178,"trial_step":178},{"step":179,"speaker":"蔻蔻","content":"谢谢……","voice":["vo_trial_30103_1_180"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130103179,"trial_step":179},{"step":180,"speaker":"白逸","content":"别腻歪了，快跑！","voice":["vo_trial_30103_1_181"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130103180,"trial_step":180},{"step":181,"content":"你们四人没有任何迟疑，拔腿狂奔。一路朝楼下狂奔。","style":3,"background":10000,"log_type":1,"src_id":130103181,"trial_step":181},{"step":182,"content":"没想到这次逃亡出奇地顺利。一路上你们甚至没有遇到什么抵抗，很快就逃出了大门。","style":3,"background":10000,"log_type":1,"src_id":130103182,"trial_step":182},{"step":183,"content":"蔻蔻砸开路边一辆面包车的玻璃，澈翻身进去短路发动。","style":3,"background":10000,"log_type":1,"src_id":130103183,"trial_step":183},{"step":184,"speaker":"白逸","content":"我来开！","voice":["vo_trial_30103_1_185"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103184,"trial_step":184},{"step":185,"content":"白逸坐上驾驶位，引擎发出哀鸣，抽搐了几下便以它不该有的速度冲出了大楼的停车场。","style":3,"background":1031,"log_type":1,"src_id":130103185,"trial_step":185},{"step":186,"speaker":"白逸","content":"哈，也太简单了。你们是怎么被这群人抓住的？丢不丢人呐？","voice":["vo_trial_30103_1_187"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103186,"trial_step":186},{"step":187,"speaker":"蔻蔻","content":"……他们根本没打算拦住我们。","voice":["vo_trial_30103_1_188"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103187,"trial_step":187},{"step":188,"speaker":"澈","content":"他们老板都打算跑路了，犯得着跟我们打生打死吗……","voice":["vo_trial_30103_1_189"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103188,"trial_step":188},{"step":189,"content":"总之都出来了，就不用计较那么多了。","style":2,"background":1031,"log_type":1,"src_id":130103189,"trial_step":189},{"step":190,"speaker":"白逸","content":"确实确实，那今晚要不要一起庆祝庆祝？","voice":["vo_trial_30103_1_191"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103190,"trial_step":190},{"step":191,"speaker":"澈","content":"我看可以。","voice":["vo_trial_30103_1_192"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103191,"trial_step":191},{"step":192,"speaker":"蔻蔻","content":"你们俩闭嘴。","voice":["vo_trial_30103_1_193"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103192,"trial_step":192},{"step":193,"content":"白逸难得地缩了缩脖子。","style":3,"background":1031,"log_type":1,"src_id":130103193,"trial_step":193},{"step":194,"speaker":"白逸","content":"不行就不行吗，这么凶干什么……","voice":["vo_trial_30103_1_195"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103194,"trial_step":194}]}