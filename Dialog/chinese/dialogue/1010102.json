{"id":1010102,"chapter_id":1010102,"scene_id":1,"steps":[{"step":1,"content":"距离审判还有\n15天","style":9,"background":10000,"log_type":1,"src_id":110102001,"trial_step":1},{"step":2,"content":"穿过走廊，你来到关押迪蒙的禁闭室门前。","style":3,"background":107,"log_type":1,"src_id":110102002,"trial_step":2},{"step":3,"content":"几名警卫正守候在这里。","style":3,"background":107,"log_type":1,"src_id":110102003,"trial_step":3},{"step":4,"speaker":"警卫","content":"证物准备就绪，嫌疑人迪蒙·谢尔德已经苏醒，您可以随时开始审问。","voice":["vo_trial_10102_1_1"],"voice_bank":"vo_dimeng_trial","style":1,"background":107,"log_type":1,"src_id":110102004,"trial_step":4},{"step":5,"options":["打开禁闭室的门"],"style":6,"background":107,"log_type":1,"src_id":110102005,"trial_step":5,"course":3,"choices":[{"text":"打开禁闭室的门","goto":6}]},{"step":6,"content":"你向工作人员点头示意，接着面向禁闭室的门，深吸一口气。","style":3,"background":107,"log_type":1,"src_id":110102006,"trial_step":6},{"step":7,"content":"禁闭室的门已打开。然而，迪蒙并不在那里。","style":3,"background":107,"log_type":1,"src_id":110102007,"trial_step":7},{"step":8,"speaker":"警卫","content":"局长，小心！","voice":["vo_trial_10102_1_2"],"voice_bank":"vo_dimeng_trial","style":1,"background":107,"log_type":1,"src_id":110102008,"trial_step":8},{"step":9,"content":"你立刻感觉到不妙，转过头，只看到迪蒙那双阴沉的眼睛。","style":3,"background":107,"log_type":1,"src_id":110102009,"trial_step":9},{"step":10,"content":"你试图做出些反应，但头部传来一阵剧痛，眼前一黑，你失去了意识……","style":3,"background":107,"log_type":1,"src_id":110102010,"trial_step":10},{"step":11,"content":"你在干什么？！","style":3,"background":10000,"log_type":1,"src_id":110102011,"trial_step":11},{"step":12,"content":"放开……局长……","style":3,"background":10000,"log_type":1,"src_id":110102012,"trial_step":12},{"step":13,"content":"放下枪……让他过去……","style":3,"background":10000,"log_type":1,"src_id":110102013,"trial_step":13},{"step":14,"content":"睁开双眼，映入眼帘的是掉漆的天花板。你的四肢被死死捆住，动弹不得。","style":3,"background":1034,"log_type":1,"src_id":110102014,"trial_step":14},{"step":15,"content":"恍惚间，你想起来发生了什么——你似乎原本打算去禁闭室审问迪蒙，却遭到了他的袭击。","style":3,"background":1034,"log_type":1,"src_id":110102015,"trial_step":15},{"step":16,"content":"迪蒙还坐在椅子上假寐。看上去，连日的逃亡和过去积累的伤疾令他疲惫不已。","style":3,"background":1034,"log_type":1,"src_id":110102016,"trial_step":16},{"step":17,"speaker":"迪蒙","content":"……醒了？","voice":["vo_trial_10102_1_3"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102017,"trial_step":17},{"step":18,"content":"似乎是听到了你挣扎的动静，迪蒙睁开了眼睛。他拿着桌上的水杯，站起身走过来，将水杯递到了你的嘴边。","style":3,"background":1034,"log_type":1,"src_id":110102018,"trial_step":18},{"step":19,"speaker":"迪蒙","content":"……","voice":["vo_trial_10102_1_4"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102019,"trial_step":19},{"step":20,"options":["喝下","拒绝"],"style":6,"background":1034,"log_type":1,"src_id":110102020,"trial_step":20,"course":3,"choices":[{"text":"喝下","goto":21},{"text":"拒绝","goto":22}]},{"step":21,"content":"你很想拒绝，但皴裂的嘴唇和干燥的喉咙无比渴望着水分。","style":3,"background":1034,"log_type":1,"src_id":110102021,"trial_step":21,"next":[24]},{"step":22,"speaker":"迪蒙","content":"你脱水了。","voice":["vo_trial_10102_1_5"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102022,"trial_step":22},{"step":23,"content":"皴裂的嘴唇传来阵阵刺痛，你意识到迪蒙说得没错，将水喝了下去。","style":3,"background":1034,"log_type":1,"src_id":110102023,"trial_step":23},{"step":24,"content":"这之后，迪蒙依旧一言不发。他大概没打算向你解释现状。","style":3,"background":1034,"log_type":1,"src_id":110102024,"trial_step":24},{"step":25,"content":"你艰难地扭动着身体，发觉身上微型个人终端还在——这样，管理局就能追踪到你的位置了。","style":3,"background":1034,"log_type":1,"src_id":110102025,"trial_step":25},{"step":26,"speaker":"迪蒙","content":"……","voice":["vo_trial_10102_1_6"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102026,"trial_step":26},{"step":27,"content":"迪蒙听到了你的动静，眯着眼睛看向你。","style":3,"background":1034,"log_type":1,"src_id":110102027,"trial_step":27},{"step":28,"speaker":"迪蒙","content":"别乱动。","voice":["vo_trial_10102_1_7"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102028,"trial_step":28},{"step":29,"content":"迪蒙眼球充血，声音中充满威胁，却又透着说不出的疲惫。","style":3,"background":1034,"log_type":1,"src_id":110102029,"trial_step":29},{"step":30,"content":"他的状态相当糟糕，那副威胁和凶狠的姿态已是强弩之末。","style":3,"background":1034,"log_type":1,"src_id":110102030,"trial_step":30},{"step":31,"options":["质问他为何绑架你"],"style":6,"background":1034,"log_type":1,"src_id":110102031,"trial_step":31,"course":3,"choices":[{"text":"质问他为何绑架你","goto":32}]},{"step":32,"content":"你已经达成你的目的，逃出管理局了，为什么还要留着我？","style":2,"background":1034,"log_type":1,"src_id":110102032,"trial_step":32},{"step":33,"speaker":"迪蒙","content":"……","voice":["vo_trial_10102_1_8"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102033,"trial_step":33},{"step":34,"content":"你要杀我？","style":2,"background":1034,"log_type":1,"src_id":110102034,"trial_step":34},{"step":35,"content":"迪蒙坐在那里，昏黄的灯光在他身前投下漆黑的阴影。","style":3,"background":1034,"log_type":1,"src_id":110102035,"trial_step":35},{"step":36,"content":"沉默良久，干涩而压抑的嗓音再一次响起。","style":3,"background":1034,"log_type":1,"src_id":110102036,"trial_step":36},{"step":37,"speaker":"迪蒙","content":"我可以不杀你……","voice":["vo_trial_10102_1_9"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102037,"trial_step":37},{"step":38,"speaker":"迪蒙","content":"不要妨碍我复仇，我会放你走。","voice":["vo_trial_10102_1_10"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102038,"trial_step":38},{"step":39,"content":"复仇，你又一次从迪蒙的口中听到这两个字。","style":3,"background":1034,"log_type":1,"src_id":110102039,"trial_step":39},{"step":40,"options":["你究竟是在向谁复仇"],"style":6,"background":1034,"log_type":1,"src_id":110102040,"trial_step":40,"course":3,"choices":[{"text":"你究竟是在向谁复仇","goto":41}]},{"step":41,"speaker":"迪蒙","content":"你不需要知道……","voice":["vo_trial_10102_1_11"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102041,"trial_step":41},{"step":42,"content":"叮——","style":3,"background":1034,"log_type":1,"src_id":110102042,"trial_step":42},{"step":43,"content":"突如其来的声响打断了迪蒙。声音来自墙角的水管。大概是什么反侦察陷阱被触发了，迪蒙警觉地站起身来。","style":3,"background":1034,"log_type":1,"src_id":110102043,"trial_step":43},{"step":44,"content":"这也意味着，很可能有人来救你了。","style":3,"background":1034,"log_type":1,"src_id":110102044,"trial_step":44},{"step":45,"content":"你复仇的对象，就是市议会的死者么？那些人做了什么？","style":2,"background":1034,"log_type":1,"src_id":110102045,"trial_step":45},{"step":46,"content":"迪蒙没有理会你，自顾自地起身走到一边，拉开窗帘，看了一眼窗外，接着快步向你走来。","style":3,"background":1034,"log_type":1,"src_id":110102046,"trial_step":46},{"step":47,"content":"是他们陷害了你吗？","style":2,"background":1034,"log_type":1,"src_id":110102047,"trial_step":47},{"step":48,"speaker":"迪蒙","content":"闭嘴。","voice":["vo_trial_10102_1_12"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102048,"trial_step":48},{"step":49,"content":"迪蒙面部肌肉微微抽搐，却没有回答你的问题。或许是因为陷阱触发，他显得颇为不安，似乎正打算离开这里。","style":3,"background":1034,"log_type":1,"src_id":110102049,"trial_step":49},{"step":50,"content":"你该为营救你的人多争取些时间。","style":3,"background":1034,"log_type":1,"src_id":110102050,"trial_step":50},{"step":51,"options":["刺激迪蒙"],"style":6,"background":1034,"log_type":1,"src_id":110102051,"trial_step":51,"course":3,"choices":[{"text":"刺激迪蒙","goto":52}]},{"step":52,"content":"你要一直逃下去吗？","style":2,"background":1034,"log_type":1,"src_id":110102052,"trial_step":52},{"step":53,"speaker":"迪蒙","content":"？","voice":["vo_trial_10102_1_13"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102053,"trial_step":53},{"step":54,"content":"8年了，你的恶名越来越盛，可真相还是无人知晓。人们恐惧你、憎恨你……","style":2,"background":1034,"log_type":1,"src_id":110102054,"trial_step":54},{"step":55,"content":"你现在落得这副境地，东躲西藏、油尽灯枯……你的复仇又进行到哪一步了？","style":2,"background":1034,"log_type":1,"src_id":110102055,"trial_step":55},{"step":56,"speaker":"迪蒙","content":"闭嘴！","voice":["vo_trial_10102_1_14"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102056,"trial_step":56},{"step":57,"content":"迪蒙俯下身，揪住你的衣领。","style":3,"background":1034,"log_type":1,"src_id":110102057,"trial_step":57},{"step":58,"speaker":"迪蒙","content":"你什么都不懂！","voice":["vo_trial_10102_1_15"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102058,"trial_step":58},{"step":59,"content":"那你倒是告诉我，你究竟想要做什么？","style":2,"background":1034,"log_type":1,"src_id":110102059,"trial_step":59},{"step":60,"content":"压抑了8年的愤怒倾泻而出。","style":3,"background":1034,"log_type":1,"src_id":110102060,"trial_step":60},{"step":61,"speaker":"迪蒙","content":"他们必须为亚伯的死付出代价！","voice":["vo_trial_10102_1_16"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102061,"trial_step":61},{"step":62,"content":"你是想说，杀害亚伯的幕后元凶，是市议会？","style":2,"background":1034,"log_type":1,"src_id":110102062,"trial_step":62},{"step":63,"speaker":"迪蒙","content":"还不够明显么？","voice":["vo_trial_10102_1_17"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102063,"trial_step":63},{"step":64,"speaker":"迪蒙","content":"八年前，亚伯想要废除《西区治安条例》，因此参加了竞选……","voice":["vo_trial_10102_1_18"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102064,"trial_step":64},{"step":65,"speaker":"迪蒙","content":"除了那些市议会的蛆虫，还有谁有动机杀他？！","voice":["vo_trial_10102_1_19"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102065,"trial_step":65},{"step":66,"content":"迪蒙的脸有些扭曲，愤怒和杀意折磨着他紧绷多时的神经。","style":3,"background":1034,"log_type":1,"src_id":110102066,"trial_step":66},{"step":67,"speaker":"迪蒙","content":"他们买通了芬恩，我曾经的部下，把携带狂厄武器的暴徒放进了会场。","voice":["vo_trial_10102_1_20"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102067,"trial_step":67},{"step":68,"speaker":"迪蒙","content":"我不得不亲手解决那个死役，即便他曾是亚伯，我的……父亲。","voice":["vo_trial_10102_1_21"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102068,"trial_step":68},{"step":69,"content":"在说到“父亲”两个字的时候，迪蒙的声音明显在颤抖。","style":3,"background":1034,"log_type":1,"src_id":110102069,"trial_step":69},{"step":70,"speaker":"迪蒙","content":"他们把所有事情都推到我的头上……","voice":["vo_trial_10102_1_22"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102070,"trial_step":70},{"step":71,"speaker":"迪蒙","content":"最可笑的是，所有人都乐意相信市议会的说辞。就因为我是……辛迪加人。","voice":["vo_trial_10102_1_23"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102071,"trial_step":71},{"step":72,"speaker":"迪蒙","content":"既然如此，我只能用辛迪加的方式做个了断……","voice":["vo_trial_10102_1_24"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102072,"trial_step":72},{"step":73,"content":"迪蒙凑到你跟前，一字一顿地说道。","style":3,"background":1034,"log_type":1,"src_id":110102073,"trial_step":73},{"step":74,"speaker":"迪蒙","content":"所有跟这件事有关的人，都要付出代价。","voice":["vo_trial_10102_1_26"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102074,"trial_step":74},{"step":75,"content":"迪蒙宣泄着8年来无处诉说的愤懑与不甘。","style":3,"background":1034,"log_type":1,"src_id":110102075,"trial_step":75},{"step":76,"content":"一口气说完这些，他大口喘气，双目血红。神色如此凶狠，却又透露着深深的无助。","style":3,"background":1034,"log_type":1,"src_id":110102076,"trial_step":76},{"step":77,"options":["我可以帮你"],"style":6,"background":1034,"log_type":1,"src_id":110102077,"trial_step":77,"course":3,"choices":[{"text":"我可以帮你","goto":78}]},{"step":78,"speaker":"迪蒙","content":"帮我？","voice":["vo_trial_10102_1_27"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102078,"trial_step":78},{"step":79,"content":"迪蒙报之以一声冷笑。","style":3,"background":1034,"log_type":1,"src_id":110102079,"trial_step":79},{"step":80,"speaker":"迪蒙","content":"怎么帮我？向市议会宣战？","voice":["vo_trial_10102_1_28"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102080,"trial_step":80},{"step":81,"content":"你是管理局的禁闭者，如果你刚刚说的是真的，我就有义务保护你。","style":2,"background":1034,"log_type":1,"src_id":110102081,"trial_step":81},{"step":82,"content":"只有活着才能找出幕后黑手。这样逃下去，你早晚会死……跟我回管理局，还来得及。","style":2,"background":1034,"log_type":1,"src_id":110102082,"trial_step":82},{"step":83,"content":"迪蒙仰起头，深吸了一口气，情绪渐渐平复下来。","style":3,"background":1034,"log_type":1,"src_id":110102083,"trial_step":83},{"step":84,"speaker":"迪蒙","content":"……如果是在八年前，或许我愿意相信你。","voice":["vo_trial_10102_1_29"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102084,"trial_step":84},{"step":85,"speaker":"迪蒙","content":"但现在不会了。","voice":["vo_trial_10102_1_30"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102085,"trial_step":85},{"step":86,"speaker":"迪蒙","content":"我知道你想拖延时间等待救援，我不会再给你机会了。","voice":["vo_trial_10102_1_31"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102086,"trial_step":86},{"step":87,"content":"你奋力挣扎着起身，试图辩解些什么。","style":3,"background":1034,"log_type":1,"src_id":110102087,"trial_step":87},{"step":88,"content":"剧烈动作的影响下，那串原本打算用作质询证物的手链从你上衣口袋中滑出，摔在地上。","style":3,"background":1034,"log_type":1,"src_id":110102088,"trial_step":88},{"step":89,"speaker":"迪蒙","content":"！","voice":["vo_trial_10102_1_32"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102089,"trial_step":89},{"step":90,"content":"迪蒙的瞳孔骤然缩小——他已经是第二次看到这个了，那种明显的动摇依旧无法掩饰。","style":3,"background":1034,"log_type":1,"src_id":110102090,"trial_step":90},{"step":91,"content":"你这才想起，原本打算在审查时问的问题，以及在查询资料时得到的那个问题。","style":3,"background":1034,"log_type":1,"src_id":110102091,"trial_step":91},{"step":92,"speaker":"夜莺","content":"不出意外的话，市议会提供的那条手链，属于这个人。","voice":["vo_trial_10102_1_33"],"voice_bank":"vo_dimeng_trial","style":1,"background":10000,"log_type":1,"src_id":110102092,"trial_step":92},{"step":93,"speaker":"夜莺","content":"亚伯的亲生女儿，迪蒙的义妹——","voice":["vo_trial_10102_1_34"],"voice_bank":"vo_dimeng_trial","style":1,"background":10000,"log_type":1,"src_id":110102093,"trial_step":93},{"step":94,"options":["说出那个名字"],"style":6,"background":1034,"log_type":1,"src_id":110102094,"trial_step":94,"course":3,"choices":[{"text":"说出那个名字","goto":95}]},{"step":95,"content":"薇拉·谢尔德。","style":2,"background":1034,"log_type":1,"src_id":110102095,"trial_step":95},{"step":96,"content":"迪蒙看着地上的手链，没有作答。","style":3,"background":1034,"log_type":1,"src_id":110102096,"trial_step":96},{"step":97,"content":"她对你而言很重要吗？","style":2,"background":1034,"log_type":1,"src_id":110102097,"trial_step":97},{"step":98,"speaker":"迪蒙","content":"她是我的家人……我的妹妹。","voice":["vo_trial_10102_1_35"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102098,"trial_step":98},{"step":99,"content":"迪蒙的表情给出了肯定的答复。","style":3,"background":1034,"log_type":1,"src_id":110102099,"trial_step":99},{"step":100,"content":"他从地面上拾起手链，动作极为轻柔。","style":3,"background":1034,"log_type":1,"src_id":110102100,"trial_step":100},{"step":101,"content":"抬起手，昏暗的光透过窗帘缝照在他身上。白色的手链微微晃动。他的脸上，露出一种你从未见过的温柔神色。","style":3,"background":1034,"log_type":1,"src_id":110102101,"trial_step":101},{"step":102,"content":"她在哪里？","style":2,"background":1034,"log_type":1,"src_id":110102102,"trial_step":102},{"step":103,"speaker":"迪蒙","content":"我……不知道。","voice":["vo_trial_10102_1_36"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102103,"trial_step":103},{"step":104,"speaker":"迪蒙","content":"我在逃亡，她是议员的女儿，我不能去见她。","voice":["vo_trial_10102_1_37"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102104,"trial_step":104},{"step":105,"content":"那市议会给的手链……","style":2,"background":1034,"log_type":1,"src_id":110102105,"trial_step":105},{"step":106,"speaker":"迪蒙","content":"我只想到一种可能，他们绑架了薇拉，并想要以此威胁我。","voice":["vo_trial_10102_1_38"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102106,"trial_step":106},{"step":107,"content":"这就是你不顾自己的伤势，逃离管理局的原因？","style":2,"background":1034,"log_type":1,"src_id":110102107,"trial_step":107},{"step":108,"speaker":"迪蒙","content":"薇拉是我最后的家人……我必须找到她。","voice":["vo_trial_10102_1_39"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102108,"trial_step":108},{"step":109,"content":"迪蒙将手链攥在自己的手心里，转向了你。他的神色前所未有的平静。","style":3,"background":1034,"log_type":1,"src_id":110102109,"trial_step":109},{"step":110,"options":["我会帮你找到她"],"style":6,"background":1034,"log_type":1,"src_id":110102110,"trial_step":110,"course":3,"choices":[{"text":"我会帮你找到她","goto":111}]},{"step":111,"content":"这一次，迪蒙没有立刻拒绝。","style":3,"background":1034,"log_type":1,"src_id":110102111,"trial_step":111},{"step":112,"content":"管理局有充足的人手和完备的情报网。只要你能提供相应的信息，找到薇拉并非难事。","style":2,"background":1034,"log_type":1,"src_id":110102112,"trial_step":112},{"step":113,"content":"我不是你的敌人，迪蒙。跟我回去吧。你不该把所有事情都背负在自己身上。","style":2,"background":1034,"log_type":1,"src_id":110102113,"trial_step":113},{"step":114,"content":"迪蒙没有回应，只是静静注视着你。","style":3,"background":1034,"log_type":1,"src_id":110102114,"trial_step":114},{"step":115,"content":"值得庆幸的是，他眼中已经没有了敌意。","style":3,"background":1034,"log_type":1,"src_id":110102115,"trial_step":115},{"step":116,"content":"良久，迪蒙做出了答复。","style":3,"background":1034,"log_type":1,"src_id":110102116,"trial_step":116},{"step":117,"speaker":"迪蒙","content":"谢谢……","voice":["vo_trial_10102_1_40"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102117,"trial_step":117},{"step":118,"content":"迪蒙走到窗前拉开窗帘。强烈的阳光从外面照进来，一时间你竟有些睁不开眼。","style":3,"background":1034,"log_type":1,"src_id":110102118,"trial_step":118},{"step":119,"speaker":"迪蒙","content":"像你这样的人，我也见过一些，他们……都没能活下来。","voice":["vo_trial_10102_1_41"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102119,"trial_step":119},{"step":120,"speaker":"迪蒙","content":"在狄斯城，好人是活不长的。反而是我这种败类，活到了现在。","voice":["vo_trial_10102_1_42"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102120,"trial_step":120},{"step":121,"content":"迪蒙打开窗户。风涌进屋子，带着泥土和草木香的空气将淡淡的霉腐气味一扫而空。","style":3,"background":1034,"log_type":1,"src_id":110102121,"trial_step":121},{"step":122,"speaker":"迪蒙","content":"这是我一个人的战争。","voice":["vo_trial_10102_1_43"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102122,"trial_step":122},{"step":123,"content":"等等……","style":2,"background":1034,"log_type":1,"src_id":110102123,"trial_step":123},{"step":124,"speaker":"迪蒙","content":"你有一群不错的手下。他们会找到你的。","voice":["vo_trial_10102_1_44"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102124,"trial_step":124},{"step":125,"content":"迪蒙倚在窗台边上，一只手捂着尚未复原的伤口，看向了窗外。","style":3,"background":1034,"log_type":1,"src_id":110102125,"trial_step":125},{"step":126,"content":"他打算就这么一走了之——以他现在的身体状况，被捕只是时间问题。","style":3,"background":1034,"log_type":1,"src_id":110102126,"trial_step":126},{"step":127,"content":"你不能就这么离开，市议会一定安排了重兵搜捕你，一旦落到他们手上……","style":2,"background":1034,"log_type":1,"src_id":110102127,"trial_step":127},{"step":128,"content":"老旧的木门不知何时起已经自己打开，一个戴着帽子的男人站在门前。","style":3,"background":1034,"log_type":1,"src_id":110102127,"trial_step":127},{"step":129,"speaker":"神秘的男人","content":"咳咳……","voice":["vo_trial_10102_1_45"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102128,"trial_step":128},{"step":130,"speaker":"神秘的男人","content":"抱歉，我不想打断你们的交谈。","voice":["vo_trial_10102_1_46"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102128,"trial_step":128},{"step":131,"content":"你不能就这么离开，市议会一定安排了重兵搜捕你，一旦落到他们手上……","style":2,"background":1034,"log_type":1,"src_id":110102127,"trial_step":127},{"step":132,"content":"老旧的木门不知何时起已经自己打开，一个戴着帽子的男人站在门前。","style":3,"background":1034,"log_type":1,"src_id":110102127,"trial_step":127},{"step":133,"speaker":"神秘的男人","content":"咳咳……","voice":["vo_trial_10102_1_45"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102128,"trial_step":128},{"step":134,"speaker":"神秘的男人","content":"抱歉，我不想打断你们的交谈。","voice":["vo_trial_10102_1_46"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102128,"trial_step":128},{"step":135,"speaker":"迪蒙","content":"你是谁？！","voice":["vo_trial_10102_1_47"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102129,"trial_step":129},{"step":136,"content":"迪蒙立刻警觉起来，就连他都没察觉到这个男人的到来。","style":3,"background":1034,"log_type":1,"src_id":110102130,"trial_step":130},{"step":137,"speaker":"神秘的男人","content":"我是谁并不重要，重要的是我听到的东西。看起来15天后，一场很可能不太公平的“审判”在等着你。","voice":["vo_trial_10102_1_48"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102131,"trial_step":131},{"step":138,"speaker":"神秘的男人","content":"我有一个破局的计划……两位，愿意聊聊吗？","voice":["vo_trial_10102_1_49"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102132,"trial_step":132},{"step":139,"content":"男人带着淡淡的笑意。他并没有等待回答，而是摘下帽子快步走了进来。","style":3,"background":10000,"log_type":1,"src_id":110102133,"trial_step":133},{"step":140,"speaker":"神秘的男人","content":"我想你们一定愿意。","voice":["vo_trial_10102_1_50"],"voice_bank":"vo_dimeng_trial","style":1,"background":10000,"log_type":1,"src_id":110102134,"trial_step":134}]}