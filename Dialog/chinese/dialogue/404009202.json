{"id":404009202,"chapter_id":30001,"scene_id":30039,"steps":[{"step":1,"speaker":"玩家","content":"……","style":2,"background":2236,"log_type":1},{"step":2,"speaker":"简","content":"……","voice":["vo_event_404009202_02"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":3,"speaker":"德雷雅","content":"……","voice":["vo_event_404009202_04"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":4,"speaker":"白逸","content":"……","voice":["vo_event_404009202_03"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":5,"content":"似乎混进来一个画风不太对的人，但对此你早已经习以为常了。","style":3,"background":2236,"log_type":1},{"step":6,"content":"在走走停停几次之后，你们终于来到了目的地，但这里显然……","style":3,"background":2236,"log_type":1},{"step":7,"speaker":"选项","options":["……这地方对吗？"],"jump":[8],"style":6,"background":2236,"log_type":1},{"step":8,"speaker":"白逸","content":"对……对吧？天体学家说是这里的。","voice":["vo_event_404009202_06"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":9,"speaker":"简","content":"老板，你会不会看错地图了？","voice":["vo_event_404009202_07"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":10,"speaker":"白逸","content":"不可能，绝对不可能。我白逸绝对不会犯同样的错误。","voice":["vo_event_404009202_08"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":11,"content":"蓝色，只有蓝色。","style":3,"background":2236,"log_type":1},{"step":12,"content":"这片海域的水是你见过最清澈的，甚至比新城某些豪宅的泳池水都要干净。","style":3,"background":2236,"log_type":1},{"step":13,"content":"甚至就连水下的每一块砂石海草，都历历可数。","style":3,"background":2236,"log_type":1},{"step":14,"speaker":"简","content":"……不像是有狂厄的样子。","voice":["vo_event_404009202_12"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":15,"speaker":"德雷雅","content":"不对，这很反常。这水里是不是少了什么东西？","voice":["vo_event_404009202_13"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":16,"content":"烤鱼师傅率先发现了问题所在。","style":3,"background":2236,"log_type":1},{"step":17,"speaker":"简","content":"鱼。","voice":["vo_event_404009202_15"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":18,"content":"一旁的无良老板来了灵感。","style":3,"background":2236,"log_type":1},{"step":19,"speaker":"白逸","content":"诶我突然想起来……东洲有句话叫“水至清则无鱼。”","voice":["vo_event_404009202_17"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":20,"speaker":"白逸","content":"或许这里就不是海呢？所以这里才没有鱼。","voice":["vo_event_404009202_18"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":21,"speaker":"德雷雅","content":"看来答案很明显了。","voice":["vo_event_404009202_19"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":22,"content":"德雷雅抢先一步而出，将手探入水中。只是一瞬间，水面便沸腾起来，水流仿佛有了生命，整个空间都在这一刻苏醒。白逸愣了一下，下意识地往后退了一步。","style":3,"background":2236,"log_type":1},{"step":23,"speaker":"白逸","content":"啊——？不是，我开玩笑的啊。","voice":["vo_event_404009202_20"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":24,"content":"话音未落，你们脚下的水流忽然化作一面巨浪，巨大的阴影将在场的所有人都卷了进去。","style":3,"background":2236,"log_type":1},{"step":25,"content":"转场","style":18,"background":10000,"log_type":1},{"step":26,"content":"白逸的声音仿佛仍在耳畔回响，而此时你早已身处这片大海的深处。","style":3,"background":705,"log_type":1},{"step":27,"content":"视野被极致的黑暗吞噬。起初，你什么也看不见，只有一片令人心悸的虚无。","style":3,"background":705,"log_type":1},{"step":28,"content":"渐渐地，你的眼睛开始适应这片未知的空间。你的双脚触地，海水没有倒灌进你的鼻腔，仿佛和在陆地上的感觉无二。","style":3,"background":705,"log_type":1},{"step":29,"content":"但这“陆地”却是无比沉重的，无处不在的海水不再是温柔的介质。你只能摸着海底岩层缓慢前进，过了好一会儿才来到了一片相对开阔的地带。","style":3,"background":2311,"log_type":1},{"step":30,"speaker":"？？","content":"嘻嘻……","voice":["vo_event_404009202_29"],"voice_bank":"vo_event_40092","style":1,"background":2311,"log_type":1},{"step":31,"content":"一声嗤笑穿透重重海水，刺入你的耳膜中，狂厄的气息也随着她的声音升腾翻涌。","style":3,"background":2311,"log_type":1},{"step":32,"content":"那是一个模糊的、修长而扭曲的人形轮廓，几乎与这片大海融为一体。","style":3,"background":2311,"log_type":1},{"step":33,"speaker":"？？","content":"光是你一个人，可还远远不够呢……","voice":["vo_event_404009202_32"],"voice_bank":"vo_event_40092","style":1,"background":2311,"log_type":1},{"step":34,"content":"你竭力向前望去，借着几缕微弱到几乎熄灭的浮游生物冷光，你终于看得到那片空间的轮廓。","style":3,"background":2237,"log_type":1},{"step":35,"content":"在几块嶙峋礁石围拢的空地上，放着几套老旧的课桌椅，那桌椅显然不是来自大海本身，木料腐朽发黑，缠满了滑腻的海藻和藤壶，金属部件锈迹斑斑。","style":3,"background":2237,"log_type":1},{"step":36,"content":"而垂着头坐在座位上的，便是率先触碰水源的天体学家。","style":3,"background":2237,"log_type":1},{"step":37,"content":"违和感又一次袭向了你。","style":3,"background":2237,"log_type":1},{"step":38,"content":"就算被卷入狂厄的领域，凭借德雷雅自身的实力应该也不会这么简单被捕获，更不会这么鲁莽地行事，她身上究竟发生了什么……？","style":3,"background":2237,"log_type":1},{"step":39,"speaker":"？？","content":"看啊……又有人来了！我总能找到的，总会找到的！","voice":["vo_event_404009202_36"],"voice_bank":"vo_event_40092","style":1,"background":2237,"log_type":1},{"step":40,"content":"它快速靠近德雷雅，仿佛是在宣告自己的胜利一般，空间中的狂厄能量随着它的话语不住地激荡。","style":3,"background":2237,"log_type":1},{"step":41,"speaker":"德雷雅","content":"……你无法……伤害我……","voice":["vo_event_404009202_122"],"voice_bank":"vo_event_40092","style":1,"background":2237,"log_type":1},{"step":42,"speaker":"？？","content":"……哈哈哈哈！你该不会是怕了吧？","voice":["vo_event_404009202_41"],"voice_bank":"vo_event_40092","style":1,"background":2237,"log_type":1},{"step":43,"content":"模糊的影子激动得无以复加，甚至张开了双臂，缓缓地走向了面前的天体学家。","style":3,"background":2237,"log_type":1},{"step":44,"content":"情况紧急，必须使用枷锁，即使是在虚拟的空间中，狂厄化身也一样拥有恐怖的破坏能力。","style":3,"background":2237,"log_type":1},{"step":46,"speaker":"白逸","content":"啊哒！区区狂厄，束手就擒吧！","voice":["vo_event_404009202_45"],"voice_bank":"vo_event_40092","style":1,"background":2237,"log_type":1},{"step":47,"content":"但就在枷锁即将启动的时候，两道身影如同撕裂黑暗的闪电，带着凌厉的水流，精准地切入黑影与德雷雅的身前。","style":3,"background":2237,"log_type":1},{"step":48,"speaker":"简","content":"放开她。","voice":["vo_event_404009202_46"],"voice_bank":"vo_event_40092","style":1,"background":2237,"log_type":1},{"step":49,"content":"长刀带着冷冽的寒光，径直劈向面前的黑影。与此同时，黑影另一侧的震撼弹猛然爆炸。","style":3,"background":2237,"log_type":1},{"step":50,"speaker":"？？","content":"……！","style":1,"background":2237,"log_type":1},{"step":51,"content":"想象中的激烈碰撞发生了，但你却越看越不对劲……","style":3,"background":2237,"log_type":1},{"step":52,"content":"那团被攻击的黑影并没有展现出预想中狂厄化身的狂暴反击或痛苦嘶吼。","style":3,"background":2237,"log_type":1},{"step":53,"content":"反而像是……被打懵了？","style":3,"background":2237,"log_type":1},{"step":54,"speaker":"德雷雅","content":"我说的没错，你无法伤害我。","voice":["vo_event_404009202_53"],"voice_bank":"vo_event_40092","style":1,"background":2237,"log_type":1},{"step":55,"content":"被绑架的受害者走上前去示意白逸和简停手，二人都有些疑惑地看向德雷雅，和被突如其来的一套组合拳打飞的——","style":3,"background":2237,"log_type":1},{"step":56,"speaker":"拉弥亚","content":"咳……咳咳咳……","voice":["vo_event_404009202_57"],"voice_bank":"vo_event_40092","style":1,"background":2237,"log_type":1},{"step":57,"speaker":"白逸&简","content":"诶？","voice":["vo_event_404009202_54"],"voice_bank":"vo_event_40092","style":1,"background":2237,"log_type":1},{"step":58,"content":"转场","style":18,"background":10000,"log_type":1},{"step":59,"speaker":"白逸","content":"哎呀……这可真是大水冲了龙王庙，自家人打了自家人……","voice":["vo_event_404009202_60"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":60,"content":"白逸一脸不好意思地挠着头发，一旁的简则是像小鸡啄米般不住地点着头。","style":3,"background":2235,"log_type":1},{"step":61,"content":"一旁被误伤的拉弥亚手里抱满了白记实业的土特产，从牙膏、牙刷、小零食到名片，应有尽有——这些都是白逸作为赔礼送的。","style":3,"background":2235,"log_type":1},{"step":62,"speaker":"德雷雅","content":"所以，你并不是这个空间的狂厄根源。","voice":["vo_event_404009202_63"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":63,"speaker":"拉弥亚","content":"怎么想都不可能是我吧！","voice":["vo_event_404009202_64"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":64,"speaker":"玩家","content":"那这地方是怎么变成这样的？","style":2,"background":2235,"log_type":1},{"step":65,"content":"漫长的黑夜、诡异的水下空间……本来这些都不应该出现在这个空间中。","style":3,"background":2235,"log_type":1},{"step":66,"speaker":"白逸","content":"总不会真是自然形成的吧？真要是这样我马上就去dismyth炒作了。","voice":["vo_event_404009202_67"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":67,"speaker":"简","content":"这明显是人为的。","voice":["vo_event_404009202_68"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":68,"content":"就在你们百思不得其解时，拉弥亚的声音带着点迟疑响起：","style":3,"background":2235,"log_type":1},{"step":69,"speaker":"拉弥亚","content":"那个……其实……","voice":["vo_event_404009202_70"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":70,"speaker":"拉弥亚","content":"其实我来这里比较早，这个地方一开始不是这样的。大概……几天前？对，就是几天前！","voice":["vo_event_404009202_71"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":71,"content":"此话一出，就连白逸也开始认真听了。","style":3,"background":2235,"log_type":1},{"step":72,"speaker":"拉弥亚","content":"一开始这里是很正常的景区，景色很好，夜晚的时间也正常。","voice":["vo_event_404009202_73"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":73,"speaker":"拉弥亚","content":"但过了几天，就变样了……我原先还以为是管理局做的，但现在看来并不是。","voice":["vo_event_404009202_74"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":74,"speaker":"选项","options":["你好像记得很清楚"],"jump":[75],"style":6,"background":2235,"log_type":1},{"step":75,"speaker":"拉弥亚","content":"那是因为……因为……","voice":["vo_event_404009202_76"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":76,"content":"拉弥亚嗫嚅着，说不下去接下的内容。","style":3,"background":2235,"log_type":1},{"step":77,"speaker":"选项","options":["因为什么……？"],"jump":[78],"style":6,"background":2235,"log_type":1},{"step":78,"content":"在关键的线索前，拉弥亚反而打了退堂鼓。","style":3,"background":2235,"log_type":1},{"step":79,"speaker":"拉弥亚","content":"不行！我不能说！很丢人啊！","voice":["vo_event_404009202_80"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":80,"speaker":"白逸","content":"你放心，我们白记实业的员工都是受过专业训练的，无论多好笑，都不会笑出声。","voice":["vo_event_404009202_81"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":81,"speaker":"简","content":"没错。","voice":["vo_event_404009202_82"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":82,"speaker":"拉弥亚","content":"我……","voice":["vo_event_404009202_83"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":83,"speaker":"拉弥亚","content":"我在管理局的考试不合格，所以被提前送来执行任务啊！","voice":["vo_event_404009202_84"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":84,"speaker":"众人","content":"……","style":1,"background":2235,"log_type":1},{"step":85,"content":"你望向课桌，那是一张打满了叉的试卷。","style":3,"background":2235,"log_type":1},{"step":86,"content":"你突然想起来，管理局上周似乎进行了一次基础的文化通识考试，考试并不难，上面的题有一半都是常识。","style":3,"background":2235,"log_type":1},{"step":87,"content":"或许你之前太过关注于海拉，甚至忘了这位曾经是涛玛斯协会的海洋信使，也是并没有什么生活常识的人。","style":3,"background":2235,"log_type":1},{"step":88,"speaker":"拉弥亚","content":"啊啊……我说出来了……我好想死……明明想躲在这里偷偷复习的，结果却又碰上这种事！","voice":["vo_event_404009202_88"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":89,"speaker":"拉弥亚","content":"当时我在海边捡到了一个像是什么星象仪的东西，想着看起来不错就带到这里了，结果我却被困在这里出都出不去……","voice":["vo_event_404009202_89"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":90,"content":"拉弥亚自暴自弃地趴在课桌上，有一句没一句地说着自己的经历。","style":3,"background":2235,"log_type":1},{"step":91,"speaker":"拉弥亚","content":"我想着要是有个人能替我考试就好了，或者再不济把我教会也行……","voice":["vo_event_404009202_91"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":92,"speaker":"拉弥亚","content":"但谁知道来的人是你们啊啊啊……","voice":["vo_event_404009202_92"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":93,"content":"拉弥亚的眼睛失去高光，现在的她已经没什么能失去的了。","style":3,"background":2235,"log_type":1},{"step":94,"speaker":"德雷雅","content":"星象仪，在哪？","voice":["vo_event_404009202_93"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":95,"content":"就在众人还在捂嘴憋笑看着拉弥亚时，德雷雅却先一步上前，握住了她的手。","style":3,"background":2235,"log_type":1},{"step":96,"speaker":"拉弥亚","content":"什……什么东西？","voice":["vo_event_404009202_96"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":97,"content":"面对德雷雅的突然动作，拉弥亚吓了一跳。但这并不是你认识的德雷雅会做出的动作。","style":3,"background":2235,"log_type":1},{"step":98,"speaker":"德雷雅","content":"星象仪。","voice":["vo_event_404009202_123"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":99,"speaker":"拉弥亚","content":"……就在那。","voice":["vo_event_404009202_124"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":100,"content":"拉弥亚指着复习资料散乱地堆着的课桌，几块发光的苔藓将有些破旧的星象仪照亮。","style":3,"background":2235,"log_type":1},{"step":101,"speaker":"德雷雅","content":"找到了……","voice":["vo_event_404009202_125"],"voice_bank":"vo_event_40092","style":1,"background":2235,"log_type":1},{"step":102,"content":"德雷雅轻轻招手，星象仪便仿佛被赋予了生命般，落入了她的掌心。","style":3,"background":2235,"log_type":1},{"step":103,"speaker":"拉弥亚","content":"……诶？","voice":["vo_event_404009202_99"],"voice_bank":"vo_event_40092","style":1,"background":2236,"log_type":1},{"step":104,"content":"正在拉弥亚惊讶之时，困住她几天的海底的异象也随之被解除，完整的陆地瞬间出现在众人眼前。","style":3,"background":2236,"log_type":1},{"step":105,"content":"转场","style":18,"background":10000,"log_type":1},{"step":106,"content":"在解决完狂厄之后，已经是黄昏时分。","style":3,"background":2236112,"log_type":1},{"step":107,"content":"所有人都在讨论今天晚上吃什么好，该去哪放松一下，就连白逸也换回了之前的衣服——因为狂厄被解决了。","style":3,"background":2236112,"log_type":1},{"step":108,"content":"只有德雷雅一个人，呆呆地看着手中的星象仪出神。","style":3,"background":2236112,"log_type":1},{"step":109,"speaker":"白逸","content":"喂天体学家，那东西真有这么神奇吗？","voice":["vo_event_404009202_101"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":110,"speaker":"德雷雅","content":"当然，它就是狂厄的源头。","voice":["vo_event_404009202_102"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":111,"speaker":"白逸","content":"啊？不是……你说什么？你说的是狄斯语吗？","voice":["vo_event_404009202_103"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":112,"content":"直截了当的答案让在场的所有人都有点懵，狂厄不是刚才就消失了吗？","style":3,"background":2236112,"log_type":1},{"step":113,"speaker":"德雷雅","content":"而且……我想起来了，就连我，也是它的一部分。","voice":["vo_event_404009202_107"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":114,"content":"不等众人消化，她接着继续说出了令所有人都震惊的消息。","style":3,"background":2236112,"log_type":1},{"step":115,"speaker":"选项","options":["什么意思？"],"jump":[116],"style":6,"background":2236112,"log_type":1},{"step":116,"speaker":"德雷雅","content":"别怕……事实很简单。","voice":["vo_event_404009202_110"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":117,"speaker":"德雷雅","content":"这个空间外溢的狂厄，来自德雷雅，而我是……被狂厄填充出来的，“她”某一时段的意识。","voice":["vo_event_404009202_111"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":118,"content":"“德雷雅”说这句话时，凝望着大海和与大海相接的天空，你立刻明白，这是她哪个时段的意识。","style":3,"background":2236112,"log_type":1},{"step":119,"content":"先前的所有违和感在此都得以验证，为什么她仍对群星如此感兴趣，为什么她会做出与你印象中不同的事情。","style":3,"background":2236112,"log_type":1},{"step":120,"content":"因为她只记得曾经的使命，除此以外便一概不知。","style":3,"background":2236112,"log_type":1},{"step":121,"speaker":"德雷雅","content":"请你们……就此忘记我吧。","voice":["vo_event_404009202_126"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":122,"speaker":"简","content":"可是……我们还一起开店了。","voice":["vo_event_404009202_112"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":123,"speaker":"拉弥亚","content":"虽然没帮我考试！但……但还教我做题了！","voice":["vo_event_404009202_114"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":124,"speaker":"白逸","content":"就是！还一起冲浪，一起做了那么多有意思的事情！怎么可能忘得掉啊！","voice":["vo_event_404009202_113"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":125,"speaker":"德雷雅","content":"……我不否认，但我并不是完整的她。","voice":["vo_event_404009202_115"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":126,"content":"海风将她的长发吹乱，但她依旧眺望着远方。","style":3,"background":2236112,"log_type":1},{"step":127,"speaker":"德雷雅","content":"如果狂厄继续膨胀，这无尽的海水将涌出这空间——彻底淹没狄斯。","voice":["vo_event_404009202_118"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":128,"speaker":"选项","options":["……"],"jump":[129],"style":6,"background":2236112,"log_type":1},{"step":129,"speaker":"德雷雅","content":"既然我记起来了，那么，德雷雅就该去完成德雷雅来到这里的真正使命。","voice":["vo_event_404009202_121"],"voice_bank":"vo_event_40092","style":1,"background":2236112,"log_type":1},{"step":130,"content":"她说完便向前走去，你伸出手，想拉住前行的德雷雅，但学者只是摇了摇头。","style":3,"background":2236112,"log_type":1},{"step":131,"content":"红色的光芒霎时吞没了天穹，也吞没了她的身影。","style":3,"background":2066,"log_type":1},{"step":132,"speaker":"玩家","content":"德雷雅！","style":2,"background":2066,"log_type":1}]}