{"id":402020201,"chapter_id":50055,"scene_id":55121,"steps":[{"step":1,"content":"安吉尔看了看表，起身，利落地将刀收好，拿起扔在门口的单肩包，将它包了进去，挎在肩上。","style":3,"background":2195,"log_type":1},{"step":2,"speaker":"${PlayerName}","content":"现在出门？委托还没整理好。","style":2,"background":2195,"log_type":1},{"step":3,"speaker":"安吉尔","content":"对，有点事儿，这几天应该都要出门。","voice":["vo_event_402020101_2"],"voice_bank":"vo_event_20201","style":1,"background":2195,"log_type":1},{"step":4,"options":["你接了其他委托？"],"jump":[5],"style":6,"background":2195,"log_type":1},{"step":5,"content":"安吉尔看了你一眼，她知道你所谓的“其他委托”指的是什么，但她摇了摇头。","style":3,"background":2195,"log_type":1},{"step":6,"speaker":"安吉尔","content":"没有，就是一些私事。","voice":["vo_event_402020101_3"],"voice_bank":"vo_event_20201","style":1,"background":2195,"log_type":1},{"step":7,"speaker":"安吉尔","content":"我只做你接的委托。","voice":["vo_event_402020101_4"],"voice_bank":"vo_event_20201","style":1,"background":2195,"log_type":1},{"step":8,"speaker":"${PlayerName}","content":"这样，好的。","style":2,"background":2195,"log_type":1},{"step":9,"content":"你点了点头——说到这一步，一时到不知道该怎么追问。间隙中她便推门离开了。","style":3,"background":2195,"log_type":1},{"step":10,"speaker":"安吉尔","content":"晚饭我都会回来吃的。","voice":["vo_event_402020101_5"],"voice_bank":"vo_event_20201","style":1,"background":2195,"log_type":1}]}