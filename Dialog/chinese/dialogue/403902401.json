{"id":403902401,"chapter_id":21000106,"scene_id":602,"steps":[{"step":1,"content":"逃！","style":3,"background":2427,"log_type":1},{"step":2,"content":"脚下的金属开始塌陷，雾气从四面聚拢，能见度急剧下降。","style":3,"background":2427,"log_type":1},{"step":3,"speaker":"选项","options":["逃出去！"],"jump":[4],"style":6,"background":2427,"log_type":1},{"step":4,"content":"你分辨着模糊的方向，跑出船舱，朝着记忆中看到那道阴影的方位狂奔。","style":3,"background":2427,"log_type":1},{"step":5,"speaker":"%u","content":"不会看错，<color=#fb9259>西偏南四十度方向</color>，那道阴影……是陆地，是恶意不愿你们前往之地。","style":2,"background":2427,"log_type":1},{"step":7,"content":"你看到前方雾气中，不断有模糊的黑影浮现，但你没有减速。","style":3,"background":2427,"log_type":1},{"step":8,"content":"你闭起眼睛，一头扎进雾中，强迫自己保持奔跑的节奏。","style":3,"background":2427,"log_type":1},{"step":9,"speaker":"%u","content":"陆地……陆地在前面……","style":2,"background":2427,"log_type":1},{"step":10,"content":"吸入鼻腔的空气越来越冷，寒意从脚底一路蔓延至后颈，耳边开始响起低沉的嗡鸣和呢喃声。你感觉到有什么东西缠住了你的手臂、脚踝，尾随着要将你留下。","style":3,"background":2427,"log_type":1},{"step":11,"content":"你看也不看，只回忆着记忆里前方那片模糊的雾海，像攥住最后一根救命的绳索，不允许自己停下。","style":3,"background":2427,"log_type":1},{"step":12,"content":"但精神侵蚀仍在加剧。","style":3,"background":2427,"log_type":1},{"step":13,"content":"雾气在呼吸间钻入身体，低语在耳边一层层叠加，越来越多黑影缠住你的身体，拖住你的步伐。","style":3,"background":2427,"log_type":1},{"step":14,"content":"你的脚步开始踉跄，行动开始迟缓，脑海中陆地的方位逐渐模糊。","style":3,"background":2427,"log_type":1},{"step":15,"content":"就在你几乎要彻底失控的瞬间，一道熟悉而坚定的声音刺破了所有噪声——","style":3,"background":2427,"log_type":1},{"step":16,"speaker":"坚定的呼唤","content":"醒过来！","style":1,"background":2427,"log_type":1},{"step":17,"content":"【闪白回现实】","style":18,"background":10006,"log_type":1},{"step":18,"content":"【源津立绘虚焦】","style":18,"background":2424,"log_type":1},{"step":19,"speaker":"%u","content":"源……津？","style":2,"background":2424,"log_type":1},{"step":20,"speaker":"%u","content":"陆地……西偏南……四十度方向……","style":2,"background":2424,"log_type":1},{"step":21,"content":"你撑着最后一点力气看清眼前的人，朝她的方向踏出一步。随后，膝盖失去支撑，你的身体重重砸向地面。","style":3,"background":2424,"log_type":1}]}