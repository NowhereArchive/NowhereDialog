{"id":401100262,"chapter_id":50027,"scene_id":52713,"steps":[{"step":1,"speaker":"克里斯蒂娜","content":"咳咳……居然还有污染机关……","voice":["vo_event_401102602_1"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":2,"speaker":"克里斯蒂娜","content":"幸好FAC装甲还有些反狂厄装置，得在储备异方晶耗尽前出去。","voice":["vo_event_401102602_2"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":3,"speaker":"克里斯蒂娜","content":"也不知道这车要开去哪儿，刚刚浪费了多少时间。我得尽快——","voice":["vo_event_401102602_3"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":4,"content":"她费力摆弄着失去意识的司令，却很快发现男人身上令人胆寒的装置。","style":3,"background":922,"log_type":1},{"step":5,"speaker":"克里斯蒂娜","content":"这是……污染炸弹？","voice":["vo_event_401102602_5"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":6,"content":"这时，黑暗的另一头传来滋滋的电流声。","style":3,"background":922,"log_type":1},{"step":7,"speaker":"克里斯蒂娜","content":"？！","voice":["vo_event_401102602_7"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":8,"speaker":"克里斯蒂娜","content":"车内……对讲机？","voice":["vo_event_401102602_8"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":9,"content":"对讲机的另一头传来熟悉的声音。","style":3,"background":922,"log_type":1},{"step":10,"speaker":"可可莉克","content":"你好呀，小侦探。","voice":["vo_event_401102602_10"],"voice_bank":"vo_event_11026","style":11,"background":922,"log_type":1}]}