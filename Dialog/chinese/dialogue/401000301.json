{"id":401000301,"chapter_id":50025,"scene_id":52504,"steps":[{"step":2,"speaker":"恍惚的声音","content":"……嘿……","voice":["vo_event_401000301_2"],"voice_bank":"vo_event_10003","style":1,"background":10006002,"log_type":1},{"step":3,"content":"<color=#7683a2><i>……谁……</i></color>","voice":["vo_event_401000301_3"],"voice_bank":"vo_event_10003","style":3,"background":10006002,"log_type":1},{"step":4,"speaker":"恍惚的声音","content":"……罗睺……","voice":["vo_event_401000301_4"],"voice_bank":"vo_event_10003","style":1,"background":10006002,"log_type":1},{"step":5,"speaker":"恍惚的声音","content":"……罗睺，你在哪儿，什么时候了……还睡吗？","voice":["vo_event_401000301_5"],"voice_bank":"vo_event_10003","style":1,"background":10006002,"log_type":1},{"step":6,"content":"<color=#7683a2><i>……烦死了……我没在睡……你谁啊……</i></color>","voice":["vo_event_401000301_6"],"voice_bank":"vo_event_10003","style":3,"background":10006002,"log_type":1},{"step":7,"speaker":"恍惚的声音","content":"*文明FAC*我是你队长！老大！上级！你的指挥官！","voice":["vo_event_401000301_7"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":8,"speaker":"恍惚的声音","content":"说多少次了，进了FAC就得服从上级命令，你听进去个头啊！","voice":["vo_event_401000301_8"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":9,"speaker":"恍惚的声音","content":"你是FAC作战单位，FAC的意义就是架起战壕。但凡任意一块砖松动漏出空隙，身后城市里就有无数人死于灾害。","voice":["vo_event_401000301_9"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":10,"speaker":"恍惚的声音","content":"要绝对服从，不要动摇，不要怀疑，坚定执行每一个指令，明白吗？就像骑士守护主公一样忠诚。","voice":["vo_event_401000301_10"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":11,"speaker":"恍惚的声音","content":"平时混日子我忍了，这一趟任务你可不准摆烂！干得好就有勋章，接着就是加薪休假，你可别给我搅黄了！","voice":["vo_event_401000301_11"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":12,"speaker":"罗睺","content":"……干得烂就入土了。盼着加薪休假的骑士，还爱给自己贴金。","voice":["vo_event_401000301_12"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":13,"speaker":"恍惚的声音","content":"嘿？！还顶嘴？","voice":["vo_event_401000301_13"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":14,"speaker":"恍惚的声音","content":"好了好了，带上你的骚包盾牌，快点！","voice":["vo_event_401000301_14"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":15,"speaker":"罗睺","content":"去哪儿？","voice":["vo_event_401000301_15"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":16,"speaker":"恍惚的声音","content":"内海呀，你睡懵了？这可是嘉年华后最大的行动，保密，上庭亲自指挥。","voice":["vo_event_401000301_16"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":17,"speaker":"罗睺","content":"……内海……大战役……103年？","voice":["vo_event_401000301_17"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":18,"speaker":"罗睺","content":"<size=42><color=#fb9259>103年</color></size>？","voice":["vo_event_401000301_18"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":19,"content":"她的意识突然清醒，眼前人却开始逐渐远离。","style":3,"background":4145001,"log_type":1},{"step":20,"speaker":"罗睺","content":"……不，别去，那个任务是——","voice":["vo_event_401000301_20"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":21,"speaker":"恍惚的声音","content":"呵，你不是从不脚软吗，虚啥？战场上冷静点，别一个人横冲直撞。你只要记住一件事……","voice":["vo_event_401000301_21"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":22,"speaker":"罗睺","content":"不是，听我说，等等！","voice":["vo_event_401000301_22"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":23,"speaker":"恍惚的声音","content":"听我指挥，以长官为重，记好了，FAC的骑士！走！","voice":["vo_event_401000301_23"],"voice_bank":"vo_event_10003","style":1,"background":4145001,"log_type":1},{"step":24,"speaker":"罗睺","content":"<size=42>别去——！！</size>","voice":["vo_event_401000301_24"],"voice_bank":"vo_event_10003","style":1,"background":10006002,"log_type":1},{"step":26,"speaker":"罗睺","content":"……","voice":["vo_event_401000301_26"],"voice_bank":"vo_event_10003","style":1,"background":4143,"log_type":1},{"step":27,"content":"是梦。","style":3,"background":4143,"log_type":1},{"step":29,"content":"她醒了，戴上面罩，激烈跳动的青筋渐渐平复。","style":3,"background":4144,"log_type":1},{"step":30,"content":"附近没有危险，清晨微寒之中，天色渐亮。梦或是错觉，都该醒了。","style":3,"background":4144,"log_type":1},{"step":31,"content":"用了些许时间平复呼吸，等情绪再无波澜时，罗睺提起双盾，步履坚定，走进宁静的暗伏杀机的花苑。","voice":["plot_footstep_3"],"voice_bank":"vo_event_10003","style":3,"background":10000,"log_type":1}]}