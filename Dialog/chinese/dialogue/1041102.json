{"id":1041102,"chapter_id":1041102,"scene_id":1,"steps":[{"step":1,"content":"两周后\n新城外围某处","style":9,"background":1055,"log_type":1,"src_id":141102001,"trial_step":1},{"step":2,"content":"车子驶离市区，七扭八歪开过长满荨麻丛的小路，最终停在一处破败的小楼前。","style":3,"background":1055,"log_type":1,"src_id":141102002,"trial_step":2},{"step":3,"content":"你下车替她开门，她却坐在车里没动。尽管有意遮掩，她看到窗外景色后的片刻惊讶表情没有逃过你的眼睛。","style":3,"background":1055,"log_type":1,"src_id":141102003,"trial_step":3},{"step":4,"speaker":"克莱门汀","content":"这就是你说的“惩罚”？","voice":["vo_trial_41101_2_4"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102004,"trial_step":4},{"step":5,"speaker":"局长","content":"就当这是个惊喜吧。提前剧透不就没意思了。","style":2,"background":1055,"log_type":1,"src_id":141102005,"trial_step":5},{"step":6,"content":"——这里是红杉木孤儿院的旧址。废墟安安静静坐落在小坡上，烧毁过后的建筑已经看不太清样貌，墙体裸露出砖石，漏着风的窗口像是一排空洞的眼眶，巴巴不知在张望什么。","style":3,"background":1055,"log_type":1,"src_id":141102006,"trial_step":6},{"step":7,"speaker":"局长","content":"卡尔家族犯罪事实还在追诉中，这里说不定有搜查队没发现的新线索。","style":2,"background":1055,"log_type":1,"src_id":141102007,"trial_step":7},{"step":8,"speaker":"局长","content":"我想这件事你一定能帮得上忙，也算是将功补过，能接受吗？","style":2,"background":1055,"log_type":1,"src_id":141102008,"trial_step":8},{"step":9,"speaker":"克莱门汀","content":"你们MBCC的惩处措施还真是另类。该交代的我不是早都告诉过你了？","voice":["vo_trial_41101_2_9"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102009,"trial_step":9},{"step":10,"speaker":"局长","content":"那再说一次也无妨。就当给你的新书找找灵感，我听说你最近在收集素材。","style":2,"background":1055,"log_type":1,"src_id":141102010,"trial_step":10},{"step":11,"content":"克莱门汀下车，眼中闪过些许怀念，但很快又回到最初的那副标准笑容。","style":3,"background":1055,"log_type":1,"src_id":141102011,"trial_step":11},{"step":12,"speaker":"克莱门汀","content":"噢，看来你很关注我的动态？是那个叫小文的女孩子和你说的吧，在帮她催稿吗？","voice":["vo_trial_41101_2_12"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102012,"trial_step":12},{"step":13,"speaker":"克莱门汀","content":"成熟的作者有自己的创作节奏，局长不必担心新书的进度。今天我们不是来干正事的么？","voice":["vo_trial_41101_2_13"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102013,"trial_step":13},{"step":14,"content":"你不问，她不说，你试探，她惊讶。克莱门汀似乎总会把一切放在心里，表面却装作若无其事。","style":3,"background":1055,"log_type":1,"src_id":141102014,"trial_step":14},{"step":15,"content":"她露出标准优雅笑容，没再搭理你，自顾自走向那栋饱受摧残的建筑。","style":3,"background":1055,"log_type":1,"src_id":141102015,"trial_step":15},{"step":16,"content":"你快步跟上，在身后打了个手势让随行的安保人员散开，如果有隐香会的痕迹，他们会第一时间提醒你。","style":3,"background":1055,"log_type":1,"src_id":141102016,"trial_step":16},{"step":17,"speaker":"局长","content":"班伯里家族被扳倒以后，竞标这片地皮的人很多。重建计划的投票在新城居民们眼皮子底下进行，这次该不会有什么问题了。","style":2,"background":1055,"log_type":1,"src_id":141102017,"trial_step":17},{"step":18,"speaker":"克莱门汀","content":"要重建的话……这里就会被拆掉了吧。","voice":["vo_trial_41101_2_20"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102018,"trial_step":18},{"step":19,"speaker":"局长","content":"嗯，这是最后一次进来的机会了。","style":2,"background":1055,"log_type":1,"src_id":141102019,"trial_step":19},{"step":20,"content":"克莱门汀闭上眼，经年累月的雨水在焦黑的墙面上冲刷出道道泪痕，她的手指轻轻拂过那些痕迹。","style":3,"background":1055,"log_type":1,"src_id":141102020,"trial_step":20},{"step":21,"content":"许久，她抬起头，鸟雀在你们头顶的树林安然飞过。","style":3,"background":1055,"log_type":1,"src_id":141102021,"trial_step":21},{"step":22,"speaker":"克莱门汀","content":"已经……没有烧焦的味道了。除了那场大火，还会有人记得这里发生过什么吗？","voice":["vo_trial_41101_2_24"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102022,"trial_step":22},{"step":23,"speaker":"局长","content":"如果你想说，我会记住的，说什么都可以。","style":2,"background":1055,"log_type":1,"src_id":141102023,"trial_step":23},{"step":24,"content":"你抓住机会，她只是安静地笑着瞥了你一眼，好像随手抛下钩子就已钓出你的本意。","style":3,"background":1055,"log_type":1,"src_id":141102024,"trial_step":24},{"step":25,"content":"你一本正经找补。","style":3,"background":1055,"log_type":1,"src_id":141102025,"trial_step":25},{"step":26,"speaker":"局长","content":"这也是为了调查取证。作为亲历者的你，一定比我们更清楚关于红杉木孤儿院的一切。","style":2,"background":1055,"log_type":1,"src_id":141102026,"trial_step":26},{"step":27,"content":"你以为她又要避而不谈，或是只抛出谜题看你抓耳挠腮、上下求索。她却愣了愣，而后径直走向荒芜狼藉的前厅。","style":3,"background":1055,"log_type":1,"src_id":141102027,"trial_step":27},{"step":28,"content":"【转场，室内】","style":18,"background":1049,"log_type":1,"src_id":141102028,"trial_step":28},{"step":29,"content":"克莱门汀脚步轻盈，张开双手，她像久居此处的主人，熟络地欢迎到访的客人。","style":3,"background":1049,"log_type":1,"src_id":141102029,"trial_step":29},{"step":30,"speaker":"克莱门汀","content":"这里是阅读室，安妮会在这里玩她的小熊，书架上是好心人捐赠的童话书。角落里放着布袋扎的懒人沙发。","voice":["vo_trial_41101_2_32"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1049,"log_type":1,"src_id":141102030,"trial_step":30},{"step":31,"speaker":"克莱门汀","content":"苦荞芯，像这样的好天气，拿到外面晒一晒，味道很好闻，像是丰收的麦田。","voice":["vo_trial_41101_2_33"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1049,"log_type":1,"src_id":141102031,"trial_step":31},{"step":32,"content":"今天的确晴朗，你几乎能闻到她说的香味。","style":3,"background":1049,"log_type":1,"src_id":141102032,"trial_step":32},{"step":33,"speaker":"克莱门汀","content":"来，摸摸这里。","voice":["vo_trial_41101_2_35"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1049,"log_type":1,"src_id":141102033,"trial_step":33},{"step":34,"content":"克莱门汀牵起你的手，带着你摸向门框上一排高低不一的凹痕。凹痕旁边还标注着什么，早就难以分辨。你向她投去询问的目光。","style":3,"background":1049,"log_type":1,"src_id":141102034,"trial_step":34},{"step":35,"speaker":"克莱门汀","content":"这里是记录身高的地方，大家一向对这种一年一度的集体活动很有热情。","voice":["vo_trial_41101_2_37"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1049,"log_type":1,"src_id":141102035,"trial_step":35},{"step":36,"content":"顺着刻痕摩挲，门框上最高的线，也才不到你的胸口。","style":3,"background":1049,"log_type":1,"src_id":141102036,"trial_step":36},{"step":37,"speaker":"克莱门汀","content":"那时孤儿院的护工一直不够，我是大家的姐姐，也会帮着一起照顾孩子们。","voice":["vo_trial_41101_2_39"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1049,"log_type":1,"src_id":141102037,"trial_step":37},{"step":38,"speaker":"局长","content":"真难想象，那时候的你是什么样的，板起脸管教大家，还是跟孩子们一起疯玩？","style":2,"background":1049,"log_type":1,"src_id":141102038,"trial_step":38},{"step":39,"speaker":"克莱门汀","content":"一半一半。有人觉得我过于安静认真，也有人觉得我鬼点子多，很会差使人。","voice":["vo_trial_41101_2_41"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1049,"log_type":1,"src_id":141102039,"trial_step":39},{"step":40,"content":"她带你转到侧屋。这里应该是厨房，窗下的灶台已经落满了灰。旁边堆着几只垒起来的小碗。","style":3,"background":1049,"log_type":1,"src_id":141102040,"trial_step":40},{"step":41,"content":"克莱门汀蹲下身，挪开碗，在地上敲了敲，很快找到一块空心的砖板，拿起来放在灶台上。","style":3,"background":1050,"log_type":1,"src_id":141102041,"trial_step":41},{"step":42,"speaker":"克莱门汀","content":"踩着这块砖，大一点的孩子都能从窗子翻出去。","voice":["vo_trial_41101_2_44"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1050,"log_type":1,"src_id":141102042,"trial_step":42},{"step":43,"speaker":"克莱门汀","content":"外面是一片小树林，月光好的时候，可以偷偷溜出去。这里算是郊区，可以去钓鱼，捉兔子，到附近的露营地参加篝火晚会。","voice":["vo_trial_41101_2_45"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1050,"log_type":1,"src_id":141102043,"trial_step":43},{"step":44,"content":"你看着窗口透出的小小蓝色，好像看到年幼的她正迎着月光，骑上窗口，而令人向往的童话世界，离他们近在咫尺。","style":3,"background":1050,"log_type":1,"src_id":141102044,"trial_step":44},{"step":45,"speaker":"克莱门汀","content":"这下，你知道我是怎样的孩子了。","voice":["vo_trial_41101_2_47"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1050,"log_type":1,"src_id":141102045,"trial_step":45},{"step":46,"content":"她眯起眼睛，似笑非笑，你忍不住笑起来。","style":3,"background":1050,"log_type":1,"src_id":141102046,"trial_step":46},{"step":47,"speaker":"局长","content":"护工们不会发现你们吗？","style":2,"background":1050,"log_type":1,"src_id":141102047,"trial_step":47},{"step":48,"speaker":"克莱门汀","content":"有好几次跑出去的人太多了，院长婆婆就会站在这里，穿着那件洗得发白的蓝围裙，让我们慢点跑，别把灰落在碗里。","voice":["vo_trial_41101_2_50"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1050,"log_type":1,"src_id":141102048,"trial_step":48},{"step":49,"content":"克莱门汀站在门后，脚尖轻轻蹭着烧焦的灰烬。","style":3,"background":1050,"log_type":1,"src_id":141102049,"trial_step":49},{"step":50,"speaker":"克莱门汀","content":"可只有那次……唯独那次，她让我们跑快一点，再快一点。","voice":["vo_trial_41101_2_52"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1050,"log_type":1,"src_id":141102050,"trial_step":50},{"step":51,"content":"【回忆滤镜，闪回一个火灾背景图】","style":18,"background":1062,"log_type":1,"src_id":141102051,"trial_step":51},{"step":52,"options":["克莱门汀……"],"style":6,"background":1050,"log_type":1,"src_id":141102053,"trial_step":53,"course":3,"choices":[{"text":"克莱门汀……","goto":54}]},{"step":53,"content":"她转过身，深深吸了口气，你安静地等在原地。","style":3,"background":1050,"log_type":1,"src_id":141102054,"trial_step":54},{"step":54,"speaker":"克莱门汀","content":"好啦，这里的信息讲得够多了。去下一个地方吧。","voice":["vo_trial_41101_2_56"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1050,"log_type":1,"src_id":141102055,"trial_step":55},{"step":55,"content":"她招招手，再次领着你走。穿过灰蒙蒙的主楼，你们往中庭去。","style":3,"background":1050,"log_type":1,"src_id":141102056,"trial_step":56},{"step":56,"content":"【转场】","style":18,"background":1055,"log_type":1,"src_id":141102057,"trial_step":57},{"step":57,"content":"阳光耀眼，她忽然在阴影中止步。入目是一片不同此前的盎然生机。","style":3,"background":1055,"log_type":1,"src_id":141102058,"trial_step":58},{"step":58,"content":"庭院中的老树半边狰狞焦枯，另半边却爆发出近乎蛮横的新绿。枝条沉沉垂向地面，几乎要盖住那只被当作秋千的旧轮胎。","style":3,"background":1055,"log_type":1,"src_id":141102059,"trial_step":59},{"step":59,"content":"克莱门汀领着你走向树下，拨开带刺的枝条。泥土松软，她轻易挖出一个铁盒。","style":3,"background":1055,"log_type":1,"src_id":141102060,"trial_step":60},{"step":60,"speaker":"克莱门汀","content":"果然还在这。","voice":["vo_trial_41101_2_62"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102061,"trial_step":61},{"step":61,"options":["这是什么？"],"style":6,"background":1055,"log_type":1,"src_id":141102062,"trial_step":62,"course":3,"choices":[{"text":"这是什么？","goto":63}]},{"step":62,"speaker":"克莱门汀","content":"时光胶囊。我们那时候学书上讲的，把胶囊埋进土里，约好等长大一起回来打开它。","voice":["vo_trial_41101_2_64"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102063,"trial_step":63},{"step":63,"speaker":"局长","content":"打开看看？","style":2,"background":1055,"log_type":1,"src_id":141102064,"trial_step":64},{"step":64,"content":"克莱门汀慢慢打开了尘封多年的盒子。或许是泥土的密闭性不错，铁盒氧化得不算快，里面的东西也还能看出些形状。","style":3,"background":1055,"log_type":1,"src_id":141102065,"trial_step":65},{"step":65,"speaker":"克莱门汀","content":"干花是薇奥拉做的，她想去小镇开家花店，要选后院里最好看的品种，赚了钱，就在红杉木周围种上更好看的花。","voice":["vo_trial_41101_2_67"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102066,"trial_step":66},{"step":66,"speaker":"克莱门汀","content":"旧放大镜是琼斯婆婆的，磨得已经不能再用了，被赛尔放进来了。","voice":["vo_trial_41101_2_68"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102067,"trial_step":67},{"step":67,"speaker":"克莱门汀","content":"那孩子想当会计，每次帮肉铺算账都又快又准，还经常拿回来老板送的排骨。","voice":["vo_trial_41101_2_69"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102068,"trial_step":68},{"step":68,"speaker":"局长","content":"怎么还有牙齿？","style":2,"background":1055,"log_type":1,"src_id":141102069,"trial_step":69},{"step":69,"content":"克莱门汀笑了起来，原本苍白的脸也染上生动的神采。她轻轻拿起那颗小小的牙。","style":3,"background":1055,"log_type":1,"src_id":141102070,"trial_step":70},{"step":70,"speaker":"克莱门汀","content":"娜娜，一激动小脸就会红扑扑。她的愿望是快快长大，所以把自己的乳牙放进来了。如果她还在，现在也应该是大姑娘了。","voice":["vo_trial_41101_2_72"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102071,"trial_step":71},{"step":71,"speaker":"局长","content":"那你呢？克莱门汀放进去了什么？","style":2,"background":1055,"log_type":1,"src_id":141102072,"trial_step":72},{"step":72,"content":"克莱门汀笑笑。她翻出压在最下面的稿纸，纸张已泛黄，上面的文字密密麻麻。","style":3,"background":1055,"log_type":1,"src_id":141102073,"trial_step":73},{"step":73,"speaker":"局长","content":"这是……你写的？","style":2,"background":1055,"log_type":1,"src_id":141102074,"trial_step":74},{"step":74,"speaker":"克莱门汀","content":"没想到吧？我的首部作品，竟然是写给小屁孩打发时间的奇幻故事。为了哄他们，我把红杉木每个人都编进来了，大家都有个独一无二的新身份，去进行独一无二的新冒险……","voice":["vo_trial_41101_2_76"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102075,"trial_step":75},{"step":75,"speaker":"克莱门汀","content":"我原本想着有一天能把长大的他们也写进去……可惜没办法完稿了。","voice":["vo_trial_41101_2_77"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102076,"trial_step":76},{"step":76,"content":"纸页已经被时光磨得发黄变脆，但凡克莱门汀手上的力道再大些，它就会破掉。但克莱门汀只是将纸轻轻放回去，动作和语气同样轻飘。","style":3,"background":1055,"log_type":1,"src_id":141102077,"trial_step":77},{"step":77,"content":"她静静诉说着这些过往。你知道那些人和事早已无法追回，你能做的只有些许安慰。","style":3,"background":1055,"log_type":1,"src_id":141102078,"trial_step":78},{"step":78,"speaker":"局长","content":"在分别的这段时间里，我去看了你写的那些故事。","style":2,"background":1055,"log_type":1,"src_id":141102079,"trial_step":79},{"step":79,"speaker":"局长","content":"安妮、维奥拉、赛尔、娜娜……这些名字在你的书里都出现过。他们变成了你笔下的侦探、警察，成了那些代表美好与光明的事物。","style":2,"background":1055,"log_type":1,"src_id":141102080,"trial_step":80},{"step":80,"speaker":"局长","content":"他们的生命永远流淌在你书写的故事里，克莱门汀。他们跟着你一天天长大，借你的眼睛看这个世界，借你的笔端表达喜怒哀乐……","style":2,"background":1055,"log_type":1,"src_id":141102081,"trial_step":81},{"step":81,"speaker":"局长","content":"这件事的意义已经远超其他。","style":2,"background":1055,"log_type":1,"src_id":141102082,"trial_step":82},{"step":82,"content":"你目光平静却笃定，克莱门汀怔怔地望着你，很快移开视线。","style":3,"background":1055,"log_type":1,"src_id":141102083,"trial_step":83},{"step":83,"speaker":"克莱门汀","content":"哈……我还是第一次听到这样的读后感。","voice":["vo_trial_41101_2_85"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102084,"trial_step":84},{"step":84,"speaker":"克莱门汀","content":"读者只关心罪案够不够刺激，结尾的反转够不够惊人。媒体也只想打听下一本书的噱头，销量会不会创造新高。","voice":["vo_trial_41101_2_86"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102085,"trial_step":85},{"step":85,"speaker":"克莱门汀","content":"只有你，好像一直在关注我的事情。","voice":["vo_trial_41101_2_87"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102086,"trial_step":86},{"step":86,"options":["或许是吧"],"style":6,"background":1055,"log_type":1,"src_id":141102087,"trial_step":87,"course":3,"choices":[{"text":"或许是吧","goto":88}]},{"step":87,"speaker":"局长","content":"但是在MBCC，大家都是这样的。大家更在意你本人，不是畅销书作家，而是<color=#fb9259>禁闭者克莱门汀</color>。","style":2,"background":1055,"log_type":1,"src_id":141102088,"trial_step":88},{"step":88,"speaker":"局长","content":"渡鸦想邀请你去学堂给孩子们讲课，邀请函已经写到第三版了，实在不符合她一贯说干就干的性格。","style":2,"background":1055,"log_type":1,"src_id":141102089,"trial_step":89},{"step":89,"speaker":"局长","content":"玉骨想跟你讨论创作，她知道你喜欢喝两杯，托外勤的同事带了东洲的烈酒。更别提已经围着你转的小文，已经念叨了好久你的新书了。","style":2,"background":1055,"log_type":1,"src_id":141102090,"trial_step":90},{"step":90,"speaker":"克莱门汀","content":"……什么时候的事？","voice":["vo_trial_41101_2_92"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102091,"trial_step":91},{"step":91,"speaker":"局长","content":"你最近总走神，所以才会没注意到。其实大家都在关注你呢。","style":2,"background":1055,"log_type":1,"src_id":141102092,"trial_step":92},{"step":92,"speaker":"局长","content":"抬头看一看吧，克莱门汀。复仇已经结束了，你不再是孤身一人。","style":2,"background":1055,"log_type":1,"src_id":141102093,"trial_step":93},{"step":93,"speaker":"局长","content":"相信我，走到阳光下，继续写下去。会有更多人走进你的故事，孩子们会遇见新的伙伴，读者会从你的故事里获得勇气与安慰——就像从前在红杉木一样。","style":2,"background":1055,"log_type":1,"src_id":141102094,"trial_step":94},{"step":94,"speaker":"局长","content":"所以……","style":2,"background":1055,"log_type":1,"src_id":141102095,"trial_step":95},{"step":95,"content":"请不要再擅自离开。也不要放弃，不要轻易迈入黑夜。","style":3,"background":1055,"log_type":1,"src_id":141102096,"trial_step":96},{"step":96,"content":"你没说完这句话。因为克莱门汀抬起头，她表情似笑非笑，说的话让你一愣。","style":3,"background":1055,"log_type":1,"src_id":141102097,"trial_step":97},{"step":97,"speaker":"克莱门汀","content":"我说呢……我想了很久，你究竟为什么带我来这里？还有哪些证据是你和你的同事们这么长时间都找不到的？","voice":["vo_trial_41101_2_99"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102098,"trial_step":98},{"step":98,"speaker":"克莱门汀","content":"然后，我想到了……","voice":["vo_trial_41101_2_100"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102099,"trial_step":99},{"step":99,"content":"她抬手，指尖从你的侧脸划过。","style":3,"background":1055,"log_type":1,"src_id":141102100,"trial_step":100},{"step":100,"speaker":"克莱门汀","content":"其实你一直在监听那间安全屋，对不对？你也早就知道，隐香会向我发出了那份邀请。","voice":["vo_trial_41101_2_102"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102101,"trial_step":101},{"step":101,"options":["？！"],"style":6,"background":1055,"log_type":1,"src_id":141102102,"trial_step":102,"course":3,"choices":[{"text":"？！","goto":103}]},{"step":102,"speaker":"局长","content":"你什么时候发现的？不对，既然你已经知道这些，为什么不早说——","style":2,"background":1055,"log_type":1,"src_id":141102103,"trial_step":103},{"step":103,"content":"那双手捧起你的脸。你被带着仰头与克莱门汀对视。","style":3,"background":1055,"log_type":1,"src_id":141102104,"trial_step":104},{"step":104,"speaker":"克莱门汀","content":"<color=#7683a2><i>她东游西走，漂泊不歇，只因无缘和你同在。</i></color>","voice":["vo_trial_41101_2_106"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102105,"trial_step":105},{"step":105,"speaker":"克莱门汀","content":"<color=#7683a2><i>只要想起你，就像凝望着月亮出神，不知怎的就出现了奇迹——</i></color>","voice":["vo_trial_41101_2_107"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102106,"trial_step":106},{"step":106,"speaker":"克莱门汀","content":"嘘，我的侦探先生，这些台词都是谁教你的呀？不觉得这种拉拢人的方式，实在老土得可爱吗？","female_content":"嘘，我的侦探小姐，这些台词都是谁教你的呀？不觉得这种拉拢人的方式，实在老土得可爱吗？","voice":["vo_trial_41101_2_108","vo_trial_41101_2_108f"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102107,"trial_step":107},{"step":107,"speaker":"局长","content":"不，不是拉拢……","style":2,"background":1055,"log_type":1,"src_id":141102108,"trial_step":108},{"step":108,"content":"你暗自催动枷锁，如果不是迫不得已，你不想强行对她使用枷锁，这不利于你此行的目的。","style":3,"background":1055,"log_type":1,"src_id":141102109,"trial_step":109},{"step":109,"speaker":"局长","content":"我只希望你在做出选择前能再认真想想。红杉木的复仇已经结束了，你已经可以继续向前了，不要再……","style":2,"background":1055,"log_type":1,"src_id":141102110,"trial_step":110},{"step":110,"content":"你话还没说完。忽然一缕甜腻的异香钻进鼻腔，这股气息让你头皮一阵发麻，你猛偏过头——","style":3,"background":1055,"log_type":1,"src_id":141102111,"trial_step":111},{"step":111,"content":"噔！一枚子弹无声地掠过你脸颊，钉入身后树干。","style":3,"background":1055,"log_type":1,"src_id":141102112,"trial_step":112},{"step":112,"content":"林间的寂静被打破。废墟与断墙的阴影里，不知何时多出了数道漆黑的人影。他们几乎与残垣同色，动作收敛，站位分散，却恰好将你们围住。","style":3,"background":1055,"log_type":1,"src_id":141102113,"trial_step":113},{"step":113,"options":["刺客？什么时候来的——"],"style":6,"background":1055,"log_type":1,"src_id":141102114,"trial_step":114,"course":3,"choices":[{"text":"刺客？什么时候来的——","goto":115}]},{"step":114,"content":"这个距离、这个角度，不可能是临时接近。为什么没有收到任何预警？望风的小队成员呢？","style":3,"background":1055,"log_type":1,"src_id":141102115,"trial_step":115},{"step":115,"content":"你猝然看向克莱门汀，她的表情同样阴沉。","style":3,"background":1055,"log_type":1,"src_id":141102117,"trial_step":117},{"step":116,"speaker":"克莱门汀","content":"……呵，看来，是我未来的同事们来催我“入职”了。","voice":["vo_trial_41101_2_116"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102118,"trial_step":118},{"step":117,"content":"说话间，第二波子弹袭来。这次你们同时向后撤步，暂避在老树后。","style":3,"background":1055,"log_type":1,"src_id":141102119,"trial_step":119},{"step":118,"options":["你已经答应他们了？"],"style":6,"background":1055,"log_type":1,"src_id":141102120,"trial_step":120,"course":3,"choices":[{"text":"你已经答应他们了？","goto":121}]},{"step":119,"speaker":"克莱门汀","content":"还没。但……","voice":["vo_trial_41101_2_119"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102121,"trial_step":121},{"step":120,"speaker":"克莱门汀","content":"如果我真的选择加入他们呢？","voice":["vo_trial_41101_2_120"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102122,"trial_step":122},{"step":121,"content":"你看不清克莱门汀的面容，喘息间，只能听见她压低的声音。","style":3,"background":1055,"log_type":1,"src_id":141102123,"trial_step":123},{"step":122,"speaker":"克莱门汀","content":"真要论，我的手没比他们干净多少。在我最绝望的时候，帮我的不是法律不是正义，而是这样的“恶人”。","voice":["vo_trial_41101_2_122"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102124,"trial_step":124},{"step":123,"speaker":"克莱门汀","content":"你也说过，事在人为。要是能借这把脏刀除掉更多臭虫……似乎，也没什么不好。","voice":["vo_trial_41101_2_123"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102125,"trial_step":125},{"step":124,"content":"克莱门汀的声音越来越低，几乎快被外界的枪声淹没，但你听得很清楚。","style":3,"background":1055,"log_type":1,"src_id":141102126,"trial_step":126},{"step":125,"options":["未来同事？别开玩笑了","你的离职流程我是不会批的"],"style":6,"background":1055,"log_type":1,"src_id":141102127,"trial_step":127,"course":3,"choices":[{"text":"未来同事？别开玩笑了","goto":128},{"text":"你的离职流程我是不会批的","goto":128}]},{"step":126,"content":"跟那几个小禁闭者待久了，偶尔也会有些口不择言。你低声啧了一下，扣动扳机探头反击。","style":3,"background":1055,"log_type":1,"src_id":141102128,"trial_step":128},{"step":127,"speaker":"局长","content":"向下滑落永远是最省力的选项。我见过仇恨吞噬人的样子，它不会让你轻松，只会让你变得更像那些混蛋。","style":2,"background":1055,"log_type":1,"src_id":141102129,"trial_step":129},{"step":128,"speaker":"局长","content":"我绝不会放你跟他们走，我们的约定可还没结束呢——就算你走了我也不会放弃，无论多少次我都会再找到你。","style":2,"background":1055,"log_type":1,"src_id":141102130,"trial_step":130},{"step":129,"content":"回身躲过攻击，你第一次在克莱门汀脸上看到如此明显的诧异。","style":3,"background":1055,"log_type":1,"src_id":141102131,"trial_step":131},{"step":130,"speaker":"克莱门汀","content":"呵……你总是能说出让我惊讶的话。","voice":["vo_trial_41101_2_130"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102132,"trial_step":132},{"step":131,"speaker":"克莱门汀","content":"藏好，不要出来。","voice":["vo_trial_41101_2_132"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102133,"trial_step":133},{"step":132,"content":"克莱门汀将你往后一推，自己站到掩体外侧。","style":3,"background":1055,"log_type":1,"src_id":141102134,"trial_step":134},{"step":133,"content":"攻击终于停下了。林间的黑影缓慢逼近，逡巡片刻，又在一个微妙的距离停步。他们在等克莱门汀表态。","style":3,"background":1055,"log_type":1,"src_id":141102135,"trial_step":135},{"step":134,"speaker":"克莱门汀","content":"我说过会主动联系你们，怎么？反悔了？还是说，就这么不信任我？","voice":["vo_trial_41101_2_134"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102136,"trial_step":136},{"step":135,"speaker":"刺客","content":"……时限快到了。","voice":["vo_trial_41101_2_135"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102137,"trial_step":137},{"step":136,"speaker":"刺客","content":"您只需借出宝贵的头脑……帮我们“清理”敌人，那些您口中恶贯满盈的垃圾。","voice":["vo_trial_41101_2_136"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102138,"trial_step":138},{"step":137,"content":"刺客枪口微微偏移，准确指向你藏身的树干。","style":3,"background":1055,"log_type":1,"src_id":141102139,"trial_step":139},{"step":138,"speaker":"刺客","content":"或者……和知晓我们存在的人，一起埋葬在这里。","voice":["vo_trial_41101_2_138"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102140,"trial_step":140},{"step":139,"content":"空气里的甜腻气息再次浮动，让你下意识屏住呼吸。","style":3,"background":1055,"log_type":1,"src_id":141102141,"trial_step":141},{"step":140,"content":"克莱门汀又向前走了一步。她抬手，像是要握住对方递出的那份“邀请”。","style":3,"background":1055,"log_type":1,"src_id":141102142,"trial_step":142},{"step":141,"content":"下一秒，空气被狂厄扭曲。最前方的刺客身体一僵，随后整个人无声倒地。第二人尚未来得及转向，呼吸已乱，枪口垂落。","style":3,"background":1055,"log_type":1,"src_id":141102143,"trial_step":143},{"step":142,"speaker":"克莱门汀","content":"我不喜欢被人逼迫的感觉。","voice":["vo_trial_41101_2_140"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102144,"trial_step":144},{"step":143,"speaker":"克莱门汀","content":"作为写字的，到底还是习惯把笔握在自己手里。","voice":["vo_trial_41101_2_141"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102145,"trial_step":145},{"step":144,"content":"克莱门汀的选择已经十分明显了。没有多余的废话，三名刺客从同时从阴影里扑出，同时抵达的，还有来自三个方向的利刃。","style":3,"background":1055,"log_type":1,"src_id":141102147,"trial_step":147},{"step":145,"speaker":"局长","content":"小心！","style":2,"background":1055,"log_type":1,"src_id":141102148,"trial_step":148},{"step":146,"content":"情况危急，你顾不得隐蔽，试图阻止其中一把袭向克莱门汀的匕首。","style":3,"background":1055,"log_type":1,"src_id":141102149,"trial_step":149},{"step":147,"content":"但克莱门汀动作更快。她抬手举枪。","style":3,"background":1055,"log_type":1,"src_id":141102151,"trial_step":151},{"step":148,"content":"砰——第一枚子弹击飞逼近你面门的匕首。几乎是同时，第二枚、第三枚子弹依次弹飞剩下的飞刃。","style":3,"background":1055,"log_type":1,"src_id":141102152,"trial_step":152},{"step":149,"speaker":"克莱门汀","content":"局长，你能为我挡刀我很高兴。但这种时候……还是枪比较快吧？","voice":["vo_trial_41101_2_147"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102153,"trial_step":153},{"step":150,"content":"高涨的狂厄从克莱门汀身上迸发。侵蚀从那枚蝴蝶状的饰品上蔓延出来。","style":3,"background":1055,"log_type":1,"src_id":141102154,"trial_step":154},{"step":151,"content":"同时，猩红纹路自她脚下炸开，如血管般瞬间爬满庭院地面！她能接触到的范围内，刺客们都痛苦地跪倒在地。","style":3,"background":1055,"log_type":1,"src_id":141102155,"trial_step":155},{"step":152,"content":"刺客早已做好了克莱门汀拒绝的准备。而克莱门汀也在等这一刻，她需要他们再靠近些，进入她的异能范围。","style":3,"background":1055,"log_type":1,"src_id":141102156,"trial_step":156},{"step":153,"speaker":"克莱门汀","content":"真遗憾，你们起码应该弄清楚我的能力。","voice":["vo_trial_41101_2_151"],"voice_bank":"vo_kelaimenting_trial","style":1,"background":1055,"log_type":1,"src_id":141102157,"trial_step":157},{"step":154,"content":"刺客们被克莱门汀触碰，狂厄霸道地控制着他们朝自己的脖子挥动匕首。他们的肌肉在颤抖，仅存的本能反抗着这股力量。","style":3,"background":1055,"log_type":1,"src_id":141102158,"trial_step":158},{"step":155,"content":"克莱门汀身上的狂厄更盛，脖颈处的蝴蝶饰品仿佛被滋养得更加鲜活，稍一振翅就能起飞。","style":3,"background":1055,"log_type":1,"src_id":141102160,"trial_step":160},{"step":156,"content":"你感到巨大的不受控制的狂厄乱流从克莱门汀单薄的身体里涌出，血色迅速从她脸上流失。","style":3,"background":1055,"log_type":1,"src_id":141102161,"trial_step":161},{"step":157,"content":"<i><b>——克莱门汀的力量是有代价的，而那个代价就是她自己的生命。</b></i>","style":3,"background":1055,"log_type":1,"src_id":141102162,"trial_step":162},{"step":158,"options":["克莱门汀！别被它吞噬！"],"style":6,"background":1055,"log_type":1,"src_id":141102163,"trial_step":163,"course":3,"choices":[{"text":"克莱门汀！别被它吞噬！","goto":164}]},{"step":159,"content":"狂厄中心的女人听到你的声音，侧过脸。她笑容浅淡，动了动唇，似乎在向你说些什么。","style":3,"background":1055,"log_type":1,"src_id":141102164,"trial_step":164},{"step":160,"content":"她在说什么？你听不清。你本打算按照克莱门汀自己的意志为她上枷锁，但现在情况危急，再不决断克莱门汀要么失控，要么死亡。不是犹豫的时候了！","style":3,"background":1055,"log_type":1,"src_id":141102165,"trial_step":165},{"step":161,"content":"你迎着克莱门汀释放的狂厄乱流，艰难靠近她，终于拉住她的手。","style":3,"background":1055,"log_type":1,"src_id":141102166,"trial_step":166},{"step":162,"speaker":"局长","content":"克莱门汀！醒一醒！","style":2,"background":1055,"log_type":1,"src_id":141102167,"trial_step":167},{"step":163,"content":"纯粹的狂厄不分敌我，终于也向你袭来。","style":3,"background":1055,"log_type":1,"src_id":141102168,"trial_step":168},{"step":164,"options":["释放枷锁"],"style":6,"background":1055,"log_type":1,"src_id":141102169,"trial_step":169,"course":3,"choices":[{"text":"释放枷锁","goto":170}]},{"step":165,"content":"鲜红的光刺中，枷锁链接着你们两人的意识。她的意识像是一抔握不住的流沙，急速地向黑暗滑落，快到你即将抓不住。","style":3,"background":10000,"log_type":1,"src_id":141102170,"trial_step":170},{"step":166,"content":"你感到她的生命体征逐渐变弱，你尝试利用枷锁替她分担，但却被一同拽进了无边的黑暗……","style":3,"background":10000,"log_type":1,"src_id":141102171,"trial_step":171}]}