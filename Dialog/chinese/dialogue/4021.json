{"id":4021,"chapter_id":4,"scene_id":402,"steps":[{"step":1,"speaker":"海拉","content":"唔啊——！！","voice":["vo_cgplot_4021001"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":2,"options":["冷静，抓住我"],"jump":[3],"style":6,"background":401,"log_type":1},{"step":3,"speaker":"${PlayerName}","content":"电梯有制动装置，通道里的尖刺也能起到一些缓冲作用。我们还没自由落体呢。","style":2,"background":401,"log_type":1},{"step":4,"speaker":"海拉","content":"呜呜说得好听，那你别把我抓得那么紧啊。搞不懂是谁更慌了。","voice":["vo_cgplot_4021004"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":5,"speaker":"赫卡蒂","content":"下面的敌人暂时没有威胁了，但还要小心来自上方的攻击。","voice":["vo_cgplot_4021005"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":6,"speaker":"海拉","content":"上面的攻击？","voice":["vo_cgplot_4021006"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":7,"content":"话音刚落，几个死役从上空跳落，砸在本就不稳定的升降梯上。","style":3,"background":401,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"这不是死役会有的杀气，有谁在操控它们？","voice":["vo_cgplot_4021008"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":9,"speaker":"海拉","content":"哈……这电梯都快被砸碎了，还有人愿意跳上来跟我们陪葬呢——","voice":["vo_cgplot_4021009"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":10,"speaker":"海拉","content":"抓稳点，${PlayerName}，看着下面的高度。在我们摔成肉饼前，只有你能想办法了。","voice":["vo_cgplot_4021010"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1}]}