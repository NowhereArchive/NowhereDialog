{"id":404009302,"chapter_id":30001,"scene_id":30041,"steps":[{"step":1,"content":"转场","style":18,"background":4313,"log_type":1},{"step":2,"content":"仿佛一个巨大的肥皂泡破裂了，一切都重归原点。","style":3,"background":4313,"log_type":1},{"step":3,"content":"“空间”被格式化，曾经进入过空间内的市民也一并被消除了记忆——正如最初一样。","style":3,"background":4314,"log_type":1},{"step":4,"content":"夏日的余温似乎也随着远去的海风一并消弭。","style":3,"background":4314,"log_type":1},{"step":5,"content":"你重新回到了修缮完毕的“极乐岛”，但这里已经空无一人。","style":3,"background":1015,"log_type":1},{"step":6,"content":"恍惚间，你好像看到了曾经的德雷雅。","style":3,"background":1015,"log_type":1},{"step":7,"content":"转场","style":18,"background":1015,"log_type":1},{"step":8,"speaker":"小德雷雅","content":"朋友先生朋友先生！","female_content":"朋友小姐朋友小姐！","voice":["vo_event_404009302_16","vo_event_404009302_16f"],"voice_bank":"vo_event_40093","style":1,"background":1015,"log_type":1},{"step":9,"content":"小姑娘不停摇着你的手臂。","style":3,"background":1015,"log_type":1},{"step":10,"speaker":"小德雷雅","content":"你说啊，要是我以后把什么都忘了怎么办呀！","voice":["vo_event_404009302_18"],"voice_bank":"vo_event_40093","style":1,"background":1015,"log_type":1},{"step":11,"speaker":"小德雷雅","content":"啊不行！什么都忘了也不好……那就还记得星星和朋友先生吧！","female_content":"啊不行！什么都忘了也不好……那就还记得星星和朋友小姐吧！","voice":["vo_event_404009302_21","vo_event_404009302_21f"],"voice_bank":"vo_event_40093","style":1,"background":1015,"log_type":1},{"step":12,"speaker":"玩家","content":"到那时候，我会帮助你，让你都想起来的。","style":2,"background":1015,"log_type":1},{"step":13,"speaker":"小德雷雅","content":"真的吗？说不定我一直都想不起来呢？","voice":["vo_event_404009302_22"],"voice_bank":"vo_event_40093","style":1,"background":1015,"log_type":1},{"step":14,"speaker":"玩家","content":"那我就一直帮你，谁让我们是朋友呢。","style":2,"background":1015,"log_type":1},{"step":15,"speaker":"小德雷雅","content":"嘿！朋友先生最好了！","female_content":"嘿！朋友小姐最好了！","voice":["vo_event_404009302_23","vo_event_404009302_23f"],"voice_bank":"vo_event_40093","style":1,"background":1015,"log_type":1},{"step":16,"content":"一股像是什么东西烧糊了的味道涌进了你的鼻腔，将你拉回了现实。","style":3,"background":1015,"log_type":1},{"step":17,"content":"循着烟雾的轨迹，你一路前行着，直到——","style":3,"background":1015,"log_type":1},{"step":18,"content":"夜晚的海滩上，几个熟悉的身影正在忙上忙下。","style":3,"background":1015,"log_type":1},{"step":19,"content":"简在打着下手，白逸在一旁挂着招牌，拉弥亚则在一旁的石头上看书。","style":3,"background":1015,"log_type":1},{"step":20,"content":"惹麻烦的禁闭者们又重新出现在这片沙滩上，可唯独少了一个人。","style":3,"background":1015,"log_type":1},{"step":21,"content":"你四处寻觅着她的身影，可仍是一无所获。","style":3,"background":1015,"log_type":1},{"step":22,"content":"就在你坐在礁石上，漫无目的地眺望着海滩时——","style":3,"background":1015,"log_type":1},{"step":23,"content":"一根竹签插着半条烤糊的鳗鱼就这么出现在了你的面前。","style":3,"background":1015,"log_type":1},{"step":24,"speaker":"德雷雅","content":"烤鳗鱼……要试试吗？","voice":["vo_event_404009302_11"],"voice_bank":"vo_event_40093","style":1,"background":1015,"log_type":1}]}