{"id":402401302,"chapter_id":21000104,"scene_id":402,"steps":[{"step":1,"speaker":"赫斯提亚","content":"别走太快，离我近点。","voice":["vo_event_402401302_1"],"voice_bank":"vo_event_24013","style":1,"background":2226,"log_type":1},{"step":2,"content":"她跟在你身后半步，紧紧拽住你的胳膊，手有些凉，有些抖。","style":3,"background":2226,"log_type":1},{"step":3,"speaker":"选项","options":["你很怕吗？"],"jump":[4],"style":6,"background":2226,"log_type":1},{"step":4,"content":"她眉头一皱，用火炬戳你一下。","style":3,"background":2226,"log_type":1},{"step":5,"speaker":"赫斯提亚","content":"放尊重点，别得寸进尺了。","voice":["vo_event_402401302_5"],"voice_bank":"vo_event_24013","style":1,"background":2226,"log_type":1},{"step":6,"speaker":"赫斯提亚","content":"我比你更了解这片黑暗，像你这种无知无畏的家伙迟早会出事。","voice":["vo_event_402401302_6"],"voice_bank":"vo_event_24013","style":1,"background":2226,"log_type":1},{"step":7,"speaker":"赫斯提亚","content":"别等怪物从黑暗里钻出来把你拖走了，再哇哇乱哭求我救你……","voice":["vo_event_402401302_7"],"voice_bank":"vo_event_24013","style":1,"background":2226,"log_type":1},{"step":8,"speaker":"选项","options":["它长什么样？"],"jump":[9],"style":6,"background":2226,"log_type":1},{"step":9,"content":"赫斯提亚深吸一口气，描述起了那只存在于她口中的东西。","style":3,"background":2226,"log_type":1},{"step":10,"speaker":"赫斯提亚","content":"它……是神明恶意的具象，是实体化的恐惧，没有固定的形体。","voice":["vo_event_402401302_10"],"voice_bank":"vo_event_24013","style":1,"background":2226,"log_type":1},{"step":11,"speaker":"赫斯提亚","content":"不过非要描述的话，嗯……它浑身漆黑，满是粘稠的液体，就像只被剥了皮的野兽。","voice":["vo_event_402401302_11"],"voice_bank":"vo_event_24013","style":1,"background":2226,"log_type":1},{"step":12,"speaker":"赫斯提亚","content":"痛苦和恐惧令它疯狂。它不会死，或者说本就已经死了。所以它的叫声……就像有人在哭一样……","voice":["vo_event_402401302_12"],"voice_bank":"vo_event_24013","style":1,"background":2226,"log_type":1},{"step":13,"content":"伴随着瘆人而细致的描述，女孩的气息愈发急促起来。","style":3,"background":2226,"log_type":1},{"step":14,"content":"突然之间，空气中多出了一种细微的声响，像是呜咽，又像是痛苦的低吼，令人寒毛倒竖。","style":3,"background":2226,"log_type":1},{"step":15,"speaker":"？？？","content":"<color=#dg1f1f><i>呜呜呜呜呜……嗷嗷……</color></i>","voice":["vo_event_402401302_15"],"voice_bank":"vo_event_24013","style":1,"background":2226,"log_type":1},{"step":16,"speaker":"赫斯提亚","content":"它……它的眼睛是红的……血红色……只要看到一次就绝对不会忘记……","voice":["vo_event_402401302_16"],"voice_bank":"vo_event_24013","style":1,"background":2226,"log_type":1},{"step":17,"content":"声音越来越近，很快就变得震耳欲聋。与此同时，一个血红色的光点自黑暗中飞速接近。","style":3,"background":2226,"log_type":1},{"step":18,"content":"女孩脸上的恐惧达到了极限，连带整个身体都止不住地战栗起来。","style":3,"background":2226,"log_type":1},{"step":19,"speaker":"赫斯提亚","content":"它……它……","voice":["vo_event_402401302_19"],"voice_bank":"vo_event_24013","style":1,"background":2226,"log_type":1},{"step":20,"content":"怪物在你眼前显露了真身——正如赫斯提亚所说的那样，血红色眼睛，漆黑的身体不断地扭曲变形，石油般的粘稠液体自其身上滴落，在地面留下污秽的痕迹。","style":3,"background":2226,"log_type":1},{"step":21,"content":"女孩显然也感受到了那可怖的动静。","style":3,"background":2226,"log_type":1},{"step":22,"speaker":"赫斯提亚","content":"它……来了……快跑！！！","voice":["vo_event_402401302_22"],"voice_bank":"vo_event_24013","style":1,"background":2226,"log_type":1}]}