{"id":6082,"chapter_id":6,"scene_id":608,"steps":[{"step":1,"content":"你们赢了，但污染并没有减慢速度，四面八方传来更多死役的咆哮。","style":3,"background":511,"log_type":1},{"step":2,"content":"它们像被某个声音驱使，要将你逐出这里，或者撕成碎片。这种邪恶的意志开始压迫你的神经。","style":3,"background":511,"log_type":1},{"step":3,"options":["稳住枷锁"],"jump":[4],"style":6,"background":511,"log_type":1},{"step":4,"content":"又开始了……你们两个，离开这里，不要回头。","style":2,"background":511,"log_type":1},{"step":5,"speaker":"赫卡蒂","content":"……不要。","voice":["vo_cgplot_6082005"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":6,"content":"你们不能再出事了！","style":2,"background":511,"log_type":1},{"step":7,"speaker":"海拉","content":"唔——闭嘴啦！你又不肯走，我们怎么可能丢下你逃跑！","voice":["vo_cgplot_6082007"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"我的任务，就是陪你到塔顶，决战。","voice":["vo_cgplot_6082008"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":9,"speaker":"海拉","content":"可塔顶的大哥已经没了，只靠我们能行吗？","voice":["vo_cgplot_6082009"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":10,"options":["这里不只有我们"],"jump":[11],"style":6,"background":511,"log_type":1},{"step":11,"content":"你紧紧握住枷锁。","style":3,"background":511,"log_type":1},{"step":12,"options":["卓娅，回应我！"],"jump":[13],"style":6,"background":511,"log_type":1}]}