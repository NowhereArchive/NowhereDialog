{"id":1120503,"chapter_id":1120503,"scene_id":1,"steps":[{"step":1,"content":"砰！","style":3,"background":305,"log_type":1,"src_id":220503001,"trial_step":1},{"step":2,"content":"海拉挥舞着钢制水管将一个敌人打翻在地。","style":3,"background":305,"log_type":1,"src_id":220503002,"trial_step":2},{"step":3,"speaker":"海拉","content":"都哭丧着脸干嘛，好歹又解决掉一个，不该高兴吗？","style":1,"background":305,"log_type":1,"src_id":220503003,"trial_step":3},{"step":4,"content":"战斗开始后第九分钟，队伍中三分之一的人都已负伤。","style":3,"background":305,"log_type":1,"src_id":220503004,"trial_step":4},{"step":5,"content":"若不是依凭拖车场复杂的地形，绝对的人数差距足以让你们在这短短几分钟内全军覆没。","style":3,"background":305,"log_type":1,"src_id":220503005,"trial_step":5},{"step":6,"content":"即便如此，保护着赫罗和另外两名重伤员，战局还是愈发不利。","style":3,"background":305,"log_type":1,"src_id":220503006,"trial_step":6},{"step":7,"content":"眼下，几乎不可能把所有人全须全尾地送出去。","style":3,"background":305,"log_type":1,"src_id":220503007,"trial_step":7},{"step":8,"options":["自己留下拖住敌人"],"style":6,"background":305,"log_type":1,"src_id":220503008,"trial_step":8,"course":3,"choices":[{"text":"自己留下拖住敌人","goto":9}]},{"step":9,"content":"赫卡蒂。","style":2,"background":305,"log_type":1,"src_id":220503009,"trial_step":9},{"step":10,"speaker":"赫卡蒂","content":"在。","style":1,"background":305,"log_type":1,"src_id":220503010,"trial_step":10},{"step":11,"content":"你和B组护送赫罗和伤员朝西走。尽可能避开眼线，把他们送回军团的据点。","style":2,"background":305,"log_type":1,"src_id":220503011,"trial_step":11},{"step":12,"speaker":"海拉","content":"那我呢？","style":1,"background":305,"log_type":1,"src_id":220503012,"trial_step":12},{"step":13,"content":"我们留下，向东面佯攻。","style":2,"background":305,"log_type":1,"src_id":220503013,"trial_step":13},{"step":14,"content":"尽可能闹出点大动静来，掩护他们撤离。","style":2,"background":305,"log_type":1,"src_id":220503014,"trial_step":14},{"step":15,"speaker":"海拉","content":"哈哈哈，我就知道，还是咱俩最莽。","style":1,"background":305,"log_type":1,"src_id":220503015,"trial_step":15},{"step":16,"speaker":"赫罗","content":"不行！","style":1,"background":305,"log_type":1,"src_id":220503016,"trial_step":16},{"step":17,"content":"赫罗的声音不大，却异常坚定。","style":3,"background":305,"log_type":1,"src_id":220503017,"trial_step":17},{"step":18,"speaker":"海拉","content":"怎么，就你现在这副德行还想留下来？别了吧，我可不想打架的时候还得带着拖油瓶。","style":1,"background":305,"log_type":1,"src_id":220503018,"trial_step":18},{"step":19,"speaker":"海拉","content":"乖乖服从局长的命令吧小矮子。","style":1,"background":305,"log_type":1,"src_id":220503019,"trial_step":19},{"step":20,"content":"海拉一脸得意地凑到赫罗跟前。虽然嘴里说着“小矮子”，但这两人身高其实差不多。","style":3,"background":305,"log_type":1,"src_id":220503020,"trial_step":20},{"step":21,"speaker":"赫罗","content":"军团没有不战而逃的懦夫。","style":1,"background":305,"log_type":1,"src_id":220503021,"trial_step":21},{"step":22,"content":"赫罗没有和海拉置气，平静的话语得到了身边军团成员的赞同。","style":3,"background":305,"log_type":1,"src_id":220503022,"trial_step":22},{"step":23,"speaker":"赫罗","content":"而且，我不能再眼睁睁看着别人替我牺牲了。","style":1,"background":305,"log_type":1,"src_id":220503023,"trial_step":23},{"step":24,"content":"自觉气势短了一截的海拉向后退了一步，嘟囔起来。","style":3,"background":305,"log_type":1,"src_id":220503024,"trial_step":24},{"step":25,"speaker":"海拉","content":"装什么啊……","style":1,"background":305,"log_type":1,"src_id":220503025,"trial_step":25},{"step":26,"speaker":"海拉","content":"我一个人就能保护好这家伙了。而且，你武器都没带来，拿什么打架啊？","style":1,"background":305,"log_type":1,"src_id":220503026,"trial_step":26},{"step":27,"speaker":"赫罗","content":"我的禁闭者能力并不依赖武器。","style":1,"background":305,"log_type":1,"src_id":220503027,"trial_step":27},{"step":28,"content":"赫罗身上的战纹逐渐透过绷带亮起光芒。","style":3,"background":305,"log_type":1,"src_id":220503028,"trial_step":28},{"step":29,"speaker":"赫罗","content":"况且别忘了，这里是拖车场，我是车队的女儿。","style":1,"background":305,"log_type":1,"src_id":220503029,"trial_step":29},{"step":30,"speaker":"赫罗","content":"这么多零件，足够我用的了。","style":1,"background":305,"log_type":1,"src_id":220503030,"trial_step":30},{"step":31,"content":"说完这番话，赫罗和海拉都看向了你。","style":3,"background":305,"log_type":1,"src_id":220503031,"trial_step":31},{"step":32,"content":"时间紧迫，必须尽快做出决断。","style":3,"background":305,"log_type":1,"src_id":220503032,"trial_step":32},{"step":33,"content":"我明白了……","style":2,"background":305,"log_type":1,"src_id":220503033,"trial_step":33},{"step":34,"content":"那我们就一起突围吧。","style":2,"background":305,"log_type":1,"src_id":220503034,"trial_step":34},{"step":35,"speaker":"海拉","content":"切。","style":1,"background":305,"log_type":1,"src_id":220503035,"trial_step":35},{"step":36,"content":"海拉发出不满的声音，却没有再反对，而是把水管扛到了肩上。","style":3,"background":305,"log_type":1,"src_id":220503036,"trial_step":36},{"step":37,"content":"这是个过于理想化的方案，你们成功突围的可能性并不高。","style":3,"background":305,"log_type":1,"src_id":220503037,"trial_step":37},{"step":38,"content":"可你发现，此刻每个人都握紧了手中的武器。","style":3,"background":305,"log_type":1,"src_id":220503038,"trial_step":38},{"step":39,"content":"笼罩在他们脸上的阴霾不见了。","style":3,"background":305,"log_type":1,"src_id":220503039,"trial_step":39},{"step":40,"content":"子弹呼啸而过，射穿了海拉的小臂。","style":3,"background":305,"log_type":1,"src_id":220503040,"trial_step":40},{"step":41,"speaker":"海拉","content":"赫卡蒂！","style":1,"background":305,"log_type":1,"src_id":220503041,"trial_step":41},{"step":42,"content":"梦魇撕碎了眼前的敌人，替海拉创造出一个身位的空间。","style":3,"background":305,"log_type":1,"src_id":220503042,"trial_step":42},{"step":43,"content":"海拉猛地向前一跃，抡圆了手中的钢管。","style":3,"background":305,"log_type":1,"src_id":220503043,"trial_step":43},{"step":44,"speaker":"海拉","content":"打够了吗？轮到我了！","style":1,"background":305,"log_type":1,"src_id":220503044,"trial_step":44},{"step":45,"content":"砰！","style":3,"background":305,"log_type":1,"src_id":220503045,"trial_step":45},{"step":46,"content":"眼前的敌人悉数倒下。战斗暂时停止了。","style":3,"background":305,"log_type":1,"src_id":220503046,"trial_step":46},{"step":47,"speaker":"治安局首领","content":"一群废物！有狂厄武器还**打不赢。","style":1,"background":305,"log_type":1,"src_id":220503047,"trial_step":47},{"step":48,"speaker":"治安局喽啰","content":"老……老大，现在怎么办？","style":1,"background":305,"log_type":1,"src_id":220503048,"trial_step":48},{"step":49,"speaker":"治安局首领","content":"不能等了，再耗下去，他们的援军就要到了。","style":1,"background":305,"log_type":1,"src_id":220503049,"trial_step":49},{"step":50,"speaker":"治安局首领","content":"放火，逼他们出来。","style":1,"background":305,"log_type":1,"src_id":220503050,"trial_step":50},{"step":51,"speaker":"治安局喽啰","content":"可……可是老大……","style":1,"background":305,"log_type":1,"src_id":220503051,"trial_step":51},{"step":52,"speaker":"治安局首领","content":"别**废话了，快去！","style":1,"background":305,"log_type":1,"src_id":220503052,"trial_step":52},{"step":53,"speaker":"治安局首领","content":"放火这点小事最多被撤职，把他们放跑了我们***全都得玩儿完，知道吗？！","style":1,"background":305,"log_type":1,"src_id":220503053,"trial_step":53},{"step":54,"speaker":"治安局喽啰","content":"知……知道了。","style":1,"background":305,"log_type":1,"src_id":220503054,"trial_step":54},{"step":55,"content":"一个个玻璃燃烧瓶被抛入拖车场。在垃圾的助燃下，火势越来越大。","style":3,"background":305,"log_type":1,"src_id":220503055,"trial_step":55},{"step":56,"content":"为首的人夺过身边人的狂厄武器，对准了出逃的必经之路。","style":3,"background":305,"log_type":1,"src_id":220503056,"trial_step":56},{"step":57,"speaker":"治安局首领","content":"风向是对的，老天爷都站在我这边。我可不会栽在你们这些人手上。","style":1,"background":305,"log_type":1,"src_id":220503057,"trial_step":57},{"step":58,"content":"杂乱的脚步声越来越近，领头人的脸色越来越兴奋，牙齿咬得嘎嘎作响。","style":3,"background":305,"log_type":1,"src_id":220503058,"trial_step":58},{"step":59,"speaker":"治安局首领","content":"给我去*吧！","style":1,"background":305,"log_type":1,"src_id":220503059,"trial_step":59},{"step":60,"speaker":"赫罗","content":"该*的是你。","style":1,"background":305,"log_type":1,"src_id":220503060,"trial_step":60},{"step":61,"content":"头顶传来的声音让他出现了一瞬间的愣神。","style":3,"background":305,"log_type":1,"src_id":220503061,"trial_step":61},{"step":62,"content":"一个身材矮小的少女，举着一把大得有些夸张的武器，站在了拖车的顶部。","style":3,"background":305,"log_type":1,"src_id":220503062,"trial_step":62},{"step":63,"content":"下一刻，她一跃而下，斧刃将狰狞的狂厄武器砸成碎块，也将那个持有狂厄武器的男人掀出几米外。","style":3,"background":305,"log_type":1,"src_id":220503063,"trial_step":63},{"step":64,"content":"在地上翻滚了十多圈之后，那个人抽搐了几下，失去了意识。","style":3,"background":305,"log_type":1,"src_id":220503064,"trial_step":64},{"step":65,"speaker":"赫罗","content":"跟我上！","style":1,"background":305,"log_type":1,"src_id":220503065,"trial_step":65},{"step":66,"content":"在赫罗的怒吼声中，禁闭者、行动队员、军团成员一鼓作气，将本就已失去首领的治安局部队冲散。","style":3,"background":305,"log_type":1,"src_id":220503066,"trial_step":66},{"step":67,"content":"在一片混乱之中，你扛着跪倒在地的赫罗，冲出了包围圈。","style":3,"background":305,"log_type":1,"src_id":220503067,"trial_step":67},{"step":68,"content":"你们一路冲刺，终于彻底甩掉了追兵。","style":3,"background":121,"log_type":1,"src_id":220503068,"trial_step":68},{"step":69,"content":"烈火加剧了混乱，治安局的人已经不是威胁了。","style":3,"background":121,"log_type":1,"src_id":220503069,"trial_step":69},{"step":70,"speaker":"赫罗","content":"真可惜……明明还想有机会再回去看看的。","style":1,"background":121,"log_type":1,"src_id":220503070,"trial_step":70},{"step":71,"content":"你气喘吁吁地背着赫罗前进。少女的身体明明很轻，但你还是累得够呛。","style":3,"background":121,"log_type":1,"src_id":220503071,"trial_step":71},{"step":72,"content":"或许该找时间多锻炼锻炼身体了。","style":3,"background":121,"log_type":1,"src_id":220503072,"trial_step":72},{"step":73,"speaker":"夜莺","content":"局长，附近没有敌人了。请您就待在原地，接应车队马上就到。","style":11,"background":121,"log_type":1,"src_id":220503073,"trial_step":73},{"step":74,"content":"天空下起了雨，看着不远处的军团据点，你知道，分别的时刻到了。","style":3,"background":121,"log_type":1,"src_id":220503074,"trial_step":74},{"step":75,"content":"不……我不相信，队长不可能接受这样的手术！","style":3,"background":121,"log_type":1,"src_id":220503075,"trial_step":75},{"step":76,"speaker":"老杰","content":"蓝尼伤得不轻，我们得赶紧把他带回去，还得尽快做好准备，防止治安局下一轮反扑。","style":1,"background":121,"log_type":1,"src_id":220503076,"trial_step":76},{"step":77,"speaker":"海拉","content":"怕什么，他们蹦跶不了多久了。","style":1,"background":121,"log_type":1,"src_id":220503077,"trial_step":77},{"step":78,"content":"听到军团和海拉的声音，肩膀上的赫罗动了动。","style":3,"background":121,"log_type":1,"src_id":220503078,"trial_step":78},{"step":79,"speaker":"赫罗","content":"${PlayerName}，放我下来吧。","style":1,"background":121,"log_type":1,"src_id":220503079,"trial_step":79},{"step":80,"content":"别乱动，你伤口崩开了。","style":2,"background":121,"log_type":1,"src_id":220503080,"trial_step":80},{"step":81,"speaker":"赫罗","content":"我没事的。","style":1,"background":121,"log_type":1,"src_id":220503081,"trial_step":81},{"step":82,"speaker":"海拉","content":"你没事个屁啊没事。","style":1,"background":121,"log_type":1,"src_id":220503082,"trial_step":82},{"step":83,"content":"赫罗没有跟海拉斗嘴，只是坚持要你把她放下来。你最终还是答应了。","style":3,"background":121,"log_type":1,"src_id":220503083,"trial_step":83},{"step":84,"content":"毕竟她需要与军团的同僚告别。这次分别，再见面得有段时间了。","style":3,"background":121,"log_type":1,"src_id":220503084,"trial_step":84},{"step":85,"speaker":"赫罗","content":"老杰……蓝尼……丹尼……凯文……","style":1,"background":121,"log_type":1,"src_id":220503085,"trial_step":85},{"step":86,"speaker":"赫罗","content":"黑发女人","style":1,"background":121,"log_type":1,"src_id":220503086,"trial_step":86},{"step":87,"speaker":"老杰","content":"多亏了你……还有这个局长，我们都活下来了。","style":1,"background":121,"log_type":1,"src_id":220503087,"trial_step":87},{"step":88,"speaker":"赫罗","content":"这次的事结束之后，你们就不用再战斗了。","style":1,"background":121,"log_type":1,"src_id":220503088,"trial_step":88},{"step":89,"speaker":"赫罗","content":"毕竟，辛迪加的黑帮已经没了，再没什么要去征服的东西了。","style":1,"background":121,"log_type":1,"src_id":220503089,"trial_step":89},{"step":90,"speaker":"老杰","content":"嗯，只要守住现在的就好。","style":1,"background":121,"log_type":1,"src_id":220503090,"trial_step":90},{"step":91,"speaker":"老杰","content":"反正也是从车队那会儿过来的，不去干黑帮，大不了继续做做运输，饿不死。","style":1,"background":121,"log_type":1,"src_id":220503091,"trial_step":91},{"step":92,"speaker":"赫罗","content":"那就好……我再也不想看到……了。","style":1,"background":121,"log_type":1,"src_id":220503092,"trial_step":92},{"step":93,"content":"赫罗松了口气，脚下一软，差点跌倒在地。","style":3,"background":121,"log_type":1,"src_id":220503093,"trial_step":93},{"step":94,"content":"你及时扶住了她。","style":3,"background":121,"log_type":1,"src_id":220503094,"trial_step":94},{"step":95,"content":"老杰看着你们，眼神有些复杂。","style":3,"background":121,"log_type":1,"src_id":220503095,"trial_step":95},{"step":96,"speaker":"老杰","content":"唉……其实原本，我们只是在执行卓娅的命令，保护好赫罗罢了。","style":1,"background":121,"log_type":1,"src_id":220503096,"trial_step":96},{"step":97,"speaker":"老杰","content":"毕竟在我们眼里，赫罗始终是个小妮子。","style":1,"background":121,"log_type":1,"src_id":220503097,"trial_step":97},{"step":98,"speaker":"老杰","content":"大人保护小孩子，天经地义的事。","style":1,"background":121,"log_type":1,"src_id":220503098,"trial_step":98},{"step":99,"speaker":"赫罗","content":"我说过，我不是……小孩子了……","style":1,"background":121,"log_type":1,"src_id":220503099,"trial_step":99},{"step":100,"speaker":"老杰","content":"嗯，你不是。","style":1,"background":121,"log_type":1,"src_id":220503100,"trial_step":100},{"step":101,"content":"老杰的话没有半点敷衍的意思。","style":3,"background":121,"log_type":1,"src_id":220503101,"trial_step":101},{"step":102,"speaker":"老杰","content":"卓娅说得没错，你是会接过她火炬的人。","style":1,"background":121,"log_type":1,"src_id":220503102,"trial_step":102},{"step":103,"speaker":"老杰","content":"你是合格的军团领袖。","style":1,"background":121,"log_type":1,"src_id":220503103,"trial_step":103},{"step":104,"speaker":"赫罗","content":"我……算不上什么领袖。","style":1,"background":121,"log_type":1,"src_id":220503104,"trial_step":104},{"step":105,"speaker":"赫罗","content":"卓娅老大会回来的。军团的领袖，自始至终都只有她一个人。","style":1,"background":121,"log_type":1,"src_id":220503105,"trial_step":105},{"step":106,"speaker":"赫罗","content":"不过，在她回来之前，无论军团有什么困难，我，还有${PlayerName}，我们都不会坐视不管的。","style":1,"background":121,"log_type":1,"src_id":220503106,"trial_step":106},{"step":107,"speaker":"赫罗","content":"是吧？","style":1,"background":121,"log_type":1,"src_id":220503107,"trial_step":107},{"step":108,"content":"赫罗看向你。","style":3,"background":121,"log_type":1,"src_id":220503108,"trial_step":108},{"step":109,"content":"嗯。","style":2,"background":121,"log_type":1,"src_id":220503109,"trial_step":109},{"step":110,"speaker":"海拉","content":"逞什么强啊臭矮子。一边吐血一边说这种耍帅的台词很逊的好吗？","style":1,"background":121,"log_type":1,"src_id":220503110,"trial_step":110},{"step":111,"content":"车队的声音接近，一行人互道珍重，就此分别。","style":3,"background":121,"log_type":1,"src_id":220503111,"trial_step":111},{"step":112,"content":"随着雨水的冲刷，背后的火光渐渐熄灭。","style":3,"background":1018,"log_type":1,"src_id":220503112,"trial_step":112},{"step":113,"content":"回去的路上，你的通讯终端响起。一个熟悉的名字出现在显示屏幕上。","style":3,"background":1018,"log_type":1,"src_id":220503113,"trial_step":113},{"step":114,"speaker":"兰利","content":"你好新人，这次干得不错。","style":11,"background":1018,"log_type":1,"src_id":220503114,"trial_step":114},{"step":115,"content":"无需知会，兰利早已知晓了一切。","style":3,"background":1018,"log_type":1,"src_id":220503115,"trial_step":115},{"step":116,"content":"需要我做什么？","style":2,"background":1018,"log_type":1,"src_id":220503116,"trial_step":116},{"step":117,"speaker":"兰利","content":"向前，第三个路口停下。","style":11,"background":1018,"log_type":1,"src_id":220503117,"trial_step":117},{"step":118,"speaker":"兰利","content":"我的人在那里，把你找到的东西给他。","style":11,"background":1018,"log_type":1,"src_id":220503118,"trial_step":118},{"step":119,"content":"说完，兰利挂断了电话。","style":3,"background":1018,"log_type":1,"src_id":220503119,"trial_step":119},{"step":120,"content":"三个路口之后，头戴灰色帽子的男人正撑着伞等待在那里。","style":3,"background":1028,"log_type":1,"src_id":220503120,"trial_step":120},{"step":121,"content":"接过情报，男人露出礼貌的笑容，向你脱帽致意。","style":3,"background":1028,"log_type":1,"src_id":220503121,"trial_step":121},{"step":122,"content":"你们的人当时在附近？","style":2,"background":1028,"log_type":1,"src_id":220503122,"trial_step":122},{"step":123,"speaker":"9th人员","content":"是的。","style":1,"background":1028,"log_type":1,"src_id":220503123,"trial_step":123},{"step":124,"speaker":"9th人员","content":"我知道您想说什么，局长阁下。","style":1,"background":1028,"log_type":1,"src_id":220503124,"trial_step":124},{"step":125,"speaker":"9th人员","content":"但让我们区区两个情报员去跟凶神恶煞的治安局乱党战斗也不太合理吧。","style":1,"background":1028,"log_type":1,"src_id":220503125,"trial_step":125},{"step":126,"content":"第九机关的人还是老样子，精明得让人有些恶心。","style":3,"background":1028,"log_type":1,"src_id":220503126,"trial_step":126},{"step":127,"speaker":"9th人员","content":"不过您放心，治安局很快就不再存在了。","style":1,"background":1028,"log_type":1,"src_id":220503127,"trial_step":127},{"step":128,"speaker":"9th人员","content":"只要您的军团朋友挺过今天，就不会有人可以威胁他们了。","style":1,"background":1028,"log_type":1,"src_id":220503128,"trial_step":128},{"step":129,"content":"引擎发动，男人向你挥手致意。","style":3,"background":1028,"log_type":1,"src_id":220503129,"trial_step":129},{"step":130,"content":"一旁的赫罗已经睡着了。虽然伤得很重，但她的脸上还挂着笑容。","style":3,"background":1018,"log_type":1,"src_id":220503130,"trial_step":130},{"step":131,"speaker":"赫罗","content":"哥哥……","style":1,"background":1018,"log_type":1,"src_id":220503131,"trial_step":131},{"step":132,"content":"你轻轻抚过赫罗的额头，拭去她眼角的泪水。","style":3,"background":1018,"log_type":1,"src_id":220503132,"trial_step":132},{"step":133,"content":"愿她有个好梦。","style":3,"background":1018,"log_type":1,"src_id":220503133,"trial_step":133}]}