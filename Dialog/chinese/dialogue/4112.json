{"id":4112,"chapter_id":4,"scene_id":412,"steps":[{"step":1,"speaker":"赫罗","content":"呜——！！","voice":["vo_cgplot_4112001"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":2,"content":"污秽的化身消散了，赫罗终于摆脱了阴影，虚脱着昏倒在卓娅怀中。","style":3,"background":405,"log_type":1},{"step":3,"options":["她还好吗？"],"jump":[4],"style":6,"background":405,"log_type":1},{"step":4,"speaker":"卓娅","content":"赫罗扛得住，比这痛百倍的伤她都扛过。","voice":["vo_cgplot_4112004"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":5,"speaker":"卓娅","content":"她会回来的，她知道有人等她回来。","voice":["vo_cgplot_4112005"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":6,"speaker":"卓娅","content":"接下来，该到它了——","voice":["vo_cgplot_4112006"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":7,"content":"她站起身，看向已经打开的石坛。","style":3,"background":405,"log_type":1}]}