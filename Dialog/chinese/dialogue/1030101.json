{"id":1030101,"chapter_id":1030101,"scene_id":1,"steps":[{"step":1,"speaker":"夜莺","content":"局长，我们失败了。","voice":["vo_trial_30101_1_1"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101001,"trial_step":1},{"step":2,"content":"失败？怎么可能？","style":2,"background":1017,"log_type":1,"src_id":130101002,"trial_step":2},{"step":3,"content":"呃，等等，你说什么失败了？","style":2,"background":1017,"log_type":1,"src_id":130101003,"trial_step":3},{"step":4,"speaker":"夜莺","content":"别太紧张，局长，算不上什么至关重要的事。","voice":["vo_trial_30101_1_4"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101004,"trial_step":4},{"step":5,"speaker":"夜莺","content":"我们针对白记实业的调查，基本上宣告失败了。","voice":["vo_trial_30101_1_5"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101005,"trial_step":5},{"step":6,"content":"调查人员被袭击了？","style":2,"background":1017,"log_type":1,"src_id":130101006,"trial_step":6},{"step":7,"speaker":"夜莺","content":"没那回事。调查人员很好，只是他们查证白记实业相关的情报进度不太好。","voice":["vo_trial_30101_1_7"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101007,"trial_step":7},{"step":8,"content":"那没事，我也没指望这么快就能查出最终结果。","style":2,"background":1017,"log_type":1,"src_id":130101008,"trial_step":8},{"step":9,"speaker":"夜莺","content":"我会要求他们继续调查的。","voice":["vo_trial_30101_1_9"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101009,"trial_step":9},{"step":10,"content":"嗯。不过，现有的成果也不能就这么浪费。","style":2,"background":1017,"log_type":1,"src_id":130101010,"trial_step":10},{"step":11,"content":"准备一下审查室。正好，借此机会好好跟白老板聊聊。","style":2,"background":1017,"log_type":1,"src_id":130101011,"trial_step":11},{"step":12,"speaker":"白逸","content":"哟，来啦。","voice":["vo_trial_30101_1_12"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101013,"trial_step":13,"drawing":1030101},{"step":13,"content":"白逸的坐姿非常随意，就像在自己家里一样。","style":3,"log_type":1,"src_id":130101014,"trial_step":14,"drawing":1030101},{"step":14,"speaker":"白逸","content":"单独找我见面，是想聊点见不得人的事情吗？","voice":["vo_trial_30101_1_14"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101015,"trial_step":15,"drawing":1030101},{"step":15,"content":"……","style":2,"log_type":1,"src_id":130101016,"trial_step":16,"drawing":1030101},{"step":16,"speaker":"白逸","content":"啊呀，别害羞嘛，想说什么就说吧。我不会嘲笑你的。","voice":["vo_trial_30101_1_16"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101017,"trial_step":17,"drawing":1030101},{"step":17,"speaker":"白逸","content":"当然，按老规矩，陪聊按分钟计费。不开口也要算钱哦。","voice":["vo_trial_30101_1_17"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101018,"trial_step":18,"drawing":1030101},{"step":18,"options":["你没资格讨价还价","别打岔"],"style":6,"log_type":1,"src_id":130101019,"trial_step":19,"course":3,"drawing":1030101,"choices":[{"text":"你没资格讨价还价","goto":20},{"text":"别打岔","goto":21}]},{"step":19,"content":"配合审查是禁闭者的义务。","style":2,"log_type":1,"src_id":130101020,"trial_step":20,"drawing":1030101,"next":[22]},{"step":20,"content":"……现在是审查，严肃一点。","style":2,"log_type":1,"src_id":130101021,"trial_step":21,"drawing":1030101},{"step":21,"speaker":"白逸","content":"开个玩笑而已嘛……这点小事我还不至于真的管你要钱。","voice":["vo_trial_30101_1_21"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101022,"trial_step":22,"drawing":1030105},{"step":22,"speaker":"白逸","content":"有什么想问的就问吧，我听着呢。","voice":["vo_trial_30101_1_22"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101023,"trial_step":23,"drawing":1030105},{"step":23,"content":"……","style":2,"log_type":1,"src_id":130101024,"trial_step":24,"drawing":1030105},{"step":24,"content":"我今天找你的主要目的，是想了解有关“白记实业”这家公司的事情。","style":2,"log_type":1,"src_id":130101025,"trial_step":25,"drawing":1030105},{"step":25,"speaker":"白逸","content":"你想知道白记的事？早说呀，我们白记，最值得说的……嗯……","voice":["vo_trial_30101_1_25"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101026,"trial_step":26,"drawing":1030101},{"step":26,"speaker":"白逸","content":"我们刚推出了辛迪加七日伴游活动，考虑一下？","voice":["vo_trial_30101_1_26"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101027,"trial_step":27,"drawing":1030101},{"step":27,"speaker":"白逸","content":"现在下单的话享受八折优惠哦。","voice":["vo_trial_30101_1_27"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101028,"trial_step":28,"drawing":1030101},{"step":28,"content":"你们的业务我当然也很好奇。","style":2,"log_type":1,"src_id":130101029,"trial_step":29,"drawing":1030101},{"step":29,"content":"但更重要的是，“白记实业”这块招牌后的秘密。","style":2,"log_type":1,"src_id":130101030,"trial_step":30,"drawing":1030101},{"step":30,"speaker":"白逸","content":"哦——","voice":["vo_trial_30101_1_30"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101031,"trial_step":31,"drawing":1030105},{"step":31,"content":"白逸眯起眼睛，身体微微前倾。","style":3,"log_type":1,"src_id":130101032,"trial_step":32,"drawing":1030105},{"step":32,"speaker":"白逸","content":"原来你想知道的是这个啊，可是，想打听别人的秘密……","voice":["vo_trial_30101_1_32"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101033,"trial_step":33,"drawing":1030105},{"step":33,"speaker":"白逸","content":"我可以不收你的钱。不过，你也不能一点表示都没有吧？","voice":["vo_trial_30101_1_33"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101034,"trial_step":34,"drawing":1030105},{"step":34,"options":["你想要什么？"],"style":6,"log_type":1,"src_id":130101035,"trial_step":35,"course":3,"drawing":1030105,"choices":[{"text":"你想要什么？","goto":36}]},{"step":35,"content":"白逸又向前凑了凑。","style":3,"log_type":1,"src_id":130101036,"trial_step":36,"drawing":1030104},{"step":36,"speaker":"白逸","content":"西区商城，专享折扣，限时秒杀，更可以拉上好友一起砍价。","voice":["vo_trial_30101_1_36"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101037,"trial_step":37,"drawing":1030104},{"step":37,"speaker":"白逸","content":"最新款个人终端，武器，死恋电台见面会门票……各类紧俏商品应有尽有。","voice":["vo_trial_30101_1_37"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101038,"trial_step":38,"drawing":1030104},{"step":38,"speaker":"白逸","content":"还在犹豫什么，赶紧扫描二维码下载吧！","voice":["vo_trial_30101_1_38"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101039,"trial_step":39,"drawing":1030104},{"step":39,"content":"……","style":2,"log_type":1,"src_id":130101040,"trial_step":40,"drawing":1030104},{"step":40,"speaker":"白逸","content":"赶紧扫描二维码下载吧！","voice":["vo_trial_30101_1_40"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101041,"trial_step":41,"drawing":1030104},{"step":41,"content":"白逸又指了指胸口。","style":3,"log_type":1,"src_id":130101042,"trial_step":42,"drawing":1030104},{"step":42,"content":"……","style":2,"log_type":1,"src_id":130101043,"trial_step":43,"drawing":1030104},{"step":43,"content":"你举起个人终端，扫描了那串来源不明的二维码。","style":3,"log_type":1,"src_id":130101044,"trial_step":44,"drawing":1030104},{"step":44,"speaker":"白逸","content":"哈哈，这才对吗。","voice":["vo_trial_30101_1_44"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101045,"trial_step":45,"drawing":1030104},{"step":45,"content":"不得不说MBCC的网速很快，你还没来得及反应，下载进度条就已经满了。","style":3,"log_type":1,"src_id":130101046,"trial_step":46,"drawing":1030101},{"step":46,"content":"花花绿绿的广告弹窗伴随着音质极差的土味音乐一瞬间挤满了你的终端屏幕，怎么点都关不完。","style":3,"log_type":1,"src_id":130101047,"trial_step":47,"drawing":1030101},{"step":47,"options":["关闭个人终端"],"style":6,"log_type":1,"src_id":130101048,"trial_step":48,"course":3,"drawing":1030101,"choices":[{"text":"关闭个人终端","goto":49}]},{"step":48,"content":"你将个人终端关闭，放回口袋里。","style":3,"log_type":1,"src_id":130101049,"trial_step":49,"drawing":1030101},{"step":49,"content":"我已经按照你的要求扫码下载了。接下来，你也该配合我的工作了吧？","style":2,"log_type":1,"src_id":130101050,"trial_step":50,"drawing":1030101},{"step":50,"speaker":"白逸","content":"行吧。","voice":["vo_trial_30101_1_50"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101051,"trial_step":51,"drawing":1030101},{"step":51,"content":"白逸伸了个懒腰。","style":3,"log_type":1,"src_id":130101052,"trial_step":52,"drawing":1030101},{"step":52,"content":"先说说你们的基本情况吧。","style":2,"log_type":1,"src_id":130101053,"trial_step":53,"drawing":1030101},{"step":53,"speaker":"白逸","content":"上至复仇下至遛狗，白记实业为您解忧。","voice":["vo_trial_30101_1_53"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101054,"trial_step":54,"drawing":1030104},{"step":54,"speaker":"白逸","content":"我们白记历史悠久诚信经营，业务范围广、完单率高，连续五年被评为辛迪加最受欢迎商家。","voice":["vo_trial_30101_1_54"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101055,"trial_step":55,"drawing":1030104},{"step":55,"content":"据我所知，你们白记是105年成立的，对吧？","style":2,"log_type":1,"src_id":130101056,"trial_step":56,"drawing":1030104},{"step":56,"speaker":"白逸","content":"哎呀你懂不懂啊。在辛迪加这种地方，能开超过两年的企业都算是历史悠久了。","voice":["vo_trial_30101_1_56"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101057,"trial_step":57,"drawing":1030104},{"step":57,"speaker":"白逸","content":"咳咳，嗯，团队初创期仅有两人，后扩充至三人。此后团队趋于稳定。虽然人员没有增长，但业务规模却不断扩大。","voice":["vo_trial_30101_1_57"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101058,"trial_step":58,"drawing":1030104},{"step":58,"speaker":"白逸","content":"在辛迪加地区多年耕耘之后，我们甚至与辛迪加的明星帮派军团建立了长期稳定的业务往来……","voice":["vo_trial_30101_1_58"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101059,"trial_step":59,"drawing":1030104},{"step":59,"speaker":"白逸","content":"唉下面的我不记得了。总之你只要知道，白记很厉害，在辛迪加没人敢不给我们面子。就连军团都不敢惹我们，还得乖乖给我们委托业务。","voice":["vo_trial_30101_1_59"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101060,"trial_step":60,"drawing":1030104},{"step":60,"speaker":"白逸","content":"我说得够明白了吧。","voice":["vo_trial_30101_1_60"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101061,"trial_step":61,"drawing":1030104},{"step":61,"content":"不，我不太明白——为什么同样是白记的成员，蔻蔻跟你说的情况完全相反。","style":2,"log_type":1,"src_id":130101062,"trial_step":62,"drawing":1030104},{"step":62,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":63,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":64,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":65,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":66,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":67,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":68,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":69,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":70,"content":"这是蔻蔻的证词，需要我给你念一遍吗？","style":2,"log_type":1,"src_id":130101064,"trial_step":64,"drawing":1030104},{"step":71,"content":"……也就是说，白记的经营状况很糟糕，对吗？","style":2,"background":1017,"log_type":1,"src_id":130101065,"trial_step":65},{"step":72,"speaker":"蔻蔻","content":"糟糕？烂透了！","voice":["vo_trial_30101_1_64"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101066,"trial_step":66},{"step":73,"speaker":"蔻蔻","content":"房租拖了半年了，水电费更是一天都没缴过。再这样下去连饭都吃不起了！","voice":["vo_trial_30101_1_65"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101067,"trial_step":67},{"step":74,"speaker":"蔻蔻","content":"澈成天摸鱼打牌，有时候好几天都看不见人影。好不容易看到他人了还满嘴歪理。让他干点活还死活不愿意。","voice":["vo_trial_30101_1_66"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101068,"trial_step":68},{"step":75,"speaker":"蔻蔻","content":"我能怎么办？只好我一个人干活啊。","voice":["vo_trial_30101_1_67"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101069,"trial_step":69},{"step":76,"speaker":"蔻蔻","content":"可我每天在外面送外卖、替人疏通下水道赚来的那点钱，白逸只用搞砸一次委托就能全赔光。","voice":["vo_trial_30101_1_68"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101070,"trial_step":70},{"step":77,"speaker":"蔻蔻","content":"她是真不知道自己“辛迪加三害”的外号是哪儿来的嘛……一天到晚就是在闯祸欠债，我真是巴不得她能消停一会儿。","voice":["vo_trial_30101_1_69"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101071,"trial_step":71},{"step":78,"speaker":"蔻蔻","content":"有时候真的挺绝望的，感觉日子没法过了……","voice":["vo_trial_30101_1_70"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101072,"trial_step":72},{"step":79,"content":"既然这么糟，你为什么不另谋出路？","style":2,"background":1017,"log_type":1,"src_id":130101073,"trial_step":73},{"step":80,"speaker":"蔻蔻","content":"……一个做事完全不着调，一个天塌下来都不肯干活……饭也不会做，我不在家就只能吃泡面。","voice":["vo_trial_30101_1_72"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101074,"trial_step":74},{"step":81,"speaker":"蔻蔻","content":"臭不要脸的连妈都叫得出口，离了我这两个人能活得下去？","voice":["vo_trial_30101_1_73"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101075,"trial_step":75},{"step":82,"speaker":"白逸","content":"好你个蔻蔻，在局长面前尽损我呢是吧……","voice":["vo_trial_30101_1_74"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101076,"trial_step":76,"drawing":1030106},{"step":83,"content":"没想到，堂堂白老板，居然是辛迪加三害中的“老赖”。还真是名不虚传啊。","style":2,"log_type":1,"src_id":130101077,"trial_step":77,"drawing":1030106},{"step":84,"speaker":"白逸","content":"没有，这明显就是有些不怀好意的家伙嫉妒我。我……嗐……","voice":["vo_trial_30101_1_76"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101078,"trial_step":78,"drawing":1030106},{"step":85,"content":"白逸叹了口气。","style":3,"log_type":1,"src_id":130101079,"trial_step":79,"drawing":1030102},{"step":86,"speaker":"白逸","content":"好吧好吧，蔻蔻说得对。白记的业务确实出了点小问题行了吧。","voice":["vo_trial_30101_1_78"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101080,"trial_step":80,"drawing":1030102},{"step":87,"speaker":"白逸","content":"所以呢？让我承认这些对你有什么好处？","voice":["vo_trial_30101_1_79"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101081,"trial_step":81,"drawing":1030102},{"step":88,"content":"我只是需要你能诚实地面对我。","style":2,"log_type":1,"src_id":130101082,"trial_step":82,"drawing":1030102},{"step":89,"speaker":"白逸","content":"哈？就这原因？你们心理可真够扭曲的……","voice":["vo_trial_30101_1_81"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101083,"trial_step":83,"drawing":1030103},{"step":90,"content":"接下来的问题非常重要，希望你能好好回答。","style":2,"log_type":1,"src_id":130101084,"trial_step":84,"drawing":1030102},{"step":91,"options":["卓娅在哪儿？"],"style":6,"log_type":1,"src_id":130101085,"trial_step":85,"course":3,"drawing":1030102,"choices":[{"text":"卓娅在哪儿？","goto":86}]},{"step":92,"speaker":"白逸","content":"我怎么可能知道。","voice":["vo_trial_30101_1_84"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101086,"trial_step":86,"drawing":1030103},{"step":93,"content":"白老板翻了个白眼。","style":3,"log_type":1,"src_id":130101087,"trial_step":87,"drawing":1030103},{"step":94,"content":"可你自己都说了，白记“与辛迪加的明星帮派军团建立了长期稳定的业务往来”。","style":2,"log_type":1,"src_id":130101088,"trial_step":88,"drawing":1030102},{"step":95,"speaker":"白逸","content":"怎么了，不许我吹牛啊？再说了，你刚刚不是已经戳穿我了吗？","voice":["vo_trial_30101_1_87"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101089,"trial_step":89,"drawing":1030102},{"step":96,"content":"BR-004爆发当天，澈进入了黑环。常人根本无法在黑环里行动那么长时间，但他却能不受影响。","style":2,"log_type":1,"src_id":130101090,"trial_step":90,"drawing":1030102},{"step":97,"content":"你们白记是不是有什么不可告人的秘密？","style":2,"log_type":1,"src_id":130101091,"trial_step":91,"drawing":1030102},{"step":98,"speaker":"白逸","content":"没有。","voice":["vo_trial_30101_1_90"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101092,"trial_step":92,"drawing":1030102},{"step":99,"content":"白逸的回答非常干脆。","style":3,"log_type":1,"src_id":130101093,"trial_step":93,"drawing":1030102},{"step":100,"content":"在雕像顶与卓娅周旋的人是不是你？","style":2,"log_type":1,"src_id":130101094,"trial_step":94,"drawing":1030102},{"step":101,"speaker":"白逸","content":"不是。","voice":["vo_trial_30101_1_93"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101095,"trial_step":95,"drawing":1030102},{"step":102,"content":"白逸再一次矢口否认。","style":3,"log_type":1,"src_id":130101096,"trial_step":96,"drawing":1030103},{"step":103,"speaker":"白逸","content":"谁没事不要命往黑环里跑啊。","voice":["vo_trial_30101_1_95"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101097,"trial_step":97,"drawing":1030103},{"step":104,"content":"可澈那天说帮忙牵制卓娅的是他的朋友。","style":2,"log_type":1,"src_id":130101098,"trial_step":98,"drawing":1030103},{"step":105,"speaker":"白逸","content":"谁知道那个臭小鬼勾搭上了什么狐朋狗友，总之我不认识。","voice":["vo_trial_30101_1_97"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101099,"trial_step":99,"drawing":1030103},{"step":106,"content":"你那几天在哪里？","style":2,"log_type":1,"src_id":130101100,"trial_step":100,"drawing":1030103},{"step":107,"speaker":"白逸","content":"跑业务呗，还能干什么？","voice":["vo_trial_30101_1_99"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101101,"trial_step":101,"drawing":1030103},{"step":108,"content":"有人能证明吗？","style":2,"log_type":1,"src_id":130101102,"trial_step":102,"drawing":1030103},{"step":109,"speaker":"白逸","content":"证明？我要怎么证明？蔻蔻在你们管理局享福，澈在黑环里，谁能证明嘛……","voice":["vo_trial_30101_1_101"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101103,"trial_step":103,"drawing":1030103},{"step":110,"speaker":"白逸","content":"我这个老板，做得一点尊严没有，整天奔波赚钱养家……","voice":["vo_trial_30101_1_102"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101104,"trial_step":104,"drawing":1030103},{"step":111,"content":"白逸抹了抹眼角并不存在的眼泪，瞟了你一眼。","style":3,"log_type":1,"src_id":130101105,"trial_step":105,"drawing":1030103},{"step":112,"speaker":"白逸","content":"手底下员工一个个吃里扒外不把我这个老板放在眼里，最后还要我背黑锅呜呜……","voice":["vo_trial_30101_1_104"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101106,"trial_step":106,"drawing":1030103},{"step":113,"content":"白逸说的显然不是实话。不过很可惜，你所掌握的情报并不足以推翻她这通胡搅蛮缠式的发言。","style":3,"log_type":1,"src_id":130101107,"trial_step":107,"drawing":1030103},{"step":114,"content":"既然如此，不如利用现有的情报来验证一下你的猜想。","style":3,"log_type":1,"src_id":130101108,"trial_step":108,"drawing":1030103},{"step":115,"content":"你都这么说了，我姑且就相信你。","style":2,"log_type":1,"src_id":130101109,"trial_step":109,"drawing":1030103},{"step":116,"content":"不过我还有别的事情要问你——","style":2,"log_type":1,"src_id":130101110,"trial_step":110,"drawing":1030103},{"step":117,"content":"测试音效的打断逻辑","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":118,"content":"播放一个长音效，会有个前奏，稍等一会儿。","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":119,"content":"播放相同音效，会继续延续。","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":120,"content":"暂停配置音效，这里测试一下打断。","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":121,"content":"播放一个稍短的音效，在这里等待它结束。","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":122,"content":"配置同名音效，看能否再次播放。","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":123,"content":"结束测试。","style":18,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":124,"content":"自六月起，██街有一股势力动作频频。其行为包括但不限于吸纳黑帮、疑似贩运狂厄武器等。","style":2,"log_type":1,"src_id":130101112,"trial_step":112,"drawing":1030103},{"step":125,"content":"MBCC抓获了该组织一名小头目，其自称服务于白记实业……","style":2,"log_type":1,"src_id":130101113,"trial_step":113,"drawing":1030103},{"step":126,"content":"解释一下吧，白老板。","style":2,"log_type":1,"src_id":130101114,"trial_step":114,"drawing":1030103},{"step":127,"speaker":"白逸","content":"污蔑！这是赤裸裸的污蔑！","voice":["vo_trial_30101_1_113"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101115,"trial_step":115,"drawing":1030106},{"step":128,"speaker":"白逸","content":"肯定是哪个不知好歹的帮派余孽。真是狗胆包天，居然敢栽赃到老娘的头上。","voice":["vo_trial_30101_1_114"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101116,"trial_step":116,"drawing":1030106},{"step":129,"content":"所以真的不是你因为缺钱缺得厉害，才盯上狂厄武器的生意的？","style":2,"log_type":1,"src_id":130101117,"trial_step":117,"drawing":1030106},{"step":130,"speaker":"白逸","content":"那怎么可能？！我再怎么穷也不至于沦落到这份儿上。","voice":["vo_trial_30101_1_116"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101118,"trial_step":118,"drawing":1030106},{"step":131,"content":"白逸一把夺过情报夹，指着情报上的那个男人破口大骂。","style":3,"log_type":1,"src_id":130101119,"trial_step":119,"drawing":1030106},{"step":132,"speaker":"白逸","content":"这谁啊？认都不认识我怎么可能招来当员工。","voice":["vo_trial_30101_1_118"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101120,"trial_step":120,"drawing":1030106},{"step":133,"speaker":"白逸","content":"再说了，白记就我、澈、蔻蔻，哪儿来的第四个人啊……","voice":["vo_trial_30101_1_119"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101121,"trial_step":121,"drawing":1030106},{"step":134,"speaker":"白逸","content":"等等，澈该不会就是跟这帮人混到一块儿去了吧？","voice":["vo_trial_30101_1_120"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101122,"trial_step":122,"drawing":1030106},{"step":135,"content":"白逸露出一副气势汹汹的表情。","style":3,"log_type":1,"src_id":130101123,"trial_step":123,"drawing":1030106},{"step":136,"speaker":"白逸","content":"好啊这臭小子，不干活也就算了，还吃里扒外败坏白记的名声……","voice":["vo_trial_30101_1_122"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101124,"trial_step":124,"drawing":1030106},{"step":137,"content":"你先冷静，这只是你的猜测。","style":2,"log_type":1,"src_id":130101125,"trial_step":125,"drawing":1030106},{"step":138,"speaker":"白逸","content":"我不管，敢冒充白记的人必须付出代价！","voice":["vo_trial_30101_1_124"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101126,"trial_step":126,"drawing":1030106},{"step":139,"content":"说着，白逸瞟了你一眼。","style":3,"log_type":1,"src_id":130101127,"trial_step":127,"drawing":1030106},{"step":140,"speaker":"白逸","content":"你得帮我。","voice":["vo_trial_30101_1_126"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101128,"trial_step":128,"drawing":1030103},{"step":141,"content":"这是你们白记的事，我为什么要插手？","style":2,"log_type":1,"src_id":130101129,"trial_step":129,"drawing":1030103},{"step":142,"speaker":"白逸","content":"你根除了辛迪加地区的狂厄武器交易，我借你之手除掉冒充我的人，这叫双赢好吗！","voice":["vo_trial_30101_1_128"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101130,"trial_step":130,"drawing":1030103},{"step":143,"speaker":"白逸","content":"难不成你们MBCC不想管狂厄武器的生意了？","voice":["vo_trial_30101_1_129"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101131,"trial_step":131,"drawing":1030103},{"step":144,"options":["管理局不会不管的"],"style":6,"log_type":1,"src_id":130101132,"trial_step":132,"course":3,"drawing":1030103,"choices":[{"text":"管理局不会不管的","goto":133}]},{"step":145,"content":"白逸说得没错。不管外面那个白记实业是真是假，涉及到狂厄武器，你不能不管。","style":3,"log_type":1,"src_id":130101133,"trial_step":133,"drawing":1030103},{"step":146,"speaker":"白逸","content":"那就好。你放心，这事儿我来帮你，保证不掉链子。我倒要看看，是谁敢冒充老娘，真是活腻歪了。","voice":["vo_trial_30101_1_132"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101134,"trial_step":134,"drawing":1030104},{"step":147,"content":"……","style":2,"log_type":1,"src_id":130101135,"trial_step":135,"drawing":1030104},{"step":148,"content":"无论如何，眼下也没有更多情报可以向白逸质问的了。","style":3,"log_type":1,"src_id":130101136,"trial_step":136,"drawing":1030104},{"step":149,"content":"清除狂厄威胁的确是MBCC的首要任务，你本就打算解决掉这个交易狂厄武器的团伙。现在白逸主动请缨，反倒是给了你探明虚实的机会。","style":3,"log_type":1,"src_id":130101137,"trial_step":137,"drawing":1030104},{"step":150,"content":"那这次的行动，就要多多仰仗你了。","style":2,"log_type":1,"src_id":130101138,"trial_step":138,"drawing":1030104},{"step":151,"speaker":"白逸","content":"包在我身上。","voice":["vo_trial_30101_1_137"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101139,"trial_step":139,"drawing":1030104},{"step":152,"content":"白逸拍着胸脯保证。","style":3,"log_type":1,"src_id":130101140,"trial_step":140,"drawing":1030104},{"step":153,"content":"……","style":2,"log_type":1,"src_id":130101141,"trial_step":141,"drawing":1030104},{"step":154,"content":"走出审查室，夜莺正站在门前等你。","style":3,"background":107,"log_type":1,"src_id":130101142,"trial_step":142},{"step":155,"speaker":"夜莺","content":"审查感觉如何？进展顺利吗？","voice":["vo_trial_30101_1_141"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130101143,"trial_step":143},{"step":156,"content":"不算很顺利。白逸嘴很严，看上去也很擅长应对这种场景。","style":2,"background":107,"log_type":1,"src_id":130101144,"trial_step":144},{"step":157,"content":"我们没有决定性证据，短时间内还没法拆穿她。","style":2,"background":107,"log_type":1,"src_id":130101145,"trial_step":145},{"step":158,"speaker":"夜莺","content":"那您打算……","voice":["vo_trial_30101_1_144"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130101146,"trial_step":146},{"step":159,"content":"无论如何，狂厄武器不能放着不管。","style":2,"background":107,"log_type":1,"src_id":130101147,"trial_step":147},{"step":160,"content":"你掏出个人终端。","style":3,"background":107,"log_type":1,"src_id":130101148,"trial_step":148},{"step":161,"content":"我先联系行动部门，我们尽快解决这个麻烦，说不定还能发……","style":2,"background":107,"log_type":1,"src_id":130101149,"trial_step":149},{"step":162,"speaker":"广告","content":"定制刀具，限时预约。","style":1,"background":107,"log_type":1,"src_id":130101150,"trial_step":150},{"step":163,"speaker":"广告","content":"硝酸甘油出售，量大从优！","style":1,"background":107,"log_type":1,"src_id":130101151,"trial_step":151},{"step":164,"speaker":"广告","content":"新城罐头食品，数量有限，先到先得。","style":1,"background":107,"log_type":1,"src_id":130101152,"trial_step":152},{"step":165,"content":"你刚一打开个人终端，十多个广告弹窗怼在你的脸上，吓了你一大跳。","style":3,"background":107,"log_type":1,"src_id":130101153,"trial_step":153},{"step":166,"content":"……","style":2,"background":107,"log_type":1,"src_id":130101154,"trial_step":154},{"step":167,"content":"算了，你替我联系他们吧。我先去处理派遣的事情，15分钟后让负责人去我办公室报道。","style":2,"background":107,"log_type":1,"src_id":130101155,"trial_step":155},{"step":168,"speaker":"夜莺","content":"明白。","voice":["vo_trial_30101_1_154"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130101156,"trial_step":156},{"step":169,"content":"你匆匆将终端放回口袋，快步离开审查室区域。","style":3,"background":107,"log_type":1,"src_id":130101157,"trial_step":157}]}