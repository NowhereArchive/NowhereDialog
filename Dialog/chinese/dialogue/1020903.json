{"id":1020903,"chapter_id":1020903,"scene_id":1,"steps":[{"step":1,"content":"【砂海洞穴】","style":18,"background":2003,"log_type":1,"src_id":120903001,"trial_step":1},{"step":2,"content":"与已知的每一片沙漠相似，砂海中昼与夜的交替十分明显——白日总是刺眼而灼热，夜晚则是寒冷刺骨。","style":3,"background":2003,"log_type":1,"src_id":120903002,"trial_step":2},{"step":3,"content":"长期生活在砂海中的居民大多会有一套应对这温差的办法，而西涅克斯的对策则更为简单。入夜时分，她会让秘金兽们躺到自己身边当恒温棉毯，等到日出气温升高再把它们一脚踹开。","style":3,"background":2003,"log_type":1,"src_id":120903003,"trial_step":3},{"step":4,"content":"说起秘金兽，这两天它们身体恶化的速度变得更快了。你被囚禁的几天，每天都有几只秘金兽死去。","style":3,"background":2003,"log_type":1,"src_id":120903004,"trial_step":4},{"step":5,"content":"西涅克斯信守着与秘金兽们的承诺。每次有秘金兽死去，她就像之前那样啃食掉它们的身体，而其他秘金兽也会与之前那次一样，虔诚地守候在她身侧，陪伴她完成这场“仪式”。","style":3,"background":2003,"log_type":1,"src_id":120903005,"trial_step":5},{"step":6,"content":"但，这样海量的摄入造成了一些连带影响。你发现她身上秘金覆盖的面积越来越大，变异程度也不断加深。分析之后，你得出了一个显而易见的结论。","style":3,"background":2003,"log_type":1,"src_id":120903006,"trial_step":6},{"step":7,"content":"——她对秘金的承载能力，已经快要达到极限了。","style":3,"background":2003,"log_type":1,"src_id":120903007,"trial_step":7},{"step":8,"speaker":"西涅克斯","content":"停下？哦？什么叫停下？","voice":["vo_trial_404103_1_1"],"voice_bank":"vo_synex_trial","style":1,"background":2003,"log_type":1,"src_id":120903008,"trial_step":8},{"step":9,"content":"这两天我观察了你进食的情况，也看到了它对你身体的影响。","style":2,"background":2003,"log_type":1,"src_id":120903009,"trial_step":9},{"step":10,"content":"你身体已经快到极限了，变异也在不断加深。如果再持续摄入这么大量的秘金，你的身体会被压垮的。","style":2,"background":2003,"log_type":1,"src_id":120903010,"trial_step":10},{"step":11,"content":"西涅克斯听后兴奋地搓了搓手，露出一个微笑。","style":3,"background":2003,"log_type":1,"src_id":120903011,"trial_step":11},{"step":12,"speaker":"西涅克斯","content":"听起来还不错呀，坏处呢？","voice":["vo_trial_404103_1_2"],"voice_bank":"vo_synex_trial","style":1,"background":2003,"log_type":1,"src_id":120903012,"trial_step":12},{"step":13,"content":"？","style":2,"background":2003,"log_type":1,"src_id":120903013,"trial_step":13},{"step":14,"content":"……你听起来，完全不在意自己的生命安全。","style":2,"background":2003,"log_type":1,"src_id":120903014,"trial_step":14},{"step":15,"speaker":"西涅克斯","content":"我很在意这副身体，尤其是身体里我能调用的力量。而这两天，我清楚地感觉到它正在飞速增长，因此心情很好呢。","voice":["vo_trial_404103_1_3"],"voice_bank":"vo_synex_trial","style":1,"background":2003,"log_type":1,"src_id":120903015,"trial_step":15},{"step":16,"speaker":"西涅克斯","content":"怎么啦，小局长，看到我力量增长是不是很担心，觉得以后就再也没法控制我啦？","voice":["vo_trial_404103_1_4"],"voice_bank":"vo_synex_trial","style":1,"background":2003,"log_type":1,"src_id":120903016,"trial_step":16},{"step":17,"content":"她用爪子拍了拍你的脸蛋。","style":3,"background":2003,"log_type":1,"src_id":120903017,"trial_step":17},{"step":18,"speaker":"西涅克斯","content":"真可惜，我要的就是这种效果。","voice":["vo_trial_404103_1_5"],"voice_bank":"vo_synex_trial","style":1,"background":2003,"log_type":1,"src_id":120903018,"trial_step":18},{"step":19,"speaker":"西涅克斯","content":"好啦，时间差不多了，我要出去找灰烬使徒玩了。你就在这绑着吧，拜拜~","voice":["vo_trial_404103_1_6"],"voice_bank":"vo_synex_trial","style":1,"background":2003,"log_type":1,"src_id":120903019,"trial_step":19},{"step":20,"content":"说完，西涅克斯吹了个口哨，就出门去了。","style":3,"background":2003,"log_type":1,"src_id":120903020,"trial_step":20},{"step":21,"content":"……啧。","style":2,"background":2003,"log_type":1,"src_id":120903021,"trial_step":21},{"step":22,"content":"你低头看向自己胸前，先前准备的定位装置正在缓慢闪烁着微光。这是已经被定位的符号，根据闪烁的间隔，FAC将在几小时后到达。","style":3,"background":2003,"log_type":1,"src_id":120903022,"trial_step":22},{"step":23,"content":"在那之前，最好能控制住西涅克斯……至少不能让她再杀人。","style":3,"background":2003,"log_type":1,"src_id":120903023,"trial_step":23},{"step":24,"content":"你缓慢挪向岩壁，开始在岩壁上刮蹭绳索。洞穴岩壁十分粗糙，但绳索也是坚韧，你费了一番功夫，才勉强弄松了绳结。","style":3,"background":2003,"log_type":1,"src_id":120903024,"trial_step":24},{"step":25,"content":"就在你和绳子搏斗的这会儿，天色突然暗了下来。周围的秘金兽纷纷警觉地抬起头。","style":3,"background":2003,"log_type":1,"src_id":120903025,"trial_step":25},{"step":26,"content":"……日食？不……沙暴吗？","style":2,"background":2003,"log_type":1,"src_id":120903026,"trial_step":26},{"step":27,"speaker":"秘金兽","content":"咕咕唔——！","style":1,"background":2003,"log_type":1,"src_id":120903027,"trial_step":27},{"step":28,"content":"突然间，就像在印证你的担忧，一个长得像瓶子一样的秘金兽出现在洞口光线中。","style":3,"background":2003,"log_type":1,"src_id":120903028,"trial_step":28},{"step":29,"content":"怎么了？是西涅克斯出什么事了吗？","style":2,"background":2003,"log_type":1,"src_id":120903029,"trial_step":29},{"step":30,"content":"绳索就在这时断了，那秘金兽也没有其他的反应，它一把抱住了你的手臂，向洞外拖去。","style":3,"background":2003,"log_type":1,"src_id":120903030,"trial_step":30},{"step":31,"content":"【砂海·夜】","style":18,"background":10000,"log_type":1,"src_id":120903031,"trial_step":31},{"step":32,"content":"——！","style":2,"background":2419,"log_type":1,"src_id":120903032,"trial_step":32},{"step":33,"content":"走出洞口，抬眼便是遮天蔽日的一片沙暴。","style":3,"background":2419,"log_type":1,"src_id":120903033,"trial_step":33},{"step":34,"content":"不祥的漆黑与夜空交汇在一起，让你近乎看不清前方的景象。你眯着眼四处寻找，终于从无尽混沌里分辨出了一抹金黄。","style":3,"background":2419,"log_type":1,"src_id":120903034,"trial_step":34},{"step":35,"content":"是西涅克斯。她处在风暴中心，正与身形巨大的使徒搏杀。秘金微光的映照下，又是一次攻击，使徒操控的巨石重重砸向西涅克斯胸口。可即使受了这么重的伤，她嘴角那抹诡异的微笑也没有丝毫动摇。","style":3,"background":2419,"log_type":1,"src_id":120903035,"trial_step":35},{"step":36,"content":"西涅克斯！！快回来！！","style":2,"background":2419,"log_type":1,"src_id":120903036,"trial_step":36},{"step":37,"content":"风暴逐步向你所在的方向靠近，哪怕只是在风暴的最边缘，你也感受到了狂厄力量的奔涌。","style":3,"background":2419,"log_type":1,"src_id":120903037,"trial_step":37},{"step":38,"content":"那是压倒性的，足以碾碎一个小镇的“天灾”！","style":3,"background":2419,"log_type":1,"src_id":120903038,"trial_step":38},{"step":39,"speaker":"西涅克斯","content":"哎呀，这是谁呀？洞穴里的小仓鼠挣扎着爬了出来，是想跟大人们一起玩吗？","voice":["vo_trial_404103_1_7"],"voice_bank":"vo_synex_trial","style":1,"background":2419,"log_type":1,"src_id":120903039,"trial_step":39},{"step":40,"speaker":"西涅克斯","content":"可惜大人正忙呢，没空搭理你！","voice":["vo_trial_404103_1_8"],"voice_bank":"vo_synex_trial","style":1,"background":2419,"log_type":1,"src_id":120903040,"trial_step":40},{"step":41,"content":"清醒点！西涅克斯，从没有人能独自对抗灰烬使徒！再这样下去你真的会死！","style":2,"background":2419,"log_type":1,"src_id":120903041,"trial_step":41},{"step":42,"speaker":"西涅克斯","content":"哦，我会死啊？但这和你有什么关系呢？","voice":["vo_trial_404103_1_9"],"voice_bank":"vo_synex_trial","style":1,"background":2419,"log_type":1,"src_id":120903042,"trial_step":42},{"step":43,"speaker":"西涅克斯","content":"你也说我的命不长了，那在这不长的生命里头，难道要小心翼翼，平淡无聊度过吗？这跟直接死了有什么区别？","voice":["vo_trial_404103_1_10"],"voice_bank":"vo_synex_trial","style":1,"background":2419,"log_type":1,"src_id":120903043,"trial_step":43},{"step":44,"content":"……","style":2,"background":2419,"log_type":1,"src_id":120903044,"trial_step":44},{"step":45,"content":"你在这一刻突然明白了。这个女人，她一直是故意的。","style":3,"background":2419,"log_type":1,"src_id":120903045,"trial_step":45},{"step":46,"content":"她是在主动寻找这些最惊险的战斗，期待着撕裂别人的身体，也渴盼着敌手把自己的身躯撕成两半。","style":3,"background":2419,"log_type":1,"src_id":120903046,"trial_step":46},{"step":47,"content":"仿佛只有在浑身浴血、生死一线的时候，她才能满足于自己生命的重量。","style":3,"background":2419,"log_type":1,"src_id":120903047,"trial_step":47},{"step":48,"speaker":"西涅克斯","content":"怕疼就退后，想看就看着。杀红眼的时候，我可认不出你。","voice":["vo_trial_404103_1_11"],"voice_bank":"vo_synex_trial","style":1,"background":2419,"log_type":1,"src_id":120903048,"trial_step":48},{"step":49,"content":"她的体表又一次出现了那熟悉的流金色纹路，但这次，它们不再是像上次那样缓慢地流动，而是像湍流不断冲刷着西涅克斯的身躯，就像一团金色的火焰，要将她烧灼殆尽。","style":3,"background":2419,"log_type":1,"src_id":120903049,"trial_step":49},{"step":50,"content":"她再一次冲进了风暴之中。","style":3,"background":2419,"log_type":1,"src_id":120903050,"trial_step":50},{"step":51,"content":"秘金力量的加持下，那双利爪很快将黑影撕开了一个裂口，然后是第二个、第三个……使徒吃痛地大声嘶吼起来，那些被洞穿的部位被金色光芒焚烧着，任凭再多的黑色沙尘都无法让它愈合。","style":3,"background":2419,"log_type":1,"src_id":120903051,"trial_step":51},{"step":52,"content":"但同时，一模一样的金色裂隙，也出现在了西涅克斯的颈间。她的双手偏转成了一个诡异的角度，让你想起秘金兽的四肢。","style":3,"background":2419,"log_type":1,"src_id":120903052,"trial_step":52},{"step":53,"content":"……","style":2,"background":2419,"log_type":1,"src_id":120903053,"trial_step":53},{"step":54,"content":"过量秘金已经渗透了她的身体。神智恐怕也即将消失，现在对她喊话只是徒劳。最好的方法可能是疏解掉她身上的秘金力量，但你手上并没有合适的设备。","style":3,"background":2419,"log_type":1,"src_id":120903054,"trial_step":54},{"step":55,"content":"看来，那就只剩下最简单粗暴的一种方式了。","style":3,"background":2419,"log_type":1,"src_id":120903055,"trial_step":55},{"step":56,"options":["冲进去！"],"style":3,"background":2419,"log_type":1,"src_id":120903056,"trial_step":56,"course":3,"choices":[{"text":"冲进去！","goto":57}]},{"step":57,"content":"【沙暴背景】","style":18,"background":2418,"log_type":1,"src_id":120903057,"trial_step":57},{"step":58,"content":"汹涌的风暴瞬间将你包围，你向咫尺可见的西涅克斯方向用力伸出了手——","style":3,"background":2418,"log_type":1,"src_id":120903058,"trial_step":58},{"step":59,"content":"西涅克斯！！！","style":2,"background":2418,"log_type":1,"src_id":120903059,"trial_step":59},{"step":60,"content":"使用枷锁","style":22,"background":2418,"log_type":1,"src_id":120903059,"trial_step":59},{"step":61,"content":"西涅克斯！！！","style":2,"background":2418,"log_type":1,"src_id":120903059,"trial_step":59},{"step":62,"content":"使用枷锁","style":22,"background":2418,"log_type":1,"src_id":120903059,"trial_step":59},{"step":63,"content":"（枷锁特效）","style":18,"background":2418,"log_type":1,"src_id":120903060,"trial_step":60},{"step":64,"content":"枷锁的力量奋力穿透了秘金屏障，抓住了在黑风中翻滚身形的秘金怪兽。","style":3,"background":2418,"log_type":1,"src_id":120903061,"trial_step":61},{"step":65,"content":"【再次释放枷锁】","style":22,"background":2418,"log_type":1,"src_id":120903061,"trial_step":61},{"step":66,"content":"枷锁的力量奋力穿透了秘金屏障，抓住了在黑风中翻滚身形的秘金怪兽。","style":3,"background":2418,"log_type":1,"src_id":120903061,"trial_step":61},{"step":67,"content":"【再次释放枷锁】","style":22,"background":2418,"log_type":1,"src_id":120903061,"trial_step":61},{"step":68,"content":"你的力量暂且压住了她体内扭曲的狂厄。西涅克斯颈部的金光淡去，取而代之的是赤红色的纹路。","style":3,"background":2418,"log_type":1,"src_id":120903062,"trial_step":62},{"step":69,"content":"这是我的枷锁——我知道你大概不会喜欢，但现在的你没有拒绝的资格。","style":2,"background":2418,"log_type":1,"src_id":120903063,"trial_step":63},{"step":70,"content":"限此一次，来做我的提线木偶吧。","style":2,"background":2418,"log_type":1,"src_id":120903064,"trial_step":64},{"step":71,"content":"一道又一道的红光袭向西涅克斯，随着枷锁的不断加深，她的双眼也重新亮了起来。","style":3,"background":2418,"log_type":1,"src_id":120903065,"trial_step":65},{"step":72,"speaker":"西涅克斯","content":"哦……哦哦哦哦？这是什么？这是什么？！","voice":["vo_trial_404103_1_12"],"voice_bank":"vo_synex_trial","style":1,"background":2418,"log_type":1,"src_id":120903066,"trial_step":66},{"step":73,"speaker":"西涅克斯","content":"这种紧缚的感觉，刺穿的感觉，窒息的感觉——好爽！好爽！","voice":["vo_trial_404103_1_13"],"voice_bank":"vo_synex_trial","style":1,"background":2418,"log_type":1,"src_id":120903067,"trial_step":67},{"step":74,"speaker":"西涅克斯","content":"你怎么从没说过，枷锁是这么舒服的东西！","voice":["vo_trial_404103_1_14"],"voice_bank":"vo_synex_trial","style":1,"background":2418,"log_type":1,"src_id":120903068,"trial_step":68},{"step":75,"content":"枷锁的力量在她体内横冲直撞，以破坏性的入侵平息了秘金的暴走，几秒前还几近濒死的西涅克斯，此刻却在你身前完全恢复了神智，她极为满足地欣赏着身上那些红色与金色相间的烙痕。","style":3,"background":2418,"log_type":1,"src_id":120903069,"trial_step":69},{"step":76,"speaker":"西涅克斯","content":"……真是判若两人。原来之前那个小白兔的样子只是你的伪装，现在终于情不自禁露出真实的自己了？","voice":["vo_trial_404103_1_15"],"voice_bank":"vo_synex_trial","style":1,"background":2418,"log_type":1,"src_id":120903070,"trial_step":70},{"step":77,"speaker":"西涅克斯","content":"我喜欢这份力量……我暂且答应你。我会听你话、受你差使，直到战斗结束。","voice":["vo_trial_404103_1_16"],"voice_bank":"vo_synex_trial","style":1,"background":2418,"log_type":1,"src_id":120903071,"trial_step":71},{"step":78,"speaker":"西涅克斯","content":"所以，可以攻击了吗？局长大~人~？","voice":["vo_trial_404103_1_17"],"voice_bank":"vo_synex_trial","style":1,"background":2418,"log_type":1,"src_id":120903072,"trial_step":72},{"step":79,"speaker":"选项","options":["去吧，消灭它！"],"style":6,"background":2418,"log_type":1,"src_id":120903073,"trial_step":73,"course":3,"choices":[{"text":"去吧，消灭它！","goto":74}]},{"step":80,"speaker":"西涅克斯","content":"谨遵你的命令。哈哈哈哈哈哈——！","voice":["vo_trial_404103_1_18"],"voice_bank":"vo_synex_trial","style":1,"background":2418,"log_type":1,"src_id":120903074,"trial_step":74},{"step":81,"content":"话音刚落，西涅克斯就再次冲向了使徒所在的风暴之中。","style":3,"background":2418,"log_type":1,"src_id":120903075,"trial_step":75},{"step":82,"content":"她像一颗金红色的子弹般在风暴的内壁闪电般穿梭，每一次穿透使徒的身躯时，都会传来非人的怒吼与大笑。","style":3,"background":2418,"log_type":1,"src_id":120903076,"trial_step":76},{"step":83,"content":"战斗持续了近一个小时。最终西涅克斯也没能绞下了使徒的头颅，但她也再没有失去神智，你与她一起撑到了使徒溃逃的那一刻。","style":3,"background":2005,"log_type":1,"src_id":120903077,"trial_step":77},{"step":84,"content":"别追了！西涅克斯！！","style":2,"background":2005,"log_type":1,"src_id":120903078,"trial_step":78},{"step":85,"content":"枷锁耗尽了你的精神力，而西涅克斯的体力也在战斗中透支一空。你们两人接连倒在了沙地里，头靠头，脚抵脚，她浑身殷红的血液染透了你的衣摆。","style":3,"background":2005,"log_type":1,"src_id":120903079,"trial_step":79},{"step":86,"content":"西涅克斯转过头，与你四目相对，她那双血红色的眼睛里，此刻正涌动着什么让你陌生的东西。","style":3,"background":2005,"log_type":1,"src_id":120903080,"trial_step":80},{"step":87,"speaker":"西涅克斯","content":"呵呵呵呵……这比我先前想象的还要爽呢……","voice":["vo_trial_404103_1_19"],"voice_bank":"vo_synex_trial","style":1,"background":2005,"log_type":1,"src_id":120903081,"trial_step":81},{"step":88,"content":"如果可以的话，请你少做这种透支生命的行动。","style":2,"background":2005,"log_type":1,"src_id":120903082,"trial_step":82},{"step":89,"speaker":"西涅克斯","content":"可惜现在战斗已经结束了，我不会再听你的了。是不是很可惜刚才没有再拿命拖一拖呀？","voice":["vo_trial_404103_1_20"],"voice_bank":"vo_synex_trial","style":1,"background":2005,"log_type":1,"src_id":120903083,"trial_step":83},{"step":90,"content":"……","style":2,"background":2005,"log_type":1,"src_id":120903084,"trial_step":84},{"step":91,"speaker":"西涅克斯","content":"不过当然，刚才说的也不是灰烬使徒，是你。准确来说，是你的枷锁~","voice":["vo_trial_404103_1_21"],"voice_bank":"vo_synex_trial","style":1,"background":2005,"log_type":1,"src_id":120903085,"trial_step":85},{"step":92,"speaker":"西涅克斯","content":"多么爽快呀，两股力量在这副身体里彼此倾轧对撞，打起架来的感觉完全不一样，就好像身体回到全盛期了一样……真是让人怀念的感觉。","voice":["vo_trial_404103_1_22"],"voice_bank":"vo_synex_trial","style":1,"background":2005,"log_type":1,"src_id":120903086,"trial_step":86},{"step":93,"content":"西涅克斯的声音越来越小，但声线中却带着十足的喜悦。","style":3,"background":2005,"log_type":1,"src_id":120903087,"trial_step":87},{"step":94,"speaker":"西涅克斯","content":"哈啊……没想到……你这只小白兔还是有两把刷子的，原本不想跟你回MBCC的……","voice":["vo_trial_404103_1_23"],"voice_bank":"vo_synex_trial","style":1,"background":2005,"log_type":1,"src_id":120903088,"trial_step":88},{"step":95,"content":"……那现在呢？","style":2,"background":2005,"log_type":1,"src_id":120903089,"trial_step":89},{"step":96,"content":"回到局里，你的病也可以治好。这一次你应该不会拒绝了吧？","style":2,"background":2005,"log_type":1,"src_id":120903090,"trial_step":90},{"step":97,"content":"长时间的沉默。你没听到回应，于是转头看向身边人，却发现她早已带着笑容坠入了梦乡。","style":1,"background":2005,"log_type":1,"src_id":120903091,"trial_step":91},{"step":98,"content":"这家伙……","style":2,"background":2005,"log_type":1,"src_id":120903092,"trial_step":92},{"step":99,"content":"其实你可以理解西涅克斯的困倦。漫长的战斗、枷锁的负荷，早将你们二人的体力与精神力消耗殆尽。如今系着你的意识的，也不过是一份对二人安危的担忧。","style":3,"background":2005,"log_type":1,"src_id":120903093,"trial_step":93},{"step":100,"content":"你也倒了下来，已经有些模糊的眼睛越过西涅克斯的身体，远远眺望着地平线。","style":3,"background":2005,"log_type":1,"src_id":120903094,"trial_step":94},{"step":101,"content":"你在远处看到了最熟悉的那群人的身影。","style":3,"background":2005,"log_type":1,"src_id":120903095,"trial_step":95},{"step":102,"content":"你用尽最后一点力气起身，向他们挥着手，而他们最终也发现了你。","style":3,"background":2005,"log_type":1,"src_id":120903096,"trial_step":96},{"step":103,"speaker":"遥远的声音","content":"队长，那边有人！","voice":["vo_trial_404103_1_25"],"voice_bank":"vo_synex_trial","style":1,"background":2005,"log_type":1,"src_id":120903097,"trial_step":97},{"step":104,"speaker":"遥远的声音","content":"那是……是局长！局长身边还有一个浑身带血的女人！快抬担架来！","voice":["vo_trial_404103_1_26"],"voice_bank":"vo_synex_trial","style":1,"background":2005,"log_type":1,"src_id":120903098,"trial_step":98},{"step":105,"speaker":"字幕","content":"针对位于砂海的秘金实验体西涅克斯的捕获行动开启两天后，FAC搜救队在砂海腹地寻找到了此前失踪的${PlayerName}。","style":14,"background":2005,"is_centered":true,"log_type":1,"src_id":120903099,"trial_step":99},{"step":106,"speaker":"字幕","content":"其周身出现多处伤口，兼有中度脱水等症状，经治疗预后良好。","style":14,"background":2005,"is_centered":true,"log_type":1,"src_id":120903100,"trial_step":100},{"step":107,"speaker":"字幕","content":"在${PlayerName}身边，发现涉嫌费沙研究所泄密事件等多起恶性案件的犯人“西涅克斯”。捕获时，对象自身的危险性已大幅削弱，基于其所携带的情报特殊性，要求尽快进行审查。","style":14,"background":2005,"is_centered":true,"log_type":1,"src_id":120903101,"trial_step":101}]}