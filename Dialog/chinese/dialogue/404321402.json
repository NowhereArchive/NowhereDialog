{"id":404321402,"chapter_id":50088,"scene_id":58859,"steps":[{"step":1,"content":"你开门走出去，前往马洛的房间。","style":3,"background":2174,"log_type":1},{"step":2,"content":"【希露妲房间】","style":18,"background":2506,"log_type":1},{"step":3,"content":"马洛的房间很宽大，与希露妲的一样都是属于主人房。","style":3,"background":2506,"log_type":1},{"step":4,"content":"你轻手轻脚地搜寻起来。","style":3,"background":2506,"log_type":1},{"step":5,"speaker":"诺兰","content":"嘘——别动。","voice":["vo_event_404321402_01"],"voice_bank":"vo_event_43214","style":1,"background":2506,"log_type":1},{"step":6,"content":"一柄冰冷的刀顶住了你的后背。","style":3,"background":2506,"log_type":1},{"step":7,"speaker":"诺兰","content":"我刚刚去你的房间找你，却没想到你跑到了这里。","voice":["vo_event_404321402_03"],"voice_bank":"vo_event_43214","style":1,"background":2506,"log_type":1},{"step":8,"speaker":"诺兰","content":"我知道自己不是鼹鼠，那么鼹鼠就一定在另外3个人里。那为什么要这么麻烦地一个个辨认，索性全杀光不就好了？","voice":["vo_event_404321402_04"],"voice_bank":"vo_event_43214","style":1,"background":2506,"log_type":1},{"step":9,"speaker":"诺兰","content":"所以我先杀了曼菲斯特，然后去杀了海伦娜。","voice":["vo_event_404321402_05"],"voice_bank":"vo_event_43214","style":1,"background":2506,"log_type":1},{"step":10,"speaker":"诺兰","content":"杀死海伦娜的时候，我看到了这个。","voice":["vo_event_404321402_06"],"voice_bank":"vo_event_43214","style":1,"background":2506,"log_type":1},{"step":11,"content":"她从你背后伸出手，指尖捏着的是已经被鲜血染红的密信。","style":3,"background":2506,"log_type":1},{"step":12,"speaker":"诺兰","content":"海伦娜把这东西当护身符放在身上，是不是很可笑？","voice":["vo_event_404321402_08"],"voice_bank":"vo_event_43214","style":1,"background":2506,"log_type":1},{"step":13,"speaker":"诺兰","content":"原来你才是那个身份不明、潜入我们之中的鼹鼠！","voice":["vo_event_404321402_09"],"voice_bank":"vo_event_43214","style":1,"background":2506,"log_type":1},{"step":14,"speaker":"诺兰","content":"只要杀了你，这一切就都结束了，我就能跟希露妲活着出去了！","voice":["vo_event_404321402_10"],"voice_bank":"vo_event_43214","style":1,"background":2506,"log_type":1},{"step":15,"options":["先下手为强，杀了诺兰","用语言转移她的注意力"],"style":34,"background":2506,"log_type":1}]}