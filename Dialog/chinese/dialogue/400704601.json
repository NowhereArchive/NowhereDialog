{"id":400704601,"chapter_id":50019,"scene_id":51913,"steps":[{"step":1,"speaker":"黑影","content":"嘿嘿，来呀来呀！我在这边哦！","voice":["vo_event_400704601_1"],"voice_bank":"vo_event_07046","style":1,"background":2075,"log_type":1},{"step":2,"speaker":"黑影","content":"加油加油——你可比我们家的佣人姐姐们厉害多了！","voice":["vo_event_400704601_2"],"voice_bank":"vo_event_07046","style":1,"background":2075,"log_type":1},{"step":3,"content":"游戏开始将近二十分钟，你全身的细胞都因连续奔跑发出悲鸣。","style":3,"background":2075,"log_type":1},{"step":4,"content":"它甚至没有想要藏起来，就只是大摇大摆地站在路边等你来抓。","style":3,"background":2075,"log_type":1},{"step":5,"options":["抓到你了——"],"jump":[6],"style":6,"background":2075,"log_type":1},{"step":6,"content":"提灯黑影在你即将触碰到的前一秒消失。这是第14次失败了。","style":3,"background":2075,"log_type":1},{"step":7,"speaker":"黑影","content":"哎呀呀，还差一点点，继续努力哦~","voice":["vo_event_400704601_7"],"voice_bank":"vo_event_07046","style":1,"background":2075,"log_type":1},{"step":8,"content":"和昨天一样，在你马上要接触到它时，它便会立刻消失。","style":3,"background":2075,"log_type":1},{"step":9,"options":["尝试把它逼进狭小的空间试试"],"jump":[10],"style":6,"background":2075,"log_type":1},{"step":10,"content":"虽然它足够灵活，但要是进到死胡同的话，行动应该也会受到限制吧？","style":3,"background":2075,"log_type":1},{"step":11,"content":"你有意地规划着你的前进路线，控制它进入商店街的小巷，它虽然看起来有些惊讶，但还是顺着你的路线进行游戏。","style":3,"background":2075,"log_type":1},{"step":12,"content":"不过，出乎你意料的是，自从来到这里之后，它的反应倒是慢了许多。","style":3,"background":2075,"log_type":1},{"step":13,"content":"它甚至直接将提灯别在了腰后，一整个影子紧贴在一家玩具店的橱窗上。","style":3,"background":2075,"log_type":1},{"step":14,"speaker":"黑影","content":"……咦？这不是千代的模型么？","voice":["vo_event_400704601_14"],"voice_bank":"vo_event_07046","style":1,"background":2075,"log_type":1},{"step":15,"speaker":"黑影","content":"哇……造型好有新意！下次一定要说服爸爸给我买！","voice":["vo_event_400704601_15"],"voice_bank":"vo_event_07046","style":1,"background":2075,"log_type":1},{"step":16,"speaker":"黑影","content":"啊——这里还有好多！好想都带回家啊！","voice":["vo_event_400704601_16"],"voice_bank":"vo_event_07046","style":1,"background":2075,"log_type":1},{"step":17,"content":"它好像被橱窗后的模型玩具夺去了注意力，你趁机出手。","style":3,"background":2075,"log_type":1},{"step":18,"speaker":"黑影","content":"哇！居然偷袭我！","voice":["vo_event_400704601_18"],"voice_bank":"vo_event_07046","style":1,"background":2075,"log_type":1},{"step":19,"speaker":"黑影","content":"好刺激诶！比家里玩的藏猫猫有趣多了！家里的人怕伤到我，都不敢这么和我玩的！再来，再来！","voice":["vo_event_400704601_19"],"voice_bank":"vo_event_07046","style":1,"background":2075,"log_type":1},{"step":20,"content":"你一路追赶，它也就这么一路后退着，直到你成功将它逼进了一个死胡同。","style":14,"background":10000,"log_type":1},{"step":21,"options":["是我赢了。"],"jump":[22],"style":6,"background":2079,"log_type":1},{"step":22,"content":"看着退无可退的黑影，你说出了胜利者的宣言。","style":3,"background":2079,"log_type":1},{"step":23,"speaker":"黑影","content":"嘿嘿，抓不住可就不算赢哦~抓住我再说这句话吧？","voice":["vo_event_400704601_23"],"voice_bank":"vo_event_07046","style":1,"background":2079,"log_type":1},{"step":24,"content":"它朝你招了招手，你则用尽全身力量前冲。","style":3,"background":2079,"log_type":1},{"step":25,"content":"但在这过程中，你却只看到它的身影渐渐开始与墙面融为一体，并在最后穿了过去。","style":3,"background":2079,"log_type":1},{"step":26,"content":"咚——！","style":3,"background":2079,"log_type":1},{"step":27,"content":"而回应你的，只有混凝土的坚硬触感。","style":3,"background":2079,"log_type":1},{"step":28,"speaker":"黑影","content":"嘿嘿，你还是要加油哦~","voice":["vo_event_400704601_27"],"voice_bank":"vo_event_07046","style":1,"background":2079,"log_type":1},{"step":29,"content":"从墙的另一侧，传来了它的声音。","style":3,"background":2079,"log_type":1}]}