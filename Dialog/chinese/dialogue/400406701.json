{"id":400406701,"chapter_id":50016,"scene_id":51608,"steps":[{"step":1,"content":"N.F.113年\n1月24日 晚上7点","style":9,"background":2041,"log_type":1},{"step":2,"speaker":"新闻","content":"距离第41届狄斯卡颁奖典礼还有3天，狄莱坞庆典紧锣密鼓地筹备中……","voice":["vo_event_400406701_2"],"voice_bank":"vo_event_04067","style":11,"background":2041,"log_type":1},{"step":3,"speaker":"新闻","content":"电影相关投资总额大幅上涨，股票板块形势喜人。狄莱坞电影学院院长多次公开露面，感谢社会各界的关注与支持……","voice":["vo_event_400406701_3"],"voice_bank":"vo_event_04067","style":11,"background":2041,"log_type":1},{"step":4,"speaker":"新闻","content":"同样引发广泛关注的是著名导演黛伦的行踪。息影5年后，黛伦首次放出消息，通过工作室接受狄斯卡评委会邀请，出任本次狄斯卡评委。","voice":["vo_event_400406701_4"],"voice_bank":"vo_event_04067","style":11,"background":2041,"log_type":1},{"step":5,"content":"回到面包车车内，画外音","style":18,"background":2048,"log_type":1},{"step":6,"speaker":"新闻","content":"众多娱乐媒体齐聚狄莱坞，意图确认这位传奇导演的复出意向。但目前尚未有媒体与导演本人取得联系……","voice":["vo_event_400406701_6"],"voice_bank":"vo_event_04067","style":11,"background":2048,"log_type":1},{"step":7,"speaker":"嗷呜","content":"嗨呀呀，舞狮结束冲个凉真的太舒服啦～接下来是，雪糕，雪糕，雪糕……","voice":["vo_event_400406701_7"],"voice_bank":"vo_event_04067","style":1,"background":2048,"log_type":1},{"step":8,"speaker":"嗷呜","content":"呀——！！谁偷吃了嗷呜的雪糕！！","voice":["vo_event_400406701_8"],"voice_bank":"vo_event_04067","style":1,"background":2048,"log_type":1},{"step":9,"speaker":"洛芙","content":"诶？你也喜欢这个气温吃雪糕吗？不愧是嗷呜妹妹，跟我心有灵犀！","voice":["vo_event_400406701_9"],"voice_bank":"vo_event_04067","style":1,"background":2048,"log_type":1},{"step":10,"speaker":"嗷呜","content":"唔……就算是洛芙也不能原谅！！！把嗷呜的幸福时光还回来啦！！！","voice":["vo_event_400406701_10"],"voice_bank":"vo_event_04067","style":1,"background":2048,"log_type":1},{"step":11,"speaker":"洛芙","content":"诶诶，不是我——","voice":["vo_event_400406701_11"],"voice_bank":"vo_event_04067","style":1,"background":2048,"log_type":1},{"step":12,"speaker":"“导演”D","content":"呼……呼……嘶——！！！凉了凉了……","voice":["vo_event_400406701_12"],"voice_bank":"vo_event_04067","style":1,"background":2048,"log_type":1}]}