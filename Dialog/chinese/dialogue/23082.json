{"id":23082,"chapter_id":21,"scene_id":2108,"steps":[{"step":2,"speaker":"奇兰-II号","content":"成功了，拉玛。","style":1,"background":2629,"log_type":1},{"step":3,"speaker":"拉玛","content":"她人呢？人去哪儿了！${PlayerName}，把艾瑟默尔带回来，拜托你——","voice":["vo_cgplot_23092030"],"voice_bank":"vo_cgplot_2309","style":1,"background":2629,"log_type":1},{"step":4,"speaker":"席宁","content":"……是吗，${PlayerName}成功了。","voice":["vo_cgplot_23092033","vo_cgplot_23092033f"],"voice_bank":"vo_cgplot_2309","style":1,"background":2622131,"log_type":1},{"step":5,"speaker":"席宁","content":"要是还愿意回来跟我分享就好了，这样的材料可是很难得到的。","voice":["vo_cgplot_23092034"],"voice_bank":"vo_cgplot_2309","style":1,"background":2622131,"log_type":1},{"step":6,"content":"只是遗憾……好像要赶不及了。","style":3,"background":2622131,"log_type":1},{"step":7,"content":"她脚边，身前，被毁坏的地底傀儡叠做一堆。面前，粗糙的裂隙中源源不断地钻出新敌人。","style":3,"background":2622131,"log_type":1},{"step":8,"content":"它们做出一反常态的行动呢……","style":3,"background":2622131,"log_type":1},{"step":9,"content":"看来BR-003也只是幌子，真正的目的在这里……他们很努力在遮掩。","style":3,"background":2622131,"log_type":1},{"step":10,"speaker":"席宁","content":"该谢谢地底……用行动证实我的猜想。","voice":["vo_cgplot_23092039"],"voice_bank":"vo_cgplot_2309","style":1,"background":2622131,"log_type":1},{"step":11,"content":"【转场】","style":18,"background":2631,"log_type":1},{"step":12,"content":"重伤的艾瑟默尔被傀儡带回隐香会。伊薇利恩在给她疗伤。","style":3,"background":2631,"log_type":1},{"step":13,"content":"【交代一下灭口席宁】","style":18,"background":2631,"log_type":1},{"step":14,"speaker":"艾瑟默尔","content":"…………","style":1,"background":2631,"log_type":1},{"step":15,"speaker":"伊薇利恩","content":"不用这样看我，我不打算杀你。","voice":["vo_cgplot_23092001"],"voice_bank":"vo_cgplot_2309","style":1,"background":2631,"log_type":1},{"step":16,"speaker":"伊薇利恩","content":"夺环的时机还没成熟，再说，你已经按照约定，为我们争取了足够的时间，够了。剩下的小动作……她不会介意的。","voice":["vo_cgplot_23092002"],"voice_bank":"vo_cgplot_2309","style":1,"background":2631,"log_type":1},{"step":17,"speaker":"伊薇利恩","content":"你很有才能，这里有你的容身之处。","voice":["vo_cgplot_23092003"],"voice_bank":"vo_cgplot_2309","style":1,"background":2631,"log_type":1},{"step":18,"speaker":"艾瑟默尔","content":"……不需要……我给自己留好了位置，我知道要怎么走……","voice":["vo_cgplot_23092004"],"voice_bank":"vo_cgplot_2309","style":1,"background":2631,"log_type":1},{"step":19,"speaker":"艾瑟默尔","content":"还有最后一件事……","voice":["vo_cgplot_23092005"],"voice_bank":"vo_cgplot_2309","style":1,"background":2631,"log_type":1},{"step":20,"content":"她艰难抬手，准备战斗。","style":3,"background":2631,"log_type":1},{"step":21,"speaker":"伊薇利恩","content":"……是吗，那这一程我送你。","voice":["vo_cgplot_23092007"],"voice_bank":"vo_cgplot_2309","style":1,"background":2631,"log_type":1}]}