":"格雷格","content":"我们，自由了。","voice":["vo_trial_60304_1_17"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160304050,"trial_step":50},{"step":55,"speaker":"康兰","content":"灵魂！灵魂！给我美味的灵魂！！！","voice":["vo_trial_60304_1_18"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160304052,"trial_step":52},{"step":56,"speaker":"局长","content":"“观察并等待其枝繁叶茂的一天。”","style":2,"background":111,"log_type":1,"src_id":160304054,"trial_step":54},{"step":57,"speaker":"卡门奈特","content":"枷锁是很厉害……亲爱的局长……","voice":["vo_trial_60304_1_19"],"voice_bank":"vo_cab_trial","style":1,"background":2092,"log_type":1,"src_id":160304055,"trial_step":55},{"step":58,"speaker":"卡门奈特","content":"但禁闭者的力量，源于他们的内心……","voice":["vo_trial_60304_1_20"],"voice_bank":"vo_cab_trial","style":1,"background":2092,"log_type":1,"src_id":160304056,"trial_step":56},{"step":59,"speaker":"卡门奈特","content":"我的内心……充斥着对美食的渴望，填满了对美味“灵魂”的渴求。","voice":["vo_trial_60304_1_21"],"voice_bank":"vo_cab_trial","style":1,"background":2092,"log_type":1,"src_id":160304057,"trial_step":57},{"step":60,"speaker":"卡门奈特","content":"希望你能力的进步，追得上……","voice":["vo_trial_60304_1_22"],"voice_bank":"vo_cab_trial","style":1,"background":2092,"log_type":1,"src_id":160304058,"trial_step":58},{"step":61,"speaker":"卡门奈特","content":"我内心欲望的膨胀。","voice":["vo_trial_60304_1_23"],"voice_bank":"vo_cab_trial","style":1,"background":2092,"log_type":1,"src_id":160304059,"trial_step":59},{"step":62,"speaker":"局长","content":"芙兰克的任何需求都能被满足，“美食”就是你仅剩的全部，除此之外你什么都不想要。","style":2,"background":111,"log_type":1,"src_id":160304060,"trial_step":60},{"step":63,"speaker":"局长","content":"我无法像帮助康兰那样帮助你。谢谢你的“主菜”，今天的宴席就此结束吧。","style":2,"background":111,"log_type":1,"src_id":160304061,"trial_step":61},{"step":64,"content":"卡门奈特没有回应你的话，复杂而欣喜地看着你。但这次，她看向的不是你的脖颈，而是眼睛。","style":3,"background":111,"log_type":1,"src_id":160304062,"trial_step":62},{"step":65,"speaker":"卡门奈特","content":"“美食”就是全部……么？","voice":["vo_trial_60304_1_24"],"voice_ba