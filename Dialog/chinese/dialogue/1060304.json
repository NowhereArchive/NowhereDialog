ackground":111,"log_type":1,"src_id":160304027,"trial_step":27},{"step":27,"speaker":"局长","content":"他们想要的，或许对你芙兰克家大小姐而言不算什么，对他们来说却是全部。","style":2,"background":111,"log_type":1,"src_id":160304028,"trial_step":28},{"step":28,"content":"你有些无奈地看向一旁不懈挣扎的康兰，已经难以在那张痴狂的脸上找回曾经的生气。","style":3,"background":111,"log_type":1,"src_id":160304029,"trial_step":29},{"step":29,"speaker":"康兰","content":"你的味道不对……还要更滚烫，更纯粹的！","voice":["vo_trial_60304_1_9"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160304030,"trial_step":30},{"step":30,"speaker":"康兰","content":"我的食物，在哪里！","voice":["vo_trial_60304_1_10"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160304031,"trial_step":31},{"step":31,"content":"她完全无视了警卫对她的包围和警告。此时她的眼里只有——","style":3,"background":111,"log_type":1,"src_id":160304032,"trial_step":32},{"step":32,"speaker":"康兰","content":"灵魂！灵魂！给我美味的灵魂！！！","voice":["vo_trial_60304_1_11"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160304033,"trial_step":33},{"step":33,"content":"而一切的始作俑者卡门奈特，只是有些出神地听着你义正词严的指责，旁观着。","style":3,"background":111,"log_type":1,"src_id":160304034,"trial_step":34},{"step":34,"speaker":"局长","content":"我会去争取一切可调动的力量帮助康兰恢复精神健康，至于你……卡门奈特。","style":2,"background":111,"log_type":1,"src_id":160304035,"trial_step":35},{"step":35,"speaker":"局长","content":"我也会向上申请重新评估你的收容等级。","style":2,"background":111,"log_type":1,"src_id":160304036,"trial_step":36},{"step":36,"speaker":"卡门奈特","content":"哦？你不想治好我吗，善良的局长阁下？","voice":["vo_trial_60304_1_12"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160304037,"trial_step":37},{"step":37,"speaker":"局长","content":"这不一样……康兰只是被迫尝到了灵魂的味道，才会突然失控。帮她冷静下来，回忆起她的理想、她的爱人，找到更值得追寻的事物后，她或许还能恢复正常。","style":2,"background":111,"log_type":1,"src_id":160304038,"trial_step":38},{"step":38,"speaker":"局长","content":"但你——除了美食，你还想要什么？","style":2,"background":111,"log_type":1,"src_id":160304039,"trial_step":39},{"step":39,"speaker":"卡门奈特