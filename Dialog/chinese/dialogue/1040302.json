{"id":1040302,"chapter_id":1040302,"scene_id":1,"steps":[{"step":1,"content":"罗马内斯克会堂","style":9,"background":917,"log_type":1,"src_id":140302001,"trial_step":1},{"step":2,"content":"不同于你第一次来到这里的时候，现在的碑林，几乎已经看不出原来的样子了。大部分纪念碑已经坍塌，白色的大理石块散落在荒草丛间，有的地方的坟茔破裂，露出里面的寿材。","style":3,"background":917,"log_type":1,"src_id":140302002,"trial_step":2},{"step":3,"content":"你们走进碑林的时候，一只乌鸦扑簌着翅膀从一块纪念碑上飞走，你注意到那块碑上爬了一簇黑色的藤蔓，上面开了一朵米黄色的小花。","style":3,"background":917,"log_type":1,"src_id":140302003,"trial_step":3},{"step":4,"content":"那是什么花？","style":2,"background":917,"log_type":1,"src_id":140302004,"trial_step":4},{"step":5,"content":"橡木匣看见了那朵花，眼神忽然凝聚了起来。她走到藤蔓旁边蹲下，轻轻抚摸那朵小小的花。","style":3,"background":917,"log_type":1,"src_id":140302005,"trial_step":5},{"step":6,"speaker":"橡木匣","content":"渡鸦","voice":["vo_trial_40302_1_6"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302006,"trial_step":6},{"step":7,"content":"你侧耳倾听，但是，碑林间就像一片凝固的时空，连一丝风声也无。","style":3,"background":917,"log_type":1,"src_id":140302007,"trial_step":7},{"step":8,"content":"……没有。","style":2,"background":917,"log_type":1,"src_id":140302008,"trial_step":8},{"step":9,"speaker":"橡木匣","content":"这是一朵橡树花。或者说，被烙印的橡树花。","voice":["vo_trial_40302_1_9"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302009,"trial_step":9},{"step":10,"content":"但这棵藤蔓甚至不是橡树的枝。","style":2,"background":917,"log_type":1,"src_id":140302010,"trial_step":10},{"step":11,"speaker":"橡木匣","content":"烙印现象。这株藤蔓从橡木做的寿材中长出，它的花形复刻了橡树花的样子。这块碑下埋葬的是一个花匠，他生前很喜欢植物。","voice":["vo_trial_40302_1_11"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302011,"trial_step":11},{"step":12,"speaker":"橡木匣","content":"碑林后有一棵橡树，曾经被修道院的爆炸炸去了大半树干，但它依然活了下来。","voice":["vo_trial_40302_1_12"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302012,"trial_step":12},{"step":13,"content":"因为这位花匠？","style":2,"background":917,"log_type":1,"src_id":140302013,"trial_step":13},{"step":14,"speaker":"橡木匣","content":"是的，他爱护他能见到的所有植物，梦想住在森林里。尽管他这一世从来没有见过真正的森林。","voice":["vo_trial_40302_1_14"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302014,"trial_step":14},{"step":15,"speaker":"橡木匣","content":"他临死的时候，请求我说他的灵柩不要使用被烘干的木材，他希望他的生命能够和这些植物融为一体。","voice":["vo_trial_40302_1_15"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302015,"trial_step":15},{"step":16,"content":"他也是在这次大战中死去的吗？","style":2,"background":917,"log_type":1,"src_id":140302016,"trial_step":16},{"step":17,"speaker":"橡木匣","content":"不……更久之前。","voice":["vo_trial_40302_1_17"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302017,"trial_step":17},{"step":18,"content":"橡木匣温柔地笑了笑。","style":3,"background":917,"log_type":1,"src_id":140302018,"trial_step":18},{"step":19,"speaker":"橡木匣","content":"他死于一场黑帮斗争。","voice":["vo_trial_40302_1_19"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302019,"trial_step":19},{"step":20,"speaker":"橡木匣","content":"他是修道院的花匠。修道院有过一段平和的日子，直到被某个黑帮胁迫着，成为了他们藏匿重要人士的据点。","voice":["vo_trial_40302_1_20"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302020,"trial_step":20},{"step":21,"speaker":"橡木匣","content":"很快，那位黑帮藏身修道院的事情就被发现了。其余黑帮围攻了修道院，很多人都在那次围攻中死去了。","voice":["vo_trial_40302_1_21"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302021,"trial_step":21},{"step":22,"speaker":"橡木匣","content":"那时……我回到修道院的时候……他正处于临死之际。","voice":["vo_trial_40302_1_22"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302022,"trial_step":22},{"step":23,"speaker":"橡木匣","content":"他是我收殓的第一个人。","voice":["vo_trial_40302_1_23"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302023,"trial_step":23},{"step":24,"content":"他有留下执念吗？","style":2,"background":917,"log_type":1,"src_id":140302024,"trial_step":24},{"step":25,"speaker":"橡木匣","content":"他担心着修道院后的那颗橡木。","voice":["vo_trial_40302_1_25"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302025,"trial_step":25},{"step":26,"content":"天色已近黄昏，你在暮色中向碑林后望去，那里什么都没有，远方的黑暗空空茫茫，广袤无边。","style":3,"background":917,"log_type":1,"src_id":140302026,"trial_step":26},{"step":27,"speaker":"橡木匣","content":"它没有挺过上次的大战。但我保留了它的一部分。","voice":["vo_trial_40302_1_27"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302027,"trial_step":27},{"step":28,"content":"橡木匣摊开手，手心里有一颗橡子。她把橡子放在那朵小花旁边，注视着它。","style":3,"background":917,"log_type":1,"src_id":140302028,"trial_step":28},{"step":29,"content":"你们沿着碑林的墓道行走，沿途修复那些被损坏的墓碑。橡木匣似乎记得每一个墓碑的主人，记得所有墓碑和棺柩的位置。","style":3,"background":917,"log_type":1,"src_id":140302029,"trial_step":29},{"step":30,"content":"有块墓碑上放着一顶几近破烂的帽子。橡木匣轻轻把帽子从上面拿了下来，开始缝补它。","style":3,"background":917,"log_type":1,"src_id":140302030,"trial_step":30},{"step":31,"content":"这顶帽子，是你的吗？","style":2,"background":917,"log_type":1,"src_id":140302031,"trial_step":31},{"step":32,"speaker":"橡木匣","content":"不，是一个名叫娜莎的小女孩的。这里埋的是她最好的朋友，那个孩子从小多病，娜莎可能是担心她在这里风吹雨淋，会感冒。","voice":["vo_trial_40302_1_32"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302032,"trial_step":32},{"step":33,"content":"……那个孩子是病死的？","style":2,"background":917,"log_type":1,"src_id":140302033,"trial_step":33},{"step":34,"content":"橡木匣微微摇头。","style":3,"background":917,"log_type":1,"src_id":140302034,"trial_step":34},{"step":35,"speaker":"橡木匣","content":"黑帮带走了她，再把她送回来后没过两天，她的母亲在流民寨的一个反应池里发现了她。我给她做了假发和面具，这样，她离去的时候就是她认识的自己的样子了。","voice":["vo_trial_40302_1_35"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302035,"trial_step":35},{"step":36,"content":"她温柔悲哀的目光再次落在墓碑上，上面刻着小女孩的名字，但那名字也早已模糊不清了。","style":3,"background":917,"log_type":1,"src_id":140302036,"trial_step":36},{"step":37,"content":"……娜莎呢，她没有来换过这顶帽子吗？这顶帽子看起来，有些年月了。","style":2,"background":917,"log_type":1,"src_id":140302037,"trial_step":37},{"step":38,"speaker":"橡木匣","content":"她再也没办法来了。","voice":["vo_trial_40302_1_38"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302038,"trial_step":38},{"step":39,"speaker":"橡木匣","content":"那是她的墓碑。","voice":["vo_trial_40302_1_39"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302039,"trial_step":39},{"step":40,"content":"你顺着橡木匣的目光望去，在帽子的后面有另一块更新一些的墓碑，上面写着娜莎的名字和死亡时间。","style":3,"background":917,"log_type":1,"src_id":140302040,"trial_step":40},{"step":41,"speaker":"橡木匣","content":"重建执委会的人来清除狂厄污染的时候发生了冲突，一枚燃烧弹击中了她的房间。","voice":["vo_trial_40302_1_41"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302041,"trial_step":41},{"step":42,"speaker":"橡木匣","content":"火烧了三个小时才被扑灭，娜莎的家人叫我去帮忙寻找废墟里的遗骸。我到那里的时候到处都是焦炭和焚烧后的灰。","voice":["vo_trial_40302_1_42"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302042,"trial_step":42},{"step":43,"speaker":"橡木匣","content":"大火吞噬了那栋居民楼，我听见哭喊声，大人的，小孩的。救火的人被挡在街区外。等他们进来的时候，火苗已经烧到了屋顶。","voice":["vo_trial_40302_1_43"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302043,"trial_step":43},{"step":44,"content":"你似乎在橡木匣的描述中见到了那场火。天空都被染成了红色，火舌连着晚霞，好像有鲜红色的鸟雀正挣扎着想要努力逃离。","style":3,"background":917,"log_type":1,"src_id":140302044,"trial_step":44},{"step":45,"content":"在娜莎的墓碑不远处，有一片严重损毁的碑群，你在那里停下脚步，发现离你最近的一块墓碑已经被炸得只剩一点断石桩，地表也被破坏了，露出浅浅埋在土里的半个药瓶。","style":3,"background":917,"log_type":1,"src_id":140302045,"trial_step":45},{"step":46,"content":"玻璃瓶身已经碎了一半，亮晶晶的纽扣和碎玻璃混杂，撒了一地。","style":3,"background":917,"log_type":1,"src_id":140302046,"trial_step":46},{"step":47,"content":"这是什么？","style":2,"background":917,"log_type":1,"src_id":140302047,"trial_step":47},{"step":48,"speaker":"橡木匣","content":"星星。","voice":["vo_trial_40302_1_48"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302048,"trial_step":48},{"step":49,"content":"你没有出声，静静等待橡木匣的讲述。","style":3,"background":917,"log_type":1,"src_id":140302049,"trial_step":49},{"step":50,"speaker":"橡木匣","content":"他叫湖玛尔。他从小被人欺负，因为他的头发和皮肤都是白色的——他妈妈把他生在地下室里，常年不见阳光。","voice":["vo_trial_40302_1_50"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302050,"trial_step":50},{"step":51,"speaker":"橡木匣","content":"他听人说，妈妈去了有星星的地方，他开始收集这些“星星”。后来又有人告诉他，流民寨很高，晚上有很多星星，天气好的时候，你甚至可以摸到它们，他就来了。来的时候八岁，抱着他唯一的家当。","voice":["vo_trial_40302_1_51"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302051,"trial_step":51},{"step":52,"content":"她捡起那个瓶子，小心翼翼地把那些纽扣盛放进残存的半边瓶身中。","style":3,"background":917,"log_type":1,"src_id":140302052,"trial_step":52},{"step":53,"content":"这么多纽扣，他一定收集了很久。","style":2,"background":917,"log_type":1,"src_id":140302053,"trial_step":53},{"step":54,"speaker":"橡木匣","content":"我为他收集过一些，但他不要，只要他自己收集到的。","voice":["vo_trial_40302_1_54"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302054,"trial_step":54},{"step":55,"speaker":"橡木匣","content":"我还记得他那时候的表情，又喜欢那些纽扣，又不能够收下……眼睛瞪得很圆，很有趣。","voice":["vo_trial_40302_1_55"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302055,"trial_step":55},{"step":56,"speaker":"橡木匣","content":"他问我，从哪里得到了那么多的“星星”，我就带他去了我收集纽扣的地方。那是修道院停放尸体的房间。","voice":["vo_trial_40302_1_56"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302056,"trial_step":56},{"step":57,"content":"后来呢？","style":2,"background":917,"log_type":1,"src_id":140302057,"trial_step":57},{"step":58,"speaker":"橡木匣","content":"后来，他成了我的玩伴。","voice":["vo_trial_40302_1_58"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302058,"trial_step":58},{"step":59,"speaker":"橡木匣","content":"我小时候经常一个人跑去停尸房待着，那是修道院最清净的地方。我把他带到房间，以为会吓跑他……","voice":["vo_trial_40302_1_59"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302059,"trial_step":59},{"step":60,"speaker":"橡木匣","content":"但他只是很羡慕我，羡慕我能一个人拥有这么大的房间……哎呀。","voice":["vo_trial_40302_1_60"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302060,"trial_step":60},{"step":61,"content":"橡木匣轻呼一声，你走上前，帮着橡木匣扶正了玻璃瓶，接住那些差点洒出来的星星。","style":3,"background":917,"log_type":1,"src_id":140302061,"trial_step":61},{"step":62,"content":"橡木匣的目光从玻璃瓶离开，转向你，玻璃瓶的光反射在她的瞳孔中，她看向你的目光带了些温度。","style":3,"background":917,"log_type":1,"src_id":140302062,"trial_step":62},{"step":63,"speaker":"橡木匣","content":"某一天晚上，他又出现在停尸房里了，不过……是面目全非的样子。","voice":["vo_trial_40302_1_63"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302063,"trial_step":63},{"step":64,"speaker":"橡木匣","content":"他被人骗着爬上辛迪加的高楼，想要摘星星，结果摔了下去。","voice":["vo_trial_40302_1_64"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302064,"trial_step":64},{"step":65,"speaker":"橡木匣","content":"到最后的执念，不过是这么一瓶纽扣。","voice":["vo_trial_40302_1_65"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302065,"trial_step":65},{"step":66,"content":"橡木匣站起来，走进那片残破的碑群。","style":3,"background":917,"log_type":1,"src_id":140302066,"trial_step":66},{"step":67,"speaker":"橡木匣","content":"这附近埋葬的大多数都是修道院的人……这些人，都是因为活人才永远沉睡在了这里。","voice":["vo_trial_40302_1_67"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302067,"trial_step":67},{"step":68,"speaker":"橡木匣","content":"你看，亡者不会伤害你，活人才会。","voice":["vo_trial_40302_1_68"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302068,"trial_step":68},{"step":69,"content":"她的语气很平静，仿佛只是在阐述一个客观的事实。","style":3,"background":917,"log_type":1,"src_id":140302069,"trial_step":69},{"step":70,"content":"你很想反驳她说不是的，活人也有很多值得信赖的好人。但也许是因为碑林的风过于寂静，你一时间竟然不知道如何开口。","style":3,"background":917,"log_type":1,"src_id":140302070,"trial_step":70},{"step":71,"content":"你们安静地前行了一段路。直到，橡木匣在一块有些破旧的墓碑前停下了脚步，她久久地凝视着那块碑，没有说话。","style":3,"background":917,"log_type":1,"src_id":140302071,"trial_step":71},{"step":72,"content":"这是谁的墓碑？","style":2,"background":917,"log_type":1,"src_id":140302072,"trial_step":72},{"step":73,"speaker":"橡木匣","content":"我不知道。","voice":["vo_trial_40302_1_73"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302073,"trial_step":73},{"step":74,"speaker":"橡木匣","content":"但这上面残留着的……就是那个我无法解开的执念。","voice":["vo_trial_40302_1_74"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302074,"trial_step":74},{"step":75,"speaker":"橡木匣","content":"我为各种各样离去的人了却他们的执念。意外离世的人，看不到希望选择自己离开的人……","voice":["vo_trial_40302_1_75"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302075,"trial_step":75},{"step":76,"speaker":"橡木匣","content":"只有这块墓碑下的人，我一直没有能真正明白她给我传递的信息。","voice":["vo_trial_40302_1_76"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302076,"trial_step":76},{"step":77,"content":"你向橡木匣伸出手。","style":3,"background":917,"log_type":1,"src_id":140302077,"trial_step":77},{"step":78,"speaker":"橡木匣","content":"恐怕很难，她留下的信息不多。","voice":["vo_trial_40302_1_78"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302078,"trial_step":78},{"step":79,"content":"在罗马内斯克会堂的橡木匣，比在审查室温和许多。","style":3,"background":917,"log_type":1,"src_id":140302079,"trial_step":79},{"step":80,"content":"试一试。","style":2,"background":917,"log_type":1,"src_id":140302080,"trial_step":80},{"step":81,"content":"这次是两个人，总能多听到一些的。","style":2,"background":917,"log_type":1,"src_id":140302081,"trial_step":81},{"step":82,"content":"她看向你的眼睛，似乎在透过你看什么你不知道的事情，最终，她摘下了手套，捂住你的眼睛。","style":3,"background":917,"log_type":1,"src_id":140302082,"trial_step":82},{"step":83,"content":"橡木匣掌心的冰凉仍残留在你的眼睛上，眼前是一片空白。","style":3,"background":10006,"log_type":1,"src_id":140302085,"trial_step":85},{"step":84,"content":"逐渐，有暖光泛起，驱散眼底的凉意。","style":3,"background":10006,"log_type":1,"src_id":140302086,"trial_step":86},{"step":85,"content":"你发现自己身处在一片草地上，阳光和煦，是大好的晴日。","style":3,"background":905,"log_type":1,"src_id":140302088,"trial_step":88},{"step":86,"content":"也许是因为石碑经过的时间实在是太长了，你看不清画面的内容，只能隐约看见一个女孩树下念诵。","style":3,"background":905,"log_type":1,"src_id":140302089,"trial_step":89},{"step":87,"content":"她的声音很轻盈，你听不清她在念什么，转头看橡木匣，她也在努力听着。","style":3,"background":905,"log_type":1,"src_id":140302090,"trial_step":90},{"step":88,"content":"她在念什么？","style":2,"background":905,"log_type":1,"src_id":140302091,"trial_step":91},{"step":89,"content":"橡木匣没有接话。","style":3,"background":905,"log_type":1,"src_id":140302092,"trial_step":92},{"step":90,"content":"这时，一个成年人体型的人走了过来，陪着女孩一起念。","style":3,"background":905,"log_type":1,"src_id":140302093,"trial_step":93},{"step":91,"content":"平和温暖的声音，像歌一样随着阳光飘忽在空气中，女孩身上的光芒越来越亮。","style":3,"background":905,"log_type":1,"src_id":140302094,"trial_step":94},{"step":92,"speaker":"？？？","content":"苦厄……行者……光……","voice":["vo_trial_40302_1_95"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140302095,"trial_step":95},{"step":93,"content":"这些字眼，你隐隐约约觉得有些耳熟。","style":3,"background":905,"log_type":1,"src_id":140302096,"trial_step":96},{"step":94,"content":"你想要听得更清楚一些，于是用尽全力想要走上前，却踏进了一片白光之中。","style":3,"background":10006,"log_type":1,"src_id":140302097,"trial_step":97},{"step":95,"content":"你们回到了纪念碑前。","style":3,"background":917,"log_type":1,"src_id":140302098,"trial_step":98},{"step":96,"content":"枷锁的链接仍残留着，你几乎在回来的瞬间，就感受到了从橡木匣那端传来的压抑情绪。","style":3,"background":917,"log_type":1,"src_id":140302099,"trial_step":99},{"step":97,"content":"为什么？方才的阳光分明那么温暖。","style":3,"background":917,"log_type":1,"src_id":140302100,"trial_step":100},{"step":98,"content":"这次看到的信息，与你之前看到的一样吗？","style":2,"background":917,"log_type":1,"src_id":140302101,"trial_step":101},{"step":99,"speaker":"橡木匣","content":"……","voice":["vo_trial_40302_1_102"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302102,"trial_step":102},{"step":100,"content":"来之前，我们定下过约定，你要尽力协助我。","style":2,"background":917,"log_type":1,"src_id":140302103,"trial_step":103},{"step":101,"speaker":"橡木匣","content":"……这次，我能听见她念诵的声音。","voice":["vo_trial_40302_1_104"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302104,"trial_step":104},{"step":102,"content":"你感受着枷锁传来的情绪，引导着橡木匣。","style":3,"background":917,"log_type":1,"src_id":140302105,"trial_step":105},{"step":103,"content":"她念诵的那首诗，我只听见了几个字词，但我肯定在哪里听过。","style":2,"background":917,"log_type":1,"src_id":140302106,"trial_step":106},{"step":104,"content":"你有印象吗？","style":2,"background":917,"log_type":1,"src_id":140302107,"trial_step":107},{"step":105,"content":"橡木匣再次陷入沉默，可通过枷锁，你感受到了她此刻的情绪——或是不屑，或是愤怒，或者……是悲伤。","style":3,"background":917,"log_type":1,"src_id":140302108,"trial_step":108},{"step":106,"speaker":"橡木匣","content":"愚蠢又卑劣的诗……","voice":["vo_trial_40302_1_109"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302109,"trial_step":109},{"step":107,"speaker":"橡木匣","content":"我已经忘记了。","voice":["vo_trial_40302_1_110"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302110,"trial_step":110},{"step":108,"speaker":"橡木匣","content":"需要我回想起来吗，局长？","voice":["vo_trial_40302_1_111"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302111,"trial_step":111},{"step":109,"content":"她的语气有些恶劣，但你总觉得，她的悲伤比愤怒更多一些。","style":3,"background":917,"log_type":1,"src_id":140302112,"trial_step":112},{"step":110,"content":"你不想让她陷在这样的痛苦里，微微摇头。","style":3,"background":917,"log_type":1,"src_id":140302113,"trial_step":113},{"step":111,"content":"你就这样与橡木匣并肩站了一会儿，直到枷锁那端的情绪平复。","style":3,"background":917,"log_type":1,"src_id":140302114,"trial_step":114},{"step":112,"content":"你曾说过，这一片沉睡的都是与修道院有关的人。","style":2,"background":917,"log_type":1,"src_id":140302115,"trial_step":115},{"step":113,"content":"还有修道院的其他人活着吗？或者和修道院有关的人，他们也许知道一些什么。","style":2,"background":917,"log_type":1,"src_id":140302116,"trial_step":116},{"step":114,"content":"——如果，让你想起来会让你痛苦的话，就让我来找出这些答案吧。","style":2,"background":917,"log_type":1,"src_id":140302117,"trial_step":117},{"step":115,"content":"沉默片刻，橡木匣还是开口回答了你。","style":3,"background":917,"log_type":1,"src_id":140302118,"trial_step":118},{"step":116,"speaker":"橡木匣","content":"有个和修道院关系很近的医生……但我不确定他是否还活着。","voice":["vo_trial_40302_1_119"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140302119,"trial_step":119},{"step":117,"content":"不要紧，我们先去找找看。","style":2,"background":917,"log_type":1,"src_id":140302120,"trial_step":120},{"step":118,"content":"离开碑林前，你回头看了一眼，曾经生长橡树的那块土地空空荡荡。","style":3,"background":917,"log_type":1,"src_id":140302121,"trial_step":121},{"step":119,"content":"碑林里依旧一丝风也没有，墓碑的颜色是灰的，那些被封在玻璃罐子里的星星也是灰的。","style":3,"background":917,"log_type":1,"src_id":140302122,"trial_step":122}]}