{"id":1120303,"chapter_id":1120303,"scene_id":1,"steps":[{"step":1,"content":"商场的落地镜前，帕加茜看着镜子里的自己，有些局促地开口——","style":3,"background":1016,"log_type":2,"src_id":220303001,"trial_step":1},{"step":2,"speaker":"帕加茜","content":"这件外套……","style":1,"background":1016,"log_type":1,"src_id":220303002,"trial_step":2},{"step":3,"speaker":"帕加茜","content":"会影响我的活动。而且，太薄了……","style":1,"background":1016,"log_type":1,"src_id":220303003,"trial_step":3},{"step":4,"options":["但是很好看","该买点新衣服了"],"style":6,"background":1016,"log_type":1,"src_id":220303004,"trial_step":4,"course":3,"choices":[{"text":"但是很好看","goto":5},{"text":"该买点新衣服了","goto":9}]},{"step":5,"speaker":"帕加茜","content":"……","style":1,"background":1016,"log_type":1,"src_id":220303005,"trial_step":5},{"step":6,"speaker":"帕加茜","content":"谢谢……","style":1,"background":1016,"log_type":1,"src_id":220303006,"trial_step":6},{"step":7,"speaker":"帕加茜","content":"可……","style":1,"background":1016,"log_type":1,"src_id":220303007,"trial_step":7},{"step":8,"content":"你也该添几套夏装了，总是穿那么厚不太好。","style":2,"background":1016,"log_type":1,"src_id":220303008,"trial_step":8,"next":[13]},{"step":9,"speaker":"帕加茜","content":"我不怎么怕热……","style":1,"background":1016,"log_type":1,"src_id":220303009,"trial_step":9},{"step":10,"content":"要不然试试别的？","style":2,"background":1016,"log_type":1,"src_id":220303010,"trial_step":10},{"step":11,"speaker":"帕加茜","content":"……","style":1,"background":1016,"log_type":1,"src_id":220303011,"trial_step":11},{"step":12,"content":"在这新城最繁华的商业步行街，被你强行拉出来逛街的帕加茜面对令人眼花缭乱的商品，表现出了明显的不适应。","style":3,"background":1016,"log_type":1,"src_id":220303012,"trial_step":12,"next":[13]},{"step":13,"speaker":"帕加茜","content":"我觉得……很不习惯。","style":1,"background":1016,"log_type":1,"src_id":220303013,"trial_step":13},{"step":14,"content":"你需要放松。","style":2,"background":1016,"log_type":1,"src_id":220303014,"trial_step":14},{"step":15,"speaker":"帕加茜","content":"管理局的生活，已经很轻松了。","style":1,"background":1016,"log_type":1,"src_id":220303015,"trial_step":15},{"step":16,"content":"帕加茜一边说着，一边看着来来往往的行人与车辆，有些畏缩地向后退了两步。","style":3,"background":1016,"log_type":1,"src_id":220303016,"trial_step":16},{"step":17,"content":"既然你不喜欢这些，我们不如去别的地方看看？","style":2,"background":1016,"log_type":1,"src_id":220303017,"trial_step":17},{"step":18,"speaker":"帕加茜","content":"……我没有什么想去的地方。","style":1,"background":1016,"log_type":1,"src_id":220303018,"trial_step":18},{"step":19,"options":["有个地方你一定会感兴趣"],"style":6,"background":1016,"log_type":1,"src_id":220303019,"trial_step":19,"course":3,"choices":[{"text":"有个地方你一定会感兴趣","goto":20}]},{"step":20,"content":"……","style":1,"background":1016,"log_type":1,"src_id":220303020,"trial_step":20},{"step":21,"content":"看得出来，帕加茜有些无奈。","style":3,"background":1016,"log_type":1,"src_id":220303021,"trial_step":21},{"step":22,"content":"你拉着帕加茜走在花园街道上。今天的天气不错，阳光透过树叶的缝隙照在地上。","style":3,"background":1016,"log_type":1,"src_id":220303022,"trial_step":22},{"step":23,"content":"穿过长长的步行道，巨幅的广告牌出现在你们的眼前。","style":3,"background":1016,"log_type":1,"src_id":220303023,"trial_step":23},{"step":24,"speaker":"帕加茜","content":"这是……娜思嘉？","style":1,"background":1016,"log_type":1,"src_id":220303024,"trial_step":24},{"step":25,"content":"广告牌上，一位老迈的女士被孩子包围着，露出了真诚的笑容。","style":3,"background":1016,"log_type":1,"src_id":220303025,"trial_step":25},{"step":26,"content":"你还记得她的样子？她离开马耶克的时候你还很小吧？","style":2,"background":1016,"log_type":1,"src_id":220303026,"trial_step":26},{"step":27,"speaker":"帕加茜","content":"嗯，我记得。","style":1,"background":1016,"log_type":1,"src_id":220303027,"trial_step":27},{"step":28,"options":["要不要去看看她？"],"style":6,"background":1016,"log_type":1,"src_id":220303028,"trial_step":28,"course":3,"choices":[{"text":"要不要去看看她？","goto":29}]},{"step":29,"content":"上面说她现在是这所语言学校的明星导师，看上去过得不错。","style":2,"background":1016,"log_type":1,"src_id":220303029,"trial_step":29},{"step":30,"content":"一起去看看她？","style":2,"background":1016,"log_type":1,"src_id":220303030,"trial_step":30},{"step":31,"speaker":"帕加茜","content":"不必了。","style":1,"background":1016,"log_type":1,"src_id":220303031,"trial_step":31},{"step":32,"speaker":"帕加茜","content":"她未必认得出我。就算可以，看见我也只会想起不好的回忆。","style":1,"background":1016,"log_type":1,"src_id":220303032,"trial_step":32},{"step":33,"content":"你没有再说什么。绕过街角，你们来到了一家餐厅门前。","style":3,"background":1016,"log_type":1,"src_id":220303033,"trial_step":33},{"step":34,"content":"就是这里。","style":2,"background":1016,"log_type":1,"src_id":220303034,"trial_step":34},{"step":35,"speaker":"帕加茜","content":"我说过的，我不需要进食。","style":1,"background":1016,"log_type":1,"src_id":220303035,"trial_step":35},{"step":36,"content":"这家的红菜汤风评相当不错，不试试吗？","style":2,"background":1016,"log_type":1,"src_id":220303036,"trial_step":36},{"step":37,"speaker":"帕加茜","content":"……","style":1,"background":1016,"log_type":1,"src_id":220303037,"trial_step":37},{"step":38,"speaker":"帕加茜","content":"那试试吧。","style":1,"background":1016,"log_type":1,"src_id":220303038,"trial_step":38},{"step":39,"content":"帕加茜用很低的声音回应，你握住她的手走了进去。","style":3,"background":1016,"log_type":1,"src_id":220303039,"trial_step":39},{"step":40,"content":"餐厅的生意不错，里面人很多。幸亏你提前预定，服务员将你们领到了位置上。","style":3,"background":1005,"log_type":1,"src_id":220303040,"trial_step":40},{"step":41,"content":"落座之后，帕加茜快速翻看着菜单，在其中一页停了下来。","style":3,"background":1005,"log_type":1,"src_id":220303041,"trial_step":41},{"step":42,"speaker":"帕加茜","content":"红……罗宋汤和面包。","style":1,"background":1005,"log_type":1,"src_id":220303042,"trial_step":42},{"step":43,"speaker":"服务生","content":"就这些吗？小姐。","style":1,"background":1005,"log_type":1,"src_id":220303043,"trial_step":43},{"step":44,"content":"看着一边服务生有些尴尬的笑容，你叹了口气，接过了菜单。","style":3,"background":1005,"log_type":1,"src_id":220303044,"trial_step":44},{"step":45,"content":"有什么推荐的吗？","style":2,"background":1005,"log_type":1,"src_id":220303045,"trial_step":45},{"step":46,"speaker":"服务生","content":"二位，我衷心推荐本店的草莓芭菲。","style":1,"background":1005,"log_type":1,"src_id":220303046,"trial_step":46},{"step":47,"speaker":"帕加茜","content":"芭菲是……冰淇淋吧？","style":1,"background":1005,"log_type":1,"src_id":220303047,"trial_step":47},{"step":48,"speaker":"服务生","content":"没错。","style":1,"background":1005,"log_type":1,"src_id":220303048,"trial_step":48},{"step":49,"speaker":"帕加茜","content":"我不用了。","style":1,"background":1005,"log_type":1,"src_id":220303049,"trial_step":49},{"step":50,"content":"最终还是你做主多点了几道菜。点完餐之后，服务生匆匆前往后厨。","style":3,"background":1005,"log_type":1,"src_id":220303050,"trial_step":50},{"step":51,"content":"中午的餐馆人满为患。好在出餐速度很快。没过多久，几道菜品就依次被端上了桌。","style":3,"background":1005,"log_type":1,"src_id":220303051,"trial_step":51},{"step":52,"content":"帕加茜用手将面包掰成小块，用碗中的汤充分浸润，再放入口中——这是在狄斯城很少看得到的吃法。","style":3,"background":1005,"log_type":1,"src_id":220303052,"trial_step":52},{"step":53,"content":"怎么样？合你胃口吗？","style":2,"background":1005,"log_type":1,"src_id":220303053,"trial_step":53},{"step":54,"speaker":"帕加茜","content":"嗯。","style":1,"background":1005,"log_type":1,"src_id":220303054,"trial_step":54},{"step":55,"content":"是不是很熟悉。","style":2,"background":1005,"log_type":1,"src_id":220303055,"trial_step":55},{"step":56,"speaker":"帕加茜","content":"……唔嗯。","style":1,"background":1005,"log_type":1,"src_id":220303056,"trial_step":56},{"step":57,"content":"帕加茜点了点头。","style":3,"background":1005,"log_type":1,"src_id":220303057,"trial_step":57},{"step":58,"content":"这家店是勒华开的。","style":2,"background":1005,"log_type":1,"src_id":220303058,"trial_step":58},{"step":59,"content":"帕加茜放下餐具，瞪大了眼睛。","style":3,"background":1005,"log_type":1,"src_id":220303059,"trial_step":59},{"step":60,"content":"看着周围满满的顾客，帕加茜有些欣慰地笑了。","style":3,"background":1005,"log_type":1,"src_id":220303060,"trial_step":60},{"step":61,"speaker":"帕加茜","content":"看来他现在过得很好。","style":1,"background":1005,"log_type":1,"src_id":220303061,"trial_step":61},{"step":62,"content":"是啊，他们过得很好。","style":1,"background":1005,"log_type":1,"src_id":220303062,"trial_step":62},{"step":63,"content":"你还都记得吗，这些人？","style":2,"background":1005,"log_type":1,"src_id":220303063,"trial_step":63},{"step":64,"content":"你从怀中拿出一张合照。","style":3,"background":1005,"log_type":1,"src_id":220303064,"trial_step":64},{"step":65,"speaker":"帕加茜","content":"这是……波利斯？多利娅、娜思嘉……勒华？他们为什么会在一起？","style":1,"background":1005,"log_type":1,"src_id":220303065,"trial_step":65},{"step":66,"content":"马耶克人在狄斯城开始了各自的新生活。","style":2,"background":1005,"log_type":1,"src_id":220303066,"trial_step":66},{"step":67,"content":"他们还组成了一个互助会。前些日子我和他们见过面——他们很乐意接纳你。","style":2,"background":1005,"log_type":1,"src_id":220303067,"trial_step":67},{"step":68,"speaker":"帕加茜","content":"我……是禁闭者。","style":1,"background":1005,"log_type":1,"src_id":220303068,"trial_step":68},{"step":69,"speaker":"帕加茜","content":"他们帮不了我，我也帮不了他们。","style":1,"background":1005,"log_type":1,"src_id":220303069,"trial_step":69},{"step":70,"options":["你不该这么抗拒","尊重帕加茜的选择"],"style":6,"background":1005,"log_type":1,"src_id":220303070,"trial_step":70,"course":3,"choices":[{"text":"你不该这么抗拒","goto":71},{"text":"尊重帕加茜的选择","goto":73}]},{"step":71,"content":"你该试试的，或许他们可以帮助你摆脱过去……","style":2,"background":1005,"log_type":1,"src_id":220303071,"trial_step":71},{"step":72,"speaker":"帕加茜","content":"……我没有这个资格。","style":1,"background":1005,"log_type":1,"src_id":220303072,"trial_step":72,"next":[73]},{"step":73,"content":"气氛变得有些沉默。帕加茜快速喝了完眼前的汤。","style":3,"background":1005,"log_type":1,"src_id":220303073,"trial_step":73},{"step":74,"speaker":"帕加茜","content":"我们走吧。","style":1,"background":1005,"log_type":1,"src_id":220303074,"trial_step":74},{"step":75,"content":"别急，我们还有一整个下午呢。","style":2,"background":1005,"log_type":1,"src_id":220303075,"trial_step":75},{"step":76,"speaker":"帕加茜","content":"还要去……哪里。","style":1,"background":1005,"log_type":1,"src_id":220303076,"trial_step":76},{"step":77,"content":"帕加茜的声音有些无奈，但同样暗含着期待。","style":3,"background":1005,"log_type":1,"src_id":220303077,"trial_step":77},{"step":78,"options":["这次你一定会满意的"],"style":6,"background":1005,"log_type":1,"src_id":220303078,"trial_step":78,"course":3,"choices":[{"text":"这次你一定会满意的","goto":79}]},{"step":79,"content":"你们来到一栋灰色的建筑前。这里似乎还在装修，你冲着门口的管理局工作人员招招手。","style":3,"background":1016,"log_type":1,"src_id":220303079,"trial_step":79},{"step":80,"content":"进度怎么样？","style":2,"background":1016,"log_type":1,"src_id":220303080,"trial_step":80},{"step":81,"speaker":"工作人员","content":"一切顺利！最晚下周就可以参观了。","style":1,"background":1016,"log_type":1,"src_id":220303081,"trial_step":81},{"step":82,"content":"地产合同呢？","style":2,"background":1016,"log_type":1,"src_id":220303082,"trial_step":82},{"step":83,"speaker":"工作人员","content":"没问题的，我们找到了原始合同，FAC当初分配资产时没有规定我们一定要用作仓库。","style":1,"background":1016,"log_type":1,"src_id":220303083,"trial_step":83},{"step":84,"speaker":"工作人员","content":"哪怕把这里改造成夜店都没关系，都是管理局的产业。","style":1,"background":1016,"log_type":1,"src_id":220303084,"trial_step":84},{"step":85,"content":"一侧的卡车上还在陆续卸着货，工人们小心翼翼地搬运着老旧的设备。","style":3,"background":1016,"log_type":1,"src_id":220303085,"trial_step":85},{"step":86,"speaker":"帕加茜","content":"……这是？","style":1,"background":1016,"log_type":1,"src_id":220303086,"trial_step":86},{"step":87,"speaker":"帕加茜","content":"入夜前马耶克镇的温泉输水管道？","style":1,"background":1016,"log_type":1,"src_id":220303087,"trial_step":87},{"step":88,"speaker":"帕加茜","content":"你们……去了马耶克？","style":1,"background":1016,"log_type":1,"src_id":220303088,"trial_step":88},{"step":89,"options":["点点头","不回答"],"style":6,"background":1016,"log_type":1,"src_id":220303089,"trial_step":89,"next":[90,90]},{"step":90,"content":"你笑了笑，没有直接回答帕加茜的问题。","style":3,"background":1016,"log_type":1,"src_id":220303090,"trial_step":90},{"step":91,"content":"里面还有更多东西呢，我们进去看看吧。","style":2,"background":1016,"log_type":1,"src_id":220303091,"trial_step":91},{"step":92,"content":"走进建筑内，不算大的空间被分割为几块，每个区域都放置了不少“展品”。","style":3,"background":3002,"log_type":1,"src_id":220303092,"trial_step":92},{"step":93,"speaker":"帕加茜","content":"堆芯、控制杆、连广播台也是。","style":1,"background":3002,"log_type":1,"src_id":220303093,"trial_step":93},{"step":94,"speaker":"帕加茜","content":"居然都在这里……","style":1,"background":3002,"log_type":1,"src_id":220303094,"trial_step":94},{"step":95,"content":"帕加茜如数家珍般叫着这些“废品”的名字。","style":3,"background":3002,"log_type":1,"src_id":220303095,"trial_step":95},{"step":96,"content":"你在马耶克的回忆，我都搬到这里了。","style":2,"background":3002,"log_type":1,"src_id":220303096,"trial_step":96},{"step":97,"speaker":"帕加茜","content":"我……","style":1,"background":3002,"log_type":1,"src_id":220303097,"trial_step":97},{"step":98,"content":"帕加茜的声音颤抖着，她后退几步，躲进了阴影里。","style":3,"background":3002,"log_type":1,"src_id":220303098,"trial_step":98},{"step":99,"speaker":"帕加茜","content":"……请不要在我身上浪费时间了。","style":1,"background":3002,"log_type":1,"src_id":220303099,"trial_step":99},{"step":100,"content":"怎么会是浪费时间呢？","style":2,"background":3002,"log_type":1,"src_id":220303100,"trial_step":100},{"step":101,"content":"帕加茜揪着衣角，没有说话。","style":3,"background":3002,"log_type":1,"src_id":220303101,"trial_step":101},{"step":102,"content":"如果不是感觉到虚弱，你就不会吃东西。","style":2,"background":3002,"log_type":1,"src_id":220303102,"trial_step":102},{"step":103,"speaker":"帕加茜","content":"我不需要……","style":1,"background":3002,"log_type":1,"src_id":220303103,"trial_step":103},{"step":104,"content":"战斗的时候，不会休息，也从不考虑自己的安危。","style":2,"background":3002,"log_type":1,"src_id":220303104,"trial_step":104},{"step":105,"content":"你一直在帮助我，帮助着我们，一直在小心翼翼地为周围的人考虑。","style":2,"background":3002,"log_type":1,"src_id":220303105,"trial_step":105},{"step":106,"speaker":"帕加茜","content":"这是我应该做的。","style":1,"background":3002,"log_type":1,"src_id":220303106,"trial_step":106},{"step":107,"content":"明明你也有着喜欢的东西，明明也有着想要倾诉的事情……你没有罪，就算有，也早就赎清了。","style":2,"background":3002,"log_type":1,"src_id":220303107,"trial_step":107},{"step":108,"content":"你不用一直这么卑微的，偶尔，也去试着接受一下朋友的善意吧。","style":2,"background":3002,"log_type":1,"src_id":220303108,"trial_step":108},{"step":109,"content":"随着电源开关的声音回荡，温暖的黄色灯光照亮了整个大厅。","style":3,"background":3002,"log_type":1,"src_id":220303109,"trial_step":109},{"step":110,"content":"让我为你正式介绍一下——","style":2,"background":3002,"log_type":1,"src_id":220303110,"trial_step":110},{"step":111,"content":"你从口袋中取出一张纸，阅读起上面的文字。","style":3,"background":3002,"log_type":1,"src_id":220303111,"trial_step":111},{"step":112,"content":"欢迎来到大陆最北端的，不使用异方晶，仅凭被尘封的核技术和坚强的意志就与天灾抗争了足足百年的土地。","style":2,"background":3002,"log_type":1,"src_id":220303112,"trial_step":112},{"step":113,"content":"它或许已经逝去，但它的故事和人民永存。","style":2,"background":3002,"log_type":1,"src_id":220303113,"trial_step":113},{"step":114,"content":"这里是马耶克博物馆，请与我一同见证，那座英雄的城市……","style":2,"background":3002,"log_type":1,"src_id":220303114,"trial_step":114},{"step":115,"content":"你再次转身，朝着帕加茜伸出手。","style":3,"background":3002,"log_type":1,"src_id":220303115,"trial_step":115},{"step":116,"content":"喜欢这个开场词吗，它会被刻在博物馆门口。","style":2,"background":3002,"log_type":1,"src_id":220303116,"trial_step":116},{"step":117,"content":"帕加茜缓缓向前，走出了阴影。","style":3,"background":3002,"log_type":1,"src_id":220303117,"trial_step":117},{"step":118,"speaker":"帕加茜","content":"谢谢。","style":1,"background":3002,"log_type":1,"src_id":220303118,"trial_step":118},{"step":119,"content":"她的眼角闪耀着泪水，嘴角却止不住上扬。","style":3,"background":3002,"log_type":1,"src_id":220303119,"trial_step":119},{"step":120,"speaker":"帕加茜","content":"我很喜欢……","style":1,"background":3002,"log_type":1,"src_id":220303120,"trial_step":120}]}