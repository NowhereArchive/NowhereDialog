{"id":404320801,"chapter_id":50088,"scene_id":58872,"steps":[{"step":1,"speaker":"海伦娜","content":"呀——！！","voice":["vo_event_404320801_01"],"voice_bank":"vo_event_43208","style":1,"background":2174,"log_type":1},{"step":2,"content":"海伦娜发出一声尖叫，身体失去平衡，重重摔倒在地。","style":3,"background":2174,"log_type":1},{"step":3,"speaker":"局长","content":"海伦娜！","style":2,"background":2174,"log_type":1},{"step":4,"content":"你迅速俯身，扶住了她。","style":3,"background":2174,"log_type":1},{"step":5,"speaker":"海伦娜","content":"我的、我的脚……好痛，好痛啊。","voice":["vo_event_404320801_05"],"voice_bank":"vo_event_43208","style":1,"background":2174,"log_type":1},{"step":6,"content":"你一抬头，看到你俩已经掉队，而身后，震动与浓烟越来越近，火光映照出一片混乱。","style":3,"background":2174,"log_type":1},{"step":7,"speaker":"守卫","content":"喂，你们没事吧！","voice":["vo_event_404320801_07"],"voice_bank":"vo_event_43208","style":1,"background":2174,"log_type":1},{"step":8,"content":"浓烟中，守卫似乎要回过头来寻找你们，你心一横，扛起海伦娜冲进了一旁的房间当中。","style":3,"background":2174,"log_type":1},{"step":9,"content":"【拷问室】","style":18,"background":2505,"log_type":1},{"step":10,"speaker":"海伦娜","content":"怎……怎么回事……为什么我们要到这里来？","voice":["vo_event_404320801_10"],"voice_bank":"vo_event_43208","style":1,"background":2505,"log_type":1},{"step":11,"speaker":"局长","content":"这里相对安全，可以躲一会儿。","style":2,"background":2505,"log_type":1},{"step":12,"content":"你让她坐到了拷问椅上，海伦娜的脚肿得像个馒头，根本无法自行移动。","style":3,"background":2505,"log_type":1},{"step":13,"content":"但还不够，你开始给她的双手也缠上束缚带。","style":3,"background":2505,"log_type":1},{"step":14,"speaker":"海伦娜","content":"${PlayerName}长官……难道要在这个时候审我？我做了什么引你怀疑的事了吗？","voice":["vo_event_404320801_15"],"voice_bank":"vo_event_43208","style":1,"background":2505,"log_type":1},{"step":15,"content":"她看着你，逐渐噙满了眼泪。","style":3,"background":2505,"log_type":1},{"step":16,"speaker":"海伦娜","content":"还是说，你想要那封信？","voice":["vo_event_404320801_17"],"voice_bank":"vo_event_43208","style":1,"background":2505,"log_type":1},{"step":17,"speaker":"海伦娜","content":"拿到信之后你会怎么做？杀了我？","voice":["vo_event_404320801_18"],"voice_bank":"vo_event_43208","style":1,"background":2505,"log_type":1},{"step":18,"speaker":"局长","content":"………………","style":2,"background":2505,"log_type":1},{"step":19,"content":"她的眼泪让你一瞬间愣神。","style":3,"background":2505,"log_type":1},{"step":20,"content":"没错。你可以在这里审讯海伦娜，让她交出藏起来的信，有必要的话你还可以杀了她，以保证自己的秘密不被泄露出去。","style":3,"background":2505,"log_type":1},{"step":21,"content":"但……你能够做到吗？你真的是这样的人吗？","style":3,"background":2505,"log_type":1},{"step":22,"content":"就在你犹疑的刹那。","style":3,"background":2505,"log_type":1},{"step":23,"content":"（红光闪）","style":18,"background":2505,"log_type":1},{"step":24,"content":"噗嗤——！","style":3,"background":2505,"log_type":1},{"step":25,"content":"一道血光划过，你后知后觉地睁大了眼睛。","style":3,"background":2505,"log_type":1},{"step":26,"content":"四肢的力气被迅速抽离，眼前的一切开始旋转。","style":3,"background":2505,"log_type":1},{"step":27,"content":"你倒下的时候，看到海伦娜悠然地在椅子上换了个姿势。","style":3,"background":2505,"log_type":1},{"step":28,"content":"束缚带不知何时被她解开了，带着血迹的刀片与白色的信封如同变魔术般在她指尖旋转。","style":3,"background":2505,"log_type":1},{"step":29,"content":"（黑屏）","style":18,"background":10000,"log_type":1},{"step":30,"speaker":"海伦娜","content":"原想再多利用你一会儿，谁叫你自己不把握住呢？","voice":["vo_event_404320801_31"],"voice_bank":"vo_event_43208","style":1,"background":10000,"log_type":1},{"step":31,"speaker":"海伦娜","content":"答应我，不要小瞧“帽匠”的手指，好吗？","voice":["vo_event_404320801_32"],"voice_bank":"vo_event_43208","style":1,"background":10000,"log_type":1}]}