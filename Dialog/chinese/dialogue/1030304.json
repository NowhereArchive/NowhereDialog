{"id":1030304,"chapter_id":1030304,"scene_id":1,"steps":[{"step":1,"content":"目光所及的地方，都是茫茫无尽的白色，让人有些睁不开眼。","style":3,"background":10006,"log_type":1,"src_id":130304001,"trial_step":1},{"step":2,"content":"你尝试往前走去，可每踏一步，这个纯白的空间都会震动坍塌。","style":3,"background":10006,"log_type":1,"src_id":130304002,"trial_step":2},{"step":3,"speaker":"选项","options":["娜恰，回应我！"],"style":6,"background":10006,"log_type":1,"src_id":130304003,"trial_step":3,"course":3,"choices":[{"text":"娜恰，回应我！","goto":4}]},{"step":4,"content":"枷锁的另一头，还隐隐传来震动，你能感受到她还活着。","style":3,"background":10006,"log_type":1,"src_id":130304004,"trial_step":4},{"step":5,"content":"你也感受到，她在求救。","style":3,"background":10006,"log_type":1,"src_id":130304005,"trial_step":5},{"step":6,"speaker":"玩家","content":"要来不及了……","style":2,"background":10006,"log_type":1,"src_id":130304006,"trial_step":6},{"step":7,"speaker":"玩家","content":"不能让妙梦瓶吞噬掉自己！","style":2,"background":10006,"log_type":1,"src_id":130304007,"trial_step":7},{"step":8,"content":"你们解决掉了玛芙，但是妙梦瓶，玛芙的心脏，早就和娜恰融为了一体。","style":3,"background":10006,"log_type":1,"src_id":130304008,"trial_step":8},{"step":9,"content":"娜恰对快乐的偏执让这颗心脏牢牢地附着在她的梦境里，像一只寄生虫一样。","style":3,"background":10006,"log_type":1,"src_id":130304009,"trial_step":9},{"step":10,"content":"一旦停止供给，便会无休止地折磨宿主。","style":3,"background":10006,"log_type":1,"src_id":130304010,"trial_step":10},{"step":11,"speaker":"玩家","content":"该死……","style":2,"background":10006,"log_type":1,"src_id":130304011,"trial_step":11},{"step":12,"content":"你顾不了那么多了，起身往枷锁感应的方向跑去。","style":3,"background":10006,"log_type":1,"src_id":130304012,"trial_step":12},{"step":13,"content":"纯白的梦境不断坍塌，黑色的污泥像飞蛾一般朝你追来，直到你在前面，看到了娜恰。","style":3,"background":10005,"log_type":1,"src_id":130304013,"trial_step":13},{"step":14,"speaker":"玩家","content":"娜恰！醒醒！！","style":2,"background":10005,"log_type":1,"src_id":130304014,"trial_step":14},{"step":15,"speaker":"玩家","content":"不要陷进去！","style":2,"background":10005,"log_type":1,"src_id":130304015,"trial_step":15},{"step":16,"content":"咚咚——！","style":3,"background":10005,"log_type":1,"src_id":130304016,"trial_step":16},{"step":17,"content":"内脏剧烈地收缩，一阵猛烈的疼痛瞬间席卷全身。","style":3,"background":10005,"log_type":1,"src_id":130304017,"trial_step":17},{"step":18,"content":"而你看见娜恰也蜷缩起了身体，不住地叫喊。","style":3,"background":10005,"log_type":1,"src_id":130304018,"trial_step":18},{"step":19,"speaker":"娜恰","content":"不要……不要再吞噬了……","voice":["vo_trial_30304_1_1"],"voice_bank":"vo_snake_trial","style":1,"background":10005,"log_type":1,"src_id":130304019,"trial_step":19},{"step":20,"speaker":"娜恰","content":"所有的梦都会醒的，我已经……已经……没有快乐了……","voice":["vo_trial_30304_1_2"],"voice_bank":"vo_snake_trial","style":1,"background":10005,"log_type":1,"src_id":130304020,"trial_step":20},{"step":21,"speaker":"娜恰","content":"没有人能救我……我……","voice":["vo_trial_30304_1_3"],"voice_bank":"vo_snake_trial","style":1,"background":10005,"log_type":1,"src_id":130304021,"trial_step":21},{"step":22,"content":"最后一块白色脱落，纯白色的梦境变成了虚无一般的红与白。","style":3,"background":10005,"log_type":1,"src_id":130304022,"trial_step":22},{"step":23,"content":"娜恰猛地睁开眼睛，直勾勾地盯着你。","style":3,"background":110,"log_type":1,"src_id":130304023,"trial_step":23},{"step":24,"speaker":"娜恰","content":"我会被痛苦淹没的……","voice":["vo_trial_30304_1_4"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304024,"trial_step":24},{"step":25,"content":"话音刚落，无数黑泥铺天盖地将你淹没。","style":3,"background":110,"log_type":1,"src_id":130304025,"trial_step":25},{"step":26,"content":"它们钻进你的嘴里，耳朵里，让你无法呼吸。","style":3,"background":110,"log_type":1,"src_id":130304026,"trial_step":26},{"step":27,"content":"耳边呼啸着无数令人痛苦的声音——","style":3,"background":110,"log_type":1,"src_id":130304027,"trial_step":27},{"step":28,"speaker":"？？？","content":"“滚开，你这个怪物！”","voice":["vo_trial_30304_1_5"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304028,"trial_step":28},{"step":29,"speaker":"？？？","content":"“啊？你怎么还活着？”","voice":["vo_trial_30304_1_6"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304029,"trial_step":29},{"step":30,"speaker":"？？？","content":"“你只是一个赚钱的工具！“","voice":["vo_trial_30304_1_7"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304030,"trial_step":30},{"step":31,"speaker":"？？？","content":"“要是没有你就好了。”","voice":["vo_trial_30304_1_8"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304031,"trial_step":31},{"step":32,"speaker":"？？？","content":"“真恶心！！”","voice":["vo_trial_30304_1_9"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304032,"trial_step":32},{"step":33,"content":"你捂住自己的耳朵，闭上了眼睛。","style":3,"background":110,"log_type":1,"src_id":130304033,"trial_step":33},{"step":34,"content":"你强迫自己的腿动起来，拼命朝你所感应的跑去。","style":3,"background":110,"log_type":1,"src_id":130304034,"trial_step":34},{"step":35,"content":"一点，一点，你感觉到自己离她越来越近——在你即将触碰到她的一瞬间，她的背后，出现了那只巨大翅膀的怪物。","style":3,"background":110,"log_type":1,"src_id":130304035,"trial_step":35},{"step":36,"speaker":"娜恰","content":"你会……给我快乐吗？","voice":["vo_trial_30304_1_10"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304036,"trial_step":36},{"step":37,"speaker":"玩家","content":"醒过来！娜恰！","style":2,"background":110,"log_type":1,"src_id":130304038,"trial_step":38},{"step":38,"content":"红色的荆棘刺破无边的黑暗，它们一路延伸，像蛇一样缠绕在了那个女孩的身上。","style":3,"background":110,"log_type":1,"src_id":130304039,"trial_step":39},{"step":39,"speaker":"玩家","content":"别让玛芙和妙梦瓶控制你！","style":2,"background":110,"log_type":1,"src_id":130304040,"trial_step":40},{"step":40,"speaker":"娜恰","content":"局长……？","voice":["vo_trial_30304_1_11"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304041,"trial_step":41},{"step":41,"content":"周围 一切还住在尖声叫着，那个巨大的，黑色的玛芙，一次又一次地穿过娜恰，朝你攻击。","style":3,"background":110,"log_type":1,"src_id":130304042,"trial_step":42},{"step":42,"content":"它一边飞，一边叫嚣着快乐，叫嚣着痛苦，让娜恰感受它们的折磨。","style":3,"background":110,"log_type":1,"src_id":130304043,"trial_step":43},{"step":43,"speaker":"娜恰","content":"我……我好痛苦……","voice":["vo_trial_30304_1_12"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304044,"trial_step":44},{"step":44,"speaker":"娜恰","content":"我不要再这样了……","voice":["vo_trial_30304_1_13"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304045,"trial_step":45},{"step":45,"speaker":"娜恰","content":"你的快乐……给我吧！！","voice":["vo_trial_30304_1_14"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304046,"trial_step":46},{"step":46,"speaker":"玩家","content":"娜恰，我没有梦境，你在这里，得不到我的快乐。","style":2,"background":110,"log_type":1,"src_id":130304047,"trial_step":47},{"step":47,"speaker":"玩家","content":"你是知道这一点的，那为什么你……还要来找我？","style":2,"background":110,"log_type":1,"src_id":130304048,"trial_step":48},{"step":48,"speaker":"娜恰","content":"……","voice":["vo_trial_30304_1_15"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304049,"trial_step":49},{"step":49,"speaker":"玩家","content":"我是不是可以理解为……你在向我求救。","style":2,"background":110,"log_type":1,"src_id":130304050,"trial_step":50},{"step":50,"speaker":"玩家","content":"它折磨你，想以快乐为食……但你却找一个梦境中没有快乐的人？","style":2,"background":110,"log_type":1,"src_id":130304051,"trial_step":51},{"step":51,"speaker":"娜恰","content":"是的，是的！！","voice":["vo_trial_30304_1_16"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304052,"trial_step":52},{"step":52,"speaker":"娜恰","content":"我用尽了一切……力气……","voice":["vo_trial_30304_1_17"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304053,"trial_step":53},{"step":53,"speaker":"娜恰","content":"但你不认可我的快乐……我将永远被痛苦折磨！","voice":["vo_trial_30304_1_18"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304054,"trial_step":54},{"step":54,"speaker":"娜恰","content":"我会被永远折磨！","voice":["vo_trial_30304_1_19"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304055,"trial_step":55},{"step":55,"content":"眼见娜恰承认了自己的痛苦，抛弃了追逐快乐，玛芙的黑影狂躁地朝你们压来。","style":3,"background":110,"log_type":1,"src_id":130304056,"trial_step":56},{"step":56,"content":"你猛地往前扑去，抱着娜恰摔去另一侧，躲开了它的攻击。","style":3,"background":110,"log_type":1,"src_id":130304057,"trial_step":57},{"step":57,"speaker":"玩家","content":"冷静一点，娜恰。","style":2,"background":110,"log_type":1,"src_id":130304058,"trial_step":58},{"step":58,"speaker":"玩家","content":"即便我喝下梦露，也无法进入梦境的——因为我的快乐，都来自于现实。","style":2,"background":110,"log_type":1,"src_id":130304059,"trial_step":59},{"step":59,"speaker":"娜恰","content":"现实之中怎么可能会有快乐！那些快乐之下……都是苦难……！","voice":["vo_trial_30304_1_20"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304060,"trial_step":60},{"step":60,"speaker":"玩家","content":"有的，娜恰……","style":2,"background":110,"log_type":1,"src_id":130304061,"trial_step":61},{"step":61,"speaker":"玩家","content":"在枷锁的另一边，就是我的全部快乐与幸福。","style":2,"background":110,"log_type":1,"src_id":130304062,"trial_step":62},{"step":62,"speaker":"玩家","content":"我从苏醒开始，经历的一切几乎都可称作“苦难”，但正因为这些……禁闭者，他们是我的全部幸福，全部欢愉。","style":2,"background":110,"log_type":1,"src_id":130304063,"trial_step":63},{"step":63,"speaker":"玩家","content":"梦境里无法创造这些独一无二的他们……所以，我无法进入梦境。","style":2,"background":110,"log_type":1,"src_id":130304064,"trial_step":64},{"step":64,"speaker":"玩家","content":"你也是我的禁闭者……在这里，我无法承认你的快乐，我能为你做的，只有和你一起分担痛苦。","style":2,"background":110,"log_type":1,"src_id":130304065,"trial_step":65},{"step":65,"speaker":"娜恰","content":"分担痛苦……？","voice":["vo_trial_30304_1_21"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304066,"trial_step":66},{"step":66,"speaker":"娜恰","content":"可你甚至都不愿承认我的痛苦……","voice":["vo_trial_30304_1_22"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304067,"trial_step":67},{"step":67,"content":"摔在地上的黑色玛芙尖叫着又冲上云霄，它的眼睛闪烁着粉色的光，但你也看见了娜恰的胸前，也闪烁着同样的光芒——那是妙梦瓶的光！","style":3,"background":110,"log_type":1,"src_id":130304068,"trial_step":68},{"step":68,"content":"粉色的光芒闪过，玛芙像是吸取了妙梦瓶的力量，变得凶猛起来，而娜恰像是被吸走了营养似的，倒在你的怀中。","style":3,"background":110,"log_type":1,"src_id":130304069,"trial_step":69},{"step":69,"content":"你只好背起娜恰，艰难地躲避着攻击。","style":3,"background":110,"log_type":1,"src_id":130304070,"trial_step":70},{"step":70,"speaker":"玩家","content":"你听好，我从没有想要否认你的苦难！也没有希望你能接受、抹平这一切！","style":2,"background":110,"log_type":1,"src_id":130304071,"trial_step":71},{"step":71,"content":"为了躲避攻击，你护着娜恰，滚到了一旁，一个小巧的八音盒，从你的口袋里掉了出来。","style":3,"background":110,"log_type":1,"src_id":130304072,"trial_step":72},{"step":72,"content":"那是游乐园里随处可见的八音盒，滑稽的马戏团绕起了圈圈，叮叮咚咚的音乐流淌出来——那是你在进入审查室前，想要带给娜恰的礼物。","style":3,"background":110,"log_type":1,"src_id":130304073,"trial_step":73},{"step":73,"content":"听到音乐的娜恰，缓缓地睁开了眼睛，而玛芙的攻击，也因此停滞了一瞬，你利用这个空档，再次发动了枷锁，抵御着妙梦瓶对娜恰的控制。","style":3,"background":110,"log_type":1,"src_id":130304074,"trial_step":74},{"step":74,"speaker":"玩家","content":"娜恰，你知道为什么你觉得自己是怪物，但嘉年华还一直拒绝你吗？","style":2,"background":110,"log_type":1,"src_id":130304075,"trial_step":75},{"step":75,"speaker":"娜恰","content":"为……为什么啊？","voice":["vo_trial_30304_1_23"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304076,"trial_step":76},{"step":76,"content":"娜恰的声音带上哭腔，回荡在梦境之中。","style":3,"background":110,"log_type":1,"src_id":130304077,"trial_step":77},{"step":77,"speaker":"娜恰","content":"我就算成为了怪物……也无法快乐吗？","voice":["vo_trial_30304_1_24"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304078,"trial_step":78},{"step":78,"speaker":"玩家","content":"因为你不是怪物！","style":2,"background":110,"log_type":1,"src_id":130304079,"trial_step":79},{"step":79,"speaker":"玩家","content":"尽管你遭受莫大的困苦，但你依旧是人类——人正因在苦难之中，才更像一个人类。","style":2,"background":110,"log_type":1,"src_id":130304080,"trial_step":80},{"step":80,"speaker":"娜恰","content":"可是，这太痛苦了，所有人都在痛苦！我不想要……我不要！","voice":["vo_trial_30304_1_25"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304081,"trial_step":81},{"step":81,"content":"娜恰蜷缩起身子，被枷锁束缚住的玛芙见状，变成了黑泥，不断地缠绕上她，像是要把她拉入泥沼深渊。","style":3,"background":110,"log_type":1,"src_id":130304082,"trial_step":82},{"step":82,"content":"你顾不得其他，伸手进去，牵住了娜恰。","style":3,"background":110,"log_type":1,"src_id":130304083,"trial_step":83},{"step":83,"speaker":"玩家","content":"你不想要，那就不要。","style":2,"background":110,"log_type":1,"src_id":130304084,"trial_step":84},{"step":84,"speaker":"玩家","content":"我说过，我不否认苦难，也不崇尚苦难。","style":2,"background":110,"log_type":1,"src_id":130304085,"trial_step":85},{"step":85,"speaker":"玩家","content":"因为苦难就是苦难，是需要悲悯和爱去解决的！","style":2,"background":110,"log_type":1,"src_id":130304086,"trial_step":86},{"step":86,"content":"娜恰抬起头来看着你，眼泪还在往下掉，脆弱的像那个在乐园门口嚎啕大哭的小孩。","style":3,"background":110,"log_type":1,"src_id":130304087,"trial_step":87},{"step":87,"content":"你张开双手，学着娜恰的样子，对她做出拥抱的动作。","style":3,"background":110,"log_type":1,"src_id":130304088,"trial_step":88},{"step":88,"speaker":"玩家","content":"你告诉我你的一切，想让我感受你认为的快乐……","style":2,"background":110,"log_type":1,"src_id":130304089,"trial_step":89},{"step":89,"speaker":"玩家","content":"可它们是假的……真正的快乐是在这些无法逃避的阴影之下，你忽略掉的很多“爱\"。这些名为“爱”的力量，能让你抵御痛苦，化解悲伤。","style":2,"background":110,"log_type":1,"src_id":130304090,"trial_step":90},{"step":90,"speaker":"玩家","content":"它们会聚集起来，变成你的“快乐”。","style":2,"background":110,"log_type":1,"src_id":130304091,"trial_step":91},{"step":91,"content":"或许是你拥抱的动作，又或许是听进了你的话，娜恰的哭声渐渐弱了下去。而那些黑泥也不再躁动，缓缓地褪去，娜恰跌落至你的怀里。","style":3,"background":110,"log_type":1,"src_id":130304092,"trial_step":92},{"step":92,"content":"天空和大地也不再震动——白色的光芒，开始恢复闪耀。","style":3,"background":110,"log_type":1,"src_id":130304093,"trial_step":93},{"step":93,"speaker":"娜恰","content":"可是……我已经在这片阴影下了。","voice":["vo_trial_30304_1_26"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304094,"trial_step":94},{"step":94,"speaker":"娜恰","content":"我错过了许多你口中的“爱”，那是因为我根本认不清它们是什么样子的。","voice":["vo_trial_30304_1_27"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304095,"trial_step":95},{"step":95,"speaker":"娜恰","content":"我的前路，依旧是苦难铺成的。","voice":["vo_trial_30304_1_28"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304096,"trial_step":96},{"step":96,"speaker":"玩家","content":"我也一样，娜恰。","style":2,"background":110,"log_type":1,"src_id":130304097,"trial_step":97},{"step":97,"speaker":"玩家","content":"这个世界给我的第一个认知，就是危险和痛苦。但是我知道……这绝不是构成我和这个世界的全部。","style":2,"background":110,"log_type":1,"src_id":130304098,"trial_step":98},{"step":98,"speaker":"玩家","content":"还记得我说，为什么我无法进入梦境吗？","style":2,"background":110,"log_type":1,"src_id":130304099,"trial_step":99},{"step":99,"speaker":"娜恰","content":"记得……","voice":["vo_trial_30304_1_29"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304100,"trial_step":100},{"step":100,"speaker":"娜恰","content":"你说你的快乐，都在枷锁的另一头系着。","voice":["vo_trial_30304_1_30"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304101,"trial_step":101},{"step":101,"speaker":"玩家","content":"嗯，而如今，你也在。","style":2,"background":110,"log_type":1,"src_id":130304102,"trial_step":102},{"step":102,"content":"你朝娜恰摆了摆握在一起的双手，微微一笑。","style":3,"background":110,"log_type":1,"src_id":130304103,"trial_step":103},{"step":103,"speaker":"玩家","content":"你我的前路既然都是苦难，那何不……一起寻找苦难下的爱和快乐呢？","style":2,"background":110,"log_type":1,"src_id":130304104,"trial_step":104},{"step":104,"speaker":"玩家","content":"你找不到也好，不愿意找也好……时至今日，你我已经绑在了一起。","style":2,"background":110,"log_type":1,"src_id":130304105,"trial_step":105},{"step":105,"speaker":"玩家","content":"所以至少……让我在和你一起的未来里，共同分担你的痛苦。","style":2,"background":110,"log_type":1,"src_id":130304106,"trial_step":106},{"step":106,"content":"娜恰愣愣地看着你，眼角又一次泛起了泪花。","style":3,"background":110,"log_type":1,"src_id":130304107,"trial_step":107},{"step":107,"content":"可是这次的梦境没有震动，也没有破碎。","style":3,"background":110,"log_type":1,"src_id":130304108,"trial_step":108},{"step":108,"content":"娜恰凑近你，将头轻轻地靠在了你的肩上，声音沉沉的，像是快要睡着。","style":3,"background":110,"log_type":1,"src_id":130304109,"trial_step":109},{"step":109,"speaker":"娜恰","content":"你会带我找到真正的快乐吗……？","voice":["vo_trial_30304_1_31"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304110,"trial_step":110},{"step":110,"speaker":"娜恰","content":"在你身边……我就能拥有……真正的快乐吗？","voice":["vo_trial_30304_1_32"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304111,"trial_step":111},{"step":111,"speaker":"选项","options":["一定会的"],"style":6,"background":110,"log_type":1,"src_id":130304112,"trial_step":112,"course":3,"choices":[{"text":"一定会的","goto":113}]},{"step":112,"speaker":"玩家","content":"枷锁和我，都不会说谎。","style":2,"background":110,"log_type":1,"src_id":130304113,"trial_step":113},{"step":113,"speaker":"娜恰","content":"哈哈……那太好了……","voice":["vo_trial_30304_1_33"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304114,"trial_step":114},{"step":114,"content":"娜恰拿起自己武器，对准了自己的心口。","style":3,"background":110,"log_type":1,"src_id":130304115,"trial_step":115},{"step":115,"speaker":"娜恰","content":"那……救救我吧，局长。","voice":["vo_trial_30304_1_34"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304116,"trial_step":116},{"step":116,"content":"伤口裂开，娜恰把你的手放在上面。","style":3,"background":110,"log_type":1,"src_id":130304117,"trial_step":117},{"step":117,"content":"温热的触感让你汗毛倒竖，你的指尖似乎都能够感受到一顿一顿的跳动。","style":3,"background":110,"log_type":1,"src_id":130304118,"trial_step":118},{"step":118,"content":"你发动枷锁，深入那道伤口，对准附着在上面的异物，那只已经变小的，黑色的飞蛾，狠狠地缠绕——","style":3,"background":110,"log_type":1,"src_id":130304119,"trial_step":119},{"step":119,"speaker":"玛芙","content":"啊——————！！！","voice":["vo_trial_30304_1_35"],"voice_bank":"vo_snake_trial","style":1,"background":110,"log_type":1,"src_id":130304120,"trial_step":120},{"step":120,"content":"梦境的白光愈来愈亮，你什么也无法看清了。唯一感受到的，是娜恰窝在你怀里的温度，和强而有力的心跳。","style":3,"background":10005,"log_type":1,"src_id":130304121,"trial_step":121},{"step":121,"content":"你看着桌上的碎片，沉思了很久。","style":3,"background":1040,"log_type":1,"src_id":130304122,"trial_step":122},{"step":122,"content":"为了拯救娜恰，藏在她梦境中的妙梦瓶被你打碎，只剩一块残片，无论如何，你也无法找到与之相关的线索了。","style":3,"background":1040,"log_type":1,"src_id":130304123,"trial_step":123},{"step":123,"content":"里面曾经存在的东西，和娜恰的梦境一起消失，而那支仿佛只在梦境出现过的怪物队列，那个像马戏团一样的花车，那个红色污染物汇聚的入口……都无从得知了。","style":3,"background":1040,"log_type":1,"src_id":130304124,"trial_step":124},{"step":124,"content":"不过你至少知道了，玛芙并非娜恰用自己的异能制造的，而是另有其人。","style":3,"background":1040,"log_type":1,"src_id":130304125,"trial_step":125},{"step":125,"speaker":"玩家","content":"到底是什么人制作怪物，连残存的力量都能控制狂级禁闭者……？","style":2,"background":1040,"log_type":1,"src_id":130304126,"trial_step":126},{"step":126,"content":"尽管娜恰已经审查完毕，可是还有一连串的问题随之而来，让你有点头大。","style":3,"background":1040,"log_type":1,"src_id":130304127,"trial_step":127},{"step":127,"speaker":"玩家","content":"算了，一步一步来，反正……现在娜恰是我们的人。","style":2,"background":1040,"log_type":1,"src_id":130304128,"trial_step":128},{"step":128,"speaker":"夜莺","content":"既然如此，那您能好好管教一下您的禁闭者吗？","voice":["vo_trial_30304_1_36"],"voice_bank":"vo_snake_trial","style":1,"background":1040,"log_type":1,"src_id":130304129,"trial_step":129},{"step":129,"speaker":"玩家","content":"夜……夜莺？","style":2,"background":1040,"log_type":1,"src_id":130304130,"trial_step":130},{"step":130,"speaker":"夜莺","content":"编号948的禁闭者娜恰，私自将训练改为马戏表演，还总是操纵小蛇恐吓工作人员以及其他禁闭者。","voice":["vo_trial_30304_1_37"],"voice_bank":"vo_snake_trial","style":1,"background":1040,"log_type":1,"src_id":130304131,"trial_step":131},{"step":131,"speaker":"夜莺","content":"并且多次对他人出言不逊……美其名曰想看看这个人……爱不爱自己，您不去管管吗？","voice":["vo_trial_30304_1_38"],"voice_bank":"vo_snake_trial","style":1,"background":1040,"log_type":1,"src_id":130304132,"trial_step":132},{"step":132,"speaker":"玩家","content":"……唉。","style":2,"background":1040,"log_type":1,"src_id":130304133,"trial_step":133},{"step":133,"speaker":"玩家","content":"我马上就去，不过……副官要是愿意，请也对她说一声，你很喜欢她吧。","style":2,"background":1040,"log_type":1,"src_id":130304134,"trial_step":134},{"step":134,"speaker":"玩家","content":"她会安分一点的。","style":2,"background":1040,"log_type":1,"src_id":130304135,"trial_step":135}]}