{"id":6061,"chapter_id":6,"scene_id":606,"steps":[{"step":1,"speaker":"赫卡蒂","content":"这里面竟然有这么大的空间？","voice":["vo_cgplot_6061001"],"voice_bank":"vo_cgplot_06","style":1,"background":507,"log_type":1},{"step":2,"speaker":"海拉","content":"拉倒吧，从外面看最多只有一半大，这里太不对劲了。","voice":["vo_cgplot_6061002"],"voice_bank":"vo_cgplot_06","style":1,"background":507,"log_type":1},{"step":3,"options":["是空间扭曲现象吗"],"jump":[4],"style":6,"background":507,"log_type":1},{"step":4,"content":"由于靠近黑环中心，雕像内部的空间被进一步放大，恐怕时间也不再正常流转。在这里，所有熟悉的规则都可能遭到扭曲。","style":3,"background":507,"log_type":1},{"step":5,"content":"海拉按了按电梯按钮，果不其然，没有任何反应。","style":3,"background":507,"log_type":1},{"step":6,"speaker":"海拉","content":"*文明狄斯*，只能爬楼梯了。","voice":["vo_cgplot_6061006"],"voice_bank":"vo_cgplot_06","style":1,"background":507,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"紧急逃生梯在那边，跟我来。","voice":["vo_cgplot_6061007"],"voice_bank":"vo_cgplot_06","style":1,"background":507,"log_type":1},{"step":8,"content":"你们很快找到了逃生梯的入口，封堵入口的尖刺被击破，似乎不久前有人从这里出入过。","style":3,"background":511,"log_type":1},{"step":9,"speaker":"海拉","content":"难道是那个金毛的朋友？她一个人上去牵制卓娅，而且，是那个模样的卓娅？","voice":["vo_cgplot_6061009"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":10,"speaker":"赫卡蒂","content":"那个人有这个能力。看，周围的死役对我们无动于衷，都在向上移动……","voice":["vo_cgplot_6061010"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":11,"speaker":"赫卡蒂","content":"如果黑环里的怪物意识都受环主人的驱使，那就说得通了。那个人吸引了敌人全部注意力。","voice":["vo_cgplot_6061011"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":12,"speaker":"海拉","content":"嗯……看不出来，那个金毛小子背后能有这么粗的大腿？","voice":["vo_cgplot_6061012"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":13,"options":["要抓紧时间"],"jump":[14],"style":6,"background":511,"log_type":1},{"step":14,"content":"趁现在尽快登塔，卓娅就在雕像的顶部。后面注定是惨烈的战斗，你必须尽可能保留实力。","style":3,"background":511,"log_type":1},{"step":15,"content":"以最小的代价开路前进，如果有危险，千万不要拼命。你们不能死在这儿。","style":2,"background":511,"log_type":1},{"step":16,"speaker":"海拉","content":"你也一样！","voice":["vo_cgplot_6061016"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1}]}