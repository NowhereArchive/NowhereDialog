{"id":1050601,"chapter_id":1050601,"scene_id":1,"steps":[{"step":1,"content":"熟悉的时间，熟悉的街景。逆着人流向前，左转再走五十米就是第五大道，在那里，能看到新城的传播中心——新城电视台大楼。","style":3,"background":2141,"log_type":1,"src_id":150601001,"trial_step":1},{"step":2,"content":"浅色的身影站在人群之中，面无表情地看向那些打着电话，逆流而上的人。","style":3,"background":2141,"log_type":1,"src_id":150601002,"trial_step":2},{"step":3,"content":"世界浑浑噩噩，人群嘈杂的喧嚣中夹杂着令人不快的声音。","style":3,"background":2141,"log_type":1,"src_id":150601003,"trial_step":3},{"step":4,"content":"它们渐渐地，在耳畔清晰起来。","style":3,"background":2141,"log_type":1,"src_id":150601004,"trial_step":4},{"step":5,"content":"叮铃铃铃——","style":3,"background":2141,"log_type":1,"src_id":150601005,"trial_step":5},{"step":6,"speaker":"？？？","content":"你来啦……","voice":["vo_trial_50601_1_1"],"voice_bank":"vo_eleven_trial","style":11,"background":2141,"log_type":1,"src_id":150601006,"trial_step":6},{"step":7,"speaker":"？？？","content":"你是来……毁掉我的吗？","voice":["vo_trial_50601_1_2"],"voice_bank":"vo_eleven_trial","style":11,"background":2141,"log_type":1,"src_id":150601007,"trial_step":7},{"step":8,"speaker":"雷温","content":"是的。","voice":["vo_trial_50601_1_3"],"voice_bank":"vo_eleven_trial","style":1,"background":2141,"log_type":1,"src_id":150601008,"trial_step":8},{"step":9,"speaker":"？？？","content":"可是你已经毁掉了那么多人的……还不够吗？我只剩……只剩这一点点的力量了……","voice":["vo_trial_50601_1_4"],"voice_bank":"vo_eleven_trial","style":11,"background":2141,"log_type":1,"src_id":150601009,"trial_step":9},{"step":10,"speaker":"雷温","content":"只剩一点点也不行，这是源头……会再次滋生那些，不必要的麻烦。","voice":["vo_trial_50601_1_5"],"voice_bank":"vo_eleven_trial","style":1,"background":2141,"log_type":1,"src_id":150601010,"trial_step":10},{"step":11,"content":"雷温逆着人群，快步向前走去。行人的肩膀撞上她的，让她痛呼，却无法阻止她。","style":3,"background":2141,"log_type":1,"src_id":150601011,"trial_step":11},{"step":12,"speaker":"雷温","content":"收手吧，最后一通凌晨三点的电话已经挂断了。","voice":["vo_trial_50601_1_7"],"voice_bank":"vo_eleven_trial","style":1,"background":2141,"log_type":1,"src_id":150601012,"trial_step":12},{"step":13,"speaker":"雷温","content":"我不会让任何人还记得，曾经有过这样的节目，这样的电话。","voice":["vo_trial_50601_1_8"],"voice_bank":"vo_eleven_trial","style":1,"background":2141,"log_type":1,"src_id":150601013,"trial_step":13},{"step":14,"speaker":"？？？","content":"哦？那我们现在正在进行的……是什么呢？","voice":["vo_trial_50601_1_9"],"voice_bank":"vo_eleven_trial","style":11,"background":2141,"log_type":1,"src_id":150601014,"trial_step":14},{"step":15,"content":"雷温走到电视大楼楼底，找到了藏在一角的，一部黑色的终端。","style":3,"background":2141,"log_type":1,"src_id":150601015,"trial_step":15},{"step":16,"speaker":"？？？","content":"只要我和你还存在，那就还会有下一个凌晨三点的来电……","voice":["vo_trial_50601_1_11"],"voice_bank":"vo_eleven_trial","style":11,"background":2141,"log_type":1,"src_id":150601016,"trial_step":16},{"step":17,"speaker":"？？？","content":"还会有下一个“主持人”……","voice":["vo_trial_50601_1_12"],"voice_bank":"vo_eleven_trial","style":11,"background":2141,"log_type":1,"src_id":150601017,"trial_step":17},{"step":18,"speaker":"？？？","content":"这个世界，还是会充斥着你不想听到的声音！","voice":["vo_trial_50601_1_13"],"voice_bank":"vo_eleven_trial","style":11,"background":2141,"log_type":1,"src_id":150601018,"trial_step":18},{"step":19,"speaker":"？？？","content":"你永远无法改变。","voice":["vo_trial_50601_1_14"],"voice_bank":"vo_eleven_trial","style":11,"background":2141,"log_type":1,"src_id":150601019,"trial_step":19},{"step":20,"content":"咔哒。","style":3,"background":2141,"log_type":1,"src_id":150601020,"trial_step":20},{"step":21,"content":"终端里的电话被挂断，只剩下忙音。躺在手中的黑色终端，化成一缕暗色的雾气，朝上空飞去。","style":3,"background":2141,"log_type":1,"src_id":150601021,"trial_step":21},{"step":22,"speaker":"雷温","content":"……这个不是本体。","voice":["vo_trial_50601_1_17"],"voice_bank":"vo_eleven_trial","style":1,"background":2141,"log_type":1,"src_id":150601022,"trial_step":22},{"step":23,"content":"雷温抬头，被城市霓虹灯光遮盖的天空看不到一颗星星。","style":3,"background":2141,"log_type":1,"src_id":150601023,"trial_step":23},{"step":24,"content":"但她见过这里满是星星的样子——那个时候她站在最高的天台，和星星一起，拼命坠落。","style":3,"background":2141,"log_type":1,"src_id":150601024,"trial_step":24},{"step":25,"content":"她伸出手，没有人抓住她。","style":3,"background":2141,"log_type":1,"src_id":150601025,"trial_step":25},{"step":26,"speaker":"雷温","content":"不对……？！","voice":["vo_trial_50601_1_21"],"voice_bank":"vo_eleven_trial","style":1,"background":2141,"log_type":1,"src_id":150601026,"trial_step":26},{"step":27,"speaker":"雷温","content":"这不是我！！我记得……那个时候……他抓住了我的手！","female_content":"这不是我！！我记得……那个时候……她抓住了我的手！","voice":["vo_trial_50601_1_22","vo_trial_50601_1_22f"],"voice_bank":"vo_eleven_trial","style":1,"background":2141,"log_type":1,"src_id":150601027,"trial_step":27},{"step":28,"content":"一瞬间的念动，让周围的气息开始变得不对劲。","style":3,"background":2141,"log_type":1,"src_id":150601028,"trial_step":28},{"step":29,"content":"雷温被猛地慑住呼吸，一双无形的手好像托着她一般，将她从楼底往楼顶推去！","style":3,"background":2141,"log_type":1,"src_id":150601029,"trial_step":29},{"step":30,"speaker":"雷温","content":"是……是……狂厄？？","voice":["vo_trial_50601_1_26"],"voice_bank":"vo_eleven_trial","style":1,"background":2153,"log_type":1,"src_id":150601031,"trial_step":31},{"step":31,"speaker":"雷温","content":"原来本体……藏在这里吗？","voice":["vo_trial_50601_1_27"],"voice_bank":"vo_eleven_trial","style":1,"background":2153,"log_type":1,"src_id":150601032,"trial_step":32},{"step":32,"speaker":"充满恶意的声音","content":"我不是说了让你多说些舔我的话吗？多舔点就多爆米！懂吗！","voice":["vo_trial_50601_1_29"],"voice_bank":"vo_eleven_trial","style":1,"background":2146,"log_type":1,"src_id":150601034,"trial_step":34},{"step":33,"speaker":"充满嫌弃的声音","content":"争议是流量的源头，你必须抓住这个机会。啧，你不是喜欢这个节目吗？这就是你喜欢的态度？","voice":["vo_trial_50601_1_31"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150601036,"trial_step":36},{"step":34,"speaker":"雷温","content":"……又来了，又让我看到这些。","voice":["vo_trial_50601_1_32"],"voice_bank":"vo_eleven_trial","style":1,"background":2153,"log_type":1,"src_id":150601037,"trial_step":37},{"step":35,"content":"划过眼前的画面有些熟悉，又有些陌生。","style":3,"background":2153,"log_type":1,"src_id":150601038,"trial_step":38},{"step":36,"content":"把原本雷温想要释怀的事情，再次挑动起来。","style":3,"background":2153,"log_type":1,"src_id":150601039,"trial_step":39},{"step":37,"content":"滴滴滴——","style":3,"background":1017,"log_type":1,"src_id":150601040,"trial_step":40},{"step":38,"content":"一份紧急报告从你的电脑屏幕上亮起，点开来，狄斯地图上一个点位闪烁着红色的光芒。","style":3,"background":1017,"log_type":1,"src_id":150601041,"trial_step":41},{"step":39,"content":"“新城南部地区发现M值异常上涨！请管理局立刻出动，压制上涨趋势！”","style":11,"background":1017,"log_type":1,"src_id":150601042,"trial_step":42},{"step":40,"content":"又来？","style":2,"background":1017,"log_type":1,"src_id":150601043,"trial_step":43},{"step":41,"content":"你看了看电脑上的时间，熟悉的凌晨时间，让你的眼皮跳了跳。","style":3,"background":1017,"log_type":1,"src_id":150601044,"trial_step":44},{"step":42,"content":"这段时间新城的狂厄危机是不是多了些……","style":2,"background":1017,"log_type":1,"src_id":150601045,"trial_step":45},{"step":43,"content":"大家的精神状况真的不要紧吗？","style":2,"background":1017,"log_type":1,"src_id":150601046,"trial_step":46},{"step":44,"content":"算了算了，加班加班，工作工作，职责职责。","style":2,"background":1017,"log_type":1,"src_id":150601047,"trial_step":47},{"step":45,"content":"你合上手中的文件，分类放好，驱车前往标注点。","style":3,"background":1017,"log_type":1,"src_id":150601048,"trial_step":48},{"step":46,"content":"走出管理局时，门口的警卫向你行礼，并将自己的爱妻便当分了一半给你——那是一块简单的，夹着半熟蛋的三明治。","style":3,"background":1031,"log_type":1,"src_id":150601049,"trial_step":49},{"step":47,"content":"一路开，你一路觉得景色越来越眼熟。","style":3,"background":1031,"log_type":1,"src_id":150601050,"trial_step":50},{"step":48,"content":"直到那栋大楼出现在你的目的地前方时，你反应过来了。","style":3,"background":1031,"log_type":1,"src_id":150601051,"trial_step":51},{"step":49,"content":"电视大楼又出事了？该不会是……","style":2,"background":1031,"log_type":1,"src_id":150601052,"trial_step":52},{"step":50,"content":"一下车，你的终端突然响了起来，不仅是你的，你周围的很多人，终端竟然在同一时间发出了铃声。","style":3,"background":2141,"log_type":1,"src_id":150601053,"trial_step":53},{"step":51,"speaker":"路人A","content":"喂？喂？说话啊？","voice":["vo_trial_50601_1_49"],"voice_bank":"vo_eleven_trial","style":1,"background":2141,"log_type":1,"src_id":150601054,"trial_step":54},{"step":52,"speaker":"路人B","content":"什么东西？","voice":["vo_trial_50601_1_50"],"voice_bank":"vo_eleven_trial","style":1,"background":2141,"log_type":1,"src_id":150601055,"trial_step":55},{"step":53,"speaker":"路人C","content":"有人吗？信号不好？","voice":["vo_trial_50601_1_51"],"voice_bank":"vo_eleven_trial","style":1,"background":2141,"log_type":1,"src_id":150601056,"trial_step":56},{"step":54,"content":"你看着终端上的未知来电，划开了绿色的接听按钮。","style":3,"background":2141,"log_type":1,"src_id":150601057,"trial_step":57},{"step":55,"content":"耳边只有信号的嘈杂声，你不语，一边接听电话，一边用真正的证件，敲开了电视台大楼的门。","style":3,"background":2141,"log_type":1,"src_id":150601058,"trial_step":58},{"step":56,"content":"进入电梯后，电话里的声音渐渐变小，一个清晰的女声传了出来。","style":3,"background":10006,"log_type":1,"src_id":150601059,"trial_step":59},{"step":57,"speaker":"电话中的女声","content":"来天台。","voice":["vo_trial_50601_1_55"],"voice_bank":"vo_eleven_trial","style":11,"background":10006,"log_type":1,"src_id":150601060,"trial_step":60},{"step":58,"content":"你按下最高层，开始静静地等待。","style":3,"background":10006,"log_type":1,"src_id":150601061,"trial_step":61},{"step":59,"content":"雷温？","style":2,"background":10006,"log_type":1,"src_id":150601062,"trial_step":62},{"step":60,"speaker":"电话中的女声","content":"……","style":11,"background":10006,"log_type":1,"src_id":150601063,"trial_step":63},{"step":61,"content":"会在这个地方出乱子，除了你我也想不到别人了。","style":2,"background":10006,"log_type":1,"src_id":150601064,"trial_step":64},{"step":62,"content":"你对我说的那句再见，应该很快就要兑现了吧。","style":2,"background":10006,"log_type":1,"src_id":150601065,"trial_step":65},{"step":63,"speaker":"电话中的女声","content":"……","style":11,"background":10006,"log_type":1,"src_id":150601066,"trial_step":66},{"step":64,"content":"跟你商量个事儿，怎么样？","style":2,"background":10006,"log_type":1,"src_id":150601067,"trial_step":67},{"step":65,"content":"每次见你，都是在我的加班时间……","style":2,"background":10006,"log_type":1,"src_id":150601068,"trial_step":68},{"step":66,"content":"要不来我们管理局吧，这样我们见面的时间，就算不上是加班了。","style":2,"background":10006,"log_type":1,"src_id":150601069,"trial_step":69},{"step":67,"content":"还是说，你确实更想回到电视台，继续主持那档凌晨三点的来电呢？","style":2,"background":10006,"log_type":1,"src_id":150601070,"trial_step":70},{"step":68,"speaker":"电话中的女声","content":"是啊……我还想……","voice":["vo_trial_50601_1_66"],"voice_bank":"vo_eleven_trial","style":11,"background":10006,"log_type":1,"src_id":150601071,"trial_step":71},{"step":69,"speaker":"电话中的女声","content":"你知道的……我想要听到那些声音，想要所有人听到我的声音……","voice":["vo_trial_50601_1_67"],"voice_bank":"vo_eleven_trial","style":11,"background":10006,"log_type":1,"src_id":150601072,"trial_step":72},{"step":70,"content":"电话那端的声音顿了顿，飘飘忽忽地再次传来。","style":3,"background":10006,"log_type":1,"src_id":150601073,"trial_step":73},{"step":71,"speaker":"电话中的女声","content":"让这个世界再次充满……","voice":["vo_trial_50601_1_69"],"voice_bank":"vo_eleven_trial","style":11,"background":10006,"log_type":1,"src_id":150601074,"trial_step":74},{"step":72,"content":"电梯门打开，仅有的节电照明晾在门前，整个楼道昏暗一片。","style":3,"background":922,"log_type":1,"src_id":150601075,"trial_step":75},{"step":73,"content":"你感受得到，在那扇通往天台的门后，压抑着令人心惊的狂厄力量。","style":3,"background":922,"log_type":1,"src_id":150601076,"trial_step":76},{"step":74,"content":"好，我知道了。","style":2,"background":922,"log_type":1,"src_id":150601077,"trial_step":77},{"step":75,"content":"你挂断了电话，猛地拉开那扇门——","style":3,"background":922,"log_type":1,"src_id":150601078,"trial_step":78},{"step":76,"content":"空旷的天台上，一团黑色的气息紧紧地包裹着雷温。而雷温紧闭着双眼，似乎失去了意识。","style":3,"background":2153,"log_type":1,"src_id":150601079,"trial_step":79},{"step":77,"content":"她的手里握着一台终端，那不是她自己的，款式有些老旧。但上面的信号灯亮着，似乎还在通话。","style":3,"background":2153,"log_type":1,"src_id":150601080,"trial_step":80},{"step":78,"content":"刚才跟我打电话的是你吧？","style":2,"background":2153,"log_type":1,"src_id":150601081,"trial_step":81},{"step":79,"content":"但好像……只有我能听到这个声音？","style":2,"background":2153,"log_type":1,"src_id":150601082,"trial_step":82},{"step":80,"content":"同样的招数，之前在那几个狂厄塑造的世界里已经用过了。","style":2,"background":2153,"log_type":1,"src_id":150601083,"trial_step":83},{"step":81,"content":"你不会觉得，我还会相信你说的话吧？","style":2,"background":2153,"log_type":1,"src_id":150601084,"trial_step":84},{"step":82,"content":"你紧盯着那台老式终端，背在身后的手渐渐溢出红色的光晕，慢慢地朝雷温靠近。","style":3,"background":2153,"log_type":1,"src_id":150601085,"trial_step":85},{"step":83,"speaker":"电话中的女声","content":"不一样……我们是不一样的……","voice":["vo_trial_50601_1_81"],"voice_bank":"vo_eleven_trial","style":11,"background":2153,"log_type":1,"src_id":150601086,"trial_step":86},{"step":84,"speaker":"电话中的女声","content":"我希望这个世界……再次……再次……","voice":["vo_trial_50601_1_82"],"voice_bank":"vo_eleven_trial","style":11,"background":2153,"log_type":1,"src_id":150601087,"trial_step":87},{"step":85,"content":"雷温！","style":2,"background":2153,"log_type":1,"src_id":150601088,"trial_step":88},{"step":86,"content":"老式终端的指示灯闪烁，像是心神不宁一样。你抓住这一破绽，释放出赤色的枷锁，缠绕在了那个昏睡之中的人手上。","style":3,"background":2153,"log_type":1,"src_id":150601090,"trial_step":90},{"step":87,"content":"刹那间，巨大的悲伤扑面而来，你的身体迅速变冷，如坠冰窖。","style":3,"background":2153,"log_type":1,"src_id":150601091,"trial_step":91},{"step":88,"speaker":"雷温","content":"……","style":1,"background":2153,"log_type":1,"src_id":150601092,"trial_step":92},{"step":89,"speaker":"雷温","content":"我不会让你逃走的。","voice":["vo_trial_50601_1_88"],"voice_bank":"vo_eleven_trial","style":1,"background":2153,"log_type":1,"src_id":150601093,"trial_step":93},{"step":90,"content":"枷锁的另一端，雷温缓缓睁开了眼睛。你的力量将她唤醒，给予了她反抗的动力。","style":3,"background":2153,"log_type":1,"src_id":150601094,"trial_step":94},{"step":91,"speaker":"雷温","content":"给我……永远地消失吧！！","voice":["vo_trial_50601_1_90"],"voice_bank":"vo_eleven_trial","style":1,"background":2153,"log_type":1,"src_id":150601095,"trial_step":95},{"step":92,"content":"雷温发动了自己的力量，她手中的老式终端脱离了她的手掌，挣扎着飞向了半空。","style":3,"background":2153,"log_type":1,"src_id":150601096,"trial_step":96},{"step":93,"content":"此前环绕着雷温的黑色雾气，迅速地飞向它，包裹着它。","style":3,"background":2153,"log_type":1,"src_id":150601097,"trial_step":97},{"step":94,"content":"一道一道的裂痕出现在它的机身上，几声清脆的破裂声后，那个一直坚持着闪烁的红色指示灯，终于熄灭了。","style":3,"background":2153,"log_type":1,"src_id":150601098,"trial_step":98},{"step":95,"content":"雷温和那个老式终端，一起跌落在地上，她喘着气，看着那台终端，眼中晦涩不明。","style":3,"background":2153,"log_type":1,"src_id":150601099,"trial_step":99},{"step":96,"content":"还好，这次没有造成什么大事件。","style":2,"background":2153,"log_type":1,"src_id":150601100,"trial_step":100},{"step":97,"content":"你走上前去，将终端放入证物袋后，转头看向雷温。","style":3,"background":2153,"log_type":1,"src_id":150601101,"trial_step":101},{"step":98,"content":"怎么样，雷温小姐，要不要……","style":2,"background":2153,"log_type":1,"src_id":150601102,"trial_step":102},{"step":99,"speaker":"雷温","content":"请带我回去吧。","voice":["vo_trial_50601_1_98"],"voice_bank":"vo_eleven_trial","style":1,"background":2153,"log_type":1,"src_id":150601103,"trial_step":103},{"step":100,"content":"诶？","style":2,"background":2153,"log_type":1,"src_id":150601104,"trial_step":104},{"step":101,"speaker":"雷温","content":"我想……事情应该解决了，有你出手，我相信……","voice":["vo_trial_50601_1_99"],"voice_bank":"vo_eleven_trial","style":1,"background":2153,"log_type":1,"src_id":150601105,"trial_step":105},{"step":102,"speaker":"雷温","content":"我已经没有理由还留在这里了。","voice":["vo_trial_50601_1_101"],"voice_bank":"vo_eleven_trial","style":1,"background":2153,"log_type":1,"src_id":150601106,"trial_step":106},{"step":103,"content":"雷温扶着墙壁，慢慢地站了起来，拍拍身上沾到的灰尘后，向你伸出了手。","style":3,"background":2153,"log_type":1,"src_id":150601107,"trial_step":107},{"step":104,"speaker":"雷温","content":"我是禁闭者，自然……要受到严格的关押收容。","voice":["vo_trial_50601_1_103"],"voice_bank":"vo_eleven_trial","style":1,"background":2153,"log_type":1,"src_id":150601108,"trial_step":108},{"step":105,"speaker":"雷温","content":"这里……不会再有我的容身之处了。","voice":["vo_trial_50601_1_104"],"voice_bank":"vo_eleven_trial","style":1,"background":2153,"log_type":1,"src_id":150601109,"trial_step":109},{"step":106,"content":"你握上她的手，方才枷锁链接你们的感觉还残留着，无法忽视。","style":3,"background":2153,"log_type":1,"src_id":150601110,"trial_step":110},{"step":107,"content":"放心，我们这里可没你想的那么严格。","style":2,"background":2153,"log_type":1,"src_id":150601111,"trial_step":111},{"step":108,"content":"至少——不会让你饿肚子。","style":2,"background":2153,"log_type":1,"src_id":150601112,"trial_step":112},{"step":109,"content":"晚饭吃了吗？","style":2,"background":2153,"log_type":1,"src_id":150601113,"trial_step":113},{"step":110,"content":"像是没料到你会这么问，雷温愣了一下，摇了摇头。","style":3,"background":2153,"log_type":1,"src_id":150601114,"trial_step":114},{"step":111,"content":"喏，这个给你，吃吧。","style":2,"background":2153,"log_type":1,"src_id":150601115,"trial_step":115},{"step":112,"content":"你拿出那块三明治，放在雷温手中。","style":3,"background":2153,"log_type":1,"src_id":150601116,"trial_step":116},{"step":113,"content":"我同事的妻子做的，她的手艺很好，就算只是简单的三明治，也能做得很好吃。","style":2,"background":2153,"log_type":1,"src_id":150601117,"trial_step":117},{"step":114,"content":"你带着雷温，走下电梯。","style":3,"background":2153,"log_type":1,"src_id":150601118,"trial_step":118},{"step":115,"content":"大门口，那道你曾在异世界里见到过的电视墙，依然亮着。","style":3,"background":2141,"log_type":1,"src_id":150601119,"trial_step":119},{"step":116,"content":"上面在滚动播放着节目回顾，班表，以及一些通知。","style":3,"background":2141,"log_type":1,"src_id":150601120,"trial_step":120},{"step":117,"content":"即日起，本台广播节目《凌晨三点的来电》将暂停播出，恢复时间未知，请广大听众朋友们见谅。","style":11,"background":2141,"log_type":1,"src_id":150601121,"trial_step":121}]}