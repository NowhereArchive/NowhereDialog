{"id":1040304,"chapter_id":1040304,"scene_id":1,"steps":[{"step":1,"content":"回到碑林，天已经大亮了。","style":3,"background":917,"log_type":1,"src_id":140304001,"trial_step":1},{"step":2,"speaker":"橡木匣","content":"我决定放弃这次合作。","voice":["vo_trial_40304_1_2"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304002,"trial_step":2},{"step":3,"speaker":"橡木匣","content":"我的能力还不足以解读这么多年以前的执念。也许，放过它，对我们所有人都好。","voice":["vo_trial_40304_1_3"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304003,"trial_step":3},{"step":4,"content":"她望着不远处那个曾经的乱葬岗，乱葬岗早已填埋，橡木匣的眼神却像在凝望一个深渊。","style":1,"background":917,"log_type":1,"src_id":140304004,"trial_step":4},{"step":5,"content":"你翻开行医笔记，薄薄一册，有些旧了。好在，上面记载着你想要的内容。","style":1,"background":917,"log_type":1,"src_id":140304005,"trial_step":5},{"step":6,"content":"是橡木匣这么多年错过了的内容，是现在的橡木匣依旧需要看到的内容。","style":1,"background":917,"log_type":1,"src_id":140304006,"trial_step":6},{"step":7,"content":"……你之前给我说了游隼的传说，但没有说完。","style":2,"background":917,"log_type":1,"src_id":140304007,"trial_step":7},{"step":8,"speaker":"橡木匣","content":"你变得越来越啰嗦了。","voice":["vo_trial_40304_1_8"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304008,"trial_step":8},{"step":9,"content":"财富的口袋，会在商人聚集的地方找到；权力的口袋，会在战争中找到……","style":2,"background":917,"log_type":1,"src_id":140304009,"trial_step":9},{"step":10,"content":"希望的口袋，会在最痛苦的地方找到。","style":2,"background":917,"log_type":1,"src_id":140304010,"trial_step":10},{"step":11,"content":"因为希望最喜欢和生者捉迷藏，它会躲去生者最想回避的地方。","style":2,"background":917,"log_type":1,"src_id":140304011,"trial_step":11},{"step":12,"speaker":"橡木匣","content":"你有很多新奇的说法。","voice":["vo_trial_40304_1_12"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304012,"trial_step":12},{"step":13,"content":"那块纪念碑……和你有关，对吧？","style":2,"background":917,"log_type":1,"src_id":140304013,"trial_step":13},{"step":14,"content":"橡木匣不置可否，陷入了沉默。","style":3,"background":917,"log_type":1,"src_id":140304014,"trial_step":14},{"step":15,"content":"那块纪念碑的执念现在已经模糊，但它已经坚持了这么久，足以想见当时的执念有多强烈。","style":2,"background":917,"log_type":1,"src_id":140304015,"trial_step":15},{"step":16,"content":"为什么我们不能再为他坚持一下，再试一试？","style":2,"background":917,"log_type":1,"src_id":140304016,"trial_step":16},{"step":17,"content":"你不是希望所有的亡者，都能够毫无执念地离开这个世界吗？","style":2,"background":917,"log_type":1,"src_id":140304017,"trial_step":17},{"step":18,"content":"你将从医生家里找到的笔记摊开，放在墓碑前。","style":3,"background":917,"log_type":1,"src_id":140304018,"trial_step":18},{"step":19,"content":"笔记的字迹已经褪色，有的墨水因为受潮洇开了。只有那个“光”字仍然清晰，似乎被人重笔描摹过。","style":3,"background":917,"log_type":1,"src_id":140304019,"trial_step":19},{"step":20,"content":"你是个有契约精神的人，我们的约定还没有结束。","style":2,"background":917,"log_type":1,"src_id":140304020,"trial_step":20},{"step":21,"speaker":"橡木匣","content":"这就是我不喜欢和活人立下约定的原因。","voice":["vo_trial_40304_1_21"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304021,"trial_step":21},{"step":22,"content":"橡木匣安静地站在原地，虽然有些抗拒，却默许你的靠近。","style":3,"background":917,"log_type":1,"src_id":140304022,"trial_step":22},{"step":23,"content":"你伸手，触碰到她单薄的身体，和她的话语一样冰凉。你捂住她的眼睛。","style":3,"background":917,"log_type":1,"src_id":140304023,"trial_step":23},{"step":24,"content":"耳边有喋喋不休的絮语，攀附上你的神经，让你感到疼痛。","style":3,"background":917,"log_type":1,"src_id":140304026,"trial_step":26},{"step":25,"content":"橡木匣似乎想要拉开你的手，但你反手握住她。","style":3,"background":917,"log_type":1,"src_id":140304027,"trial_step":27},{"step":26,"content":"没关系，橡木匣，我不害怕。","style":2,"background":917,"log_type":1,"src_id":140304028,"trial_step":28},{"step":27,"content":"你一直坚定地握住她的手，直到两只手的温度逐渐一致，逐渐一样温暖。","style":3,"background":917,"log_type":1,"src_id":140304029,"trial_step":29},{"step":28,"content":"你开始辨认出耳旁的声音，两个苍老的声音。","style":3,"background":917,"log_type":1,"src_id":140304030,"trial_step":30},{"step":29,"content":"在你辨认清楚的刹那，枷锁的力量前所未有的强烈，你的视野也前所未有的清晰。眼前有光亮起，越来越亮，直到让你看清一切。","style":3,"background":10006,"log_type":1,"src_id":140304031,"trial_step":31},{"step":30,"speaker":"橡木匣","content":"为何光总是被赐予命途多舛的，生总是被赐给灵魂苦涩的……","voice":["vo_trial_40304_1_32"],"voice_bank":"vo_oak_trial","style":1,"background":10006,"log_type":1,"src_id":140304032,"trial_step":32},{"step":31,"content":"橡木匣的声音微微颤抖。","style":3,"background":10006,"log_type":1,"src_id":140304033,"trial_step":33},{"step":32,"content":"月光照在那块纪念碑上，小小的女孩坐在木板下，借着月光在读自己抄的诗。","style":3,"background":905,"log_type":1,"src_id":140304034,"trial_step":34},{"step":33,"content":"她抬起头看向来人，在这一瞬你看清了她的面容。那是童年的橡木匣。","style":3,"background":905,"log_type":1,"src_id":140304035,"trial_step":35},{"step":34,"speaker":"老神父","content":"奈，你在这里做什么？","voice":["vo_trial_40304_1_36"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304036,"trial_step":36},{"step":35,"speaker":"童年橡木匣","content":"在读您今天教我的诗。但我还有很多字不会。","voice":["vo_trial_40304_1_37"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304037,"trial_step":37},{"step":36,"speaker":"老神父","content":"让我看看。","voice":["vo_trial_40304_1_38"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304038,"trial_step":38},{"step":37,"speaker":"老神父","content":"金色的游隼……噢，那是在太阳身边的飞鸟。你记得葬礼通常都在天亮之前进行吗？","voice":["vo_trial_40304_1_39"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304039,"trial_step":39},{"step":38,"speaker":"童年橡木匣","content":"我记得。","voice":["vo_trial_40304_1_40"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304040,"trial_step":40},{"step":39,"speaker":"老神父","content":"亡者的世界和活人不同。但当游隼来到的时候，天就快要亮了。","voice":["vo_trial_40304_1_41"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304041,"trial_step":41},{"step":40,"speaker":"老神父","content":"我们一起来读。","voice":["vo_trial_40304_1_42"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304042,"trial_step":42},{"step":41,"speaker":"老神父＆童年橡木匣","content":"在荒野里行走的人，不再背负从前的包袱。金色的游隼问她，你从何处来。她说，我已经忘记了来时的路。天即将亮起，一切即将结束。","voice":["vo_trial_40304_1_43"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304043,"trial_step":43},{"step":42,"content":"你看见光芒越来越亮，在那白色的亮光里，更年轻一些的医生出现了，还有一些修道院的人，他们围拢在年幼的橡木匣身边，一起念诵那未完成的诗文，仿佛在完成一场虔诚的礼拜。","style":1,"background":905,"log_type":1,"src_id":140304044,"trial_step":44},{"step":43,"speaker":"众人","content":"你当度过苦厄，跨过这世上所有的丰碑，你当遇见金色的游隼，有翅膀的行者牵引你，去往光明处。光所在处，你定也在那里。","voice":["vo_trial_40304_1_45"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304045,"trial_step":45},{"step":44,"content":"书页翻动，火光染红了满月。","style":3,"background":1046,"log_type":1,"src_id":140304046,"trial_step":46},{"step":45,"content":"黑帮的怒吼与枪声终结了宁静的世界。","style":3,"background":1046,"log_type":1,"src_id":140304047,"trial_step":47},{"step":46,"speaker":"医生","content":"神父，奈她没有死，奈还有救……","voice":["vo_trial_40304_1_48"],"voice_bank":"vo_oak_trial","style":1,"background":1046,"log_type":1,"src_id":140304048,"trial_step":48},{"step":47,"speaker":"老神父","content":"她受了重伤，我们现在的储备和环境，根本救不活她……","voice":["vo_trial_40304_1_49"],"voice_bank":"vo_oak_trial","style":1,"background":1046,"log_type":1,"src_id":140304049,"trial_step":49},{"step":48,"speaker":"医生","content":"可她还没有死！她就在坑底看着我们！说不定她能撑过……","voice":["vo_trial_40304_1_50"],"voice_bank":"vo_oak_trial","style":1,"background":1046,"log_type":1,"src_id":140304050,"trial_step":50},{"step":49,"speaker":"老神父","content":"那些恶徒马上就要来了！他们好不容易找到理由攻击修道院，不管死活都一定会把奈带走！接下来他们会做什么你难道不知道吗？！","voice":["vo_trial_40304_1_51"],"voice_bank":"vo_oak_trial","style":1,"background":1046,"log_type":1,"src_id":140304051,"trial_step":51},{"step":50,"speaker":"老神父","content":"与其在那样的实验下感染狂厄……不如……交给希望吧……","voice":["vo_trial_40304_1_52"],"voice_bank":"vo_oak_trial","style":1,"background":1046,"log_type":1,"src_id":140304052,"trial_step":52},{"step":51,"speaker":"医生","content":"……","voice":["vo_trial_40304_1_53"],"voice_bank":"vo_oak_trial","style":1,"background":1046,"log_type":1,"src_id":140304053,"trial_step":53},{"step":52,"speaker":"老神父","content":"祝词早已抛弃我们了……但依旧祝愿……她能看见希望……看见光……","voice":["vo_trial_40304_1_54"],"voice_bank":"vo_oak_trial","style":1,"background":1046,"log_type":1,"src_id":140304054,"trial_step":54},{"step":53,"content":"书页又一次翻动。","style":3,"background":10000,"log_type":1,"src_id":140304055,"trial_step":55},{"step":54,"content":"医生坐在纪念碑前，那时，纪念碑没有现在这么破旧。","style":3,"background":905,"log_type":1,"src_id":140304056,"trial_step":56},{"step":55,"speaker":"医生","content":"奈……神父……你们在死后的世界重遇了吗？","voice":["vo_trial_40304_1_57"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304057,"trial_step":57},{"step":56,"speaker":"医生","content":"打他一顿吧，一直生他的气也好，他在临死前，也一直在向你忏悔着。","voice":["vo_trial_40304_1_58"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304058,"trial_step":58},{"step":57,"content":"医生似乎回忆着什么，又红了眼眶，最后叹了口气。","style":3,"background":905,"log_type":1,"src_id":140304059,"trial_step":59},{"step":58,"speaker":"医生","content":"修道院就剩我一个人了，我会常来为你们祝福的，直到我走不动的那一天。","voice":["vo_trial_40304_1_60"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304060,"trial_step":60},{"step":59,"speaker":"医生","content":"你们一定要去往有光的世界。","voice":["vo_trial_40304_1_61"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304061,"trial_step":61},{"step":60,"speaker":"医生","content":"“你当度过苦厄，跨过这世上所有的丰碑，你当遇见金色的游隼，有翅膀的行者牵引你，去往光明处。光所在处，你定也在那里。”","voice":["vo_trial_40304_1_62"],"voice_bank":"vo_oak_trial","style":1,"background":905,"log_type":1,"src_id":140304062,"trial_step":62},{"step":61,"content":"陆陆续续，很多次的祝祷从眼前闪过。年轻的医生、中年的医生、垂垂老矣的医生、直到无人拜访的墓碑。","style":1,"background":905,"log_type":1,"src_id":140304063,"trial_step":63},{"step":62,"content":"所有的唱诵汇聚在一起，执念越来越强，直到浩大的光芒到达极限。","style":1,"background":10006,"log_type":1,"src_id":140304064,"trial_step":64},{"step":63,"content":"光线逐渐暗沉。","style":1,"background":10006,"log_type":1,"src_id":140304065,"trial_step":65},{"step":64,"content":"你松开了捂住橡木匣眼睛的手。","style":1,"background":917,"log_type":1,"src_id":140304066,"trial_step":66},{"step":65,"content":"“奈”。","style":2,"background":917,"log_type":1,"src_id":140304067,"trial_step":67},{"step":66,"content":"橡木匣点头，眼底有些无奈与纵容。","style":3,"background":917,"log_type":1,"src_id":140304068,"trial_step":68},{"step":67,"speaker":"橡木匣","content":"这是神父为我起的名字，我是在九号那天被捡回来的。但奈已经死了。","voice":["vo_trial_40304_1_69"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304069,"trial_step":69},{"step":68,"content":"她的手轻轻滑过纪念碑上面的字迹。你现在能隐约辨认出上面被划花的一个字，原来是数字9。","style":3,"background":917,"log_type":1,"src_id":140304070,"trial_step":70},{"step":69,"speaker":"橡木匣","content":"你猜得没有错。这是奈的纪念碑。","voice":["vo_trial_40304_1_71"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304071,"trial_step":71},{"step":70,"speaker":"橡木匣","content":"这大概，是他们把我扔进死人坑后，为我立的一个衣冠冢。","voice":["vo_trial_40304_1_72"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304072,"trial_step":72},{"step":71,"speaker":"橡木匣","content":"我原本以为……他们立下这个冢，就像为我念一次往生诗一样……不过是减轻负罪感的借口……","voice":["vo_trial_40304_1_73"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304073,"trial_step":73},{"step":72,"content":"不，他们……","style":2,"background":917,"log_type":1,"src_id":140304074,"trial_step":74},{"step":73,"content":"橡木匣却打断了你的话。","style":3,"background":917,"log_type":1,"src_id":140304075,"trial_step":75},{"step":74,"speaker":"橡木匣","content":"我会解决这一切的。","voice":["vo_trial_40304_1_76"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304076,"trial_step":76},{"step":75,"speaker":"橡木匣","content":"但我需要你给我一些时间……","voice":["vo_trial_40304_1_77"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304077,"trial_step":77},{"step":76,"content":"你看向橡木匣，她的眼睛又恢复了从前的宁静。","style":3,"background":917,"log_type":1,"src_id":140304078,"trial_step":78},{"step":77,"speaker":"橡木匣","content":"你可以先回管理局，我需要在这里完成一些事。请你放心，我们的约定还未完成。我不会擅自离开。","voice":["vo_trial_40304_1_79"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304079,"trial_step":79},{"step":78,"content":"三天以后，你收到了一封黑色的邀请函。","style":3,"background":1017,"log_type":1,"src_id":140304080,"trial_step":80},{"step":79,"content":"“亲爱的朋友，这封信出现在这里，是为了邀请您主持一个无名之人的葬礼。”\n“祝福她不再哀哭，庆祝她不再痛苦。”\n“葬礼将于█月█日█时在罗马内斯克碑林举行。”","style":10,"background":1017,"log_type":1,"src_id":140304081,"trial_step":81},{"step":80,"content":"邀请函的装饰非常简单，上面也没有留下任何署名。但你还是决定按时前往。","style":3,"background":1017,"log_type":1,"src_id":140304082,"trial_step":82},{"step":81,"content":"你来到碑林，不出你的意料，这里并没有其他的参与者。你走上那个小小的讲台，按邀请函上的时间念开场词，然后按流程一一致辞。","style":3,"background":917,"log_type":1,"src_id":140304083,"trial_step":83},{"step":82,"content":"气氛有点怪异，台下唯一的听众，是那些大大小小的纪念碑。","style":3,"background":917,"log_type":1,"src_id":140304084,"trial_step":84},{"step":83,"content":"各位朋友，你们好。我知道这样说非常古怪，因为你们甚至不能对我做出回应。又或者，其实你们听见了我的话，但你们的暗语，我不能够理解。但我知道，这里有个人能够理解你们。","style":2,"background":917,"log_type":1,"src_id":140304085,"trial_step":85},{"step":84,"content":"这个世界有很多生者。即使是在入夜之后，也依然有很多。我有天忽然意识到亡者比生者更多，而我们从来没有用心地去听过亡者的声音。","style":2,"background":917,"log_type":1,"src_id":140304086,"trial_step":86},{"step":85,"content":"我要感谢一位朋友，她让我意识到了这一点。","style":2,"background":917,"log_type":1,"src_id":140304087,"trial_step":87},{"step":86,"content":"风吹动树林，发出亡者絮语般的响声。你似乎听到了橡木匣的轻笑。","style":3,"background":917,"log_type":1,"src_id":140304088,"trial_step":88},{"step":87,"speaker":"橡木匣","content":"“活人总以为自己的祷词能够超度亡灵，让他们得到解脱。他们借着这样的辞藻粉饰自己犯下的罪行，好像从此就能够被亡灵原谅。”","voice":["vo_trial_40304_1_89"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304089,"trial_step":89},{"step":88,"content":"亡者无需回应生者的告解，因为来路与过往都归于亡者自身。","style":2,"background":917,"log_type":1,"src_id":140304090,"trial_step":90},{"step":89,"speaker":"橡木匣","content":"“有什么意义呢？他把我丢进了黑暗之中，却叫我去寻找光。”","voice":["vo_trial_40304_1_91"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304091,"trial_step":91},{"step":90,"content":"亡者无需背负生者的祝福，因为亡者能够靠自己的力量走向生门。","style":2,"background":917,"log_type":1,"src_id":140304092,"trial_step":92},{"step":91,"speaker":"橡木匣","content":"“希望的口袋在这个世界存在吗？”","voice":["vo_trial_40304_1_93"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304093,"trial_step":93},{"step":92,"content":"没有希望的世界是生者共同的罪孽，我会一直为她捂住眼睛，直到新的世界覆盖旧的世界。","style":2,"background":917,"log_type":1,"src_id":140304094,"trial_step":94},{"step":93,"content":"你的视线走过高高低低的纪念碑，最后落在一块已经修好的纪念碑上。","style":3,"background":917,"log_type":1,"src_id":140304095,"trial_step":95},{"step":94,"content":"这是你对橡木匣大大小小问题的回答，你相信她听见了。","style":3,"background":917,"log_type":1,"src_id":140304096,"trial_step":96},{"step":95,"content":"最后，我想念一首她背得最熟的诗作为结尾。","style":2,"background":917,"log_type":1,"src_id":140304097,"trial_step":97},{"step":96,"content":"在荒野里行走的人，不再背负从前的包袱。金色的游隼问她，你从何处来。她说，我已经忘记了来时的路。天即将亮起，一切即将结束。","style":2,"background":917,"log_type":1,"src_id":140304098,"trial_step":98},{"step":97,"content":"你当度过苦厄，跨过这世上所有的丰碑，你当遇见金色的游隼，有翅膀的行者牵引你，去往光明处。光所在处，你定也在那里。","style":2,"background":917,"log_type":1,"src_id":140304099,"trial_step":99},{"step":98,"content":"你明白橡木匣的意思。她给年幼的自己办了一个葬礼，告别她耿耿于怀的过去。","style":3,"background":917,"log_type":1,"src_id":140304100,"trial_step":100},{"step":99,"content":"葬礼仪式结束，你走到那块已经被修复的纪念碑前，这里有一副没有封顶的寿材，是用橡木制成的。","style":3,"background":917,"log_type":1,"src_id":140304101,"trial_step":101},{"step":100,"content":"那个名为奈的小女孩已经好好地离开了，那么请问亡灵的使者，禁闭者橡木匣，继续逗留在这个活人的世界，究竟是为了什么呢？","style":2,"background":917,"log_type":1,"src_id":140304102,"trial_step":102},{"step":101,"speaker":"橡木匣","content":"被亡者拯救的那天，我获得了能力，于是自愿成为亡灵的使者，在生殒的狭缝之中渡人。但我总是想不明白，这个世界究竟有什么值得眷恋的？","voice":["vo_trial_40304_1_103"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304103,"trial_step":103},{"step":102,"content":"那她现在想明白了吗？","style":2,"background":917,"log_type":1,"src_id":140304104,"trial_step":104},{"step":103,"content":"寿材的盖子被打开了，你忽然意识到那也是生橡木做成的寿材，橡木匣一定是去收敛了那棵被炸毁的橡树的树干，木纹上还有被火焚烧的痕迹。","style":3,"background":917,"log_type":1,"src_id":140304105,"trial_step":105},{"step":104,"content":"这是一个真正的“橡木匣”。","style":3,"background":917,"log_type":1,"src_id":140304106,"trial_step":106},{"step":105,"content":"橡木匣的声音从匣子里的阴影中传出。","style":3,"background":917,"log_type":1,"src_id":140304107,"trial_step":107},{"step":106,"speaker":"橡木匣","content":"没有。但你或许能帮助她想明白。","voice":["vo_trial_40304_1_108"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304108,"trial_step":108},{"step":107,"content":"你向橡木匣伸出手，她轻轻牵住你的手，从她的匣子中站起来。","style":3,"background":917,"log_type":1,"src_id":140304109,"trial_step":109},{"step":108,"content":"橡树被爆炸劈倒了，不会再次生芽。但希望的种子会再次萌发。","style":3,"background":917,"log_type":1,"src_id":140304110,"trial_step":110},{"step":109,"speaker":"橡木匣","content":"谢谢你为奈送行。","voice":["vo_trial_40304_1_111"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304111,"trial_step":111},{"step":110,"content":"感谢我的话，就不要再追着我，为我制作棺材了吧？","style":2,"background":917,"log_type":1,"src_id":140304112,"trial_step":112},{"step":111,"speaker":"橡木匣","content":"直到新世界来临之前，我不会急着让你回到我这里。","voice":["vo_trial_40304_1_113"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304113,"trial_step":113},{"step":112,"speaker":"橡木匣","content":"我一直不知道，我为何留在活人的世界……","voice":["vo_trial_40304_1_114"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304114,"trial_step":114},{"step":113,"speaker":"橡木匣","content":"但你的存在，或许能为我找到意义。","voice":["vo_trial_40304_1_115"],"voice_bank":"vo_oak_trial","style":1,"background":917,"log_type":1,"src_id":140304115,"trial_step":115}]}