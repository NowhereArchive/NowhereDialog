{"id":4001018,"chapter_id":50000,"scene_id":511,"steps":[{"step":1,"speaker":"局长","content":"呼——呼——","style":2,"background":201,"log_type":1},{"step":2,"content":"宫殿内部通道十分复杂，你一路乱闯，甩掉了一些追杀者。","style":3,"background":201,"log_type":1},{"step":3,"speaker":"狂化砂盗","content":"吼——吼！！！！！","style":1,"background":201,"log_type":1},{"step":4,"speaker":"选项","options":["呼叫支援","逃跑"],"jump":[5,9],"style":6,"background":201,"log_type":1},{"step":5,"content":"继续逃下去也没用，这些砂盗源源不断，你总会在某个角落被他们逮住，快向赫卡蒂发送求救信号！","style":3,"background":201,"log_type":1},{"step":6,"content":"滴滴——","style":3,"background":201,"log_type":1},{"step":7,"speaker":"狂化砂盗","content":"吼！！吼！！！！","style":1,"background":201,"log_type":1},{"step":9,"content":"你看了看四下，没有任何趁手的武器可以帮助你在这里抵御对方的攻击，只有身后那条长长的，不知指引向何处的道路。","style":3,"background":201,"log_type":1},{"step":10,"content":"你决定继续跑下去，运气好，或许能在这迷宫一般的地方，甩掉这些砂盗。","style":3,"background":201,"log_type":1},{"step":11,"content":"砂盗们感应到你的位置，一齐冲向你。","style":3,"background":201,"log_type":1},{"step":12,"content":"经过岁月和风沙的侵蚀，宫殿地面早已脆弱不堪，根本禁不起被如此折腾。","style":3,"background":201,"log_type":1},{"step":13,"content":"地面起先裂开了一条缝，接着无数条裂隙交替相连，最终碎裂出一个极大的地洞！","style":3,"background":201,"log_type":1},{"step":14,"content":"那些狂化的怪物，与你一起掉入了无尽的深渊中……","style":3,"background":10000,"log_type":1},{"step":15,"content":"遗迹宫殿，地下。","style":3,"background":2003,"log_type":1},{"step":16,"content":"剧烈的疼痛从背部传来，你挣扎着起身，发现自己掉落在一片人为搭建起来的平台上——它仿佛就是为了接住你而存在。","style":3,"background":2003,"log_type":1},{"step":17,"content":"而你的四周，散落着怪物的残肢碎片。","style":3,"background":2003,"log_type":1},{"step":18,"speaker":"？？？","content":"你来了，就这么不舍得我吗？","voice":["vo_event1_111_16"],"voice_bank":"vo_event_01","style":1,"background":2003,"log_type":1},{"step":19,"content":"熟悉的音调，熟悉的语气……你猛地抬起头来——","style":3,"background":2003,"log_type":1},{"step":20,"content":"她一如从你身边逃走那时一样，轻盈地立在不远处的石块上，嘴角噙笑，眼眸中，却满是可怜与嘲笑。","style":3,"background":2003,"log_type":1},{"step":21,"speaker":"选项","options":["你……！"],"jump":[22],"style":6,"background":2003,"log_type":1},{"step":22,"content":"你正欲向她辩驳些什么，却发现隐藏在观星者背后的，一个……巨大无比的怪物！","style":3,"background":2003,"log_type":1},{"step":23,"content":"如藤蔓般肆意缠绕，互相勒紧了对方，粘稠的液体滴落，像极了腐肉从人的身上剥离。在死路一般蔓延的顶端，一面似人的面目，又似鲜花绽放开来的物体，静静地起伏着，好像在呼吸一样。","style":3,"background":2003,"log_type":1},{"step":24,"speaker":"观星者","content":"小怪物，这就是……“幻花”。","voice":["vo_event1_111_17"],"voice_bank":"vo_event_01","style":1,"background":2003,"log_type":1}]}