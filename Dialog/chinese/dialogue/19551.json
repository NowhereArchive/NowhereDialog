{"id":19551,"chapter_id":50086,"scene_id":58632,"steps":[{"step":1,"content":"涅槃港废墟，往日的烈火消散，啸叫的夜风里隐约能听到前线的枪炮轰鸣。","style":32,"background":2487,"log_type":1},{"step":2,"content":"德雷文正在处理公务，敌军压阵，局势纷乱，所有慌乱的人都不自觉地看向他，试图从总指挥这里获得一些力量。","style":3,"background":2453,"log_type":1},{"step":3,"content":"幸好他足够顽固，冰冷的脸上看不出丝毫表情，只有一丝不苟有条不紊的不断动作，发布命令，调配后勤，处理间谍……","style":3,"background":2453,"log_type":1},{"step":4,"speaker":"传令员","content":"将军！！到处都找不到凯瑟琳·安多哈尔，她该不会是叛逃了吧？带着我们那么多秘密？？","voice":["vo_cgplot_19031090"],"voice_bank":"vo_cgplot_1903","style":1,"background":2453,"log_type":1},{"step":5,"speaker":"传令员","content":"在这种时候……","voice":["vo_cgplot_19031091"],"voice_bank":"vo_cgplot_1903","style":1,"background":2453,"log_type":1},{"step":6,"speaker":"传令员","content":"可恶！亏我们那么信任她，一直保护她！宗主城邦的人全都——","voice":["vo_cgplot_19031092"],"voice_bank":"vo_cgplot_1903","style":1,"background":2453,"log_type":1},{"step":7,"speaker":"德雷文","content":"……","style":1,"background":2453,"log_type":1},{"step":8,"content":"沉吟半晌，德雷文放下手中的笔。","style":3,"background":2453,"log_type":1},{"step":9,"speaker":"德雷文","content":"我知道她在哪儿。","voice":["vo_cgplot_19031095"],"voice_bank":"vo_cgplot_1903","style":1,"background":2453,"log_type":1}]}