{"id":1040701,"chapter_id":1040701,"scene_id":1,"steps":[{"step":1,"content":"正午十二点，正是处理公务的好时间。","style":3,"background":1017,"log_type":1,"src_id":140701001,"trial_step":1},{"step":2,"content":"？？","style":3,"background":1017,"log_type":1,"src_id":140701002,"trial_step":2},{"step":3,"speaker":"街采记者","content":"近期，一款名为“灰镜”的社交软件受到广大市民的关注，其颇具特色的投票功能吸引了大批市民参与其中。","voice":["vo_trial_40701_1_3"],"voice_bank":"vo_bianca_trial","style":1,"background":1016,"log_type":1,"src_id":140701003,"trial_step":3},{"step":4,"speaker":"街采记者","content":"但据本台记者了解，这种以投票为名号的游戏方式导致了大规模的用户信息泄露。为防止事态进一步升级，目前该软件已被要求整改，投票功能暂时封禁……","voice":["vo_trial_40701_1_4"],"voice_bank":"vo_bianca_trial","style":1,"background":1016,"log_type":1,"src_id":140701004,"trial_step":4},{"step":5,"content":"作为灰镜投票的直接参与者，你当然知道这场游戏的内幕——并非报道中轻飘飘的“用户信息泄露”，而是一场审判。","style":3,"background":1017,"log_type":1,"src_id":140701005,"trial_step":5},{"step":6,"content":"那些被两句话带过的细节，正记录在你面前的这份调查报告中。","style":3,"background":1017,"log_type":1,"src_id":140701006,"trial_step":6},{"step":7,"content":"<b>█编号：FAC-M-307-Ⅴ：\n█档案：灰镜事件调查报告</b>\n\n*附录Ⅰ——禁闭者追踪\n于狂厄聚合体被清除的瞬间，狄斯电视台附近监测到异常的M值波峰。推测肇事人员毕安卡或已觉醒为禁闭者。\n目前，该人员仍行踪不明。MBCC持续追缉中。","style":10,"background":1017,"log_type":1,"src_id":140701007,"trial_step":7},{"step":8,"content":"毕安卡现在在哪？没人知道，唯一的线索是苹果头账号留下的邮件。","style":3,"background":1017,"log_type":1,"src_id":140701008,"trial_step":8},{"step":9,"content":"这才是真正令人头疼的问题。","style":3,"background":1017,"log_type":1,"src_id":140701009,"trial_step":9},{"step":10,"content":"哎……","style":2,"background":1017,"log_type":1,"src_id":140701010,"trial_step":10},{"step":11,"content":"可惜，头疼对解决问题没有任何帮助。你的注意力重新回到新闻播报，不知何时，画面切换到了新城的街头。","style":3,"background":1017,"log_type":1,"src_id":140701011,"trial_step":11},{"step":12,"speaker":"路人甲","content":"你问灰镜啊，这个我熟！上次投票特别火的那个谁谁谁，就是我给挂上去的，要我说，这可都是为民除害……","voice":["vo_trial_40701_1_12"],"voice_bank":"vo_bianca_trial","style":1,"background":2219,"log_type":1,"src_id":140701012,"trial_step":12},{"step":13,"speaker":"路人乙","content":"没怎么听过这个软件啊，你们是做推广的？下载产品有礼物拿吗？","voice":["vo_trial_40701_1_13"],"voice_bank":"vo_bianca_trial","style":1,"background":2219,"log_type":1,"src_id":140701013,"trial_step":13},{"step":14,"speaker":"路人丙","content":"电视台？采访？妈妈，妈妈我要上电视了妈妈——","voice":["vo_trial_40701_1_14"],"voice_bank":"vo_bianca_trial","style":1,"background":2219,"log_type":1,"src_id":140701014,"trial_step":14},{"step":15,"speaker":"街采记者","content":"……看来市民们也都陆续回到了正常的生活节奏中，让我们再采访最后一位吧。这位小姐？您现在有空吗？","voice":["vo_trial_40701_1_15"],"voice_bank":"vo_bianca_trial","style":1,"background":2219,"log_type":1,"src_id":140701015,"trial_step":15},{"step":16,"content":"镜头下摇，对准街边一位年轻女子，她正摇晃着手中的苹果汁罐子。","style":3,"background":2219,"log_type":1,"src_id":140701016,"trial_step":16},{"step":17,"speaker":"？？","content":"采访我？","voice":["vo_trial_40701_1_17"],"voice_bank":"vo_bianca_trial","style":1,"background":2219,"log_type":1,"src_id":140701017,"trial_step":17},{"step":18,"speaker":"？？","content":"好呀好呀，码掉脸就行——之前一直在采访别人，我还没被采访过呢！","voice":["vo_trial_40701_1_18"],"voice_bank":"vo_bianca_trial","style":1,"background":2219,"log_type":1,"src_id":140701018,"trial_step":18},{"step":19,"speaker":"？？","content":"要问什么呢，最近狄斯好像没有什么特别劲爆的大新闻欸。聊聊我自己？不好意思这部分需要保密，一定要说个名字的话——啊，叫我苹果汁好了！","voice":["vo_trial_40701_1_19"],"voice_bank":"vo_bianca_trial","style":1,"background":2219,"log_type":1,"src_id":140701019,"trial_step":19},{"step":20,"content":"镜头没拍到被采者的正脸，但对方声音十分耳熟。","style":3,"background":2219,"log_type":1,"src_id":140701020,"trial_step":20},{"step":21,"speaker":"街采记者","content":"……苹果汁小姐你好，我是狄斯电视台午间新闻的记者，请问您对灰——","voice":["vo_trial_40701_1_21"],"voice_bank":"vo_bianca_trial","style":1,"background":2219,"log_type":1,"src_id":140701021,"trial_step":21},{"step":22,"content":"摄像师似乎被身后的人撞了一下，镜头晃动间捕捉到了被采人的正脸。","style":3,"background":2219,"log_type":1,"src_id":140701022,"trial_step":22},{"step":23,"content":"……啊。","style":2,"background":2219,"log_type":1,"src_id":140701023,"trial_step":23},{"step":24,"content":"过分熟悉的金发与苹果头饰，正是被通缉中的毕安卡。","style":3,"background":2219,"log_type":1,"src_id":140701024,"trial_step":24},{"step":25,"content":"新城的某条小巷中，一只猫正躺在午后的阳光中，懒洋洋梳理着毛发。","style":3,"background":2101,"log_type":1,"src_id":140701025,"trial_step":25},{"step":26,"content":"下一秒，毕安卡轻巧地翻过墙头，落在被她吓到炸毛的小猫身边。","style":3,"background":2101,"log_type":1,"src_id":140701026,"trial_step":26},{"step":27,"speaker":"毕安卡","content":"抱歉啦小猫咪——大记者跑路中，都给让、让、道啦——","voice":["vo_trial_40701_1_27"],"voice_bank":"vo_bianca_trial","style":1,"background":2101,"log_type":1,"src_id":140701027,"trial_step":27},{"step":28,"speaker":"MBCC队员","content":"她刚刚往这边跑了，跟上！","voice":["vo_trial_40701_1_28"],"voice_bank":"vo_bianca_trial","style":1,"background":2101,"log_type":1,"src_id":140701028,"trial_step":28},{"step":29,"speaker":"毕安卡","content":"哇，好热情的观众朋友！可惜今天不是采访的日子，我的调查大业还没完成，这次也得先走一步啦——","voice":["vo_trial_40701_1_29"],"voice_bank":"vo_bianca_trial","style":1,"background":2101,"log_type":1,"src_id":140701029,"trial_step":29},{"step":30,"content":"毕安卡熟练地在小巷中穿梭，将追兵甩在身后。","style":3,"background":2101,"log_type":1,"src_id":140701030,"trial_step":30},{"step":31,"speaker":"MBCC队员","content":"报告，追捕目标已脱离视野范围！要跟丢了！","voice":["vo_trial_40701_1_31"],"voice_bank":"vo_bianca_trial","style":1,"background":2101,"log_type":1,"src_id":140701031,"trial_step":31},{"step":32,"speaker":"毕安卡","content":"拜拜咯——几位小哥，咱们有缘下次再见——","voice":["vo_trial_40701_1_32"],"voice_bank":"vo_bianca_trial","style":1,"background":2101,"log_type":1,"src_id":140701032,"trial_step":32},{"step":33,"content":"年轻的记者哼着小曲儿跑过街角，转身，却差点把对面走来的人撞翻。毕安卡紧急回避，却慌乱间失去平衡倒过去。","style":3,"background":2101,"log_type":1,"src_id":140701033,"trial_step":33},{"step":34,"content":"关键时刻，她被对方扶住，终于在彻底跌倒前站稳了脚。","style":3,"background":2101,"log_type":1,"src_id":140701034,"trial_step":34},{"step":35,"speaker":"毕安卡","content":"哇！好险！！小哥你没事吧？","female_content":"哇！好险！！小姐姐你没事吧？","voice":["vo_trial_40701_1_35","vo_trial_40701_1_35f"],"voice_bank":"vo_bianca_trial","style":1,"background":2101,"log_type":1,"src_id":140701035,"trial_step":35},{"step":36,"speaker":"？？","content":"我没事，你还好吗？","voice":["vo_trial_40701_1_36"],"voice_bank":"vo_bianca_trial","style":1,"background":2101,"log_type":1,"src_id":140701036,"trial_step":36},{"step":37,"speaker":"毕安卡","content":"嘿嘿，没事没事，太谢谢你了，刚刚我差点就要和地板亲密拥抱了……","voice":["vo_trial_40701_1_37"],"voice_bank":"vo_bianca_trial","style":1,"background":2101,"log_type":1,"src_id":140701037,"trial_step":37},{"step":38,"content":"毕安卡借着这位好心人的力道起身，余光却瞟到对方灰色的风衣衣角。","style":3,"background":2101,"log_type":1,"src_id":140701038,"trial_step":38},{"step":39,"speaker":"毕安卡","content":"哇，好熟悉的场景……感觉上一次逃跑的时候也是这样，小巷，灰风衣，还有……哎呀？","voice":["vo_trial_40701_1_39"],"voice_bank":"vo_bianca_trial","style":1,"background":2101,"log_type":1,"src_id":140701039,"trial_step":39},{"step":40,"content":"熟悉就对了。","style":2,"background":2101,"log_type":1,"src_id":140701040,"trial_step":40},{"step":41,"content":"不好意思，逃跑结束。抓到你了。","style":2,"background":2101,"log_type":1,"src_id":140701043,"trial_step":43},{"step":42,"speaker":"毕安卡","content":"哎呦，我的胳膊……好局长，看在咱们也当过战友的份儿上，就不能温柔点吗？","voice":["vo_trial_40701_1_45"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701045,"trial_step":45,"drawing":1040700},{"step":43,"options":["下次一定","防止你又逃走"],"style":6,"log_type":1,"src_id":140701046,"trial_step":46,"course":3,"drawing":1040700,"choices":[{"text":"下次一定","goto":47},{"text":"防止你又逃走","goto":null}]},{"step":44,"speaker":"毕安卡","content":"呜呜呜，好狠心的小灰灰……你看看这儿，上次跳楼留下的伤还没好呢！又被你这么粗暴地抓回来，我的身体都要散架啦。","voice":["vo_trial_40701_1_47"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701047,"trial_step":47,"drawing":1040700},{"step":45,"content":"当然，你面前这人面色红润，说话中气十足，怎么看都不像是伤员。","style":3,"log_type":1,"src_id":140701048,"trial_step":48,"drawing":1040700},{"step":46,"content":"“伤还没好？”","style":2,"log_type":1,"src_id":140701049,"trial_step":49,"drawing":1040700},{"step":47,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":50,"course":6,"drawing":1040700},{"step":48,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":50,"course":6,"drawing":1040700},{"step":49,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":50,"course":6,"drawing":1040700},{"step":50,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":50,"course":6,"drawing":1040700},{"step":51,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":50,"course":6,"drawing":1040700},{"step":52,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":50,"course":6,"drawing":1040700},{"step":53,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":50,"course":6,"drawing":1040700},{"step":54,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":50,"course":6,"drawing":1040700},{"step":55,"content":"这是一份关于毕安卡的搜捕记录。她从高楼一跃而下后就失踪了，你带着追踪队找了半个月，最后无功而返。","style":3,"log_type":1,"src_id":140701051,"trial_step":51,"drawing":1040704},{"step":56,"content":"毕安卡的目击报告再次出现时，你确实松了口气，但紧接着就是无休止的头痛。","style":3,"log_type":1,"src_id":140701052,"trial_step":52,"drawing":1040704},{"step":57,"content":"在追缉期间，共计目击次数14次，其中8次MBCC赶到现场时她已经离开，另外6次则是甩开追踪队后再次逃离。","style":3,"log_type":1,"src_id":140701053,"trial_step":53,"drawing":1040704},{"step":58,"content":"文件额外附赠了尤金队长给出的评价：追捕对象身手敏捷，行动狡猾，建议多组围堵行动。","style":3,"log_type":1,"src_id":140701054,"trial_step":54,"drawing":1040704},{"step":59,"options":["这就是你说的伤还没好？"],"style":6,"log_type":1,"src_id":140701055,"trial_step":55,"course":3,"drawing":1040704,"choices":[{"text":"这就是你说的伤还没好？","goto":56}]},{"step":60,"speaker":"毕安卡","content":"也就是夸张了一点点而已，小灰灰你真是没有幽默细胞。人家到处跑不也是为了进行田野调查，好继续惩恶扬善嘛。","voice":["vo_trial_40701_1_56"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701056,"trial_step":56,"drawing":1040702},{"step":61,"speaker":"毕安卡","content":"而且我保证！以记者的名誉发誓，毕安卡绝对已经悔过自新痛改前非了！","voice":["vo_trial_40701_1_57"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701057,"trial_step":57,"drawing":1040702},{"step":62,"content":"毕安卡说得信誓旦旦，但说服力实在不高。","style":3,"log_type":1,"src_id":140701058,"trial_step":58,"drawing":1040702},{"step":63,"content":"至少真心悔改的家伙也不会直到今天才“不小心”落网。","style":2,"log_type":1,"src_id":140701059,"trial_step":59,"drawing":1040700},{"step":64,"content":"来聊聊你这段时间干的事情吧。根据目击情报来看，你这段时间的活动范围很广，几乎布满了整个新城，甚至还走到了锈河附近？","style":2,"log_type":1,"src_id":140701060,"trial_step":60,"drawing":1040700},{"step":65,"content":"锈河是禁止普通居民踏入的隔离区，你过去干什么？","style":2,"log_type":1,"src_id":140701061,"trial_step":61,"drawing":1040700},{"step":66,"speaker":"毕安卡","content":"嘿嘿，既然你诚心诚意地问了，那么大记者苹果汁就慷慨地来分享一下吧——","voice":["vo_trial_40701_1_62"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701062,"trial_step":62,"drawing":1040703},{"step":67,"speaker":"毕安卡","content":"我跋山涉水四处调查，终于为MBCC带回了重量级的超级大案件！即使被通缉也一定、一定要调查清楚的那种哦！","voice":["vo_trial_40701_1_63"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701063,"trial_step":63,"drawing":1040703},{"step":68,"content":"你听懂了，这句话读作“超级大案件”，写为“麻烦又来了”。","style":3,"log_type":1,"src_id":140701064,"trial_step":64,"drawing":1040700},{"step":69,"content":"……有种不详的预感。","style":2,"log_type":1,"src_id":140701065,"trial_step":65,"drawing":1040700},{"step":70,"speaker":"毕安卡","content":"拜托了！这次真的是正经的惩恶扬善啦，你一定会感兴趣的！","voice":["vo_trial_40701_1_66"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701066,"trial_step":66,"drawing":1040703},{"step":71,"content":"毕安卡拿出一本厚厚的笔记，献宝式地放在你面前，摊开到其中一页。","style":3,"log_type":1,"src_id":140701067,"trial_step":67,"drawing":1040703},{"step":72,"speaker":"毕安卡","content":"听一下嘛，就听一小下？","voice":["vo_trial_40701_1_68"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701068,"trial_step":68,"drawing":1040703},{"step":73,"content":"熟悉的纠缠，熟悉的热情。上一次你没能拒绝她是为了糊弄追查灰镜的普通记者，但现在你已经充分了解了毕安卡对目标的过分执着。","style":3,"log_type":1,"src_id":140701069,"trial_step":69,"drawing":1040703},{"step":74,"content":"如果在这里拒绝她，说不定毕安卡又会做出什么预料之外的事情。与其这样，不如自己把握风险。","style":3,"log_type":1,"src_id":140701070,"trial_step":70,"drawing":1040703},{"step":75,"content":"行吧，说来听听。","style":2,"log_type":1,"src_id":140701071,"trial_step":71,"drawing":1040703},{"step":76,"speaker":"毕安卡","content":"锵锵，请看这里！","voice":["vo_trial_40701_1_72"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701072,"trial_step":72,"drawing":1040700},{"step":77,"speaker":"毕安卡","content":"科恩集团，一家主打清洁能源的新兴公司，营销做得火热，也有不少人愿意为此买单，于是他们靠着投资人和傻子的钱快速发家……","voice":["vo_trial_40701_1_73"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701073,"trial_step":73,"drawing":1040700},{"step":78,"speaker":"毕安卡","content":"看起来很正常对不对？不过，敏锐的毕安卡在中间嗅到了一丝不同寻常的味道……","voice":["vo_trial_40701_1_74"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701074,"trial_step":74,"drawing":1040700},{"step":79,"content":"她在纸面上点了点。“废料处理厂”与“异常排污”两个词段被人用笔重重地圈起来了。","style":3,"log_type":1,"src_id":140701075,"trial_step":75,"drawing":1040700},{"step":80,"speaker":"毕安卡","content":"在调查这个所谓清洁能源时，我意外发现了他们有几处未公开地址的废料处理厂，连暗网上都没什么人知道。明明号称“清洁能源”，但却把这几座厂子的位置捂得那么严？","voice":["vo_trial_40701_1_76"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701076,"trial_step":76,"drawing":1040700},{"step":81,"speaker":"毕安卡","content":"于是，在经过足够充分地走访调查后——","voice":["vo_trial_40701_1_77"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701077,"trial_step":77,"drawing":1040700},{"step":82,"content":"她指了指那份追踪记录上关于自己的行动轨迹。","style":3,"log_type":1,"src_id":140701078,"trial_step":78,"drawing":1040700},{"step":83,"speaker":"毕安卡","content":"终于在某个线人口中挖到了这些神秘处理厂的具体地址：所有厂房都布在新城外，几乎要进入锈河隔离区。","voice":["vo_trial_40701_1_79"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701079,"trial_step":79,"drawing":1040700},{"step":84,"speaker":"毕安卡","content":"可疑，超级可疑！没几个新城企业愿意在锈河附近建厂子，除非他们存心想倒闭，又或者……","voice":["vo_trial_40701_1_80"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701080,"trial_step":80,"drawing":1040700},{"step":85,"options":["为了利益","为了遮掩"],"style":6,"log_type":1,"src_id":140701081,"trial_step":81,"course":3,"drawing":1040700,"choices":[{"text":"为了利益","goto":82},{"text":"为了遮掩","goto":84}]},{"step":86,"content":"是因为这样能获得更大的利益？","style":2,"log_type":1,"src_id":140701082,"trial_step":82,"drawing":1040700},{"step":87,"speaker":"毕安卡","content":"bingo！小灰灰加五分，但你还是把这些资本家想得太善良啦。","voice":["vo_trial_40701_1_83"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701083,"trial_step":83,"drawing":1040703,"next":[86]},{"step":88,"content":"是为了借锈河来掩盖什么东西？","style":2,"log_type":1,"src_id":140701084,"trial_step":84,"drawing":1040700},{"step":89,"speaker":"毕安卡","content":"bingo！小灰灰加十分！","voice":["vo_trial_40701_1_85"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701085,"trial_step":85,"drawing":1040703,"next":[86]},{"step":90,"speaker":"毕安卡","content":"那位好心的知情者还送给了我这位老客户一条额外情报——","voice":["vo_trial_40701_1_86"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701086,"trial_step":86,"drawing":1040700},{"step":91,"content":"毕安卡的指尖掠过其他几个词条，落在整篇文段的最后。","style":3,"log_type":1,"src_id":140701087,"trial_step":87,"drawing":1040700},{"step":92,"speaker":"毕安卡","content":"“异常排污”。他们好像就是在藏这个。","voice":["vo_trial_40701_1_88"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701088,"trial_step":88,"drawing":1040700},{"step":93,"speaker":"毕安卡","content":"总而言之，勇敢的毕安卡决定亲赴险境，前往危机重重的锈河寻找被掩埋的正义与真相，一路过关斩将东躲西藏终于混进了他们的厂房里，拍下了超级重要的证据！","voice":["vo_trial_40701_1_89"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701089,"trial_step":89,"drawing":1040701},{"step":94,"options":["都是你自己拍的？"],"style":6,"log_type":1,"src_id":140701090,"trial_step":90,"course":3,"drawing":1040701,"choices":[{"text":"都是你自己拍的？","goto":91}]},{"step":95,"speaker":"毕安卡","content":"没错！","voice":["vo_trial_40701_1_91"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701091,"trial_step":91,"drawing":1040703},{"step":96,"speaker":"毕安卡","content":"哇，去过一次才发现，原来锈河外围的狂厄浓度也高得可以！换个普通人来估计走两步就趴下了！","voice":["vo_trial_40701_1_92"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701092,"trial_step":92,"drawing":1040703},{"step":97,"speaker":"毕安卡","content":"……诶呀？局长你的表情好严肃，该不会是担心了？别看我这样，之前可是狄斯电视台反手摄影大赛冠军呢。","voice":["vo_trial_40701_1_93"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701093,"trial_step":93,"drawing":1040702},{"step":98,"speaker":"毕安卡","content":"更何况成为禁闭者之后，好像身体素质又变强了那么一点点，感觉被追的时候跑得更快了——咳咳，不过是偷偷潜入而已，小意思啦~","voice":["vo_trial_40701_1_94"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701094,"trial_step":94,"drawing":1040702},{"step":99,"content":"毕安卡拿出平时不离身的摄像机，招呼你过去看小屏幕。","style":3,"log_type":1,"src_id":140701095,"trial_step":95,"drawing":1040700},{"step":100,"speaker":"毕安卡","content":"这段是工厂外景，这段是厂房内的机床，这段是我被门口保安发现然后一路被追到锈河的时候——","voice":["vo_trial_40701_1_96"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701096,"trial_step":96,"drawing":1040700},{"step":101,"content":"镜头很晃，能看出似乎是拍摄者在奔跑过程中匆匆留下的影像。","style":3,"background":302,"log_type":1,"src_id":140701097,"trial_step":97},{"step":102,"content":"画面中心是巨大的机械，侧旁几个穿着防护服的工人进进出出，似乎在搬运着什么。除了工厂位置比较奇怪以外，一切看起来似乎只是正常的工作场景。","style":3,"background":302,"log_type":1,"src_id":140701098,"trial_step":98},{"step":103,"content":"直到拍摄者将视角拉近，你才看出一些端倪。","style":3,"background":302,"log_type":1,"src_id":140701099,"trial_step":99},{"step":104,"content":"好厚的防护服，这里的防护等级远没到这种级别。","style":2,"background":302,"log_type":1,"src_id":140701100,"trial_step":100},{"step":105,"speaker":"毕安卡","content":"不仅如此，请看这里——他们搬运的东西也很奇怪，明明是污水处理厂，但大多数机器都在加工别的东西。","voice":["vo_trial_40701_1_101"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140701101,"trial_step":101},{"step":106,"speaker":"毕安卡","content":"还有一箱箱的不明物体，如果只是处理废料，应该没有那么多需要运输的东西？","voice":["vo_trial_40701_1_102"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140701102,"trial_step":102},{"step":107,"options":["确实很可疑……"],"style":6,"background":302,"log_type":1,"src_id":140701103,"trial_step":103,"course":3,"choices":[{"text":"确实很可疑……","goto":104}]},{"step":108,"content":"确实，如果要藏什么不能见光的东西，锈河是个不错的选择。","style":2,"background":302,"log_type":1,"src_id":140701104,"trial_step":104},{"step":109,"content":"正常企业压根不会想把手下的棋子摆到锈河，但也正因如此，锈河外围似乎形成了一块类似灯下黑的微妙区域。","style":3,"background":302,"log_type":1,"src_id":140701105,"trial_step":105},{"step":110,"content":"普通市民的案子归治安局管，但锈河涉及狂厄污染，由MBCC出手倒也合情合理。或许在现场调查后会获得更多线索。","style":3,"background":302,"log_type":1,"src_id":140701106,"trial_step":106},{"step":111,"content":"毕安卡，你刚刚说的工厂位置在哪——","style":2,"background":302,"log_type":1,"src_id":140701107,"trial_step":107},{"step":112,"content":"你抬头，这才发现毕安卡一脸“上钩了吧”的表情看着你。","style":3,"log_type":1,"src_id":140701108,"trial_step":108,"drawing":1040702},{"step":113,"speaker":"毕安卡","content":"怎么样，感兴趣啦？我没骗你吧，这可是个超级劲爆的大案子，能上年度新闻的那种！","voice":["vo_trial_40701_1_109"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701109,"trial_step":109,"drawing":1040702},{"step":114,"options":["别岔开话题"],"style":6,"log_type":1,"src_id":140701110,"trial_step":110,"course":3,"drawing":1040702,"choices":[{"text":"别岔开话题","goto":111}]},{"step":115,"content":"别岔开话题，我还没追究你私自跑去锈河的事情呢。","style":2,"log_type":1,"src_id":140701111,"trial_step":111,"drawing":1040702},{"step":116,"speaker":"毕安卡","content":"嘿嘿，当记者的事儿，这叫暗访，暗访调查。","voice":["vo_trial_40701_1_112"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701112,"trial_step":112,"drawing":1040703},{"step":117,"speaker":"毕安卡","content":"总之，现在线索明确，只差调查证据，看看这些家伙是不是真的有罪。","voice":["vo_trial_40701_1_113"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701113,"trial_step":113,"drawing":1040700},{"step":118,"speaker":"毕安卡","content":"按理说这种事儿是该交给治安局啦……不过除此以外，你看，咱们或许还有个更隐蔽、更巧妙的解决办法？","voice":["vo_trial_40701_1_114"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701114,"trial_step":114,"drawing":1040702},{"step":119,"content":"感动不过三秒。你看着毕安卡狡猾的笑脸，顿感不妙。","style":3,"log_type":1,"src_id":140701115,"trial_step":115,"drawing":1040702},{"step":120,"speaker":"毕安卡","content":"最善良的小灰灰，最亲爱的局长大人——","voice":["vo_trial_40701_1_116"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701116,"trial_step":116,"drawing":1040702},{"step":121,"speaker":"毕安卡","content":"要和我一起亲自调查，曝光黑暗惩罚坏蛋吗？","voice":["vo_trial_40701_1_117"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701117,"trial_step":117,"drawing":1040702},{"step":122,"options":["不行"],"style":6,"log_type":1,"src_id":140701118,"trial_step":118,"course":3,"drawing":1040702,"choices":[{"text":"不行","goto":119}]},{"step":123,"content":"一码归一码，MBCC有义务监管你的行动。","style":2,"log_type":1,"src_id":140701119,"trial_step":119,"drawing":1040704},{"step":124,"content":"作为灰镜投票事件的主要引导者之一，毕安卡原本需要由治安局定罪。但由于禁闭者的特殊性，她现在被交由MBCC管理——在确认毕安卡危险性降低前，禁止对象一切外出活动。","style":3,"log_type":1,"src_id":140701120,"trial_step":120,"drawing":1040704},{"step":125,"speaker":"毕安卡","content":"只是需要来自局长你的批准，以及一台能联网的电脑而已，绝对绝对不会添麻烦的！","voice":["vo_trial_40701_1_121"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701121,"trial_step":121,"drawing":1040704},{"step":126,"content":"真的？","style":2,"log_type":1,"src_id":140701122,"trial_step":122,"drawing":1040704},{"step":127,"speaker":"毕安卡","content":"当然，如果能有亲亲局长允许外出的话就更好啦。","voice":["vo_trial_40701_1_123"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701123,"trial_step":123,"drawing":1040703},{"step":128,"speaker":"毕安卡","content":"我还没来得及去另外几个排污工厂，说不定里面还藏着更劲爆的线索呢？","voice":["vo_trial_40701_1_124"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701124,"trial_step":124,"drawing":1040703},{"step":129,"content":"上次你调查灰镜的时候也是这么说的。","style":2,"log_type":1,"src_id":140701125,"trial_step":125,"drawing":1040703},{"step":130,"speaker":"毕安卡","content":"是吗？嘿嘿，此时非彼时，我这不是也认识到自己的错误，改邪归正了嘛。","voice":["vo_trial_40701_1_126"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701126,"trial_step":126,"drawing":1040704},{"step":131,"content":"毕安卡清了清嗓子，挺胸抬头，一副好好学生的样子继续开口。","style":3,"log_type":1,"src_id":140701127,"trial_step":127,"drawing":1040700},{"step":132,"speaker":"毕安卡","content":"局长说得对，确实做错事就该认罚——不过这次的情况真的不一样！总不能放任他们继续做坏事，说不定会导致更严重更可怕的结果！","voice":["vo_trial_40701_1_128"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701128,"trial_step":128,"drawing":1040700},{"step":133,"speaker":"毕安卡","content":"所以，这次就算是放我一马，当是将功补过了好不好？","voice":["vo_trial_40701_1_129"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701129,"trial_step":129,"drawing":1040700},{"step":134,"options":["……"],"style":6,"log_type":1,"src_id":140701130,"trial_step":130,"course":3,"drawing":1040700,"choices":[{"text":"……","goto":131}]},{"step":135,"content":"毕安卡可怜巴巴地看着你，语气真诚又恳切。","style":3,"log_type":1,"src_id":140701131,"trial_step":131,"drawing":1040700},{"step":136,"content":"你们因灰镜事件相识，真正相处的时间满打满算不过几天。你了解她对贯彻正义、曝光黑暗的绝对热情，但她也有差点掀翻整座城市的前科。","style":3,"log_type":1,"src_id":140701132,"trial_step":132,"drawing":1040700},{"step":137,"content":"毕安卡这次调查的目的是否单纯？你对此仍抱有怀疑。","style":3,"log_type":1,"src_id":140701133,"trial_step":133,"drawing":1040700},{"step":138,"speaker":"毕安卡","content":"${PlayerName}？局长？小灰灰？事成之后请你喝苹果汁，十罐，三十罐？不不——一百罐苹果汁！","voice":["vo_trial_40701_1_134"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701134,"trial_step":134,"drawing":1040703},{"step":139,"content":"你本应该直接拒绝她。但如她所言，这似乎确实也是个好机会。","style":3,"log_type":1,"src_id":140701135,"trial_step":135,"drawing":1040703},{"step":140,"content":"这位曾经“误入歧途”的记者，事到如今到底会不会再次选择那条老路？或许你能在与她同行的调查中获得答案。","style":3,"log_type":1,"src_id":140701136,"trial_step":136,"drawing":1040703},{"step":141,"options":["我知道了"],"style":6,"log_type":1,"src_id":140701137,"trial_step":137,"course":3,"drawing":1040703,"choices":[{"text":"我知道了","goto":138}]},{"step":142,"content":"……我知道了，我会陪你一起去的。","style":2,"log_type":1,"src_id":140701138,"trial_step":138,"drawing":1040703},{"step":143,"speaker":"毕安卡","content":"好耶！赞美小灰灰，世界第一好的亲亲局长！！","voice":["vo_trial_40701_1_139"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701139,"trial_step":139,"drawing":1040701},{"step":144,"speaker":"毕安卡","content":"放心吧局长这回我绝对老实做人规矩做事你说打东边我就不打西边——","voice":["vo_trial_40701_1_140"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701140,"trial_step":140,"drawing":1040701},{"step":145,"options":["别高兴太早"],"style":6,"log_type":1,"src_id":140701141,"trial_step":141,"course":3,"drawing":1040701,"choices":[{"text":"别高兴太早","goto":142}]},{"step":146,"content":"MBCC有一整套与禁闭者外出相关的规章条例，我会陪你一起去，但你也得遵守规定。","style":2,"log_type":1,"src_id":140701142,"trial_step":142,"drawing":1040701},{"step":147,"content":"低调行动，不擅自使用能力，不脱离监视单独行动。基本就是这些。","style":2,"log_type":1,"src_id":140701143,"trial_step":143,"drawing":1040701},{"step":148,"speaker":"毕安卡","content":"嘿嘿，明白。低调潜入嘛，我们当记者的最会干这个了。","voice":["vo_trial_40701_1_144"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701144,"trial_step":144,"drawing":1040703},{"step":149,"content":"毕安卡笑嘻嘻地比了个“交给我吧”的手势。但你怀疑她是否真的理解何为低调。","style":3,"log_type":1,"src_id":140701145,"trial_step":145,"drawing":1040703},{"step":150,"speaker":"毕安卡","content":"调查再开，这次冒险是久别重逢的搭档——正义使者小灰灰，以及苹果超人毕安卡的再度联手！","voice":["vo_trial_40701_1_146"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701146,"trial_step":146,"drawing":1040703},{"step":151,"speaker":"毕安卡","content":"事不宜迟，立刻出发吧！","voice":["vo_trial_40701_1_147"],"voice_bank":"vo_bianca_trial","style":1,"log_type":1,"src_id":140701147,"trial_step":147,"drawing":1040703}]}