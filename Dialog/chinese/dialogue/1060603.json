{"id":1060603,"chapter_id":1060603,"scene_id":1,"steps":[{"step":1,"speaker":"局长","content":"还有多少时间？","style":2,"background":2002,"log_type":1,"src_id":160603002,"trial_step":2},{"step":2,"speaker":"FAC","content":"根据我们对东洲载具的估算，六小时后嫌疑人杜若就有可能进入其他城邦地界。","voice":["vo_trial_60603_1_2"],"voice_bank":"vo_duruo_trial","style":1,"background":2002,"log_type":1,"src_id":160603003,"trial_step":3},{"step":3,"speaker":"FAC","content":"如果我们没追上，那就只能等着上头发质询信了。","voice":["vo_trial_60603_1_3"],"voice_bank":"vo_duruo_trial","style":1,"background":2002,"log_type":1,"src_id":160603004,"trial_step":4},{"step":4,"content":"你跟随FAC部队一路追踪，深入砂海腹地。枷锁的感应也逐渐清晰。","style":3,"background":2002,"log_type":1,"src_id":160603005,"trial_step":5},{"step":5,"speaker":"局长","content":"不会到那一步的。六个小时，来得及。","style":2,"background":2002,"log_type":1,"src_id":160603006,"trial_step":6},{"step":6,"content":"你为部队大致指明了方位，船只全速前进。","style":3,"background":2002,"log_type":1,"src_id":160603007,"trial_step":7},{"step":7,"content":"透过监视窗向外看去，偌大的砂海无边无际，你们只能依靠热力雷达搜寻附近的生命体。","style":3,"background":2004,"log_type":1,"src_id":160603008,"trial_step":8},{"step":8,"speaker":"FAC","content":"快看，这里有东西！","voice":["vo_trial_60603_1_8"],"voice_bank":"vo_duruo_trial","style":1,"background":2004,"log_type":1,"src_id":160603009,"trial_step":9},{"step":9,"content":"掌舵的士兵发出惊呼，你循声看去。","style":3,"background":2004,"log_type":1,"src_id":160603010,"trial_step":10},{"step":10,"content":"雷达中，一个新生的红点正在一步步向你们靠近，直到监视窗前也出现了模糊的人影。","style":3,"background":2004,"log_type":1,"src_id":160603011,"trial_step":11},{"step":11,"speaker":"FAC","content":"这是……","voice":["vo_trial_60603_1_11"],"voice_bank":"vo_duruo_trial","style":1,"background":2004,"log_type":1,"src_id":160603012,"trial_step":12},{"step":12,"content":"还没等你们探清虚实，船底的沙石开始涌动。","style":3,"background":2002,"log_type":1,"src_id":160603013,"trial_step":13},{"step":13,"speaker":"FAC","content":"是流沙？！","voice":["vo_trial_60603_1_13"],"voice_bank":"vo_duruo_trial","style":1,"background":2002,"log_type":1,"src_id":160603014,"trial_step":14},{"step":14,"content":"你的枷锁也在这时给了你确切的回应——眼前的黑影不是你所感知到的禁闭者。","style":3,"background":2002,"log_type":1,"src_id":160603015,"trial_step":15},{"step":15,"options":["是陷阱！"],"style":6,"background":2002,"log_type":1,"src_id":160603016,"trial_step":16,"course":3,"choices":[{"text":"是陷阱！","goto":17}]},{"step":16,"content":"小范围的流沙急速扩大，方圆百米的砂石像漩涡一样向你们所在的方位聚集。","style":3,"background":2002,"log_type":1,"src_id":160603017,"trial_step":17},{"step":17,"content":"狂风卷起沙石，船舱在剧烈的颠簸下开始出现故障，照明与仪表接连失灵，狭小的船舱内警铃大作。","style":3,"background":2002,"log_type":1,"src_id":160603018,"trial_step":18},{"step":18,"speaker":"FAC","content":"离开船舱，快！逃出去！不然会被沙子埋——","voice":["vo_trial_60603_1_18"],"voice_bank":"vo_duruo_trial","style":1,"background":2002,"log_type":1,"src_id":160603019,"trial_step":19},{"step":19,"content":"士兵还没把话说完，沙暴已经冲破了防护涌入舱内，你的四周顷刻间一片漆黑。","style":3,"background":10000,"log_type":1,"src_id":160603020,"trial_step":20},{"step":20,"content":"伴随流沙带来的窒息感，你昏了过去。","style":3,"background":10000,"log_type":1,"src_id":160603021,"trial_step":21},{"step":21,"content":"不知过了多久，你终于恢复了意识。","style":3,"background":10000,"log_type":1,"src_id":160603022,"trial_step":22},{"step":22,"content":"恍惚中你能够察觉自己正躺在一块硬物上。","style":3,"background":10000,"log_type":1,"src_id":160603023,"trial_step":23},{"step":23,"content":"肩胛骨传来轻微的酸痛，你下意识侧身，却同时嗅到空气里浮动的熏香，非常熟悉。","style":3,"background":10000,"log_type":1,"src_id":160603024,"trial_step":24},{"step":24,"options":["杜若？"],"style":6,"background":10000,"log_type":1,"src_id":160603025,"trial_step":25,"course":3,"choices":[{"text":"杜若？","goto":26}]},{"step":25,"content":"强光刺目，你被迫眯眼。四周是简陋的篷布。你逆光看见屋内还有一个人影，她坐在风化的石墩旁，支着脑袋，伸手拨弄着一个罗盘。","style":3,"background":2006,"log_type":1,"src_id":160603026,"trial_step":26},{"step":26,"content":"听到你这边的动静，她侧过头，还是初见时那一肚子坏水的微笑。","style":3,"background":2006,"log_type":1,"src_id":160603027,"trial_step":27},{"step":27,"speaker":"杜若","content":"晕倒了还要喊我的名字，就这么思念我吗？","voice":["vo_trial_60603_1_27"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603028,"trial_step":28},{"step":28,"options":["你救了我？"],"style":6,"background":2006,"log_type":1,"src_id":160603029,"trial_step":29,"course":3,"choices":[{"text":"你救了我？","goto":30}]},{"step":29,"speaker":"杜若","content":"是啊，我好好地走在回家路上，突然听到身后一阵巨响，回头一看——呵呵……好大一只船掉在砂海里。你说巧不巧，我就在那里捡到了你。","voice":["vo_trial_60603_1_29"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603030,"trial_step":30},{"step":30,"options":["……你能编得再靠谱点吗","哇，我差点就信了"],"style":6,"background":2006,"log_type":1,"src_id":160603031,"trial_step":31,"course":3,"choices":[{"text":"……你能编得再靠谱点吗","goto":32},{"text":"哇，我差点就信了","goto":null}]},{"step":31,"speaker":"杜若","content":"那你想听什么？我都能配合。说我专程设下了陷阱，等局长跳进来？","voice":["vo_trial_60603_1_31"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603032,"trial_step":32},{"step":32,"content":"杜若笑意盈盈，让你有些琢磨不透。","style":3,"background":2006,"log_type":1,"src_id":160603033,"trial_step":33},{"step":33,"options":["为什么这么做？"],"style":6,"background":2006,"log_type":1,"src_id":160603034,"trial_step":34,"course":3,"choices":[{"text":"为什么这么做？","goto":35}]},{"step":34,"speaker":"杜若","content":"我做的事可太多了，你问的究竟是哪一个？","voice":["vo_trial_60603_1_34"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603035,"trial_step":35},{"step":35,"speaker":"局长","content":"全部。为什么入侵资料库，为什么提前离境，为什么在奇兰广场边上要和我说那些，还有——","style":2,"background":2006,"log_type":1,"src_id":160603036,"trial_step":36},{"step":36,"speaker":"局长","content":"消灭使徒后你到底为什么又要重新回到狄斯，真的只是为了“狄斯神话”吗？","style":2,"background":2006,"log_type":1,"src_id":160603037,"trial_step":37},{"step":37,"content":"你挣扎着从石床上坐起。手掌一下撑在石床边缘，掌心传来刺痛。大概是从船上跌倒时受了伤，但你也顾不得这么多。","style":3,"background":2006,"log_type":1,"src_id":160603038,"trial_step":38},{"step":38,"speaker":"局长","content":"现在不是开玩笑的时候。你不回到狄斯，很有可能会引起狄斯与虞渊甚至整个东洲的外交矛盾。","style":2,"background":2006,"log_type":1,"src_id":160603039,"trial_step":39},{"step":39,"speaker":"局长","content":"FAC有丰富的流沙作战经验，他们很快就能定位到我们的位置。你会被会强行带走。","style":2,"background":2006,"log_type":1,"src_id":160603040,"trial_step":40},{"step":40,"speaker":"杜若","content":"那如果，我不让他们找到呢？","voice":["vo_trial_60603_1_40"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603041,"trial_step":41},{"step":41,"content":"她刻意把玩起手边那只罗盘。","style":3,"background":2006,"log_type":1,"src_id":160603042,"trial_step":42},{"step":42,"speaker":"杜若","content":"我知道狄斯技术过人，倒也一直想试试，你们的科技遇上东洲的奇门之术，究竟有多少胜算。","voice":["vo_trial_60603_1_42"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603043,"trial_step":43},{"step":43,"speaker":"局长","content":"那是什么？","style":2,"background":2006,"log_type":1,"src_id":160603044,"trial_step":44},{"step":44,"speaker":"杜若","content":"能让那些士兵发现我们的坐标，却永远找不到我们的东西。虽然我也只是懂些皮毛，但为你们的船只设点小麻烦也足够了。","voice":["vo_trial_60603_1_44"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603045,"trial_step":45},{"step":45,"speaker":"杜若","content":"跟我回东洲吧，你不用担心什么城邦矛盾，砂海危机四伏，就当我和你在奔逃途中失踪，生死未卜。狄斯与东洲都没有证据相互发难。","voice":["vo_trial_60603_1_45"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603046,"trial_step":46},{"step":46,"content":"她如今丝毫不避讳自己的计划，反倒神色自若的向你靠近，要为你治疗伤口。","style":3,"background":2006,"log_type":1,"src_id":160603047,"trial_step":47},{"step":47,"content":"可看到她靠近，你却下意识躲开了。","style":3,"background":2006,"log_type":1,"src_id":160603048,"trial_step":48},{"step":48,"speaker":"局长","content":"你还没有回答我，你真的是来窃取狄斯机密的吗？","style":2,"background":2006,"log_type":1,"src_id":160603049,"trial_step":49},{"step":49,"speaker":"杜若","content":"……","voice":["vo_trial_60603_1_49"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603050,"trial_step":50},{"step":50,"content":"那双将要为你治疗的手悬在半空。","style":3,"background":2006,"log_type":1,"src_id":160603051,"trial_step":51},{"step":51,"speaker":"杜若","content":"原来还是不相信我。","voice":["vo_trial_60603_1_51"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603052,"trial_step":52},{"step":52,"options":["相信","不相信"],"style":6,"background":2006,"log_type":1,"src_id":160603053,"trial_step":53,"course":3,"choices":[{"text":"相信","goto":54},{"text":"不相信","goto":55}]},{"step":53,"speaker":"局长","content":"我不但相信你，甚至在议会怀疑你访学目的时，为你争取自证的机会。可只靠我的信任，解释不了你反常的“背叛”。","style":2,"background":2006,"log_type":1,"src_id":160603054,"trial_step":54,"next":[56]},{"step":54,"speaker":"局长","content":"从一开始的入境申请，再到如今的“背叛”。我已经不知道你究竟哪句话才可信了。","style":2,"background":2006,"log_type":1,"src_id":160603055,"trial_step":55,"next":[56]},{"step":55,"speaker":"局长","content":"你把我拐到这里，让狄斯人认为我牺牲了，然后呢？像你在奇兰广场边说的那样，带我去东洲吗？带回去之后又打算做什么，逼我吐露黑环真相？","style":2,"background":2006,"log_type":1,"src_id":160603056,"trial_step":56},{"step":56,"content":"她听着你的质疑，笑意越来越冷。","style":3,"background":2006,"log_type":1,"src_id":160603057,"trial_step":57},{"step":57,"speaker":"杜若","content":"不需要劳烦你告诉我关于黑环的事了，我入侵资料库后全都看到了。","voice":["vo_trial_60603_1_57"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603058,"trial_step":58},{"step":58,"speaker":"杜若","content":"002、001、004我都看到了。看到你被欺瞒、试探、利用甚至舍弃。","voice":["vo_trial_60603_1_58"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603059,"trial_step":59},{"step":59,"speaker":"杜若","content":"可到头来，你还是会为了这样的狄斯怀疑我。","voice":["vo_trial_60603_1_59"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603060,"trial_step":60},{"step":60,"content":"杜若苦笑，深吸一口气，唇角抿成了一条线。","style":3,"background":2006,"log_type":1,"src_id":160603061,"trial_step":61},{"step":61,"speaker":"杜若","content":"我为什么回来，为什么和你一起访学强行建立枷锁，为什么入侵资料库，又为什么提前离境、费劲心机在砂海谋划这个陷阱，这些你真的……","voice":["vo_trial_60603_1_61"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603062,"trial_step":62},{"step":62,"speaker":"杜若","content":"真的不知道吗？","voice":["vo_trial_60603_1_62"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603063,"trial_step":63},{"step":63,"speaker":"局长","content":"你应该清楚，狄斯不会允许再让你入境。","style":2,"log_type":1,"src_id":160603065,"trial_step":65,"drawing":1060600},{"step":64,"speaker":"杜若","content":"所以我征询的不是狄斯的意见。我指名自愿接受的，是MBCC局长${PlayerName}的调查。","voice":["vo_trial_60601_1_49"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160603066,"trial_step":66,"drawing":1060600},{"step":65,"speaker":"杜若","content":"难道……你不希望我回来吗？","voice":["vo_trial_60601_1_50"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160603067,"trial_step":67,"drawing":1060601},{"step":66,"speaker":"杜若","content":"不来陪我一同编写这本名为狄斯的神话吗？一定有人期待在故事里看到你。","voice":["vo_trial_60601_1_105"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160603068,"trial_step":68,"drawing":1060600},{"step":67,"speaker":"局长","content":"……你的同乡们还有这种爱好？","style":2,"log_type":1,"src_id":160603069,"trial_step":69,"drawing":1060600},{"step":68,"speaker":"杜若","content":"有啊，比如我~给我一个在故事里写下你名字的机会吧，就当成全一下我的个人趣味？","voice":["vo_trial_60601_1_107"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160603070,"trial_step":70,"drawing":1060600},{"step":69,"speaker":"杜若","content":"……可惜，我马上就要走了，看不到雕像被修好的样子了。","voice":["vo_trial_60602_1_103"],"voice_bank":"vo_duruo_trial","style":1,"background":2153,"log_type":1,"src_id":160603071,"trial_step":71},{"step":70,"speaker":"杜若","content":"下次，我想带上一个茶案，一把好茶壶，我们一人一杯，慢慢地对饮，望月赏奇兰，枯坐到天明。","voice":["vo_trial_60602_1_104"],"voice_bank":"vo_duruo_trial","style":1,"background":2153,"log_type":1,"src_id":160603072,"trial_step":72},{"step":71,"speaker":"杜若","content":"既然如此，不如我把局长绑去东洲？","voice":["vo_trial_60602_1_118"],"voice_bank":"vo_duruo_trial","style":1,"background":2153,"log_type":1,"src_id":160603073,"trial_step":73},{"step":72,"speaker":"杜若","content":"东洲虽然没有奇兰雕像，没有新城的霓虹大厦，但金猊的舞狮、虞渊的茶道也都值得一看。","voice":["vo_trial_60602_1_119"],"voice_bank":"vo_duruo_trial","style":1,"background":2153,"log_type":1,"src_id":160603074,"trial_step":74},{"step":73,"speaker":"局长","content":"啊？所以你做这些都是——","style":2,"background":2006,"log_type":1,"src_id":160603075,"trial_step":75},{"step":74,"options":["为了我？"],"style":6,"background":2006,"log_type":1,"src_id":160603076,"trial_step":76,"course":3,"choices":[{"text":"为了我？","goto":77}]},{"step":75,"speaker":"杜若","content":"我多希望你能像对待那些无关紧要的谎言一样，早早拆穿我的目的。","voice":["vo_trial_60603_1_76"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603077,"trial_step":77},{"step":76,"speaker":"杜若","content":"这样我也不必亲自去资料库验证你的处境了。","voice":["vo_trial_60603_1_77"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603078,"trial_step":78},{"step":77,"speaker":"局长","content":"连入侵数据库也是因为我？","style":2,"background":2006,"log_type":1,"src_id":160603079,"trial_step":79},{"step":78,"content":"你有些不可置信，情况一团乱麻，手腕传来一阵阵的钝痛。见你沉吟不语，杜若上前。","style":3,"background":2006,"log_type":1,"src_id":160603080,"trial_step":80},{"step":79,"speaker":"杜若","content":"手腕的伤，先给我看看吧。","voice":["vo_trial_60603_1_80"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603081,"trial_step":81},{"step":80,"content":"她坐到你身侧，拿出一小瓶药，蘸取一点在指尖。语气和动作一样轻柔。","style":3,"background":2006,"log_type":1,"src_id":160603082,"trial_step":82},{"step":81,"speaker":"杜若","content":"和我回东洲吧，局长。","voice":["vo_trial_60603_1_82"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603083,"trial_step":83},{"step":82,"content":"沙暴仍在继续，风不断撞击避难所的篷布。距离东洲大陆涉嫌恶意盗取狄斯城信息已经过去许久，头号嫌疑人却正坐在你面前，眼里的关心不似作假。","style":3,"background":2006,"log_type":1,"src_id":160603084,"trial_step":84},{"step":83,"content":"就在你有些不知如何开口时——","style":3,"background":2006,"log_type":1,"src_id":160603085,"trial_step":85},{"step":84,"content":"猝然，掌心传来了熟悉的跳动。","style":3,"background":2006,"log_type":1,"src_id":160603086,"trial_step":86},{"step":85,"content":"并且你能清晰感知到，跳动的不止一组枷锁，距离你仍有一些距离……这股感应绝对不是来自杜若。","style":3,"background":2006,"log_type":1,"src_id":160603087,"trial_step":87},{"step":86,"speaker":"艾米潘","content":"局——长——啊——","voice":["vo_trial_60603_1_87"],"voice_bank":"vo_duruo_trial","style":1,"background":2004,"log_type":1,"src_id":160603088,"trial_step":88},{"step":87,"speaker":"赫卡蒂","content":"安静点。这里也没有……难道真的出事了？","voice":["vo_trial_60603_1_88"],"voice_bank":"vo_duruo_trial","style":1,"background":2004,"log_type":1,"src_id":160603089,"trial_step":89},{"step":88,"speaker":"海拉","content":"喂，你们别这么没头没脑地乱闯，砂海里很容易就会迷路的！**梦魇，你拉着点她们！","voice":["vo_trial_60603_1_89"],"voice_bank":"vo_duruo_trial","style":1,"background":2004,"log_type":1,"src_id":160603090,"trial_step":90},{"step":89,"speaker":"伊格尼","content":"那家伙怎么又给人添麻烦……他要是敢出什么岔子，我、我可不会轻易原谅。","female_content":"那家伙怎么又给人添麻烦……她要是敢出什么岔子，我、我可不会轻易原谅。","voice":["vo_trial_60603_1_90"],"voice_bank":"vo_duruo_trial","style":1,"background":2003,"log_type":1,"src_id":160603091,"trial_step":91},{"step":90,"speaker":"开尔文","content":"局长会没事的，或许只是普通的失联呢？我相信局长，我们一定能找到的。","voice":["vo_trial_60603_1_91"],"voice_bank":"vo_duruo_trial","style":1,"background":2003,"log_type":1,"src_id":160603092,"trial_step":92},{"step":91,"speaker":"夜莺","content":"定位应该就在这附近，仪器没有问题。","voice":["vo_trial_60603_1_92"],"voice_bank":"vo_duruo_trial","style":1,"background":2007,"log_type":1,"src_id":160603093,"trial_step":93},{"step":92,"speaker":"FAC","content":"好，我派人接着搜。","voice":["vo_trial_60603_1_93"],"voice_bank":"vo_duruo_trial","style":1,"background":2007,"log_type":1,"src_id":160603094,"trial_step":94},{"step":93,"content":"枷锁滚烫的温度与杜若手中药草的凉意交错刺激，意外地让你的思绪冷静下来。","style":3,"background":2006,"log_type":1,"src_id":160603095,"trial_step":95},{"step":94,"speaker":"局长","content":"杜若，能问你一个问题吗？","style":2,"background":2006,"log_type":1,"src_id":160603096,"trial_step":96},{"step":95,"content":"话题来得突兀，她有些讶异地抬起头。","style":3,"background":2006,"log_type":1,"src_id":160603097,"trial_step":97},{"step":96,"speaker":"局长","content":"假设你所出生的地方给不了你庇护，也没留下什么美好回忆，但你在别的地方遇到了像阿煦那样的朋友，一起患难一起成长。你会将哪里当作故乡？","style":2,"background":2006,"log_type":1,"src_id":160603098,"trial_step":98},{"step":97,"speaker":"局长","content":"或者我换一种问法，当这两个地方都需要你的时候，你会怎么选呢？","style":2,"background":2006,"log_type":1,"src_id":160603099,"trial_step":99},{"step":98,"speaker":"杜若","content":"我……","voice":["vo_trial_60603_1_99"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603100,"trial_step":100},{"step":99,"content":"她在答案脱口而出的那一瞬间顿住了。","style":3,"background":2006,"log_type":1,"src_id":160603101,"trial_step":101},{"step":100,"speaker":"局长","content":"我为狄斯做那么多的目的，或许一开始你就误解了。","style":2,"background":2006,"log_type":1,"src_id":160603102,"trial_step":102},{"step":101,"speaker":"局长","content":"就像神话的背后或许不是神，故乡所意味的，也不仅仅是一个地名。","style":2,"background":2006,"log_type":1,"src_id":160603103,"trial_step":103},{"step":102,"speaker":"局长","content":"它们的背后，究竟应该看到什么……这明明还是你教给我的。","style":2,"background":2006,"log_type":1,"src_id":160603104,"trial_step":104},{"step":103,"speaker":"杜若","content":"……是“人”所构筑的真实。","voice":["vo_trial_60603_1_104"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603105,"trial_step":105},{"step":104,"content":"杜若终于了然，她为你敷上最后一点伤药，起身拿起了那个罗盘。","style":3,"background":2006,"log_type":1,"src_id":160603106,"trial_step":106},{"step":105,"speaker":"杜若","content":"看来你做好选择了。","voice":["vo_trial_60603_1_106"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603107,"trial_step":107},{"step":106,"speaker":"局长","content":"我说过的，管理局里大大小小的麻烦事可多了，我得回去。","style":2,"background":2006,"log_type":1,"src_id":160603108,"trial_step":108},{"step":107,"speaker":"局长","content":"她们在哪里，我就会在哪里。","style":2,"background":2006,"log_type":1,"src_id":160603109,"trial_step":109},{"step":108,"options":["我要留在狄斯"],"style":6,"background":2006,"log_type":1,"src_id":160603110,"trial_step":110,"course":3,"choices":[{"text":"我要留在狄斯","goto":111}]},{"step":109,"content":"你与杜若对视，谁也没有移开目光。很久之后，杜若长叹一声。","style":3,"background":2006,"log_type":1,"src_id":160603111,"trial_step":111},{"step":110,"speaker":"杜若","content":"我不认可你的选择。","voice":["vo_trial_60603_1_111"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603112,"trial_step":112},{"step":111,"content":"她抬手放上罗盘，指尖拨动指针。","style":3,"background":2006,"log_type":1,"src_id":160603113,"trial_step":113},{"step":112,"speaker":"杜若","content":"但我尊重朋友的判断。","voice":["vo_trial_60603_1_113"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603114,"trial_step":114},{"step":113,"content":"罗盘开始飞速旋转，转过几十圈后，指针彻底停下。圆盘上隐隐散发的幽光熄灭。","style":3,"background":10006,"log_type":1,"src_id":160603115,"trial_step":115},{"step":114,"content":"同一时刻，避难所的无形屏障被梦魇轰然撞破，FAC与MBCC的警卫也一齐抵达。","style":3,"background":10006,"log_type":1,"src_id":160603116,"trial_step":116},{"step":115,"content":"那些禁闭者也奔向你，回应了枷锁的感召，挡在你身前。","style":3,"background":2006,"log_type":1,"src_id":160603117,"trial_step":117},{"step":116,"content":"FAC高举枪支，将杜若包围在圆心中央，杜若的目光扫过一排排枪口，像往常一样镇静。","style":3,"background":2006,"log_type":1,"src_id":160603118,"trial_step":118},{"step":117,"content":"没等FAC发难，她率先开口——","style":3,"background":2006,"log_type":1,"src_id":160603119,"trial_step":119},{"step":118,"speaker":"杜若","content":"多谢局长阁下舍身相救，我才能得以从风沙中脱困。","voice":["vo_trial_60603_1_119"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603120,"trial_step":120},{"step":119,"speaker":"FAC","content":"？？？","style":1,"background":2006,"log_type":1,"src_id":160603121,"trial_step":121},{"step":120,"speaker":"FAC","content":"谁问你这个了。对于资料库被入侵，没有什么说法吗？","voice":["vo_trial_60603_1_121"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603122,"trial_step":122},{"step":121,"speaker":"杜若","content":"我正是为了追击那名窃取资料的东洲叛徒才一路至此，原来FAC也没有抓到“它”吗？","voice":["vo_trial_60603_1_122"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603123,"trial_step":123},{"step":122,"content":"FAC被她忽悠的有些摸不着头脑。但杜若也不怕他们反应过来，只是越过人群，淡淡笑着，望向你。","style":3,"background":2006,"log_type":1,"src_id":160603124,"trial_step":124},{"step":123,"options":["配合她最后的谎言"],"style":6,"background":2006,"log_type":1,"src_id":160603125,"trial_step":125,"course":3,"choices":[{"text":"配合她最后的谎言","goto":126}]},{"step":124,"speaker":"局长","content":"我可以为杜若作证，砂海危机四伏……","style":2,"background":2006,"log_type":1,"src_id":160603126,"trial_step":126},{"step":125,"speaker":"杜若","content":"跟我回东洲吧，你不用担心什么城邦矛盾，砂海危机四伏，就当我和你在奔逃途中失踪，生死未卜。狄斯与东洲都没有证据相互发难。","voice":["vo_trial_60603_1_45"],"voice_bank":"vo_duruo_trial","style":1,"background":2006,"log_type":1,"src_id":160603127,"trial_step":127},{"step":126,"speaker":"局长","content":"那个入侵资料库的叛徒在奔逃途中失踪，生死未卜。","style":2,"background":2006,"log_type":1,"src_id":160603128,"trial_step":128}]}