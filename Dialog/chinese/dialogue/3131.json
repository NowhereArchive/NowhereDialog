{"id":3131,"chapter_id":3,"scene_id":313,"steps":[{"step":1,"speaker":"赫卡蒂","content":"……这些狂厄结晶在暴走。局长，我们要尽快离开。这地下有什么东西很危险。","voice":["vo_cgplot_3131001"],"voice_bank":"vo_cgplot_03","style":1,"background":302,"log_type":1},{"step":2,"speaker":"海拉","content":"…………就在前面……","voice":["vo_cgplot_3131002"],"voice_bank":"vo_cgplot_03","style":1,"background":302,"log_type":1},{"step":3,"speaker":"赫卡蒂","content":"海拉……？你要去哪里？","voice":["vo_cgplot_3131003"],"voice_bank":"vo_cgplot_03","style":1,"background":302,"log_type":1},{"step":4,"speaker":"海拉","content":"…………那群阴魂不散的家伙！就在前面！","voice":["vo_cgplot_3131004"],"voice_bank":"vo_cgplot_03","style":1,"background":302,"log_type":1},{"step":5,"content":"她向着红光的源头冲去，那是一扇被炸开的暗门。","style":3,"background":302,"log_type":1},{"step":6,"options":["追上她！"],"jump":[7],"style":6,"background":302,"log_type":1},{"step":7,"content":"暗门的背后，是一个狭窄而隐秘的实验室。","style":3,"background":1030,"log_type":1},{"step":8,"content":"光透过几个装满红色液体的罐子，将整个狭窄的空间映成赤红色。罐子上赫然印着“<color=#fb9259>PARMA-Type 99</color>”字样。","style":3,"background":1030,"log_type":1},{"step":9,"speaker":"海拉","content":"这是……","voice":["vo_cgplot_3131009"],"voice_bank":"vo_cgplot_03","style":1,"background":1030,"log_type":1},{"step":10,"content":"嘭————！！！","style":3,"background":1030,"log_type":1},{"step":11,"content":"又一阵搏动，几个罐子同时炸裂，液体溅开，在地上蔓延着。","style":3,"background":1030,"log_type":1},{"step":12,"content":"很快地面上的液体中便浮现出了好几个模糊的人影，尽管看不清面容，但这股狂意还是让你想起了一个人。","style":3,"background":1030,"log_type":1},{"step":13,"options":["是袭击我们的军团雇佣兵？"],"jump":[14],"style":6,"background":1030,"log_type":1},{"step":14,"speaker":"赫卡蒂","content":"不对，那只是污染的聚合体，比那个禁闭者更危险。这也是狂厄结晶的影响吗？","voice":["vo_cgplot_3131014"],"voice_bank":"vo_cgplot_03","style":1,"background":1030,"log_type":1},{"step":15,"speaker":"赫卡蒂","content":"海拉，战斗！","voice":["vo_cgplot_3131015"],"voice_bank":"vo_cgplot_03","style":1,"background":1030,"log_type":1},{"step":16,"speaker":"赫卡蒂","content":"……海拉？！你在干什么？","voice":["vo_cgplot_3131016"],"voice_bank":"vo_cgplot_03","style":1,"background":1030,"log_type":1},{"step":17,"content":"海拉愣愣地看着那个聚合体，浑身颤抖。","style":3,"background":1030,"log_type":1},{"step":18,"speaker":"海拉","content":"…………九十九……？","voice":["vo_cgplot_3131018"],"voice_bank":"vo_cgplot_03","style":1,"background":1030,"log_type":1}]}