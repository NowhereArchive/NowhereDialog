{"id":1050301,"chapter_id":1050301,"scene_id":1,"steps":[{"step":1,"content":"耀眼晨星，与月亮同存，称决不能失去自己的荣光。","style":10,"background":10000,"log_type":1,"src_id":150301002,"trial_step":2},{"step":2,"content":"它曾立于群星之上，曾穿越极北的云霞，曾坐落高耸的山尖。","style":10,"background":10000,"log_type":1,"src_id":150301003,"trial_step":3},{"step":3,"content":"可它依旧摇摇欲落，被预言必坠落阴间，自天坠落在这必将湮灭的虚假之上。","style":10,"background":10000,"log_type":1,"src_id":150301004,"trial_step":4},{"step":4,"content":"通讯器在滴滴地响着，一连三条简讯发送到你这里。","style":3,"background":10000,"log_type":1,"src_id":150301005,"trial_step":5},{"step":5,"content":"点开最新那条，上面要求你尽快赶到审查室，有一位禁闭者自首而来。指明要求立刻见你。","style":3,"background":10000,"log_type":1,"src_id":150301006,"trial_step":6},{"step":6,"speaker":"观星者","content":"好久不见，我的小怪物。","voice":["vo_trial_50301_1_8"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301008,"trial_step":8,"drawing":1050300},{"step":7,"content":"……","style":2,"log_type":1,"src_id":150301009,"trial_step":9,"drawing":1050300},{"step":8,"speaker":"观星者","content":"怎么一脸这样的表情？难道你一点都不想我吗？","voice":["vo_trial_50301_1_10"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301010,"trial_step":10,"drawing":1050300},{"step":9,"options":["询问情况"],"style":6,"log_type":1,"src_id":150301011,"trial_step":11,"course":3,"drawing":1050300,"choices":[{"text":"询问情况","goto":12}]},{"step":10,"content":"能先解释一下现在的状况吗？观星者小姐。","style":2,"log_type":1,"src_id":150301012,"trial_step":12,"drawing":1050300},{"step":11,"content":"审查室里，那位充满异域风情的禁闭者，拨弄着手上的链条，似乎对于她被困在这里这件事，非常新鲜。","style":3,"log_type":1,"src_id":150301013,"trial_step":13,"drawing":1050300},{"step":12,"content":"而在门口，几名工作人员正将一位晕倒的人员抬出房间，他看上去脸色铁青，像是受到了巨大的惊吓。","style":3,"log_type":1,"src_id":150301014,"trial_step":14,"drawing":1050300},{"step":13,"content":"她朝着你所指的方向一瞟，一脸满不在乎。","style":3,"log_type":1,"src_id":150301015,"trial_step":15,"drawing":1050300},{"step":14,"speaker":"观星者","content":"我还以为你已经习惯了。","voice":["vo_trial_50301_1_16"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301016,"trial_step":16,"drawing":1050300},{"step":15,"speaker":"观星者","content":"你清楚的，我身边总会发生这样的事情。","voice":["vo_trial_50301_1_17"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301017,"trial_step":17,"drawing":1050300},{"step":16,"content":"观星者毫不在意地挥挥手，身上的饰品和锁链一起发出叮铃的声音，给审查室徒增一丝诡异。","style":3,"log_type":1,"src_id":150301018,"trial_step":18,"drawing":1050300},{"step":17,"speaker":"观星者","content":"他们对我的预言能力很感兴趣。","voice":["vo_trial_50301_1_19"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301019,"trial_step":19,"drawing":1050300},{"step":18,"speaker":"观星者","content":"看在他们是你同事的份儿上，我就帮他们预测了一下~","voice":["vo_trial_50301_1_20"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301020,"trial_step":20,"drawing":1050300},{"step":19,"speaker":"观星者","content":"只是可惜，他们以为我在玩弄他们……就想上来“教训”我一下，没想到……","voice":["vo_trial_50301_1_21"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301021,"trial_step":21,"drawing":1050301},{"step":20,"speaker":"观星者","content":"喂~我真的有那么吓人吗？","voice":["vo_trial_50301_1_22"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301022,"trial_step":22,"drawing":1050301},{"step":21,"content":"躲在你身后门外的工作人员，像是怕她，又像是恨不得她马上消失，哼哼了两声，便不甘心地离开。","style":3,"log_type":1,"src_id":150301023,"trial_step":23,"drawing":1050301},{"step":22,"speaker":"观星者","content":"虽说我并不是免费预言，不过，看到他们这么滑稽的一面，就当是抵了费用吧~","voice":["vo_trial_50301_1_24"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301024,"trial_step":24,"drawing":1050301},{"step":23,"content":"观星者朝你抛了个媚眼。","style":3,"log_type":1,"src_id":150301025,"trial_step":25,"drawing":1050301},{"step":24,"speaker":"观星者","content":"当然，你不一样，小怪物。","voice":["vo_trial_50301_1_26"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301026,"trial_step":26,"drawing":1050301},{"step":25,"content":"你无视掉她赤裸裸的眼神，坐在她的面前。","style":3,"log_type":1,"src_id":150301027,"trial_step":27,"drawing":1050301},{"step":26,"options":["为什么一定要见我？"],"style":6,"log_type":1,"src_id":150301028,"trial_step":28,"course":3,"drawing":1050300,"choices":[{"text":"为什么一定要见我？","goto":29}]},{"step":27,"speaker":"观星者","content":"当然是想你了。","voice":["vo_trial_50301_1_29"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301029,"trial_step":29,"drawing":1050300},{"step":28,"content":"……谢谢你的记挂。","style":2,"log_type":1,"src_id":150301030,"trial_step":30,"drawing":1050300},{"step":29,"speaker":"观星者","content":"小怪物，你是在质疑我对你的真心吗？","voice":["vo_trial_50301_1_31"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301031,"trial_step":31,"drawing":1050301},{"step":30,"content":"我不是这个意思……","style":2,"log_type":1,"src_id":150301032,"trial_step":32,"drawing":1050301},{"step":31,"speaker":"观星者","content":"呵呵……明明你以前很大胆的，怎么这么禁不起逗。","voice":["vo_trial_50301_1_33"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301033,"trial_step":33,"drawing":1050301},{"step":32,"speaker":"观星者","content":"算啦，我其实是来告诉你……新的预言。","voice":["vo_trial_50301_1_34"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301034,"trial_step":34,"drawing":1050301},{"step":33,"content":"观星者嘴角噙着笑容，和你与她初遇在砂海时一样。","style":3,"log_type":1,"src_id":150301035,"trial_step":35,"drawing":1050301},{"step":34,"options":["配合观星者"],"style":6,"log_type":1,"src_id":150301036,"trial_step":36,"course":3,"drawing":1050300,"choices":[{"text":"配合观星者","goto":37}]},{"step":35,"content":"你说吧，但你也知道，我并不是一个……会听信预言的人。","style":2,"log_type":1,"src_id":150301037,"trial_step":37,"drawing":1050300},{"step":36,"speaker":"观星者","content":"好~好~","voice":["vo_trial_50301_1_38"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301038,"trial_step":38,"drawing":1050300},{"step":37,"content":"观星者的笑容愈发深沉，她的右手一挥，不知道从哪里带出了一张塔罗牌。","style":3,"log_type":1,"src_id":150301039,"trial_step":39,"drawing":1050303},{"step":38,"speaker":"观星者","content":"我可怜的小怪物……","voice":["vo_trial_50301_1_40"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301040,"trial_step":40,"drawing":1050303},{"step":39,"speaker":"观星者","content":"我该如何告诉你呢……命运这块巨大的画布啊——","voice":["vo_trial_50301_1_41"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301041,"trial_step":41,"drawing":1050300},{"step":40,"content":"观星者将那张塔罗牌放在了自己前方，轻轻对你摇头。","style":3,"log_type":1,"src_id":150301042,"trial_step":42,"drawing":1050300},{"step":41,"speaker":"观星者","content":"高塔耸立在动物园里，秃鹫，蝎子，豺狼，猎犬，毒蛇，猴子……","voice":["vo_trial_50301_1_43"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301043,"trial_step":43,"drawing":1050300},{"step":42,"speaker":"观星者","content":"它们在高塔下嚎叫，在泥泞里舞蹈，宣告着这罪恶的世界……","voice":["vo_trial_50301_1_44"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301044,"trial_step":44,"drawing":1050300},{"step":43,"speaker":"观星者","content":"而你又悬挂在这高塔之上，像晨星一般摇摇欲坠……","voice":["vo_trial_50301_1_45"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301045,"trial_step":45,"drawing":1050300},{"step":44,"content":"你想说的是什么。","style":2,"log_type":1,"src_id":150301046,"trial_step":46,"drawing":1050300},{"step":45,"speaker":"观星者","content":"世界的灾难……","voice":["vo_trial_50301_1_47"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301047,"trial_step":47,"drawing":1050300},{"step":46,"speaker":"观星者","content":"小怪物，你爱着的世界将因为灾难而无可避免地走向终结。","voice":["vo_trial_50301_1_48"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301048,"trial_step":48,"drawing":1050300},{"step":47,"options":["世界总会终结。"],"style":6,"log_type":1,"src_id":150301049,"trial_step":49,"course":3,"drawing":1050300,"choices":[{"text":"世界总会终结。","goto":50}]},{"step":48,"speaker":"观星者","content":"那……为何不与我一起前往真实之境呢？我一直在寻觅着，直至最近，真实的入口，似乎在你的身边蠢蠢欲动，你应该也能感受到。","voice":["vo_trial_50301_1_50"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301050,"trial_step":50,"drawing":1050300},{"step":49,"content":"你皱了皱眉头，你和观星者一起见过幻花，依稀知晓它来自于何处——近期内海附近确实不大安稳，但现在不能盲目确定这件事和观星者嘴里的“真实”有关。","style":3,"log_type":1,"src_id":150301051,"trial_step":51,"drawing":1050300},{"step":50,"content":"既然身为诞生在这个世界上的人类，我有选择和世界一起终结的权利。我不会逃避死亡的，观星者小姐。","style":2,"log_type":1,"src_id":150301052,"trial_step":52,"drawing":1050300},{"step":51,"content":"这样的蛊惑之言……你应该知道，它对我并不是很适用。","style":2,"log_type":1,"src_id":150301053,"trial_step":53,"drawing":1050300},{"step":52,"speaker":"观星者","content":"这并非蛊惑，这是预言，这是你……未来之路，你会跟我走的。","voice":["vo_trial_50301_1_54"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301054,"trial_step":54,"drawing":1050300},{"step":53,"content":"观星者说罢，用金色的指套挟起第二张塔罗牌，展示给你看。","style":3,"log_type":1,"src_id":150301055,"trial_step":55,"drawing":1050303},{"step":54,"content":"牌面上是浑身尖刺的明月悬挂高空，观星者方才说过的动物聚集在下方，仰着脖子，卖力地嘶吼。","style":3,"log_type":1,"src_id":150301056,"trial_step":56,"drawing":1050303},{"step":55,"speaker":"观星者","content":"呵呵……是正位月亮。","voice":["vo_trial_50301_1_57"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301057,"trial_step":57,"drawing":1050303},{"step":56,"speaker":"观星者","content":"你之后将踏上一段迷惘不安的旅途，一切都是那么的不明朗……","voice":["vo_trial_50301_1_58"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301058,"trial_step":58,"drawing":1050303},{"step":57,"speaker":"观星者","content":"惨白的光辉带着尖锐的刺，让你的脊背和心脏疼痛不已。","voice":["vo_trial_50301_1_59"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301059,"trial_step":59,"drawing":1050303},{"step":58,"speaker":"观星者","content":"太可怜了，我的小怪物，你需要我，亲爱的。","voice":["vo_trial_50301_1_60"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301060,"trial_step":60,"drawing":1050303},{"step":59,"options":["我的旅途一直充满着这些"],"style":6,"log_type":1,"src_id":150301061,"trial_step":61,"course":3,"drawing":1050300,"choices":[{"text":"我的旅途一直充满着这些","goto":62}]},{"step":60,"content":"观星者静静地看着你，似乎是期待着你说些什么。","style":3,"log_type":1,"src_id":150301062,"trial_step":62,"drawing":1050300},{"step":61,"content":"但我不会就此退缩的——观星者小姐，我知道打断观星者的预言，是一件很不礼貌的行为，您可以继续的。","style":2,"log_type":1,"src_id":150301063,"trial_step":63,"drawing":1050300},{"step":62,"speaker":"观星者","content":"这也是我喜欢你的原因之一，小怪物。","voice":["vo_trial_50301_1_64"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301064,"trial_step":64,"drawing":1050300},{"step":63,"content":"观星者把第二张牌放在了右手边，并抽取了第三张。","style":3,"log_type":1,"src_id":150301065,"trial_step":65,"drawing":1050300},{"step":64,"content":"看清牌面的瞬间，观星者叹了口气，以怜爱的神情注视着你。","style":3,"log_type":1,"src_id":150301066,"trial_step":66,"drawing":1050303},{"step":65,"content":"你要是想说，便说吧。","style":2,"log_type":1,"src_id":150301067,"trial_step":67,"drawing":1050303},{"step":66,"speaker":"观星者","content":"圣杯五，你将会坠入黑暗的深渊，独自无依；恐怖与悲伤像蚂蚁一样，不断将你环绕，啃食你的肉体与灵魂……","voice":["vo_trial_50301_1_68"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301068,"trial_step":68,"drawing":1050303},{"step":67,"speaker":"观星者","content":"这一切的一切，都是你的未来之路中，会遇到的劫难。","voice":["vo_trial_50301_1_69"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301069,"trial_step":69,"drawing":1050303},{"step":68,"content":"听上去，没有任何一张是令人开心的牌面。","style":2,"log_type":1,"src_id":150301070,"trial_step":70,"drawing":1050300},{"step":69,"speaker":"观星者","content":"确实如此，确实……但你有我，我的小怪物。","voice":["vo_trial_50301_1_71"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301071,"trial_step":71,"drawing":1050300},{"step":70,"speaker":"观星者","content":"我既然能在砂海让你吃尽苦头又重获新生……那我自然也能将你从这个虚假的世界中拯救出来，踏上前往真实的路。","voice":["vo_trial_50301_1_72"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301072,"trial_step":72,"drawing":1050300},{"step":71,"options":["询问观星者","拒绝观星者"],"style":6,"log_type":1,"src_id":150301073,"trial_step":73,"course":3,"drawing":1050300,"choices":[{"text":"询问观星者","goto":74},{"text":"拒绝观星者","goto":81}]},{"step":72,"content":"那条路在哪里？你如何确定尽头就是真实？","style":2,"log_type":1,"src_id":150301074,"trial_step":74,"drawing":1050300},{"step":73,"speaker":"观星者","content":"你只要跟着我前进就行了……我的能力不会欺骗我，你对我很重要。","voice":["vo_trial_50301_1_75"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301075,"trial_step":75,"drawing":1050303},{"step":74,"speaker":"观星者","content":"我的同伴，你是真实之境的钥匙。","voice":["vo_trial_50301_1_76"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301076,"trial_step":76,"drawing":1050303},{"step":75,"speaker":"观星者","content":"你的蓝色的瞳孔下是一片漆黑，深不见底……","voice":["vo_trial_50301_1_77"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301077,"trial_step":77,"drawing":1050303},{"step":76,"speaker":"观星者","content":"其中却隐藏着一条通向真实的路……","voice":["vo_trial_50301_1_78"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301078,"trial_step":78,"drawing":1050303},{"step":77,"content":"你望向侧边，漆黑的显示屏倒映出你的眼睛，堪堪能见到其一丝青蓝的色泽。","style":3,"log_type":1,"src_id":150301079,"trial_step":79,"drawing":1050303},{"step":78,"speaker":"观星者","content":"幻花回归虚空，而你将给予这个虚假的世界应有的结局！然后……然后你会开启最真实的启迪！","voice":["vo_trial_50301_1_80"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301080,"trial_step":80,"drawing":1050303,"next":[88]},{"step":79,"content":"好了，观星者小姐，我没有时间和精力陪你折腾这些预言。","style":2,"log_type":1,"src_id":150301081,"trial_step":81,"drawing":1050303},{"step":80,"content":"但如果你跟我说……你的那条“真实之路”在内海附近的话，我会比较乐意听你继续说。","style":2,"log_type":1,"src_id":150301082,"trial_step":82,"drawing":1050303},{"step":81,"speaker":"观星者","content":"呵呵……说不定呢？","voice":["vo_trial_50301_1_83"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301083,"trial_step":83,"drawing":1050303},{"step":82,"speaker":"观星者","content":"你所见的地方，就是那条真实之路，所以我才会对你如此执着。","voice":["vo_trial_50301_1_84"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301084,"trial_step":84,"drawing":1050303},{"step":83,"speaker":"观星者","content":"为什么呢……小怪物。","voice":["vo_trial_50301_1_85"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301085,"trial_step":85,"drawing":1050303},{"step":84,"speaker":"观星者","content":"这双堪比天空与海洋的蓝色眼眸后面，竟是深不见底，空无一物的黑暗……","voice":["vo_trial_50301_1_86"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301086,"trial_step":86,"drawing":1050303},{"step":85,"speaker":"观星者","content":"但我却在这片黑暗中，找到了一条通向真实的路……幻花回归虚空，我却仍在这个虚假的世界找寻……你的躯壳，会是真实之地吗？你的灵魂……会是钥匙吗？","voice":["vo_trial_50301_1_87"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301087,"trial_step":87,"drawing":1050303},{"step":86,"content":"观星者笑着，声音都渐渐颤抖起来。","style":3,"log_type":1,"src_id":150301088,"trial_step":88,"drawing":1050301},{"step":87,"speaker":"观星者","content":"这个世界给每个人灌注了愚蠢和错误，它们在肚子里酿成了罪恶。","voice":["vo_trial_50301_1_89"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301089,"trial_step":89,"drawing":1050301},{"step":88,"speaker":"观星者","content":"当罪恶攀升，啃食着大脑与精神……人们就会被虚假蒙蔽双眼。","voice":["vo_trial_50301_1_90"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301090,"trial_step":90,"drawing":1050301},{"step":89,"content":"我想我现在看得清明。","style":2,"log_type":1,"src_id":150301091,"trial_step":91,"drawing":1050301},{"step":90,"content":"观星者看着你，绛紫色的眼睛像是盛了一汪月亮，清冽疯狂。","style":3,"log_type":1,"src_id":150301092,"trial_step":92,"drawing":1050301},{"step":91,"speaker":"观星者","content":"我当然知道你不会迷失方向……你是砂海的宠儿，也被虚空认可。","voice":["vo_trial_50301_1_93"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301093,"trial_step":93,"drawing":1050301},{"step":92,"speaker":"观星者","content":"可是……在这里被这些低劣的眼神所注视，即使是你……也会被淹没的。","voice":["vo_trial_50301_1_94"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301094,"trial_step":94,"drawing":1050301},{"step":93,"content":"我不会的。","style":2,"log_type":1,"src_id":150301095,"trial_step":95,"drawing":1050301},{"step":94,"speaker":"观星者","content":"你要相信我的预言……小怪物。","voice":["vo_trial_50301_1_96"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301096,"trial_step":96,"drawing":1050301},{"step":95,"speaker":"观星者","content":"我是来拯救你的。","voice":["vo_trial_50301_1_97"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301097,"trial_step":97,"drawing":1050301},{"step":96,"options":["拯救？"],"style":6,"log_type":1,"src_id":150301098,"trial_step":98,"course":3,"drawing":1050301,"choices":[{"text":"拯救？","goto":99}]},{"step":97,"content":"我认为我现在……比在砂海的时候都要安全。","style":2,"log_type":1,"src_id":150301099,"trial_step":99,"drawing":1050301},{"step":98,"speaker":"观星者","content":"小怪物，身在这个混沌的世界中，谁都有看不清周围的时刻。","voice":["vo_trial_50301_1_100"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301100,"trial_step":100,"drawing":1050301},{"step":99,"speaker":"观星者","content":"而这里……不见日光，不见星辰。","voice":["vo_trial_50301_1_101"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301101,"trial_step":101,"drawing":1050301},{"step":100,"speaker":"观星者","content":"更不用说清澈的月光。","voice":["vo_trial_50301_1_102"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301102,"trial_step":102,"drawing":1050301},{"step":101,"content":"观星者伸出手来，像是请示着神明降临似的。","style":3,"log_type":1,"src_id":150301103,"trial_step":103,"drawing":1050301},{"step":102,"speaker":"观星者","content":"嗯……我感受到了……","voice":["vo_trial_50301_1_104"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301104,"trial_step":104,"drawing":1050301},{"step":103,"speaker":"观星者","content":"你的焦灼散发着和沙漠一样的咸味。","voice":["vo_trial_50301_1_105"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301105,"trial_step":105,"drawing":1050301},{"step":104,"speaker":"观星者","content":"但是不要害怕……","voice":["vo_trial_50301_1_106"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301106,"trial_step":106,"drawing":1050301},{"step":105,"speaker":"观星者","content":"只有荒谬和虚假才会吃人。","voice":["vo_trial_50301_1_107"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301107,"trial_step":107,"drawing":1050301},{"step":106,"content":"观星者的话毫无章法，却都带着无法让人躲开的力量。","style":3,"log_type":1,"src_id":150301108,"trial_step":108,"drawing":1050301},{"step":107,"content":"像精神的压迫，又像随着月光涨起来的潮水，将人逼得毫无退路，浸满窒息。","style":3,"log_type":1,"src_id":150301109,"trial_step":109,"drawing":1050301},{"step":108,"speaker":"观星者","content":"一场迷茫且被欺骗的旅途，一群蛇蝎鸡犬的小人，而你也终被困于高塔……","voice":["vo_trial_50301_1_110"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301110,"trial_step":110,"drawing":1050301},{"step":109,"content":"这就是你预言的结局吗？","style":2,"log_type":1,"src_id":150301111,"trial_step":111,"drawing":1050301},{"step":110,"speaker":"观星者","content":"是的，并且……它们都会实现。","voice":["vo_trial_50301_1_112"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301112,"trial_step":112,"drawing":1050301},{"step":111,"content":"既然上次我能活着从砂海回来，这次，我肯定也能打破你的预言。","style":2,"log_type":1,"src_id":150301113,"trial_step":113,"drawing":1050301},{"step":112,"speaker":"观星者","content":"那么时间和命运将会证明。","voice":["vo_trial_50301_1_114"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301114,"trial_step":114,"drawing":1050301},{"step":113,"content":"时间和命运，有的时候，也摆脱不开人的操控。","style":2,"log_type":1,"src_id":150301115,"trial_step":115,"drawing":1050300},{"step":114,"content":"你伸出手，将中间那张牌轻轻翻开，放在了自己面前。","style":3,"log_type":1,"src_id":150301116,"trial_step":116,"drawing":1050300},{"step":115,"content":"审查桌上，翻开的塔罗牌下，竟是出现了第四张塔罗牌。","style":3,"log_type":1,"src_id":150301117,"trial_step":117,"drawing":1050300},{"step":116,"content":"来解释一下吧，观星者小姐。","style":2,"log_type":1,"src_id":150301118,"trial_step":118,"drawing":1050300},{"step":117,"content":"观星者看着桌上的第四张牌，无言地笑了起来。","style":3,"log_type":1,"src_id":150301119,"trial_step":119,"drawing":1050301},{"step":118,"content":"她轻轻拿起那张牌，眯起了眼睛。","style":3,"log_type":1,"src_id":150301120,"trial_step":120,"drawing":1050303},{"step":119,"speaker":"观星者","content":"确实如你所说……时间和命运摆脱不开人的操控。","voice":["vo_trial_50301_1_121"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301121,"trial_step":121,"drawing":1050303},{"step":120,"speaker":"观星者","content":"你亲手将这张牌，送上了你的未来之位。","voice":["vo_trial_50301_1_122"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301122,"trial_step":122,"drawing":1050303},{"step":121,"content":"那这张牌又代表了什么？","style":2,"log_type":1,"src_id":150301123,"trial_step":123,"drawing":1050303},{"step":122,"speaker":"观星者","content":"这旗帜与镰刀，是再明显不过的答案。","voice":["vo_trial_50301_1_124"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301124,"trial_step":124,"drawing":1050303},{"step":123,"speaker":"观星者","content":"是谁凿开了孔洞，内里的东西流淌而出，徒留一具干涸的空壳。","voice":["vo_trial_50301_1_125"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301125,"trial_step":125,"drawing":1050303},{"step":124,"speaker":"观星者","content":"死亡……这空洞又脆弱的橡木桶，代表着凄厉的死亡啊！","voice":["vo_trial_50301_1_126"],"voice_bank":"vo_anarkia_trial","style":1,"log_type":1,"src_id":150301126,"trial_step":126,"drawing":1050303},{"step":125,"options":["……"],"style":6,"log_type":1,"src_id":150301127,"trial_step":127,"course":3,"drawing":1050301,"choices":[{"text":"……","goto":128}]},{"step":126,"content":"我走的路或许不是你所谓的通向真实的路，我也自知这条路上充满危险，荆棘。也知道这条路的尽头将会是一切的终结。","style":2,"log_type":1,"src_id":150301128,"trial_step":128,"drawing":1050301},{"step":127,"content":"但这些苦难，将打造成我的铠甲，磨砺出我的宝剑。","style":2,"log_type":1,"src_id":150301129,"trial_step":129,"drawing":1050301},{"step":128,"content":"我不会让区区预言，打破我前进的脚步。谢谢你的建议，观星者小姐。","style":2,"log_type":1,"src_id":150301130,"trial_step":130,"drawing":1050301},{"step":129,"content":"观星者的笑声渐渐溢出嘴边，引得在场所有人无不毛骨悚然。","style":3,"log_type":1,"src_id":150301131,"trial_step":131,"drawing":1050301},{"step":130,"content":"那些人看向她的眼神中，依旧是带着畏惧她的，又想要害她的光。","style":3,"log_type":1,"src_id":150301132,"trial_step":132,"drawing":1050301},{"step":131,"content":"打破这诡异画面的，是一封来自上级的紧急召集令。","style":3,"log_type":1,"src_id":150301133,"trial_step":133},{"step":132,"speaker":"FAC联络员","content":"局长！内海境内破碎防线发来紧急求援。","voice":["vo_trial_50301_1_134"],"voice_bank":"vo_anarkia_trial","style":1,"background":2001,"log_type":1,"src_id":150301134,"trial_step":134},{"step":133,"speaker":"FAC联络员","content":"有一队装备精良的人员袭击了BR-000附近的基站！也就是防护罩最薄弱的地方……","voice":["vo_trial_50301_1_135"],"voice_bank":"vo_anarkia_trial","style":1,"background":2001,"log_type":1,"src_id":150301135,"trial_step":135},{"step":134,"speaker":"FAC联络员","content":"并且……我们监测到了破碎防线M值急剧飙升，要么是有禁闭者协助袭击，要么……那群袭击者都已经是死役了。","voice":["vo_trial_50301_1_136"],"voice_bank":"vo_anarkia_trial","style":1,"background":2001,"log_type":1,"src_id":150301136,"trial_step":136},{"step":135,"content":"审查立刻结束，我马上赶过去。","style":2,"background":2001,"log_type":1,"src_id":150301137,"trial_step":137},{"step":136,"content":"你看了一眼观星者，她仍旧是那幅笑意盈盈的模样，安稳地坐在你面前。","style":3,"background":2001,"log_type":1,"src_id":150301138,"trial_step":138},{"step":137,"content":"你收拾好东西，转身离去时，那带着异域气息的香味钻进鼻翼之间，让你一阵眩晕，模糊之间，你听到了遥远的地方又传来了一阵歌谣。","style":3,"background":2001,"log_type":1,"src_id":150301139,"trial_step":139},{"step":138,"speaker":"观星者","content":"晨星啊，晨星啊……","voice":["vo_trial_50301_1_140"],"voice_bank":"vo_anarkia_trial","style":1,"background":10000,"log_type":1,"src_id":150301140,"trial_step":140},{"step":139,"speaker":"观星者","content":"你为何从天坠落，如此以往，九天九夜啊……","voice":["vo_trial_50301_1_141"],"voice_bank":"vo_anarkia_trial","style":1,"background":10000,"log_type":1,"src_id":150301141,"trial_step":141},{"step":140,"speaker":"观星者","content":"迷惘不安的旅途即将开始……我的小怪物……","voice":["vo_trial_50301_1_142"],"voice_bank":"vo_anarkia_trial","style":1,"background":10000,"log_type":1,"src_id":150301142,"trial_step":142}]}