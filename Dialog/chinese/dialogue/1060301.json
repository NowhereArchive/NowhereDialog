{"id":1060301,"chapter_id":1060301,"scene_id":1,"steps":[{"step":1,"content":"熟悉的窒息感，扑面而来。","style":3,"background":10006,"log_type":1,"src_id":160301003,"trial_step":3},{"step":2,"content":"你仿佛又被什么人按在了游泳池里，双手双脚无法动弹。","style":3,"background":10006,"log_type":1,"src_id":160301004,"trial_step":4},{"step":3,"content":"只能一点点地看着空气从嘴里溢出，最后完全消失……","style":3,"background":10006,"log_type":1,"src_id":160301005,"trial_step":5},{"step":4,"content":"我……我在哪里……","style":2,"background":10006,"log_type":1,"src_id":160301006,"trial_step":6},{"step":5,"speaker":"？？","content":"你……在我的餐盘之中呀……","voice":["vo_trial_60301_1_1"],"voice_bank":"vo_cab_trial","style":1,"background":10006,"log_type":1,"src_id":160301007,"trial_step":7},{"step":6,"content":"卡门奈特一步步向你靠近，只是指尖轻触你就感觉到灵魂与感官正在被剥离。","style":3,"background":10006,"log_type":1,"src_id":160301008,"trial_step":8},{"step":7,"content":"手脚都像被抽干般，冰冷得几乎失去知觉。","style":3,"background":10006,"log_type":1,"src_id":160301009,"trial_step":9},{"step":8,"content":"你一切的神经，都只能感知到来自耳后缠绵的气息与低语——","style":3,"background":10006,"log_type":1,"src_id":160301010,"trial_step":10},{"step":9,"speaker":"卡门奈特","content":"让我……","voice":["vo_trial_60301_1_2"],"voice_bank":"vo_cab_trial","style":1,"background":10006,"log_type":1,"src_id":160301011,"trial_step":11},{"step":10,"speaker":"卡门奈特","content":"好好享用吧——","voice":["vo_trial_60301_1_3"],"voice_bank":"vo_cab_trial","style":1,"background":10006,"log_type":1,"src_id":160301012,"trial_step":12},{"step":11,"content":"蜜莉","style":3,"background":1018,"log_type":1,"src_id":160301014,"trial_step":14},{"step":12,"content":"刚刚是……噩梦吗？","style":2,"background":1018,"log_type":1,"src_id":160301015,"trial_step":15},{"step":13,"content":"手边的通讯器还在重复着一小时前收到的讯息——","style":3,"background":1018,"log_type":1,"src_id":160301016,"trial_step":16},{"step":14,"content":"晚宴的主要关系人卡门奈特已经收监，MBCC正在针对她的狂厄异能进行检测和评估。","style":11,"background":1018,"log_type":1,"src_id":160301017,"trial_step":17},{"step":15,"content":"此外，重要嫌疑人康兰和格雷格，已被FAC带回。","style":11,"background":1018,"log_type":1,"src_id":160301018,"trial_step":18},{"step":16,"content":"此二人受狂厄影响，曾以合体人鱼怪物的形象，在晚宴现场带来巨大骚动。","style":11,"background":1018,"log_type":1,"src_id":160301019,"trial_step":19},{"step":17,"content":"目前，二人已经从人鱼体中剥离，体内并未发现狂厄残留，M值正常，但精神状态仍不稳定。","style":11,"background":1018,"log_type":1,"src_id":160301020,"trial_step":20},{"step":18,"content":"二人对FAC的调查并不配合，鉴于${PlayerName}局长在事件中与他们有所接触，特调派MBCC协同调查……","style":11,"background":1018,"log_type":1,"src_id":160301021,"trial_step":21},{"step":19,"content":"根据车外的风景，你应该马上就要抵达协同调查的目的地了。","style":3,"background":1018,"log_type":1,"src_id":160301022,"trial_step":22},{"step":20,"content":"康兰，格雷格，精神状态仍不稳定么……","style":2,"background":1018,"log_type":1,"src_id":160301023,"trial_step":23},{"step":21,"content":"你低头看了看手中的文件信息。","style":3,"background":1018,"log_type":1,"src_id":160301024,"trial_step":24},{"step":22,"content":"【康兰&格雷格的身份调查结果】\n\n\n<i>康兰，22岁，新城人，<color=#fb9259>卡门奈特</color>家仆，因不明原因失踪。\n\n格雷格，25岁，新城人，初级厨师，曾参加过<color=#fb9259>卡门奈特</color>府上举办的厨师应聘。与康兰在同一时间前后，因不明原因失踪。\n\n根据对<color=#fb9259>卡门奈特</color>府上其他佣人的问询得知，二人或为情侣关系。</i>","style":14,"background":10000,"log_type":1,"src_id":160301025,"trial_step":25},{"step":23,"content":"文件中，一个名字被反复提及。","style":3,"background":1018,"log_type":1,"src_id":160301026,"trial_step":26},{"step":24,"content":"<color=#fb9259>卡门奈特</color>……","style":2,"background":1018,"log_type":1,"src_id":160301027,"trial_step":27},{"step":25,"content":"“笃笃笃”，车窗玻璃的敲打声中断了你的思绪。","style":3,"background":1018,"log_type":1,"src_id":160301028,"trial_step":28},{"step":26,"speaker":"通讯","content":"${PlayerName}局长，我们到了。配合您一同处理事情的文员已经在病房等您了。","voice":["vo_trial_60301_1_4"],"voice_bank":"vo_cab_trial","style":11,"background":1018,"log_type":1,"src_id":160301029,"trial_step":29},{"step":27,"content":"病房门刚一打开，就是一阵慌乱的喧闹。","style":3,"background":111,"log_type":1,"src_id":160301031,"trial_step":31},{"step":28,"speaker":"FAC文员","content":"我知道你们受了惊吓，我们没有恶意的，先把刀放下……","voice":["vo_trial_60301_1_5"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160301032,"trial_step":32},{"step":29,"content":"文员带着一众警卫，踟蹰着不敢靠近。","style":3,"background":111,"log_type":1,"src_id":160301033,"trial_step":33},{"step":30,"speaker":"康兰","content":"不行！必须要证明给她看……快，快说啊格雷格。说你不爱我，说你的味道没什么价值……","voice":["vo_trial_60301_1_6"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160301035,"trial_step":35},{"step":31,"speaker":"格雷格","content":"不，不对……该被享用的应该是我。","voice":["vo_trial_60301_1_7"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160301036,"trial_step":36},{"step":32,"speaker":"格雷格","content":"我才应该证明……证明我的感情……","voice":["vo_trial_60301_1_8"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160301037,"trial_step":37},{"step":33,"content":"二人旁若无人的对话着，男人说着就将手术刀对准了自己的咽喉，配合调查的众人再次陷入慌乱。","style":3,"background":111,"log_type":1,"src_id":160301038,"trial_step":38},{"step":34,"content":"——这就是你赶到病房时见到的画面。","style":3,"background":111,"log_type":1,"src_id":160301039,"trial_step":39},{"step":35,"options":["现在是什么情况？"],"style":6,"background":111,"log_type":1,"src_id":160301040,"trial_step":40,"course":3,"choices":[{"text":"现在是什么情况？","goto":41}]},{"step":36,"speaker":"FAC文员","content":"是MBCC的局长！您可算来了……他们一直在重复一些我听不懂的话。","voice":["vo_trial_60301_1_9"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160301041,"trial_step":41},{"step":37,"speaker":"FAC文员","content":"说什么，“证明自己更好吃”“证明对方不爱自己”，总之都是一些八点档肥皂剧的台词。","voice":["vo_trial_60301_1_10"],"voice_bank":"vo_cab_trial","style":1,"background":111,"log_type":1,"src_id":160301042,"trial_step":42},{"step":38,"content":"尽管如此，他们看上去却完全不是肥皂剧里的精神状态。","style":3,"background":111,"log_type":1,"src_id":160301043,"trial_step":43},{"step":39,"options":["试探靠近","试探开口"],"style":6,"background":111,"log_type":1,"src_id":160301044,"trial_step":44,"course":3,"choices":[{"text":"试探靠近","goto":45},{"text":"试探开口","goto":48}]},{"step":40,"content":"你刚接近一步，二人就同时尖叫起来。",