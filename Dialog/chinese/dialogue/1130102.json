{"id":1130102,"chapter_id":1130102,"scene_id":1,"steps":[{"step":1,"content":"咚——","style":3,"background":1034,"log_type":1,"src_id":230102001,"trial_step":1},{"step":2,"content":"死役疯狂地用身体撞击着千疮百孔的木门，门内是你和一队随行警卫，和一批受到惊吓的民众。","style":3,"background":1034,"log_type":1,"src_id":230102002,"trial_step":2},{"step":3,"content":"十分钟前，你在外勤任务回程途中听到了呼救声，为保护群众，被卷入了一场小规模的污染爆发。","style":3,"background":1034,"log_type":1,"src_id":230102003,"trial_step":3},{"step":4,"content":"死役的围攻愈加疯狂，你们没有继续退后的余地，木门作为最后的防线已经支离破碎，而禁闭者的支援还在赶来的路上。","style":3,"background":1034,"log_type":1,"src_id":230102004,"trial_step":4},{"step":5,"speaker":"？？？","content":"各方位注意掩护，分散死役注意力！保护局长和民众优先突围！","style":11,"background":1034,"log_type":1,"src_id":230102005,"trial_step":5},{"step":6,"options":["是MBCC的援兵吗？"],"style":6,"background":1034,"log_type":1,"src_id":230102006,"trial_step":6,"course":3,"choices":[{"text":"是MBCC的援兵吗？","goto":7}]},{"step":7,"speaker":"？？？","content":"不是MBCC。","style":11,"background":1034,"log_type":1,"src_id":230102007,"trial_step":7},{"step":8,"content":"门外一阵枪声响起，陌生的女声接入通讯。","style":3,"background":1034,"log_type":1,"src_id":230102008,"trial_step":8},{"step":9,"speaker":"克莱尔","content":"${PlayerName}局长，我们是距离此地最近的FAC直属部队第六小队，我是队长克莱尔，来保护您的安全！","style":11,"background":1034,"log_type":1,"src_id":230102009,"trial_step":9},{"step":10,"speaker":"克莱尔","content":"战斗就交给我们，夜莺副官已经从MBCC调派医疗支援赶来，请不用担心。","style":11,"background":1034,"log_type":1,"src_id":230102010,"trial_step":10},{"step":11,"content":"通讯里传来的战况与门外怪物的嘶吼交织，情况仍不乐观。","style":3,"background":1034,"log_type":1,"src_id":230102011,"trial_step":11},{"step":12,"options":["有什么我们能做的吗？"],"style":6,"background":1034,"log_type":1,"src_id":230102012,"trial_step":12,"course":3,"choices":[{"text":"有什么我们能做的吗？","goto":13}]},{"step":13,"speaker":"克莱尔","content":"……你们为了保护群众已经消耗了大量的火药和体力，您要做的，就是相信我们。","style":11,"background":1034,"log_type":1,"src_id":230102013,"trial_step":13},{"step":14,"content":"通话中笃定的笑意令人安心，门内的民众也松了一口气。","style":3,"background":1034,"log_type":1,"src_id":230102014,"trial_step":14},{"step":15,"speaker":"克莱尔","content":"纳什，注意拉开距离，小心狂厄污染！","style":11,"background":1034,"log_type":1,"src_id":230102015,"trial_step":15},{"step":16,"speaker":"克莱尔","content":"火力集中向七点方向——","style":11,"background":1034,"log_type":1,"src_id":230102016,"trial_step":16},{"step":17,"content":"你看不清外面的战况，只能通过克莱尔队长的指令声推断局势。","style":3,"background":1034,"log_type":1,"src_id":230102017,"trial_step":17},{"step":18,"speaker":"克莱尔","content":"卡佳，危险——呃！","style":11,"background":1034,"log_type":1,"src_id":230102018,"trial_step":18},{"step":19,"speaker":"卡佳","content":"队长！","style":11,"background":1034,"log_type":1,"src_id":230102019,"trial_step":19},{"step":20,"content":"通话那头的通讯设备因遭受撞击发出故障的杂音。","style":3,"background":1034,"log_type":1,"src_id":230102020,"trial_step":20},{"step":21,"options":["克莱尔队长，你没事吧？"],"style":6,"background":1034,"log_type":1,"src_id":230102021,"trial_step":21,"course":3,"choices":[{"text":"克莱尔队长，你没事吧？","goto":22}]},{"step":22,"speaker":"克莱尔","content":"没事，擦伤而已……所有人都有，八点方向，展开防御屏障！不能让怪物继续靠近！","style":11,"background":1034,"log_type":1,"src_id":230102022,"trial_step":22},{"step":23,"content":"战斗仍在继续，门内众人也不敢懈怠，死死抵住木门，时刻关注着通讯内的动向。","style":3,"background":1034,"log_type":1,"src_id":230102023,"trial_step":23},{"step":24,"content":"终于，枪声弱了下来，死役发出最后一声嚎叫。","style":3,"background":1034,"log_type":1,"src_id":230102024,"trial_step":24},{"step":25,"speaker":"克莱尔","content":"呼——局长，危机已经解除，你们安全了。","style":11,"background":1034,"log_type":1,"src_id":230102025,"trial_step":25},{"step":26,"content":"警卫试探着推开门，未弥散的硝烟下躺着一地死役残骸。","style":3,"background":114,"log_type":1,"src_id":230102026,"trial_step":26},{"step":27,"content":"一名穿着染血制服的女兵站在不远处，带领她的队伍，远远向你敬礼。","style":3,"background":114,"log_type":1,"src_id":230102027,"trial_step":27},{"step":28,"speaker":"克莱尔","content":"局长，FAC直属部队第六小队，应到八人实到八人，没有伤亡。","style":1,"background":114,"log_type":1,"src_id":230102028,"trial_step":28},{"step":29,"options":["多谢，辛苦了"],"style":6,"background":114,"log_type":1,"src_id":230102029,"trial_step":29,"course":3,"choices":[{"text":"多谢，辛苦了","goto":30}]},{"step":30,"speaker":"克莱尔","content":"没事，战斗就是第六小队的使命，这是我们应该做的。","style":1,"background":114,"log_type":1,"src_id":230102030,"trial_step":30},{"step":31,"content":"她扫视了一眼受伤的群众和警卫。","style":3,"background":114,"log_type":1,"src_id":230102031,"trial_step":31},{"step":32,"speaker":"克莱尔","content":"MBCC的医疗增援应该也快赶到了，接下来的善后工作，就交给局长了。","style":1,"background":114,"log_type":1,"src_id":230102032,"trial_step":32},{"step":33,"content":"放心，全体警卫听令——","style":2,"background":114,"log_type":1,"src_id":230102033,"trial_step":33},{"step":34,"content":"检查是否有人受伤，伤员留下等待医疗队增援诊治，其余群众护送回家……","style":2,"background":114,"log_type":1,"src_id":230102034,"trial_step":34},{"step":35,"speaker":"第六小队","content":"队长！！！","style":1,"background":114,"log_type":1,"src_id":230102035,"trial_step":35},{"step":36,"content":"听见惊呼，不祥的预感袭来。一回头，克莱尔已经倒在了地上。","style":3,"background":114,"log_type":1,"src_id":230102036,"trial_step":36},{"step":37,"content":"她下颚一道看似并不严重的划痕此时正冒着诡异的黑气。","style":3,"background":114,"log_type":1,"src_id":230102037,"trial_step":37},{"step":38,"speaker":"慌张的队员","content":"你们看，这是，是……狂厄结晶！队长被感染了？！","style":1,"background":114,"log_type":1,"src_id":230102038,"trial_step":38},{"step":39,"speaker":"卡佳","content":"队长是为了保护我才……局长，怎么办！","style":1,"background":114,"log_type":1,"src_id":230102039,"trial_step":39},{"step":40,"content":"凯旋的喜悦倏忽间荡然无存，队员们急切地看向你。他们此时没有长官，需要你的指令。","style":3,"background":114,"log_type":1,"src_id":230102040,"trial_step":40},{"step":41,"content":"都别慌，警卫继续按刚才的工作，第六小队……","style":2,"background":114,"log_type":1,"src_id":230102041,"trial_step":41},{"step":42,"content":"你并未显露出慌乱，但狂厄结晶这东西你再熟悉不过，一旦沾染，很快就会发生死役异变。","style":3,"background":114,"log_type":1,"src_id":230102042,"trial_step":42},{"step":43,"options":["安抚队员情绪"],"style":6,"background":114,"log_type":1,"src_id":230102043,"trial_step":43,"course":3,"choices":[{"text":"安抚队员情绪","goto":44}]},{"step":44,"content":"放心，她是为了支援MBCC受伤的，MBCC一定会救她。","style":2,"background":114,"log_type":1,"src_id":230102044,"trial_step":44},{"step":45,"content":"你尽可能平复呼吸，向克莱尔伸出手。医疗队还没有赶到，或许你只能试一试了——用枷锁遏制狂厄。","style":3,"background":114,"log_type":1,"src_id":230102045,"trial_step":45},{"step":46,"speaker":"？？","content":"你想和她一起死在这儿吗？","style":1,"background":114,"log_type":1,"src_id":230102046,"trial_step":46},{"step":47,"content":"熟悉的声音在身后响起——","style":3,"background":114,"log_type":1,"src_id":230102047,"trial_step":47},{"step":48,"content":"机械手臂拨开人群，令人安心的一抹白色来到你身边。","style":3,"background":114,"log_type":1,"src_id":230102048,"trial_step":48},{"step":49,"content":"艾恩？","style":2,"background":114,"log_type":1,"src_id":230102049,"trial_step":49},{"step":50,"speaker":"艾恩","content":"还算镇定，表现不错。","style":1,"background":114,"log_type":1,"src_id":230102050,"trial_step":50},{"step":51,"content":"她挑眉点了点头，不再有其他冗余的问候，立刻进入了工作状态开始检查患者伤口。","style":3,"background":114,"log_type":1,"src_id":230102051,"trial_step":51},{"step":52,"options":["向艾恩说明情况"],"style":6,"background":114,"log_type":1,"src_id":230102052,"trial_step":52,"course":3,"choices":[{"text":"向艾恩说明情况","goto":53}]},{"step":53,"content":"右侧下颚位置，在战斗过程中被狂厄结晶擦伤。","style":2,"background":114,"log_type":1,"src_id":230102053,"trial_step":53},{"step":54,"speaker":"艾恩","content":"时间？","style":1,"background":114,"log_type":1,"src_id":230102054,"trial_step":54},{"step":55,"content":"大约十五分钟前。","style":2,"background":114,"log_type":1,"src_id":230102055,"trial_step":55},{"step":56,"content":"艾恩一边清理克莱尔外伤的感染，一边用手指丈量伤口到大脑的距离，皱了皱眉。","style":3,"background":114,"log_type":1,"src_id":230102056,"trial_step":56},{"step":57,"speaker":"艾恩","content":"高强度战斗是神经最活跃的时候，十五分钟，恐怕……","style":1,"background":114,"log_type":1,"src_id":230102057,"trial_step":57},{"step":58,"content":"她跪在患者身侧拿起克莱尔制服上的名牌。","style":3,"background":114,"log_type":1,"src_id":230102058,"trial_step":58},{"step":59,"speaker":"艾恩","content":"FAC……？","style":1,"background":114,"log_type":1,"src_id":230102059,"trial_step":59},{"step":60,"content":"除了你，并没有人发现艾恩对这三个字母的犹疑。","style":3,"background":114,"log_type":1,"src_id":230102060,"trial_step":60},{"step":61,"speaker":"艾恩","content":"……FAC第六小队队长克莱尔，听得到我说话吗？睁开眼睛！","style":1,"background":114,"log_type":1,"src_id":230102061,"trial_step":61},{"step":62,"content":"克莱尔痛苦地皱了皱眉。","style":3,"background":114,"log_type":1,"src_id":230102062,"trial_step":62},{"step":63,"speaker":"艾恩","content":"克莱尔，听得到我说话吗！","style":1,"background":114,"log_type":1,"src_id":230102063,"trial_step":63},{"step":64,"content":"艾恩一边说着，一边将手放在克莱尔头顶，用神经电异能开始侦测体内的污染情况。","style":3,"background":114,"log_type":1,"src_id":230102064,"trial_step":64},{"step":65,"speaker":"克莱尔","content":"我……抱歉……","style":1,"background":114,"log_type":1,"src_id":230102065,"trial_step":65},{"step":66,"content":"第三次呼唤后，克莱尔嘴唇颤抖，勉强睁开了眼睛。但她的右眼因靠近患处，已经呈现黑紫色。","style":3,"background":114,"log_type":1,"src_id":230102066,"trial_step":66},{"step":67,"content":"狂厄的扩散竟如此迅速，所有队员都同时倒吸了一口气。","style":3,"background":114,"log_type":1,"src_id":230102067,"trial_step":67},{"step":68,"speaker":"艾恩","content":"试试双手握拳，能做到吗？","style":1,"background":114,"log_type":1,"src_id":230102068,"trial_step":68},{"step":69,"content":"克莱尔的左手成功握紧，右手却没有任何动作。","style":3,"background":114,"log_type":1,"src_id":230102069,"trial_step":69},{"step":70,"speaker":"艾恩","content":"还有意识，但检测到神经连接遭到严重侵蚀，污染已经蔓延到大脑。光是清理创口没有用，必须立刻进行手术。","style":1,"background":114,"log_type":1,"src_id":230102070,"trial_step":70},{"step":71,"speaker":"卡佳","content":"手术？现在吗？在这里？","style":1,"background":114,"log_type":1,"src_id":230102071,"trial_step":71},{"step":72,"speaker":"艾恩","content":"无关的人都滚开！${PlayerName}留下帮忙。","style":1,"background":114,"log_type":1,"src_id":230102072,"trial_step":72},{"step":73,"content":"队员们有些不安地看向你，显然并不放心将队长交给一个陌生人。","style":3,"background":114,"log_type":1,"src_id":230102073,"trial_step":73},{"step":74,"content":"艾恩也不和他们多费口舌，已经开始从医疗包内掏出工具。","style":3,"background":114,"log_type":1,"src_id":230102074,"trial_step":74},{"step":75,"options":["劝说小队队员"],"style":6,"background":114,"log_type":1,"src_id":230102075,"trial_step":75,"course":3,"choices":[{"text":"劝说小队队员","goto":76}]},{"step":76,"content":"她是很优秀的医师，相信她，都退后一些吧。","style":2,"background":114,"log_type":1,"src_id":230102076,"trial_step":76},{"step":77,"content":"队员们妥协退到远处。与此同时，艾恩在简单消毒后，立刻就对准右侧颅骨选定了开刀的位置。","style":3,"background":114,"log_type":1,"src_id":230102077,"trial_step":77},{"step":78,"speaker":"艾恩","content":"局长，把拉钩……把左数第三个工具拿起来。","style":1,"background":114,"log_type":1,"src_id":230102078,"trial_step":78},{"step":79,"content":"艾恩说着，为克莱尔注射了麻醉药剂，机械手臂同时变化出刀片状和钳状结构。","style":3,"background":114,"log_type":1,"src_id":230102079,"trial_step":79},{"step":80,"content":"你认识机械臂此刻的形态，脑海中又出现泰德痴傻的样子，拿取工具的手不知为何停在了半空。","style":3,"background":114,"log_type":1,"src_id":230102080,"trial_step":80},{"step":81,"options":["你要进行神经改造？"],"style":6,"background":114,"log_type":1,"src_id":230102081,"trial_step":81,"course":3,"choices":[{"text":"你要进行神经改造？","goto":82}]},{"step":82,"speaker":"艾恩","content":"你劝他们相信我，但你自己好像不是这么想的？","style":1,"background":114,"log_type":1,"src_id":230102082,"trial_step":82},{"step":83,"content":"这真的是唯一的选择吗？","style":2,"background":114,"log_type":1,"src_id":230102083,"trial_step":83},{"step":84,"speaker":"艾恩","content":"不然？给她上枷锁然后你们一起失控送死？","style":1,"background":114,"log_type":1,"src_id":230102084,"trial_step":84},{"step":85,"speaker":"艾恩","content":"……我只给你二十秒的时间做决定，麻醉马上就会开始作用，这是在跟狂厄的扩散赛跑！","style":1,"background":114,"log_type":1,"src_id":230102085,"trial_step":85},{"step":86,"options":["我必须尊重克莱尔的意见","你没有资格决定她的未来"],"style":6,"background":114,"log_type":1,"src_id":230102086,"trial_step":86,"course":3,"choices":[{"text":"我必须尊重克莱尔的意见","goto":87},{"text":"你没有资格决定她的未来","goto":90}]},{"step":87,"content":"见艾恩没有阻拦，你也不再拖延，立刻伏在克莱尔耳边。","style":3,"background":114,"log_type":1,"src_id":230102087,"trial_step":87},{"step":88,"content":"克莱尔，你听着，这个手术能救你的命，但是同时你也会丧失情绪、欲望和记忆，再也无法成为一名战士。","style":2,"background":114,"log_type":1,"src_id":230102088,"trial_step":88},{"step":89,"content":"即便如此，你也愿意接受这个手术吗？","style":2,"background":114,"log_type":1,"src_id":230102089,"trial_step":89,"next":[93]},{"step":90,"speaker":"艾恩","content":"你也没有资格让她死在这里！狂厄可不会等你找亲属签字。","style":1,"background":114,"log_type":1,"src_id":230102090,"trial_step":90},{"step":91,"speaker":"艾恩","content":"如果能先抑制狂厄，新城的医师或许还能帮她康复。可如果她现在就折在这里，一切就真的结束了。","style":1,"background":114,"log_type":1,"src_id":230102091,"trial_step":91},{"step":92,"content":"你无法反驳。但克莱尔身为一名战士，真的愿意丧失情绪、欲望、记忆继续生活吗……二十秒的时限一点点过去。","style":3,"background":114,"log_type":1,"src_id":230102092,"trial_step":92},{"step":93,"speaker":"克莱尔","content":"活……","style":1,"background":114,"log_type":1,"src_id":230102093,"trial_step":93},{"step":94,"content":"奄奄一息的克莱尔挣扎着抽动身躯，用尽全力看向队员们所在的方向——","style":3,"background":114,"log_type":1,"src_id":230102094,"trial_step":94},{"step":95,"speaker":"克莱尔","content":"无论如何……救我……他们，在等我……","style":1,"background":114,"log_type":1,"src_id":230102095,"trial_step":95},{"step":96,"content":"克莱尔开口的同时，银色的机械手臂已经就位，就像是预料到答案般，另一只手已经摆好了接过工具的姿势。","style":3,"background":114,"log_type":1,"src_id":230102096,"trial_step":96},{"step":97,"speaker":"艾恩","content":"我比你更清楚人对求生的渴望……地上左数第三个，把这里撑开，快。","style":1,"background":114,"log_type":1,"src_id":230102097,"trial_step":97},{"step":98,"content":"手术正式开始。","style":3,"background":114,"log_type":1,"src_id":230102098,"trial_step":98},{"step":99,"content":"另一边，退到远处的第六小队队员听不清你们的交流，更看不到艾恩手下神乎其技的操作，只能不安地等待着。","style":3,"background":114,"log_type":1,"src_id":230102099,"trial_step":99},{"step":100,"speaker":"卡佳","content":"纳什，你看到了吗，那个电流……","style":1,"background":114,"log_type":1,"src_id":230102100,"trial_step":100},{"step":101,"speaker":"卡佳","content":"她是禁闭者……但现在这种情况，也是没办法的事吧。","style":1,"background":114,"log_type":1,"src_id":230102101,"trial_step":101},{"step":102,"speaker":"卡佳","content":"我们过去所有的队员，但凡沾上一点点结晶，全都……","style":1,"background":114,"log_type":1,"src_id":230102102,"trial_step":102},{"step":103,"speaker":"纳什","content":"但禁闭者也是狂厄灾难的源头！","style":1,"background":114,"log_type":1,"src_id":230102103,"trial_step":103},{"step":104,"content":"挣扎、不甘、无奈……小队所有人都陷入沉默。","style":3,"background":114,"log_type":1,"src_id":230102104,"trial_step":104},{"step":105,"speaker":"纳什","content":"你们还记得队长的口头禅是什么吗？","style":1,"background":114,"log_type":1,"src_id":230102105,"trial_step":105},{"step":106,"speaker":"卡佳","content":"战斗是第六小队的使命。","style":1,"background":114,"log_type":1,"src_id":230102106,"trial_step":106},{"step":107,"speaker":"纳什","content":"如果那个禁闭者敢做任何有辱战士尊严的事，我饶不了她！","style":1,"background":114,"log_type":1,"src_id":230102107,"trial_step":107},{"step":108,"content":"昏迷中的克莱尔生命体征稳定，在神经电异能的帮助下，她感受不到痛苦。空气中弥漫着血肉焦糊的气味。","style":3,"background":114,"log_type":1,"src_id":230102108,"trial_step":108},{"step":109,"content":"手术正在平稳进行，远处的杂音没有对艾恩造成丝毫影响。","style":3,"background":114,"log_type":1,"src_id":230102109,"trial_step":109},{"step":110,"content":"旁人恐怕难以相信，眼前无比冷静的医师，狂厄值早在多年前就逼近异化的临界点。","style":3,"background":114,"log_type":1,"src_id":230102110,"trial_step":110},{"step":111,"options":["莓丝呢？"],"style":6,"background":114,"log_type":1,"src_id":230102111,"trial_step":111,"course":3,"choices":[{"text":"莓丝呢？","goto":112}]},{"step":112,"speaker":"艾恩","content":"嗯，我听得见……拉钩可以松开了。","style":1,"background":114,"log_type":1,"src_id":230102112,"trial_step":112},{"step":113,"content":"是因为你禁闭者的身份吗？","style":2,"background":114,"log_type":1,"src_id":230102113,"trial_step":113},{"step":114,"speaker":"艾恩","content":"嗯……针线。","style":1,"background":114,"log_type":1,"src_id":230102114,"trial_step":114},{"step":115,"content":"需要替你解释一下吗？","style":2,"background":114,"log_type":1,"src_id":230102115,"trial_step":115},{"step":116,"speaker":"艾恩","content":"解释什么？我确实是禁闭者，手术后果确实非常严重，这都是事实。","style":1,"background":114,"log_type":1,"src_id":230102116,"trial_step":116},{"step":117,"speaker":"艾恩","content":"但只有我能救她的命，这也是事实。","style":1,"background":114,"log_type":1,"src_id":230102117,"trial_step":117},{"step":118,"content":"艾恩的语气异常平静，你注意到，她此时的操作慢了下来。","style":3,"background":114,"log_type":1,"src_id":230102118,"trial_step":118},{"step":119,"content":"是手术出现什么困难了吗？","style":2,"background":114,"log_type":1,"src_id":230102119,"trial_step":119},{"step":120,"speaker":"艾恩","content":"缝合而已，不想给她留下难看的疤，稍微废了点时间。","style":1,"background":114,"log_type":1,"src_id":230102120,"trial_step":120},{"step":121,"content":"艾恩剪去最后一段缝线，放下了手里的器具。","style":3,"background":114,"log_type":1,"src_id":230102121,"trial_step":121},{"step":122,"speaker":"艾恩","content":"今天的手术，你都看清了吗？","style":1,"background":114,"log_type":1,"src_id":230102122,"trial_step":122},{"step":123,"options":["……","没有"],"style":6,"background":114,"log_type":1,"src_id":230102123,"trial_step":123,"course":3},{"step":124,"content":"艾恩的速度非常快，你只记得她切除了一团黑紫色的果冻状组织，仪器在几条血管一样的丝状纹理间游走。","style":3,"background":114,"log_type":1,"src_id":230102124,"trial_step":124},{"step":125,"speaker":"艾恩","content":"……算了，让你旁观一次，我的目的就已经达到了。","style":1,"background":114,"log_type":1,"src_id":230102125,"trial_step":125},{"step":126,"speaker":"艾恩","content":"手术结束，叫他们过来吧。","style":1,"background":114,"log_type":1,"src_id":230102126,"trial_step":126},{"step":127,"speaker":"纳什","content":"你说什么？！","style":1,"background":114,"log_type":1,"src_id":230102128,"trial_step":128},{"step":128,"content":"队员愤怒地抓住艾恩的领子，艾恩没有躲开，麻木地看着眼前已经习以为常的闹剧，又重复了一遍刚才的话。","style":3,"background":114,"log_type":1,"src_id":230102129,"trial_step":129},{"step":129,"speaker":"艾恩","content":"狂厄病灶已经切除，同时她的情绪、欲望、记忆也全部丧失。","style":1,"background":114,"log_type":1,"src_id":230102130,"trial_step":130},{"step":130,"speaker":"艾恩","content":"要想抑制狂厄，必须根除暴力冲动。","style":1,"background":114,"log_type":1,"src_id":230102131,"trial_step":131},{"step":131,"speaker":"纳什","content":"你知不知道她这样就无法上战场了！这比杀了她还让她难受！","style":1,"background":114,"log_type":1,"src_id":230102132,"trial_step":132},{"step":132,"speaker":"艾恩","content":"这是她自己的选择，是为了活命必要的牺牲。","style":1,"background":114,"log_type":1,"src_id":230102133,"trial_step":133},{"step":133,"speaker":"卡佳","content":"不……我不相信，队长不可能接受这样的手术！","style":1,"background":114,"log_type":1,"src_id":230102134,"trial_step":134},{"step":134,"speaker":"卡佳","content":"面对那些被污染的战友，队长总是告诉他们不要悔恨，FAC是为了狂厄而存在的，为了狂厄而死是光荣的。","style":1,"background":114,"log_type":1,"src_id":230102135,"trial_step":135},{"step":135,"speaker":"卡佳","content":"这样的队长，背负着大家的意志战斗的队长，如果知道自己在污染下苟活，肯定会很自责的……","style":1,"background":114,"log_type":1,"src_id":230102136,"trial_step":136},{"step":136,"speaker":"艾恩","content":"闭嘴！废物的命，和英雄的命，都是一样的。","style":1,"background":114,"log_type":1,"src_id":230102137,"trial_step":137},{"step":137,"speaker":"纳什","content":"你说谁是废物！","style":1,"background":114,"log_type":1,"src_id":230102138,"trial_step":138},{"step":138,"speaker":"纳什","content":"明明就是因为你！是你用手术延长了队长的痛苦，羞辱了战士的尊严！！！","style":1,"background":114,"log_type":1,"src_id":230102139,"trial_step":139},{"step":139,"speaker":"艾恩","content":"这就是你们FAC对待救命恩人的态度吗？","style":1,"background":114,"log_type":1,"src_id":230102140,"trial_step":140},{"step":140,"content":"艾恩推开无理取闹的队员，从包里拿出一把手术刀，扔在昏迷的克莱尔身边。","style":3,"background":114,"log_type":1,"src_id":230102141,"trial_step":141},{"step":141,"speaker":"艾恩","content":"如果你觉得死在战场上才是对战士的尊重，那你动手吧。","style":1,"background":114,"log_type":1,"src_id":230102142,"trial_step":142},{"step":142,"speaker":"纳什","content":"我……我们当然比任何人都希望她能活着！但我们也了解克莱尔，她不会愿意的……","style":1,"background":114,"log_type":1,"src_id":230102143,"trial_step":143},{"step":143,"content":"纳什瞪着地上的手术刀气愤地喘着粗气，另一个人影却毫不犹豫地冲了上去。","style":3,"background":114,"log_type":1,"src_id":230102144,"trial_step":144},{"step":144,"speaker":"纳什","content":"卡佳！你做什么！","style":1,"background":114,"log_type":1,"src_id":230102145,"trial_step":145},{"step":145,"content":"名叫卡佳的队员并不回应队友的阻拦，持刀捅向艾恩。","style":3,"background":114,"log_type":1,"src_id":230102146,"trial_step":146},{"step":146,"options":["挡下攻击！"],"style":6,"background":114,"log_type":1,"src_id":230102147,"trial_step":147,"course":3,"choices":[{"text":"挡下攻击！","goto":148}]},{"step":147,"content":"住手！","style":2,"background":114,"log_type":1,"src_id":230102148,"trial_step":148},{"step":148,"content":"经历了长时间战斗的卡佳此时早就没了力气，被你轻松拦下，跪倒在地。","style":3,"background":114,"log_type":1,"src_id":230102149,"trial_step":149},{"step":149,"content":"没有艾恩，克莱尔现在已经变成死役被我们杀死了。你要恩将仇报吗？","style":2,"background":114,"log_type":1,"src_id":230102150,"trial_step":150},{"step":150,"speaker":"卡佳","content":"我……我什么都做不了，至少要帮队长，把这个害她变成行尸走肉的女人给……","style":1,"background":114,"log_type":1,"src_id":230102151,"trial_step":151},{"step":151,"speaker":"卡佳","content":"第六小队，应到八人，实到……","style":1,"background":114,"log_type":1,"src_id":230102152,"trial_step":152},{"step":152,"content":"她已经崩溃失常，以怨恨的眼神狠狠瞪着艾恩。","style":3,"background":114,"log_type":1,"src_id":230102153,"trial_step":153},{"step":153,"content":"克莱尔知道这个手术会导致什么后果。但为了能回到你们身边，她自愿接受了……","style":2,"background":114,"log_type":1,"src_id":230102154,"trial_step":154},{"step":154,"speaker":"卡佳","content":"不！不可能！我不相信！一定是因为禁闭者！一定是这个禁闭者自作主张！","style":1,"background":114,"log_type":1,"src_id":230102155,"trial_step":155},{"step":155,"content":"其余的队员围在昏迷的队长身边，他们默许了卡佳的失控。","style":3,"background":114,"log_type":1,"src_id":230102156,"trial_step":156},{"step":156,"content":"面对不公平的质疑，艾恩表现得异常平静。云淡风轻的表情似乎在告诉你，这就是彼岸面对的日常。","style":3,"background":114,"log_type":1,"src_id":230102157,"trial_step":157},{"step":157,"speaker":"艾恩","content":"我说过，没有必要解释，别浪费时间了。","style":1,"background":114,"log_type":1,"src_id":230102158,"trial_step":158},{"step":158,"content":"她抓起你的领口转身离开，即便身后又传来了谩骂，艾恩的脚步也没有停下。","female_content":"她抓起你的手腕转身离开，即便身后又传来了谩骂，艾恩的脚步也没有停下。","style":3,"background":114,"log_type":1,"src_id":230102159,"trial_step":159},{"step":159,"speaker":"纳什","content":"这就是禁闭者……果然，都是怪物……无情的，冰冷的怪物！","style":1,"background":114,"log_type":1,"src_id":230102160,"trial_step":160},{"step":160,"speaker":"艾恩","content":"呵，怪物么……","style":1,"background":114,"log_type":1,"src_id":230102161,"trial_step":161},{"step":161,"content":"可能是长久的苦战让你产生了幻觉，你看到艾恩竟因“怪物”二字露出笑意，微笑带着几分无奈，几分追忆。","style":3,"background":114,"log_type":1,"src_id":230102162,"trial_step":162}]}