{"id":1021002,"chapter_id":1021002,"scene_id":1,"steps":[{"step":1,"content":"【蓝色碎片动态背景】","style":18,"background":10002,"log_type":1,"src_id":121002001,"trial_step":1},{"step":2,"content":"眼前一片黑暗。耳边不断传来蚊蝇一样的嗡嗡声，想伸手去驱赶，却发现身体好重，胳膊沉得抬不起来。","style":3,"background":10002,"log_type":1,"src_id":121002002,"trial_step":2},{"step":3,"speaker":"杂乱的声音","content":"…………","style":1,"background":10002,"log_type":1,"src_id":121002003,"trial_step":3},{"step":4,"content":"身体像是被一块巨石压住，无论如何驱动都难以动弹。烦躁间，耳边的嗡嗡声越来越大，仔细听来，竟慢慢组合成了某种能理解的字句。","style":3,"background":10002,"log_type":1,"src_id":121002004,"trial_step":4},{"step":5,"content":"【梦境，啸风的过去。背景-东洲山林】","style":18,"background":2580,"log_type":1,"src_id":121002005,"trial_step":5},{"step":6,"speaker":"采药少女","content":"——呀，你终于醒了。感觉好些了吗？","voice":["vo_trial_21002_1_2"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002006,"trial_step":6},{"step":7,"speaker":"？？","content":"？！","voice":["vo_trial_21002_1_3"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002007,"trial_step":7},{"step":8,"content":"一头乱毛的小孩猛地起身，又不小心戳到腿上的伤口，摔倒在地。","style":3,"background":2580,"log_type":1,"src_id":121002008,"trial_step":8},{"step":9,"content":"一双手从旁侧伸出来，轻柔地贴上皮肤。背着药筐的少女蹲在小孩身边，眼中满是担忧。","style":3,"background":2580,"log_type":1,"src_id":121002009,"trial_step":9},{"step":10,"speaker":"采药少女","content":"是太痛了吗？这样可不行，你的伤口发炎了，草药得敷一段时间才能有效果呀。","voice":["vo_trial_21002_1_4"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002010,"trial_step":10},{"step":11,"content":"什么冰凉的东西被敷在腿上。小孩几乎是条件反射般张嘴，一口咬住对方手腕。虎牙之下的的脉搏鼓动，手腕瘦得似乎一用力就能咬断。","style":3,"background":2580,"log_type":1,"src_id":121002011,"trial_step":11},{"step":12,"speaker":"采药少女","content":"乖，别怕……放心，不会很疼的……","voice":["vo_trial_21002_1_5"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002012,"trial_step":12},{"step":13,"content":"少女并没有把人推开，而是柔着声音哄着，然后用另一只手为小孩展示手中的药材。","style":3,"background":2580,"log_type":1,"src_id":121002013,"trial_step":13},{"step":14,"speaker":"采药少女","content":"我是在采药的路上捡到的你，雪那么厚，几乎快把你埋住了。还好皮外伤没影响骨头，半个月应该就能痊愈。","voice":["vo_trial_21002_1_7"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002014,"trial_step":14},{"step":15,"speaker":"采药少女","content":"这个季节上山的人不多，山里有虎兽觅食，危险得很。你不得出门上山，应该也是有些苦衷吧……","voice":["vo_trial_21002_1_6"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002015,"trial_step":15},{"step":16,"content":"……没有敌意，不是敌人。鼻尖闻到几种常见止血药草的味道，小孩在确认对方无害后，才装模作样舔舔少女的手腕，把头缩了回去。","style":3,"background":2580,"log_type":1,"src_id":121002016,"trial_step":16},{"step":17,"content":"采药少女的动作很快很轻。伤口很快就被包好，又被扎上一条漂亮的红绳固定。","style":3,"background":2580,"log_type":1,"src_id":121002017,"trial_step":17},{"step":18,"speaker":"采药少女","content":"看，这就扎好了。","voice":["vo_trial_21002_1_8"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002018,"trial_step":18},{"step":19,"content":"少女拍拍小孩的头，又顺了顺对方有些打结的发丝。不过她刚一转过身，小孩就晃晃脑袋，活动关节想要跑走。","style":3,"background":2580,"log_type":1,"src_id":121002019,"trial_step":19},{"step":20,"speaker":"？？","content":"———！","voice":["vo_trial_21002_1_1"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002020,"trial_step":20},{"step":21,"content":"可惜，出逃未半就被采药的少女再次摁下。","style":3,"background":2580,"log_type":1,"src_id":121002021,"trial_step":21},{"step":22,"speaker":"采药少女","content":"你的腿现在动不了，得在这庙子里好好休息。放心，这段时间我会每天上山，药材管够……呃？","voice":["vo_trial_21002_1_9"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002022,"trial_step":22},{"step":23,"content":"身边突然传来细细簌簌的声音。少女一偏头，发现不知何时那个毛茸茸的脑袋已经凑了过来，直往她腰间挂的布包上闻。","style":3,"background":2580,"log_type":1,"src_id":121002023,"trial_step":23},{"step":24,"content":"少女一拍额头，从腰间的布包里掏出两个圆圆薄薄的东西。","style":3,"background":2580,"log_type":1,"src_id":121002024,"trial_step":24},{"step":25,"speaker":"采药少女","content":"呀！瞧我这记性，差点忘了——","voice":["vo_trial_21002_1_10"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002025,"trial_step":25},{"step":26,"content":"炸毛小孩先开始还警惕着，只是凑上去闻闻，但很快被香气吸引，就着少女的手咬了一口——喉头滚动，没尝出味，再来一口，两眼冒光。","style":3,"background":2580,"log_type":1,"src_id":121002026,"trial_step":26},{"step":27,"speaker":"？？","content":"！！！","voice":["vo_trial_21002_1_11"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002027,"trial_step":27},{"step":28,"content":"这次小孩尝出味了，一把抢过，大口吞咽起来，肉汁糊了满嘴。直到恋恋不舍品味完最后一点，才舔了舔手指，又满眼期待地努努嘴，示意少女再来两个。","style":3,"background":2580,"log_type":1,"src_id":121002028,"trial_step":28},{"step":29,"speaker":"采药少女","content":"哈哈~先喝口水吧，慢些吃，等明日上山我再给你带几个肉饼……","voice":["vo_trial_21002_1_12"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002029,"trial_step":29},{"step":30,"content":"少女的话没说完，却发现小孩拿起了另一个葫芦，一饮而下。","style":3,"background":2580,"log_type":1,"src_id":121002030,"trial_step":30},{"step":31,"content":"小孩眨眨眼，眼前的少女似乎分裂成了八个，每一个脸上都是焦灼，摇晃着自己的肩膀让自己赶紧吐出来。","style":3,"background":2580,"log_type":1,"src_id":121002031,"trial_step":31},{"step":32,"speaker":"采药少女","content":"？！那是消毒用的，不能喝！","voice":["vo_trial_21002_1_13"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002032,"trial_step":32},{"step":33,"speaker":"？？","content":"……嗝…………","voice":["vo_trial_21002_1_14"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002033,"trial_step":33},{"step":34,"content":"热气上涌，小孩又想着起来走两步，却天旋地转，又一次趴倒在地上。","style":3,"background":2580,"log_type":1,"src_id":121002034,"trial_step":34},{"step":35,"speaker":"？？","content":"…………不…………","voice":["vo_trial_21002_1_15"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002035,"trial_step":35},{"step":36,"speaker":"采药少女","content":"嗯？","voice":["vo_trial_21002_1_16"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002036,"trial_step":36},{"step":37,"speaker":"？？","content":"俺，厉害，很强……不会，傻……","voice":["vo_trial_21002_1_17"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002037,"trial_step":37},{"step":38,"speaker":"？？","content":"坏东西，都杀了……这里，俺的地盘……安全…………","voice":["vo_trial_21002_1_18"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002038,"trial_step":38},{"step":39,"content":"小孩说着，眼睛开始迷糊，眼皮沉沉向下坠，嘴里的话也越来越不清晰。少女哭笑不得，只好哄着给她喂水。","style":3,"background":2580,"log_type":1,"src_id":121002039,"trial_step":39},{"step":40,"speaker":"采药少女","content":"好，好，我知道了……","voice":["vo_trial_21002_1_19"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002040,"trial_step":40},{"step":41,"speaker":"采药少女","content":"好好睡吧……愿山君保佑，等你睡醒，伤好了……就能自己下山了……","voice":["vo_trial_21002_1_20"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121002041,"trial_step":41},{"step":42,"content":"【辛迪加街道】","style":18,"background":2015,"log_type":1,"src_id":121002042,"trial_step":42},{"step":43,"speaker":"啸风","content":"哈哈哈哈哈——果然还是你们这旮好玩！","voice":["vo_trial_21002_1_21"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121002043,"trial_step":43},{"step":44,"content":"啸风从高楼上一跃而下，语气中带着抑制不住的兴奋。","style":3,"background":2015,"log_type":1,"src_id":121002044,"trial_step":44},{"step":45,"content":"耳边是呼啸的风声和女人爽朗的大笑。你被啸风扛在肩上躲避追兵，随着一路颠簸，追踪队伍的吵闹声逐渐远去，而你也终于忍不住快要吐出来了。","style":3,"background":2015,"log_type":1,"src_id":121002045,"trial_step":45},{"step":46,"options":["拍拍啸风"],"style":6,"background":2015,"log_type":1,"src_id":121002046,"trial_step":46,"course":3,"choices":[{"text":"拍拍啸风","goto":47}]},{"step":47,"content":"我投降！有什么条件都可以聊，不想我直接吐在你身上的话快放我下来——！","style":2,"background":2015,"log_type":1,"src_id":121002047,"trial_step":47},{"step":48,"content":"头顶传来一声轻笑。很快，你被人提着放下，双腿终于再次回归地面。抬头，你看到这一切的始作俑者正蹲在你面前，饶有兴趣地低头看着你。","style":3,"background":2015,"log_type":1,"src_id":121002048,"trial_step":48},{"step":49,"speaker":"啸风","content":"小身板儿还是这么脆，怎么也不练练？狄斯人扣你吃的了？","voice":["vo_trial_21002_1_22"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121002049,"trial_step":49},{"step":50,"options":["已经比之前好不少了"],"style":6,"background":2015,"log_type":1,"src_id":121002050,"trial_step":50,"course":3,"choices":[{"text":"已经比之前好不少了","goto":51}]},{"step":51,"content":"说正事儿。不是要我带你玩吗？回答我几个问题，我给你当导游。","style":2,"background":2015,"log_type":1,"src_id":121002051,"trial_step":51},{"step":52,"content":"啸风一歪头，似乎是没想到出来玩还有这么多步骤。","style":3,"background":2015,"log_type":1,"src_id":121002052,"trial_step":52},{"step":53,"content":"在游乐园捣乱的是你吧？那几个跟你走了的孩子呢？他们现在在哪儿？","style":2,"background":2015,"log_type":1,"src_id":121002053,"trial_step":53},{"step":54,"speaker":"啸风","content":"喏，在烤肉摊门口啃串呢，那几只猫也有份。","voice":["vo_trial_21002_1_23"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121002054,"trial_step":54},{"step":55,"content":"还有丢失的珠宝——不对，烤肉摊？你怎么付的钱？","style":2,"background":2015,"log_type":1,"src_id":121002055,"trial_step":55},{"step":56,"speaker":"啸风","content":"你们人都喜欢亮晶晶的玩意儿，我就塞给烤肉摊上的伙计了。哎，还有一些我套在假猫皮上都没人捡，嘿，不会是假的吧？","voice":["vo_trial_21002_1_24"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121002056,"trial_step":56},{"step":57,"content":"那，你那只老虎呢？它可是已经被我抓回MBCC了，你不着急？","style":2,"background":2015,"log_type":1,"src_id":121002057,"trial_step":57},{"step":58,"speaker":"啸风","content":"大咪啊？没事，咱们先玩，它想人了会自个儿溜回来的。","voice":["vo_trial_21002_1_27"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121002058,"trial_step":58},{"step":59,"content":"………………","style":2,"background":2015,"log_type":1,"src_id":121002059,"trial_step":59},{"step":60,"content":"啸风一屁股坐在你边上，乐呵呵说起了自己一路来狄斯的冒险之旅：带着老虎偷渡上来狄斯的货船，又被货船载着一路进入辛迪加；由于一时间找不到你，就只好到处先“溜达溜达”，等你主动来找她。","style":3,"background":2015,"log_type":1,"src_id":121002060,"trial_step":60},{"step":61,"content":"啸风讲得手舞足蹈、绘声绘色，全然不觉得自己闯了多大的祸。而你捂着额头，竭力克制着心中的无语，向她发问。","style":3,"background":2015,"log_type":1,"src_id":121002061,"trial_step":61},{"step":62,"content":"最后烦请山君大人解释一下，这次来狄斯究竟是来干嘛？现在不像是找我玩，倒像是在玩我……","style":2,"background":2015,"log_type":1,"src_id":121002062,"trial_step":62},{"step":63,"speaker":"啸风","content":"当然来找乐子了！","voice":["vo_trial_21002_1_25"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121002063,"trial_step":63},{"step":64,"speaker":"啸风","content":"你和耍梅花的小丫头走了，那几个天天在外面搅混水的家伙也死的死、残的残……多没劲。嘿，还得是你们狄斯这地儿好，热闹，人也热情，都上赶给咱送礼呢。","voice":["vo_trial_21002_1_26"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121002064,"trial_step":64},{"step":65,"content":"啸风顺着舔舔嘴角。你不敢细想她口中“上赶着送礼”的人都是什么意思。","style":3,"background":2015,"log_type":1,"src_id":121002065,"trial_step":65},{"step":66,"content":"不管怎么说，有你跟在边上盯着，总比放她在外面捣乱要好。","style":3,"background":2015,"log_type":1,"src_id":121002066,"trial_step":66},{"step":67,"content":"……总之祖宗你行行好，别乱跑了，小心又被逮到。还想逛什么？我带你去。","style":2,"background":2015,"log_type":1,"src_id":121002067,"trial_step":67},{"step":68,"speaker":"啸风","content":"说到这个，我刚刚路上还瞅着不少好东西——","voice":["vo_trial_21002_1_28"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121002068,"trial_step":68},{"step":69,"content":"啸风眼睛一亮。你略感不妙，还来不及抵抗，就又被拎住衣领，身体腾空而起。","style":3,"background":2015,"log_type":1,"src_id":121002069,"trial_step":69},{"step":70,"speaker":"啸风","content":"乖乖带路吧宝贝儿！有咱在，一准儿保你舒舒服服，吃香喝辣~","voice":["vo_trial_21002_1_29"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121002070,"trial_step":70},{"step":71,"content":"【辛迪加街道】","style":18,"background":100,"log_type":1,"src_id":121002071,"trial_step":71},{"step":72,"content":"你到底还是低估了啸风口中“乐子”的含义。","style":3,"background":100,"log_type":1,"src_id":121002072,"trial_step":72},{"step":73,"content":"从到处蹭吃蹭喝、顺手牵羊，到冲进黑帮交易现场搅混水……只有她不感兴趣的，没有她不敢去做的。","style":3,"background":100,"log_type":1,"src_id":121002073,"trial_step":73},{"step":74,"speaker":"啸风","content":"货？什么货？","voice":["vo_trial_21002_1_30"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":100,"log_type":1,"src_id":121002074,"trial_step":74},{"step":75,"content":"你试着问过啸风，为什么要袭击走私东洲货物的黑帮。而她一歪脑袋，似乎格外意外。","style":3,"background":100,"log_type":1,"src_id":121002075,"trial_step":75},{"step":76,"speaker":"啸风","content":"哦，你说的是那几个铁盒啊。不懂了吧，盒儿里的东西没意思，但那上面的几根木杈子……啧啧，那才是好玩意儿，山里都不好整到的。","voice":["vo_trial_21002_1_73"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":100,"log_type":1,"src_id":121002076,"trial_step":76},{"step":77,"content":"几通波折下来，你也基本摸透了啸风的行事规律：她爱玩闹也爱乐子，就喜欢往危险的地方钻，大多数时候腿在前面跑脑子在后面追。","style":3,"background":100,"log_type":1,"src_id":121002077,"trial_step":77},{"step":78,"content":"至于怎么收尾……","style":3,"background":100,"log_type":1,"src_id":121002078,"trial_step":78},{"step":79,"speaker":"啸风","content":"哈哈哈哈哈哈哈——","voice":["vo_trial_21001_1_41"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":100,"log_type":1,"src_id":121002079,"trial_step":79},{"step":80,"content":"——当然是先打，打不过就跑！","style":3,"background":100,"log_type":1,"src_id":121002080,"trial_step":80},{"step":81,"content":"你只能尽量躲在啸风身后，用大衣外套遮住脸——以防第二天，米诺斯局长的照片先啸风一步贴上通缉令榜首。","style":3,"background":100,"log_type":1,"src_id":121002081,"trial_step":81},{"step":82,"content":"【奇兰广场】","style":18,"background":1048,"log_type":1,"src_id":121002082,"trial_step":82},{"step":83,"content":"傍晚时分，广场上因庆典围聚了不少人。而你和啸风站在广场上——准确的说，是高处的天台外围。","style":3,"background":1048,"log_type":1,"src_id":121002083,"trial_step":83},{"step":84,"content":"啸风手边放了好几个陶壶，已然是酒过三巡。你拒绝了她的共饮邀请，不过啸风也不在意，她躺得四仰八叉，仿佛身下的不是天台，而是一个巨型猫爬架。","style":3,"background":1048,"log_type":1,"src_id":121002084,"trial_step":84},{"step":85,"content":"下方庆典的灯光晃动，她盯着边上手边摇动的光斑，看了半天终于忍不住出手去扑，但却扑了个空——样子倒是让你想起来总在管理局外混吃混喝的那几只胖猫。","style":3,"background":1048,"log_type":1,"src_id":121002085,"trial_step":85},{"step":86,"content":"噗嗤……","style":2,"background":1048,"log_type":1,"src_id":121002086,"trial_step":86},{"step":87,"content":"你的笑声获得了啸风的一个白眼。","style":3,"background":1048,"log_type":1,"src_id":121002087,"trial_step":87},{"step":88,"content":"啸风打了个嗝，甩掉满脑袋酒气。她起身，熟练地拍了拍屁股，冲下方围观的小孩儿喊话。","style":3,"background":1048,"log_type":1,"src_id":121002088,"trial_step":88},{"step":89,"speaker":"啸风","content":"喂——下面几个小崽儿！","voice":["vo_trial_21002_1_74"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002089,"trial_step":89},{"step":90,"speaker":"啸风","content":"山君我初来乍到，想了解狄斯的新鲜玩意——来，谁能给我讲几个好听的故事？说得好，有糖吃。","voice":["vo_trial_21002_1_75"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002090,"trial_step":90},{"step":91,"content":"下方的小孩儿们吓了一跳，但很快就被啸风手中的糖果吸引，犹豫片刻便争先恐后地举手。啸风随手一指，选中了挤得最靠前的一个。","style":3,"background":1048,"log_type":1,"src_id":121002091,"trial_step":91},{"step":92,"speaker":"围观的孩子","content":"我听过好多禁闭者的故事！帅气的军团老大卓娅，召唤闪电的辛迪加无冕之王艾米潘、还有……还有小老鼠海拉，打遍砂海无敌手！","voice":["vo_trial_21002_1_31"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002092,"trial_step":92},{"step":93,"speaker":"啸风","content":"嚯，还有这种事儿呢？有意思——接着。","voice":["vo_trial_21002_1_32"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002093,"trial_step":93},{"step":94,"content":"啸风往下扔了把糖。看到啸风真的会发糖，孩子们都迫不及待等她接着问。","style":3,"background":1048,"log_type":1,"src_id":121002094,"trial_step":94},{"step":95,"speaker":"围观的孩子","content":"我我我！我还听过别的故事！","voice":["vo_trial_21002_1_33"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002095,"trial_step":95},{"step":96,"speaker":"啸风","content":"哦……？","voice":["vo_trial_21002_1_34"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002096,"trial_step":96},{"step":97,"speaker":"围观的孩子","content":"这是我先前在流民寨的商人大叔那里听过的一个东洲故事……","voice":["vo_trial_21002_1_35"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002097,"trial_step":97},{"step":98,"content":"【看看能不能用东洲背景图做点演出】","style":18,"background":2575,"log_type":1,"src_id":121002098,"trial_step":98},{"step":99,"speaker":"围观的孩子","content":"传说很久很久以前，某年东洲战乱，一村人不得不背井离乡，逃进大山脚下生活。","voice":["vo_trial_21002_1_36"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121002099,"trial_step":99},{"step":100,"speaker":"围观的孩子","content":"可是山里那么危险，上山打猎的人们必须成群结队互相保护，才能不被野兽偷袭。","voice":["vo_trial_21002_1_37"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121002100,"trial_step":100},{"step":101,"speaker":"围观的孩子","content":"某天，一个孩子在山路上走丢了。他的妈妈哭呀哭呀，嗓子都快喊破了，漫山遍野地找，但怎么都找不到他……","voice":["vo_trial_21002_1_38"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121002101,"trial_step":101},{"step":102,"speaker":"围观的孩子","content":"直到，他自己从山上下来了！","voice":["vo_trial_21002_1_39"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121002102,"trial_step":102},{"step":103,"options":["自己下来了？"],"style":6,"background":2575,"log_type":1,"src_id":121002103,"trial_step":103,"course":3,"choices":[{"text":"自己下来了？","goto":104}]},{"step":104,"speaker":"围观的孩子","content":"没错！一点儿伤都没有！他说，他在山里遇到了一只银白色的大老虎，老虎保护了他，给了他一条红手绳，还把他送到了下山的正路上！","voice":["vo_trial_21002_1_40"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121002104,"trial_step":104},{"step":105,"speaker":"围观的孩子","content":"人人都说，这是遇到虎仙了。于是从此之后，每个上山人手上都会戴一根红绳，再带一份供奉。有虎仙保佑，就不怕在上山遇到危险啦！","voice":["vo_trial_21002_1_41"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121002105,"trial_step":105},{"step":106,"content":"【回到avg】","style":18,"background":1048,"log_type":1,"src_id":121002106,"trial_step":106},{"step":107,"content":"打头的孩子讲得绘声绘色，听得旁边其他孩子都不禁发出惊叹。","style":3,"background":1048,"log_type":1,"src_id":121002107,"trial_step":107},{"step":108,"speaker":"围观的孩子","content":"咦？那虎仙是从哪来的呢？","voice":["vo_trial_21002_1_42"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002108,"trial_step":108},{"step":109,"speaker":"围观的孩子","content":"笨蛋，老虎可是神仙，肯定是从一开始就在山上的呀！","voice":["vo_trial_21002_1_43"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002109,"trial_step":109},{"step":110,"options":["好耳熟的故事"],"style":6,"background":1048,"log_type":1,"src_id":121002110,"trial_step":110,"course":3,"choices":[{"text":"好耳熟的故事","goto":111}]},{"step":111,"content":"没想到您的“英明事迹”都已经传到狄斯来了。是吧，山君大人？","style":2,"background":1048,"log_type":1,"src_id":121002111,"trial_step":111},{"step":112,"content":"你本想出言打趣啸风，却久久没听见回复。你偏头看去，啸风的脸映在霓虹灯管的反光中，似乎是在笑，却看不清真意。","style":3,"background":1048,"log_type":1,"src_id":121002112,"trial_step":112},{"step":113,"content":"……啸风？","style":2,"background":1048,"log_type":1,"src_id":121002113,"trial_step":113},{"step":114,"content":"【闪白+手电筒打开声音，震屏】","style":18,"background":1048,"log_type":1,"src_id":121002114,"trial_step":114},{"step":115,"speaker":"治安官","content":"喂，那边做什么呢——赶紧下来！","voice":["vo_trial_21002_1_44"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002115,"trial_step":115},{"step":116,"content":"一声呵斥打断了你们的聚会。围在雕像下的小孩儿们瞬间作鸟兽散。射光照出蹲在高处的两人——你和啸风也该跑路了。","style":3,"background":1048,"log_type":1,"src_id":121002116,"trial_step":116},{"step":117,"content":"不过……就你对啸风的了解，她绝对不会选择最常规的退场方式。","style":3,"background":1048,"log_type":1,"src_id":121002117,"trial_step":117},{"step":118,"speaker":"啸风","content":"哈，来得正好。吃饱喝足，该起来活动活动、消化消化食儿了。各位，咱们有钱的捧个钱场，有手有嘴的就鼓个掌叫个好——","voice":["vo_trial_21002_1_45"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002118,"trial_step":118},{"step":119,"content":"啸风气势汹汹立在奇兰头顶，居高临下俯视手举警棍和盾牌的治安队，松垮的外衣在风中猎猎作响。","style":3,"background":1048,"log_type":1,"src_id":121002119,"trial_step":119},{"step":120,"content":"但在动手的前一秒，她的眼前突然晃过一个闪亮的光点。","style":3,"background":1048,"log_type":1,"src_id":121002120,"trial_step":120},{"step":121,"speaker":"啸风","content":"？！——啥玩意儿？！","voice":["vo_trial_21002_1_46"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1048,"log_type":1,"src_id":121002121,"trial_step":121},{"step":122,"content":"身体先于意识行动，啸风一头扑向花坛里的光点。身上不知从哪儿摸来的糖果、彩纸、漂亮小玩意儿，零散的宝石珍珠，顿时花花绿绿、金碧辉煌洒了漫天。","style":3,"background":1048,"log_type":1,"src_id":121002122,"trial_step":122},{"step":123,"content":"而你……你偷偷关掉了手电筒，立起衣领遮住这张人尽皆知的脸，迅速绕开治安队，在孩子们的惊呼，以及治安队的叫喊中跑去花坛捞人。","style":3,"background":1048,"log_type":1,"src_id":121002123,"trial_step":123},{"step":124,"content":"【换个背景，辛迪加暗巷】","style":18,"background":907,"log_type":1,"src_id":121002124,"trial_step":124},{"step":125,"content":"你拽着啸风的手在辛迪加曲里拐弯的暗巷里一路狂奔。","style":3,"background":907,"log_type":1,"src_id":121002125,"trial_step":125},{"step":126,"speaker":"啸风","content":"呦呵？腿脚还挺利索。","voice":["vo_trial_21002_1_47"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002126,"trial_step":126},{"step":127,"content":"还不是为了抓捕某些腿脚更利索的家伙，特意练的吗？","style":2,"background":907,"log_type":1,"src_id":121002127,"trial_step":127},{"step":128,"content":"你跑得呼哧带喘，自然语气也没带什么好气儿。不过啸风倒是不在意，语气还是笑呵呵的。","style":3,"background":907,"log_type":1,"src_id":121002128,"trial_step":128},{"step":129,"speaker":"啸风","content":"你咋想到的？咋就知道我迷那个会动的亮圆圈儿？","voice":["vo_trial_21002_1_48"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002129,"trial_step":129},{"step":130,"speaker":"啸风","content":"不愧是咱瞧中的家伙，要不要考虑换份工跟我混？我这儿也很需要你这种宝贝。","voice":["vo_trial_21002_1_49"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002130,"trial_step":130},{"step":131,"content":"比方说？","style":2,"background":907,"log_type":1,"src_id":121002131,"trial_step":131},{"step":132,"speaker":"啸风","content":"游山玩水、吃喝玩乐，遇到打架斗殴还能再掺和一脚。","voice":["vo_trial_21002_1_50"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002132,"trial_step":132},{"step":133,"content":"不好意思，暂不考虑。","style":2,"background":907,"log_type":1,"src_id":121002133,"trial_step":133},{"step":134,"content":"你回答得斩钉截铁、义正词严。","style":3,"background":907,"log_type":1,"src_id":121002134,"trial_step":134},{"step":135,"speaker":"啸风","content":"是嘛，那可就难整了，我瞅前头那哥几个儿，对咱俩都挺感兴趣的……","voice":["vo_trial_21002_1_51"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002135,"trial_step":135},{"step":136,"content":"啸风的声音减弱。你感到手上传来一股力道，拉得你直向后，倒入一个充斥着酒气的怀抱。你一时间没反应过来，想说话，却被啸风直接扣着脑袋摁进她怀里。","style":3,"background":907,"log_type":1,"src_id":121002136,"trial_step":136},{"step":137,"options":["？啸风，你又干什么——"],"style":6,"background":907,"log_type":1,"src_id":121002137,"trial_step":137,"course":3,"choices":[{"text":"？啸风，你又干什么——","goto":138}]},{"step":138,"content":"嘘——啸风轻轻将手指贴在唇边，然后指向前方。顺势借着酒馆廉价的霓虹，你看清了黑暗里的轮廓。巷口停着一辆不起眼的货车，两波黑衣人正往你们的方向警惕张望。","style":3,"background":907,"log_type":1,"src_id":121002138,"trial_step":138},{"step":139,"content":"为首的男人慢慢转过头，露出一张疤脸，目光落在你和啸风诡异的姿势上。","style":3,"background":907,"log_type":1,"src_id":121002139,"trial_step":139},{"step":140,"speaker":"黑衣人1","content":"……什么人？你叫来的？","voice":["vo_trial_21002_1_52"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002140,"trial_step":140},{"step":141,"speaker":"黑衣人2","content":"没有啊，我还以为是你找来搬货的。","voice":["vo_trial_21002_1_53"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002141,"trial_step":141},{"step":142,"content":"好消息，对方并没认出你们。但……坏消息，对方显然也没打算放过你们。黑衣男人侧身堵住巷口，手伸进衣襟中，显然是准备随时拔枪。","style":3,"background":907,"log_type":1,"src_id":121002142,"trial_step":142},{"step":143,"content":"你正想着如何脱困时，啸风突然一呲虎牙，揽着你大胆地往前走了两步。她脚步虚浮满身醉意，简直像是误入此地的路人。","style":3,"background":907,"log_type":1,"src_id":121002143,"trial_step":143},{"step":144,"speaker":"啸风","content":"哟，我这朋友喝多了脑子确实不大好使，但也是道上有名有姓的。这张脸认得吗？他可是大名鼎鼎的糯米糍局长。","female_content":"哟，我这朋友喝多了脑子确实不大好使，但也是道上有名有姓的。这张脸认得吗？她可是大名鼎鼎的糯米糍局长。","voice":["vo_trial_21002_1_56"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002144,"trial_step":144},{"step":145,"speaker":"黑衣人2","content":"糯米糍局长？你说这个立着领子装深沉的倒霉蛋，和那个叼木棍的傻大妞？","voice":["vo_trial_21002_1_57"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002145,"trial_step":145},{"step":146,"content":"黑衣男人左看右看，突然盯住啸风的脸，似乎想起来什么。","style":3,"background":907,"log_type":1,"src_id":121002146,"trial_step":146},{"step":147,"speaker":"黑衣人1","content":"不对……高个子、白头发、头上长耳朵的女人……","voice":["vo_trial_21002_1_54"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002147,"trial_step":147},{"step":148,"speaker":"黑衣人1","content":"这是那个才抢了咱们货的混蛋！！","voice":["vo_trial_21002_1_55"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002148,"trial_step":148},{"step":149,"content":"你瞬间转头。啸风朝你咧嘴一笑，满脸无辜。","style":3,"background":907,"log_type":1,"src_id":121002149,"trial_step":149},{"step":150,"options":["怎么到处都有你的仇家？？"],"style":6,"background":907,"log_type":1,"src_id":121002150,"trial_step":150,"course":3,"choices":[{"text":"怎么到处都有你的仇家？？","goto":151}]},{"step":151,"content":"未等啸风回答，十几个着装统一的大汉从车里跳出来，将你们包围。顿时，狭窄的巷子显得格外拥挤。","style":3,"background":907,"log_type":1,"src_id":121002151,"trial_step":151},{"step":152,"speaker":"黑衣人1","content":"哼！赶紧把货给我们吐出来，不然要你们好看！","voice":["vo_trial_21002_1_58"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002152,"trial_step":152},{"step":153,"content":"咔哒——枪支上膛的声音分外明晰。","style":3,"background":907,"log_type":1,"src_id":121002153,"trial_step":153},{"step":154,"speaker":"啸风","content":"嚯……几个小崽子，山里没老虎，就胆子肥想当大王了……","voice":["vo_trial_21002_1_59"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002154,"trial_step":154},{"step":155,"content":"你被啸风摁在怀里，看不清她的表情，但明显能感觉到她的跃跃欲试。","style":3,"background":907,"log_type":1,"src_id":121002155,"trial_step":155},{"step":156,"content":"你当然不怀疑啸风的战斗力……只是，若凭着她在这里打起来，肯定又会造成无数破坏。","style":3,"background":907,"log_type":1,"src_id":121002156,"trial_step":156},{"step":157,"content":"你下意识摸向怀里，才想起通讯器早被揽着你的山君大人丢得不知道哪去了。余光扫过附近地形——四周已经被人包围。你们该如何突围？又该如何逃跑？","style":3,"background":907,"log_type":1,"src_id":121002157,"trial_step":157},{"step":158,"content":"视线掠过头顶，你突然有了主意。","style":3,"background":907,"log_type":1,"src_id":121002158,"trial_step":158},{"step":159,"content":"啸风！再表演一次<color=#fb9259>那个</color>，给他们涨涨见识！","style":2,"background":907,"log_type":1,"src_id":121002159,"trial_step":159},{"step":160,"speaker":"黑衣人1","content":"那个？","voice":["vo_trial_21002_1_60"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002160,"trial_step":160},{"step":161,"speaker":"黑衣人2","content":"哪个？","voice":["vo_trial_21002_1_61"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002161,"trial_step":161},{"step":162,"content":"四周都被围堵，没有突破口——于是你向上指天。","style":3,"background":907,"log_type":1,"src_id":121002162,"trial_step":162},{"step":163,"speaker":"黑衣人2","content":"*辛迪加粗口*，什么这个那个，你们条子脑袋都不太好使吗？！","voice":["vo_trial_21002_1_62"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002163,"trial_step":163},{"step":164,"speaker":"啸风","content":"那个啊……","voice":["vo_trial_21002_1_63"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002164,"trial_step":164},{"step":165,"content":"啸风嘴角上扬。","style":3,"background":907,"log_type":1,"src_id":121002165,"trial_step":165},{"step":166,"speaker":"啸风","content":"既然你诚心诚意地求了……那山君我，就勉为其难，再表演一次吧。","voice":["vo_trial_21002_1_64"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002166,"trial_step":166},{"step":167,"content":"啸风表情严肃下来，她高高竖起一根手指向上指天，然后缓缓收回，拇指与食指圈起抵在嘴边。","style":3,"background":907,"log_type":1,"src_id":121002167,"trial_step":167},{"step":168,"content":"【空场1s，口哨声音，紧接着是流浪猫的大叫】","style":18,"background":907,"log_type":1,"src_id":121002168,"trial_step":168},{"step":169,"speaker":"黑衣人1","content":"啊？！——这、这什么东西？！","voice":["vo_trial_21002_1_65"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002169,"trial_step":169},{"step":170,"content":"随着一声口哨，黑暗中瞬间亮起无数闪着幽光的眼睛。无数只怪叫着的生物从天而降，影子一样嗖嗖扑向围上来的黑帮众人。","style":3,"background":907,"log_type":1,"src_id":121002170,"trial_step":170},{"step":171,"speaker":"黑衣人们","content":"猫？！","voice":["vo_trial_21002_1_66"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002171,"trial_step":171},{"step":172,"speaker":"啸风","content":"哈哈哈哈哈哈哈哈——","voice":["vo_trial_21002_1_67"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002172,"trial_step":172},{"step":173,"content":"啸风甩起大衣，扑面盖住前方的黑帮，抬脚飞踢，对方的手腕发出清脆的喀嚓声，枪应声而落，被她一把捞起扔给你。","style":3,"background":907,"log_type":1,"src_id":121002173,"trial_step":173},{"step":174,"options":["接过枪，加入战斗！"],"style":6,"background":907,"log_type":1,"src_id":121002174,"trial_step":174,"course":3,"choices":[{"text":"接过枪，加入战斗！","goto":175}]},{"step":175,"content":"虎爪、棍棒、拳脚、改装枪四管齐下，巷子里顿时战得乱作一团。","style":3,"background":907,"log_type":1,"src_id":121002175,"trial_step":175},{"step":176,"content":"骨头的闷响、金属的撞击和吃痛的叫骂混成一片。不断有人被打得踉跄后退，棍风枪影间，惨叫和闷哼此起彼伏。","style":3,"background":907,"log_type":1,"src_id":121002176,"trial_step":176},{"step":177,"content":"直到站着的只剩下你和她两个，躺着的全都在哭爹喊娘，你才喊啸风停手。","style":3,"background":907,"log_type":1,"src_id":121002177,"trial_step":177},{"step":178,"content":"差不多了，再打下去就问不出话来了。","style":2,"background":907,"log_type":1,"src_id":121002178,"trial_step":178},{"step":179,"content":"你到货车边上搜查，拨开最上面那层伪装用的木天蓼枝干，撬开铅封木箱。","style":3,"background":907,"log_type":1,"src_id":121002179,"trial_step":179},{"step":180,"content":"二级走私药品，数量足够他们关几个月了。","style":2,"background":907,"log_type":1,"src_id":121002180,"trial_step":180},{"step":181,"content":"你搜出黑帮的通讯设备，顺手呼叫了辛迪加治安管理局。余光里，啸风也停下脚步，对着那车违禁品翻箱倒柜，啧啧称奇。","style":3,"background":907,"log_type":1,"src_id":121002181,"trial_step":181},{"step":182,"speaker":"啸风","content":"我说什么来着，你把好苗子都抓进去了。这几个都是小喽啰，打起来都不够填牙缝的。","voice":["vo_trial_21002_1_68"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002182,"trial_step":182},{"step":183,"content":"她摸出一根木天蓼枝叼在嘴里，又抓出一把扔出去——给那帮立了大功的流浪猫。","style":3,"background":907,"log_type":1,"src_id":121002183,"trial_step":183},{"step":184,"content":"瞬间，整条暗巷又多了一群磨蹭着木天蓼，满意地遍地打滚的猫咪。猫叫混合着黑帮虚弱的呻吟，场面一时变得十分滑稽。","style":3,"background":907,"log_type":1,"src_id":121002184,"trial_step":184},{"step":185,"content":"就算老虎不在身边，也能唤来群猫相助。不愧是堂堂山君，果然厉害。","style":2,"background":907,"log_type":1,"src_id":121002185,"trial_step":185},{"step":186,"content":"啸风蹲在地上，手法娴熟地撸着一只三花猫，摸猫的方式与先前摸老虎如出一辙。","style":3,"background":907,"log_type":1,"src_id":121002186,"trial_step":186},{"step":187,"content":"你蹲下也想撸猫，可对方却突然竖起耳朵，跳起来撒腿就跑。你目瞪口呆，恍惚听到警笛声才反应过来——这些“小老虎们”耳朵可比你好使多了。","style":3,"background":907,"log_type":1,"src_id":121002187,"trial_step":187},{"step":188,"content":"耳边传来一声嗤笑。啸风也伸个懒腰起立，却被你喊住。","style":3,"background":907,"log_type":1,"src_id":121002188,"trial_step":188},{"step":189,"content":"啸风。","style":2,"background":907,"log_type":1,"src_id":121002189,"trial_step":189},{"step":190,"speaker":"啸风","content":"嗯？","voice":["vo_trial_21002_1_69"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002190,"trial_step":190},{"step":191,"content":"下一站，你想不想去个更刺激的地方？","style":2,"background":907,"log_type":1,"src_id":121002191,"trial_step":191},{"step":192,"speaker":"啸风","content":"行啊，走着！","voice":["vo_trial_21002_1_70"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":907,"log_type":1,"src_id":121002192,"trial_step":192},{"step":193,"content":"【黑屏】","style":18,"background":10000,"log_type":1,"src_id":121002193,"trial_step":193},{"step":194,"speaker":"啸风","content":"……嚯，我还寻思着你准备去哪……","voice":["vo_trial_21002_1_71"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":10000,"log_type":1,"src_id":121002194,"trial_step":194},{"step":195,"speaker":"啸风","content":"合着这就是你说的，“更刺激的地方”？","voice":["vo_trial_21002_1_72"],"voice_bank":"vo_xiaofeng_trial","style":1,"log_type":1,"src_id":121002197,"trial_step":197,"drawing":1021000}]}