{"id":1120601,"chapter_id":1120601,"scene_id":1,"steps":[{"step":1,"speaker":"莓丝","content":"你来啦！","style":1,"log_type":1,"src_id":220601002,"trial_step":2,"drawing":1120601},{"step":2,"content":"见到你进入审查室，莓丝满脸期待地向你凑了过来。","style":3,"log_type":1,"src_id":220601003,"trial_step":3,"drawing":1120601},{"step":3,"speaker":"莓丝","content":"这里无聊死了，我什么时候能出去啊？","style":1,"log_type":1,"src_id":220601004,"trial_step":4,"drawing":1120601},{"step":4,"speaker":"莓丝","content":"我还拖欠着好几个订单呢，要不让我做完再回来吧。","style":1,"log_type":1,"src_id":220601005,"trial_step":5,"drawing":1120601},{"step":5,"content":"严肃点，莓丝。","style":2,"log_type":1,"src_id":220601006,"trial_step":6,"drawing":1120601},{"step":6,"content":"我知道你做过什么，也清楚你的手段，","style":2,"log_type":1,"src_id":220601007,"trial_step":7,"drawing":1120601},{"step":7,"content":"现在，我问，你答，我们尽快结束。","style":2,"log_type":1,"src_id":220601008,"trial_step":8,"drawing":1120601},{"step":8,"speaker":"莓丝","content":"嘻嘻……你审查别人也这么严肃吗？有意思。","style":1,"log_type":1,"src_id":220601009,"trial_step":9,"drawing":1120603},{"step":9,"speaker":"莓丝","content":"好吧好吧，我就大发慈悲地配合你。有什么想问的，赶紧说吧。","style":1,"log_type":1,"src_id":220601010,"trial_step":10,"drawing":1120603},{"step":10,"speaker":"新城治安员","content":"……袭击者使用了一种未知的毒气弹。普通人吸入后M值会异常升高，呈现出严重的亢奋、易怒和癫狂状态。","style":1,"background":1040,"log_type":1,"src_id":220601011,"trial_step":11},{"step":11,"speaker":"新城治安员","content":"部分吸入者会无差别攻击其他人，目前受害者已经破百……","style":1,"background":1040,"log_type":1,"src_id":220601012,"trial_step":12},{"step":12,"speaker":"新城治安员","content":"我们完全无法保存毒剂的样本。一旦引爆，残留的毒剂哪怕保存在密封容器中也会因不明原因逸散。","style":1,"background":1040,"log_type":1,"src_id":220601013,"trial_step":13},{"step":13,"speaker":"新城治安员","content":"袭击者非常谨慎，他们似乎很熟悉新城的监控系统，我们找不到他们的踪迹。","style":1,"background":1040,"log_type":1,"src_id":220601014,"trial_step":14},{"step":14,"content":"所以你们没有任何有效线索吗？","style":2,"background":1040,"log_type":1,"src_id":220601015,"trial_step":15},{"step":15,"speaker":"新城治安员","content":"……也不完全是，我们找到了这个。","style":1,"background":1040,"log_type":1,"src_id":220601016,"trial_step":16},{"step":16,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":17,"course":6,"drawing":1120602},{"step":17,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":17,"course":6,"drawing":1120602},{"step":18,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":17,"course":6,"drawing":1120602},{"step":19,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":17,"course":6,"drawing":1120602},{"step":20,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":17,"course":6,"drawing":1120602},{"step":21,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":17,"course":6,"drawing":1120602},{"step":22,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":17,"course":6,"drawing":1120602},{"step":23,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":17,"course":6,"drawing":1120602},{"step":24,"speaker":"莓丝","content":"也就是说……","style":1,"log_type":1,"src_id":220601018,"trial_step":18,"drawing":1120602},{"step":25,"speaker":"莓丝","content":"因为这个上面印着我工坊商标的空罐子，那些没用的治安员就觉得是我干的？","style":1,"log_type":1,"src_id":220601019,"trial_step":19,"drawing":1120602},{"step":26,"content":"你有嫌疑。","style":2,"log_type":1,"src_id":220601020,"trial_step":20,"drawing":1120602},{"step":27,"speaker":"莓丝","content":"我最近一直在你这里呀。","style":1,"log_type":1,"src_id":220601021,"trial_step":21,"drawing":1120604},{"step":28,"speaker":"莓丝","content":"要是我还能出去到处安毒气弹，是不是说明你跟我也是一伙的啊？","style":1,"log_type":1,"src_id":220601022,"trial_step":22,"drawing":1120604},{"step":29,"options":["你很可能有团队"],"style":6,"log_type":1,"src_id":220601023,"trial_step":23,"course":3,"drawing":1120602,"choices":[{"text":"你很可能有团队","goto":24}]},{"step":30,"content":"武器工匠并不需要亲临现场。你完全有可能加入过一个团伙。","style":2,"log_type":1,"src_id":220601024,"trial_step":24,"drawing":1120602},{"step":31,"speaker":"莓丝","content":"哦，好推理。","style":1,"log_type":1,"src_id":220601025,"trial_step":25,"drawing":1120601},{"step":32,"content":"莓丝一脸赞扬的表情。","style":3,"log_type":1,"src_id":220601026,"trial_step":26,"drawing":1120601},{"step":33,"speaker":"莓丝","content":"然后呢？你有证据吗？","style":1,"log_type":1,"src_id":220601027,"trial_step":27,"drawing":1120601},{"step":34,"content":"遗憾的是，你没有。新城治安机构提供的线索少之又少。就算MBCC亲自出动搜索情报，你们也没有发现莓丝与他人之间有什么勾连。","style":3,"log_type":1,"src_id":220601028,"trial_step":28,"drawing":1120601},{"step":35,"speaker":"莓丝","content":"没有吧，那要不就算了？我腻了，让我回去吧。","style":1,"log_type":1,"src_id":220601029,"trial_step":29,"drawing":1120601},{"step":36,"content":"莓丝显然没有打算好好配合你。","style":3,"log_type":1,"src_id":220601030,"trial_step":30,"drawing":1120601},{"step":37,"content":"然而，成千上万新城市民的人身安全危在旦夕。现在不是陪她玩猜谜游戏的时间了。","style":3,"log_type":1,"src_id":220601031,"trial_step":31,"drawing":1120601},{"step":38,"content":"听着，莓丝。现在袭击者身份未明，新城数百万人的生命安全都在面临威胁。","style":2,"log_type":1,"src_id":220601032,"trial_step":32,"drawing":1120601},{"step":39,"content":"我知道你不关心这些，也不在乎谁会受伤或是丢掉性命。","style":2,"log_type":1,"src_id":220601033,"trial_step":33,"drawing":1120601},{"step":40,"content":"但我必须履行职责。你最好配合我，否则……","style":2,"log_type":1,"src_id":220601034,"trial_step":34,"drawing":1120601},{"step":41,"content":"若有必要，我会使用更加强硬的手段。","style":2,"log_type":1,"src_id":220601035,"trial_step":35,"drawing":1120601},{"step":42,"speaker":"莓丝","content":"嗯——？","style":1,"log_type":1,"src_id":220601036,"trial_step":36,"drawing":1120603},{"step":43,"content":"莓丝似乎没有被你严肃的态度吓到，反而笑了出来。","style":3,"log_type":1,"src_id":220601037,"trial_step":37,"drawing":1120603},{"step":44,"content":"那副笑容看着令人有些烦躁。","style":3,"log_type":1,"src_id":220601038,"trial_step":38,"drawing":1120603},{"step":45,"speaker":"莓丝","content":"欸，怎么办呢，谁叫我只是个被收容的禁闭者呢……你有枷锁，我难道还能反抗你吗？","style":1,"log_type":1,"src_id":220601039,"trial_step":39,"drawing":1120603},{"step":46,"speaker":"莓丝","content":"但在我乖乖配合你之前，我也有几个问题想要问你。","style":1,"log_type":1,"src_id":220601040,"trial_step":40,"drawing":1120603},{"step":47,"options":["同意","拒绝"],"style":6,"log_type":1,"src_id":220601041,"trial_step":41,"course":3,"drawing":1120603,"choices":[{"text":"同意","goto":42},{"text":"拒绝","goto":43}]},{"step":48,"speaker":"莓丝","content":"哈，我就知道你很爽快。那我可问了啊。","style":1,"log_type":1,"src_id":220601042,"trial_step":42,"drawing":1120601,"next":[48]},{"step":49,"content":"如果我说不呢？","style":2,"log_type":1,"src_id":220601043,"trial_step":43,"drawing":1120603},{"step":50,"speaker":"莓丝","content":"那我就会拼命抵抗，能多拖延一点时间就多拖延一点时间。","style":1,"log_type":1,"src_id":220601044,"trial_step":44,"drawing":1120603},{"step":51,"speaker":"莓丝","content":"虽然最后肯定没办法抵抗无敌的枷锁束缚，但我一定会努力多恶心你一会儿。","style":1,"log_type":1,"src_id":220601045,"trial_step":45,"drawing":1120603},{"step":52,"speaker":"莓丝","content":"你觉得怎么样？","style":1,"log_type":1,"src_id":220601046,"trial_step":46,"drawing":1120603},{"step":53,"content":"这不是个好选择。","style":3,"log_type":1,"src_id":220601047,"trial_step":47,"drawing":1120603},{"step":54,"content":"与其和她在无聊的博弈中浪费时间，不如尽快回答她的问题。","style":3,"log_type":1,"src_id":220601048,"trial_step":48,"drawing":1120603},{"step":55,"content":"问吧。","style":2,"log_type":1,"src_id":220601049,"trial_step":49,"drawing":1120603},{"step":56,"content":"莓丝的嘴角划过一抹得逞的讪笑。","style":3,"log_type":1,"src_id":220601050,"trial_step":50,"drawing":1120601},{"step":57,"speaker":"莓丝","content":"好，那第一个问题——","style":1,"log_type":1,"src_id":220601051,"trial_step":51,"drawing":1120601},{"step":58,"speaker":"莓丝","content":"新城有你特别在乎的人吗？","style":1,"log_type":1,"src_id":220601052,"trial_step":52,"drawing":1120601},{"step":59,"content":"……","style":2,"log_type":1,"src_id":220601053,"trial_step":53,"drawing":1120601},{"step":60,"content":"这个问题你一时不知道该如何回答。","style":3,"log_type":1,"src_id":220601054,"trial_step":54,"drawing":1120601},{"step":61,"speaker":"莓丝","content":"应该是没有吧？我听说过的，MBCC的新任局长是个失忆后还被赶鸭子上架的可怜人。","style":1,"log_type":1,"src_id":220601055,"trial_step":55,"drawing":1120601},{"step":62,"speaker":"莓丝","content":"没上任多久就得忙着满世界救火，想必也没时间在新城结识什么人吧？","style":1,"log_type":1,"src_id":220601056,"trial_step":56,"drawing":1120601},{"step":63,"speaker":"莓丝","content":"好啦，这个问题就当你回答过了，下一个。","style":1,"log_type":1,"src_id":220601057,"trial_step":57,"drawing":1120601},{"step":64,"speaker":"莓丝","content":"毒气弹这事理论上该由你处理吗？","style":1,"log_type":1,"src_id":220601058,"trial_step":58,"drawing":1120601},{"step":65,"speaker":"莓丝","content":"应该不是吧——你的职责只是抓捕禁闭者、处理黑环异变。这种小事，怎么也轮不到你去管啊。","style":1,"log_type":1,"src_id":220601059,"trial_step":59,"drawing":1120601},{"step":66,"speaker":"莓丝","content":"不好意思啊，前面那几个问题我已经忘记了。只回答最后一个可以吗？关于我的作品……","style":1,"log_type":1,"src_id":220601060,"trial_step":60,"drawing":1120601},{"step":67,"speaker":"莓丝","content":"你就没有想过，你做的这一切真的有意义吗？","style":1,"log_type":1,"src_id":220601061,"trial_step":61,"drawing":1120601},{"step":68,"content":"莓丝捂住了嘴，仿佛是在掩饰笑意。","style":3,"log_type":1,"src_id":220601062,"trial_step":62,"drawing":1120602},{"step":69,"speaker":"莓丝","content":"好可怜哦，每天被这个机构使唤，为那个长官跑腿。明明一次次地竭尽全力赌上性命，却连一句感谢的话都听不到。","style":1,"log_type":1,"src_id":220601063,"trial_step":63,"drawing":1120602},{"step":70,"speaker":"莓丝","content":"仔细想想，你有受到过他们哪怕一丝一毫的尊重吗？","style":1,"log_type":1,"src_id":220601064,"trial_step":64,"drawing":1120602},{"step":71,"speaker":"莓丝","content":"在那些人眼里，你不过是一把趁手的武器罢了——专门替他们干些又脏又累还见不得人的勾当。","style":1,"log_type":1,"src_id":220601065,"trial_step":65,"drawing":1120602},{"step":72,"speaker":"莓丝","content":"这样看来，你和我锻造的那些小可爱们根本没区别嘛。不对，我的小可爱们可是会被买家们好好收藏养护的，哈哈哈哈哈……","style":1,"log_type":1,"src_id":220601066,"trial_step":66,"drawing":1120602},{"step":73,"speaker":"莓丝","content":"或者……","style":1,"log_type":1,"src_id":220601067,"trial_step":67,"drawing":1120602},{"step":74,"content":"莓丝再一次俯身凑近你。","style":3,"log_type":1,"src_id":220601068,"trial_step":68,"drawing":1120604},{"step":75,"speaker":"莓丝","content":"或者你也可以让他们看看，你不是什么武器。","style":1,"log_type":1,"src_id":220601069,"trial_step":69,"drawing":1120604},{"step":76,"speaker":"莓丝","content":"割开他们妄图操控你的手，让他们见见血……你不觉得这样很刺激吗？","style":1,"log_type":1,"src_id":220601070,"trial_step":70,"drawing":1120604},{"step":77,"content":"莓丝在你耳边低语着，犹如挑拨人心的恶魔。","style":3,"log_type":1,"src_id":220601071,"trial_step":71,"drawing":1120604},{"step":78,"speaker":"莓丝","content":"那些傲慢的上位者必须付出代价。${PlayerName}，你有力量，有真正忠于你的禁闭者，这理由够充分了……","style":1,"log_type":1,"src_id":220601072,"trial_step":72,"drawing":1120603},{"step":79,"speaker":"莓丝","content":"去吧，别再被操纵了，让尸位素餐的废物都见鬼去吧，你才是狄斯城的主宰……","style":1,"log_type":1,"src_id":220601073,"trial_step":73,"drawing":1120603},{"step":80,"options":["赞同莓丝","拒绝莓丝"],"style":6,"log_type":1,"src_id":220601074,"trial_step":74,"course":3,"drawing":1120603,"choices":[{"text":"赞同莓丝","goto":75},{"text":"拒绝莓丝","goto":78}]},{"step":81,"content":"是的，我应该成为主宰——","style":2,"log_type":1,"src_id":220601075,"trial_step":75,"drawing":1120603},{"step":82,"content":"当我成为主宰之后，我会消除狂厄，让狄斯城得到真正的和平。","style":2,"log_type":1,"src_id":220601076,"trial_step":76,"drawing":1120603},{"step":83,"content":"莓丝看到你戏谑的表情明显愣住了一会儿，旋即又爆发出一连串的笑声。","style":3,"log_type":1,"src_id":220601077,"trial_step":77,"drawing":1120601,"next":[81]},{"step":84,"content":"不，我不需要。","style":2,"log_type":1,"src_id":220601078,"trial_step":78,"drawing":1120603},{"step":85,"content":"我只希望狂厄被根除，狄斯城获得真正的和平。","style":2,"log_type":1,"src_id":220601079,"trial_step":79,"drawing":1120603},{"step":86,"content":"莓丝愣了一下，看着你的脸，旋即爆发出一连串的笑声。","style":3,"log_type":1,"src_id":220601080,"trial_step":80,"drawing":1120601},{"step":87,"speaker":"莓丝","content":"哈哈哈哈哈哈哈太有意思了，太有意思了！","style":1,"log_type":1,"src_id":220601081,"trial_step":81,"drawing":1120601},{"step":88,"speaker":"莓丝","content":"这还是第一次……有人被说中了心中所想之后，还能跟个没事人似地拒绝我的提议，哈哈哈哈哈哈！","style":1,"log_type":1,"src_id":220601082,"trial_step":82,"drawing":1120601},{"step":89,"speaker":"莓丝","content":"哈哈哈哈……明明你身后有那——么巨大的黑暗和恶意，居然没有被它控制……你究竟还算不算人啊哈哈哈哈哈哈哈……","style":1,"log_type":1,"src_id":220601083,"trial_step":83,"drawing":1120601},{"step":90,"options":["你的问题问完了吗？"],"style":6,"log_type":1,"src_id":220601084,"trial_step":84,"course":3,"drawing":1120601,"choices":[{"text":"你的问题问完了吗？","goto":85}]},{"step":91,"speaker":"莓丝","content":"哈哈……抱歉抱歉……问完了。","style":1,"log_type":1,"src_id":220601085,"trial_step":85,"drawing":1120601},{"step":92,"speaker":"莓丝","content":"你也不用再说什么了，我已经知道答案了。","style":1,"log_type":1,"src_id":220601086,"trial_step":86,"drawing":1120601},{"step":93,"speaker":"莓丝","content":"礼尚往来，轮到我回答你的问题了。","style":1,"log_type":1,"src_id":220601087,"trial_step":87,"drawing":1120601},{"step":94,"content":"莓丝坐直身体，抹了抹眼角因狂笑而溢出的眼泪，重新露出那副狡黠得让人有些讨厌的笑容。","style":3,"log_type":1,"src_id":220601088,"trial_step":88,"drawing":1120602},{"step":95,"content":"不等你开口，她就先拿起了那个小小的空罐。","style":3,"log_type":1,"src_id":220601089,"trial_step":89,"drawing":1120602},{"step":96,"speaker":"莓丝","content":"我知道你想问什么——开门见山地说，这个东西是我造的。","style":1,"log_type":1,"src_id":220601090,"trial_step":90,"drawing":1120602},{"step":97,"speaker":"莓丝","content":"不过呢，袭击者的确不是我的同伙。至少在造这玩意儿的时候，主顾应该没告诉过我它的用途。","style":1,"log_type":1,"src_id":220601091,"trial_step":91,"drawing":1120602},{"step":98,"speaker":"莓丝","content":"至于这位主顾的线索，对不起，我想不起来了。","style":1,"log_type":1,"src_id":220601092,"trial_step":92,"drawing":1120602},{"step":99,"content":"这个东西被造出来不超过半年，你不该没印象。","style":2,"log_type":1,"src_id":220601093,"trial_step":93,"drawing":1120602},{"step":100,"speaker":"莓丝","content":"你记得半年前的今天跟谁一起吃过饭吗？","style":1,"log_type":1,"src_id":220601094,"trial_step":94,"drawing":1120603},{"step":101,"speaker":"莓丝","content":"拜托，我每周都会接到好几笔订单，谁会事无巨细地都记在脑子里啊。","style":1,"log_type":1,"src_id":220601095,"trial_step":95,"drawing":1120603},{"step":102,"content":"你想说你对于这一切一无所知？","style":2,"log_type":1,"src_id":220601096,"trial_step":96,"drawing":1120603},{"step":103,"speaker":"莓丝","content":"别急嘛，我当然还是会帮你的。","style":1,"log_type":1,"src_id":220601097,"trial_step":97,"drawing":1120601},{"step":104,"speaker":"莓丝","content":"毕竟我还在期待你能给我多少惊喜呢……","style":1,"log_type":1,"src_id":220601098,"trial_step":98,"drawing":1120601},{"step":105,"content":"那你还能提供什么情报？","style":2,"log_type":1,"src_id":220601099,"trial_step":99,"drawing":1120601},{"step":106,"speaker":"莓丝","content":"新城花园大道109号15层，那里是我的私人工坊。","style":1,"log_type":1,"src_id":220601100,"trial_step":100,"drawing":1120601},{"step":107,"speaker":"莓丝","content":"过去两年所有主顾的订单账本我都留在那里，只要有它……","style":1,"log_type":1,"src_id":220601101,"trial_step":101,"drawing":1120601},{"step":108,"content":"听完莓丝的话，你立刻起身，同时打开了通讯器。","style":3,"log_type":1,"src_id":220601102,"trial_step":102,"drawing":1120601},{"step":109,"content":"嗯，替我准备车，去新城……","style":2,"log_type":1,"src_id":220601103,"trial_step":103,"drawing":1120601},{"step":110,"speaker":"莓丝","content":"等等等等，我也一起去！","style":1,"log_type":1,"src_id":220601104,"trial_step":104,"drawing":1120604},{"step":111,"content":"你转过身。","style":3,"log_type":1,"src_id":220601105,"trial_step":105,"drawing":1120604},{"step":112,"content":"你还没有洗脱嫌疑。","style":2,"log_type":1,"src_id":220601106,"trial_step":106,"drawing":1120604},{"step":113,"speaker":"莓丝","content":"我把账本藏起来了！而且那些账本可是加密过的，只有我一个人能看懂。","style":1,"log_type":1,"src_id":220601107,"trial_step":107,"drawing":1120601},{"step":114,"speaker":"莓丝","content":"别这么盯着我，我一向很注重主顾的个人隐私。","style":1,"log_type":1,"src_id":220601108,"trial_step":108,"drawing":1120601},{"step":115,"content":"看着你冰冷的眼神，莓丝索性耍起了无赖。","style":3,"log_type":1,"src_id":220601109,"trial_step":109,"drawing":1120601},{"step":116,"speaker":"莓丝","content":"哎——呀——你带我去能怎么样吗，人家都好久没回去过了想家了怎么了嘛！","style":1,"log_type":1,"src_id":220601110,"trial_step":110,"drawing":1120601},{"step":117,"speaker":"莓丝","content":"你也不想浪费时间在破译加密上吧，难道你有枷锁还怕控制不住我吗？","style":1,"log_type":1,"src_id":220601111,"trial_step":111,"drawing":1120601},{"step":118,"content":"就在这时，通讯器那边的工作人员传来了新的讯息。","style":3,"log_type":1,"src_id":220601112,"trial_step":112,"drawing":1120601},{"step":119,"content":"你们搜查过了？没有找到账本？","style":2,"log_type":1,"src_id":220601113,"trial_step":113,"drawing":1120603},{"step":120,"speaker":"莓丝","content":"好啊，未经允许就闯进少女的房间，这就是你们管理局的做派吗？！","style":1,"log_type":1,"src_id":220601114,"trial_step":114,"drawing":1120603},{"step":121,"content":"你有些无可奈何地看了一眼面前异常吵闹的少女。","style":3,"log_type":1,"src_id":220601115,"trial_step":115,"drawing":1120603},{"step":122,"content":"……嗯，我把莓丝也带过去，她会协助我们找到并破译账本。","style":2,"log_type":1,"src_id":220601116,"trial_step":116,"drawing":1120603},{"step":123,"speaker":"莓丝","content":"好耶！！我要把楼下周边店的新品全扫光！！","style":1,"log_type":1,"src_id":220601117,"trial_step":117,"drawing":1120601},{"step":124,"speaker":"莓丝","content":"呃……用管理局的车带回来应该可以的吧？","style":1,"log_type":1,"src_id":220601118,"trial_step":118,"drawing":1120601},{"step":125,"content":"……","style":2,"log_type":1,"src_id":220601119,"trial_step":119,"drawing":1120601}]}