{"id":404321702,"chapter_id":50088,"scene_id":58861,"steps":[{"step":1,"content":"面对着希露妲的枪口，你反而释然了。","style":3,"background":2506,"log_type":1},{"step":2,"content":"你放下了枪。随即闭上了眼，等待审判的到来。","style":3,"background":2506,"log_type":1},{"step":3,"content":"（进入黑屏）","style":18,"background":10000,"hide_button":true,"log_type":1},{"step":4,"speaker":"希露妲","content":"……告诉我发生了什么。","voice":["vo_event_404321802_01"],"voice_bank":"vo_event_43218","style":1,"background":10000,"log_type":1},{"step":5,"content":"（黑屏消失）","style":18,"background":2506,"log_type":1},{"step":6,"content":"睁开眼睛，你看到希露妲放下了枪。","style":3,"background":2506,"log_type":1},{"step":7,"content":"她的嘴唇紧抿着，一向冷淡的脸上露出决然的神色。","style":3,"background":2506,"log_type":1},{"step":8,"speaker":"希露妲","content":"我相信你不是鼹鼠，但你要告诉我，到底发生了什么。","voice":["vo_event_404321802_05"],"voice_bank":"vo_event_43218","style":1,"background":2506,"log_type":1},{"step":9,"content":"你将刚才发生的事一五一十告诉了希露妲，但隐瞒了海伦娜的信，反正那封信已经被血浸透，完全不能阅读了。","style":3,"background":2506,"log_type":1},{"step":10,"content":"你讲完了一切，希露妲注视着诺兰的尸体。","style":3,"background":2506,"log_type":1},{"step":11,"speaker":"希露妲","content":"能帮我一个忙吗？","voice":["vo_event_404321802_08"],"voice_bank":"vo_event_43218","style":1,"background":2506,"log_type":1},{"step":12,"speaker":"希露妲","content":"帮我一起，把他们的尸体入殓。然后……就回去睡吧。","voice":["vo_event_404321802_09"],"voice_bank":"vo_event_43218","style":1,"background":2506,"log_type":1},{"step":13,"speaker":"希露妲","content":"现下，真的不会有鼹鼠了。","voice":["vo_event_404321802_10"],"voice_bank":"vo_event_43218","style":1,"background":2506,"log_type":1}]}