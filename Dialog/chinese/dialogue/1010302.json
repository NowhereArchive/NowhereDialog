,"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302099,"trial_step":99},{"step":133,"content":"他蠕动着身体，将手伸了过来。","style":3,"background":1023,"log_type":1,"src_id":110302100,"trial_step":100},{"step":134,"speaker":"康拉德","content":"一会儿就好……","voice":["vo_trial_10302_1_53"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302101,"trial_step":101},{"step":135,"content":"男人混沌的眼神看向你却无法聚焦。","style":3,"background":1023,"log_type":1,"src_id":110302102,"trial_step":102},{"step":136,"speaker":"选项","options":["答应康拉德的请求。"],"style":6,"background":1023,"log_type":1,"src_id":110302103,"trial_step":103,"course":3,"choices":[{"text":"答应康拉德的请求。","goto":104}]},{"step":137,"content":"他闭着眼睛，力气却大得出奇，紧紧地箍住你的手，手指不住摩挲着你的掌心，仿佛贪恋着这片刻的安宁和清明。","style":3,"background":1023,"log_type":1,"src_id":110302104,"trial_step":104},{"step":138,"content":"可你几乎立刻意识到有些不对，男人手指的动作过于规律，似乎在向你传递着一则简短的信息——","style":3,"background":1023,"log_type":1,"src_id":110302105,"trial_step":105},{"step":139,"content":"翁斯坦 47 301 翁斯坦 47 301 翁斯坦 47 301……","style":3,"background":1023,"log_type":1,"src_id":110302106,"trial_step":106},{"step":140,"content":"男人一遍又一遍重复着，仿佛生怕你没有领会到他的意图。","style":3,"background":1023,"log_type":1,"src_id":110302107,"trial_step":107},{"step":141,"speaker":"选项","options":["向他传达你已经记住了"],"style":6,"background":1023,"log_type":1,"src_id":110302108,"trial_step":108,"course":3,"choices":[{"text":"向他传达你已经记住了","goto":109}]},{"step":142,"content":"你紧紧握住男人的手。他明白了你的意思。","style":3,"background":1023,"log_type":1,"src_id":110302109,"trial_step":109},{"step":143,"speaker":"康拉德","content":"哈哈……滚吧……你们都滚吧……","voice":["vo_trial_10302_1_54"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302110,"trial_step":110},{"step":144,"content":"男人无比疲惫地闭上眼睛，再无声响。但任谁都看得出来，他还活着，狂厄暂时稳定了下来。","style":3,"background":1023,"log_type":1,"src_id":110302111,"trial_step":111},{"step":145,"content":"你看向罗睺，她的情绪已经被完全隐藏。黑衣的骑士沉默站在你身后，注视着你们两人，再不透露一点真心。只有额前忘记擦去的细密的冷汗记录着她刚刚转瞬即逝的真实。","style":3,"background":1023,"log_type":1,"src_id":110302112,"trial_step":112},{"step":146,"speaker":"%u","content":"他暂时没事了，会有人照顾他的。走吧，我们之间还有话要说。","style":2,"background":1023,"log_type":1,"src_id":110302113,"trial_step":113},{"step":147,"content":"她看着你将康拉德扶上床铺，看你给他盖上被子，看着那个深陷于绝望和痛苦中的男人沉沉睡去，没说一句话。罗睺只是闭眼半晌，随即看向你。","style":3,"background":1023,"log_type":1,"src_id":110302114,"trial_step":114},{"step":148,"speaker":"罗睺","content":"是，长官。","voice":["vo_trial_10302_1_55"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302115,"trial_step":115},{"step":149,"content":"离开阴暗的病房，你和罗睺重新回到了门前。","style":3,"background":107,"log_type":1,"src_id":110302117,"trial_step":117},{"step":150,"content":"你向守卫点头示意，拖着还有些疲惫的身躯穿行于无人的走廊。","style":3,"background":107,"log_type":1,"src_id":110302118,"trial_step":118},{"step":151,"content":"走廊中过于空旷，只有你和罗睺的脚步声。突然，身后传来她冰冷的声音。","style":3,"background":107,"log_type":1,"src_id":110302119,"trial_step":119},{"step":152,"speaker":"罗睺","content":"他给了你什么？","voice":["vo_trial_10302_1_56"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302120,"trial_step":120},{"step":153,"content":"她果然看到康拉德的小动作，想必也一直记得那位战士隐蔽的习惯吧。","style":3,"background":107,"log_type":1,"src_id":110302121,"trial_step":121},{"step":154,"content":"你确认了她与你之间的距离，确认自己大概也许能来得及用枷锁自我保护后，转身，大大方方摊开双手。","style":3,"background":107,"log_type":1,"src_id":110302122,"trial_step":122},{"step":155,"speaker":"选项","options":["你这是在审问我？审问你的“长官”？"],"style":6,"background":107,"log_type":1,"src_id":110302123,"trial_step":123,"course":3,"choices":[{"text":"你这是在审问我？审问你的“长官”？","goto":124}]},{"step":156,"content":"她没有回避你的目光，语气冷硬。","style":3,"background":107,"log_type":1,"src_id":110302124,"trial_step":124},{"step":157,"speaker":"罗睺","content":"不敢。我只是要尽保护“长官”的职责。","voice":["vo_trial_10302_1_57"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302125,"trial_step":125},{"step":158,"speaker":"罗睺","content":"康拉德不知好歹触碰禁忌，沦落到这幅模样，他不是禁闭者，你的枷锁无法压制他身上的污染。对狄斯城来说，他已经是巨大的威胁了。","voice":["vo_trial_10302_1_58"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302126,"trial_step":126},{"step":159,"speaker":"%u","content":"要我驱逐他？还是杀了他？你知道我不会这么做。","style":2,"background":107,"log_type":1,"src_id":110302127,"trial_step":127},{"step":160,"speaker":"罗睺","content":"我知道你不会。他对你有用。","voice":["vo_trial_10302_1_59"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302128,"trial_step":128},{"step":161,"speaker":"罗睺","content":"那就听我的劝告，封锁消息，把他押进你能找到的最严密的拘禁室，派最强的战士看守他，片刻不离。否则，煽动他的势力一定会找上门，波及你。","voice":["vo_trial_10302_1_60"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302129,"trial_step":129},{"step":162,"speaker":"罗睺","content":"这都是……为了你的安全着想。","voice":["vo_trial_10302_1_61"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302130,"trial_step":130},{"step":163,"speaker":"%u","content":"当然，我会这么做的。","style":2,"background":107,"log_type":1,"src_id":110302131,"trial_step":131},{"step":164,"speaker":"选项","options":["既然你这么想借我的手保护他……"],"style":6,"background":107,"log_type":1,"src_id":110302132,"trial_step":132,"course":3,"choices":[{"text":"既然你这么想借我的手保护他……","goto":133}]},{"step":165,"content":"罗睺愣了一下，旋即又冷下脸来，她刚张口要说些什么——","style":3,"background":107,"log_type":1,"src_id":110302133,"trial_step":133},{"step":166,"speaker":"选项","options":["开玩笑的"],"style":6,"background":107,"log_type":1,"src_id":110302134,"trial_step":134,"course":3,"choices":[{"text":"开玩笑的","goto":135}]},{"step":167,"content":"她的话被你堵了回去。你笑眯眯观察她的反应，慢悠悠说着。","style":3,"background":107,"log_type":1,"src_id":110302135,"trial_step":135},{"step":168,"speaker":"%u","content":"我会向FAC申请把他调来管理局的。虽然他不是禁闭者，但刚刚我的力量确实起作用了，多一个观察对象也很好。","style":2,"background":107,"log_type":1,"src_id":110302136,"trial_step":136},{"step":169,"speaker":"%u","content":"而且我确实对他很感兴趣。我很想知道……他那么拼命，一个人撞得头破血流……到底是为了什么。","style":2,"background":107,"log_type":1,"src_id":110302137,"trial_step":137},{"step":170,"content":"你看着罗睺，她也死死地盯着你。自从见过她真正的愤怒，你现在多少能辨识出她的情绪。","style":3,"background":107,"log_type":1,"src_id":110302138,"trial_step":138},{"step":171,"content":"她又在强忍怒意，面罩之下估计已经在咬牙切齿了，忍得还怪努力的。让人禁不住想再戳她两下，说不定还能再爆出几句真心话。","style":3,"background":107,"log_type":1,"src_id":110302139,"trial_step":139},{"step":172,"content":"但下一秒，她合上眼睛，像缓缓呼吸了几次后。再睁开，罗睺已恢复平静。","style":3,"background":107,"log_type":1,"src_id":110302140,"trial_step":140},{"step":173,"speaker":"罗睺","content":"你会错意了。我要保护的只有我的“长官”。","voice":["vo_trial_10302_1_62"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302141,"trial_step":141},{"step":174,"speaker":"罗睺","content":"就按你刚才所说，他已经被狂厄破坏、意识破碎，被你收做枷锁能力的实验对象。这是可以被接受的理由。其它的，不要多嘴。","voice":["vo_trial_10302_1_63"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302142,"trial_step":142},{"step":175,"speaker":"罗睺","content":"不管他给过你什么，不管你对那些疯话有什么兴趣。那都是非常危险的东西。","voice":["vo_trial_10302_1_64"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302143,"trial_step":143},{"step":176,"speaker":"罗睺","content":"危险不在于它多有价值，在于你们想要“越界”的态度。我会亲自处理这些危险品，包括伸手触碰它的所有人。","voice":["vo_trial_10302_1_65"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302144,"trial_step":144},{"step":177,"speaker":"罗睺","content":"接下来是对您的“建议”：不要做能力之外的事，不要窥探不该窥探的东西，不管刚刚他对你说了什么，全部忘掉。否则你会落得跟他同样的下场。","voice":["vo_trial_10302_1_66"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302145,"trial_step":145},{"step":178,"content":"又是威胁的口气。你看着她，慢慢问到。","style":3,"background":107,"log_type":1,"src_id":110302146,"trial_step":146},{"step":179,"speaker":"选项","options":["这是来自你真正“主人”的警告？"],"style":6,"background":107,"log_type":1,"src_id":110302147,"trial_step":147,"course":3,"choices":[{"text":"这是来自你真正“主人”的警告？","goto":148}]},{"step":180,"speaker":"%u","content":"还是说，你要像保护康拉德那样保护我？","style":2,"background":107,"log_type":1,"src_id":110302148,"trial_step":148},{"step":181,"content":"你故技重施，可她没有再像几秒钟之前那样动摇。只是像坚硬的石雕般看着你。","style":3,"background":107,"log_type":1,"src_id":110302149,"trial_step":149},{"step":182,"speaker":"罗睺","content":"都一样。","voice":["vo_trial_10302_1_67"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302150,"trial_step":150},{"step":183,"speaker":"罗睺","content":"你是不该被牵连的人，为了自己的安全着想。不要越界。","voice":["vo_trial_10302_1_68"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302151,"trial_step":151},{"step":184,"content":"门开了，几个守卫前来迎接你们。罗睺再也没有开口，就像一位沉默而忠诚的护卫，紧紧跟随在你身后。","style":3,"background":107,"log_type":1,"src_id":110302152,"trial_step":152},{"step":185,"content":"可你知道，这位“忠诚的护卫”绝不会听从你的命令。而她同样藏着不可说的秘密。","style":3,"background":107,"log_type":1,"src_id":110302153,"trial_step":153}]}