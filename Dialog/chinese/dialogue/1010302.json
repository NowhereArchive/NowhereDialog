{"id":1010302,"chapter_id":1010302,"scene_id":1,"steps":[{"step":1,"speaker":"FAC队员","content":"他曾是位好长官。","voice":["vo_trial_10302_1_1"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302001,"trial_step":1},{"step":2,"content":"负责守卫监禁室的FAC队员点燃了一根烟，青灰色的烟雾在走廊的灯光下上升。","style":3,"background":107,"log_type":1,"src_id":110302002,"trial_step":2},{"step":3,"speaker":"FAC队员","content":"几个月前，他还是风趣温和的朋友、受人尊敬的榜样、被爱戴的队长……","voice":["vo_trial_10302_1_2"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302003,"trial_step":3},{"step":4,"speaker":"FAC队员","content":"现在呢？","voice":["vo_trial_10302_1_3"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302004,"trial_step":4},{"step":5,"content":"透过观察窗，他看了一眼里面的人，又匆匆移开了目光。","style":3,"background":107,"log_type":1,"src_id":110302005,"trial_step":5},{"step":6,"speaker":"FAC队员","content":"只是几个月的时间，被狂厄搞坏了脑子，满嘴胡话,呵呵……","voice":["vo_trial_10302_1_4"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302006,"trial_step":6},{"step":7,"speaker":"FAC队员","content":"……可怜的疯子。","voice":["vo_trial_10302_1_5"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302007,"trial_step":7},{"step":8,"content":"仿佛是在发泄某种情绪，FAC队员狠狠掐灭烟头，掷在地上。","style":3,"background":107,"log_type":1,"src_id":110302008,"trial_step":8},{"step":9,"speaker":"FAC队员","content":"算了，我们都知道自己迟早会变成那样，又矫情个什么劲……","voice":["vo_trial_10302_1_6"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302009,"trial_step":9},{"step":10,"content":"提示音响起，一则临时秘钥被发送到了你的个人终端上。","style":3,"background":107,"log_type":1,"src_id":110302010,"trial_step":10},{"step":11,"speaker":"选项","options":["出示临时秘钥"],"style":6,"background":107,"log_type":1,"src_id":110302011,"trial_step":11,"course":3,"choices":[{"text":"出示临时秘钥","goto":12}]},{"step":12,"content":"眼前的男人让开身位，你将秘钥对准了门前的电子锁。","style":3,"background":107,"log_type":1,"src_id":110302012,"trial_step":12},{"step":13,"speaker":"FAC队员","content":"……帮我个忙。","voice":["vo_trial_10302_1_7"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302013,"trial_step":13},{"step":14,"speaker":"%u","content":"？","style":2,"background":107,"log_type":1,"src_id":110302014,"trial_step":14},{"step":15,"speaker":"FAC队员","content":"我知道你是反狂厄的专家，也知道你救过不少人……即便是所有人都觉得没救的禁闭者……","voice":["vo_trial_10302_1_8"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302015,"trial_step":15},{"step":16,"speaker":"FAC队员","content":"哪怕只有一丝可能……请救救他。","voice":["vo_trial_10302_1_9"],"voice_bank":"vo_rahu_trial","style":1,"background":107,"log_type":1,"src_id":110302016,"trial_step":16},{"step":17,"content":"监禁室内没有开灯，你只看到黑暗中模糊的人影。","style":3,"background":1023,"log_type":1,"src_id":110302018,"trial_step":18},{"step":18,"speaker":"选项","options":["开灯","走向人影"],"style":6,"background":1023,"log_type":1,"src_id":110302019,"trial_step":19,"course":3,"choices":[{"text":"开灯","goto":20},{"text":"走向人影","goto":22}]},{"step":19,"content":"你正打算打开电灯的开关，罗睺阻止了你。","style":3,"background":1023,"log_type":1,"src_id":110302020,"trial_step":20},{"step":20,"content":"她没有说话，只是摇了摇头。你明白了她的意思。","style":3,"background":1023,"log_type":1,"src_id":110302021,"trial_step":21,"next":[23]},{"step":21,"content":"对于一个习惯了黑暗、饱经折磨的人而言，突然开灯只会刺激到他脆弱的精神。","style":3,"background":1023,"log_type":1,"src_id":110302022,"trial_step":22},{"step":22,"content":"你慢慢走过去。借着走廊里昏暗的光线，你看清了眼前的男人。","style":3,"background":1023,"log_type":1,"src_id":110302023,"trial_step":23},{"step":23,"speaker":"康拉德","content":"……","voice":["vo_trial_10302_1_10"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302024,"trial_step":24},{"step":24,"content":"粘稠而沉重的喘息、伴随着呼吸起伏的布料摩擦、监视仪器的嗡鸣共同组成了诡异又压迫的底噪。","style":3,"background":1023,"log_type":1,"src_id":110302025,"trial_step":25},{"step":25,"content":"在那之中，是一张过于惨白和消瘦的脸。他双眼紧闭，眼球却不住转动，表情也异常狰狞，仿佛在经历某种可怕的梦境。","style":3,"background":1023,"log_type":1,"src_id":110302026,"trial_step":26},{"step":26,"content":"似乎是察觉到了你们的动静，他猛地睁开双眼。","style":3,"background":1023,"log_type":1,"src_id":110302027,"trial_step":27},{"step":27,"speaker":"康拉德","content":"……谁？！","voice":["vo_trial_10302_1_11"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302028,"trial_step":28},{"step":28,"content":"男人漆黑空洞的瞳仁仿佛填满了怨愤和仇恨的深渊。他的身体猛地前倾，束缚衣被骤然绷紧，高强度化纤与布料摩擦发出令人牙酸的异响。","style":3,"background":1023,"log_type":1,"src_id":110302029,"trial_step":29},{"step":29,"content":"很难想象这样一个形销骨立的男人能爆发出如此可怕的力量。他就像一头发狂的野兽。你毫不怀疑，若不是受到束缚，他会在睁开眼睛的第一瞬间扑上来，咬断你的脖子。","style":3,"background":1023,"log_type":1,"src_id":110302030,"trial_step":30},{"step":30,"speaker":"%u","content":"你好，康拉德·凯奇先生……","style":2,"background":1023,"log_type":1,"src_id":110302031,"trial_step":31},{"step":31,"speaker":"康拉德","content":"罗睺？！","voice":["vo_trial_10302_1_12"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302032,"trial_step":32},{"step":32,"content":"男人无视了你，直勾勾地盯着你身旁随行的人，用几乎要将牙齿咬碎的声线念出了那个名字。","style":3,"background":1023,"log_type":1,"src_id":110302033,"trial_step":33},{"step":33,"speaker":"康拉德","content":"呵呵……呵呵呵呵呵，你还舍得回来？","voice":["vo_trial_10302_1_13"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302034,"trial_step":34},{"step":34,"speaker":"罗睺","content":"来给你收尸。","voice":["vo_trial_10302_1_14"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302035,"trial_step":35},{"step":35,"speaker":"康拉德","content":"呵呵呵……你还记得这事……","voice":["vo_trial_10302_1_15"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302036,"trial_step":36},{"step":36,"speaker":"康拉德","content":"这个人呢？","voice":["vo_trial_10302_1_16"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302037,"trial_step":37},{"step":37,"content":"男人的目光瞥向你，那里面是毫不掩饰的敌意与防备。","style":3,"background":1023,"log_type":1,"src_id":110302038,"trial_step":38},{"step":38,"speaker":"%u","content":"我是${PlayerName}，米诺斯危机管理局的局长。","style":2,"background":1023,"log_type":1,"src_id":110302039,"trial_step":39},{"step":39,"speaker":"%u","content":"罗睺刚刚经调任至MBCC供职，我姑且算是她的直属上级。","style":2,"background":1023,"log_type":1,"src_id":110302040,"trial_step":40},{"step":40,"speaker":"康拉德","content":"上级？又换了一个？呵呵呵……","voice":["vo_trial_10302_1_17"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302041,"trial_step":41},{"step":41,"speaker":"康拉德","content":"小心点，${PlayerName}，她是条会咬人的狗。","voice":["vo_trial_10302_1_18"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302042,"trial_step":42},{"step":42,"speaker":"罗睺","content":"……他们说你的脑子被狂厄搞坏了，看来的确如此。","voice":["vo_trial_10302_1_19"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302043,"trial_step":43},{"step":43,"speaker":"康拉德","content":"是啊，毕竟都过去这么久了，发生点什么都不意外。","voice":["vo_trial_10302_1_20"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302044,"trial_step":44},{"step":44,"speaker":"罗睺","content":"只过了几个月而已。","voice":["vo_trial_10302_1_21"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302045,"trial_step":45},{"step":45,"speaker":"康拉德","content":"几个月已经很久了，足够让我变成这副鬼样子，也足够让你背叛我们，去给上庭当狗……","voice":["vo_trial_10302_1_22"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302046,"trial_step":46},{"step":46,"speaker":"罗睺","content":"发生什么了？","voice":["vo_trial_10302_1_23"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302047,"trial_step":47},{"step":47,"content":"罗睺并没有回应男人的指控，只是追问男人的经历。","style":3,"background":1023,"log_type":1,"src_id":110302048,"trial_step":48},{"step":48,"speaker":"康拉德","content":"发生了什么？哈哈哈哈……","voice":["vo_trial_10302_1_24"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302049,"trial_step":49},{"step":49,"speaker":"康拉德","content":"和103年一样，都死了，死在我眼前，死得不明不白。只有我走了大运，被人像捡垃圾一样救回来……","voice":["vo_trial_10302_1_25"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302050,"trial_step":50},{"step":50,"speaker":"康拉德","content":"我开始理解你当初的感受了，罗睺。亏我那时候觉得你脑子出了问题，原来只不过是我还没有看见真相。","voice":["vo_trial_10302_1_26"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302051,"trial_step":51},{"step":51,"speaker":"康拉德","content":"必须有人为此付出代价……上庭……他们会付出代价的……","voice":["vo_trial_10302_1_27"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302052,"trial_step":52},{"step":52,"content":"男人的声音满是阴狠与怨毒，黑色的血管浮现在他的脸上。","style":3,"background":1023,"log_type":1,"src_id":110302053,"trial_step":53},{"step":53,"options":["向康拉德询问情报"],"style":6,"background":1023,"log_type":1,"src_id":110302054,"trial_step":54,"course":3,"choices":[{"text":"向康拉德询问情报","goto":55}]},{"step":54,"speaker":"%u","content":"你所谓的“真相”究竟是什么？","style":2,"background":1023,"log_type":1,"src_id":110302055,"trial_step":55},{"step":55,"speaker":"康拉德","content":"呵呵。","voice":["vo_trial_10302_1_28"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302056,"trial_step":56},{"step":56,"content":"男人冷笑了一声。","style":3,"background":1023,"log_type":1,"src_id":110302057,"trial_step":57},{"step":57,"speaker":"康拉德","content":"我凭什么告诉你？","voice":["vo_trial_10302_1_29"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302058,"trial_step":58},{"step":58,"speaker":"%u","content":"任何人，即便是上庭，也需要为其罪行负责，这是我坚信的准则。","style":2,"background":1023,"log_type":1,"src_id":110302059,"trial_step":59},{"step":59,"speaker":"%u","content":"前提是，必须有能够证明这一切的证据……","style":2,"background":1023,"log_type":1,"src_id":110302060,"trial_step":60},{"step":60,"content":"男人眯起眼睛看了看你，接着，他的目光移向你身边的罗睺。片刻之后，他开口说道：","style":3,"background":1023,"log_type":1,"src_id":110302061,"trial_step":61},{"step":61,"speaker":"康拉德","content":"证据，我当然有……害死瓦尔纳……让我们毫无意义去送死的……上庭的罪证……这10年来，西区、里湾、内海，他们插手做的一切……","voice":["vo_trial_10302_1_30"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302062,"trial_step":62},{"step":62,"speaker":"康拉德","content":"问题是，我有什么理由相信，你不是他们派来的？","voice":["vo_trial_10302_1_31"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302063,"trial_step":63},{"step":63,"speaker":"康拉德","content":"上庭……最不缺的就是狗。","voice":["vo_trial_10302_1_32"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302064,"trial_step":64},{"step":64,"content":"在说出这些回答时，男人的目光始终死死盯着罗睺，似乎是期待她做出某种反应。","style":3,"background":1023,"log_type":1,"src_id":110302065,"trial_step":65},{"step":65,"speaker":"罗睺","content":"证据在哪儿？","voice":["vo_trial_10302_1_33"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302066,"trial_step":66},{"step":66,"content":"罗睺的声音冰冷，眼神紧紧锁在康拉德身上。在你还想说什么前，你感受到了一股骇人的杀气——那是在警告你闭嘴退下的信号。","style":3,"background":1023,"log_type":1,"src_id":110302067,"trial_step":67},{"step":67,"speaker":"罗睺","content":"那都是虚假的情报，是地底用来迷惑人心的谎言。你被利用了，把它交给我，我来处理。","voice":["vo_trial_10302_1_34"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302068,"trial_step":68},{"step":68,"speaker":"罗睺","content":"FAC终日服从纪律，投身战场。你们是最正直最坦荡的，也是离真正的邪恶最遥远的人，你没有时间寻找真相辨别真伪。","voice":["vo_trial_10302_1_35"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302069,"trial_step":69},{"step":69,"speaker":"罗睺","content":"不管是谁给你的“证据”，那都是假的。他们只是在利用你与上庭为敌。","voice":["vo_trial_10302_1_36"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302070,"trial_step":70},{"step":70,"speaker":"罗睺","content":"把它交出来。","voice":["vo_trial_10302_1_37"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302071,"trial_step":71},{"step":71,"speaker":"康拉德","content":"……这就是你要对我说的？都到这一步了，你对我说的就是这个？？","voice":["vo_trial_10302_1_38"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302072,"trial_step":72},{"step":72,"speaker":"康拉德","content":"去你的地底！去你的假情报！还“谁给我的证据”……这是你留下的证据！！！","voice":["vo_trial_10302_1_39"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302073,"trial_step":73},{"step":73,"speaker":"康拉德","content":"这都是你亲手搜集的证据！！是你自己的意志！罗睺本人真正的意志！你为了这真相一个人撞得头破血流，现在回来却跟我说这种话？！","voice":["vo_trial_10302_1_40"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302074,"trial_step":74},{"step":74,"speaker":"康拉德","content":"你不是罗睺，你这混蛋究竟是谁？！！","voice":["vo_trial_10302_1_41"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302075,"trial_step":75},{"step":75,"content":"男人癫狂地嚎叫着，竟挣脱拘束向你们扑来，带着几近凄惨的哀嚎，污染扑面而来。","style":3,"background":1023,"log_type":1,"src_id":110302076,"trial_step":76},{"step":76,"content":"罗睺一把推开你，抓住康拉德挣扎扑来的手将他压倒在地，用异方晶狠狠钉在他掌心，近乎残酷地制服了这个悲痛发狂的男人。一套动作下来干净利落毫不迟疑。","style":3,"background":1023,"log_type":1,"src_id":110302077,"trial_step":77},{"step":77,"content":"可你的枷锁却在隐隐震动。","style":3,"background":1023,"log_type":1,"src_id":110302078,"trial_step":78},{"step":78,"speaker":"罗睺","content":"我是罗睺。是清醒的人。","voice":["vo_trial_10302_1_42"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302079,"trial_step":79},{"step":79,"speaker":"罗睺","content":"你只是被过去的幻影纠缠，自我欺骗罢了。离真正的真相太远，只会死在跑向它的路上。","voice":["vo_trial_10302_1_43"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302080,"trial_step":80},{"step":80,"speaker":"罗睺","content":"向前看，康拉德，就像你以前跟我说的一样……向前看！你不是一直活得很明白吗？！","voice":["vo_trial_10302_1_44"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302081,"trial_step":81},{"step":81,"speaker":"康拉德","content":"……向前看？","voice":["vo_trial_10302_1_45"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302082,"trial_step":82},{"step":82,"speaker":"康拉德","content":"因为你变成疯狗替所有人泄愤，我才能从仇恨里解脱出来。因为你替我发疯，我才能“活得明白”！","voice":["vo_trial_10302_1_46"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302083,"trial_step":83},{"step":83,"speaker":"康拉德","content":"现在连你都变成这副样子，还怎么让我向前看？！","voice":["vo_trial_10302_1_47"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302084,"trial_step":84},{"step":84,"content":"男人猛地抬起头，狂厄侵蚀了他所有理智，也让最真切的感情肆无忌惮地宣泄着，他漆黑的瞳仁里满是绝望与怨毒。","style":3,"background":1023,"log_type":1,"src_id":110302085,"trial_step":85},{"step":85,"speaker":"康拉德","content":"我不该让你去的，那个山庄，我就不该让你一个人去的……那里都发生了什么？","voice":["vo_trial_10302_1_48"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302086,"trial_step":86},{"step":86,"speaker":"康拉德","content":"是上庭吗？还是那些刺客……她们都对你做了什么？为什么会变成这样……？","voice":["vo_trial_10302_1_49"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302087,"trial_step":87},{"step":87,"speaker":"康拉德","content":"罗睺在哪里……我最后的战友去哪儿了……","voice":["vo_trial_10302_1_50"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302088,"trial_step":88},{"step":88,"speaker":"康拉德","content":"<color=#fb9259><size=45>是你杀了她吗？！！！</size></color>","voice":["vo_trial_10302_1_51"],"voice_bank":"vo_rahu_trial","style":1,"background":1023,"log_type":1,"src_id":110302089,"trial_step":89},{"step":89,"content":"男人歇斯底里地嚎叫着，脸上的血管不住蠕动，苍白的皮肤上出现了暗沉的瘢痕——剧烈的情绪波动令他出现了严重的狂厄化倾向。","style":3,"background":1023,"log_type":1,"src_id":110302090,"trial_step":90},{"step":90,"content":"罗睺的异方晶几乎要按进他体内，却被越来越快地消耗着，污染不断溢出，开始侵蚀罗睺的身体，她的脸上浮现出猩红的狂厄痕迹。","style":3,"background":1023,"log_type":1,"src_id":110302091,"trial_step":91},{"step":91,"content":"可她没有放手，罗睺死死压制着康拉德，紧盯着他的眼睛，从她的双眼中你看到了极尽强烈的情绪。枷锁剧烈震颤着，说不清是来自康拉德的狂厄暴走、还是另一个人过于激昂的感情——但现在不是分辨这些的时候。","style":3,"background":1023,"log_type":1,"src_id":110302092,"trial_step":92},{"step":92,"content":"你必须采取行动。","style":3,"background":1023,"log_type":1,"src_id":110302093,"trial_step":93},{"step":93,"options":["使用枷锁"],"style":6,"background":1023,"log_type":1,"src_id":110302094,"trial_step":94,"course":3,"choices":[{"text":"使用枷锁","goto":95}]},{"step":94,"speaker":"%u","content":"罗睺，让开！","style":2,"background":1023,"log_type":1,"src_id":110302095,"trial_step":95},{"step":95,"content":"你对她下了“禁止令”。这瞬间她眼中燃起激烈的愤怒，几乎要扑过来咬断你的脖子也想把那个男人护在身后。这么久以来你第一次看到她的心，你记住了。","style":3,"background":1023,"log_type":1,"src_id":110302095,"trial_step":95},{"step":96,"content":"然后你竭力压制住这个暴怒的禁闭者，几乎要用尽枷锁的力量才能逼迫她按你心愿挪开步伐。她必须远离污染，而你也有必须要做的事——","style":3,"background":1023,"log_type":1,"src_id":110302095,"trial_step":95},{"step":97,"speaker":"%u","content":"康拉德！振作点！","style":2,"background":1023,"log_type":1,"src_id":110302095,"trial_step":95},{"step":98,"content":"康拉德的狂厄近乎暴走，你竭尽全力用枷锁压制。医疗部门曾经告诉过你：为濒临死役化的人代偿是极其危险的举动，但，这个男人不能死。","style":3,"background":1023,"log_type":1,"src_id":110302095,"trial_step":95},{"step":99,"content":"无论是一个正直的生命、一段被摧毁的真相、还是对你身后那个几乎要被绷断的禁闭者来说——康拉德都不能死。你非常清楚这一点。","style":3,"background":1023,"log_type":1,"src_id":110302095,"trial_step":95},{"step":100,"speaker":"%u","content":"罗睺，让开！","style":2,"background":1023,"log_type":1,"src_id":110302095,"trial_step":95},{"step":101,"content":"你对她下了“禁止令”。这瞬间她眼中燃起激烈的愤怒，几乎要扑过来咬断你的脖子也想把那个男人护在身后。这么久以来你第一次看到她的心，你记住了。","style":3,"background":1023,"log_type":1,"src_id":110302095,"trial_step":95},{"step":102,"content":"然后你竭力压制住这个暴怒的禁闭者，几乎要用尽枷锁的力量才能逼迫她按你心愿挪开步伐。她必须远离污染，而你也有必须要做的事——","style":3,"background":1023,"log_type":1,"src_id":110302095,"trial_step":95},{"step":103,"speaker":"%u","content":"康拉德！振作点！","style":2,"background":1023,"log_type":1,"src_id":110302095,"trial_step":95},{"step":104,"content":"康拉德的狂厄近乎暴走，你竭尽全力用枷锁压制。医疗部门曾经告诉过你：为濒临死役化的人代偿是极其危险的举动，但，这个男人不能死。","style":3,"background":1023,"log_type":1,"src_id":110302095,"trial_step":95},{"step":105,"content":"无论是一个正直的生命、一段被摧毁的真相、还是对你身后那个几乎要被绷断的禁闭者来说——康拉德都不能死。你非常清楚这一点。","style":3,"background":1023,"log_type":1,"src_id":1103020