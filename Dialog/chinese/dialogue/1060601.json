{"id":1060601,"chapter_id":1060601,"scene_id":1,"steps":[{"step":1,"speaker":"议员","content":"早听说在这次金乌使徒的镇压行动中，局长和东洲使团合作，亲密无间。","voice":["vo_trial_60601_1_1"],"voice_bank":"vo_duruo_trial","style":1,"background":1040,"log_type":1,"src_id":160601001,"trial_step":1},{"step":2,"speaker":"议员","content":"想必这次对您来说，应该不成问题。","voice":["vo_trial_60601_1_2"],"voice_bank":"vo_duruo_trial","style":1,"background":1040,"log_type":1,"src_id":160601002,"trial_step":2},{"step":3,"content":"一大早，议员就造访了管理局办公室，将一叠资料放在了你的桌上。","style":3,"background":1040,"log_type":1,"src_id":160601003,"trial_step":3},{"step":4,"speaker":"局长","content":"使徒之战已经结束一周，一切恢复正常，使团也已经返回东洲。","style":2,"background":1040,"log_type":1,"src_id":160601004,"trial_step":4},{"step":5,"speaker":"局长","content":"现在旧事重提是有什么担忧？","style":2,"background":1040,"log_type":1,"src_id":160601005,"trial_step":5},{"step":6,"speaker":"议员","content":"使团是回去了没错，可难道您不知道吗？","voice":["vo_trial_60601_1_6"],"voice_bank":"vo_duruo_trial","style":1,"background":1040,"log_type":1,"src_id":160601006,"trial_step":6},{"step":7,"speaker":"议员","content":"使团中的某人，又回来了。","voice":["vo_trial_60601_1_7"],"voice_bank":"vo_duruo_trial","style":1,"background":1040,"log_type":1,"src_id":160601007,"trial_step":7},{"step":8,"content":"议员说着打开了面前的资料夹，文件扉页上赫然写着——<color=#fb9259>杜若入境申请</color>。","style":3,"background":1040,"log_type":1,"src_id":160601008,"trial_step":8},{"step":9,"options":["杜若回狄斯了？","我不知道，什么时候的事？"],"style":6,"background":1040,"log_type":1,"src_id":160601009,"trial_step":9,"course":3,"choices":[{"text":"杜若回狄斯了？","goto":10},{"text":"我不知道，什么时候的事？","goto":10}]},{"step":10,"speaker":"议员","content":"您最好不是在装傻。外邦在深入参与狄斯军事行动后又派使者以“访学”名义重游狄斯……这其中的关系要害，应该不需要我赘述了吧。","voice":["vo_trial_60601_1_10"],"voice_bank":"vo_duruo_trial","style":1,"background":1040,"log_type":1,"src_id":160601010,"trial_step":10},{"step":11,"speaker":"局长","content":"……你们怀疑她另有目的？","style":2,"background":1040,"log_type":1,"src_id":160601011,"trial_step":11},{"step":12,"speaker":"议员","content":"至少我们不能排除她有刺探情报的意图。城邦间的嫌隙没有那么容易弥合，但使徒一战后表面的太平也不能太快戳破。所以只好辛苦局长了。","voice":["vo_trial_60601_1_12"],"voice_bank":"vo_duruo_trial","style":1,"background":1040,"log_type":1,"src_id":160601012,"trial_step":12},{"step":13,"options":["为什么是我？"],"style":6,"background":1040,"log_type":1,"src_id":160601013,"trial_step":13,"course":3,"choices":[{"text":"为什么是我？","goto":14}]},{"step":14,"speaker":"议员","content":"这是杜若大使自己要求的。她愿意接受MBCC的调查，如果你对她的审查不通过，她也同意被驱逐出境。","voice":["vo_trial_60601_1_14"],"voice_bank":"vo_duruo_trial","style":1,"background":1040,"log_type":1,"src_id":160601014,"trial_step":14},{"step":15,"content":"议员留下了这份文件，并交代了“护送”大使前来管理局进行“入境调查”的时间。","style":3,"background":1040,"log_type":1,"src_id":160601015,"trial_step":15},{"step":16,"content":"离开前，议员拍拍你的肩膀。","style":3,"background":1040,"log_type":1,"src_id":160601016,"trial_step":16},{"step":17,"speaker":"议员","content":"你有权通过她的申请，但你应该清楚狄斯想要的结果到底是什么。","voice":["vo_trial_60601_1_17"],"voice_bank":"vo_duruo_trial","style":1,"background":1040,"log_type":1,"src_id":160601017,"trial_step":17},{"step":18,"speaker":"议员","content":"体面地将她送回东洲吧，这是狄斯城对你的信任。","voice":["vo_trial_60601_1_18"],"voice_bank":"vo_duruo_trial","style":1,"background":1040,"log_type":1,"src_id":160601018,"trial_step":18},{"step":19,"content":"审查室维持着适宜的温度，重返狄斯的学者已经被安排入内等候。没有人为她带上手铐，那些用来提防禁闭者的M值检测仪器也已经被关闭。","style":3,"log_type":1,"src_id":160601020,"trial_step":20,"drawing":1060600},{"step":20,"content":"在表面工作上，狄斯城对这位外邦要员给足了优待。","style":3,"log_type":1,"src_id":160601021,"trial_step":21,"drawing":1060600},{"step":21,"content":"察觉到有人入内，杜若抬眼，与你四目相对。","style":3,"log_type":1,"src_id":160601024,"trial_step":24,"drawing":1060601},{"step":22,"speaker":"杜若","content":"都说别时容易见时难，想不到我们那么快就见面了。","voice":["vo_trial_60601_1_25"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601025,"trial_step":25,"drawing":1060600},{"step":23,"speaker":"杜若","content":"别来无恙，局长，金乌对枷锁的反噬恢复得如何了？","voice":["vo_trial_60601_1_26"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601026,"trial_step":26,"drawing":1060600},{"step":24,"content":"她面色如常，好像只是最平常的寒暄。","style":3,"log_type":1,"src_id":160601027,"trial_step":27,"drawing":1060600},{"step":25,"options":["恢复得很好"],"style":6,"log_type":1,"src_id":160601028,"trial_step":28,"course":3,"drawing":1060600,"choices":[{"text":"恢复得很好","goto":29}]},{"step":26,"speaker":"局长","content":"枷锁和身体一切正常，辛苦你“远道而来”关心我的健康。","style":2,"log_type":1,"src_id":160601029,"trial_step":29,"drawing":1060600},{"step":27,"content":"你故意加重咬字想要试探她的态度。","style":3,"log_type":1,"src_id":160601030,"trial_step":30,"drawing":1060600},{"step":28,"speaker":"杜若","content":"是吗，没事就好。","voice":["vo_trial_60601_1_31"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601031,"trial_step":31,"drawing":1060600},{"step":29,"content":"她没有如你预期般引出新的话题，只是欣慰地淡淡点头。审查室里再次陷入尴尬的沉寂。","style":3,"log_type":1,"src_id":160601032,"trial_step":32,"drawing":1060600},{"step":30,"content":"杜若并没有为这微妙的沉默感到不自在，目光在你的脸上停留片刻后，不徐不疾地落到你手中的入境申请上。她表情一哂。","style":3,"log_type":1,"src_id":160601033,"trial_step":33,"drawing":1060600},{"step":31,"speaker":"杜若","content":"你手上的，是小别重逢的礼物吗？","voice":["vo_trial_60601_1_34"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601034,"trial_step":34,"drawing":1060600},{"step":32,"speaker":"局长","content":"我以为你比我更清楚这是什么？","style":2,"log_type":1,"src_id":160601035,"trial_step":35,"drawing":1060600},{"step":33,"speaker":"杜若","content":"居然又把问题抛回给我了。只是一周不见，我们局长可真是狡猾多了。看来以后得编些高级的故事来骗你了。","voice":["vo_trial_60601_1_36"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601036,"trial_step":36,"drawing":1060600},{"step":34,"options":["那“访学”也是谎言吗？"],"style":6,"log_type":1,"src_id":160601037,"trial_step":37,"course":3,"drawing":1060600,"choices":[{"text":"那“访学”也是谎言吗？","goto":38}]},{"step":35,"speaker":"局长","content":"危机已经解除了，为什么还要回到狄斯？为什么回来之前没有和我联系？","style":2,"log_type":1,"src_id":160601038,"trial_step":38,"drawing":1060600},{"step":36,"speaker":"局长","content":"从使团第一次踏足狄斯开始你们就在第九机关的高度提防名单里，你明明一开始知道，却还要一个人冒险。","style":2,"log_type":1,"src_id":160601039,"trial_step":39,"drawing":1060600},{"step":37,"speaker":"局长","content":"指名我对你进行入境审查又是什么目的？","style":2,"log_type":1,"src_id":160601040,"trial_step":40,"drawing":1060600},{"step":38,"speaker":"杜若","content":"……","style":1,"log_type":1,"src_id":160601041,"trial_step":41,"drawing":1060600},{"step":39,"content":"她并不作答，身体微微前倾，仔仔细细地观察你。","style":3,"log_type":1,"src_id":160601042,"trial_step":42,"drawing":1060600},{"step":40,"speaker":"杜若","content":"局长，你在着急？还是在生气？","voice":["vo_trial_60601_1_43"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601043,"trial_step":43,"drawing":1060600},{"step":41,"speaker":"杜若","content":"金乌使徒当前，你也从来没有表露过这样的情绪，现在是为了什么？","voice":["vo_trial_60601_1_44"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601044,"trial_step":44,"drawing":1060600},{"step":42,"content":"她又凑近了一些。","style":3,"log_type":1,"src_id":160601045,"trial_step":45,"drawing":1060600},{"step":43,"speaker":"杜若","content":"是在责怪我回来之前没有告诉你，还是说你在……担心我？","voice":["vo_trial_60601_1_46"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601046,"trial_step":46,"drawing":1060600},{"step":44,"options":["我在担心你的处境","我在为你的隐瞒生气","你想多了，我是秉公办事"],"style":6,"log_type":1,"src_id":160601047,"trial_step":47,"course":3,"drawing":1060600,"choices":[{"text":"我在担心你的处境","goto":48},{"text":"我在为你的隐瞒生气","goto":null},{"text":"你想多了，我是秉公办事","goto":null}]},{"step":45,"speaker":"局长","content":"你应该清楚，狄斯不会允许再让你入境。","style":2,"log_type":1,"src_id":160601048,"trial_step":48,"drawing":1060600},{"step":46,"speaker":"杜若","content":"所以我征询的不是狄斯的意见。我指名自愿接受的，是MBCC局长${PlayerName}的调查。","voice":["vo_trial_60601_1_49"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601049,"trial_step":49,"drawing":1060600},{"step":47,"speaker":"杜若","content":"难道……你不希望我回来吗？","voice":["vo_trial_60601_1_50"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601050,"trial_step":50,"drawing":1060601},{"step":48,"content":"她似乎很期待你的回答，但你实在无法从她的话语中辨别是调侃还是真心，只能将话题重新引回入境申请。","style":3,"log_type":1,"src_id":160601051,"trial_step":51,"drawing":1060601},{"step":49,"speaker":"局长","content":"这无关我的个人意愿，就凭你这份漏洞百出的申请，无论是谁接手都很难通过吧。","style":2,"log_type":1,"src_id":160601052,"trial_step":52,"drawing":1060600},{"step":50,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":53,"course":6,"drawing":1060600},{"step":51,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":53,"course":6,"drawing":1060600},{"step":52,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":53,"course":6,"drawing":1060600},{"step":53,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":53,"course":6,"drawing":1060600},{"step":54,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":53,"course":6,"drawing":1060600},{"step":55,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":53,"course":6,"drawing":1060600},{"step":56,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":53,"course":6,"drawing":1060600},{"step":57,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":53,"course":6,"drawing":1060600},{"step":58,"content":"鄙人将狄斯成功消灭金乌的神话带回了故乡，取得了很好的反响，东洲对贵邦文明产生了积极的兴趣。\n\n正逢鄙人对故乡神话的研究已获得阶段性成果，作为神话学者，希望能够借此机会拓宽选题，来到贵邦访学了解狄斯的神话。","style":14,"log_type":1,"src_id":160601054,"trial_step":54,"drawing":1060600},{"step":59,"speaker":"杜若","content":"呀，多么娟秀的字迹，不卑不亢的行文，有什么问题？","voice":["vo_trial_60601_1_55"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601055,"trial_step":55,"drawing":1060600},{"step":60,"speaker":"局长","content":"当然有问题……","style":2,"log_type":1,"src_id":160601056,"trial_step":56,"drawing":1060600},{"step":61,"options":["关于路程"],"style":6,"log_type":1,"src_id":160601057,"trial_step":57,"course":3,"drawing":1060600,"choices":[{"text":"关于路程","goto":58}]},{"step":62,"speaker":"局长","content":"距离使节团离开狄斯城才几天，即便是最快的速度，也不足以让你带着消灭金乌的神话穿越砂海，回到东洲，再折返回狄斯。","style":2,"log_type":1,"src_id":160601058,"trial_step":58,"drawing":1060600},{"step":63,"options":["关于神话"],"style":6,"log_type":1,"src_id":160601059,"trial_step":59,"course":3,"drawing":1060600,"choices":[{"text":"关于神话","goto":60}]},{"step":64,"speaker":"局长","content":"共同作战那么久我早就看出来了，你是整个使团中最不信任所谓神话的人，甚至一次次用行动颠覆和打破过去的传说。","style":2,"log_type":1,"src_id":160601060,"trial_step":60,"drawing":1060600},{"step":65,"speaker":"局长","content":"你想要收集的绝不只是狄斯神话而已。","style":2,"log_type":1,"src_id":160601061,"trial_step":61,"drawing":1060600},{"step":66,"options":["关于狄斯"],"style":6,"log_type":1,"src_id":160601062,"trial_step":62,"course":3,"drawing":1060600,"choices":[{"text":"关于狄斯","goto":63}]},{"step":67,"speaker":"局长","content":"狄斯城入夜后才刚刚建立，作为新兴的移民城邦和你们东洲不同，这里没有悠久的历史文化。","style":2,"log_type":1,"src_id":160601063,"trial_step":63,"drawing":1060600},{"step":68,"speaker":"局长","content":"你在这里能够“访学”的，只有没落的矿区工厂、新型的城市科技以及……","style":2,"log_type":1,"src_id":160601064,"trial_step":64,"drawing":1060600},{"step":69,"speaker":"局长","content":"黑环、狂厄、异方晶。","style":2,"log_type":1,"src_id":160601065,"trial_step":65,"drawing":1060601},{"step":70,"content":"这是狄斯最核心的机要，也是你最不愿意做出的推论。说出这些名词后，审查室的气氛一度降到冰点。","style":3,"log_type":1,"src_id":160601066,"trial_step":66,"drawing":1060601},{"step":71,"content":"听着你一条条反驳她的申请，直到你说出关于间谍窃取机密的怀疑，她终于睁开了眼睛。","style":3,"log_type":1,"src_id":160601067,"trial_step":67,"drawing":1060601},{"step":72,"speaker":"杜若","content":"我记得局长挺喜欢听我讲故事的。想久违地再听我聊聊吗？","voice":["vo_trial_60601_1_68"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601068,"trial_step":68,"drawing":1060601},{"step":73,"speaker":"局长","content":"你还没有回应我的问题。","style":2,"log_type":1,"src_id":160601069,"trial_step":69,"drawing":1060601},{"step":74,"speaker":"杜若","content":"故事里就有答案。","voice":["vo_trial_60601_1_70"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601070,"trial_step":70,"drawing":1060601},{"step":75,"speaker":"局长","content":"神话故事？","style":2,"log_type":1,"src_id":160601071,"trial_step":71,"drawing":1060601},{"step":76,"speaker":"杜若","content":"真实故事。","voice":["vo_trial_60601_1_72"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601072,"trial_step":72,"drawing":1060600},{"step":77,"content":"她拿出一鼎香炉，东洲制式。","style":3,"log_type":1,"src_id":160601073,"trial_step":73,"drawing":1060600},{"step":78,"speaker":"杜若","content":"故事会有些长，介意我点上熏香吗？这有助于我清理思路。","voice":["vo_trial_60601_1_74"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601074,"trial_step":74,"drawing":1060600},{"step":79,"options":["同意","拒绝"],"style":6,"log_type":1,"src_id":160601075,"trial_step":75,"course":3,"drawing":1060600,"choices":[{"text":"同意","goto":77},{"text":"拒绝","goto":76}]},{"step":80,"speaker":"杜若","content":"放心，只是普通的熏香，我不会在其间掺杂异能的。","voice":["vo_trial_60601_1_76"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601076,"trial_step":76,"drawing":1060600},{"step":81,"content":"青烟萦绕下，她打开了话题。","style":3,"log_type":1,"src_id":160601077,"trial_step":77,"drawing":1060601},{"step":82,"speaker":"杜若","content":"从开始记事起，父母就将我送去了学塾。","voice":["vo_trial_60601_1_78"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601078,"trial_step":78,"drawing":1060601},{"step":83,"speaker":"杜若","content":"东洲大陆的文明源远流长，即便入夜之后也没有断绝传承。在为学子开蒙的过程中，先生会讲述各式各样的神话传说。金乌神话，就是其中之一。","voice":["vo_trial_60601_1_79"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601079,"trial_step":79,"drawing":1060601},{"step":84,"speaker":"杜若","content":"但第一次听先生讲述金乌的神话后，我产生了质疑。只会给人类带来灾厄的化身为什么要被奉为神祇？","voice":["vo_trial_60601_1_80"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601080,"trial_step":80,"drawing":1060601},{"step":85,"speaker":"杜若","content":"先生没有回答我的问题，他说“圣贤书里就是这么写的，你记住就是了”。","voice":["vo_trial_60601_1_81"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601081,"trial_step":81,"drawing":1060601},{"step":86,"content":"杜若轻声笑了笑，有些无奈地摇头。","style":3,"log_type":1,"src_id":160601082,"trial_step":82,"drawing":1060601},{"step":87,"speaker":"杜若","content":"你恐怕会意外吧，我小时候可不是什么听话的好学生。先生越是这么说，我越是不服气。","voice":["vo_trial_60601_1_83"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601083,"trial_step":83,"drawing":1060601},{"step":88,"speaker":"杜若","content":"我将神话视为迷信，试图证明金乌不是神，只是一种妖兽。而后我以一系列的质疑为起点，开始了身为神话学者的研究。","voice":["vo_trial_60601_1_84"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601084,"trial_step":84,"drawing":1060601},{"step":89,"speaker":"杜若","content":"研究的这些年里，我读了一些书，也遇见了一些朋友。","voice":["vo_trial_60601_1_85"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601085,"trial_step":85,"drawing":1060601},{"step":90,"speaker":"杜若","content":"有的朋友和我一样不信神话，但却为了守护那些愚昧的信仰，献出了生命。","voice":["vo_trial_60601_1_86"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601086,"trial_step":86,"drawing":1060602},{"step":91,"speaker":"杜若","content":"有的朋友在苍生大义与个人信条之间会毫不犹豫地选择前者，并为之付出数十年无名的努力。","voice":["vo_trial_60601_1_87"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601087,"trial_step":87,"drawing":1060602},{"step":92,"speaker":"杜若","content":"还有的朋友……你已经见过了。","voice":["vo_trial_60601_1_88"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601088,"trial_step":88,"drawing":1060602},{"step":93,"options":["金乌体内的那位巫祭？"],"style":6,"log_type":1,"src_id":160601089,"trial_step":89,"course":3,"drawing":1060602,"choices":[{"text":"金乌体内的那位巫祭？","goto":90}]},{"step":94,"speaker":"杜若","content":"是啊，就是阿煦她们挽救了十日天灾下的虞泉，是她们让我知道，即便通读整墙的典籍，我所追寻的也只是神话中最浅薄的一部分。","voice":["vo_trial_60601_1_90"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601090,"trial_step":90,"drawing":1060602},{"step":95,"content":"她难得竭尽坦诚地讲述着。","style":3,"log_type":1,"src_id":160601091,"trial_step":91,"drawing":1060602},{"step":96,"speaker":"杜若","content":"原来神迹真的存在，是那些故友……是“人”，创造了神迹。","voice":["vo_trial_60601_1_92"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601092,"trial_step":92,"drawing":1060602},{"step":97,"content":"杜若表现出前所未有的认真，她在努力压抑着自己的情绪，但你还是本能感受到了空气中狂厄的波动。","style":3,"log_type":1,"src_id":160601093,"trial_step":93,"drawing":1060602},{"step":98,"content":"这对她来说显然不是轻松的过去，她花费了一些时间调整呼吸。","style":3,"log_type":1,"src_id":160601094,"trial_step":94,"drawing":1060602},{"step":99,"speaker":"杜若","content":"你说我不信神，这话没错，我只相信用人类血汗构筑的真相。","voice":["vo_trial_60601_1_95"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601095,"trial_step":95,"drawing":1060601},{"step":100,"speaker":"杜若","content":"但你说狄斯没有神话，这却错了。","voice":["vo_trial_60601_1_96"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601096,"trial_step":96,"drawing":1060601},{"step":101,"speaker":"杜若","content":"对见证过覆灭的人们而言，天灾之下能够建起这样一座繁荣发达的城邦，本就是神话。","voice":["vo_trial_60601_1_97"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601097,"trial_step":97,"drawing":1060601},{"step":102,"content":"气氛沉静下来，香炉中的香材也恰好燃尽。但杜若对神话一番新的解读却余音绕梁，同那股青烟的香味一样，仍盘桓于一方审查室中。","style":3,"log_type":1,"src_id":160601098,"trial_step":98,"drawing":1060601},{"step":103,"content":"或许直到此刻，你才真正对“神话学者”这个身份有了认知。","style":3,"log_type":1,"src_id":160601099,"trial_step":99,"drawing":1060601},{"step":104,"options":["你真的是为了“狄斯神话”而来？"],"style":6,"log_type":1,"src_id":160601100,"trial_step":100,"course":3,"drawing":1060601,"choices":[{"text":"你真的是为了“狄斯神话”而来？","goto":101}]},{"step":105,"speaker":"杜若","content":"局长要是还不信我，就陪我一同访学如何？","voice":["vo_trial_60601_1_101"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601101,"trial_step":101,"drawing":1060600},{"step":106,"speaker":"杜若","content":"正巧我也需要一位向导，带我走近狄斯，了解风土人情。这里的人们都是如何看待已经被克服的天灾，如何看待如今的生活，又是如何面对狂厄的潜在威胁？","voice":["vo_trial_60601_1_102"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601102,"trial_step":102,"drawing":1060600},{"step":107,"speaker":"局长","content":"这些也是“神话”的一部分吗？","style":2,"log_type":1,"src_id":160601103,"trial_step":103,"drawing":1060600},{"step":108,"speaker":"杜若","content":"当然，和“凡人的信念也能射落太阳”一样，这些看似唾手可得的日常对于没有异方晶庇护的东洲而言，如梦似幻，像传说，像希望……","voice":["vo_trial_60601_1_104"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601104,"trial_step":104,"drawing":1060600},{"step":109,"speaker":"杜若","content":"不来陪我一同编写这本名为狄斯的神话吗？一定有人期待在故事里看到你。","voice":["vo_trial_60601_1_105"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601105,"trial_step":105,"drawing":1060600},{"step":110,"speaker":"局长","content":"……你的同乡们还有这种爱好？","style":2,"log_type":1,"src_id":160601106,"trial_step":106,"drawing":1060600},{"step":111,"speaker":"杜若","content":"有啊，比如我~给我一个在故事里写下你名字的机会吧，就当成全一下我的个人趣味？","voice":["vo_trial_60601_1_107"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601107,"trial_step":107,"drawing":1060600},{"step":112,"content":"她又恢复了往日调笑的轻松，食指轻点，落在那份入境同意书上。","style":3,"log_type":1,"src_id":160601108,"trial_step":108,"drawing":1060600},{"step":113,"speaker":"议员","content":"你有权通过她的申请，但你应该清楚狄斯想要的结果到底是什么。","voice":["vo_trial_60601_1_17"],"voice_bank":"vo_duruo_trial","style":1,"background":1040,"log_type":1,"src_id":160601109,"trial_step":109,"drawing":1060600},{"step":114,"speaker":"议员","content":"体面地将她送回东洲吧，这是狄斯城对你的信任。","voice":["vo_trial_60601_1_18"],"voice_bank":"vo_duruo_trial","style":1,"background":1040,"log_type":1,"src_id":160601110,"trial_step":110,"drawing":1060600},{"step":115,"content":"你看似拥有批准的权利，可事实上你只能在无条件驱逐和承担全责之间二选一而已。","style":3,"log_type":1,"src_id":160601111,"trial_step":111,"drawing":1060600},{"step":116,"options":["签署入境同意书"],"style":6,"log_type":1,"src_id":160601112,"trial_step":112,"course":3,"drawing":1060600,"choices":[{"text":"签署入境同意书","goto":113}]},{"step":117,"speaker":"局长","content":"“访学”只能像你所说的那样，去了解风土人情。一切与城邦机密相关的事都不能过问，申请中列举的所有敏感地区都不可靠近……","style":2,"log_type":1,"src_id":160601113,"trial_step":113,"drawing":1060600},{"step":118,"speaker":"局长","content":"MBCC帮你争取到的权益只有这些了。","style":2,"log_type":1,"src_id":160601114,"trial_step":114,"drawing":1060600},{"step":119,"speaker":"杜若","content":"哦？这么说，我通过你的入境审查了？","voice":["vo_trial_60601_1_115"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601115,"trial_step":115,"drawing":1060601},{"step":120,"speaker":"局长","content":"虽然你这个人撒谎惯了，但我还是愿意赌一把你对“神话”求索的初心。“访学”过程中我也会全程同行，以免你搞什么小动作。","style":2,"log_type":1,"src_id":160601116,"trial_step":116,"drawing":1060601},{"step":121,"speaker":"杜若","content":"你不怕惹那些大人物不开心吗？","voice":["vo_trial_60601_1_117"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601117,"trial_step":117,"drawing":1060600},{"step":122,"speaker":"局长","content":"这你就不用管了，MBCC会为你专门拟定入境协议，你只要遵守规范，完成你的神话就好。","style":2,"log_type":1,"src_id":160601118,"trial_step":118,"drawing":1060600},{"step":123,"speaker":"杜若","content":"好霸道好威风，你在狄斯人里果然也是极有魅力的那一批~那么局长大人，你刚刚还欠着我一个问题，可以告诉我了吗——","voice":["vo_trial_60601_1_119"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601119,"trial_step":119,"drawing":1060600},{"step":124,"speaker":"杜若","content":"局长你自己……希望我回来吗？","voice":["vo_trial_60601_1_120"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601120,"trial_step":120,"drawing":1060600},{"step":125,"content":"她压低了声音，狐狸似的噙笑看你。","style":3,"log_type":1,"src_id":160601121,"trial_step":121,"drawing":1060600},{"step":126,"speaker":"局长","content":"那你也有问题没有回答我——短短几日不足以往返狄斯和东洲，为什么要在入境申请里撒谎？","style":2,"log_type":1,"src_id":160601122,"trial_step":122,"drawing":1060600},{"step":127,"speaker":"杜若","content":"这样啊……","voice":["vo_trial_60601_1_123"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601123,"trial_step":123,"drawing":1060600},{"step":128,"content":"她迟疑了片刻，你似乎在她脸上捕捉到一闪而逝的失落。","style":3,"log_type":1,"src_id":160601124,"trial_step":124,"drawing":1060600},{"step":129,"speaker":"杜若","content":"那我们就互相欠着这个问题吧，也算扯平了。","voice":["vo_trial_60601_1_125"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601125,"trial_step":125,"drawing":1060600},{"step":130,"speaker":"杜若","content":"狄斯街头，不见不散，旅伴。","voice":["vo_trial_60601_1_126"],"voice_bank":"vo_duruo_trial","style":1,"log_type":1,"src_id":160601126,"trial_step":126,"drawing":1060600}]}