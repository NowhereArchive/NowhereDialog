{"id":404330501,"chapter_id":50088,"scene_id":58877,"steps":[{"step":1,"content":"你试图用身体阻挡曼菲斯特，却被他一个猛撞击飞到了墙上。","style":3,"background":2505,"log_type":1},{"step":2,"content":"（血红）","style":18,"background":2505,"log_type":1},{"step":3,"content":"双耳一阵嗡鸣，有液体从头上流淌下来。","style":3,"background":2505,"log_type":1},{"step":4,"speaker":"曼菲斯特","content":"这是我的密码机——我的——！","style":1,"background":2505,"log_type":1},{"step":5,"content":"在所有人震惊的目光中，怪物张开了血盆大口，将半人高的磐石高举了起来，强行塞进了巨大的喉管。","style":3,"background":2505,"log_type":1},{"step":6,"content":"金属在喉管之中被挤压的声音，变成一系列如点火般的细小爆鸣，轰鸣从他的体内向外炸开——","style":3,"background":2505,"log_type":1},{"step":7,"content":"（爆鸣+白屏）","style":18,"background":10006,"log_type":1},{"step":8,"content":"从他喉咙深处喷涌而出的狂厄气浪瞬间席卷了整个庄园。","style":3,"background":10006,"log_type":1},{"step":9,"content":"你的身体被猛烈的力量挤压、撕碎，转瞬之间便失去了知觉。","style":3,"background":10006,"log_type":1}]}