0301},{"step":163,"content":"你们都沉默了许久，狼獾用有些沙哑的声音再次开口。","style":3,"log_type":1,"src_id":240301152,"trial_step":152,"drawing":1140301},{"step":164,"speaker":"狼獾","content":"汉……那个臭老头是怎么死的？","style":1,"log_type":1,"src_id":240301153,"trial_step":153,"drawing":1140301},{"step":165,"content":"死亡原因？","style":2,"log_type":1,"src_id":240301154,"trial_step":154,"drawing":1140301},{"step":166,"content":"你又仔细看了一遍资料，然而关于汉克，只有一句轻描淡写的“拾荒者汉克确认死亡”，没有死因、没有尸体报告。","style":3,"log_type":1,"src_id":240301155,"trial_step":155,"drawing":1140301},{"step":167,"content":"没有记录，这不正常，难道有谁做了手脚？会不会跟武器交易有什么关系……","style":2,"log_type":1,"src_id":240301156,"trial_step":156,"drawing":1140303},{"step":168,"content":"你合上资料夹，站起身来。狼獾还坐在原地，似乎在思考你刚刚说的话。","style":3,"log_type":1,"src_id":240301157,"trial_step":157,"drawing":1140303},{"step":169,"content":"今天就到这里吧，我得抽空去锈河，搜查汉克的住所。","style":2,"log_type":1,"src_id":240301158,"trial_step":158,"drawing":1140303},{"step":170,"speaker":"狼獾","content":"等一下！","style":1,"log_type":1,"src_id":240301159,"trial_step":159,"drawing":1140300},{"step":171,"content":"他一把抓住你的手。","style":3,"log_type":1,"src_id":240301160,"trial_step":160,"drawing":1140300},{"step":172,"speaker":"狼獾","content":"什么时候去？我给你带路。","style":1,"log_type":1,"src_id":240301161,"trial_step":161,"drawing":1140300},{"step":173,"options":["答应狼獾","拒绝他的好意"],"style":6,"log_type":1,"src_id":240301162,"trial_step":162,"course":3,"drawing":1140300,"choices":[{"text":"答应狼獾","goto":163},{"text":"拒绝他的好意","goto":167}]},{"step":174,"content":"你也想知道他的死因，对吧？","style":2,"log_type":1,"src_id":240301163,"trial_step":163,"drawing":1140300},{"step":175,"speaker":"狼獾","content":"谁管那老头啊！是……是因为锈河太危险了，你那么蠢，会迷路的。","style":1,"log_type":1,"src_id":240301164,"trial_step":164,"drawing":1140304},{"step":176,"content":"看来他还是不愿意坦白自己在意汉克的原因。","style":3,"log_type":1,"src_id":240301165,"trial_step":165,"drawing":1140301},{"step":177,"content":"好吧，我可以带你去。","style":2,"log_type":1,"src_id":240301166,"trial_step":166,"drawing":1140301,"next":[172]},