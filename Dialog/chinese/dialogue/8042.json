{"id":8042,"chapter_id":8,"scene_id":804,"steps":[{"step":1,"content":"兰利和夜莺的幻象已被驱散，但浑浊的迷雾仍然没有减淡的迹象。","style":3,"background":703,"log_type":1},{"step":2,"content":"读取记忆，具象意识，放大情绪……黑色的幻境能力本质与湖上哈梅尔的治愈乐园相同，是深层的精神入侵。","style":3,"background":703,"log_type":1},{"step":3,"content":"它甚至能如此具体地描摹你潜意识中的猜疑，看来“她”已经潜入你精神深处——她一定会再次出现。","style":3,"background":703,"log_type":1},{"step":4,"speaker":"选项","options":["直面我，这种程度根本不算什么"],"jump":[5],"style":6,"background":703,"log_type":1},{"step":5,"content":"迷雾中隐约传来了熟悉的声音。","style":3,"background":703,"log_type":1},{"step":6,"speaker":"？？？","content":"你很……强大吗……？","voice":["vo_cgplot_8042006"],"voice_bank":"vo_cgplot_08","style":1,"background":10000,"log_type":1},{"step":7,"speaker":"？？？","content":"那……为什么不救我？","voice":["vo_cgplot_8042007"],"voice_bank":"vo_cgplot_08","style":1,"background":10000,"log_type":1},{"step":8,"speaker":"【空场】","content":"淡入战损灰发立绘","style":18,"background":10000,"log_type":1}]}