{"id":400301201,"chapter_id":50014,"scene_id":51402,"steps":[{"step":1,"speaker":"怪物的声音","content":"——！","style":1,"background":2025,"log_type":1},{"step":2,"content":"一向冷静的赫卡蒂在这次任务中却表现得不太正常。死役的咆哮声，夜半的钟声，甚至风吹入美术馆的声音……每一丝响动都会引起她的警觉。","style":3,"background":2025,"log_type":1},{"step":3,"content":"但过高的敏感性反而让她们一次又一次地踏入死役的包围。","style":3,"background":2025,"log_type":1},{"step":4,"content":"不过这次，她们碰上的不只有怪物，还有——","style":3,"background":2025,"log_type":1},{"step":5,"speaker":"莎夏","content":"啊——这是什么东西！","voice":["vo_event_03012_1"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":6,"speaker":"莎夏","content":"要死要死要死要死！","voice":["vo_event_03012_2"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":7,"content":"莎夏一路狂奔，身后的怪物们嚎叫着，对她穷追不舍。","style":3,"background":2025,"log_type":1},{"step":8,"content":"她一个飞扑到雷比尼斯的身边，想要抱住雷比尼斯的大腿，却被优雅地躲过。","style":3,"background":2025,"log_type":1},{"step":9,"content":"扑了个空的莎夏摇摇晃晃地站起，却是第一时间捡起了掉在地上的手机，开始了录制。","style":3,"background":2025,"log_type":1},{"step":10,"speaker":"雷比尼斯","content":"接敌，准备剿灭。","voice":["vo_event_03012_4"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":11,"content":"刀光连闪，跟随着莎夏的怪物瞬间便灰飞烟灭。","style":3,"background":2025,"log_type":1},{"step":12,"speaker":"莎夏","content":"喂喂喂你们难道都不害怕的么！","voice":["vo_event_03012_6"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":13,"content":"短暂的战斗结束后，莎夏死皮赖脸地跟了上来，手中的屏幕还在闪烁着，显然是进入了采访的状态。","style":3,"background":2025,"log_type":1},{"step":14,"speaker":"雷比尼斯","content":"不会，管理局内的情况更糟。","voice":["vo_event_03012_8"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":15,"speaker":"莎夏","content":"可是，那可是有人从画里钻出来诶！","voice":["vo_event_03012_9"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":16,"speaker":"赫卡蒂","content":"不要再跟着我们了，你会死的。","voice":["vo_event_03012_10"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":17,"speaker":"莎夏","content":"听到了么大家，这就是禁闭者！","voice":["vo_event_03012_11"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":18,"speaker":"莎夏","content":"有强大的力量，有碾碎一切力量的禁闭者！","voice":["vo_event_03012_12"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":19,"speaker":"莎夏","content":"要我说，这FAC就该多放几个这样的人。又厉害，又能给大家提供话题，多好！","voice":["vo_event_03012_13"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":20,"content":"她无视了赫卡蒂的发言，又自顾自地开始录制。","style":3,"background":2025,"log_type":1},{"step":21,"speaker":"赫卡蒂","content":"……","voice":["vo_event_03012_15"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":22,"speaker":"雷比尼斯","content":"重复，希望您的判断，是正确的。","voice":["vo_event_03012_16"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":23,"content":"雷比尼斯看向了一旁的莎夏。","style":3,"background":2025,"log_type":1},{"step":24,"speaker":"赫卡蒂","content":"无所谓，我不会保护她。","voice":["vo_event_03012_17"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":25,"speaker":"雷比尼斯","content":"同意，但，有一个问题。","voice":["vo_event_03012_18"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":26,"speaker":"雷比尼斯","content":"她，是否对你的心态，产生了影响？","voice":["vo_event_03012_19"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":27,"speaker":"赫卡蒂","content":"……","style":1,"background":2025,"log_type":1},{"step":28,"content":"赫卡蒂沉默着，握紧了手中的画册。","style":3,"background":2025,"log_type":1},{"step":29,"speaker":"赫卡蒂","content":"找回局长是最优先事项，不必在意我的状态。","voice":["vo_event_03012_20"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":30,"speaker":"雷比尼斯","content":"否认，不是关于你救下的人本身。","voice":["vo_event_03012_21"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":31,"speaker":"雷比尼斯","content":"而是，你受影响，带着我们走到了错误的方向。","voice":["vo_event_03012_22"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":32,"content":"这已经是第11次，赫卡蒂因为过于敏感导致她做出了错误的判断，走入了错误的路线。","style":3,"background":2025,"log_type":1},{"step":33,"speaker":"赫卡蒂","content":"……","style":1,"background":2025,"log_type":1},{"step":34,"content":"时间一分一秒过去，赫卡蒂只得看着手中的导览器，陷入沉默。","style":3,"background":2025,"log_type":1},{"step":35,"content":"她不知道，失去了枷锁的指引，到底该怎么做才能找到局长。","style":3,"background":2025,"log_type":1},{"step":36,"speaker":"雷比尼斯","content":"提问，恩菲尔。","voice":["vo_event_03012_26"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":37,"speaker":"大丽花导览","content":"我在。","voice":["vo_event_03012_27"],"voice_bank":"vo_event_03_p1b","style":11,"background":2025,"log_type":1},{"step":38,"content":"雷比尼斯率先打破了僵局，淡蓝色的向导应声而出。","style":3,"background":2025,"log_type":1},{"step":39,"speaker":"雷比尼斯","content":"疑问，场馆地图是否出错？","voice":["vo_event_03012_29"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":40,"speaker":"大丽花导览","content":"这是恩菲尔亲手设计的地图，绝对不会出错。","voice":["vo_event_03012_30"],"voice_bank":"vo_event_03_p1b","style":11,"background":2025,"log_type":1}]}