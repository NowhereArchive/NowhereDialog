{"id":8022,"chapter_id":8,"scene_id":802,"steps":[{"step":1,"speaker":"海拉","content":"哈、哈、真的是、没完没了近不了身！","voice":["vo_cgplot_8022001"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":2,"speaker":"海拉","content":"说要我们过去，你倒是放人呀！整这么多怪物堵我干嘛！","voice":["vo_cgplot_8022002"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":3,"speaker":"选项","options":["她想要的只有我"],"jump":[4],"style":6,"background":710,"log_type":1},{"step":4,"content":"你上前一步，直面那个扭曲的幻影。","style":3,"background":710,"log_type":1},{"step":5,"speaker":"选项","options":["来吧，你要我怎么陪你？"],"jump":[6],"style":6,"background":710,"log_type":1},{"step":6,"speaker":"“哈梅尔”","content":"哈哈哈哈——你果然是最好的，你比她还要好！","voice":["vo_cgplot_8022006"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":7,"speaker":"“哈梅尔”","content":"我来接你了！","voice":["vo_cgplot_8022007"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"局长，危险！","voice":["vo_cgplot_8022008"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":10,"content":"她的裙摆化作无数幻影向你扑来，在禁闭者们惊慌地阻拦之前，你伸手一把握住那些黑影，任凭它们将你吞没。","style":3,"background":710,"log_type":1}]}