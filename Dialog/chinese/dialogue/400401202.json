{"id":400401202,"chapter_id":50016,"scene_id":51620,"steps":[{"step":1,"speaker":"嗷呜","content":"于是嗷呜大魔王又一次派人袭击了村庄——","voice":["vo_event_400401202_2"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":2,"speaker":"嗷呜","content":"这次的规模更大，村民们根——本——抵抗不了嗷呜怪们的进攻。","voice":["vo_event_400401202_3"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":3,"speaker":"嗷呜","content":"嘿嘿，这时候你要怎么做呢……你要来救他们呢？还是说想逃跑呢？","voice":["vo_event_400401202_4"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":4,"speaker":"嗷呜","content":"勇敢的女主角？","voice":["vo_event_400401202_5"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":5,"speaker":"琳","content":"我……我……","voice":["vo_event_400401202_6"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":6,"speaker":"村民","content":"别管我们，琳，去找糖果，你要好好的！","voice":["vo_event_400401202_8"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":7,"speaker":"琳","content":"可，可是……","voice":["vo_event_400401202_9"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":8,"speaker":"村民","content":"快走——你一定要找到勇气糖果！你是我们的希望！","voice":["vo_event_400401202_10"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":9,"speaker":"村民","content":"加油啊！琳！","voice":["vo_event_400401202_11"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":10,"speaker":"村民","content":"我们可就全靠你了！","voice":["vo_event_400401202_12"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":11,"speaker":"琳","content":"……我……我知道了！我一定会找到糖果的！","voice":["vo_event_400401202_13"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":12,"speaker":"琳","content":"我一定会来救你们的！","voice":["vo_event_400401202_14"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":13,"content":"于是琳离开了村子，成为了最后的火种，踏上了寻找打倒嗷呜大魔王的方法的旅程。","style":3,"background":4040,"log_type":1}]}