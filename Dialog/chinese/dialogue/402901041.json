{"id":402901041,"chapter_id":70045,"scene_id":74505,"steps":[{"step":1,"content":"【图科镇-街道】","style":18,"background":2290,"log_type":1},{"step":2,"speaker":"砂盗首领","content":"说，货在哪里，那两个女人在哪里？！","voice":["vo_event_402901041_02"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":3,"speaker":"小提米","content":"唔——不、不知道——我什么……什么也不知道！！","voice":["vo_event_402901041_03"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":4,"speaker":"砂盗首领","content":"哈，大的小的都给我装傻，不肯说是吧！","voice":["vo_event_402901041_04"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":5,"content":"提米被人用力甩在地上，而他的身旁，身穿制服的莱特被布团塞着嘴巴，五花大绑动弹不得。","style":3,"background":2290,"log_type":1},{"step":6,"speaker":"莱特","content":"唔、唔唔——！","voice":["vo_event_402901041_06"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":7,"content":"砂盗冲着莱特的腹部狠踢了几脚，在对方痛得发不出声音后，砂盗摸出一把刀，递给手下。","style":3,"background":2290,"log_type":1},{"step":8,"speaker":"砂盗首领","content":"既然不肯说，那以后也不用再说了。","voice":["vo_event_402901041_08"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":9,"speaker":"砂盗首领","content":"穿制服的那个，你可要睁大眼睛好好地看清楚，我是怎么把这小孩儿给拆开的……","voice":["vo_event_402901041_09"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":10,"speaker":"砂盗首领","content":"别堵嘴，让他喊！动静越大越好，我就不信她们能假装没听——","voice":["vo_event_402901041_10"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":11,"content":"砂盗们沸腾骂声戛然而止。领头的砂盗被一只铁桶砸中后脑，砸倒在地。","style":3,"background":2290,"log_type":1},{"step":12,"speaker":"海拉","content":"放开他们！你海拉爷爷在这呢！","voice":["vo_event_402901041_12"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1}]}