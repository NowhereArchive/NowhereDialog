{"id":1060104,"chapter_id":1060104,"scene_id":1,"steps":[{"step":1,"content":"枷锁的感应加上诺曼留下的吊坠的指引，找到哈梅尔的位置并不太难。她没有走远，还停留在距离大门原址不远的地方。","style":3,"background":1037,"log_type":1,"src_id":160104001,"trial_step":1},{"step":2,"content":"等你找到她的时候，她正好奇地抚摸着残破的遗迹，仔细端详着。","style":3,"background":1037,"log_type":1,"src_id":160104002,"trial_step":2},{"step":3,"options":["哈梅尔，你在看什么？"],"style":6,"background":1037,"log_type":1,"src_id":160104003,"trial_step":3,"course":3,"choices":[{"text":"哈梅尔，你在看什么？","goto":4}]},{"step":4,"speaker":"哈梅尔","content":"局长。","voice":["vo_trial_60104_1_4"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104004,"trial_step":4},{"step":5,"content":"她对你的到来似乎并不意外。","style":3,"background":1037,"log_type":1,"src_id":160104005,"trial_step":5},{"step":6,"speaker":"哈梅尔","content":"我见过嘉年华披上幻境前狰狞可怖的样子，也见过它在虚像下最热闹繁华的时候。","voice":["vo_trial_60104_1_6"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104006,"trial_step":6},{"step":7,"speaker":"哈梅尔","content":"但这样的嘉年华……却是第一次见。","voice":["vo_trial_60104_1_7"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104007,"trial_step":7},{"step":8,"content":"为了抹杀一切狂厄留存的风险，那些游乐设施基本都已经清除了。剩下的这些应该很快也会被处理掉。","style":2,"background":1037,"log_type":1,"src_id":160104008,"trial_step":8},{"step":9,"content":"用不了多久，这里会变成一片戈壁，甚至会被锈河的垃圾重新覆盖。","style":2,"background":1037,"log_type":1,"src_id":160104009,"trial_step":9},{"step":10,"speaker":"哈梅尔","content":"狄斯很快就会忘记嘉年华吧，也会忘记我……","voice":["vo_trial_60104_1_10"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104010,"trial_step":10},{"step":11,"content":"我会记得你，也会帮你想起来这里发生的事，我今天就是为此而来的。","style":2,"background":1037,"log_type":1,"src_id":160104011,"trial_step":11},{"step":12,"content":"那个多管闲事的臭水母应该告诉过你吧？","style":2,"background":1037,"log_type":1,"src_id":160104012,"trial_step":12},{"step":13,"content":"冷不丁的调侃成功逗笑了哈梅尔，她将双手轻轻放在胸口。","style":3,"background":1037,"log_type":1,"src_id":160104013,"trial_step":13},{"step":14,"speaker":"哈梅尔","content":"它都告诉我了……你愿意看我跳舞，对吗？","voice":["vo_trial_60104_1_14"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104014,"trial_step":14},{"step":15,"content":"是的，虽然只有我一个观众。","style":2,"background":1037,"log_type":1,"src_id":160104015,"trial_step":15},{"step":16,"speaker":"哈梅尔","content":"一个，也很好……","voice":["vo_trial_60104_1_16"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104016,"trial_step":16},{"step":17,"content":"萧瑟的陆滩上只有你、哈梅尔以及两个被太阳拉长的影子并肩而行。","style":3,"background":1037,"log_type":1,"src_id":160104017,"trial_step":17},{"step":18,"content":"你们要继续进入嘉年华遗迹的深处，回到独属于哈梅尔的湖心舞台。","style":3,"background":1037,"log_type":1,"src_id":160104018,"trial_step":18},{"step":19,"content":"这个位置，大概就是我遇见那三只傀儡的地方，空虚、痛苦、恐惧。他们都很喜欢你的舞蹈，你还有印象吗？","style":2,"background":1037,"log_type":1,"src_id":160104020,"trial_step":20},{"step":20,"speaker":"哈梅尔","content":"空虚、痛苦、恐惧……这是他们的名字吗？","voice":["vo_trial_60104_1_21"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104021,"trial_step":21},{"step":21,"content":"对。","style":2,"background":1037,"log_type":1,"src_id":160104022,"trial_step":22},{"step":22,"speaker":"哈梅尔","content":"好悲伤的名字……","voice":["vo_trial_60104_1_23"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104023,"trial_step":23},{"step":23,"speaker":"哈梅尔","content":"我依稀记起了一些……我的舞蹈能帮他们暂时忘记烦恼，却无法真正让这些灵魂安歇。","voice":["vo_trial_60104_1_24"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104024,"trial_step":24},{"step":24,"content":"她伸出手，手掌拂过无形的气流，面前浮起了三只小小的水母幻象。","style":3,"background":1037,"log_type":1,"src_id":160104025,"trial_step":25},{"step":25,"content":"和那象征孤独和拘束的幽影不同，这三只胖乎乎的水母实在小得可爱。","style":3,"background":1037,"log_type":1,"src_id":160104026,"trial_step":26},{"step":26,"speaker":"哈梅尔","content":"去吧，去那个没有烦恼的世界。当他们需要我的舞蹈时，替我陪伴他们。","voice":["vo_trial_60104_1_27"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104027,"trial_step":27},{"step":27,"content":"哈梅尔挥了挥手，三只小水母悠悠升空。","style":3,"background":1037,"log_type":1,"src_id":160104028,"trial_step":28},{"step":28,"content":"你明知道这只是一种视觉上的仪式，它们不可能真的通往另一个世界，但还是忍不住抬头目送这三个小水母消失在天空。","style":3,"background":1037,"log_type":1,"src_id":160104029,"trial_step":29},{"step":29,"options":["继续前进"],"style":6,"background":1037,"log_type":1,"src_id":160104030,"trial_step":30,"course":3,"choices":[{"text":"继续前进","goto":31}]},{"step":30,"content":"你们按照导航指引的方位一直走，直到不远处的土壤露出激烈战斗后留下的大片焦褐。","style":3,"background":1037,"log_type":1,"src_id":160104031,"trial_step":31},{"step":31,"speaker":"哈梅尔","content":"你在这里遭遇过危险？","voice":["vo_trial_60104_1_32"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104032,"trial_step":32},{"step":32,"content":"那是一个模仿你的……","style":2,"background":1037,"log_type":1,"src_id":160104033,"trial_step":33},{"step":33,"content":"你不确定那能否被称作“人”。","style":3,"background":1037,"log_type":1,"src_id":160104034,"trial_step":34},{"step":34,"speaker":"哈梅尔","content":"你提起过，这里有另一个哈梅尔。","voice":["vo_trial_60104_1_35"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104035,"trial_step":35},{"step":35,"speaker":"哈梅尔","content":"我想……我曾经知道她的存在。她是极乐之境的中心，却也是这里最孤独的孩子，对吗？","voice":["vo_trial_60104_1_36"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104036,"trial_step":36},{"step":36,"content":"你想起了什么？","style":2,"background":1037,"log_type":1,"src_id":160104037,"trial_step":37},{"step":37,"speaker":"哈梅尔","content":"婴孩孤单的啼哭，组成了舞曲的一部分。或许，我和她早已经熟悉了。","voice":["vo_trial_60104_1_38"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104038,"trial_step":38},{"step":38,"content":"她羡慕你拥有的嘉年华里所有人的爱，所以模仿你。","style":2,"background":1037,"log_type":1,"src_id":160104039,"trial_step":39},{"step":39,"speaker":"哈梅尔","content":"羡慕我……","voice":["vo_trial_60104_1_40"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104040,"trial_step":40},{"step":40,"content":"哈梅尔俯下身，用指尖细细感受土壤的温度，似乎在用这种方式与模仿者交流。","style":3,"background":1037,"log_type":1,"src_id":160104041,"trial_step":41},{"step":41,"speaker":"哈梅尔","content":"知道自己想要什么，是件多幸运的事，我该羡慕你才对。","voice":["vo_trial_60104_1_42"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104042,"trial_step":42},{"step":42,"content":"她指尖落下的地方开出了一朵小花。","style":3,"background":1037,"log_type":1,"src_id":160104043,"trial_step":43},{"step":43,"speaker":"哈梅尔","content":"土地、空气、阳光和雨水，它们都会爱你……这次，请好好长大吧。","voice":["vo_trial_60104_1_44"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104044,"trial_step":44},{"step":44,"content":"这花朵明明只是小小的幻象，却在风吹过时轻轻摆动了叶片。","style":3,"background":1037,"log_type":1,"src_id":160104045,"trial_step":45},{"step":45,"options":["继续前进"],"style":6,"background":1037,"log_type":1,"src_id":160104046,"trial_step":46,"course":3,"choices":[{"text":"继续前进","goto":47}]},{"step":46,"content":"你们继续走了一阵，距离你的目的地越来越近，残留的景物也越来越稀少。","style":3,"background":1037,"log_type":1,"src_id":160104047,"trial_step":47},{"step":47,"content":"终于，在一片空荡荡的平地前，哈梅尔停下了脚步。","style":3,"background":1037,"log_type":1,"src_id":160104048,"trial_step":48},{"step":48,"speaker":"哈梅尔","content":"这个地方，我感觉……很熟悉？","voice":["vo_trial_60104_1_49"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104049,"trial_step":49},{"step":49,"content":"这里曾是嘉年华神圣不可侵犯的领地，守卫哈梅尔舞姿的游行者们将这附近围得水泄不通。","style":3,"background":1037,"log_type":1,"src_id":160104050,"trial_step":50},{"step":50,"content":"黑环破碎后，这里又成为了镇压数万死役的深湖。","style":3,"background":1037,"log_type":1,"src_id":160104051,"trial_step":51},{"step":51,"content":"你曾在这里为哈梅尔套上枷锁，许诺带她离开。可惜，她已经忘记了。","style":3,"background":1037,"log_type":1,"src_id":160104052,"trial_step":52},{"step":52,"content":"如今所有幻象褪去，这里竟然只是一方空旷的平地……","style":3,"background":1037,"log_type":1,"src_id":160104053,"trial_step":53},{"step":53,"content":"哈梅尔试探着向前迈出一步、两步、三步……她的脚步渐渐有了节奏，像是习惯了足尖的触感，逐渐轻盈起来。","style":3,"background":1037,"log_type":1,"src_id":160104054,"trial_step":54},{"step":54,"content":"走至中心后，她转身面向了今日唯一的观众。观众安静地等待她的开场，但她的内心，却无法平静——","style":3,"background":1037,"log_type":1,"src_id":160104055,"trial_step":55},{"step":55,"speaker":"幽影","content":"<color=#7683a2><i>为自己所感知的一切自由起舞……这个心愿，你实现了吗？</i></color>","voice":["vo_trial_60104_1_57"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104057,"trial_step":57},{"step":56,"speaker":"哈梅尔","content":"<color=#7683a2><i>我不知道，但他已经解开了对我异能的禁制，这场演出，我可以全力跳下去。</i></color>","female_content":"<color=#7683a2><i>我不知道，但她已经解开了对我异能的禁制，这场演出，我可以全力跳下去。</i></color>","voice":["vo_trial_60104_1_58"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104058,"trial_step":58},{"step":57,"speaker":"诺曼","content":"<color=#7683a2><i>万一他只是为了放松你的戒备，和过去那些人一样哄骗你利用你！</i></color>","female_content":"<color=#7683a2><i>万一她只是为了放松你的戒备，和过去那些人一样哄骗你利用你！</i></color>","voice":["vo_trial_60104_1_59"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104059,"trial_step":59},{"step":58,"speaker":"哈梅尔","content":"<color=#7683a2><i>不会的……我感觉得到，他……他不一样。</i></color>","female_content":"<color=#7683a2><i>不会的……我感觉得到，她……她不一样。</i></color>","voice":["vo_trial_60104_1_60"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104060,"trial_step":60},{"step":59,"speaker":"骸","content":"<color=#7683a2><i>哪里不一样？我看他和你回忆里那些蠢观众也没什么差别嘛~</i></color>","female_content":"<color=#7683a2><i>哪里不一样？我看她和你回忆里那些蠢观众也没什么差别嘛~</i></color>","voice":["vo_trial_60104_1_61"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104061,"trial_step":61},{"step":60,"speaker":"哈梅尔","content":"<color=#7683a2><i>不，请别这么说他。</i></color>","female_content":"<color=#7683a2><i>不，请别这么说她。</i></color>","voice":["vo_trial_60104_1_62"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104062,"trial_step":62},{"step":61,"speaker":"老人","content":"<color=#7683a2><i>那究竟哪里不一样？</i></color>","voice":["vo_trial_60104_1_63"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104063,"trial_step":63},{"step":62,"speaker":"幽影","content":"<color=#7683a2><i>掩藏在回忆尽头的念头一层层剥开。</i></color>","voice":["vo_trial_60104_1_64"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104064,"trial_step":64},{"step":63,"speaker":"幽影","content":"<color=#7683a2><i>别再掩藏自己的欲望，你和他的故事，是时候重现于脑海。</i></color>","female_content":"<color=#7683a2><i>别再掩藏自己的欲望，你和她的故事，是时候重现于脑海。</i></color>","voice":["vo_trial_60104_1_65"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104065,"trial_step":65},{"step":64,"content":"就算我的心有黑洞，那也不需要用别的东西填补。我会背负它继续前进。","style":2,"background":50705,"log_type":1,"src_id":160104066,"trial_step":66},{"step":65,"content":"为自己跳舞吧，哈梅尔。我不需要你为我阻挡地狱。","style":2,"background":50705,"log_type":1,"src_id":160104067,"trial_step":67},{"step":66,"content":"枷锁没有指引错，我早该知道你就在这里。","style":2,"background":711,"log_type":1,"src_id":160104068,"trial_step":68},{"step":67,"content":"我来见你了，哈梅尔。","style":2,"background":711,"log_type":1,"src_id":160104069,"trial_step":69},{"step":68,"content":"你已经做得够多了，你不需要再牺牲自己。我答应过，带你回去，我不能让你孤独一人！","style":2,"background":705,"log_type":1,"src_id":160104070,"trial_step":70},{"step":69,"content":"那个具象出的幽影说你正在困惑、迷茫、孤独……但这不是你的错。","style":2,"background":1000,"log_type":1,"src_id":160104071,"trial_step":71},{"step":70,"content":"能与黑环共度二十三年，避免了诺曼和更多人误入险境，你已经做得很好了。","style":2,"background":1000,"log_type":1,"src_id":160104072,"trial_step":72},{"step":71,"content":"哈梅尔一直优先考虑别人的感受，把自己最热烈的愿望藏在最深处，一直积压。","style":2,"background":1037,"log_type":1,"src_id":160104073,"trial_step":73},{"step":72,"content":"困惑、迷茫、孤独……还是要谢谢你，让我看到她的噩梦，帮她把这些话说出来。","style":2,"background":1037,"log_type":1,"src_id":160104074,"trial_step":74},{"step":73,"speaker":"哈梅尔","content":"<color=#7683a2><i>是啊，我为什么没能想起来……他不一样，他与这个用痛苦织就的世界都不同。</i></color>","female_content":"<color=#7683a2><i>是啊，我为什么没能想起来……她不一样，她与这个用痛苦织就的世界都不同。</i></color>","voice":["vo_trial_60104_1_75"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104075,"trial_step":75},{"step":74,"speaker":"哈梅尔","content":"<color=#7683a2><i>灾难带来破碎的烟尘，癫狂的愁绪谱写了悲观的未来。但烟尘背后……</i></color>","voice":["vo_trial_60104_1_76"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104076,"trial_step":76},{"step":75,"speaker":"哈梅尔","content":"<color=#7683a2><i>有星光闪烁。</i></color>","voice":["vo_trial_60104_1_77"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104077,"trial_step":77},{"step":76,"speaker":"幽影","content":"<color=#7683a2><i>他希望你能尽兴。</i></color>","female_content":"<color=#7683a2><i>她希望你能尽兴。</i></color>","voice":["vo_trial_60104_1_78"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104078,"trial_step":78},{"step":77,"speaker":"幽影","content":"<color=#7683a2><i>做出选择吧，你将如何起舞——</i></color>","voice":["vo_trial_60104_1_79"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104079,"trial_step":79},{"step":78,"content":"哈梅尔？","style":2,"background":1037,"log_type":1,"src_id":160104081,"trial_step":81},{"step":79,"content":"不是要跳舞吗，为什么在出神……","style":2,"background":1037,"log_type":1,"src_id":160104082,"trial_step":82},{"step":80,"content":"！？","style":2,"background":1037,"log_type":1,"src_id":160104083,"trial_step":83},{"step":81,"content":"她突然来到你面前牵起了你的手。","style":3,"background":1037,"log_type":1,"src_id":160104084,"trial_step":84},{"step":82,"speaker":"哈梅尔","content":"可以……和我一起跳这支舞吗？","voice":["vo_trial_60104_1_85"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104085,"trial_step":85},{"step":83,"content":"突然的邀请让你措手不及，还没来得及思考如何回答，你已经跟着她来到了舞台的中心。","style":3,"background":1037,"log_type":1,"src_id":160104086,"trial_step":86},{"step":84,"options":["这太突然了","我还没有做好准备"],"style":6,"background":1037,"log_type":1,"src_id":160104087,"trial_step":87,"course":3,"choices":[{"text":"这太突然了","goto":88},{"text":"我还没有做好准备","goto":null}]},{"step":85,"content":"哈梅尔笑着没有回答，只是将十指与你交握。","style":3,"background":1037,"log_type":1,"src_id":160104088,"trial_step":88},{"step":86,"content":"她的眼神始终停留在你的身上。渐渐的，周遭的声音开始变得模糊，你跟上了她的步调。","style":3,"background":1037,"log_type":1,"src_id":160104089,"trial_step":89},{"step":87,"content":"这是你感知到的世界吗？这和你噩梦中的记忆不一样。","style":2,"background":1037,"log_type":1,"src_id":160104090,"trial_step":90},{"step":88,"speaker":"哈梅尔","content":"这是……我感知到的你。","voice":["vo_trial_60104_1_91"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104091,"trial_step":91},{"step":89,"content":"裙摆恣意展开铺就画卷，你们就像彩排过无数次般共同在上面谱写新的幻象。","style":3,"background":1037,"log_type":1,"src_id":160104092,"trial_step":92},{"step":90,"speaker":"哈梅尔","content":"一起，跳到尽兴为止吧——","voice":["vo_trial_60104_1_93"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160104093,"trial_step":93},{"step":91,"content":"她引领着你开始旋转。你们的距离那么近，你甚至可以听清她均匀的呼吸，能够感受到她脉搏里跳动的欣悦。","style":3,"background":3003,"log_type":1,"src_id":160104094,"trial_step":94},{"step":92,"content":"双人舞所塑造的幻境与冰之湖截然不同，描绘出来自春日的暖意。","style":3,"background":3003,"log_type":1,"src_id":160104095,"trial_step":95},{"step":93,"content":"草长，莺鸣……自然的景致像是演绎着一首饱含爱意的诗歌，时而暧昧缱绻，时而热烈奔放，一层层将这片历经毁灭的土地覆盖。","style":3,"background":3003,"log_type":1,"src_id":160104096,"trial_step":96},{"step":94,"speaker":"幽影","content":"<color=#7683a2><i>她的舞，变了？</i></color>","voice":["vo_trial_60104_1_97"],"voice_bank":"vo_hameier_trial","style":1,"background":3003,"log_type":1,"src_id":160104097,"trial_step":97},{"step":95,"speaker":"空虚傀儡","content":"<color=#7683a2><i>没有强迫，没有利用，这一曲悦音只是心之所想。</i></color>","voice":["vo_trial_60104_1_98"],"voice_bank":"vo_hameier_trial","style":1,"background":3003,"log_type":1,"src_id":160104098,"trial_step":98},{"step":96,"speaker":"恐惧傀儡","content":"<color=#7683a2><i>那她还会再为我们歌颂悲伤与痛苦吗？</i></color>","voice":["vo_trial_60104_1_99"],"voice_bank":"vo_hameier_trial","style":1,"background":3003,"log_type":1,"src_id":160104099,"trial_step":99},{"step":97,"speaker":"苦痛傀儡","content":"<color=#7683a2><i>不会了，我们不再是她最后的观众。</i></color>","voice":["vo_trial_60104_1_100"],"voice_bank":"vo_hameier_trial","style":1,"background":3003,"log_type":1,"src_id":160104100,"trial_step":100},{"step":98,"speaker":"诺曼","content":"<color=#7683a2><i>是时候告辞了。</i></color>","voice":["vo_trial_60104_1_101"],"voice_bank":"vo_hameier_trial","style":1,"background":3003,"log_type":1,"src_id":160104101,"trial_step":101},{"step":99,"speaker":"老人","content":"<color=#7683a2><i>这次……</i></color>","voice":["vo_trial_60104_1_102"],"voice_bank":"vo_hameier_trial","style":1,"background":3003,"log_type":1,"src_id":160104102,"trial_step":102},{"step":100,"speaker":"疯狂傀儡","content":"<color=#7683a2><i>是真正的道别了。</i></color>","voice":["vo_trial_60104_1_103"],"voice_bank":"vo_hameier_trial","style":1,"background":3003,"log_type":1,"src_id":160104103,"trial_step":103},{"step":101,"content":"好像有什么人在说话？","style":2,"background":3003,"log_type":1,"src_id":160104104,"trial_step":104},{"step":102,"speaker":"哈梅尔","content":"那是祝福的声音……","voice":["vo_trial_60104_1_105"],"voice_bank":"vo_hameier_trial","style":1,"background":3003,"log_type":1,"src_id":160104105,"trial_step":105},{"step":103,"speaker":"哈梅尔","content":"咚——咚——，他们在祝福这支舞蹈……","voice":["vo_trial_60104_1_106"],"voice_bank":"vo_hameier_trial","style":1,"background":3003,"log_type":1,"src_id":160104106,"trial_step":106},{"step":104,"speaker":"哈梅尔","content":"永不落幕。","voice":["vo_trial_60104_1_107"],"voice_bank":"vo_hameier_trial","style":1,"background":3003,"log_type":1,"src_id":160104107,"trial_step":107}]}