p":113},{"step":121,"content":"她手中武器对准了男孩，脸上难得没有了笑容，显得冷静、无情。","style":3,"background":1007,"log_type":1,"src_id":260302114,"trial_step":114},{"step":122,"content":"但你和男孩都能清楚看到，安的手在颤抖。","style":3,"background":1007,"log_type":1,"src_id":260302115,"trial_step":115},{"step":123,"speaker":"男孩","content":"一个月吗……也好。","style":1,"background":1007,"log_type":1,"src_id":260302116,"trial_step":116},{"step":124,"content":"男孩捡起了地上的药物。","style":3,"background":1007,"log_type":1,"src_id":260302117,"trial_step":117},{"step":125,"options":["你要放他走？","你不是还有第三种选择吗？"],"style":6,"background":1007,"log_type":1,"src_id":260302118,"trial_step":118,"course":3,"choices":[{"text":"你要放他走？","goto":119},{"text":"你不是还有第三种选择吗？","goto":121}]},{"step":126,"content":"安抿了抿嘴唇，低头避开了你的视线。","style":3,"background":1007,"log_type":1,"src_id":260302119,"trial_step":119},{"step":127,"content":"真的放这孩子离开吗？放走狂厄者，在FAC眼中，是非常严重的渎职。","style":3,"background":1007,"log_type":1,"src_id":260302120,"trial_step":120,"next":[124]},{"step":128,"content":"将他作为新的希望，保存到你的特质药水里。","style":2,"background":1007,"log_type":1,"src_id":260302121,"trial_step":121},{"step":129,"content":"安没有说话，抿了抿嘴唇，低头避开了你的视线。","style":3,"background":1007,"log_type":1,"src_id":260302122,"trial_step":122},{"step":130,"content":"看来她已经做出了新的选择。真的要放走这个孩子吗？哪怕需要背负渎职的问责。","style":3,"background":1007,"log_type":1,"src_id":260302123,"trial_step":123,"next":[124]},{"step":131,"content":"你没有办法保证他永远不会伤人。","style":2,"background":1007,"log_type":1,"src_id":260302125,"trial_step":125},{"step":132,"speaker":"安","content":"局长，您这次让我出来，不就是为了让我做出选择吗？为什么……","style":1,"background":1007,"log_type":1,"src_id":260302126,"trial_step":126},{"step":133,"content":"唯独这个不行。","style":2,"background":1007,"log_type":1,"src_id":260302127,"trial_step":127},{"step":134,"content":"你正要上前发动攻击，却突然感觉后颈被扎了一针——","style":3,"background":1007,"log_type":1,"src_id":260302128,"trial_step":128},{"step":135,"content":"你！……","style":2,"background":10000,"log_type":1,"src_id":260302129,"trial_step":129},{"step":136,"content":"两眼一黑，你落进了安的怀中。","style":3,"background":10000,"log_type":1,"src_id":260302130,"trial_step":130},{"step":137,"speaker":"安","content":"局长，我不会逃走的，但……抱歉，这孩子还想再看看这个世界。","style":1,"background":10000,"log_type":1,"src_id":260302131,"trial_step":131},{"step":138,"content":"意识模糊间，你听到了安对男孩最后的嘱托。","style":3,"background":10000,"log_type":1,"src_id":260302132,"trial_step":132},{"step":139,"speaker":"安","content":"千万别被危机管理局抓住，去锈河，跑得远远的。","style":1,"background":10000,"log_type":1,"src_id":260302133,"trial_step":133},{"step":140,"speaker":"安","content":"最后一个月，祝你好运，但愿我们……不会再见了……","style":1,"background":10000,"log_type":1,"src_id":260302134,"trial_step":134},{"step":141,"content":"我们回MBCC吧，安，今天什么都没有发生。","style":2,"background":1007,"log_type":1,"src_id":260302137,"trial_step":137},{"step":142,"speaker":"安","content":"您会被怪罪的……","style":1,"background":1007,"log_type":1,"src_id":260302138,"trial_step":138},{"step":143,"content":"我知道。","style":2,"background":1007,"log_type":1,"src_id":260302139,"trial_step":139},{"step":144,"speaker":"安","content":"我不会连累您的。","style":1,"background":1007,"log_type":1,"src_id":260302140,"trial_step":140},{"step":145,"content":"安从口袋里拿出一支注射剂。","style":3,"background":1007,"log_type":1,"src_id":260302141,"trial_step":141},{"step":146,"speaker":"安","content":"这是麻醉药，我不会对您造成伤害，也不会逃走。","style":1,"background":1007,"log_type":1,"src_id":260302142,"trial_step":142},{"step":147,"content":"你会带着昏迷的我回到MBCC，然后把一切责任揽在自己身上。","style":2,"background":1007,"log_type":1,"src_id":260302143,"trial_step":143},{"step":148,"speaker":"安","content":"……这是我能想到最万全的办法。","style":1,"background":1007,"log_type":1,"src_id":260302144,"trial_step":144},{"step":149,"content":"她又想一个人承担一切。","style":3,"background":1007,"log_type":1,"src_id":260302145,"trial_step":145},{"step":150,"content":"你就没有想过我会同意放走他吗？","style":2,"background":1007,"log_type":1,"src_id":260302146,"trial_step":146},{"step":151,"speaker":"安","content":"消灭狂厄者是您的职责……","style":1,"background":1007,"log_type":1,"src_id":260302147,"trial_step":147},{"step":152,"content":"但那孩子还想再看看这个世界，这是他想要的“活着”。","style":2,"background":1007,"log_type":1,"src_id":260302148,"trial_step":148},{"step":153,"content":"安吃惊地看着你，手中的麻醉剂跌落到地上断成两截。","style":3,"background":1007,"log_type":1,"src_id":260302149,"trial_step":149},{"step":154,"content":"你希望自己面对狂厄，能做的不只是“坚持”而已，我也一样。","style":2,"background":1007,"log_type":1,"src_id":260302150,"trial_step":150},{"step":155,"options":["嘱咐这对男孩远离其他人"],"style":6,"background":1007,"log_type":1,"src_id":260302151,"trial_step":151,"course":3,"choices":[{"text":"嘱咐这对男孩远离其他人","goto":152}]},{"step":156,"content":"最后这一个月，你可以去锈河，但不要接近别的人类，也别和死役聚在一起，如果你伤人被FAC发现，我就真的没有办法救你了。","style":2,"background":1007,"log_type":1,"src_id":260302152,"trial_step":152},{"step":157,"speaker":"男孩","content":"嗯，知道了，谢了！","style":1,"background":1007,"log_type":1,"src_id":260302153,"trial_step":153},{"step":158,"content":"男孩挥了挥手里吃剩的棒棒糖，在你和安的目送下转身离开。","style":3,"background":1007,"log_type":1,"src_id":260302154,"trial_step":154},{"step":159,"speaker":"男孩","content":"我叫加里！记得有机会的话，替我去新城玩玩！","style":1,"background":1007,"log_type":1,"src_id":260302155,"trial_step":155}]}