1,"background":1007,"log_type":1,"src_id":260302054,"trial_step":54},{"step":62,"speaker":"安","content":"……","style":1,"background":1007,"log_type":1,"src_id":260302055,"trial_step":55},{"step":63,"options":["……"],"style":6,"background":1007,"log_type":1,"src_id":260302056,"trial_step":56,"course":3,"choices":[{"text":"……","goto":57}]},{"step":64,"speaker":"男孩","content":"你们怎么还赖着不走啊，天都要黑了。","style":1,"background":1007,"log_type":1,"src_id":260302057,"trial_step":57},{"step":65,"speaker":"安","content":"你没有别的需要我帮助的吗？","style":1,"background":1007,"log_type":1,"src_id":260302058,"trial_step":58},{"step":66,"speaker":"男孩","content":"别的？有啊，我想去新城看看。听说那里很繁华，不用担心吃喝，也不会变成狂厄者……","style":1,"background":1007,"log_type":1,"src_id":260302059,"trial_step":59},{"step":67,"speaker":"男孩","content":"啧，不过我这样肯定进不去了。","style":1,"background":1007,"log_type":1,"src_id":260302060,"trial_step":60},{"step":68,"speaker":"男孩","content":"我现在可能更适合去锈河冒险。","style":1,"background":1007,"log_type":1,"src_id":260302061,"trial_step":61},{"step":69,"speaker":"男孩","content":"在那里说不定能远远看一眼新城。","style":1,"background":1007,"log_type":1,"src_id":260302062,"trial_step":62},{"step":70,"speaker":"安","content":"真的……没有别的心愿了吗？","style":1,"background":1007,"log_type":1,"src_id":260302063,"trial_step":63},{"step":71,"content":"安没有继续说下去，但你知道她想问什么。","style":3,"background":1007,"log_type":1,"src_id":260302064,"trial_step":64},{"step":72,"options":["你不想活下去吗？"],"style":6,"background":1007,"log_type":1,"src_id":260302065,"trial_step":65,"course":3,"choices":[{"text":"你不想活下去吗？","goto":66}]},{"step":73,"speaker":"男孩","content":"废话，难不成我还想死？但我都已经这样了……","style":1,"background":1007,"log_type":1,"src_id":260302066,"trial_step":66},{"step":74,"speaker":"安","content":"万一呢！万一我们可以等到狂厄被治疗的那一天！","style":1,"background":1007,"log_type":1,"src_id":260302067,"trial_step":67},{"step":75,"speaker":"男孩","content":"那治好之后呢，我也是个怪物了吧？新城能放我进去吗？","style":1,"background":1007,"log_type":1,"src_id":260302068,"trial_step":68},{"step":76,"content":"男孩的语气异