{"id":403101501,"chapter_id":21000105,"scene_id":502,"steps":[{"step":1,"speaker":"派尔琪雅","content":"前面有障碍，注意躲避。","voice":["vo_event_403101501_3"],"voice_bank":"vo_event_31015","style":1,"background":2310106,"log_type":1},{"step":2,"content":"你及时偏移方向，朝舷窗外的派尔琪雅点点头。","style":3,"background":2310106,"log_type":1},{"step":3,"content":"受伤怪物的嚎叫愈发迫近，但你能做的并不多。除了相信派尔琪雅的指引，只剩下祈祷这艘受损的潜艇能在怪物追上之前带你们逃出生天。","style":3,"background":2310106,"log_type":1},{"step":4,"speaker":"派尔琪雅","content":"拉格纳他……怎么样了。","voice":["vo_event_403101501_7"],"voice_bank":"vo_event_31015","style":1,"background":2310106,"log_type":1},{"step":5,"speaker":"${PlayerName}","content":"很不好……他好像被什么东西控制了……","style":2,"background":2307,"log_type":1},{"step":6,"content":"他似乎陷入了某种可怕的噩梦，双目紧闭，表情时而惊恐，时而又露出瘆人的笑容，说着含糊不清的梦呓。","style":3,"background":2307,"log_type":1},{"step":7,"speaker":"派尔琪雅","content":"班彦医生会治好他的，一定……","voice":["vo_event_403101501_13"],"voice_bank":"vo_event_31015","style":1,"background":2307,"log_type":1},{"step":8,"speaker":"怪物","content":"——！！！","voice":["vo_event_403101501_15"],"voice_bank":"vo_event_31015","style":1,"background":2307,"log_type":1},{"step":9,"speaker":"${PlayerName}","content":"……我们先离开这里。","style":2,"background":2310106,"log_type":1},{"step":10,"speaker":"派尔琪雅","content":"嗯。","voice":["vo_event_403101501_17"],"voice_bank":"vo_event_31015","style":1,"background":2310106,"log_type":1}]}