{"id":4042,"chapter_id":4,"scene_id":404,"steps":[{"step":1,"speaker":"赫卡蒂","content":"前面就是出口。海拉，带局长出去，离远点。","voice":["vo_cgplot_4042001"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":2,"speaker":"海拉","content":"——！哼，好想法。${PlayerName}，快！","voice":["vo_cgplot_4042002"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":3,"content":"她拉过你的手，猛冲着把你拽出甬道。","style":3,"background":403,"log_type":1},{"step":4,"speaker":"海拉","content":"出来了。赫卡蒂，动手！","voice":["vo_cgplot_4042004"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":5,"content":"赫卡蒂踏出甬道的瞬间，转身放出梦魇，击碎甬道的上方。巨大的砂岩顷刻崩塌下来，封堵了出口。","style":3,"background":10000,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"……结束了。","voice":["vo_cgplot_4042007"],"voice_bank":"vo_cgplot_04","style":1,"background":10000,"log_type":1},{"step":8,"speaker":"海拉","content":"呼……太好了，我还怕它们能化成汁儿从缝里钻过来呢。那些家伙、还有这个地方都太邪门儿了。","voice":["vo_cgplot_4042008"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":9,"speaker":"赫卡蒂","content":"不要放松警惕，即使离开甬道也并不一定安全。","voice":["vo_cgplot_4042009"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":10,"speaker":"赫卡蒂","content":"局长，能感应到遗产大概的距离吗？","voice":["vo_cgplot_4042010"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":11,"content":"……不需要感应些什么了。甬道的尽头是一个开阔的深坑，你就站在断崖岸边，向下看去。","style":3,"background":402,"log_type":1},{"step":12,"content":"深坑直径近百米，唯一一条窄道成螺旋状向下盘转，连接着中央底部浮起的孤岛。","style":3,"background":402,"log_type":1},{"step":13,"content":"在孤岛的中央，静立着一个石坛，毫无生气，令人胆寒。","style":3,"background":405,"log_type":1}]}