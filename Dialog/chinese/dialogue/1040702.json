{"id":1040702,"chapter_id":1040702,"scene_id":1,"steps":[{"step":1,"speaker":"摩根&伊桑","content":"……","style":1,"background":2221,"log_type":1,"src_id":140702001,"trial_step":1},{"step":2,"content":"两人又一次探头，看向办公室中略显突兀的那张桌子——那里原本是毕安卡的工位，但现在已经变成了一张杂物桌。","style":3,"background":2221,"log_type":1,"src_id":140702002,"trial_step":2},{"step":3,"speaker":"伊桑","content":"……她后来有联系过你吗？","voice":["vo_trial_40702_1_3"],"voice_bank":"vo_bianca_trial","style":1,"background":2221,"log_type":1,"src_id":140702003,"trial_step":3},{"step":4,"speaker":"摩根","content":"没有。辞退通知来得突然，她桌上那堆苹果盲盒还是我给她收起来的。","voice":["vo_trial_40702_1_4"],"voice_bank":"vo_bianca_trial","style":1,"background":2221,"log_type":1,"src_id":140702004,"trial_step":4},{"step":5,"content":"两人对视一眼，又是叹气。","style":3,"background":2221,"log_type":1,"src_id":140702005,"trial_step":5},{"step":6,"speaker":"摩根","content":"往好处想想，就毕安卡那停不下来的性子，说不定再过两天，又能在哪篇报道上看到她了……","voice":["vo_trial_40702_1_6"],"voice_bank":"vo_bianca_trial","style":1,"background":2221,"log_type":1,"src_id":140702006,"trial_step":6},{"step":7,"speaker":"毕安卡","content":"哼哼～","voice":["vo_trial_40702_1_7"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702007,"trial_step":7},{"step":8,"speaker":"毕安卡","content":"我是一个小记者，曝光本领强~我要把那大坏蛋，全都抓个光～","voice":["vo_trial_40702_1_8"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702008,"trial_step":8},{"step":9,"options":["等等……","让我休息一下……"],"style":6,"background":1019,"log_type":1,"src_id":140702009,"trial_step":9,"course":3,"choices":[{"text":"等等……","goto":10},{"text":"让我休息一下……","goto":null}]},{"step":10,"content":"啊——！","style":3,"background":1019,"log_type":1,"src_id":140702010,"trial_step":10},{"step":11,"content":"随着你们接近目的地，你的体力也濒临极限。","style":3,"background":1019,"log_type":1,"src_id":140702011,"trial_step":11},{"step":12,"speaker":"毕安卡","content":"又累了？哎呀，好啦好啦，再坚持一下，马上就到了——新闻可不等人呐局长！","voice":["vo_trial_40702_1_12"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702012,"trial_step":12},{"step":13,"content":"你一边调整呼吸，一边观察毕安卡的状态：她仍是一副没心没肺的快乐样子，脚步轻快，甚至还有余力哼歌。","style":3,"background":1019,"log_type":1,"src_id":140702013,"trial_step":13},{"step":14,"options":["你还记得咱们的行动目标吧"],"style":6,"background":1019,"log_type":1,"src_id":140702014,"trial_step":14,"course":3,"choices":[{"text":"你还记得咱们的行动目标吧","goto":15}]},{"step":15,"speaker":"毕安卡","content":"“低调行动！不擅自使用能力！不脱离监视单独行动！”","voice":["vo_trial_40702_1_15"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702015,"trial_step":15},{"step":16,"speaker":"毕安卡","content":"偷偷潜入工厂，调查厂房内的黑暗真相，再将这份珍贵的情报带出来昭告天下——哇，听起来可真酷！","voice":["vo_trial_40702_1_16"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702016,"trial_step":16},{"step":17,"speaker":"毕安卡","content":"瞧，咱们到了，那就是被科恩藏起来的另一处工厂。","voice":["vo_trial_40702_1_17"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702017,"trial_step":17},{"step":18,"content":"你仰头查看远处的工厂。围墙高耸入云，几乎遮住里面所有的建筑，只能远远听到重型机器的运作声。","style":3,"background":1019,"log_type":1,"src_id":140702018,"trial_step":18},{"step":19,"content":"外面看不到明显的排污口，各处运输口也有警卫严格看守，整座工厂宛若一座不透风的堡垒。","style":3,"background":1019,"log_type":1,"src_id":140702019,"trial_step":19},{"step":20,"options":["你上次是怎么进去的？"],"style":6,"background":1019,"log_type":1,"src_id":140702020,"trial_step":20,"course":3,"choices":[{"text":"你上次是怎么进去的？","goto":21}]},{"step":21,"speaker":"毕安卡","content":"简单，看到那边了吗？喏，就在墙下，我上次偶然发现了一个小洞，刚好能够一个人钻过去——","voice":["vo_trial_40702_1_21"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702021,"trial_step":21},{"step":22,"options":["……","还有别的方法吗？"],"style":6,"background":1019,"log_type":1,"src_id":140702022,"trial_step":22,"course":3,"choices":[{"text":"……","goto":23},{"text":"还有别的方法吗？","goto":null}]},{"step":23,"speaker":"毕安卡","content":"怎么，不会生气了吧？开个玩笑嘛！堂堂新城第一记者毕安卡，当然有自己的特殊门路~","voice":["vo_trial_40702_1_23"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702023,"trial_step":23},{"step":24,"content":"比如？","style":2,"background":1019,"log_type":1,"src_id":140702024,"trial_step":24},{"step":25,"speaker":"毕安卡","content":"所谓最危险的地方就是最安全的地方，潜入也是同样的道理，只要利用好思维死角，就能轻松应敌!","voice":["vo_trial_40702_1_25"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702025,"trial_step":25},{"step":26,"speaker":"毕安卡","content":"咱们直接——从正门进！","voice":["vo_trial_40702_1_26"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702026,"trial_step":26},{"step":27,"content":"……","style":2,"background":922,"log_type":1,"src_id":140702027,"trial_step":27},{"step":28,"content":"这里空间狭小，本就不多的空余被不知道装着什么的箱子挤占，你和毕安卡只能挤在小小的缝隙间。","style":3,"background":922,"log_type":1,"src_id":140702028,"trial_step":28},{"step":29,"content":"不仅如此，空间还在以一种有节奏的频率震动着……没错，你们所处的“箱子”正在运输途中。","style":3,"background":922,"log_type":1,"src_id":140702029,"trial_step":29},{"step":30,"content":"……这就是你说的“走正门”？","style":2,"background":922,"log_type":1,"src_id":140702030,"trial_step":30},{"step":31,"speaker":"毕安卡","content":"嘿嘿……","voice":["vo_trial_40702_1_31"],"voice_bank":"vo_bianca_trial","style":1,"background":922,"log_type":1,"src_id":140702031,"trial_step":31},{"step":32,"speaker":"毕安卡","content":"人躲箱子里，箱子从门进……不也是走正门吗？","voice":["vo_trial_40702_1_32"],"voice_bank":"vo_bianca_trial","style":1,"background":922,"log_type":1,"src_id":140702032,"trial_step":32},{"step":33,"content":"震动停止，你听到叉车的声音，紧接着感受到瞬间的失重感。运输结束，你们的“箱子”落地了。","style":3,"background":922,"log_type":1,"src_id":140702033,"trial_step":33},{"step":34,"speaker":"略显疑惑的工人","content":"怎么感觉今天的货尤其沉啊，难道是换供应商了？","voice":["vo_trial_40702_1_34"],"voice_bank":"vo_bianca_trial","style":1,"background":922,"log_type":1,"src_id":140702034,"trial_step":34},{"step":35,"content":"声音突然靠近，似乎是其中一个人还想再次检查一遍箱子，却被另一个拦下。","style":3,"background":922,"log_type":1,"src_id":140702035,"trial_step":35},{"step":36,"speaker":"胆小怕事的工人","content":"差不多得了！赶紧搬完赶紧下班，我可不想在这破地方呆太久！","voice":["vo_trial_40702_1_36"],"voice_bank":"vo_bianca_trial","style":1,"background":922,"log_type":1,"src_id":140702036,"trial_step":36},{"step":37,"content":"两人匆匆离去，你努力将侧脸贴在箱壁上倾听，现在外面只剩下机械运作的杂音。","style":3,"background":922,"log_type":1,"src_id":140702037,"trial_step":37},{"step":38,"options":["外面的人已经走了"],"style":6,"background":922,"log_type":1,"src_id":140702038,"trial_step":38,"course":3,"choices":[{"text":"外面的人已经走了","goto":39}]},{"step":39,"content":"可以出去了。","style":2,"background":922,"log_type":1,"src_id":140702039,"trial_step":39},{"step":40,"speaker":"毕安卡","content":"好嘞，又到毕安卡出马了！离这个位置远点，顺便把耳朵捂上……没错没错，小心误伤。","voice":["vo_trial_40702_1_40"],"voice_bank":"vo_bianca_trial","style":1,"background":922,"log_type":1,"src_id":140702040,"trial_step":40},{"step":41,"content":"一片黑暗中，你看不到毕安卡的动作，只感觉她好像把什么东西抵在箱壁上。","style":3,"background":922,"log_type":1,"src_id":140702041,"trial_step":41},{"step":42,"content":"砰——！","style":3,"background":922,"log_type":1,"src_id":140702042,"trial_step":42},{"step":43,"speaker":"毕安卡","content":"——哈！潜入计划，完美成功！","voice":["vo_trial_40702_1_43"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702043,"trial_step":43},{"step":44,"content":"刚刚还完好无损的箱子被人从内而外暴力破开，你转头，看到毕安卡手中的凶器，正是她随身携带的摄像机。","style":3,"background":302,"log_type":1,"src_id":140702044,"trial_step":44},{"step":45,"content":"“不擅自使用能力”？","style":2,"background":302,"log_type":1,"src_id":140702045,"trial_step":45},{"step":46,"speaker":"毕安卡","content":"啊哈哈哈……又不是拍特工电影，不用那么繁琐，咱们特殊情况特殊处理，果然还是一炮轰上去最干脆利落嘛，静音又高效！","voice":["vo_trial_40702_1_46"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702046,"trial_step":46},{"step":47,"speaker":"毕安卡","content":"好局长，又生气了？生气也行，等调查完再说嘛。","voice":["vo_trial_40702_1_47"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702047,"trial_step":47},{"step":48,"content":"毕安卡先一步从箱子里爬出来，笑嘻嘻地把手伸给你。","style":1,"background":302,"log_type":1,"src_id":140702048,"trial_step":48},{"step":49,"options":["搭上毕安卡的手"],"style":6,"background":302,"log_type":1,"src_id":140702049,"trial_step":49,"course":3,"choices":[{"text":"搭上毕安卡的手","goto":50}]},{"step":50,"content":"行吧，等最后再一起算。刚刚动静不算小，趁着巡逻的保安过来前抓紧调查吧。","style":2,"background":302,"log_type":1,"src_id":140702050,"trial_step":50},{"step":51,"content":"巡逻人员半小时一轮回，留给你们的调查事件时间还算富裕，可以将疑点一一查清。","style":3,"background":302,"log_type":1,"src_id":140702051,"trial_step":51},{"step":52,"options":["开始调查"],"style":6,"background":302,"log_type":1,"src_id":140702052,"trial_step":52,"course":3,"choices":[{"text":"开始调查","goto":53}]},{"step":53,"content":"你环顾四周。这座废料处理厂的布置比你想象中更加简单，除了庞大的机床外就是角落成箱的货品。偌大的空间现在只有你和毕安卡两个人。","style":3,"background":302,"log_type":1,"src_id":140702053,"trial_step":53},{"step":54,"content":"厂房里没有值班的人。你暗自在心中盘算这里的人员布置，几乎大多数守卫都把守着门口，剩下几个则是来去匆匆、穿着极厚防护服的搬运人员。","style":3,"background":302,"log_type":1,"src_id":140702054,"trial_step":54},{"step":55,"content":"如你预想中那样，或许是距离锈河仍有一段距离，这里的狂厄浓度并不算高。防护等级肯定不至于需要穿那种厚度的防护服。","style":3,"background":302,"log_type":1,"src_id":140702055,"trial_step":55},{"step":56,"content":"而且他们并不愿在加工车间滞留，明明已经做了那么完备的防护，为什么？","style":2,"background":302,"log_type":1,"src_id":140702056,"trial_step":56},{"step":57,"content":"房间里肯定还藏着别的东西……毕安卡，我们去那边看看。","style":2,"background":302,"log_type":1,"src_id":140702057,"trial_step":57},{"step":58,"content":"毕安卡？","style":2,"background":302,"log_type":1,"src_id":140702058,"trial_step":58},{"step":59,"content":"你转头，正好看到毕安卡还蹲在刚刚的货箱边，举着摄像机拍着什么。","style":3,"background":302,"log_type":1,"src_id":140702059,"trial_step":59},{"step":60,"speaker":"毕安卡","content":"刚才躲进来的时候没仔细看，只是隐隐觉得哪里有反光，果然……","voice":["vo_trial_40702_1_60"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702060,"trial_step":60},{"step":61,"content":"毕安卡转过头，表情难得认真。","style":3,"background":302,"log_type":1,"src_id":140702061,"trial_step":61},{"step":62,"speaker":"毕安卡","content":"货箱里的东西，是<color=#fb9259>枪</color>啊。","voice":["vo_trial_40702_1_62"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702062,"trial_step":62},{"step":63,"options":["？！"],"style":6,"background":302,"log_type":1,"src_id":140702063,"trial_step":63,"course":3,"choices":[{"text":"？！","goto":64}]},{"step":64,"speaker":"毕安卡","content":"准确来说，应该是枪支半成品。凭借我那一丢丢浅薄的武器知识来看，似乎所有填弹的部分被改造过，使用的并非常规火药子弹。","voice":["vo_trial_40702_1_64"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702064,"trial_step":64},{"step":65,"speaker":"毕安卡","content":"……哈哈，原来如此，怪不得工厂要藏进这么危险的地方，要是被治安局发现了可够他们喝一壶的。","voice":["vo_trial_40702_1_65"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702065,"trial_step":65},{"step":66,"speaker":"毕安卡","content":"这哪里是废料处理厂啊？这根本就是个非法的武器加工厂！","voice":["vo_trial_40702_1_66"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702066,"trial_step":66},{"step":67,"speaker":"毕安卡","content":"但疑点还不止在这里！不明加工物，半成品武器，还有奇奇怪怪的选址……锈河的狂厄污染很浓，绝非一般武器倒卖商的最优选择。","voice":["vo_trial_40702_1_67"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702067,"trial_step":67},{"step":68,"options":["除非他们另有所图"],"style":6,"background":302,"log_type":1,"src_id":140702068,"trial_step":68,"course":3,"choices":[{"text":"除非他们另有所图","goto":69}]},{"step":69,"content":"他们需要锈河的东西？但这里除了狂厄就只剩下被污染的——","style":2,"background":302,"log_type":1,"src_id":140702069,"trial_step":69},{"step":70,"content":"你也停下了话头。毕安卡和你对视，眼睛越来越亮。","style":3,"background":302,"log_type":1,"src_id":140702070,"trial_step":70},{"step":71,"speaker":"毕安卡","content":"走！去看看流水线！证据一定就在那边！","voice":["vo_trial_40702_1_71"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702071,"trial_step":71},{"step":72,"content":"毕安卡一跃而起，拽着你一起溜到加工器械旁边。机器仍在运作，发出巨大的轰鸣声。无数半成品在这里被加工成真正的杀伤性武器。","style":3,"background":302,"log_type":1,"src_id":140702072,"trial_step":72},{"step":73,"content":"镜头记录下工厂的真相：枪支填弹区的玻璃管中，液体透出令人作呕的猩红色。是狂厄提取液。","style":3,"background":302,"log_type":1,"src_id":140702073,"trial_step":73},{"step":74,"speaker":"毕安卡","content":"……小灰灰，咱们可挖到宝了。","voice":["vo_trial_40702_1_74"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702074,"trial_step":74},{"step":75,"speaker":"毕安卡","content":"他们做的，是沾了狂厄的凶器啊。","voice":["vo_trial_40702_1_75"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702075,"trial_step":75},{"step":76,"speaker":"保安","content":"——喂！谁在那边！","voice":["vo_trial_40702_1_76"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702076,"trial_step":76},{"step":77,"content":"手电灯光猛地打向室内，保安一脸狐疑地走进车间。","style":3,"background":302,"log_type":1,"src_id":140702077,"trial_step":77},{"step":78,"speaker":"保安","content":"怪事情，刚刚好像听到有人说话的声儿，难道是我听错了？","voice":["vo_trial_40702_1_78"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702078,"trial_step":78},{"step":79,"content":"灯光在货箱与机床间扫动。在光照不到的地方，你与毕安卡侧身缩在机械的阴影中，动弹不得。","style":3,"background":302,"log_type":1,"src_id":140702079,"trial_step":79},{"step":80,"content":"保安仍在巡逻，你和毕安卡只能通过口型、手势与为数不多的默契来沟通。","style":3,"background":302,"log_type":1,"src_id":140702080,"trial_step":80},{"step":81,"speaker":"毕安卡","content":"（有人来了！！怎么办！！！）","voice":["vo_trial_40702_1_81"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702081,"trial_step":81},{"step":82,"content":"脚步声离你们越来越近，很快光线就会扫到你们的藏身之处。","style":3,"background":302,"log_type":1,"src_id":140702082,"trial_step":82},{"step":83,"content":"（没有退路了，这次调查不成功就会打草惊蛇。）","style":2,"background":302,"log_type":1,"src_id":140702083,"trial_step":83},{"step":84,"content":"（必须把证据带出去。）","style":2,"background":302,"log_type":1,"src_id":140702084,"trial_step":84},{"step":85,"speaker":"毕安卡","content":"（必须……必须什么？出去？现在跑吗？)","voice":["vo_trial_40702_1_85"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702085,"trial_step":85},{"step":86,"content":"（证、据、带、出、去。）","style":2,"background":302,"log_type":1,"src_id":140702086,"trial_step":86},{"step":87,"speaker":"毕安卡","content":"（现在就出去？没问题！倒数三秒就开跑，三、二——）","voice":["vo_trial_40702_1_87"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702087,"trial_step":87},{"step":88,"content":"（喂毕安卡等一下！）","style":2,"background":302,"log_type":1,"src_id":140702088,"trial_step":88},{"step":89,"speaker":"毕安卡","content":"一！要逃跑啦！","voice":["vo_trial_40702_1_89"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702089,"trial_step":89},{"step":90,"content":"毕安卡抓着你从死角处猛地冲出来，趁保镖反应过来前飞奔向出口。","style":3,"background":302,"log_type":1,"src_id":140702090,"trial_step":90},{"step":91,"speaker":"保安","content":"？！什么玩意儿！有入侵者！！大门，关大门！！","voice":["vo_trial_40702_1_91"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702091,"trial_step":91},{"step":92,"content":"铁质大门在你们面前缓缓合拢。你们跑得够快，但也难在大门彻底关闭前逃出生天。","style":3,"background":302,"log_type":1,"src_id":140702092,"trial_step":92},{"step":93,"options":["毕安卡，轰开它！"],"style":6,"background":302,"log_type":1,"src_id":140702093,"trial_step":93,"course":3,"choices":[{"text":"毕安卡，轰开它！","goto":94}]},{"step":94,"speaker":"毕安卡","content":"这次不算违规了？","voice":["vo_trial_40702_1_94"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702094,"trial_step":94},{"step":95,"content":"特殊情况特殊处理！瞄准大门，发射！","style":2,"background":302,"log_type":1,"src_id":140702095,"trial_step":95},{"step":96,"speaker":"毕安卡","content":"嘿嘿，得令！","voice":["vo_trial_40702_1_96"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702096,"trial_step":96},{"step":97,"speaker":"毕安卡","content":"来吧，挡路的家伙们！看镜头，茄——子——","voice":["vo_trial_40702_1_97"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702097,"trial_step":97},{"step":98,"content":"你视野外的某处闪动了一下，紧接着一束强光猛然发射，轰出一条逃往外界的生路。","style":3,"background":302,"log_type":1,"src_id":140702098,"trial_step":98},{"step":99,"content":"你与毕安卡一路狂奔，甩脱追兵后马不停蹄回到城区，找了个地方开始发帖曝光真相。","style":3,"background":1048,"log_type":1,"src_id":140702099,"trial_step":99},{"step":100,"content":"<b>【持续曝光！新城狂厄来源，科恩集团工厂内视频流出……！24h内删除！】</b>\n发帖人：特浓苹果汁2.0\n浏览量：2w+ 评论：1086","style":10,"background":1048,"log_type":1,"src_id":140702100,"trial_step":100},{"step":101,"content":"毕安卡沉浸在网络中，仿佛不仅是发送一条回帖，而是在与全狄斯的黑暗宣战。","style":3,"background":1048,"log_type":1,"src_id":140702101,"trial_step":101},{"step":102,"speaker":"毕安卡","content":"热度还在攀升，现在全狄斯的论坛上都在讨论这件事！等再发酵一段时间就可以让其他媒体一起下场，发个官方通告彻底锤死！","voice":["vo_trial_40702_1_102"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702102,"trial_step":102},{"step":103,"speaker":"毕安卡","content":"嘿嘿，能想出这么完美的计划，不愧是全MBCC最厉害的记者毕安卡～","voice":["vo_trial_40702_1_103"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702103,"trial_step":103},{"step":104,"options":["递苹果汁"],"style":6,"background":1048,"log_type":1,"src_id":140702104,"trial_step":104,"course":3,"choices":[{"text":"递苹果汁","goto":105}]},{"step":105,"content":"冰镇铝罐突然贴上侧脸，吓得毕安卡一个激灵。","style":3,"background":1048,"log_type":1,"src_id":140702105,"trial_step":105},{"step":106,"speaker":"毕安卡","content":"啊啊啊啊什么东西那么冰难道是金属我我我我这辈子就做过一次那么祸害别人的事情局长我罪不至此啊——","voice":["vo_trial_40702_1_106"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702106,"trial_step":106},{"step":107,"speaker":"毕安卡","content":"咦？什么嘛，原来只是苹果汁啊。","voice":["vo_trial_40702_1_107"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702107,"trial_step":107},{"step":108,"content":"“只是”苹果汁就把你吓成这样。","style":2,"background":1048,"log_type":1,"src_id":140702108,"trial_step":108},{"step":109,"content":"毕安卡笑嘻嘻地接过你递来的苹果汁，扯开拉环，高举着罐子与你碰杯。","style":3,"background":1048,"log_type":1,"src_id":140702109,"trial_step":109},{"step":110,"speaker":"毕安卡","content":"那么，为了庆祝正义一方的伟大胜利，以及那些即将被彻底曝光的混球恶棍们——干杯！","voice":["vo_trial_40702_1_110"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702110,"trial_step":110},{"step":111,"options":["干杯"],"style":6,"background":1048,"log_type":1,"src_id":140702111,"trial_step":111,"course":3,"choices":[{"text":"干杯","goto":112}]},{"step":112,"content":"呛鼻的气泡涌上来，带来熟悉的灼烧感。你不再像之前那样狼狈，一口接一口慢慢喝着。","style":3,"background":1048,"log_type":1,"src_id":140702112,"trial_step":112},{"step":113,"content":"你们坐在MBCC的最高处，正好能俯视远处的新城。灯光所及之处光鲜亮丽，也衬得阴影更加浓重。","style":3,"background":1048,"log_type":1,"src_id":140702113,"trial_step":113},{"step":114,"speaker":"毕安卡","content":"呜呜呜……果、果然，苹果汁才是真理的化身、永恒不变的至宝、所有新闻工作者的守护神……","voice":["vo_trial_40702_1_114"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702114,"trial_step":114},{"step":115,"speaker":"毕安卡","content":"哎……可惜毕安卡真正想要的东西，无论是灰镜还是苹果汁之神都解决不了呀……","voice":["vo_trial_40702_1_115"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702115,"trial_step":115},{"step":116,"content":"毕安卡抱腿缩在你边上，垂头丧气嘀嘀咕咕，比起传奇记者更像个耍赖的小孩儿。","style":3,"background":1048,"log_type":1,"src_id":140702116,"trial_step":116},{"step":117,"content":"若是想打探毕安卡的真心话，现在或许是个不错的时机。","style":3,"background":1048,"log_type":1,"src_id":140702117,"trial_step":117},{"step":118,"options":["毕安卡，你想要什么？"],"style":6,"background":1048,"log_type":1,"src_id":140702118,"trial_step":118,"course":3,"choices":[{"text":"毕安卡，你想要什么？","goto":119}]},{"step":119,"speaker":"毕安卡","content":"我想要的东西？哼哼……那可多了去了……","voice":["vo_trial_40702_1_119"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702119,"trial_step":119},{"step":120,"speaker":"毕安卡","content":"我想喝便利店出的新口味苹果汁，想买新城刚出的最新款苹果系列盲盒……想不用天天苦哈哈跑采访，线索就能直接跳到手里……","voice":["vo_trial_40702_1_120"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702120,"trial_step":120},{"step":121,"speaker":"毕安卡","content":"想要所有事情都像我想得那么顺利，想要把坏蛋们都抓出来，想看他们被正义的苹果战士制裁……","voice":["vo_trial_40702_1_121"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702121,"trial_step":121},{"step":122,"speaker":"毕安卡","content":"不想再眼睁睁看着报道发出去，却没人在乎，没人关注……","voice":["vo_trial_40702_1_122"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702122,"trial_step":122},{"step":123,"speaker":"毕安卡","content":"还有……","voice":["vo_trial_40702_1_123"],"voice_bank":"vo_bianca_trial","style":1,"background":1048,"log_type":1,"src_id":140702123,"trial_step":123},{"step":124,"content":"毕安卡的声音越来越低，你几乎听不见她在说什么。以为她又睡着了，转头查看却发现毕安卡正直直盯着手边的电脑，表情严肃，看不见一丝醉态。","style":3,"background":1048,"log_type":1,"src_id":140702124,"trial_step":124},{"step":125,"options":["怎么了？"],"style":6,"background":1048,"log_type":1,"src_id":140702125,"trial_step":125,"course":3,"choices":[{"text":"怎么了？","goto":126}]},{"step":126,"content":"毕安卡没有动。你不得不靠过去，看向她的屏幕。","style":3,"background":1048,"log_type":1,"src_id":140702126,"trial_step":126},{"step":127,"content":"那是一条来自论坛的官方私信。","style":3,"background":1048,"log_type":1,"src_id":140702127,"trial_step":127},{"step":128,"content":"由于用户<color=#fb9259>特浓苹果汁2.0</color>在论坛中宣传不实言论，相关讨论已造成大规模不良影响。经多户举报后，本站点决定删除该账号下所有回贴、论坛中所有相关的讨论内容，并另对用户进行禁言处罚。\n\n<b>特此，对用户<color=#fb9259>特浓苹果汁2.0</color>处以永久封禁。该处置即刻生效，不可申诉解封。</b>","style":10,"background":1048,"log_type":1,"src_id":140702128,"trial_step":128}]}