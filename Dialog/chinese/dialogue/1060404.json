{"id":1060404,"chapter_id":1060404,"scene_id":1,"steps":[{"step":1,"speaker":"可可莉克","content":"要和他说些什么好呢……","female_content":"要和她说些什么好呢……","voice":["vo_trial_60404_1_1","vo_trial_60404_1_1f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":107,"log_type":1,"src_id":160404001,"trial_step":1},{"step":2,"speaker":"可可莉克","content":"“多亏了你啊，给我续了一口气。”","voice":["vo_trial_60404_1_2"],"voice_bank":"vo_coquelicot_trial","style":1,"background":107,"log_type":1,"src_id":160404002,"trial_step":2},{"step":3,"speaker":"可可莉克","content":"不行，有点粗俗，不符合我们花园的格调。","voice":["vo_trial_60404_1_3"],"voice_bank":"vo_coquelicot_trial","style":1,"background":107,"log_type":1,"src_id":160404003,"trial_step":3},{"step":4,"speaker":"可可莉克","content":"“我会记下你的恩情，未来就一起好好相处吧~”","voice":["vo_trial_60404_1_4"],"voice_bank":"vo_coquelicot_trial","style":1,"background":107,"log_type":1,"src_id":160404004,"trial_step":4},{"step":5,"speaker":"可可莉克","content":"这听上去未免也太不客气了……咳……咳咳呼……","voice":["vo_trial_60404_1_5"],"voice_bank":"vo_coquelicot_trial","style":1,"background":107,"log_type":1,"src_id":160404005,"trial_step":5},{"step":6,"content":"可可莉克已经在办公室外踟蹰了很久，虚弱的身体甚至已经感受到疲惫，但她还是没有想好要对你说些什么。","style":3,"background":107,"log_type":1,"src_id":160404006,"trial_step":6},{"step":7,"speaker":"可可莉克","content":"所以，还是失败了吗？","voice":["vo_trial_60404_1_8"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404008,"trial_step":8},{"step":8,"speaker":"堇","content":"对……局长试图用枷锁吸收您体内的全部狂厄，但收效甚微。","voice":["vo_trial_60404_1_9"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404009,"trial_step":9},{"step":9,"speaker":"堇","content":"MBCC几乎动用了全部医疗力量，也只是将您从鬼门关拉了回来。","voice":["vo_trial_60404_1_10"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404010,"trial_step":10},{"step":10,"speaker":"堇","content":"狂厄对您的下一次蚕食，不知道还会在什么时候发生。","voice":["vo_trial_60404_1_11"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404011,"trial_step":11},{"step":11,"speaker":"可可莉克","content":"命悬一线，说的应该就是我现在的状态了吧？","voice":["vo_trial_60404_1_12"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404012,"trial_step":12},{"step":12,"content":"可可莉克看着自己的掌心还是有些恍惚，枷锁的红光已经暂时压制住了狂厄的黑气。","style":3,"background":2106,"log_type":1,"src_id":160404013,"trial_step":13},{"step":13,"content":"她任由堇为自己梳理碎发，怔怔地望着头顶病房的天花板，许久才缓过神来。","style":3,"background":2106,"log_type":1,"src_id":160404014,"trial_step":14},{"step":14,"speaker":"可可莉克","content":"那家伙呢？在上演什么做好事不留名的苦情戏码吗？","voice":["vo_trial_60404_1_15"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404015,"trial_step":15},{"step":15,"speaker":"堇","content":"您是说局长？他……","female_content":"您是说局长？她……","voice":["vo_trial_60404_1_16","vo_trial_60404_1_16f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404016,"trial_step":16},{"step":16,"content":"堇移开了视线，但可可莉克还是第一时间注意到了，堇试图藏在身后的文件夹。","voice":["vo_trial_60404_1_17"],"voice_bank":"vo_coquelicot_trial","style":3,"background":2106,"log_type":1,"src_id":160404017,"trial_step":17},{"step":17,"speaker":"可可莉克","content":"拿出来吧，想骗过我你还不够水准呢。","voice":["vo_trial_60404_1_18"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404018,"trial_step":18},{"step":18,"content":"那是一本印着MBCC钢印的文件夹，里面夹着一张来自米诺斯危机管理局局长的重要工作报告。","style":3,"background":2106,"log_type":1,"src_id":160404019,"trial_step":19},{"step":19,"content":"113年x月xx日\n　　MBCC在辛迪加发现禁闭者踪迹，经追踪，确认为狂厄级禁闭者可可莉克。\n　　根据审问调查，花园全体受地底势力胁迫，被迫参与八月袭击行动。\n　　其中除业师可可莉克外，其余禁闭者均在与FAC的交战中阵亡，花园确认覆灭。","style":10,"background":2106,"log_type":1,"src_id":160404020,"trial_step":20},{"step":20,"speaker":"可可莉克","content":"可那十几个孩子逃走的时候，他明明在场……","female_content":"可那十几个孩子逃走的时候，她明明在场……","voice":["vo_trial_60404_1_21","vo_trial_60404_1_21f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404021,"trial_step":21},{"step":21,"content":"她好像意识到了什么，突然合上了文件。","style":3,"background":2106,"log_type":1,"src_id":160404022,"trial_step":22},{"step":22,"speaker":"可可莉克","content":"堇，这份报告，是交给第九机关的吧？","voice":["vo_trial_60404_1_23"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404023,"trial_step":23},{"step":23,"speaker":"堇","content":"好像是的？是有什么问题吗？","voice":["vo_trial_60404_1_24"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404024,"trial_step":24},{"step":24,"speaker":"可可莉克","content":"不，没有问题，甚至一切都如我所愿……看来他已经不需要我给出的答案了。","female_content":"不，没有问题，甚至一切都如我所愿……看来她已经不需要我给出的答案了。","voice":["vo_trial_60404_1_25","vo_trial_60404_1_25f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404025,"trial_step":25},{"step":25,"speaker":"可可莉克","content":"哈……堇，你选中的这个人，还真是有趣。","voice":["vo_trial_60404_1_26"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404026,"trial_step":26},{"step":26,"speaker":"堇","content":"堇愚笨，没有明白业师的意思。","voice":["vo_trial_60404_1_27"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404027,"trial_step":27},{"step":27,"speaker":"可可莉克","content":"${PlayerName}——","voice":["vo_trial_60404_1_28"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404028,"trial_step":28},{"step":28,"content":"她将手里文件夹递还。","style":3,"background":2106,"log_type":1,"src_id":160404029,"trial_step":29},{"step":29,"speaker":"可可莉克","content":"他没你想的那么纯良，却也不是我以为的那么不可信任。","female_content":"她没你想的那么纯良，却也不是我以为的那么不可信任。","voice":["vo_trial_60404_1_30","vo_trial_60404_1_30f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404030,"trial_step":30},{"step":30,"speaker":"可可莉克","content":"他帮了我大忙，却在向上提交之前，故意让我看了这份报告。","female_content":"她帮了我大忙，却在向上提交之前，故意让我看了这份报告。","voice":["vo_trial_60404_1_31","vo_trial_60404_1_31f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404031,"trial_step":31},{"step":31,"speaker":"可可莉克","content":"这下……我不得不去找他聊聊了。","female_content":"这下……我不得不去找她聊聊了。","voice":["vo_trial_60404_1_32","vo_trial_60404_1_32f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404032,"trial_step":32},{"step":32,"content":"可可莉克艰难地翻下病床，堇想要上前帮忙，却被她抬手拒绝了。","style":3,"background":2106,"log_type":1,"src_id":160404033,"trial_step":33},{"step":33,"speaker":"可可莉克","content":"不用了，这场谈话，只有我和他参与就够了。","female_content":"不用了，这场谈话，只有我和她参与就够了。","voice":["vo_trial_60404_1_34","vo_trial_60404_1_34f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404034,"trial_step":34},{"step":34,"speaker":"可可莉克","content":"呼……还真是小瞧这家伙了，承受了这么多狂厄，还有力气写这些废话……也不知道来看望一下本业师。","voice":["vo_trial_60404_1_35"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404035,"trial_step":35},{"step":35,"content":"可可莉克自顾自向病房外走，脚步还有些虚浮，絮絮叨叨地埋怨着，才注意到堇一直神色嗫喏地留在病床旁。","style":3,"background":2106,"log_type":1,"src_id":160404036,"trial_step":36},{"step":36,"speaker":"可可莉克","content":"你怎么了？从刚才起就一直躲躲闪闪的。","voice":["vo_trial_60404_1_37"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404037,"trial_step":37},{"step":37,"speaker":"堇","content":"这份报告……是局长在决定用枷锁救您前就准备好了的。","voice":["vo_trial_60404_1_38"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404038,"trial_step":38},{"step":38,"speaker":"堇","content":"局长说，如果自己第一时间没有醒来，就把这个交给您，让您先放心。","voice":["vo_trial_60404_1_39"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404039,"trial_step":39},{"step":39,"speaker":"堇","content":"局长听说了您的过去，了解您最讨厌的就是“自我牺牲”，让我别把他的状况告诉你。","female_content":"局长听说了您的过去，了解您最讨厌的就是“自我牺牲”，让我别把她的状况告诉你。","voice":["vo_trial_60404_1_40","vo_trial_60404_1_40f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404040,"trial_step":40},{"step":40,"speaker":"堇","content":"可……我知道，我瞒不住您。","voice":["vo_trial_60404_1_41"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404041,"trial_step":41},{"step":41,"speaker":"可可莉克","content":"还有呢？","voice":["vo_trial_60404_1_42"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404042,"trial_step":42},{"step":42,"content":"可可莉克似乎已经猜到了答案，但还是不受控制地问了下去。","style":3,"background":2106,"log_type":1,"src_id":160404043,"trial_step":43},{"step":43,"speaker":"堇","content":"还有……他希望您能相信，枷锁不是束缚，禁闭者对MBCC而言也不是拿来利用的棋子。","female_content":"还有……她希望您能相信，枷锁不是束缚，禁闭者对MBCC而言也不是拿来利用的棋子。","voice":["vo_trial_60404_1_44","vo_trial_60404_1_44f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404044,"trial_step":44},{"step":44,"speaker":"堇","content":"他对禁闭者，就像您对花园。","female_content":"她对禁闭者，就像您对花园。","voice":["vo_trial_60404_1_45","vo_trial_60404_1_45f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404045,"trial_step":45},{"step":45,"content":"中间堇似乎又说了些什么，但可可莉克已经没有注意了。","style":3,"background":2106,"log_type":1,"src_id":160404046,"trial_step":46},{"step":46,"speaker":"可可莉克","content":"他现在，人在哪？","female_content":"她现在，人在哪？","voice":["vo_trial_60404_1_47","vo_trial_60404_1_47f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404047,"trial_step":47},{"step":47,"speaker":"堇","content":"副官小姐说局长现在的情况稍有好转，刚从加强监护病房转出，不接受探望。","voice":["vo_trial_60404_1_48"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404048,"trial_step":48},{"step":48,"speaker":"堇","content":"局长正在自己的休息室。现在的状态应该已经可以说话进食了。","voice":["vo_trial_60404_1_49"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2106,"log_type":1,"src_id":160404049,"trial_step":49},{"step":49,"content":"堇恭顺地说完抬头，眼前却早就没有了可可莉克的踪影。","style":3,"background":2106,"log_type":1,"src_id":160404050,"trial_step":50},{"step":50,"speaker":"可可莉克","content":"该说些什么……","voice":["vo_trial_60404_1_52"],"voice_bank":"vo_coquelicot_trial","style":1,"background":107,"log_type":1,"src_id":160404052,"trial_step":52},{"step":51,"content":"<color=#7683a2><i>谢谢你看穿了我的弱点？看穿了连我自己都不敢承认的私心？</i></color>","voice":["vo_trial_60404_1_53"],"voice_bank":"vo_coquelicot_trial","style":3,"background":107,"log_type":1,"src_id":160404053,"trial_step":53},{"step":52,"content":"<color=#7683a2><i>还是……责备他，像那些孩子似的，保护不了自己。</i></color>","female_content":"<color=#7683a2><i>还是……责备她，像那些孩子似的，保护不了自己。</i></color>","voice":["vo_trial_60404_1_54","vo_trial_60404_1_54f"],"voice_bank":"vo_coquelicot_trial","style":3,"background":107,"log_type":1,"src_id":160404054,"trial_step":54},{"step":53,"content":"可可莉克一直没有想好如何开口。当她见到局长的一瞬间，“嗡”的一声，好像有什么状况外的共鸣冲击了可可莉克的大脑。","style":3,"background":1014,"log_type":1,"src_id":160404055,"trial_step":55},{"step":54,"content":"伤口、淤青、污染的残留，遍布了眼前这个人的全身。它们之中，有因为锈火留下的，也有替可可莉克分担狂厄时新添的。","style":3,"background":1014,"log_type":1,"src_id":160404056,"trial_step":56},{"step":55,"content":"她就这样静静审视你身上的每一道伤口，在这个不大的空间内，和你保持着微妙的距离。","style":3,"background":1014,"log_type":1,"src_id":160404057,"trial_step":57},{"step":56,"content":"她似乎越过了这段距离，看见了很多人……","style":3,"background":1014,"log_type":1,"src_id":160404058,"trial_step":58},{"step":57,"content":"不说些什么吗?","style":2,"background":1014,"log_type":1,"src_id":160404060,"trial_step":60},{"step":58,"content":"你来这儿，应该也不是特意来参观我的伤口的吧？","style":2,"background":1014,"log_type":1,"src_id":160404061,"trial_step":61},{"step":59,"content":"“别担心，我身体里分担的东西多了去了，不差这一个”——你很想这么说，但还是忍住了。","style":3,"background":1014,"log_type":1,"src_id":160404062,"trial_step":62},{"step":60,"speaker":"可可莉克","content":"少自作多情了，我像是那种会关心你伤势的人吗？","voice":["vo_trial_60404_1_63"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1014,"log_type":1,"src_id":160404063,"trial_step":63},{"step":61,"speaker":"局长","content":"嗯，说不定呢？你其实没有那么残忍，对吧。","style":2,"background":1014,"log_type":1,"src_id":160404064,"trial_step":64},{"step":62,"speaker":"局长","content":"知道堇和昙是怎么评价你的吗？","style":2,"background":1014,"log_type":1,"src_id":160404065,"trial_step":65},{"step":63,"speaker":"局长","content":"嘴上很挑剔，甚至还有些颐指气使，但比任何一个人都更爱花园。","style":2,"background":1014,"log_type":1,"src_id":160404066,"trial_step":66},{"step":64,"speaker":"局长","content":"一旦有任何花园杀手遭遇危险，你都会骂骂咧咧地，加倍替她们讨回公道。","style":2,"background":1014,"log_type":1,"src_id":160404067,"trial_step":67},{"step":65,"speaker":"可可莉克","content":"……","style":1,"background":1014,"log_type":1,"src_id":160404068,"trial_step":68},{"step":66,"speaker":"局长","content":"你确实手段偏激，目中无人。但不得不承认……","style":2,"background":1014,"log_type":1,"src_id":160404069,"trial_step":69},{"step":67,"speaker":"局长","content":"你是个很好的业师。","style":2,"background":1014,"log_type":1,"src_id":160404070,"trial_step":70},{"step":68,"speaker":"可可莉克","content":"啧，你这像是夸人的话吗！","voice":["vo_trial_60404_1_71"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1014,"log_type":1,"src_id":160404071,"trial_step":71},{"step":69,"content":"她语气嗔怪，脸上却挂着释然的笑意。","style":3,"background":1014,"log_type":1,"src_id":160404072,"trial_step":72},{"step":70,"content":"<color=#7683a2><i>或许我知道， 该说些什么了</i></color>","voice":["vo_trial_60404_1_73"],"voice_bank":"vo_coquelicot_trial","style":3,"background":1014,"log_type":1,"src_id":160404073,"trial_step":73},{"step":71,"speaker":"可可莉克","content":"鲜花盛放后总会凋零的，这没什么。我来，只是想问问你——","voice":["vo_trial_60404_1_74"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1014,"log_type":1,"src_id":160404074,"trial_step":74},{"step":72,"speaker":"可可莉克","content":"你留给我的最后这口气，还够我挥霍多久? 一年，一个月，还是.....","voice":["vo_trial_60404_1_75"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1014,"log_type":1,"src_id":160404075,"trial_step":75},{"step":73,"speaker":"局长","content":"不能保证，但MBCC会尽力。","style":2,"background":1014,"log_type":1,"src_id":160404076,"trial_step":76},{"step":74,"speaker":