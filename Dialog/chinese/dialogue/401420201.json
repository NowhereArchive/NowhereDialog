{"id":401420201,"chapter_id":50050,"scene_id":55022,"steps":[{"step":1,"speaker":"伊芙","content":"你是谁家的小狗啊，为什么在这里？","voice":["vo_event_401420201_1"],"voice_bank":"vo_event_14202","style":1,"background":10006,"log_type":1},{"step":2,"speaker":"小狗","content":"呜呜……","voice":["vo_event_401420201_2"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":3,"speaker":"伊芙","content":"还挂着项圈……应该有自己的主人吧？你的主人呢？","voice":["vo_event_401420201_3"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":4,"speaker":"小狗","content":"唔……","voice":["vo_event_401420201_4"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":5,"speaker":"伊芙","content":"这样啊……他们把你丢到这儿了。","voice":["vo_event_401420201_5"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":6,"speaker":"伊芙","content":"那你愿意来我这里吗？","voice":["vo_event_401420201_6"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":7,"speaker":"小狗","content":"汪！","voice":["vo_event_401420201_7"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":8,"speaker":"伊芙","content":"真的能听懂！好聪明的小狗……","voice":["vo_event_401420201_8"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":9,"speaker":"伊芙","content":"看你瘦得皮包骨头的……叫你骨头，怎么样？","voice":["vo_event_401420201_9"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":10,"speaker":"骨头","content":"汪汪！","voice":["vo_event_401420201_10"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":11,"speaker":"伊芙","content":"我不知道你真正的生日，把捡到你的今天当做你的生日，可以吗？","voice":["vo_event_401420201_11"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":12,"speaker":"骨头","content":"汪汪呜——！","voice":["vo_event_401420201_12"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":13,"speaker":"伊芙","content":"好~那先让马蕾莎带你去洗个澡吧，再让宝莉给你做漂亮的新衣服。","voice":["vo_event_401420201_13"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":14,"speaker":"伊芙","content":"以后，骨头就是干净健康的小狗，是玩具厂的一员了，是我们的家人。","voice":["vo_event_401420201_14"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":15,"speaker":"伊芙","content":"让巴斯给你找点好吃的，本纳带着你去散步，好不好？","voice":["vo_event_401420201_15"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":16,"speaker":"骨头","content":"汪唔……","voice":["vo_event_401420201_16"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":17,"speaker":"伊芙","content":"怎么又不开心？","voice":["vo_event_401420201_17"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":18,"speaker":"伊芙","content":"我？我没法带你去散步……","voice":["vo_event_401420201_18"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":19,"speaker":"伊芙","content":"你也看到了，我必须有轮椅才行。","voice":["vo_event_401420201_19"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":20,"speaker":"伊芙","content":"也给骨头装个轮子，我们就可以一起了？","voice":["vo_event_401420201_20"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":21,"speaker":"骨头","content":"汪！","voice":["vo_event_401420201_21"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":22,"speaker":"伊芙","content":"笨蛋，逗你的，轮子有什么好的。我才羡慕你呢……","voice":["vo_event_401420201_22"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":23,"speaker":"伊芙","content":"我试了好几次，还是没有站起来，还给爸爸妈妈添了很多麻烦……","voice":["vo_event_401420201_23"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":24,"speaker":"伊芙","content":"骨头……","voice":["vo_event_401420201_24"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":25,"speaker":"骨头","content":"唔？","voice":["vo_event_401420201_25"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":26,"speaker":"伊芙","content":"我……我也想带你散步。我想……再站起来试试。","voice":["vo_event_401420201_26"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":27,"speaker":"骨头","content":"汪！汪汪！汪汪汪汪汪汪！","voice":["vo_event_401420201_27"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1},{"step":28,"speaker":"伊芙","content":"哈哈哈，好啦好啦，好多口水。","voice":["vo_event_401420201_28"],"voice_bank":"vo_event_14202","style":1,"background":1019,"log_type":1}]}