{"id":4072,"chapter_id":4,"scene_id":407,"steps":[{"step":1,"speaker":"海拉","content":"我有种不好的预感，整个大坑都像活着的一样……","voice":["vo_cgplot_4072001"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":2,"speaker":"海拉","content":"我们还要往前吗？真的还要找那个遗产吗？","voice":["vo_cgplot_4072002"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":3,"speaker":"？？","content":"早就没退路了……","voice":["vo_cgplot_4072003"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":4,"content":"你背上的人突然动了动。","style":3,"background":402,"log_type":1},{"step":5,"options":["什么时候醒的？"],"jump":[6],"style":6,"background":402,"log_type":1},{"step":6,"speaker":"赫罗","content":"……开始战斗的时候。","voice":["vo_cgplot_4072006"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":7,"speaker":"赫罗","content":"倒是你，怎么精神劲儿全没了？刚刚手无寸铁迎面挡我斧头的气势到哪儿去了？","voice":["vo_cgplot_4072007"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"他不是战斗人员。","female_content":"她不是战斗人员。","voice":["vo_cgplot_4072008","vo_cgplot_4072008f"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":9,"speaker":"赫罗","content":"谁管你啊？既然踏上战场，就拼尽全力迎敌。这个世界根本没有包容逃兵的善良。","voice":["vo_cgplot_4072009"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":10,"speaker":"赫罗","content":"放我下来，把斧子还我，我去解决它。","voice":["vo_cgplot_4072010"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":11,"speaker":"海拉","content":"胡说什么呢，你的伤还没好。","voice":["vo_cgplot_4072011"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":12,"speaker":"赫罗","content":"搞不懂状况的是你。那个遗产……跟当时一样，正在活化。不快点压制住，这里没人能活得了。","voice":["vo_cgplot_4072012"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":13,"options":["我没想逃","你上也没用，一边待着去"],"jump":[14,14],"style":6,"background":402,"log_type":1},{"step":14,"content":"某种意义上，这个重伤的小矮子，确实挺能鼓舞人。","style":3,"background":402,"log_type":1}]}