{"id":1020402,"chapter_id":1020402,"scene_id":1,"steps":[{"step":1,"content":"█月13日，17:24，班彦四院正门前。","style":9,"background":102,"log_type":1,"src_id":120402001,"trial_step":1},{"step":2,"content":"你怎么也跟来了……","style":2,"background":102,"log_type":1,"src_id":120402002,"trial_step":2},{"step":3,"content":"一个戴着古怪面具的金发男人鬼鬼祟祟地从医院正门边的景观树后探出了头。","style":3,"background":102,"log_type":1,"src_id":120402003,"trial_step":3},{"step":4,"content":"是你自己说的不能在新城露面，才拜托我来的吧？","style":2,"background":102,"log_type":1,"src_id":120402004,"trial_step":4},{"step":5,"speaker":"唐","content":"大丈夫行得正坐得直，怕什么？","voice":["vo_trial_20402_1_5"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402005,"trial_step":5},{"step":6,"content":"你要不摘下脸上戴的玩意儿再说话？","style":2,"background":102,"log_type":1,"src_id":120402006,"trial_step":6},{"step":7,"speaker":"唐","content":"啊呀……","voice":["vo_trial_20402_1_7"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402007,"trial_step":7},{"step":8,"speaker":"唐","content":"这不是不放心你一个人独闯“魔窟”嘛。","voice":["vo_trial_20402_1_8"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402008,"trial_step":8},{"step":9,"content":"唐的声音自这个滑稽的面具后响起，你不禁扶了扶额头。","style":3,"background":102,"log_type":1,"src_id":120402009,"trial_step":9},{"step":10,"content":"而且你这个面具……到底哪儿来的？","style":2,"background":102,"log_type":1,"src_id":120402010,"trial_step":10},{"step":11,"speaker":"唐","content":"你们采购办那个紫毛小姑娘给的。","voice":["vo_trial_20402_1_11"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402011,"trial_step":11},{"step":12,"speaker":"唐","content":"我说要个变装道具，她管我要钱，我说能不能便宜点儿……","voice":["vo_trial_20402_1_12"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402012,"trial_step":12},{"step":13,"content":"……","style":2,"background":102,"log_type":1,"src_id":120402013,"trial_step":13},{"step":14,"speaker":"唐","content":"不打紧不打紧，只要能让别人认不出我就行，效果是一样的。","voice":["vo_trial_20402_1_14"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402014,"trial_step":14},{"step":15,"speaker":"唐","content":"来人了……赶紧去应付一下。","voice":["vo_trial_20402_1_15"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402015,"trial_step":15},{"step":16,"content":"另一边，医院正门，一位身材魁梧的护士向你走来。","style":3,"background":102,"log_type":1,"src_id":120402016,"trial_step":16},{"step":17,"speaker":"护士","content":"您就是MBCC的局长？","voice":["vo_trial_20402_1_17"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402017,"trial_step":17},{"step":18,"content":"护士先生站定在你跟前，你才真正感受到这位精神病院护士的压迫感。","style":3,"background":102,"log_type":1,"src_id":120402018,"trial_step":18},{"step":19,"content":"他甚至比唐高了半个头，肌肉更是几乎要撑爆身上的护士服。","style":3,"background":102,"log_type":1,"src_id":120402019,"trial_step":19},{"step":20,"options":["……是我"],"style":6,"background":102,"log_type":1,"src_id":120402020,"trial_step":20,"course":3,"choices":[{"text":"……是我","goto":21}]},{"step":21,"speaker":"护士","content":"好的。","voice":["vo_trial_20402_1_21"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402021,"trial_step":21},{"step":22,"content":"巨汉护士瞥了一眼你身边的唐。","style":3,"background":102,"log_type":1,"src_id":120402022,"trial_step":22},{"step":23,"speaker":"护士","content":"这位是随行人员？","voice":["vo_trial_20402_1_23"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402023,"trial_step":23},{"step":24,"content":"……没错。","style":2,"background":102,"log_type":1,"src_id":120402024,"trial_step":24},{"step":25,"speaker":"护士","content":"预约里没说要带人。","voice":["vo_trial_20402_1_25"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402025,"trial_step":25},{"step":26,"content":"唐急中生智，赶忙解释道：","style":3,"background":102,"log_type":1,"src_id":120402026,"trial_step":26},{"step":27,"speaker":"唐","content":"我是保镖！","voice":["vo_trial_20402_1_27"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402027,"trial_step":27},{"step":28,"speaker":"唐","content":"我们MBCC局长在外出行，带个跟班不过分吧？","voice":["vo_trial_20402_1_28"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402028,"trial_step":28},{"step":29,"content":"护士看了看你们俩，对这个回答似乎没什么意见。","style":3,"background":102,"log_type":1,"src_id":120402029,"trial_step":29},{"step":30,"speaker":"护士","content":"行，那跟我来，我带你们去见达斯医生。","voice":["vo_trial_20402_1_30"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402030,"trial_step":30},{"step":31,"content":"护士先生如同一座移动的铁塔，带着你们进入了医院。","style":3,"background":102,"log_type":1,"src_id":120402031,"trial_step":31},{"step":32,"content":"你们始终保持着不远不近的距离。进入正门后你忍不住小声对唐说道：","style":3,"background":120,"log_type":1,"src_id":120402032,"trial_step":32},{"step":33,"content":"他居然这么轻易就接受了，都没有吐槽你这副奇葩装扮。","style":2,"background":120,"log_type":1,"src_id":120402033,"trial_step":33},{"step":34,"speaker":"唐","content":"那不显得哥们儿变装完美么？","voice":["vo_trial_20402_1_34"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402034,"trial_step":34},{"step":35,"content":"……我觉得是见怪不怪了。","style":2,"background":120,"log_type":1,"src_id":120402035,"trial_step":35},{"step":36,"speaker":"护士","content":"班彦四院是一家拥有悠久历史的精神专科医院，同时也负责收治被狂厄影响、M值紊乱的病人。","voice":["vo_trial_20402_1_36"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402036,"trial_step":36},{"step":37,"content":"一路上，护士先生时不时会给你介绍两句。","style":3,"background":120,"log_type":1,"src_id":120402037,"trial_step":37},{"step":38,"content":"和MBCC的业务倒是有一些重合……","style":2,"background":120,"log_type":1,"src_id":120402038,"trial_step":38},{"step":39,"speaker":"护士","content":"那不一样。","voice":["vo_trial_20402_1_39"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402039,"trial_step":39},{"step":40,"speaker":"护士","content":"我们是医院，你们是禁闭者收容机构，职能完全不一样。","voice":["vo_trial_20402_1_40"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402040,"trial_step":40},{"step":41,"content":"护士先生似乎完全不懂什么叫“玩笑”，一边走一边转头看了你们一眼。","style":3,"background":120,"log_type":1,"src_id":120402041,"trial_step":41},{"step":42,"speaker":"护士","content":"而且，正常来讲，我们是不会收治禁闭者的。","voice":["vo_trial_20402_1_42"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402042,"trial_step":42},{"step":43,"content":"为什么？","style":2,"background":120,"log_type":1,"src_id":120402043,"trial_step":43},{"step":44,"content":"你下意识问了一句。","style":3,"background":120,"log_type":1,"src_id":120402044,"trial_step":44},{"step":45,"speaker":"护士","content":"发起疯来破坏力太大，不好控制……","voice":["vo_trial_20402_1_45"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402045,"trial_step":45},{"step":46,"speaker":"护士","content":"前面就是病人活动区了。","voice":["vo_trial_20402_1_46"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402046,"trial_step":46},{"step":47,"content":"护士说着，脚步明显加快了一些，你赶紧跟上。","style":3,"background":120,"log_type":1,"src_id":120402047,"trial_step":47},{"step":48,"content":"在这片区域里，身着病号服的病人们三三两两成群，或站或坐。","style":3,"background":111,"log_type":1,"src_id":120402048,"trial_step":48},{"step":49,"content":"他们有的就只是站着不动，有的发出意义不明的怪声，有的则对着空气手舞足蹈高谈阔论。","style":3,"background":111,"log_type":1,"src_id":120402049,"trial_step":49},{"step":50,"speaker":"护士","content":"活动区一向是我们四院的特色，病人们在这里可以展开文化生活，体验跟外面一样……","voice":["vo_trial_20402_1_50"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402050,"trial_step":50},{"step":51,"content":"叮铃铃——","style":3,"background":111,"log_type":1,"src_id":120402051,"trial_step":51},{"step":52,"content":"急促的铃声打断了护士先生的讲话。","style":3,"background":111,"log_type":1,"src_id":120402052,"trial_step":52},{"step":53,"content":"他抄起腰间别着的个人终端，按下键，瓮声瓮气地问道：","style":3,"background":111,"log_type":1,"src_id":120402053,"trial_step":53},{"step":54,"speaker":"护士","content":"什么事？","voice":["vo_trial_20402_1_54"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402054,"trial_step":54},{"step":55,"speaker":"嘈杂声","content":"研究室的病人应激……拉不住……","voice":["vo_trial_20402_1_55"],"voice_bank":"vo_don_trial","style":11,"background":111,"log_type":1,"src_id":120402055,"trial_step":55},{"step":56,"speaker":"护士","content":"知道了，我马上来。","voice":["vo_trial_20402_1_56"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402056,"trial_step":56},{"step":57,"content":"麻利地挂断电话，护士转过头。","style":3,"background":111,"log_type":1,"src_id":120402057,"trial_step":57},{"step":58,"speaker":"护士","content":"抱歉，有急事，在这儿等我。","voice":["vo_trial_20402_1_58"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402058,"trial_step":58},{"step":59,"content":"紧接着，你们就眼见着这个身高超过两米的巨汉迈开腿，如同一台全速运行的卡车冲了出去。","style":3,"background":111,"log_type":1,"src_id":120402059,"trial_step":59},{"step":60,"content":"拐过一个路口，他就不见了踪影，只剩下宛如闷雷的脚步声还在走廊里回荡。","style":3,"background":111,"log_type":1,"src_id":120402060,"trial_step":60},{"step":61,"content":"……","style":2,"background":111,"log_type":1,"src_id":120402061,"trial_step":61},{"step":62,"speaker":"唐","content":"……","voice":["vo_trial_20402_1_62"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402062,"trial_step":62},{"step":63,"content":"这位护士先生……就把我们扔在这儿了？","style":2,"background":111,"log_type":1,"src_id":120402063,"trial_step":63},{"step":64,"content":"我们现在该怎么办？","style":2,"background":111,"log_type":1,"src_id":120402064,"trial_step":64},{"step":65,"speaker":"唐","content":"怎么办？等呗，你又不知道医生办公室在哪儿。","voice":["vo_trial_20402_1_65"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402065,"trial_step":65},{"step":66,"content":"再怎么说这里也是精神病院的病人活动区……","style":2,"background":111,"log_type":1,"src_id":120402066,"trial_step":66},{"step":67,"content":"不会出问题吧？","style":2,"background":111,"log_type":1,"src_id":120402067,"trial_step":67},{"step":68,"speaker":"唐","content":"有我在呢，怕什么。","voice":["vo_trial_20402_1_68"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402068,"trial_step":68},{"step":69,"content":"倒不是怕，就是这些病人……看上去有些不对劲。","style":2,"background":111,"log_type":1,"src_id":120402069,"trial_step":69},{"step":70,"content":"唐朝你凑过来，低声提醒道：","style":3,"background":111,"log_type":1,"src_id":120402070,"trial_step":70},{"step":71,"speaker":"唐","content":"你猜得没错……他们很多都是无辜的平民，是受了涅槃迫害，以“M值不稳定”的名义被关进这里的。","voice":["vo_trial_20402_1_71"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402071,"trial_step":71},{"step":72,"content":"经过唐的提醒，你才反应过来，他们身上的确都有明显的伤痕，甚至有一些肢体都有残缺。","style":3,"background":111,"log_type":1,"src_id":120402072,"trial_step":72},{"step":73,"content":"嗯，有机会的话，应该把他们也救出去……","style":2,"background":111,"log_type":1,"src_id":120402073,"trial_step":73},{"step":74,"content":"不过，倒是有件事，我很好奇——","style":2,"background":111,"log_type":1,"src_id":120402074,"trial_step":74},{"step":75,"content":"你转过头，看向唐。","style":3,"background":111,"log_type":1,"src_id":120402075,"trial_step":75},{"step":76,"options":["你对这里怎么这么熟悉？"],"style":6,"background":111,"log_type":1,"src_id":120402076,"trial_step":76,"course":3,"choices":[{"text":"你对这里怎么这么熟悉？","goto":77}]},{"step":77,"content":"医生你也认识，病人的情况你也清楚……","style":2,"background":111,"log_type":1,"src_id":120402077,"trial_step":77},{"step":78,"content":"一个西区人，对新城的精神病院这么熟悉……","style":2,"background":111,"log_type":1,"src_id":120402078,"trial_step":78},{"step":79,"content":"你不会在这儿待过吧？","style":2,"background":111,"log_type":1,"src_id":120402079,"trial_step":79},{"step":80,"speaker":"唐","content":"……","voice":["vo_trial_20402_1_80"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402080,"trial_step":80},{"step":81,"speaker":"唐","content":"说什么呢？人脉，诶，人脉懂吗？","voice":["vo_trial_20402_1_81"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402081,"trial_step":81},{"step":82,"content":"唐有些浮夸地拍了拍胸脯。","style":3,"background":111,"log_type":1,"src_id":120402082,"trial_step":82},{"step":83,"speaker":"唐","content":"像哥们儿这么牛逼的人物，到哪儿都能吃得开……","voice":["vo_trial_20402_1_83"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402083,"trial_step":83},{"step":84,"content":"还没等你来得及吐槽，背后忽然传来一阵声音：","style":3,"background":111,"log_type":1,"src_id":120402084,"trial_step":84},{"step":85,"speaker":"病人A","content":"这不是……这不是大英雄吗？","voice":["vo_trial_20402_1_85"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402085,"trial_step":85},{"step":86,"speaker":"唐","content":"咳咳咳……","voice":["vo_trial_20402_1_86"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402086,"trial_step":86},{"step":87,"speaker":"病人A","content":"是我呀，上庭皇帝，你不认识我了？","voice":["vo_trial_20402_1_87"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402087,"trial_step":87},{"step":88,"content":"唐僵在了原地。","style":3,"background":111,"log_type":1,"src_id":120402088,"trial_step":88},{"step":89,"speaker":"唐","content":"呃……我……","voice":["vo_trial_20402_1_89"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402089,"trial_step":89},{"step":90,"speaker":"病人A","content":"磨磨唧唧的不应朕的话，反了你了！欺君之罪！杀头！满门抄斩！！","voice":["vo_trial_20402_1_90"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402090,"trial_step":90},{"step":91,"speaker":"病人A","content":"来人啊，给我拿下这个逆贼！","voice":["vo_trial_20402_1_91"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402091,"trial_step":91},{"step":92,"speaker":"唐","content":"别别别……","voice":["vo_trial_20402_1_92"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402092,"trial_step":92},{"step":93,"content":"唐无奈地转过头，赔出一副笑脸。","style":3,"background":111,"log_type":1,"src_id":120402093,"trial_step":93},{"step":94,"speaker":"唐","content":"怎么能不认识你呢，皇帝陛下。","voice":["vo_trial_20402_1_94"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402094,"trial_step":94},{"step":95,"speaker":"病人A","content":"这才对嘛，好好辅佐朕的大业，大大有赏……诶？你这样子怎么回事？","voice":["vo_trial_20402_1_95"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402095,"trial_step":95},{"step":96,"speaker":"病人A","content":"才多久没见啊，怎么胡子长这么长了？","voice":["vo_trial_20402_1_96"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402096,"trial_step":96},{"step":97,"speaker":"病人A","content":"快来看呐！大英雄回来了！还长了胡子！","voice":["vo_trial_20402_1_97"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402097,"trial_step":97},{"step":98,"content":"“上庭皇帝陛下”大声吆喝着，活动区的病人们察觉到动静，纷纷凑了过来。","style":3,"background":111,"log_type":1,"src_id":120402098,"trial_step":98},{"step":99,"speaker":"病人B","content":"大英雄，是你吗？","voice":["vo_trial_20402_1_99"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402099,"trial_step":99},{"step":100,"content":"事情发展到这个地步，唐也没再躲躲闪闪藏。他摘下脸上的面具，有些尴尬地笑了笑。","style":3,"background":111,"log_type":1,"src_id":120402100,"trial_step":100},{"step":101,"speaker":"唐","content":"是我。小土豆，好久没见了，你最近还好么？","voice":["vo_trial_20402_1_101"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402101,"trial_step":101},{"step":102,"speaker":"病人B","content":"不好不好，天天浇水，还是没发芽。地下的那几个老家伙老是拿我切片，一定是我太好吃了……等我发芽了非得毒死他们！","voice":["vo_trial_20402_1_102"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402102,"trial_step":102},{"step":103,"speaker":"病人C","content":"你快毒死他们。白大褂再不死我快被他们折磨死了。动不动就拿雷劈我。","voice":["vo_trial_20402_1_103"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402103,"trial_step":103},{"step":104,"speaker":"唐","content":"他们拿雷劈你？","voice":["vo_trial_20402_1_104"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402104,"trial_step":104},{"step":105,"speaker":"病人C","content":"我怎么知道？你走之后就换我做避雷针了。我不挨劈其他人也得挨……","voice":["vo_trial_20402_1_105"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402105,"trial_step":105},{"step":106,"speaker":"病人A","content":"都是朕的错……是朕命令地鼠挖洞，被那些逆贼发现了……朕害了他……","voice":["vo_trial_20402_1_106"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402106,"trial_step":106},{"step":107,"speaker":"病人B","content":"大英雄，你什么时候带我们出去啊？再这么下去，我都快被切没了。","voice":["vo_trial_20402_1_107"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402107,"trial_step":107},{"step":108,"speaker":"唐","content":"快了……","voice":["vo_trial_20402_1_108"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402108,"trial_step":108},{"step":109,"content":"唐的眼神变得坚定起来。","style":3,"background":111,"log_type":1,"src_id":120402109,"trial_step":109},{"step":110,"speaker":"唐","content":"很快我就会带你们出去，我保证。","voice":["vo_trial_20402_1_110"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402110,"trial_step":110},{"step":111,"speaker":"病人B","content":"很快是多快啊？你都出去好久了……","voice":["vo_trial_20402_1_111"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402111,"trial_step":111},{"step":112,"content":"病人们闹哄哄地围着唐，还在问这问那。突然，“上庭皇帝”警觉地抬起了头。","style":3,"background":111,"log_type":1,"src_id":120402112,"trial_step":112},{"step":113,"speaker":"病人A","content":"不对劲，来人了！全军，听我号令，撤！","voice":["vo_trial_20402_1_113"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402113,"trial_step":113},{"step":114,"content":"随着“上庭皇帝”的一声号令，病人们一哄而散。","style":3,"background":111,"log_type":1,"src_id":120402114,"trial_step":114},{"step":115,"content":"护士先生颇具特色的沉重脚步声越来越近，唐赶忙重新戴上了面具。","style":3,"background":111,"log_type":1,"src_id":120402115,"trial_step":115},{"step":116,"content":"做完这一切，唐有些尴尬地看向你。","style":3,"background":111,"log_type":1,"src_id":120402116,"trial_step":116},{"step":117,"speaker":"唐","content":"我说过，我在哪儿都吃得开……没吹牛吧。","voice":["vo_trial_20402_1_117"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402117,"trial_step":117},{"step":118,"content":"……","style":2,"background":111,"log_type":1,"src_id":120402118,"trial_step":118},{"step":119,"content":"你真在这儿待……","style":2,"background":111,"log_type":1,"src_id":120402119,"trial_step":119},{"step":120,"speaker":"唐","content":"嘘——护士先生来了。","voice":["vo_trial_20402_1_120"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402120,"trial_step":120},{"step":121,"speaker":"唐","content":"正事儿要紧，回去再跟你解释，咱们先过去吧。","voice":["vo_trial_20402_1_121"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402121,"trial_step":121},{"step":122,"speaker":"护士","content":"这边。","voice":["vo_trial_20402_1_122"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402122,"trial_step":122},{"step":123,"content":"护士先生推开办公室的门，你和唐两人走进去之后，他退了出去，把门关了起来。","style":3,"background":1041,"log_type":1,"src_id":120402123,"trial_step":123},{"step":124,"content":"坐在办公桌上的医生头也不抬，依旧在写着什么。","style":3,"background":1041,"log_type":1,"src_id":120402124,"trial_step":124},{"step":125,"options":["打招呼"],"style":6,"background":1041,"log_type":1,"src_id":120402125,"trial_step":125,"course":3,"choices":[{"text":"打招呼","goto":126}]},{"step":126,"content":"你好，我是MBCC的局长，${PlayerName}。我和你预约过今天下午的时间。","style":2,"background":1041,"log_type":1,"src_id":120402126,"trial_step":126},{"step":127,"speaker":"医生","content":"达斯·阿尔兹。","voice":["vo_trial_20402_1_127"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402127,"trial_step":127},{"step":128,"content":"医生说出了自己的名字，手头的工作却始终没有停止。","style":3,"background":1041,"log_type":1,"src_id":120402128,"trial_step":128},{"step":129,"content":"办公室里陷入了诡异的沉默。","style":3,"background":1041,"log_type":1,"src_id":120402129,"trial_step":129},{"step":130,"content":"你等了一会儿，眼见医生没有继续说话的意思，便主动开口道：","style":3,"background":1041,"log_type":1,"src_id":120402130,"trial_step":130},{"step":131,"content":"我这次来，是想请您收治……","style":2,"background":1041,"log_type":1,"src_id":120402131,"trial_step":131},{"step":132,"speaker":"达斯","content":"西区的狂厄病人，我知道。","voice":["vo_trial_20402_1_132"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402132,"trial_step":132},{"step":133,"content":"那你看……","style":2,"background":1041,"log_type":1,"src_id":120402133,"trial_step":133},{"step":134,"content":"医生抬头看了你们一眼。","style":3,"background":1041,"log_type":1,"src_id":120402134,"trial_step":134},{"step":135,"speaker":"达斯","content":"不治。","voice":["vo_trial_20402_1_135"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402135,"trial_step":135},{"step":136,"content":"……","style":2,"background":1041,"log_type":1,"src_id":120402136,"trial_step":136},{"step":137,"content":"我听人说你是一位优秀的精神科医生……","style":2,"background":1041,"log_type":1,"src_id":120402137,"trial_step":137},{"step":138,"speaker":"达斯","content":"不治的意思不是治不了。","voice":["vo_trial_20402_1_138"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402138,"trial_step":138},{"step":139,"content":"关于治疗资金你大可放心，MBCC和新城的慈善机构会提供充足的……","style":2,"background":1041,"log_type":1,"src_id":120402139,"trial_step":139},{"step":140,"speaker":"达斯","content":"不治的意思不是要收钱。","voice":["vo_trial_20402_1_140"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402140,"trial_step":140},{"step":141,"speaker":"达斯","content":"不治的意思就是不治。","voice":["vo_trial_20402_1_141"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402141,"trial_step":141},{"step":142,"content":"……","style":2,"background":1041,"log_type":1,"src_id":120402142,"trial_step":142},{"step":143,"content":"达斯如此冷硬的态度让你一时间有些不知所措。","style":3,"background":1041,"log_type":1,"src_id":120402143,"trial_step":143},{"step":144,"options":["能问问原因吗？"],"style":6,"background":1041,"log_type":1,"src_id":120402144,"trial_step":144,"course":3,"choices":[{"text":"能问问原因吗？","goto":145}]},{"step":145,"speaker":"达斯","content":"别问我，问你的“保镖”。","voice":["vo_trial_20402_1_145"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402145,"trial_step":145},{"step":146,"content":"你转过头，只见唐挠了挠头，摘下面具，脸上的笑容有些无奈。","style":3,"background":1041,"log_type":1,"src_id":120402146,"trial_step":146},{"step":147,"speaker":"唐","content":"达斯，这是我朋友，也是整个西区的恩人，你……","voice":["vo_trial_20402_1_147"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402147,"trial_step":147},{"step":148,"speaker":"达斯","content":"你一个通缉犯，居然敢到这种地方来……你想救西区来的那个病人，对不对？","voice":["vo_trial_20402_1_148"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402148,"trial_step":148},{"step":149,"content":"医生停止了手头的工作，抬起头，笔头重重地磕了桌面一下。","style":3,"background":1041,"log_type":1,"src_id":120402149,"trial_step":149},{"step":150,"speaker":"达斯","content":"她被关在医院的地下设施里——就是当初关你的地方，守卫24小时看护，你们没有任何机会。","voice":["vo_trial_20402_1_150"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402150,"trial_step":150},{"step":151,"speaker":"达斯","content":"同样，你也别指望从我这里获得任何帮助。","voice":["vo_trial_20402_1_151"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402151,"trial_step":151},{"step":152,"content":"说着，医生瞥了你一眼。","style":3,"background":1041,"log_type":1,"src_id":120402152,"trial_step":152},{"step":153,"speaker":"达斯","content":"你是MBCC的局长，对吧？我不知道你是出于什么目的站在他这一边的，但你一定受到了欺骗。","voice":["vo_trial_20402_1_153"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402153,"trial_step":153},{"step":154,"speaker":"达斯","content":"你的这位“保镖”是我曾经的病人，是个相当危险的疯子，当初不知道用了什么手段逃脱了四院的控制。","voice":["vo_trial_20402_1_154"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402154,"trial_step":154},{"step":155,"content":"医生站起身，从他手边的文件柜中翻出一份档案，递到你手中。","style":3,"background":1041,"log_type":1,"src_id":120402155,"trial_step":155},{"step":156,"speaker":"达斯","content":"不相信的话，这是他的病历，你看了就明白了。","voice":["vo_trial_20402_1_156"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402156,"trial_step":156},{"step":157,"speaker":"达斯","content":"按理来说，我现在应该立刻通知医院的安保人员，把这个通缉犯重新收押，让他留在这里好好接受治疗。","voice":["vo_trial_20402_1_157"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402157,"trial_step":157},{"step":158,"speaker":"达斯","content":"但我只是一个医生，我的工作只有治病救人，没兴趣参与你们和涅槃的政治斗争。","voice":["vo_trial_20402_1_158"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402158,"trial_step":158},{"step":159,"speaker":"达斯","content":"不过我奉劝你一句，四院是<b>正规医院</b>，背后有涅槃集团的支持。","voice":["vo_trial_20402_1_159"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402159,"trial_step":159},{"step":160,"speaker":"达斯","content":"和他们作对，你要想清楚后果。","voice":["vo_trial_20402_1_160"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402160,"trial_step":160},{"step":161,"content":"达斯没再看你们，而是坐回自己的办公桌，继续开始工作。","style":3,"background":1041,"log_type":1,"src_id":120402161,"trial_step":161},{"step":162,"speaker":"达斯","content":"想必你也不是来找我看病的，那我们就没什么可聊的了。","voice":["vo_trial_20402_1_162"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402162,"trial_step":162},{"step":163,"speaker":"达斯","content":"请回吧。","voice":["vo_trial_20402_1_163"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402163,"trial_step":163},{"step":164,"content":"在护士礼貌的带领下，你和唐被“请”出了医生的办公室。","style":3,"background":120,"log_type":1,"src_id":120402164,"trial_step":164},{"step":165,"content":"看来这件事，比你之前设想的还要困难……","style":2,"background":1018,"log_type":1,"src_id":120402165,"trial_step":165},{"step":166,"content":"离开医院之后，你和唐坐上了返回管理局的车。","style":3,"background":1018,"log_type":1,"src_id":120402166,"trial_step":166},{"step":167,"speaker":"唐","content":"确实，达斯八成也遇到了麻烦……","voice":["vo_trial_20402_1_167"],"voice_bank":"vo_don_trial","style":1,"background":1018,"log_type":1,"src_id":120402167,"trial_step":167},{"step":168,"speaker":"唐","content":"明明去年这个时候，他就已经向四院递交了辞呈。现在却只能留在四院脱不开身……","voice":["vo_trial_20402_1_168"],"voice_bank":"vo_don_trial","style":1,"background":1018,"log_type":1,"src_id":120402168,"trial_step":168},{"step":169,"content":"至少他告诉了我们玛格丽女士的位置，还把你的档案也带了出来。","style":2,"background":1018,"log_type":1,"src_id":120402169,"trial_step":169},{"step":170,"content":"我们这一趟也不算是毫无收获。","style":2,"background":1018,"log_type":1,"src_id":120402170,"trial_step":170},{"step":171,"speaker":"唐","content":"哈哈，你倒是挺乐观。","voice":["vo_trial_20402_1_171"],"voice_bank":"vo_don_trial","style":1,"background":1018,"log_type":1,"src_id":120402171,"trial_step":171},{"step":172,"content":"和你学的。","style":2,"background":1018,"log_type":1,"src_id":120402172,"trial_step":172},{"step":173,"content":"你看了一眼手中的病历。","style":3,"background":1018,"log_type":1,"src_id":120402173,"trial_step":173},{"step":174,"content":"不过，既然事态有变，我们或许也该准备新的对策了。","style":2,"background":1018,"log_type":1,"src_id":120402174,"trial_step":174},{"step":175,"speaker":"唐","content":"不急，先分析一下现有的情报吧。","voice":["vo_trial_20402_1_175"],"voice_bank":"vo_don_trial","style":1,"background":1018,"log_type":1,"src_id":120402175,"trial_step":175},{"step":176,"speaker":"唐","content":"一定会有办法的……","voice":["vo_trial_20402_1_176"],"voice_bank":"vo_don_trial","style":1,"background":1018,"log_type":1,"src_id":120402176,"trial_step":176}]}