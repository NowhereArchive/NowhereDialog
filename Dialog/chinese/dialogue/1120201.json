{"id":1120201,"chapter_id":1120201,"scene_id":1,"steps":[{"step":1,"speaker":"温蒂","content":"嘻嘻……哈哈哈哈……","voice":["vo_trial_120201_1_2"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201002,"trial_step":2,"drawing":1120206},{"step":2,"speaker":"温蒂","content":"对，就是这里，用力切下去……再切……用力……","voice":["vo_trial_120201_1_3"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201003,"trial_step":3,"drawing":1120206},{"step":3,"content":"逼仄的空间里，温蒂正目不转睛地注视着电子屏，屏幕上循环播放着一段侦察机传回来的录像。","style":3,"log_type":1,"src_id":220201004,"trial_step":4,"drawing":1120206},{"step":4,"content":"画面中，少女拿着巨大的链锯，追赶着那些不可名状的生物，将它们砍碎，随后咧开嘴角，露出尖锐的牙齿，喉咙里发出了嗬嗬的笑声。","style":3,"log_type":1,"src_id":220201005,"trial_step":5,"drawing":1120206},{"step":5,"speaker":"温蒂","content":"真漂亮啊…………","voice":["vo_trial_120201_1_6"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201006,"trial_step":6,"drawing":1120201},{"step":6,"speaker":"温蒂","content":"嗯，嗯……就该是这样的。","voice":["vo_trial_120201_1_8"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201008,"trial_step":8,"drawing":1120201},{"step":7,"speaker":"温蒂","content":"对~逃吧！叫吧！哈哈哈！","voice":["vo_trial_120201_1_9"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201009,"trial_step":9,"drawing":1120216},{"step":8,"content":"温蒂坐在审查室中央的椅子上，手脚皆被特制的锁链束缚。","style":3,"log_type":1,"src_id":220201010,"trial_step":10,"drawing":1120216},{"step":9,"content":"明明是让人惊悚的画面，她却面带笑容地看着，露出满意的表情。","style":3,"log_type":1,"src_id":220201011,"trial_step":11,"drawing":1120216},{"step":10,"options":["你很喜欢这个？"],"style":6,"log_type":1,"src_id":220201012,"trial_step":12,"course":3,"drawing":1120206,"choices":[{"text":"你很喜欢这个？","goto":13}]},{"step":11,"speaker":"温蒂","content":"喜欢，当然喜欢！第一次有人给我拍照录像，我好高兴啊。","voice":["vo_trial_120201_1_13"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201013,"trial_step":13,"drawing":1120206},{"step":12,"speaker":"温蒂","content":"原来我工作的时候是这个样子……嘿嘿，真好看。","voice":["vo_trial_120201_1_14"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201014,"trial_step":14,"drawing":1120206},{"step":13,"speaker":"温蒂","content":"还有其他人的吗？我想多看点！","voice":["vo_trial_120201_1_15"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201015,"trial_step":15,"drawing":1120206},{"step":14,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":16,"course":6,"drawing":1120201},{"step":15,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":16,"course":6,"drawing":1120201},{"step":16,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":16,"course":6,"drawing":1120201},{"step":17,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":16,"course":6,"drawing":1120201},{"step":18,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":16,"course":6,"drawing":1120201},{"step":19,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":16,"course":6,"drawing":1120201},{"step":20,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":16,"course":6,"drawing":1120201},{"step":21,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":16,"course":6,"drawing":1120201},{"step":22,"speaker":"温蒂","content":"拍得真好……虽然还是只有我一个人，但是谢谢你们。","voice":["vo_trial_120201_1_17"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201017,"trial_step":17,"drawing":1120201},{"step":23,"content":"看到你更新了音像，温蒂温顺地看了一会儿，转头过来看向你。","style":3,"log_type":1,"src_id":220201018,"trial_step":18,"drawing":1120201},{"step":24,"speaker":"温蒂","content":"你……刚刚做了什么吗？","voice":["vo_trial_120201_1_19"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201019,"trial_step":19,"drawing":1120201},{"step":25,"options":["没有","你指什么？"],"style":6,"log_type":1,"src_id":220201020,"trial_step":20,"course":3,"drawing":1120201,"choices":[{"text":"没有","goto":21},{"text":"你指什么？","goto":null}]},{"step":26,"speaker":"温蒂","content":"你身上有种熟悉的味道。嗅嗅……","voice":["vo_trial_120201_1_21"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201021,"trial_step":21,"drawing":1120201},{"step":27,"speaker":"温蒂","content":"我能闻闻吗？过来，过来。","voice":["vo_trial_120201_1_22"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201022,"trial_step":22,"drawing":1120201},{"step":28,"content":"她满是期盼地看向你，眼神清澈，却又让人感到毛骨悚然。","style":3,"log_type":1,"src_id":220201023,"trial_step":23,"drawing":1120201},{"step":29,"content":"你想起那份检验报告——温蒂被认定为一级异变，精神受狂厄影响，非常不稳定。","style":3,"log_type":1,"src_id":220201024,"trial_step":24,"drawing":1120201},{"step":30,"options":["听她的","拒绝"],"style":6,"log_type":1,"src_id":220201025,"trial_step":25,"course":3,"drawing":1120201,"choices":[{"text":"听她的","goto":26},{"text":"拒绝","goto":34}]},{"step":31,"content":"审查室的座椅牢牢束缚住温蒂，你略微上前两步，倒也无甚所谓。","style":3,"log_type":1,"src_id":220201026,"trial_step":26,"drawing":1120201},{"step":32,"speaker":"温蒂","content":"嗯……好熟悉的味道……你的脖子也是，好柔软，好纤细……我能摸摸看吗？","voice":["vo_trial_120201_1_27"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201027,"trial_step":27,"drawing":1120201},{"step":33,"speaker":"温蒂","content":"这么柔软……我只要摸一下……它就会……哈哈哈哈！！","voice":["vo_trial_120201_1_28"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201028,"trial_step":28,"drawing":1120201},{"step":34,"options":["赶快退后"],"style":6,"log_type":1,"src_id":220201029,"trial_step":29,"course":3,"drawing":1120201},{"step":35,"speaker":"温蒂","content":"哈哈哈哈哈哈 ——！！","voice":["vo_trial_120201_1_30"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201030,"trial_step":30,"drawing":1120216},{"step":36,"speaker":"温蒂","content":"你身上也有死人的臭味！跟锈河一样的恶臭！！","voice":["vo_trial_120201_1_31"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201031,"trial_step":31,"drawing":1120216},{"step":37,"content":"她难耐地躁动起来，不停地闻着着身边的味道。视线最后落在你的身上时，爆发出一阵怪笑。","style":3,"log_type":1,"src_id":220201032,"trial_step":32,"drawing":1120216},{"step":38,"speaker":"温蒂","content":"我知道……嗯……这个味道！锈河赐予我的礼物，柔软的小蛋糕！哈哈哈哈！切分开来，我一块，他一块……你……？我只会给你漂亮的送葬！哈哈哈哈——","voice":["vo_trial_120201_1_33"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201033,"trial_step":33,"drawing":1120216,"next":[37]},{"step":39,"speaker":"温蒂","content":"啊~不行吗……可我真的很在意。","voice":["vo_trial_120201_1_34"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201034,"trial_step":34,"drawing":1120206},{"step":40,"speaker":"温蒂","content":"你的脖子……看起来纤细柔软……","voice":["vo_trial_120201_1_35"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201035,"trial_step":35,"drawing":1120206},{"step":41,"speaker":"温蒂","content":"我喜欢你的身体。你身上的味道究竟是什么……让我觉得好熟悉……","voice":["vo_trial_120201_1_36"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201036,"trial_step":36,"drawing":1120206},{"step":42,"options":["你在说什么……"],"style":6,"log_type":1,"src_id":220201037,"trial_step":37,"course":3,"drawing":1120206},{"step":43,"speaker":"温蒂","content":"嗯——嗯！！我知道了，哈哈哈哈哈哈哈！是死人的臭味！！跟锈河一样的恶臭！！","voice":["vo_trial_120201_1_38"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201038,"trial_step":38,"drawing":1120216},{"step":44,"speaker":"温蒂","content":"锈河边的盛大宴会——埋藏在垃圾堆里的饕餮，难闻的奶油和蛋糕，一块一块切分——哈哈哈哈！让我从切口里看看吧，看看流出来的到底是污水……还是令人作呕的脏东西……！","voice":["vo_trial_120201_1_39"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201039,"trial_step":39,"drawing":1120216},{"step":45,"content":"审查室的椅子被她不断摇晃，金属与金属之间的剧烈摩擦，发出令人心惊胆战的声音。","style":3,"log_type":1,"src_id":220201040,"trial_step":40,"drawing":1120216},{"step":46,"content":"你终于想起，这可是锈河收割者，与怪物共舞的疯子。为了抓住这个可怕的幽灵，你们与她在锈河周旋了几乎一整夜。","style":3,"log_type":1,"src_id":220201041,"trial_step":41,"drawing":1120216},{"step":47,"content":"她是个疯子——这种疯狂沾染了死亡的味道，恐惧渐渐蔓延你的全身。","style":3,"log_type":1,"src_id":220201042,"trial_step":42,"drawing":1120216},{"step":48,"content":"但你克制住离开的冲动，确认了一下拘束链的状态。审问必须要继续，她身上有重大嫌疑。","style":3,"log_type":1,"src_id":220201043,"trial_step":43,"drawing":1120216},{"step":49,"content":"测试音效的打断逻辑","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":50,"content":"播放一个长音效，会有个前奏，稍等一会儿。","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":51,"content":"播放相同音效，会继续延续。","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":52,"content":"暂停配置音效，这里测试一下打断。","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":53,"content":"播放一个稍短的音效，在这里等待它结束。","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":54,"content":"配置同名音效，看能否再次播放。","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":55,"content":"结束测试。","style":18,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":56,"content":"这是一份关于狂厄武器的调查报告。","style":3,"log_type":1,"src_id":220201045,"trial_step":45,"drawing":1120201},{"step":57,"content":"那是用狂厄结晶制造的邪恶武器。黑帮们觊觎禁闭者的力量，不惜沾染狂厄，让无辜者变成怪物，让辛迪加血流成河。","style":3,"log_type":1,"src_id":220201046,"trial_step":46,"drawing":1120201},{"step":58,"content":"FAC尚未揪出制造狂厄武器的幕后黑手，但目前已成功锁定最早一批邪恶结晶的来源——锈河。","style":3,"log_type":1,"src_id":220201047,"trial_step":47,"drawing":1120201},{"step":59,"content":"高级狂厄结晶通过禁闭者实验获得，而大批量的低级结晶则是从堆积在锈河的众多死役渣滓中提取。","style":3,"log_type":1,"src_id":220201048,"trial_step":48,"drawing":1120201},{"step":60,"content":"随即，一个涉嫌倒卖死役残渣的盗尸集团也浮出水面。而首个落网的嫌疑人，就坐在你面前。","style":3,"log_type":1,"src_id":220201049,"trial_step":49,"drawing":1120201},{"step":61,"content":"我会问你几个问题来了解事情经过，可以的话，希望你能好好回答。","style":2,"log_type":1,"src_id":220201050,"trial_step":50,"drawing":1120201,"next":[51]},{"step":62,"speaker":"温蒂","content":"回答的话……你会放我回去吗？我想那里的人了。","voice":["vo_trial_120201_1_51"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201051,"trial_step":51,"drawing":1120201},{"step":63,"options":["不可能","看你配合的情况"],"style":6,"log_type":1,"src_id":220201052,"trial_step":52,"course":3,"drawing":1120201,"choices":[{"text":"不可能","goto":53},{"text":"看你配合的情况","goto":54}]},{"step":64,"speaker":"温蒂","content":"嘻嘻嘻……你会的。你知道我属于那里。","voice":["vo_trial_120201_1_53"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201053,"trial_step":53,"drawing":1120206,"next":[55]},{"step":65,"speaker":"温蒂","content":"哈哈哈哈好！我越来越喜欢你了！","voice":["vo_trial_120201_1_54"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201054,"trial_step":54,"drawing":1120206},{"step":66,"content":"你无视她瘆人的阴笑声，打开虚拟投影，一张张照片出现在温蒂面前。","style":3,"log_type":1,"src_id":220201055,"trial_step":55,"drawing":1120206},{"step":67,"content":"被淤液所包裹着的污染物，混杂着碎屑，淌了一地，染黑了整个土地。","style":3,"log_type":1,"src_id":220201056,"trial_step":56,"drawing":1120206},{"step":68,"speaker":"温蒂","content":"锈河！我的归属之地……","voice":["vo_trial_120201_1_57"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201057,"trial_step":57,"drawing":1120206},{"step":69,"content":"看来你很了解那里的情况。有很多怪物吗？","style":2,"log_type":1,"src_id":220201058,"trial_step":58,"drawing":1120206},{"step":70,"speaker":"温蒂","content":"怪物？你是说死役，还是我？","voice":["vo_trial_120201_1_59"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201059,"trial_step":59,"drawing":1120206},{"step":71,"speaker":"温蒂","content":"嘻嘻，不管是什么，都有很多哦……完整的，不完整的……都有。","voice":["vo_trial_120201_1_60"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201060,"trial_step":60,"drawing":1120206},{"step":72,"speaker":"温蒂","content":"怪物残渣、蓝色的雨、黑泥、解决不掉的危险垃圾、还有无处可去的人……所有你们不要的东西，全都丢到了锈河，锈河全都接受。","voice":["vo_trial_120201_1_61"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201061,"trial_step":61,"drawing":1120206},{"step":73,"content":"你查阅了资料，锈河是被特别划分出来的废弃带。","style":3,"log_type":1,"src_id":220201062,"trial_step":62,"drawing":1120206},{"step":74,"content":"自入夜84年起，那些无法被处理的污染与生物残渣都被倾倒到锈河，渐渐地那里成为怪物的摇篮，也是危险丑类的徘徊地。","style":3,"log_type":1,"src_id":220201063,"trial_step":63,"drawing":1120206},{"step":75,"speaker":"温蒂","content":"嘿嘿，你怎么老这么盯着我呀。","voice":["vo_trial_120201_1_64"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201064,"trial_step":64,"drawing":1120206},{"step":76,"options":["你有重大嫌疑"],"style":6,"log_type":1,"src_id":220201065,"trial_step":65,"course":3,"drawing":1120206,"choices":[{"text":"你有重大嫌疑","goto":66}]},{"step":77,"content":"在我们的调查中，大部分制作狂厄武器的原料，都来自于锈河。所以我们认为锈河边有人在盗窃提取死役的组织体，作为“货物”。","style":2,"log_type":1,"src_id":220201066,"trial_step":66,"drawing":1120206},{"step":78,"content":"他们能将“货物”分割成小块运输走，还可能有对抗死役的力量。","style":2,"log_type":1,"src_id":220201067,"trial_step":67,"drawing":1120206},{"step":79,"content":"温蒂，是你干的吗？","style":2,"log_type":1,"src_id":220201068,"trial_step":68,"drawing":1120216},{"step":80,"speaker":"温蒂","content":"电锯……分割？！是、是、是~我喜欢做这个事情，我也喜欢追着它们……听它们发出尖锐的声音……哈哈哈！","voice":["vo_trial_120201_1_69"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201069,"trial_step":69,"drawing":1120216},{"step":81,"content":"我在怀疑你，这是重罪。","style":2,"log_type":1,"src_id":220201070,"trial_step":70,"drawing":1120216},{"step":82,"speaker":"温蒂","content":"哈哈哈哈——分割，那肯定是我！！我就在锈河！切分着好看的蛋糕，它们就像蜂巢一样，柔软……粘稠……恶心！！！","voice":["vo_trial_120201_1_71"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201071,"trial_step":71,"drawing":1120206},{"step":83,"speaker":"温蒂","content":"你也想感受一下吗？","voice":["vo_trial_120201_1_72"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201072,"trial_step":72,"drawing":1120206},{"step":84,"content":"温蒂看着你，眼神极为露骨地表达着自己想要将你一口吞下的欲望。","style":3,"log_type":1,"src_id":220201073,"trial_step":73,"drawing":1120206},{"step":85,"options":["不要岔开话题"],"style":6,"log_type":1,"src_id":220201074,"trial_step":74,"course":3,"drawing":1120206,"choices":[{"text":"不要岔开话题","goto":75}]},{"step":86,"content":"你承认自己收集死役样本，收集它们身上的污染组织。对吗？为什么？","style":2,"log_type":1,"src_id":220201075,"trial_step":75,"drawing":1120206},{"step":87,"speaker":"温蒂","content":"嘿嘿，那是任务呀！","voice":["vo_trial_120201_1_76"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201076,"trial_step":76,"drawing":1120206},{"step":88,"speaker":"温蒂","content":"丢进锈河的渣滓、游荡的死役、可爱的怪物们……谁也不能离开锈河……","voice":["vo_trial_120201_1_77"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201077,"trial_step":77,"drawing":1120206},{"step":89,"speaker":"温蒂","content":"我会找到它们，切开，切碎……这可是我们无上光荣的任务啊~","voice":["vo_trial_120201_1_78"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201078,"trial_step":78,"drawing":1120206},{"step":90,"options":["谁给你的任务？"],"style":6,"log_type":1,"src_id":220201079,"trial_step":79,"course":3,"drawing":1120206,"choices":[{"text":"谁给你的任务？","goto":80}]},{"step":91,"speaker":"温蒂","content":"谁……？","voice":["vo_trial_120201_1_80"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201080,"trial_step":80,"drawing":1120218},{"step":92,"content":"温蒂阴恻恻地看过来，压低了声音，和头顶排风扇的呜咽声一般……","style":3,"log_type":1,"src_id":220201081,"trial_step":81,"drawing":1120218},{"step":93,"speaker":"温蒂","content":"谁给我的这个任务早就不重要了……我只要这个任务。","voice":["vo_trial_120201_1_82"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201082,"trial_step":82,"drawing":1120218},{"step":94,"speaker":"温蒂","content":"那些东西一点点腐烂，流出巧克力浓浆……埋藏在浓浆里的小玩具，跳啊，跳啊……还有被巧克力覆盖的小樱桃，一直在呵呵呵呵地笑着。","voice":["vo_trial_120201_1_83"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201083,"trial_step":83,"drawing":1120218},{"step":95,"speaker":"温蒂","content":"我和他们天天，天天都在一起~和它们玩耍！分享它们的美味……听着它们的哭声做美梦……嘻嘻嘻……","voice":["vo_trial_120201_1_84"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201084,"trial_step":84,"drawing":1120206},{"step":96,"speaker":"温蒂","content":"你知道吗？那些东西腐烂的样子，你根本想象不出来。一半散发着作呕的臭味，一半……是会爬的黑泥。","voice":["vo_trial_120201_1_85"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201085,"trial_step":85,"drawing":1120206},{"step":97,"speaker":"温蒂","content":"我要小心地把他们分隔开，干干净净，把黑东西攒起来。它们就像一滩呕吐物……","voice":["vo_trial_120201_1_86"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201086,"trial_step":86,"drawing":1120206},{"step":98,"speaker":"温蒂","content":"呃唔唔唔唔——！","voice":["vo_trial_120201_1_87"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201087,"trial_step":87,"drawing":1120208},{"step":99,"content":"温蒂的喉咙里发出令人不悦的呕吐声，涎水滴下来，落在她的鞋尖上。","style":3,"log_type":1,"src_id":220201088,"trial_step":88,"drawing":1120208},{"step":100,"speaker":"温蒂","content":"一点点腐烂，一块块烂开！","voice":["vo_trial_120201_1_89"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201089,"trial_step":89,"drawing":1120216},{"step":101,"speaker":"温蒂","content":"一个个睡着，一座座土堆！","voice":["vo_trial_120201_1_90"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201090,"trial_step":90,"drawing":1120216},{"step":102,"speaker":"温蒂","content":"去**的和垃圾交易吧！","voice":["vo_trial_120201_1_91"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201091,"trial_step":91,"drawing":1120216},{"step":103,"content":"她猛地抖动了一下，吓了你一大跳，拘束链碰撞出一串尖锐的声音。","style":3,"log_type":1,"src_id":220201092,"trial_step":92,"drawing":1120216},{"step":104,"speaker":"温蒂","content":"哈哈哈哈哈哈哈——","voice":["vo_trial_120201_1_93"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201093,"trial_step":93,"drawing":1120216},{"step":105,"speaker":"温蒂","content":"你这个胆小鬼，只会躲在别人背后的废物东西！","voice":["vo_trial_120201_1_94"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201094,"trial_step":94,"drawing":1120216},{"step":106,"content":"你已经习惯了她突然发作的疯狂举动，也开始厌倦这样没有章法的回答。","style":3,"log_type":1,"src_id":220201095,"trial_step":95,"drawing":1120216},{"step":107,"content":"你甚至觉得，不能排除所谓的精神异常只是她为了掩饰罪行的伪装。","style":3,"log_type":1,"src_id":220201096,"trial_step":96,"drawing":1120216},{"step":108,"content":"FAC调查报告显示，锈河边的死役买卖链非常成熟，售卖、偷盗和运输以及掩人耳目的方式都滴水不漏。","style":3,"log_type":1,"src_id":220201097,"trial_step":97,"drawing":1120216},{"step":109,"content":"这可不是区区一个“疯子”能做到的。","style":3,"log_type":1,"src_id":220201098,"trial_step":98,"drawing":1120216},{"step":110,"options":["询问同谋者"],"style":6,"log_type":1,"src_id":220201099,"trial_step":99,"course":3,"drawing":1120201,"choices":[{"text":"询问同谋者","goto":100}]},{"step":111,"content":"我们有理由怀疑你有同伙或者合作对象，是辛迪加的黑帮吗？","style":2,"log_type":1,"src_id":220201100,"trial_step":100,"drawing":1120201},{"step":112,"speaker":"温蒂","content":"辛迪加？那是哪里？","voice":["vo_trial_120201_1_101"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201101,"trial_step":101,"drawing":1120201},{"step":113,"content":"呼……眼睛都要睁不开了……","style":3,"log_type":1,"src_id":220201102,"trial_step":102,"drawing":1120201},{"step":114,"content":"那些追求狂厄武器的暴徒，他们是你的同伴吗？","style":2,"log_type":1,"src_id":220201103,"trial_step":103,"drawing":1120201},{"step":115,"speaker":"温蒂","content":"不要把我们和他相提并论。","voice":["vo_trial_120201_1_104"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201104,"trial_step":104,"drawing":1120217},{"step":116,"speaker":"温蒂","content":"我的同伴可比他们高尚得多，厉害得多。","voice":["vo_trial_120201_1_105"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201105,"trial_step":105,"drawing":1120217},{"step":117,"options":["同伴？"],"style":6,"log_type":1,"src_id":220201106,"trial_step":106,"course":3,"drawing":1120217,"choices":[{"text":"同伴？","goto":107}]},{"step":118,"speaker":"温蒂","content":"嘻嘻嘻……是啊，交心交命的同伴、朋友、家人……和那些家伙不一样，和你也不一样！","voice":["vo_trial_120201_1_107"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201107,"trial_step":107,"drawing":1120206},{"step":119,"speaker":"温蒂","content":"我可是有很多——很多同伴的！","voice":["vo_trial_120201_1_108"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201108,"trial_step":108,"drawing":1120206},{"step":120,"speaker":"温蒂","content":"我们很强，很光荣……我们一起完成任务，为这个世界带来光明！嘻嘻嘻……","voice":["vo_trial_120201_1_109"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201109,"trial_step":109,"drawing":1120206},{"step":121,"speaker":"温蒂","content":"我们永远在一起，没有怪物是我们的对手。","voice":["vo_trial_120201_1_110"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201110,"trial_step":110,"drawing":1120206},{"step":122,"speaker":"温蒂","content":"它们在锈河变成垃圾，而所有的垃圾，都是我们的——","voice":["vo_trial_120201_1_111"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201111,"trial_step":111,"drawing":1120206},{"step":123,"content":"她的语调渐渐低沉，脸上的笑越来越深，直觉告诉你，她对自己疯狂的说辞深信不疑。","style":3,"log_type":1,"src_id":220201112,"trial_step":112,"drawing":1120206},{"step":124,"content":"她的同伴……会是什么样？","style":3,"log_type":1,"src_id":220201113,"trial_step":113,"drawing":1120206},{"step":125,"options":["他们在哪儿？"],"style":6,"log_type":1,"src_id":220201114,"trial_step":114,"course":3,"drawing":1120206,"choices":[{"text":"他们在哪儿？","goto":115}]},{"step":126,"speaker":"温蒂","content":"他们？啊……我的朋友们？我的家人们？","voice":["vo_trial_120201_1_115"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201115,"trial_step":115,"drawing":1120206},{"step":127,"speaker":"温蒂","content":"他们在家……但，我带来了他们的东西。","voice":["vo_trial_120201_1_116"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201116,"trial_step":116,"drawing":1120206},{"step":128,"speaker":"温蒂","content":"想要的话，自己来找找呀？","voice":["vo_trial_120201_1_117"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201117,"trial_step":117,"drawing":1120206},{"step":129,"content":"温蒂胸前的服饰里，露出了一条锈迹斑斑的链子，与她身上的物品显得格格不入。","style":3,"log_type":1,"src_id":220201118,"trial_step":118,"drawing":1120206},{"step":130,"content":"你走至她的身旁，将那条链子轻轻拉出——那条金属链子串着几个金属铭牌，带着温蒂的体温，躺在掌心之上。","style":3,"log_type":1,"src_id":220201119,"trial_step":119,"drawing":1120206},{"step":131,"content":"链条上串起十几个金属铭牌，微微晃动，反射出一丝寒光——那不是任何辛迪加帮派的恶趣味徽记。","style":3,"log_type":1,"src_id":220201120,"trial_step":120,"drawing":1120206},{"step":132,"content":"它们的样式锋利，信息带有加密，看得出隶属一个高度制度化的组织；而材质是某种极高级合金，表明这个组织拥有相当的装备、物资支持。","style":3,"log_type":1,"src_id":220201121,"trial_step":121,"drawing":1120206},{"step":133,"content":"只是它们的表面遍布的污染和划痕，明显经历过无数极度危险的战斗的洗礼。","style":3,"log_type":1,"src_id":220201122,"trial_step":122,"drawing":1120206},{"step":134,"speaker":"温蒂","content":"啊~是我的同伴，我的队友，我的家人……","voice":["vo_trial_120201_1_123"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201123,"trial_step":123,"drawing":1120201},{"step":135,"content":"此刻，她深情的呼喊让你汗毛直竖。","style":3,"log_type":1,"src_id":220201124,"trial_step":124,"drawing":1120201},{"step":136,"content":"这样一个多人、精英化的组织，掌握锈河，控制死役尸体、还拥有温蒂这样的禁闭者……","style":3,"log_type":1,"src_id":220201125,"trial_step":125,"drawing":1120201},{"step":137,"content":"你们却直到现在，才第一次意识到他们的存在？！","style":3,"log_type":1,"src_id":220201126,"trial_step":126,"drawing":1120201},{"step":138,"options":["你们究竟是什么组织？"],"style":6,"log_type":1,"src_id":220201127,"trial_step":127,"course":3,"drawing":1120201,"choices":[{"text":"你们究竟是什么组织？","goto":128}]},{"step":139,"speaker":"温蒂","content":"你害怕了吗？你在害怕吗，局长？哈哈哈哈哈哈——","voice":["vo_trial_120201_1_128"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201128,"trial_step":128,"drawing":1120201},{"step":140,"speaker":"温蒂","content":"别怕呀，你怎么会怕我们呢？怎么能把我们忘记呢？","voice":["vo_trial_120201_1_129"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201129,"trial_step":129,"drawing":1120201},{"step":141,"speaker":"温蒂","content":"作为FAC的狗，你们应该很清楚我们的事才对啊！","voice":["vo_trial_120201_1_130"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201130,"trial_step":130,"drawing":1120201},{"step":142,"content":"FAC的狗……？","style":3,"log_type":1,"src_id":220201131,"trial_step":131,"drawing":1120201},{"step":143,"speaker":"温蒂","content":"鲜血流进机器里，把我们烙印在这个东西上……","voice":["vo_trial_120201_1_132"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201132,"trial_step":132,"drawing":1120206},{"step":144,"speaker":"温蒂","content":"像一道诅咒……困住我们所有人。","voice":["vo_trial_120201_1_133"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201133,"trial_step":133,"drawing":1120206},