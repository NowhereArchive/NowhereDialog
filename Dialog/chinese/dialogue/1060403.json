{"id":1060403,"chapter_id":1060403,"scene_id":1,"steps":[{"step":1,"speaker":"？？","content":"年纪轻轻就牺牲了啊……可怜他们的女儿了。","voice":["vo_trial_60403_1_1"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403002,"trial_step":2},{"step":2,"speaker":"？","content":"究竟是因为什么事啊？","voice":["vo_trial_60403_1_2"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403003,"trial_step":3},{"step":3,"speaker":"？？","content":"不知道，那边不愿意透露任何信息。甚至连姓名也不能写在上面。","voice":["vo_trial_60403_1_3"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403004,"trial_step":4},{"step":4,"speaker":"？？","content":"只是派人送来了一对勋章。","voice":["vo_trial_60403_1_4"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403005,"trial_step":5},{"step":5,"speaker":"？","content":"哎，也是一种荣耀吧，为狄斯捐躯，也算死得其所。","voice":["vo_trial_60403_1_5"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403006,"trial_step":6},{"step":6,"content":"哀悼的路人被女孩粗暴地赶走。","style":3,"background":4189001,"log_type":1,"src_id":160403007,"trial_step":7},{"step":7,"speaker":"可可莉克","content":"滚！都滚！不需要你们的悼念！","voice":["vo_trial_60403_1_7"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403008,"trial_step":8},{"step":8,"speaker":"可可莉克","content":"呵……你们的付出，你们的名字，反正也不会有人记得！","voice":["vo_trial_60403_1_8"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403009,"trial_step":9},{"step":9,"content":"女孩赌气似的一脚踢在墓前那朵突兀的虞美人上。","style":3,"background":4189001,"log_type":1,"src_id":160403010,"trial_step":10},{"step":10,"content":"那是FAC勋章背后的种子，伴随功勋一同被埋入了不见天日的泥土之下。","style":3,"background":4189001,"log_type":1,"src_id":160403011,"trial_step":11},{"step":11,"speaker":"可可莉克","content":"你们就真的觉得，别人的命，要比自己的更有价值吗？","voice":["vo_trial_60403_1_11"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403012,"trial_step":12},{"step":12,"speaker":"可可莉克","content":"谁定义的？凭什么？","voice":["vo_trial_60403_1_12"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403013,"trial_step":13},{"step":13,"content":"女孩冷笑着，用指甲在腕间割出一道血痕，诡异的黑气倾泻而出。","style":3,"background":4189001,"log_type":1,"src_id":160403014,"trial_step":14},{"step":14,"speaker":"可可莉克","content":"喂，臭东西，我知道你想吞噬我，对吗？","voice":["vo_trial_60403_1_14"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403015,"trial_step":15},{"step":15,"speaker":"狂厄","content":"……","style":1,"background":4189001,"log_type":1,"src_id":160403016,"trial_step":16},{"step":16,"speaker":"可可莉克","content":"吃吧。但作为交换，我有个要求。","voice":["vo_trial_60403_1_16"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403017,"trial_step":17},{"step":17,"speaker":"可可莉克","content":"我可不想变成别人手中无意义的弃子，没有人可以衡量我这条命的用法。","voice":["vo_trial_60403_1_17"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403018,"trial_step":18},{"step":18,"speaker":"可可莉克","content":"只要足够强……就能为自己活。","voice":["vo_trial_60403_1_18"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403019,"trial_step":19},{"step":19,"speaker":"要员","content":"为什么……","voice":["vo_trial_60403_1_20"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403021,"trial_step":21},{"step":20,"speaker":"可可莉克","content":"不为什么，拿钱办事对刺客而言，难道不是天经地义的吗？","voice":["vo_trial_60403_1_21"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403022,"trial_step":22},{"step":21,"speaker":"要员","content":"……呵！是啊……不过是一群拿钱办事的疯子！","voice":["vo_trial_60403_1_22"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403023,"trial_step":23},{"step":22,"speaker":"可可莉克","content":"哦？那你们，是为了狄斯的安定，死在了疯子的狂厄异能之下——这样说，能让你们更有价值吗，各位\"贵宾“？","voice":["vo_trial_60403_1_23"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403024,"trial_step":24},{"step":23,"content":"刺客没有给他们继续开口的机会，小巷里弥漫着腐败的甜腥。","style":3,"background":4190001,"log_type":1,"src_id":160403025,"trial_step":25},{"step":24,"speaker":"可可莉克","content":"真讨厌，看到我那么华丽的招式，怎么都不笑一个呢？","voice":["vo_trial_60403_1_25"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403026,"trial_step":26},{"step":25,"speaker":"可可莉克","content":"我赐给你们的，难道不是你们最喜欢的“荣誉”吗？不应该为此感到高兴吗？","voice":["vo_trial_60403_1_26"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403027,"trial_step":27},{"step":26,"content":"可可莉克用手指在那呆滞僵硬的脸上撑起一个笑容，很快又厌烦地甩开。","style":3,"background":4190001,"log_type":1,"src_id":160403028,"trial_step":28},{"step":27,"speaker":"可可莉克","content":"你们曾给别人带去绝望、痛苦、悲伤，我不过是让你们全都再尝一遍罢了。","voice":["vo_trial_60403_1_28"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403029,"trial_step":29},{"step":28,"speaker":"可可莉克","content":"这才是人人公平的狄斯城啊哈哈哈哈哈……咳咳咳！","voice":["vo_trial_60403_1_29"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403030,"trial_step":30},{"step":29,"content":"情绪牵动着体内的创痛，但她似乎已经习惯了异能带来的折磨，不在乎地擦了擦嘴角，在血泊中埋下一粒种子。","style":3,"background":4190001,"log_type":1,"src_id":160403031,"trial_step":31},{"step":30,"speaker":"可可莉克","content":"当年那些冠冕堂皇的嘉奖，如今由我，还给你们~","voice":["vo_trial_60403_1_31"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403032,"trial_step":32},{"step":31,"content":"单薄的影子消失在暗巷的尽头。","style":3,"background":4190001,"log_type":1,"src_id":160403033,"trial_step":33},{"step":32,"content":"十，百，千？她已经不记得自己送出了多少朵虞美人，未尝败绩。","style":1,"background":10006,"log_type":1,"src_id":160403034,"trial_step":34},{"step":33,"speaker":"可可莉克","content":"花园的委托也好，宿命的怨敌也罢……我能扫清一切。","voice":["vo_trial_60403_1_34"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403035,"trial_step":35},{"step":34,"content":"终于，她触碰到了仇恨的中心。","style":3,"background":10006,"log_type":1,"src_id":160403036,"trial_step":36},{"step":35,"speaker":"业师","content":"得手了？","voice":["vo_trial_60403_1_37"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403038,"trial_step":38},{"step":36,"speaker":"可可莉克","content":"是。","voice":["vo_trial_60403_1_38"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403039,"trial_step":39},{"step":37,"speaker":"业师","content":"确认是他吗？","voice":["vo_trial_60403_1_39"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403040,"trial_step":40},{"step":38,"speaker":"可可莉克","content":"确认，父母参与的那次行动中，他是主要负责人。","voice":["vo_trial_60403_1_40"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403041,"trial_step":41},{"step":39,"speaker":"业师","content":"很好，这些年辛苦你了，好好休息一下吧。","voice":["vo_trial_60403_1_41"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403042,"trial_step":42},{"step":40,"speaker":"可可莉克","content":"……","style":1,"background":4191001,"log_type":1,"src_id":160403043,"trial_step":43},{"step":41,"speaker":"业师","content":"怎么，对我的安排不满意？","voice":["vo_trial_60403_1_43"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403044,"trial_step":44},{"step":42,"speaker":"可可莉克","content":"我不在的这几天，花园少了很多人呐？","voice":["vo_trial_60403_1_44"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403045,"trial_step":45},{"step":43,"speaker":"业师","content":"嗯，一项地底派来的危险任务。为了保全大局，必须向上放出一些饵料。","voice":["vo_trial_60403_1_45"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403046,"trial_step":46},{"step":44,"speaker":"业师","content":"最终目的已经达成，他们也不算白白牺牲了。","voice":["vo_trial_60403_1_46"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403047,"trial_step":47},{"step":45,"content":"长大了的刺客没有答话，她一派平静地吹了吹指尖的灰尘。","style":3,"background":4191001,"log_type":1,"src_id":160403048,"trial_step":48},{"step":46,"speaker":"业师","content":"为了地底的大业，这是他们身为刺客的荣耀。","voice":["vo_trial_60403_1_48"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403049,"trial_step":49},{"step":47,"speaker":"业师","content":"可可莉克，别忘了是花园扶持你，锻炼你，帮你收获复仇的情报。","voice":["vo_trial_60403_1_49"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403050,"trial_step":50},{"step":48,"speaker":"业师","content":"总有一天，你也要……","voice":["vo_trial_60403_1_50"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403051,"trial_step":51},{"step":49,"speaker":"可可莉克","content":"也要为了你们的计划，去白白送死吗？","voice":["vo_trial_60403_1_51"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403052,"trial_step":52},{"step":50,"speaker":"可可莉克","content":"我还以为，接纳禁闭者的花园能是什么好地方……没想到，都一样。","voice":["vo_trial_60403_1_52"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403053,"trial_step":53},{"step":51,"speaker":"可可莉克","content":"你们的野心，和花园的其他人又有什么关系？","voice":["vo_trial_60403_1_53"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403054,"trial_step":54},{"step":52,"speaker":"可可莉克","content":"这么关心不见阳光的地方，那我就亲手送你去吧。","voice":["vo_trial_60403_1_55"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4192001,"log_type":1,"src_id":160403056,"trial_step":56},{"step":53,"speaker":"可可莉克","content":"我不会让自己成为这种自我感动的笑话。我的花朵们——","voice":["vo_trial_60403_1_56"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4192001,"log_type":1,"src_id":160403057,"trial_step":57},{"step":54,"speaker":"可可莉克","content":"也一样。","voice":["vo_trial_60403_1_57"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4192001,"log_type":1,"src_id":160403058,"trial_step":58},{"step":55,"speaker":"加洛法诺","content":"我不愿再失去家人了……","voice":["vo_trial_60403_1_59"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403060,"trial_step":60},{"step":56,"speaker":"可可莉克","content":"花园就是你的家，我给你家人。","voice":["vo_trial_60403_1_60"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403061,"trial_step":61},{"step":57,"speaker":"蓟","content":"他该得到惩罚！","voice":["vo_trial_60403_1_61"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403062,"trial_step":62},{"step":58,"speaker":"可可莉克","content":"那就做到极致，我会教你。","voice":["vo_trial_60403_1_62"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403063,"trial_step":63},{"step":59,"speaker":"昙","content":"我还要更强，不会被任何人踩在脚下！","voice":["vo_trial_60403_1_63"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403064,"trial_step":64},{"step":60,"speaker":"可可莉克","content":"那就赢过我，或者杀了我。","voice":["vo_trial_60403_1_64"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403065,"trial_step":65},{"step":61,"speaker":"堇","content":"请原谅，我或许又要随他而去了。","female_content":"请原谅，我或许又要随她而去了。","voice":["vo_trial_60403_1_65","vo_trial_60403_1_65f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403066,"trial_step":66},{"step":62,"speaker":"可可莉克","content":"呵，把自己的全部都押在另一个人身上，就不怕被背叛吗？","voice":["vo_trial_60403_1_66"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403067,"trial_step":67},{"step":63,"speaker":"堇","content":"……我不在乎。","voice":["vo_trial_60403_1_67"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":