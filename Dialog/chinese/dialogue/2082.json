{"id":2082,"chapter_id":2,"scene_id":208,"steps":[{"step":1,"speaker":"狂厄者","content":"……救…………救…………我……","voice":["vo_cgplot_2082001"],"voice_bank":"vo_cgplot_02","style":1,"background":106,"log_type":1},{"step":2,"content":"就在前一天，他们还是泰德的手下。现在因为自己老大的野心，变成无知无识的重度狂厄者，并最终成为了污染的一部分。","style":3,"background":106,"log_type":1},{"step":3,"speaker":"海拉","content":"……我们呆在这种地方，真的没问题吗？","voice":["vo_cgplot_2082003"],"voice_bank":"vo_cgplot_02","style":1,"background":106,"log_type":1},{"step":4,"speaker":"赫卡蒂","content":"那个医师说过，局长的枷锁能遏制我们身上的狂厄。","voice":["vo_cgplot_2082004"],"voice_bank":"vo_cgplot_02","style":1,"background":106,"log_type":1},{"step":5,"speaker":"海拉","content":"……那，其他人呢？那个灰头发的就不说了，安，还有我们要抓的目标，她们身上都没枷锁吧？岂不是——","voice":["vo_cgplot_2082005"],"voice_bank":"vo_cgplot_02","style":1,"background":106,"log_type":1},{"step":6,"speaker":"赫卡蒂","content":"那就在她们崩溃前施加枷锁。","voice":["vo_cgplot_2082006"],"voice_bank":"vo_cgplot_02","style":1,"background":106,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"我们到最深层了。","voice":["vo_cgplot_2082007"],"voice_bank":"vo_cgplot_02","style":1,"background":106,"log_type":1},{"step":8,"content":"长长的通道没有岔路，尽头是另一扇隔离门。门后是彼岸最后的隔离病房。","style":3,"background":108,"log_type":1}]}