{"id":402604052,"chapter_id":50070,"scene_id":57027,"steps":[{"step":2,"content":"（前面经历过的几个3次元实景，白转场切换一下）蒙太奇式","style":18,"background":2275,"hide_button":true,"log_type":1},{"step":4,"content":"【转场】","style":18,"background":2261,"hide_button":true,"log_type":1},{"step":5,"speaker":"赫卡蒂","content":"结束了……","voice":["vo_event_402604042_07"],"voice_bank":"vo_event_26404","style":1,"background":2274,"hide_button":true,"log_type":1},{"step":6,"speaker":"赫卡蒂","content":"我只会操控梦魇，也一直在这个梦中寻找狂厄的力量。","voice":["vo_event_402604042_08"],"voice_bank":"vo_event_26404","style":1,"background":2274,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"幸好，直到最后它也没出现。","voice":["vo_event_402604042_09"],"voice_bank":"vo_event_26404","style":1,"background":2274,"log_type":1},{"step":8,"content":"她回头看向梦中的幻影，两个世界正在分离，那些模糊的人影正逐渐淡去……","style":3,"background":2274,"log_type":1},{"step":9,"speaker":"赫卡蒂","content":"我要走了，回到我的局长身边。谢谢你们，愿这里永远是个美好的梦境。","voice":["vo_event_402604042_11"],"voice_bank":"vo_event_26404","style":1,"background":2274,"log_type":1},{"step":10,"content":"系统不甘心地发出最后的鸣响，被你们随手一按，权限启动了，如大家所愿，它闭上了嘴。","style":3,"background":2248001,"log_type":1},{"step":11,"content":"这是你们辛苦迎来的胜利，心中的确满足，这就是通关的快乐。","style":3,"background":2248001,"log_type":1},{"step":12,"speaker":"000","content":"你亲手扔了主角光环，变成跟我一样的系统错误……怎么还跟以前一样硬碰硬？","voice":["vo_event_402604052_17"],"voice_bank":"vo_event_26405","style":1,"background":2248001,"log_type":1},{"step":13,"speaker":"000","content":"就这么想让我回来吗？","voice":["vo_event_402604052_18"],"voice_bank":"vo_event_26405","style":1,"background":2248001,"log_type":1},{"step":14,"speaker":"选项","options":["对啊，我拼了命来救你","没有，谁让我是局长呢"],"jump":[15,20],"style":6,"background":2248001,"log_type":1},{"step":15,"content":"她笑的很开心，搂住你的手臂又圈紧了一些。","style":3,"background":2248001,"log_type":1},{"step":16,"speaker":"000","content":"呀~我会不好意思的。","voice":["vo_event_402604052_21"],"voice_bank":"vo_event_26405","style":1,"background":2248001,"log_type":1},{"step":17,"speaker":"${PlayerName}","content":"会不好意思吗？我还以为这些都是你计划好的。","style":2,"background":2248001,"log_type":1},{"step":18,"speaker":"${PlayerName}","content":"在我身上用了那么多心思，那么想我来“救”你，我当然要来。","style":2,"background":2248001,"log_type":1},{"step":20,"speaker":"000","content":"好好好，那以后我不来你的局子了，永远不来了，别后悔哦。","voice":["vo_event_402604052_24"],"voice_bank":"vo_event_26405","style":1,"background":2248001,"log_type":1},{"step":21,"speaker":"${PlayerName}","content":"真的？你真不会找各种空子钻进我的管理局吗？","style":2,"background":2248001,"log_type":1},{"step":22,"speaker":"${PlayerName}","content":"这一路你使了那么多小心机，总算把我套路来了。","style":2,"background":2248001,"log_type":1},{"step":23,"speaker":"000","content":"嗯……好想法，我确实干得出这种事。","voice":["vo_event_402604052_36"],"voice_bank":"vo_event_26405","style":1,"background":2248001,"log_type":1},{"step":24,"speaker":"000","content":"那你这是——上钩了？为了我这么帅气又拼命，还做了这种出格事……你明明不是这样的人。","voice":["vo_event_402604052_38"],"voice_bank":"vo_event_26405","style":1,"background":2248001,"log_type":1},{"step":25,"speaker":"选项","options":["又来了"],"jump":[26],"style":6,"background":2248001,"log_type":1},{"step":26,"speaker":"${PlayerName}","content":"“你该是这样的人，不该是那样的人……”你总是说这种话。","style":2,"background":2248001,"log_type":1},{"step":27,"speaker":"${PlayerName}","content":"明明自己也不喜欢被别人编排故事，却总要给我贴标签。","style":2,"background":2248001,"log_type":1},{"step":28,"speaker":"${PlayerName}","content":"别说你够了解我，才认识几天，你懂不了太多。","style":2,"background":2248001,"log_type":1},{"step":29,"content":"你拍拍她的猫耳朵。","style":3,"background":2248001,"log_type":1},{"step":30,"speaker":"000","content":"是吗，但有一件事我不会弄错。下次别猜女孩子的心了，木头局长。","voice":["vo_event_402604052_66"],"voice_bank":"vo_event_26405","style":1,"background":2248001,"log_type":1},{"step":31,"speaker":"000","content":"我粘着你的理由，就不能只是简单的喜欢你，想跟你多待一会儿吗？","voice":["vo_event_402604052_123"],"voice_bank":"vo_event_26405","style":1,"background":2248001,"log_type":1},{"step":32,"content":"…………","style":2,"background":2248001,"log_type":1},{"step":33,"content":"该怎么回答她呢？你还记得这系统给你的最重要的信息。","style":3,"background":2248001,"log_type":1},{"step":34,"content":"<color=#cafffc>纠错系统只会纠正系统内部的错误\n我们不会处理游离在外的异常</color>","style":14,"background":2277001,"is_centered":true,"log_type":1},{"step":35,"content":"<color=#cafffc>何况现实世界绝不会出现狂厄\n更不会有制止狂厄的神秘力量\n\n因为狂厄只是人虚构的幻想</color>","style":14,"background":2277001,"is_centered":true,"log_type":1},{"step":36,"content":"你们击溃了强大的游戏纠错系统，但这并不是全部。一直以来，封堵狂厄、击碎000的强大敌人还没来。","style":3,"background":2248001,"log_type":1},{"step":37,"content":"那是某种更高的规则，它比这个世界的一切更高维，所谓的权限在它面前也不堪一击，是绝对不可战胜的。","style":3,"background":2248001,"log_type":1},{"step":38,"content":"它的功能大概就是捍卫秩序，确保此间的鸭子神们永远不会发现狂厄，不能有错误的妄想，确保在这边的世界，虚构与想象永远不能扭曲现实。","style":3,"background":2248001,"log_type":1},{"step":39,"content":"所以，当鸭子们从噩梦中醒来发现系统被篡改时，你们的游戏就该结束了。","style":3,"background":2248001,"log_type":1},{"step":40,"content":"就算真的舍不得，现在也有更重要的事要做。你牵起她的手，将神的权限全部共享，这个时候更干脆地离开才是最优解，你准备好道别的台词。","style":3,"background":2248001,"log_type":1},{"step":41,"content":"可她却先一步握紧了你的手，漂浮起来，托起你的脸。","style":3,"background":2248001,"log_type":1},{"step":42,"content":"这次没再硬磕你的嘴唇，她只是靠近了，轻轻抵上你的额头。","style":3,"background":2248001,"log_type":1},{"step":43,"speaker":"000","content":"谢谢你找到我，唤醒我，带我走出那片黑夜，走这么长的路，经历一次绚丽的冒险。","voice":["vo_event_402604052_40"],"voice_bank":"vo_event_26405","style":1,"background":4330,"log_type":1},{"step":44,"speaker":"000","content":"这场烟花，我看得很开心。","voice":["vo_event_402604052_124"],"voice_bank":"vo_event_26405","style":1,"background":4330,"log_type":1},{"step":45,"speaker":"选项","options":["……我也是"],"jump":[46],"style":6,"background":4330,"log_type":1},{"step":46,"content":"裂隙的光芒越来越盛，逐渐浸没二人。000的身体变得飘忽，离别将至，她看进你的眼睛。","style":3,"background":4330,"log_type":1},{"step":47,"content":"笑容里带着期待，又带着些许遗憾。","style":3,"background":4330,"log_type":1},{"step":48,"speaker":"000","content":"没事的，我已经不害怕了。你带给我那么多种可能，我总会抓住。","voice":["vo_event_402604052_45"],"voice_bank":"vo_event_26405","style":1,"background":4330,"log_type":1},{"step":49,"speaker":"000","content":"也许在谁的梦里，也许进别人的故事，哦，又或者，集齐创世神之力的我们，可以再造一个全新的世界，我们会再见的。","voice":["vo_event_402604052_46"],"voice_bank":"vo_event_26405","style":1,"background":4330,"log_type":1},{"step":50,"speaker":"000","content":"最后的时间，带你看看前面的路吧。","voice":["vo_event_402604052_62"],"voice_bank":"vo_event_26405","style":1,"background":4330,"log_type":1},{"step":51,"speaker":"000","content":"不要紧的，不管前面有什么，不管你以后能不能记得……你都在今天创造过奇迹。","voice":["vo_event_402604052_63"],"voice_bank":"vo_event_26405","style":1,"background":4330,"log_type":1},{"step":52,"speaker":"000","content":"那么以后，无论怎样的黑夜……你都一定能抓住打破它的可能。","voice":["vo_event_402604052_70"],"voice_bank":"vo_event_26405","style":1,"background":4330,"log_type":1},{"step":53,"content":"【转场】","style":18,"background":10000,"log_type":1},{"step":54,"content":"【看剧透视频】关于未来的蒙太奇","style":23,"background":10000,"log_type":1},{"step":55,"content":"【转场】","style":18,"background":10000,"log_type":1},{"step":56,"speaker":"摩尔","content":"……看来这就是世界的底线。呵呵，都被那两人践踏成这样了，还只是回溯到原点……","voice":["vo_event_402604052_73"],"voice_bank":"vo_event_26405","style":1,"background":4331,"log_type":1},{"step":57,"speaker":"摩尔","content":"真温柔啊。","voice":["vo_event_402604052_125"],"voice_bank":"vo_event_26405","style":1,"background":4331,"log_type":1},{"step":58,"content":"两个世界的时间同时倒转，看不见的手在缓慢修补异常撕裂的漏洞。一切终将回归正轨，每个世界的系统都健壮得令人着迷。","style":3,"background":4331,"log_type":1},{"step":59,"content":"000的诞生虽然是彻底的意外，但也证明了狂厄网络已经能穿过世界边界，触及另一个意识，是莫大的惊喜。","style":3,"background":4331,"log_type":1},{"step":60,"speaker":"摩尔","content":"可怜那位局长先生这么拼命，最后也还是什么都带不回来。","female_content":"可怜那位局长小姐这么拼命，最后也还是什么都带不回来。","voice":["vo_event_402604052_74","vo_event_402604052_74f"],"voice_bank":"vo_event_26405","style":1,"background":4331,"log_type":1},{"step":61,"speaker":"摩尔","content":"……呵呵，说什么呢，我也一样。这么一回溯，几天的工作也全白干了。","voice":["vo_event_402604052_126"],"voice_bank":"vo_event_26405","style":1,"background":4332,"hide_button":true,"log_type":1},{"step":62,"voice":["vo_event_402604052_126"],"voice_bank":"vo_event_26405","style":18,"background":4332,"hide_button":true,"log_type":1},{"step":63,"speaker":"${PlayerName}","content":"我不相信什么异次元神创造世界，也不信什么文档能决定人的命运灵魂。","voice":["vo_event_402604052_78","vo_event_402604052_78f"],"voice_bank":"vo_event_26405","style":1,"background":2155,"hide_button":true,"log_type":1},{"step":64,"speaker":"${PlayerName}","content":"能篡改000的只能是她的创造者。但那绝不是所谓的神，入侵她的就是最初污染她的狂厄数据——也就是你放出的数据。","voice":["vo_event_402604052_79","vo_event_402604052_79f"],"voice_bank":"vo_event_26405","style":1,"background":2155,"log_type":1},{"step":65,"speaker":"${PlayerName}","content":"是你入侵了000的底层，再利用她深信的设定论把她逼上死路。","voice":["vo_event_402604052_80","vo_event_402604052_80f"],"voice_bank":"vo_event_26405","style":1,"background":2155,"log_type":1},{"step":66,"content":"【上枷锁】","style":18,"background":2155,"log_type":1},{"step":67,"speaker":"${PlayerName}","content":"我不追究你的处置方式。但这几天你借000的入侵路径暗中盗取了大量情报，这些全部都没上报吧？","voice":["vo_event_402604052_81","vo_event_402604052_81f"],"voice_bank":"vo_event_26405","style":1,"background":2155,"log_type":1},{"step":68,"speaker":"${PlayerName}","content":"第九机关就在外面，他们会查清你跟狄斯暗网、跟地底势力的关系。但现在，先带我去网络深处，去那个禁闭者最早被污染的地方。","voice":["vo_event_402604052_83","vo_event_402604052_83f"],"voice_bank":"vo_event_26405","style":1,"background":2155,"log_type":1},{"step":69,"speaker":"${PlayerName}","content":"你一定还记得在哪里，专家。","voice":["vo_event_402604052_85","vo_event_402604052_85f"],"voice_bank":"vo_event_26405","style":1,"background":2155,"log_type":1},{"step":70,"content":"外衣的防水效果很不错，摩尔就这么走进蓝雨中，雨水恰好冲洗掉衣摆沾着的血渍。","style":3,"background":4333,"log_type":1},{"step":71,"content":"很久没杀蜘蛛了，手有点生，没控制好分寸，脏了喜欢的衣服。","style":3,"background":4333,"log_type":1},{"step":72,"speaker":"摩尔","content":"唉，那些拷回来的命运、设定、文档，我还想带回去让你看看。全被你的弟弟搞黄了。再过一会儿，就连我也会全忘记吧。","female_content":"唉，那些拷回来的命运、设定、文档，我还想带回去让你看看。全被你的妹妹搞黄了。再过一会儿，就连我也会全忘记吧。","voice":["vo_event_402604052_87","vo_event_402604052_87f"],"voice_bank":"vo_event_26405","style":1,"background":4333,"log_type":1},{"step":73,"speaker":"摩尔","content":"罢了，也没什么可惜的。忘记就忘记了。","voice":["vo_event_402604052_88"],"voice_bank":"vo_event_26405","style":1,"background":4333,"log_type":1},{"step":74,"speaker":"摩尔","content":"狄斯暗网的使命已经达成，不用再当出头鸟，也不用当烟雾弹。我的工作结束了吧？接下来可以申请一个长假吗？","voice":["vo_event_402604052_89"],"voice_bank":"vo_event_26405","style":1,"background":4333,"log_type":1},{"step":75,"speaker":"摩尔","content":"毕竟就我看过的命运来说，未来很长一段时间，它都站在你那边。","voice":["vo_event_402604052_90"],"voice_bank":"vo_event_26405","style":1,"background":4333,"log_type":1},{"step":76,"speaker":"摩尔","content":"哦，抱歉，差点忘了。","voice":["vo_event_402604052_91"],"voice_bank":"vo_event_26405","style":1,"background":4333,"log_type":1},{"step":77,"content":"【CG-返回地底】","style":18,"background":4334,"hide_button":true,"log_type":1},{"step":78,"speaker":"摩尔","content":"我也是你的伙伴。","voice":["vo_event_402604052_92"],"voice_bank":"vo_event_26405","style":1,"background":4334,"hide_button":true,"log_type":1},{"step":79,"speaker":"摩尔","content":"那这样的命运就是最好的。","voice":["vo_event_402604052_93"],"voice_bank":"vo_event_26405","style":1,"background":4334,"hide_button":true,"log_type":1},{"step":80,"content":"【CG-摩尔摘帽】","style":18,"background":4335,"hide_button":true,"log_type":1},{"step":81,"speaker":"摩尔","content":"它将站在我们这边。","voice":["vo_event_402604052_94"],"voice_bank":"vo_event_26405","style":1,"background":4335,"hide_button":true,"log_type":1},{"step":83,"content":"ed","style":23,"background":10000,"log_type":1},{"step":84,"content":"飞书聊天","style":29,"background":10000,"log_type":1},{"step":86,"speaker":"艾米潘","content":"局长！这边这边！","voice":["vo_event_402604052_117"],"voice_bank":"vo_event_26405","style":1,"background":2217,"log_type":1},{"step":87,"speaker":"雷比尼斯","content":"请放弃，刚刚给你买游戏卡带已经用完所有预算，请找莓丝借钱。","voice":["vo_event_402604052_118"],"voice_bank":"vo_event_26405","style":1,"background":2217,"log_type":1},{"step":88,"content":"跟禁闭者们一起走在宽敞的街道，没有桎梏、没有算计，没有危险，同伴们的笑声没有丝毫阴霾，这久违的轻松确实值得珍惜。","style":3,"background":2217,"log_type":1},{"step":89,"content":"夏日阳光洒落，人群熙熙攘攘，一切都如此平和，你却突然停住脚步。","style":3,"background":2217,"log_type":1},{"step":90,"speaker":"遥远的声音","content":"菠菜！菠菜！","voice":["vo_event_402604052_121"],"voice_bank":"vo_event_26405","style":1,"background":2217,"log_type":1},{"step":91,"speaker":"赫卡蒂","content":"局长，你怎么了？","voice":["vo_event_402604052_122"],"voice_bank":"vo_event_26405","style":1,"background":2217,"log_type":1},{"step":92,"speaker":"${PlayerName}","content":"……好像幻听了。","style":2,"background":2217,"log_type":1},{"step":93,"speaker":"选项","options":["走吧，回管理局"],"jump":[94],"style":6,"background":2217,"log_type":1}]}