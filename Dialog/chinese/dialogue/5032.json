{"id":5032,"chapter_id":5,"scene_id":505,"steps":[{"step":1,"speaker":"海拉","content":"哈哈哈哈谢谢军团大哥们，自由的感觉真棒！很快就能击穿他们了，复仇时间到，冲啦！赫卡蒂，一起上！","voice":["vo_cgplot_5032001"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":2,"speaker":"赫卡蒂","content":"<size=30><color=#7683a2>………… 这是命令，这是命令……</size> </color>","voice":["vo_cgplot_5032002"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":3,"speaker":"赫卡蒂","content":"不、不要妨碍我们。","voice":["vo_cgplot_5032003"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":4,"speaker":"FAC士兵","content":"啧，那帮怪物果然不可信任，从一开始就不该把他们编入作战部队！","voice":["vo_cgplot_5032004"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":5,"speaker":"FAC士兵","content":"这下怎么办？那个局长还在他们手上，我们不能放手战斗。要放他们过去吗？","voice":["vo_cgplot_5032005"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":6,"speaker":"？？","content":"不，如果放任他们离开，局长就真的危险了。","voice":["vo_cgplot_5032006"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":7,"content":"一个身着重甲的士兵从后方赶到，他的步履稳健，手持重战斧而来，盔甲上036数字涂装显然彰显着他与其他人的不同。","style":3,"background":504,"log_type":1},{"step":8,"speaker":"厄尔希","content":"士兵们的迷茫消失了……","voice":["vo_cgplot_5032008"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":9,"speaker":"厄尔希","content":"小心点，那个人一句话就重振队伍士气，他不简单。","voice":["vo_cgplot_5032009"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":10,"speaker":"036","content":"我来指挥，必须在这里把他夺回。","female_content":"我来指挥，必须在这里把她夺回。","voice":["vo_cgplot_5032010","vo_cgplot_5032010f"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1}]}