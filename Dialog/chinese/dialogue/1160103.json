{"id":1160103,"chapter_id":1160103,"scene_id":1,"steps":[{"step":1,"speaker":"艾瑞尔","content":"谢谢您，局长。","style":1,"background":1011,"log_type":1,"src_id":260103001,"trial_step":1},{"step":2,"content":"这样就可以了么？","style":2,"background":1011,"log_type":1,"src_id":260103002,"trial_step":2},{"step":3,"speaker":"艾瑞尔","content":"嗯。","style":1,"background":1011,"log_type":1,"src_id":260103003,"trial_step":3},{"step":4,"speaker":"艾瑞尔","content":"帮我见到父亲，帮我发出艾瑞尔·斯宾塞已故的讣告，都给局长添了不少麻烦吧。","style":1,"background":1011,"log_type":1,"src_id":260103004,"trial_step":4},{"step":5,"speaker":"艾瑞尔","content":"我已经……不知道该怎么感谢您了。","style":1,"background":1011,"log_type":1,"src_id":260103005,"trial_step":5},{"step":6,"options":["这只是小事，不必放在心上。"],"style":6,"background":1011,"log_type":1,"src_id":260103006,"trial_step":6,"course":3,"choices":[{"text":"这只是小事，不必放在心上。","goto":7}]},{"step":7,"content":"你们站在崭新的墓碑前，上面工整地刻着“艾瑞尔·斯宾塞”的名字。","style":3,"background":1011,"log_type":1,"src_id":260103007,"trial_step":7},{"step":8,"content":"看来最后他还是认可你作为家族的一员。","style":2,"background":1011,"log_type":1,"src_id":260103008,"trial_step":8},{"step":9,"speaker":"艾瑞尔","content":"……是吗。","style":1,"background":1011,"log_type":1,"src_id":260103009,"trial_step":9},{"step":10,"content":"新墓的位置很好，在斯宾塞家园林后山，站在这里正好可以俯视府邸中此时正在举办的葬礼。","style":3,"background":1011,"log_type":1,"src_id":260103010,"trial_step":10},{"step":11,"speaker":"艾瑞尔","content":"我父亲他……很固执，很难改变。","style":1,"background":1011,"log_type":1,"src_id":260103011,"trial_step":11},{"step":12,"speaker":"艾瑞尔","content":"就像新城的大多数人一样……敌视着禁闭者。","style":1,"background":1011,"log_type":1,"src_id":260103012,"trial_step":12},{"step":13,"speaker":"艾瑞尔","content":"如果……我当时没有打伤父亲……会不会就此改变他对我的看法呢？","style":1,"background":1011,"log_type":1,"src_id":260103013,"trial_step":13},{"step":14,"content":"都已经过去了。","style":2,"background":1011,"log_type":1,"src_id":260103014,"trial_step":14},{"step":15,"speaker":"艾瑞尔","content":"是啊，都过去了。","style":1,"background":1011,"log_type":1,"src_id":260103015,"trial_step":15},{"step":16,"speaker":"艾瑞尔","content":"我明白的，就算改变了父亲也改变不了整个新城的偏见。","style":1,"background":1011,"log_type":1,"src_id":260103016,"trial_step":16},{"step":17,"speaker":"艾瑞尔","content":"与其给家族平添烦忧，还是这样更好。","style":1,"background":1011,"log_type":1,"src_id":260103017,"trial_step":17},{"step":18,"speaker":"艾瑞尔","content":"一直不被允许插手家中事务的艾瑞尔，也算是和家族有了共同的秘密。","style":1,"background":1011,"log_type":1,"src_id":260103018,"trial_step":18},{"step":19,"speaker":"艾瑞尔","content":"只是，父亲……会一直以为自己杀死了我，这会让他有片刻的愧疚吗？","style":1,"background":1011,"log_type":1,"src_id":260103019,"trial_step":19},{"step":20,"content":"艾瑞尔神色复杂地看着远处的仪仗。","style":3,"background":1011,"log_type":1,"src_id":260103020,"trial_step":20},{"step":21,"speaker":"艾瑞尔","content":"用这种方式来让父亲或多或少在意我一些，我也有了卑鄙的私心呢……","style":1,"background":1011,"log_type":1,"src_id":260103021,"trial_step":21},{"step":22,"options":["他可能不会在意你","这不卑鄙"],"style":6,"background":1011,"log_type":1,"src_id":260103022,"trial_step":22,"course":3,"choices":[{"text":"他可能不会在意你","goto":23},{"text":"这不卑鄙","goto":null}]},{"step":23,"content":"他之前那么羞辱你，甚至直接对你开枪。","style":2,"background":1011,"log_type":1,"src_id":260103023,"trial_step":23},{"step":24,"content":"在葛昂辛的自私和无情面前，你这都不算什么。","style":2,"background":1011,"log_type":1,"src_id":260103024,"trial_step":24},{"step":25,"content":"……自从上次得知了你回家的真实目的，我才认识到原来你不是我想象中的那么单纯不谙世事，你比我以为的要聪明一些。","style":2,"background":1011,"log_type":1,"src_id":260103025,"trial_step":25},{"step":26,"speaker":"艾瑞尔","content":"诶……？原来局长一直觉得我很笨么？","style":1,"background":1011,"log_type":1,"src_id":260103026,"trial_step":26},{"step":27,"content":"我还没见过有人明目张胆救狂厄的。","style":2,"background":1011,"log_type":1,"src_id":260103027,"trial_step":27},{"step":28,"content":"但是话又说回来，我也需要向你道歉。","style":2,"background":1011,"log_type":1,"src_id":260103028,"trial_step":28},{"step":29,"content":"禁闭者大多是有罪之人，在听了你坦白的经历后，我其实并不相信你。","style":2,"background":1011,"log_type":1,"src_id":260103029,"trial_step":29},{"step":30,"speaker":"艾瑞尔","content":"局长怀疑过我？","style":1,"background":1011,"log_type":1,"src_id":260103030,"trial_step":30},{"step":31,"content":"……被审查的时候你难道一点都没察觉到吗？","style":2,"background":1011,"log_type":1,"src_id":260103031,"trial_step":31},{"step":32,"speaker":"艾瑞尔","content":"我……我那时太紧张了……","style":1,"background":1011,"log_type":1,"src_id":260103032,"trial_step":32},{"step":33,"speaker":"艾瑞尔","content":"我以为只要我如实交代，您就会相信的……","style":1,"background":1011,"log_type":1,"src_id":260103033,"trial_step":33},{"step":34,"content":"果然还是个笨蛋啊……","style":2,"background":1011,"log_type":1,"src_id":260103034,"trial_step":34},{"step":35,"content":"闲聊间，送葬的仪仗队正从庄园缓缓走向墓地。","style":3,"background":1011,"log_type":1,"src_id":260103035,"trial_step":35},{"step":36,"options":["时间到了"],"style":6,"background":1011,"log_type":1,"src_id":260103036,"trial_step":36,"course":3},{"step":37,"content":"你不能被他们发现，我们该走了。","style":2,"background":1011,"log_type":1,"src_id":260103037,"trial_step":37},{"step":38,"speaker":"艾瑞尔","content":"好。","style":1,"background":1011,"log_type":1,"src_id":260103038,"trial_step":38},{"step":39,"content":"艾瑞尔最后一次望向斯宾塞家的庄园，眼底深深的眷恋与不舍几乎夺眶而出，就好像是要将那里的景色永远铭刻进回忆里一般。","style":3,"background":1011,"log_type":1,"src_id":260103039,"trial_step":39},{"step":40,"content":"像是过了很久很久，又像是仅仅过了一秒钟，她转头对你露出了一个微笑。","style":3,"background":1011,"log_type":1,"src_id":260103040,"trial_step":40},{"step":41,"speaker":"艾瑞尔","content":"我们……回家吧。","style":1,"background":1011,"log_type":1,"src_id":260103041,"trial_step":41},{"step":42,"content":"晚风吹乱了艾瑞尔的刘海，她的眼底隐隐有光芒闪动。","style":3,"background":1011,"log_type":1,"src_id":260103042,"trial_step":42},{"step":43,"content":"家……吗。你的心中一时五味杂陈。","style":3,"background":1011,"log_type":1,"src_id":260103043,"trial_step":43},{"step":44,"options":["你后悔吗？"],"style":6,"background":1011,"log_type":1,"src_id":260103044,"trial_step":44,"course":3,"choices":[{"text":"你后悔吗？","goto":45}]},{"step":45,"content":"救那个人……你后悔过吗？","style":2,"background":1011,"log_type":1,"src_id":260103045,"trial_step":45},{"step":46,"speaker":"艾瑞尔","content":"不后悔。","style":1,"background":1011,"log_type":1,"src_id":260103046,"trial_step":46},{"step":47,"content":"那你后悔离开斯宾塞家锦衣玉食的生活吗？","style":2,"background":1011,"log_type":1,"src_id":260103047,"trial_step":47},{"step":48,"content":"她伸手轻轻抚过石碑上的姓氏，黄昏的最后一束日光跳跃在黑灰的石碑与她的指尖。","style":3,"background":1011,"log_type":1,"src_id":260103048,"trial_step":48},{"step":49,"speaker":"艾瑞尔","content":"不后悔。","style":1,"background":1011,"log_type":1,"src_id":260103049,"trial_step":49},{"step":50,"content":"不知是因为自身的能力的影响，还是心中的善意使然，此刻立于夕阳之下的艾瑞尔，美丽圣洁得宛若画中之人。","style":3,"background":1011,"log_type":1,"src_id":260103050,"trial_step":50},{"step":51,"content":"少女心底无声的祈愿随风而逝，融化在这无边的沉沉暮色里。","style":3,"background":10000,"log_type":1,"src_id":260103051,"trial_step":51},{"step":52,"speaker":"艾瑞尔","content":"……这个，要避光处理。放在这里比较好。","style":1,"background":2001,"log_type":1,"src_id":260103052,"trial_step":52},{"step":53,"speaker":"艾瑞尔","content":"嗯……这个要低温保存……要放到冰柜里才行。","style":1,"background":2001,"log_type":1,"src_id":260103053,"trial_step":53},{"step":54,"speaker":"艾瑞尔","content":"冰柜……冰柜……","style":1,"background":2001,"log_type":1,"src_id":260103054,"trial_step":54},{"step":55,"content":"艾瑞尔低着头，走向冰柜，全然没有发现站在冰柜前的你。","style":3,"background":2001,"log_type":1,"src_id":260103055,"trial_step":55},{"step":56,"options":["我来帮你放吧"],"style":6,"background":2001,"log_type":1,"src_id":260103056,"trial_step":56,"course":3,"choices":[{"text":"我来帮你放吧","goto":57}]},{"step":57,"speaker":"艾瑞尔","content":"谢谢……诶？","style":1,"background":2001,"log_type":1,"src_id":260103057,"trial_step":57},{"step":58,"speaker":"艾瑞尔","content":"局长？您怎么来了。","style":1,"background":2001,"log_type":1,"src_id":260103058,"trial_step":58},{"step":59,"content":"我来看看你最近的情况。","style":2,"background":2001,"log_type":1,"src_id":260103059,"trial_step":59},{"step":60,"speaker":"艾瑞尔","content":"请不用担心，自从加入医疗队之后，艾瑞尔也有了不少进步呢。","style":1,"background":2001,"log_type":1,"src_id":260103060,"trial_step":60},{"step":61,"speaker":"艾瑞尔","content":"您看，我正在帮忙进行药品管理的工作。","style":1,"background":2001,"log_type":1,"src_id":260103061,"trial_step":61},{"step":62,"content":"额……但你手里这瓶试剂，并不需要低温保存。","style":2,"background":2001,"log_type":1,"src_id":260103062,"trial_step":62},{"step":63,"speaker":"艾瑞尔","content":"啊……真的……","style":1,"background":2001,"log_type":1,"src_id":260103063,"trial_step":63},{"step":64,"content":"艾瑞尔手忙脚乱地辨识药水的标签，完全不像是得到成长的样子。","style":3,"background":2001,"log_type":1,"src_id":260103064,"trial_step":64},{"step":65,"content":"你不如先从简单的工作做起，这样不太容易出错。","style":2,"background":2001,"log_type":1,"src_id":260103065,"trial_step":65},{"step":66,"speaker":"艾瑞尔","content":"相信我，局长，我真的可以的……这个应该是放在这里的没错吧？","style":1,"background":2001,"log_type":1,"src_id":260103066,"trial_step":66},{"step":67,"content":"她似乎不帮上些忙就不肯罢休，你也不好再阻止。","style":3,"background":2001,"log_type":1,"src_id":260103067,"trial_step":67},{"step":68,"content":"除了看望你，我还有别的好消息要带给你。","style":2,"background":2001,"log_type":1,"src_id":260103068,"trial_step":68},{"step":69,"speaker":"艾瑞尔","content":"……好消息？","style":1,"background":2001,"log_type":1,"src_id":260103069,"trial_step":69},{"step":70,"content":"关于商恩的。","style":2,"background":2001,"log_type":1,"src_id":260103070,"trial_step":70},{"step":71,"speaker":"艾瑞尔","content":"商恩是？","style":1,"background":2001,"log_type":1,"src_id":260103071,"trial_step":71},{"step":72,"content":"你在新城放跑的人，我们在辛迪加找到了她。","style":2,"background":2001,"log_type":1,"src_id":260103072,"trial_step":72},{"step":73,"content":"她的M值暂时没有继续增长的迹象，已经开始了新的生活。","style":2,"background":2001,"log_type":1,"src_id":260103073,"trial_step":73},{"step":74,"speaker":"艾瑞尔","content":"真的！太好了……我真的帮到她了！","style":1,"background":2001,"log_type":1,"src_id":260103074,"trial_step":74},{"step":75,"content":"她笑着长舒一口气，将手中的药水放进了冰柜。","style":3,"background":2001,"log_type":1,"src_id":260103075,"trial_step":75},{"step":76,"content":"“咔嚓！”","style":3,"background":2001,"log_type":1,"src_id":260103076,"trial_step":76},{"step":77,"speaker":"艾瑞尔","content":"局长有没有听到什么声音？","style":1,"background":2001,"log_type":1,"src_id":260103077,"trial_step":77},{"step":78,"content":"好像是药水试管裂开的声音？","style":2,"background":2001,"log_type":1,"src_id":260103078,"trial_step":78},{"step":79,"speaker":"艾瑞尔","content":"糟了！这个也不能低温保存！","style":1,"background":2001,"log_type":1,"src_id":260103079,"trial_step":79}]}