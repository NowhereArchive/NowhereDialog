{"id":404320601,"chapter_id":50088,"scene_id":58856,"steps":[{"step":1,"content":"地窖","style":9,"background":10000,"log_type":1},{"step":2,"content":"【地窖】","style":18,"background":2504,"log_type":1},{"step":3,"content":"漆黑的地道中，传来了脚步声。","style":3,"background":2504,"log_type":1},{"step":4,"speaker":"？？？","content":"喂——我来了。","voice":["vo_event_404320601_01"],"voice_bank":"vo_event_43206","style":1,"background":2504,"log_type":1},{"step":5,"speaker":"？？？","content":"我看到你藏的暗号了，你在哪里——！","voice":["vo_event_404320601_02"],"voice_bank":"vo_event_43206","style":1,"background":2504,"log_type":1},{"step":6,"content":"寂静中，人声传得很远，过了不久，墙壁中传来了管道的敲击声。","style":3,"background":2504,"log_type":1},{"step":7,"content":"（咚咚咚咚——）","style":18,"background":2504,"log_type":1},{"step":8,"speaker":"？？？","content":"*脏话*，就知道故弄玄虚。","voice":["vo_event_404320601_05"],"voice_bank":"vo_event_43206","style":1,"background":2504,"log_type":1},{"step":9,"content":"他耐着性子，也开始敲击墙壁管道。","style":3,"background":2504,"log_type":1},{"step":10,"content":"【转场、大厅、轻快的BGM】","style":18,"background":2503,"log_type":1},{"step":11,"speaker":"海伦娜","content":"……对，间谍有很多种类型。最常见一类是在本地发展的下线，平时做好一个普通人的职责，等到需要的时候再启用。","voice":["vo_event_404320601_08"],"voice_bank":"vo_event_43206","style":1,"background":2503,"log_type":1},{"step":12,"speaker":"海伦娜","content":"少见一些的就是专门派往某个部门进行潜伏的“卧底”，这种就需要专门配置一整套的合理身份，以及相应的辅助。","voice":["vo_event_404320601_09"],"voice_bank":"vo_event_43206","style":1,"background":2503,"log_type":1},{"step":13,"speaker":"海伦娜","content":"马洛那种就是“高级卧底”，你知道他为了在帮派里混到如今的地位牺牲了多少、杀了多少人？","voice":["vo_event_404320601_10"],"voice_bank":"vo_event_43206","style":1,"background":2503,"log_type":1},{"step":14,"content":"海伦娜半醉不醉地把酒杯落在桌上，向你凑近了一些。","style":3,"background":2503,"log_type":1},{"step":15,"speaker":"海伦娜","content":"所以说，他是个坏人，我可一点都不吃惊。","voice":["vo_event_404320601_12"],"voice_bank":"vo_event_43206","style":1,"background":2503,"log_type":1},{"step":16,"content":"你不动声色地往后挪了一点，避开她的抚摸。","style":3,"background":2503,"log_type":1},{"step":17,"speaker":"局长","content":"看来你是真的很恨他。","style":2,"background":2503,"log_type":1},{"step":18,"speaker":"海伦娜","content":"当然，我会变成这样还不都是他害的？","voice":["vo_event_404320601_14"],"voice_bank":"vo_event_43206","style":1,"background":2503,"log_type":1},{"step":19,"content":"似乎察觉到自己有些失态，女人摇了摇一旁的酒瓶，发现已经空了。","style":3,"background":2503,"log_type":1},{"step":20,"speaker":"海伦娜","content":"和长官聊天就是开心，我再去拿一瓶……","voice":["vo_event_404320601_16"],"voice_bank":"vo_event_43206","style":1,"background":2503,"log_type":1},{"step":21,"content":"她摇摇晃晃地起身，忽然被窗外的某个东西吸引了目光。","style":3,"background":2503,"log_type":1},{"step":22,"speaker":"海伦娜","content":"喂……那……那是什么？","voice":["vo_event_404320601_18"],"voice_bank":"vo_event_43206","style":1,"background":2503,"log_type":1},{"step":23,"content":"【外景、雨、加个火焰特效】","style":18,"background":2511,"log_type":1},{"step":24,"speaker":"海伦娜","content":"快看，别馆是不是着火了？！","voice":["vo_event_404320601_20"],"voice_bank":"vo_event_43206","style":1,"background":2511,"log_type":1},{"step":25,"speaker":"曼菲斯特","content":"还真是……但现在这种大雨的天气，再说这座庄园原本就是砖石结构，防火性能还是可以的……","voice":["vo_event_404320601_21"],"voice_bank":"vo_event_43206","style":1,"background":2511,"log_type":1},{"step":26,"speaker":"诺兰","content":"不对！那里是仓库，有油料储备——","voice":["vo_event_404320601_22"],"voice_bank":"vo_event_43206","style":1,"background":2511,"log_type":1},{"step":27,"content":"轰隆——！","style":3,"background":2503,"log_type":1},{"step":28,"content":"一声震天爆炸从窗外炸响，说不上是火药还是油桶爆炸的动静，巨大的震动让主楼这边的物品都劈里啪啦地掉了一地。","style":3,"background":2503,"log_type":1},{"step":29,"content":"巨响之后便是火光，伴随着滚滚浓烟向着主楼蔓延过来。","style":3,"background":2503,"log_type":1},{"step":30,"speaker":"曼菲斯特","content":"怎么又来了？！警卫！警卫呢！！快开门啊！放我们出去！这里要爆炸了！","voice":["vo_event_404320601_26"],"voice_bank":"vo_event_43206","style":1,"background":2503,"log_type":1},{"step":31,"content":"曼菲斯特扑到紧锁的大门上，大声呼救。","style":3,"background":2503,"log_type":1},{"step":32,"content":"又是一声巨响，更多的震动在脚下炸响。","style":3,"background":2503,"log_type":1},{"step":33,"content":"这是又一次的敌袭！却比今早的更加猛烈，更加危险！","style":3,"background":2503,"log_type":1},{"step":34,"speaker":"守卫","content":"各位不要慌张，目前只是别馆遇袭！我们已经增派人手去那儿了，请主楼的各位跟随我们立刻去避难！","voice":["vo_event_404320601_30"],"voice_bank":"vo_event_43206","style":1,"background":2503,"log_type":1},{"step":35,"speaker":"诺兰","content":"*脏话*——鼹鼠这混账！这回绝不会让你跑掉了！","voice":["vo_event_404320601_31"],"voice_bank":"vo_event_43206","style":1,"background":2503,"log_type":1},{"step":36,"content":"诺兰怒吼一声冲向了门廊，向着烟雾弥漫的方向奔去。","style":3,"background":2503,"log_type":1},{"step":37,"content":"海伦娜紧张地抓住了你的手。","style":3,"background":2503,"log_type":1},{"step":38,"options":["跟诺兰一起帮忙救火","趁机带海伦娜离开","上楼保护希露妲"],"style":34,"background":2503,"log_type":1}]}