102033},{"step":76,"speaker":"黛伦","content":"他们是不可能让这样的电影上狄斯卡的。","voice":["vo_trial_20301_1_70"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301078,"trial_step":78,"drawing":1102033},{"step":77,"options":["为什么？","即使是你拍的？"],"style":6,"log_type":1,"src_id":120301079,"trial_step":79,"course":3,"drawing":1102033,"choices":[{"text":"为什么？","goto":80},{"text":"即使是你拍的？","goto":84}]},{"step":78,"speaker":"黛伦","content":"还能有为什么啊~","voice":["vo_trial_20301_1_72"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301080,"trial_step":80,"drawing":1102032},{"step":79,"content":"黛伦掰着手指喃喃自语了半天，朝你伸出十只手指。","style":3,"log_type":1,"src_id":120301081,"trial_step":81,"drawing":1102032},{"step":80,"speaker":"黛伦","content":"我粗略算了下，大概有这么多为什么。","voice":["vo_trial_20301_1_74"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301082,"trial_step":82,"drawing":1102032},{"step":81,"speaker":"黛伦","content":"但是为了你写的审查报告能顺利提交上去呢，我就不说了。","voice":["vo_trial_20301_1_75"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301083,"trial_step":83,"drawing":1102032,"next":[88]},{"step":82,"speaker":"黛伦","content":"哈哈哈哈~你可真有意思。","voice":["vo_trial_20301_1_76"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301084,"trial_step":84,"drawing":1102033},{"step":83,"speaker":"黛伦","content":"什么叫即使是我拍的？","voice":["vo_trial_20301_1_77"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301085,"trial_step":85,"drawing":1102033},{"step":84,"speaker":"黛伦","content":"就是因为是我拍的……","voice":["vo_trial_20301_1_78"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301086,"trial_step":86,"drawing":1102034},{"step":85,"speaker":"黛伦","content":"他们才更加严格，更加不可理喻吧。","voice":["vo_trial_20301_1_79"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301087,"trial_step":87,"drawing":1102034},{"step":86,"content":"黛伦说完便陷入沉默，帽子遮住了她的眼睛，你看不清她这一刻的情绪。","style":3,"log_type":1,"src_id":120301088,"trial_step":88,"drawing":1102034},{"step":87,"content":"他们对你的诸多限制和……强行让你遵从他们的意愿，算是……你排斥外面那些人的原因吗？","style":2,"log_type":1,"src_id":120301089,"trial_step":89,"drawing":1102034},{"step":88,"content":"你转动了一下钢笔的笔帽，打开，再盖上，钢笔发出的咔哒声，有一点像场记牌合上的声音。","style":3,"log_type":1,"src_id":120301090,"trial_step":90,"drawing":1102034},{"step":89,"content":"黛伦听到声音，抬起头来，看着你摇了摇头。","style":3,"log_type":1,"src_id":120301091,"trial_step":91,"drawing":1102030},{"step":90,"speaker":"黛伦","content":"我不排斥他们。","voice":["vo_trial_20301_1_84"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301092,"trial_step":92,"drawing":1102030},{"step":91,"speaker":"黛伦","content":"我只是……觉得他们很无聊而已。","voice":["vo_trial_20301_1_85"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301093,"trial_step":93,"drawing":1102030},{"step":92,"content":"黛伦伸了伸懒腰，撑着脸，一副快要睡着的模样。","style":3,"log_type":1,"src_id":120301094,"trial_step":94,"drawing":1102030},{"step":93,"content":"但从前你似乎并没那么讨厌狄斯卡？息影前你应该参加了好几届吧？","style":2,"log_type":1,"src_id":120301095,"trial_step":95,"drawing":1102030},{"step":94,"speaker":"黛伦","content":"哎，再有才华的导演，也是要吃饭的，局长大人~","voice":["vo_trial_20301_1_88"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301096,"trial_step":96,"drawing":1102032},{"step":95,"speaker":"黛伦","content":"不过我现在，确实没有以前那么有棱角了。","voice":["vo_trial_20301_1_89"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301097,"trial_step":97,"drawing":1102032},{"step":96,"speaker":"黛伦","content":"你应该听说过吧，我拿奖的那届狄斯卡……就是我息影前最后参加的那场，我没有去。","voice":["vo_trial_20301_1_90"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301098,"trial_step":98,"drawing":1102032},{"step":97,"content":"听说了，不过没有人指责你，相反，很多人都觉得你这样的举动……","style":2,"log_type":1,"src_id":120301099,"trial_step":99,"drawing":1102032},{"step":98,"content":"相当有个性。","style":2,"log_type":1,"src_id":120301100,"trial_step":100,"drawing":1102032},{"step":99,"speaker":"黛伦","content":"个性？","voice":["vo_trial_20301_1_93"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301101,"trial_step":101,"drawing":1102030},{"step":100,"speaker":"黛伦","content":"我能有什么个性啊~","voice":["vo_trial_20301_1_94"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301102,"trial_step":102,"drawing":1102030},{"step":101,"speaker":"黛伦","content":"这只是还不够成熟的我做的一些还不够完美的抉择罢了。","voice":["vo_trial_20301_1_95"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301103,"trial_step":103,"drawing":1102030},{"step":102,"speaker":"黛伦","content":"至于观众，至于评委……","voice":["vo_trial_20301_1_96"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301104,"trial_step":104,"drawing":1102030},{"step":103,"content":"黛伦的眼睛总是带着笑的，微微睁开的眼睛，挡住了大部分的锋芒——","style":3,"log_type":1,"src_id":120301105,"trial_step":105,"drawing":1102030},{"step":104,"content":"她嗤笑了一声，沉下眼角，笑得看不见任何光亮。","style":3,"log_type":1,"src_id":120301106,"trial_step":106,"drawing":1102033},{"step":105,"speaker":"黛伦","content":"他们只会看到自己想看的，或是……看到别人安排自己想看的。","voice":["vo_trial_20301_1_99"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301107,"trial_step":107,"drawing":1102033},{"step":106,"content":"那你……是因为什么才不去的？","style":2,"log_type":1,"src_id":120301108,"trial_step":108,"drawing":1102033},{"step":107,"content":"狄斯卡，是电影人很高的成就奖项吧。","style":2,"log_type":1,"src_id":120301109,"trial_step":109,"drawing":1102033},{"step":108,"speaker":"黛伦","content":"送审的那部电影，不值得。","voice":["vo_trial_20301_1_102"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301110,"trial_step":110,"drawing":1102033},{"step":109,"speaker":"黛伦","content":"就算评委，观众，所有人都觉得它足以获得这样的成就。","voice":["vo_trial_20301_1_103"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301111,"trial_step":111,"drawing":1102033},{"step":110,"speaker":"黛伦","content":"但我自己不觉得。","voice":["vo_trial_20301_1_104"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301112,"trial_step":112,"drawing":1102033},{"step":111,"speaker":"黛伦","content":"所以我不必去——那个现场是他们的狂欢，与我无关。","voice":["vo_trial_20301_1_105"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301113,"trial_step":113,"drawing":1102033},{"step":112,"content":"黛伦语气轻松，似乎对这个至高的肯定毫不在意。","style":3,"log_type":1,"src_id":120301114,"trial_step":114,"drawing":1102033},{"step":113,"content":"我好像还是第一次见到导演与观众的意愿这么背道而驰的。","style":2,"log_type":1,"src_id":120301115,"trial_step":115,"drawing":1102033},{"step":114,"content":"看来是电影本身出了什么问题吧。","style":2,"log_type":1,"src_id":120301116,"trial_step":116,"drawing":1102033},{"step":115,"speaker":"黛伦","content":"你……还挺敏锐的嘛。","voice":["vo_trial_20301_1_109"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301117,"trial_step":117,"drawing":1102033},{"step":116,"speaker":"黛伦","content":"那不妨来猜一下吧，场记先生，哪个是真实的理由，哪个是虚假的理由。","female_content":"那不妨来猜一下吧，场记小姐，哪个是真实的理由，哪个是虚假的理由。","voice":["vo_trial_20301_1_110","vo_trial_20301_1_110f"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301118,"trial_step":118,"drawing":1102033},{"step":117,"content":"黛伦眯着眼睛看着你，脸上的笑容似曾相识。","style":3,"log_type":1,"src_id":120301119,"trial_step":119,"drawing":1102033},{"step":118,"speaker":"黛伦","content":"落难的救生艇上，只剩下一个女人，一头老虎，还有一只狗、一只猴子、一只河马。","voice":["vo_trial_20301_1_112"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301120,"trial_step":120,"drawing":1102033},{"step":119,"speaker":"黛伦","content":"为了生存，狗与猴子还有河马共同袭击了危险的老虎，老虎向女人求救，女人却说道：","voice":["vo_trial_20301_1_113"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301121,"trial_step":121,"drawing":1102033},{"step":120,"speaker":"黛伦","content":"“为了我们能活下来。”","voice":["vo_trial_20301_1_114"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301122,"trial_step":122,"drawing":1102033},{"step":121,"speaker":"黛伦","content":"但其实她知道，她心里想的是——“为了你能活下来。”","voice":["vo_trial_20301_1_115"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301123,"trial_step":123,"drawing":1102033},{"step":122,"speaker":"黛伦","content":"来吧，猜猜看吧。","voice":["vo_trial_20301_1_116"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301124,"trial_step":124,"drawing":1102033},{"step":123,"options":["说出来的是虚假","说出来的是真实"],"style":6,"log_type":1,"src_id":120301125,"trial_step":125,"course":3,"drawing":1102033,"choices":[{"text":"说出来的是虚假","goto":126},{"text":"说出来的是真实","goto":127}]},{"step":124,"speaker":"黛伦","content":"这很符合大家通常的想法。","voice":["vo_trial_20301_1_118"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301126,"trial_step":126,"drawing":1102033,"next":[128]},{"step":125,"speaker":"黛伦","content":"你确实是一个不按常理思考的孩子，我喜欢。","voice":["vo_trial_20301_1_119"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301127,"trial_step":127,"drawing":1102033},{"step":126,"speaker":"黛伦","content":"但实际上，无论真实或虚假，其实根本不重要——重要的只是你怎么选择而已。","voice":["vo_trial_20301_1_120"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301128,"trial_step":128,"drawing":1102033},{"step":127,"speaker":"黛伦","content":"所以，女人带着那只老虎……一起跳下了大海，消失在所有人眼里。","voice":["vo_trial_20301_1_121"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301129,"trial_step":129,"drawing":1102033},{"step":128,"content":"……","style":2,"log_type":1,"src_id":120301130,"trial_step":130,"drawing":1102033},{"step":129,"content":"你……我是说，她和老虎消失了，但“救生艇”和“救济粮”还在，对吧？","style":2,"log_type":1,"src_id":120301131,"trial_step":131,"drawing":1102033},{"step":130,"speaker":"黛伦","content":"没错，所有物种围着它忙碌着，庆贺着，就像宾客们知道自己的名字写在了大人物的<color=#fb9259>《舞会名册》</color>上一样，也不管这名字是由自己的意愿加上去的，还是别人硬塞给自己的。","voice":["vo_trial_20301_1_124"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301132,"trial_step":132,"drawing":1102033},{"step":131,"content":"难道说……","style":2,"log_type":1,"src_id":120301133,"trial_step":133,"drawing":1102033},{"step":132,"speaker":"黛伦","content":"对，其实是个很简单的答案——送过去的电影，并不是我剪辑的版本。","voice":["vo_trial_20301_1_126"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301134,"trial_step":134,"drawing":1102033},{"step":133,"content":"黛伦说得轻描淡写，你却瞬间明白了。","style":3,"log_type":1,"src_id":120301135,"trial_step":135,"drawing":1102033},{"step":134,"content":"连嗷呜这样的初学者，都知道要自己盯着剪辑，只有这样，才能把导演心目中原本想要呈现的故事表现出来。","style":3,"log_type":1,"src_id":120301136,"trial_step":136,"drawing":1102033},{"step":135,"content":"如若换了他人来剪辑……总会失去一些自己的想法。","style":3,"log_type":1,"src_id":120301137,"trial_step":137,"drawing":1102033},{"step":136,"content":"严重的情况下，导演版和剪辑版，甚至会出现意图完全不一样的情况。","style":3,"log_type":1,"src_id":120301138,"trial_step":138,"drawing":1102033},{"step":137,"content":"原本这部电影……是想表达些什么呢？","style":2,"log_type":1,"src_id":120301139,"trial_step":139,"drawing":1102033},{"step":138,"speaker":"黛伦","content":"唔……","voice":["vo_trial_20301_1_132"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301140,"trial_step":140,"drawing":1102033},{"step":139,"speaker":"黛伦","content":"我不记得了。","voice":["vo_trial_20301_1_133"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301141,"trial_step":141,"drawing":1102031},{"step":140,"content":"黛伦低着头思考了好一会儿，抬起头看着你时，却耸耸肩来了这么一句。","style":3,"log_type":1,"src_id":120301142,"trial_step":142,"drawing":1102031},{"step":141,"speaker":"黛伦","content":"反正它早就被改得面目全非，就算放给我看我也不一定能记得起来了。","voice":["vo_trial_20301_1_135"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301143,"trial_step":143,"drawing":1102031},{"step":142,"speaker":"黛伦","content":"我也不明白，为什么现在的人还在反复咀嚼这部与我无关的片子。","voice":["vo_trial_20301_1_136"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301144,"trial_step":144,"drawing":1102031},{"step":143,"speaker":"黛伦","content":"或许就是因为……太无聊了吧。","voice":["vo_trial_20301_1_137"],"voice_bank":"vo_deren_trial","style":1,"log_type":1,"src_id":120301145,"trial_step":145,"drawing":1102031},{"step":144,"content":"她肯定不是不记得了……","style":3,"log_type":1,"src_id":120301146,"trial_step":146,"drawing":1102030},{"step":145,"content":"你看着开始闭目养神的黛伦，暗暗腹诽。","style":3,"log_type":1,"src_id":120301147,"trial_step":147,"drawing":1102030},{"step":146,"content":"但无论如何，黛伦始终不愿意再提起有关于那部电影的事情，对此你也只好暂时作罢，结束了这场例行询问。","style":3,"log_type":1,"src_id":120301148,"trial_step":148,"drawing":1102030}]}