{"id":1021001,"chapter_id":1021001,"scene_id":1,"steps":[{"step":1,"content":"【梦境，啸风的过去。背景-山路】","style":18,"background":2575,"log_type":1,"src_id":121001001,"trial_step":1},{"step":2,"content":"东洲某处山间，一小队村民正在沿着小路向上攀行。","style":3,"background":2575,"log_type":1,"src_id":121001002,"trial_step":2},{"step":3,"content":"前日刚下过雪，山里冷得刺骨。一片白茫茫间，有什么东西从树林中一晃而过，撞到树枝。枝干摇晃，上面积的雪簌簌地落下几块，又再次恢复平静。","style":3,"background":2575,"log_type":1,"src_id":121001003,"trial_step":3},{"step":4,"content":"行在山中的旅人一哆嗦，颤巍巍地向同伴开口。","style":3,"background":2575,"log_type":1,"src_id":121001004,"trial_step":4},{"step":5,"speaker":"胆小的村民","content":"喂……你有没有听见什么声音？","voice":["vo_trial_21001_1_1"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121001005,"trial_step":5},{"step":6,"speaker":"慌张的村民","content":"别自己吓自己！快走快走，老虎争地盘，小心等会儿追出来咬人。","voice":["vo_trial_21001_1_2"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121001006,"trial_step":6},{"step":7,"content":"身披蓑衣斗笠的山民互相推搡着，快步离去。而在他们并未注意到的地方，一双藏匿在积雪下方的眼睛注视着刚刚发生的一切。","style":3,"background":2575,"log_type":1,"src_id":121001007,"trial_step":7},{"step":8,"speaker":"？？","content":"………………","voice":["vo_trial_21001_1_3"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121001008,"trial_step":8},{"step":9,"content":"确认人类已经远去，她再也撑不住身形，腿一软歪倒在旁侧的树干上。腿上的伤口因过度活动再次裂开，灼痛燃烧着神经，血沿着小腿淌下，把脚边的白雪也染上红色。","style":3,"background":2575,"log_type":1,"src_id":121001009,"trial_step":9},{"step":10,"content":"得赶紧走，找个安全的地方等伤恢复……但身体却再难站起。疼痛加剧，意识也开始变得模糊。","style":3,"background":2575,"log_type":1,"src_id":121001010,"trial_step":10},{"step":11,"speaker":"？？","content":"……呃啊…………","voice":["vo_trial_21001_1_4"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121001011,"trial_step":11},{"step":12,"content":"一阵风吹过，枝叶翕动发出阵阵声响。疼痛麻痹了警觉，她后知后觉地意识到这声音中似乎夹了些杂音。","style":3,"background":2575,"log_type":1,"src_id":121001012,"trial_step":12},{"step":13,"content":"【演出，空场2s+脚步声】","style":18,"background":2575,"log_type":1,"src_id":121001013,"trial_step":13},{"step":14,"speaker":"模糊的人声","content":"你…………","voice":["vo_trial_21001_1_5"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121001014,"trial_step":14},{"step":15,"content":"【过渡一下，进入现实。当下时间，东洲山林】","style":18,"background":2580,"log_type":1,"src_id":121001015,"trial_step":15},{"step":16,"content":"鸟儿倏地腾空。振翅声惊扰了女人的梦境，她缓缓睁开眼。","style":3,"background":2580,"log_type":1,"src_id":121001016,"trial_step":16},{"step":17,"content":"窝在她身侧的白虎张大嘴打了个哈欠，舔舔爪子又盘了起来，斜睨正靠在自己身上睡大觉的人。","style":3,"background":2580,"log_type":1,"src_id":121001017,"trial_step":17},{"step":18,"speaker":"？？","content":"啊呀……嗯~","voice":["vo_trial_21001_1_6"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121001018,"trial_step":18},{"step":19,"content":"女人懒散地伸了个懒腰，又顺手撸了几把旁边的老虎。老虎油光水滑的皮毛顿时变得乱糟糟。","style":3,"background":2580,"log_type":1,"src_id":121001019,"trial_step":19},{"step":20,"content":"还未等对方反应，她又挠上老虎下巴。老虎被伺候得舒服，满意地把脑袋拱进女人手心。","style":3,"background":2580,"log_type":1,"src_id":121001020,"trial_step":20},{"step":21,"speaker":"啸风","content":"吃饱喝足，还是得睡一觉最舒坦。是吧，大咪？","voice":["vo_trial_21001_1_7"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121001021,"trial_step":21},{"step":22,"content":"白虎以呼噜声回应。","style":3,"background":2580,"log_type":1,"src_id":121001022,"trial_step":22},{"step":23,"content":"啸风揉了把虎头，这才起身望向山下。今天阳光正好，冰雪初融。她像是想起什么，若有所思。","style":3,"background":2580,"log_type":1,"src_id":121001023,"trial_step":23},{"step":24,"speaker":"啸风","content":"今天外头这个天儿真不错，倒是适合出门溜溜……","voice":["vo_trial_21001_1_8"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121001024,"trial_step":24},{"step":25,"speaker":"啸风","content":"咋样大咪，想不想找个比山下更得劲的地方玩玩？","voice":["vo_trial_21001_1_9"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121001025,"trial_step":25},{"step":26,"content":"【背景-MBCC内】","style":18,"background":1040,"log_type":1,"src_id":121001026,"trial_step":26},{"step":27,"content":"N.F.116年 朔雪山庄事件后\nMBCC管理局内","style":9,"background":1040,"log_type":1,"src_id":121001027,"trial_step":27},{"step":28,"content":"意思是……需要年底多加个班？","style":2,"background":1040,"log_type":1,"src_id":121001028,"trial_step":28},{"step":29,"content":"你正坐在自己的办公桌前，与夜莺新递上来的文档面面相觑。","style":3,"background":1040,"log_type":1,"src_id":121001029,"trial_step":29},{"step":30,"speaker":"夜莺","content":"是的，西区重建组委发来求助，有一名危险人士在辛迪加出没，目前已犯下数起案件，事件规模和影响都远超正常范围。","voice":["vo_trial_21001_1_10"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1040,"log_type":1,"src_id":121001030,"trial_step":30},{"step":31,"speaker":"夜莺","content":"西区刚从BR002的伤痛中恢复，委员会希望我们能尽快抓到嫌犯，低调行事，避免局面进一步恶化。","voice":["vo_trial_21001_1_11"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1040,"log_type":1,"src_id":121001031,"trial_step":31},{"step":32,"speaker":"夜莺","content":"而且今年……比较特殊。上庭那位将军几次三番替您申请带薪假，您的书面行动报告相比去年，确实稍有些……","voice":["vo_trial_21001_1_12"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1040,"log_type":1,"src_id":121001032,"trial_step":32},{"step":33,"options":["行，明白，都明白"],"style":6,"background":1040,"log_type":1,"src_id":121001033,"trial_step":33,"course":3,"choices":[{"text":"行，明白，都明白","goto":34}]},{"step":34,"content":"看来我还得谢谢他们及时送温暖，送来的绩效大礼包。","style":2,"background":1040,"log_type":1,"src_id":121001034,"trial_step":34},{"step":35,"content":"走吧，让我们看看这位嫌犯到底去哪了。","style":2,"background":1040,"log_type":1,"src_id":121001035,"trial_step":35},{"step":36,"content":"【换场景，辛迪加另一条街道】","style":18,"background":2015,"log_type":1,"src_id":121001036,"trial_step":36},{"step":37,"content":"你带领着追缉小队，沿着这位破坏分子留下的犯罪现场一路排查。","style":3,"background":2015,"log_type":1,"src_id":121001037,"trial_step":37},{"step":38,"content":"对象造成的破坏范围之广、数量之多，几乎没有隐藏自己的行迹。按理说，本应很好追查，但……","style":3,"background":2015,"log_type":1,"src_id":121001038,"trial_step":38},{"step":39,"content":"【快切】","style":18,"background":100,"log_type":1,"src_id":121001039,"trial_step":39},{"step":40,"speaker":"烤肉店店长","content":"两只鸡、十八个猪蹄、一整头羊——还有后厨那那那几只总爱翻垃圾的猫，全消失了！肯定是被那家伙逮走吃了！","voice":["vo_trial_21001_1_13"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":100,"log_type":1,"src_id":121001040,"trial_step":40},{"step":41,"speaker":"烤肉店店长","content":"就像那哥什么拉……啊？您没听说过？没引进啊……嗨！我哪儿敢倒卖走私碟啊？我们这片放映机都没几台，您说是不是，哈哈……","voice":["vo_trial_21001_1_14"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":100,"log_type":1,"src_id":121001041,"trial_step":41},{"step":42,"speaker":"烤肉店店长","content":"一定要把那家伙捉拿归案啊大英雄！来拿着拿着，千万别客气啊，常来啊……","voice":["vo_trial_21001_1_15"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":100,"log_type":1,"src_id":121001042,"trial_step":42},{"step":43,"content":"【快切】","style":18,"background":1038,"log_type":1,"src_id":121001043,"trial_step":43},{"step":44,"speaker":"珠宝销售员","content":"偷偷跟您说，那人VIP间的小点心都没剩下，连着展柜里的虎爪手链一起，全都打包带走了。但那个特容易倒的珐琅彩甜点架子倒没事，真奇怪。","voice":["vo_trial_21001_1_16"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1038,"log_type":1,"src_id":121001044,"trial_step":44},{"step":45,"speaker":"珠宝销售员","content":"喏，被偷的首饰就是这套，您看看……当然，试戴一下也可以~","voice":["vo_trial_21001_1_17"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1038,"log_type":1,"src_id":121001045,"trial_step":45},{"step":46,"speaker":"珠宝销售员","content":"还真别说，这个猫眼祖母绿蛮衬您的嘞。不买没关系的，这是我的名片，随时保持联系呀~","voice":["vo_trial_21001_1_18"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1038,"log_type":1,"src_id":121001046,"trial_step":46},{"step":47,"content":"【快切】","style":18,"background":1004,"log_type":1,"src_id":121001047,"trial_step":47},{"step":48,"speaker":"游乐园经理","content":"东西？没丢东西，可是丢了整整八个孩子！","voice":["vo_trial_21001_1_19"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1004,"log_type":1,"src_id":121001048,"trial_step":48},{"step":49,"speaker":"游乐园经理","content":"几个监控画面都是正常的，也没发现行径可疑的人……发生这种事，我比你们更着急！我们连自己的损失都没盘点呢！","voice":["vo_trial_21001_1_20"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1004,"log_type":1,"src_id":121001049,"trial_step":49},{"step":50,"speaker":"游乐园经理","content":"瞧瞧，爆米花机、跷跷板、小鸭子游泳圈——还有这套猫猫玩偶服，全坏了！都得报废！","voice":["vo_trial_21001_1_21"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1004,"log_type":1,"src_id":121001050,"trial_step":50},{"step":51,"speaker":"游乐园经理","content":"玩偶服？孩子们是挺喜欢的，总喜欢追着它跑。不过这个大小的玩偶，我们一般会找一米八以上的壮小伙子来扮，不然撑不起裙摆……商业机密，可别说出去啊！","voice":["vo_trial_21001_1_22"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1004,"log_type":1,"src_id":121001051,"trial_step":51},{"step":52,"content":"【快切】","style":18,"background":2015,"log_type":1,"src_id":121001052,"trial_step":52},{"step":53,"speaker":"夜莺","content":"……以上，就是近期在辛迪加流窜的破坏分子的全部情报。","voice":["vo_trial_21001_1_23"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121001053,"trial_step":53},{"step":54,"content":"此刻，你们正在最新的“犯罪”现场——这里先前大概是个停车场，但现在，几辆货车撞在一起，车头变形扭曲，原本应该落在地面上的轮胎仰着朝天。场面颇为壮观。","style":3,"background":2015,"log_type":1,"src_id":121001054,"trial_step":54},{"step":55,"options":["这是怎么回事？"],"style":6,"background":2015,"log_type":1,"src_id":121001055,"trial_step":55,"course":3,"choices":[{"text":"这是怎么回事？","goto":56}]},{"step":56,"speaker":"夜莺","content":"这里曾经是几只黑帮势力的交易点，在西区重建后，多数黑帮被肃清，但仍有余党在地下活动。","voice":["vo_trial_21001_1_24"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121001056,"trial_step":56},{"step":57,"speaker":"夜莺","content":"这几辆货车属于一支往返于东洲与狄斯间的走私商队，大概是想来这里卸货，却被第三方势力袭击，人财两空。","voice":["vo_trial_21001_1_25"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121001057,"trial_step":57},{"step":58,"content":"在距离你最近的车厢铁皮上印着几道极其恐怖的深刻裂痕。不难想象这里曾经历过怎样一场激烈的争斗。","style":3,"background":2015,"log_type":1,"src_id":121001058,"trial_step":58},{"step":59,"content":"你一边查看现场，一边试图通过已有的信息推演嫌犯的形象。","style":3,"background":2015,"log_type":1,"src_id":121001059,"trial_step":59},{"step":60,"content":"身手敏健，行踪诡谲，从攻击痕迹看身高接近两米，还拥有一身怪力。而且不仅拐孩子，甚至连街上的流浪猫都不放过……","style":2,"background":2015,"log_type":1,"src_id":121001060,"trial_step":60},{"step":61,"content":"越说越离谱了。你忍不住揉揉眉心，看来这次要抓的是块硬骨头。","style":3,"background":2015,"log_type":1,"src_id":121001061,"trial_step":61},{"step":62,"options":["检查货车车厢"],"style":6,"background":2015,"log_type":1,"src_id":121001062,"trial_step":62,"course":3,"choices":[{"text":"检查货车车厢","goto":63}]},{"step":63,"content":"你靠近破损的铁皮车厢。曾经载满违禁品的箱体四零八落倒了满地，各类货物混成一团。你目光停在车厢一角，突然皱眉。","style":3,"background":2015,"log_type":1,"src_id":121001063,"trial_step":63},{"step":64,"content":"……嗯？这里还有食物？","style":2,"background":2015,"log_type":1,"src_id":121001064,"trial_step":64},{"step":65,"speaker":"夜莺","content":"主要是一些特色食品和进口零食，用来遮掩从东洲走私来的各类违禁物品。","voice":["vo_trial_21001_1_26"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121001065,"trial_step":65},{"step":66,"speaker":"夜莺","content":"局长？是有什么新发现吗？","voice":["vo_trial_21001_1_27"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2015,"log_type":1,"src_id":121001066,"trial_step":66},{"step":67,"content":"你探身进入车厢，从地上捡起一根短枝。干枯的褐色木枝，似乎被什么东西啃咬过，上面都是齿痕。","style":3,"background":2015,"log_type":1,"src_id":121001067,"trial_step":67},{"step":68,"content":"这是——","style":2,"background":2015,"log_type":1,"src_id":121001068,"trial_step":68},{"step":69,"options":["木天蓼？"],"style":6,"background":2015,"log_type":1,"src_id":121001069,"trial_step":69,"course":3,"choices":[{"text":"木天蓼？","goto":70}]},{"step":70,"content":"你弯下腰，直接上手将凌乱的杂物拨开，露出下方的痕迹——两只底部还留着些酒液的陶罐、几具已经被啃干净的动物骨架、还有一张做工粗糙却厚实的毛毯。","style":3,"background":2015,"log_type":1,"src_id":121001070,"trial_step":70},{"step":71,"content":"果然，这里才是最初的案件现场。有人跟着这箱走私的货品一起，从东洲偷渡进来了。","style":2,"background":2015,"log_type":1,"src_id":121001071,"trial_step":71},{"step":72,"content":"至于这位偷渡者的身份……","style":3,"background":2015,"log_type":1,"src_id":121001072,"trial_step":72},{"step":73,"content":"夜莺，通知组委会，请他们帮个忙——","style":2,"background":2015,"log_type":1,"src_id":121001073,"trial_step":73},{"step":74,"content":"该把这位“嫌犯”钓出来见见面了。","style":2,"background":2015,"log_type":1,"src_id":121001074,"trial_step":74},{"step":75,"content":"【换个背景，还是辛迪加街道】","style":18,"background":121,"log_type":1,"src_id":121001075,"trial_step":75},{"step":76,"content":"一辆巨型货车停在某栋建筑的后方。司机下车，娴熟地敲开后门，与里侧的黑衣人碰头。","style":3,"background":121,"log_type":1,"src_id":121001076,"trial_step":76},{"step":77,"speaker":"黑衣人","content":"东西带来了吗？","voice":["vo_trial_21001_1_28"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001077,"trial_step":77},{"step":78,"speaker":"商队司机","content":"当然，之前的只是给兄弟们赶路垫吧垫吧的零嘴，这批才是真正的“好货”。","voice":["vo_trial_21001_1_29"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001078,"trial_step":78},{"step":79,"speaker":"黑衣人","content":"好。没被人追踪吧？","voice":["vo_trial_21001_1_30"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001079,"trial_step":79},{"step":80,"speaker":"商队司机","content":"我办事，你放心。喏，“厨子”本人也请来了，就在车上。","voice":["vo_trial_21001_1_31"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001080,"trial_step":80},{"step":81,"content":"司机回头，指了指从副驾驶座上下来的人。","style":3,"background":121,"log_type":1,"src_id":121001081,"trial_step":81},{"step":82,"content":"黑衣人终于点头，叫人开始验货。而司机趁机凑到那位“厨子”身边，压低声音开口。","style":3,"background":121,"log_type":1,"src_id":121001082,"trial_step":82},{"step":83,"speaker":"商队司机","content":"局长，目标仍未出现，要继续行动吗？","voice":["vo_trial_21001_1_32"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001083,"trial_step":83},{"step":84,"content":"……好。还有，下次别挂横幅，有点欲盖弥彰了，稍微动点脑子都能猜出有陷阱。","style":2,"background":121,"log_type":1,"src_id":121001084,"trial_step":84},{"step":85,"content":"你抬头看了眼头顶“欢迎东洲星级厨师莅临指导”的字样，松了松被厨师服勒紧的领口。","style":3,"background":121,"log_type":1,"src_id":121001085,"trial_step":85},{"step":86,"content":"不远处，由追缉队员伪装的黑衣人已经围在货车旁侧，缓缓将车门打开一条缝。所有人屏息凝神，看着其中一人上前，从车内取出你特意申请来的战略物资——","style":3,"background":121,"log_type":1,"src_id":121001086,"trial_step":86},{"step":87,"content":"几只表皮金黄、香气四溢的正宗东洲熏鸡。","style":3,"background":121,"log_type":1,"src_id":121001087,"trial_step":87},{"step":88,"content":"全员戒备，等待指令……","style":2,"background":121,"log_type":1,"src_id":121001088,"trial_step":88},{"step":89,"content":"一秒，两秒……肉制品的香气随风扩散。后街安静得只能听见脚步声。","style":3,"background":121,"log_type":1,"src_id":121001089,"trial_step":89},{"step":90,"content":"你安静地等待着，眼看那只放熏鸡的箱子被抬出来，逐渐靠近，就在即将被搬入室内的前一秒——","style":3,"background":121,"log_type":1,"src_id":121001090,"trial_step":90},{"step":91,"content":"【演出，虎啸+飞跃音效】","style":18,"background":121,"log_type":1,"src_id":121001091,"trial_step":91},{"step":92,"content":"随着一声咆哮，一个庞然的身影掠过你的脑袋，猛地从车顶砸了下来！","style":3,"background":121,"log_type":1,"src_id":121001092,"trial_step":92},{"step":93,"content":"就是现在！动手！！","style":2,"background":121,"log_type":1,"src_id":121001093,"trial_step":93},{"step":94,"content":"货车像被压扁的铁皮玩具，发出骇人的破裂声。同时，巨网从天而降，将袭击者兜入其中。潜伏在暗处的追缉小队一拥而上，压制敌方。","style":3,"background":121,"log_type":1,"src_id":121001094,"trial_step":94},{"step":95,"content":"袭击者开始挣扎，扑腾着扬起地上的灰尘，巨力几乎将身上的追缉队员们掀翻。","style":3,"background":121,"log_type":1,"src_id":121001095,"trial_step":95},{"step":96,"content":"随着网逐渐收紧，袭击者的挣扎似乎也在逐渐减弱。你望向烟尘中那只身形巨大的怪物，突然觉得不太对。那外形有些太眼熟了，你不久前才见过它，那是……","style":3,"background":121,"log_type":1,"src_id":121001096,"trial_step":96},{"step":97,"content":"老虎？？？？？","style":2,"background":121,"log_type":1,"src_id":121001097,"trial_step":97},{"step":98,"speaker":"追缉队员","content":"——呃啊？！","voice":["vo_trial_21001_1_33"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001098,"trial_step":98},{"step":99,"content":"耳边突然传来一声惨叫。你回头，却发现身边的几个队员突然身体折叠，以诡异的姿势向后倒去，快速被烟尘吞噬。","style":3,"background":121,"log_type":1,"src_id":121001099,"trial_step":99},{"step":100,"content":"人类惨叫、枪声和野兽般的怒吼在四下响起回声。情急之下，你只有一个选择——","style":3,"background":121,"log_type":1,"src_id":121001100,"trial_step":100},{"step":101,"options":["使用枷锁！"],"style":6,"background":121,"log_type":1,"src_id":121001101,"trial_step":101,"course":3,"choices":[{"text":"使用枷锁！","goto":102}]},{"step":102,"content":"枷锁上的红光隐隐照亮烟雾，你看不清，却能感觉自己的身体在下一刻腾空。","style":3,"background":121,"log_type":1,"src_id":121001102,"trial_step":102},{"step":103,"content":"天旋地转，然后是胃部传来坚硬的触感——你后知后觉意识到，自己被什么人拽着离地，扛在了肩上。","style":3,"background":121,"log_type":1,"src_id":121001103,"trial_step":103},{"step":104,"speaker":"？？","content":"山君出马，巡视狄斯——","voice":["vo_trial_21001_1_34"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001104,"trial_step":104},{"step":105,"speaker":"？？","content":"小家伙，好久不见，想咱没有啊？","voice":["vo_trial_21001_1_35"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001105,"trial_step":105},{"step":106,"options":["啸风？！"],"style":6,"background":121,"log_type":1,"src_id":121001106,"trial_step":106,"course":3,"choices":[{"text":"啸风？！","goto":107}]},{"step":107,"content":"你疯了？？快放我下来！！！——呃！","style":2,"background":121,"log_type":1,"src_id":121001107,"trial_step":107},{"step":108,"content":"你垂着头看不见，只能听见追缉队成员们惊慌而愤怒的吼叫，接着胃部又被用力一顶，啸风拖着你跃上货车顶部，躲开追缉队的攻击。","style":3,"background":121,"log_type":1,"src_id":121001108,"trial_step":108},{"step":109,"speaker":"追缉队员","content":"快联系副官！火力压制，夺回局长！！！","voice":["vo_trial_21001_1_36"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001109,"trial_step":109},{"step":110,"speaker":"虎啸","content":"吼——！！","style":1,"background":121,"log_type":1,"src_id":121001110,"trial_step":110},{"step":111,"content":"似乎有人冲上来，但却被啸风一掌击退。发出一声长啸，长尾横扫，将周围的追缉队员全部荡开。","style":3,"background":121,"log_type":1,"src_id":121001111,"trial_step":111},{"step":112,"content":"停手！！啸风，你到底想要什么？！","style":2,"background":121,"log_type":1,"src_id":121001112,"trial_step":112},{"step":113,"content":"那个懒洋洋的、愉悦的声音鬼魅般在你头顶响起。你挣扎着抬头，正撞上一张得意的笑脸。","style":3,"background":121,"log_type":1,"src_id":121001113,"trial_step":113},{"step":114,"speaker":"啸风","content":"我跑这么大老远来找你玩，怎么还甩脸子了？不惊喜？不高兴？","voice":["vo_trial_21001_1_37"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001114,"trial_step":114},{"step":115,"content":"本来应该在东洲山里的老虎突然出现在狄斯，不是惊喜是惊吓！横幅你没看到吗？","style":2,"background":121,"log_type":1,"src_id":121001115,"trial_step":115},{"step":116,"speaker":"啸风","content":"我这俩眼睛又不是喘气儿使的，当然看着了啊。哎呀，不过你们人有句老话，说舍不得宝贝套不着狼。人的陷阱里一般是真有好东西……","voice":["vo_trial_21001_1_38"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001116,"trial_step":116},{"step":117,"speaker":"啸风","content":"瞧瞧，这不就给我逮住了吗？","voice":["vo_trial_21001_1_39"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":121,"log_type":1,"src_id":121001117,"trial_step":117},{"step":118,"content":"你——！","style":2,"background":121,"log_type":1,"src_id":121001118,"trial_step":118},{"step":119,"content":"眼前景象疯狂切换，你离地面时近时远，是啸风带着你在建筑间飞驰跳跃。","style":3,"background":2244,"log_type":1,"src_id":121001121,"trial_step":121},{"step":120,"content":"胃被顶得难受。头一回被人用这种姿势扛在肩上，你努力依靠核心的力量维持平衡，不让脑袋在剧烈的风里乱晃。","style":3,"background":2244,"log_type":1,"src_id":121001122,"trial_step":122},{"step":121,"content":"等等……换个姿势，要吐了……","style":2,"background":2244,"log_type":1,"src_id":121001123,"trial_step":123},{"step":122,"content":"早知道就不高估她看见横幅会知趣走人了！","style":3,"background":2244,"log_type":1,"src_id":121001124,"trial_step":124},{"step":123,"speaker":"啸风","content":"好了，猎到的宝贝就是我的了。小东西们，你们的头头就借我玩会儿吧——","voice":["vo_trial_21001_1_40"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2244,"log_type":1,"src_id":121001125,"trial_step":125},{"step":124,"speaker":"啸风","content":"东洲最近无聊得很，但我看你这地盘不错，热闹多，有意思。刚好我现在还缺个带路的家伙，而你……","voice":["vo_trial_21001_1_42"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2244,"log_type":1,"src_id":121001126,"trial_step":126},{"step":125,"content":"又是瞬间腾空。你被啸风转着换了个姿势，直接对上她那双笑意盎然的竖瞳。","style":3,"background":2244,"log_type":1,"src_id":121001127,"trial_step":127},{"step":126,"speaker":"啸风","content":"哈哈哈~前轱辘不转后轱辘转，来都来了，刚好就给咱来当导游吧！","voice":["vo_trial_21001_1_43"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2244,"log_type":1,"src_id":121001128,"trial_step":128}]}