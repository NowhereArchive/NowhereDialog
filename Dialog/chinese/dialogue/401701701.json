{"id":401701701,"chapter_id":21000103,"scene_id":306,"steps":[{"step":1,"content":"在一个寒冷的早晨，你们终于完成了机甲的最终调试。","style":3,"background":2176,"log_type":1},{"step":2,"content":"你们没忘记将队友们的研究资料带上。最后一点空间，也尽可能塞上了食物和药品。","style":3,"background":2176,"log_type":1},{"step":3,"speaker":"瓦尼菈","content":"准备好了吗？","voice":["vo_event_401701701_3"],"voice_bank":"vo_event_17017","style":1,"background":2176,"log_type":1},{"step":4,"content":"机甲之上传来瓦尼菈的声音。","style":3,"background":2176,"log_type":1},{"step":5,"options":["没问题"],"jump":[6],"style":6,"background":2176,"log_type":1},{"step":6,"content":"白色的雾气自你口中吐出，你朝她比了大拇指，示意你已经准备好了。","style":3,"background":2176,"log_type":1},{"step":7,"speaker":"瓦尼菈","content":"那就出发吧。","voice":["vo_event_401701701_7"],"voice_bank":"vo_event_17017","style":1,"background":2176,"log_type":1}]}