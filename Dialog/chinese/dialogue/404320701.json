{"id":404320701,"chapter_id":50088,"scene_id":58871,"steps":[{"step":1,"content":"【大厅】","style":18,"background":2503,"log_type":1},{"step":2,"content":"如果这两次的爆炸都是鼹鼠的安排，那么爆炸本身肯定不是行动的主要目的，现场一定会留下它的线索，甚至说，它本人很可能还混在其中。","style":3,"background":2503,"log_type":1},{"step":3,"content":"你迅速挣脱海伦娜的手，紧随诺兰冲出门廊。","style":3,"background":2503,"log_type":1},{"step":4,"content":"【外景】","style":18,"background":2511,"log_type":1},{"step":5,"speaker":"诺兰","content":"你跟来干什么！没手没脚的文员别碍事！","voice":["vo_event_404320701_01"],"voice_bank":"vo_event_43207","style":1,"background":2511,"log_type":1},{"step":6,"content":"她身手异常矫健，一脚踢碎一块落下的石板，在面前清出一条道路，毫不客气地拉起你的手臂，把你往后一带，推到安全区域。","style":3,"background":2511,"log_type":1},{"step":7,"options":["你想趁机销毁证据吗"],"jump":[8],"style":6,"background":2511,"log_type":1},{"step":8,"speaker":"诺兰","content":"随便你吧，想死就跟上！","voice":["vo_event_404320701_04"],"voice_bank":"vo_event_43207","style":1,"background":2511,"log_type":1},{"step":9,"content":"诺兰的身影随即消失在火焰中，你一咬牙，再次跟了进去。","style":3,"background":2511,"log_type":1},{"step":10,"content":"（黑屏+火焰）","style":18,"background":10000,"log_type":1},{"step":11,"content":"爆炸激起的烟尘遮蔽了视线，在不断的震动中，你能感受到还有其他的炸药正在引爆。","style":3,"background":10000,"log_type":1},{"step":12,"content":"噗——！","style":3,"background":10000,"log_type":1},{"step":13,"content":"突然一声闷响，你看到诺兰的身影在浓烟中摇晃了一下，就消失不见了。","style":3,"background":10000,"log_type":1},{"step":14,"content":"噗——！","style":3,"background":10000,"log_type":1},{"step":15,"content":"第二声闷响，你感到腹部传来灼烧般的剧痛，低头一看，涌出的鲜血已染红了衣衫。","style":3,"background":10000,"log_type":1},{"step":16,"content":"（红色滤镜）","style":18,"background":10000,"log_type":1},{"step":17,"content":"你艰难地捂住伤口，但视线已经模糊了起来。","style":3,"background":10000,"log_type":1},{"step":18,"content":"一个谜样的黑影在火光中缓缓地出现，对你再次举起了枪。","style":3,"background":10000,"log_type":1},{"step":19,"speaker":"嘶哑的声音","content":"狄斯——万岁！","voice":["vo_event_404320701_15"],"voice_bank":"vo_event_43207","style":1,"background":10000,"log_type":1}]}