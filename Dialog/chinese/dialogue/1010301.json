{"id":1010301,"chapter_id":1010301,"scene_id":1,"steps":[{"step":1,"content":"113年██月██日\nMBCC本部\n局长办公室","style":9,"background":1040,"log_type":1,"src_id":110301002,"trial_step":2},{"step":2,"speaker":"9th成员","content":"也就是说，您认为104年和113年两次锈火危机，在幕后推波助澜的是涅槃集团。或者说，他们背后的某些东西，对吗？","voice":["vo_trial_10301_1_1"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301003,"trial_step":3},{"step":3,"speaker":"9th成员","content":"真是个危险的揣测。不过，也难怪您会有这种想法。","voice":["vo_trial_10301_1_2"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301004,"trial_step":4},{"step":4,"speaker":"9th成员","content":"毕竟您自己也被牵扯其中，甚至连“死亡”都可以被利用……","voice":["vo_trial_10301_1_3"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301005,"trial_step":5},{"step":5,"speaker":"%u","content":"没有那么复杂。我想要的只是真相。","style":2,"background":1040,"log_type":1,"src_id":110301006,"trial_step":6},{"step":6,"speaker":"9th成员","content":"真相啊……","voice":["vo_trial_10301_1_4"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301007,"trial_step":7},{"step":7,"speaker":"9th成员","content":"不顾一切追逐真相的人，到头来，又有几个能支付得起真相的代价呢。","voice":["vo_trial_10301_1_5"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301008,"trial_step":8},{"step":8,"speaker":"9th成员","content":"退一步讲，知晓真相之后您又打算做些什么？让那个对您开枪的“大人物”血债血偿？","voice":["vo_trial_10301_1_6"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301009,"trial_step":9},{"step":9,"speaker":"%u","content":"……","style":2,"background":1040,"log_type":1,"src_id":110301010,"trial_step":10},{"step":10,"speaker":"9th成员","content":"不用紧张，只是开个玩笑。","voice":["vo_trial_10301_1_7"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301011,"trial_step":11},{"step":11,"speaker":"9th成员","content":"无论如何，那位幕后推手都不会是易与之辈……","voice":["vo_trial_10301_1_8"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301012,"trial_step":12},{"step":12,"speaker":"9th成员","content":"请留意您身边的新客人。","voice":["vo_trial_10301_1_9"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301013,"trial_step":13},{"step":13,"speaker":"%u","content":"嗯……","style":2,"background":1040,"log_type":1,"src_id":110301014,"trial_step":14},{"step":14,"content":"突兀的“人事调动”，来自FAC的狂厄级禁闭者。你知道面前男人要你提防的是谁——事实上，从罗睺来到MBCC的第一天起，你就没有停止过对她的防备。","style":3,"background":1040,"log_type":1,"src_id":110301015,"trial_step":15},{"step":15,"speaker":"9th成员","content":"看来您的心里早有答案。","voice":["vo_trial_10301_1_10"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301016,"trial_step":16},{"step":16,"content":"第九机关的官员从他的提包中取出一份封装完好的文件，微笑着放在办公桌上。","style":3,"background":1040,"log_type":1,"src_id":110301017,"trial_step":17},{"step":17,"speaker":"9th成员","content":"这是您要的东西……第九机关不会妨碍您调查所谓的真相。但要提醒一句……","voice":["vo_trial_10301_1_11"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301018,"trial_step":18},{"step":18,"speaker":"9th成员","content":"行事注意安全。","voice":["vo_trial_10301_1_12"],"voice_bank":"vo_rahu_trial","style":1,"background":1040,"log_type":1,"src_id":110301019,"trial_step":19},{"step":19,"speaker":"罗睺","content":"说明你的来意。","voice":["vo_trial_10301_1_13"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301023,"trial_step":23,"drawing":1010301},{"step":20,"content":"强光照射下，女人的面部笼罩着阴影。","style":3,"log_type":1,"src_id":110301024,"trial_step":24,"drawing":1010301},{"step":21,"speaker":"选项","options":["例行调查"],"style":6,"log_type":1,"src_id":110301025,"trial_step":25,"course":3,"drawing":1010301,"choices":[{"text":"例行调查","goto":26}]},{"step":22,"speaker":"罗睺","content":"例行调查，是这种形式？","voice":["vo_trial_10301_1_14"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301026,"trial_step":26,"drawing":1010301},{"step":23,"content":"罗睺环顾四周，逼仄的审查室中只有冰冷的监视仪器和卤素灯的嗡鸣。","style":3,"log_type":1,"src_id":110301027,"trial_step":27,"drawing":1010301},{"step":24,"speaker":"%u","content":"你接受了MBCC的“人事调动”，同时也是狂厄级禁闭者。接受这种形式的调查是你的义务。","style":2,"log_type":1,"src_id":110301028,"trial_step":28,"drawing":1010301},{"step":25,"content":"罗睺看着你的眼睛，片刻之后露出一个毫无温度的冷笑。","style":3,"log_type":1,"src_id":110301029,"trial_step":29,"drawing":1010301},{"step":26,"speaker":"罗睺","content":"是，<color=#fb9259><size=40>长官</size></color>。","voice":["vo_trial_10301_1_15"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301030,"trial_step":30,"drawing":1010304},{"step":27,"content":"你取出标有罗睺名字的档案袋，放在了桌上。","style":3,"log_type":1,"src_id":110301031,"trial_step":31,"drawing":1010304},{"step":28,"speaker":"选项","options":["和我聊聊你在FAC的经历。"],"style":6,"log_type":1,"src_id":110301032,"trial_step":32,"course":3,"drawing":1010304,"choices":[{"text":"和我聊聊你在FAC的经历。","goto":33}]},{"step":29,"content":"罗睺看了一眼桌上的档案袋。","style":3,"log_type":1,"src_id":110301033,"trial_step":33,"drawing":1010304},{"step":30,"speaker":"罗睺","content":"你已经知道了，何必再让我复述一遍？","voice":["vo_trial_10301_1_16"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301034,"trial_step":34,"drawing":1010301},{"step":31,"speaker":"%u","content":"档案卷宗多少会有遗漏和谬误，我想想听听你的说法。","style":2,"log_type":1,"src_id":110301035,"trial_step":35,"drawing":1010301},{"step":32,"content":"罗睺倒是没有犹豫，讲述起自己的经历。","style":3,"log_type":1,"src_id":110301036,"trial_step":36,"drawing":1010301},{"step":33,"speaker":"罗睺","content":"我出生于辛迪加，102年被FAC收编。此后共计11年都在为FAC工作。","voice":["vo_trial_10301_1_17"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301037,"trial_step":37,"drawing":1010301},{"step":34,"speaker":"罗睺","content":"直到上周——上面认为我在你这里能发挥更大作用。","voice":["vo_trial_10301_1_18"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301038,"trial_step":38,"drawing":1010301},{"step":35,"content":"说起这些时罗睺的态度，似乎对于“上面的决定”并不是很满意。","style":3,"log_type":1,"src_id":110301039,"trial_step":39,"drawing":1010301},{"step":36,"speaker":"%u","content":"就这些？能多说些细节吗？","style":2,"log_type":1,"src_id":110301040,"trial_step":40,"drawing":1010301},{"step":37,"speaker":"罗睺","content":"哪一方面的细节？","voice":["vo_trial_10301_1_19"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301041,"trial_step":41,"drawing":1010302},{"step":38,"speaker":"%u","content":"比如你加入FAC的原因之类的。","style":2,"log_type":1,"src_id":110301042,"trial_step":42,"drawing":1010302},{"step":39,"speaker":"罗睺","content":"原因？","voice":["vo_trial_10301_1_20"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301043,"trial_step":43,"drawing":1010304},{"step":40,"content":"罗睺笑了笑，好像这是一个不值一提却又被重复多次的愚蠢问题。","style":3,"log_type":1,"src_id":110301044,"trial_step":44,"drawing":1010304},{"step":41,"speaker":"罗睺","content":"呵……为了活命。","voice":["vo_trial_10301_1_21"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301045,"trial_step":45,"drawing":1010304},{"step":42,"speaker":"罗睺","content":"比起去FAC，活在辛迪加反倒更危险。","voice":["vo_trial_10301_1_22"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301046,"trial_step":46,"drawing":1010304},{"step":43,"speaker":"%u","content":"据我所知，FAC不常在西区招收新人。你是如何同他们牵上线的？","style":2,"log_type":1,"src_id":110301047,"trial_step":47,"drawing":1010304},{"step":44,"speaker":"罗睺","content":"当时有一支小队在辛迪加执行任务。我遇见了他们的队长，被引荐去了新兵营试训。","voice":["vo_trial_10301_1_23"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301048,"trial_step":48,"drawing":1010304},{"step":45,"speaker":"%u","content":"队长的名字？","style":2,"log_type":1,"src_id":110301049,"trial_step":49,"drawing":1010304},{"step":46,"speaker":"罗睺","content":"……","voice":["vo_trial_10301_1_24"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301050,"trial_step":50,"drawing":1010301},{"step":47,"content":"罗睺略微停顿了半刻，接着用随意的语气说道：","style":3,"log_type":1,"src_id":110301051,"trial_step":51,"drawing":1010301},{"step":48,"speaker":"罗睺","content":"不记得了。","voice":["vo_trial_10301_1_25"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301052,"trial_step":52,"drawing":1010304},{"step":49,"speaker":"%u","content":"是吗？","style":2,"log_type":1,"src_id":110301053,"trial_step":53,"drawing":1010301},{"step":50,"content":"她在撒谎。","style":3,"log_type":1,"src_id":110301054,"trial_step":54,"drawing":1010301},{"step":51,"content":"档案记载，罗睺完成试训后就加入了那位队长的小队，在近两年的时间里一同参与过二十余次行动。","style":3,"log_type":1,"src_id":110301055,"trial_step":55,"drawing":1010301},{"step":52,"speaker":"%u","content":"据我所知直到103年，小队覆灭为止，你都在那位队长的小队中。","style":2,"log_type":1,"src_id":110301056,"trial_step":56,"drawing":1010301},{"step":53,"speaker":"%u","content":"你曾多次向上报告，索要内海覆灭的“真相”，不惜闯入FAC高层的办公区，做出过激行为，也因此背上两次处分。","style":2,"log_type":1,"src_id":110301057,"trial_step":57,"drawing":1010301},{"step":54,"speaker":"%u","content":"你真的不记得那位长官的名字？","style":2,"log_type":1,"src_id":110301058,"trial_step":58,"drawing":1010301},{"step":55,"content":"罗睺没有回答，只是久久地盯着你手上的卷宗。","style":3,"log_type":1,"src_id":110301059,"trial_step":59,"drawing":1010301},{"step":56,"content":"沉默良久，她冷不丁咧开嘴说道：","style":3,"log_type":1,"src_id":110301060,"trial_step":60,"drawing":1010301},{"step":57,"speaker":"罗睺","content":"创伤后应激障碍……我接受过FAC提供的治疗。","voice":["vo_trial_10301_1_26"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301061,"trial_step":61,"drawing":1010301},{"step":58,"speaker":"罗睺","content":"不需要记得的，不该记得的，我都不记得了。这样无论是对我，还是对其他人，都更好。","voice":["vo_trial_10301_1_27"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301062,"trial_step":62,"drawing":1010301},{"step":59,"content":"罗睺的说辞和档案上的记录没有冲突。","style":3,"log_type":1,"src_id":110301063,"trial_step":63,"drawing":1010301},{"step":60,"content":"很显然，她在FAC接受的反拷问训练没有白费。继续在这个话题上纠缠没有意义，甚至可能背上“迫害老兵”之类的道德指控。","style":3,"log_type":1,"src_id":110301064,"trial_step":64,"drawing":1010301},{"step":61,"content":"但你知道她依旧没有说实话，至少不全是实话。你故作随意地翻阅着档案，尝试揭过刚刚的话题。","style":3,"log_type":1,"src_id":110301065,"trial_step":65,"drawing":1010301},{"step":62,"speaker":"%u","content":"很庆幸你能从那段经历中走出来。","style":2,"log_type":1,"src_id":110301066,"trial_step":66,"drawing":1010301},{"step":63,"speaker":"罗睺","content":"……庆幸？","voice":["vo_trial_10301_1_28"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301067,"trial_step":67,"drawing":1010302},{"step":64,"content":"罗睺发出疑问，你能听出她语气中极难察觉的一丝怒意。","style":3,"log_type":1,"src_id":110301068,"trial_step":68,"drawing":1010302},{"step":65,"content":"明明是她自己提到的“已经治愈”、“对大家都好”，但在你说出那番话时，即便掩饰得很好，她还是仿佛被戳中了痛脚。","style":3,"log_type":1,"src_id":110301069,"trial_step":69,"drawing":1010302},{"step":66,"speaker":"%u","content":"我们不是敌人，罗睺，是即将开始长期共事的同僚。","style":2,"log_type":1,"src_id":110301070,"trial_step":70,"drawing":1010302},{"step":67,"speaker":"%u","content":"在FAC的十一年已经证明了你的忠诚与能力。既然你能解释清楚履历上的“瑕疵”，我自然会为获得这样一位优秀的下属感到庆幸。","style":2,"log_type":1,"src_id":110301071,"trial_step":71,"drawing":1010302},{"step":68,"content":"你解释着。另一边，手中的档案突然停止了翻动，停留在最后一页。","style":3,"log_type":1,"src_id":110301072,"trial_step":72,"drawing":1010302},{"step":69,"speaker":"%u","content":"113年七月，你离开FAC本部前往埃丽卡山庄，去做什么？","style":2,"log_type":1,"src_id":110301073,"trial_step":73,"drawing":1010302},{"step":70,"content":"面对你话锋突转，罗睺微微一愣，但还是以极快的速度反应过来。","style":3,"log_type":1,"src_id":110301074,"trial_step":74,"drawing":1010302},{"step":71,"speaker":"罗睺","content":"休假。","voice":["vo_trial_10301_1_29"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301075,"trial_step":75,"drawing":1010301},{"step":72,"speaker":"%u","content":"那里不是给普通人休假的地方。","style":2,"log_type":1,"src_id":110301076,"trial_step":76,"drawing":1010301},{"step":73,"speaker":"罗睺","content":"……这是我的私事，我拒绝回答。","voice":["vo_trial_10301_1_30"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301077,"trial_step":77,"drawing":1010301},{"step":74,"speaker":"%u","content":"你是去找某个人的，对么？","style":2,"log_type":1,"src_id":110301078,"trial_step":78,"drawing":1010301},{"step":75,"speaker":"%u","content":"你瞒着FAC的同僚，前往埃丽卡山庄，并且在那里接触到了一位“大人物”……","style":2,"log_type":1,"src_id":110301079,"trial_step":79,"drawing":1010301},{"step":76,"speaker":"罗睺","content":"呵呵，不简单……","voice":["vo_trial_10301_1_31"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301080,"trial_step":80,"drawing":1010304},{"step":77,"content":"罗睺的笑声打断了你。","style":3,"log_type":1,"src_id":110301081,"trial_step":81,"drawing":1010304},{"step":78,"speaker":"罗睺","content":"MBCC的情报机构有点意思，行事很大胆。","voice":["vo_trial_10301_1_32"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301082,"trial_step":82,"drawing":1010304},{"step":79,"content":"罗睺的笑容消失无踪，只留下冷酷的注目。","style":3,"log_type":1,"src_id":110301083,"trial_step":83,"drawing":1010304},{"step":80,"speaker":"罗睺","content":"但是，你最好让你手下的人收敛一点，手别伸太长。","voice":["vo_trial_10301_1_33"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301084,"trial_step":84,"drawing":1010302},{"step":81,"content":"威胁之意溢于言表，你冷静地回敬道：","style":3,"log_type":1,"src_id":110301085,"trial_step":85,"drawing":1010302},{"step":82,"speaker":"%u","content":"这一点无需你挂心，我的情报源相当可靠。","style":2,"log_type":1,"src_id":110301086,"trial_step":86,"drawing":1010302},{"step":83,"speaker":"罗睺","content":"第九机关，对么？","voice":["vo_trial_10301_1_34"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301087,"trial_step":87,"drawing":1010304},{"step":84,"content":"你不再理会罗睺近乎挑衅的提问，继续着刚刚的话题。","style":3,"log_type":1,"src_id":110301088,"trial_step":88,"drawing":1010304},{"step":85,"speaker":"%u","content":"你前往埃丽卡山庄的目的究竟是什么？","style":2,"log_type":1,"src_id":110301089,"trial_step":89,"drawing":1010304},{"step":86,"speaker":"罗睺","content":"你可靠的情报来源呢？为什么不问问他们？","voice":["vo_trial_10301_1_35"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301090,"trial_step":90,"drawing":1010304},{"step":87,"speaker":"%u","content":"我想听你本人的说法。","style":2,"log_type":1,"src_id":110301091,"trial_step":91,"drawing":1010304},{"step":88,"speaker":"罗睺","content":"……","voice":["vo_trial_10301_1_36"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301092,"trial_step":92,"drawing":1010301},{"step":89,"speaker":"罗睺","content":"他们在公共频道发布了一则求援讯息。我收到，然后去了。就这么简单。","voice":["vo_trial_10301_1_37"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301093,"trial_step":93,"drawing":1010301},{"step":90,"speaker":"%u","content":"那么，在回应求救讯息之前，你知道埃丽卡山庄有一位上庭要员在吗？","style":2,"log_type":1,"src_id":110301094,"trial_step":94,"drawing":1010301},{"step":91,"content":"罗睺直视着你，这一刻像是她在审视你的动机。几秒沉默后，她突然大笑出声。","style":3,"log_type":1,"src_id":110301095,"trial_step":95,"drawing":1010301},{"step":92,"speaker":"罗睺","content":"哈哈，我说我不知道，你信吗？","voice":["vo_trial_10301_1_38"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301096,"trial_step":96,"drawing":1010304},{"step":93,"speaker":"%u","content":"……","style":2,"log_type":1,"src_id":110301097,"trial_step":97,"drawing":1010304},{"step":94,"speaker":"罗睺","content":"我当然知道。如果不是有上庭高官在那里，我为什么要管他们的死活？","voice":["vo_trial_10301_1_39"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301098,"trial_step":98,"drawing":1010304},{"step":95,"speaker":"%u","content":"你从一开始就是奔着那位上庭要员去的？为什么？","style":2,"log_type":1,"src_id":110301099,"trial_step":99,"drawing":1010304},{"step":96,"speaker":"罗睺","content":"为什么？当然是去献献殷勤，好能离开FAC。","voice":["vo_trial_10301_1_40"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301100,"trial_step":100,"drawing":1010304},{"step":97,"speaker":"%u","content":"你已经在FAC任职超过十年，为什么会突然想要另谋他处？","style":2,"log_type":1,"src_id":110301101,"trial_step":101,"drawing":1010304},{"step":98,"speaker":"罗睺","content":"不是突然。我早就想换份差事了。","voice":["vo_trial_10301_1_41"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301102,"trial_step":102,"drawing":1010304},{"step":99,"content":"她语气再没了被审查者该有的紧张，带着看透你一般的嘲讽或敷衍，随意地说着。","style":3,"log_type":1,"src_id":110301103,"trial_step":103,"drawing":1010304},{"step":100,"speaker":"罗睺","content":"我是在FAC待了十多年，大大小小的行动参与了上百次。从BR-002的行动开始，我身边的人换了一茬又一茬，比我年长的、比我年轻的，都死了，没有一个能善终。","voice":["vo_trial_10301_1_42"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301104,"trial_step":104,"drawing":1010304},{"step":101,"speaker":"罗睺","content":"我想活下去。那些给上庭做保镖的雇佣兵能活着退休，凭什么FAC的人不行？是嫌我们的血还流得不够多吗？","voice":["vo_trial_10301_1_43"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301105,"trial_step":105,"drawing":1010304},{"step":102,"speaker":"罗睺","content":"上庭大人物给的差事总归不会那么窝囊。","voice":["vo_trial_10301_1_44"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301106,"trial_step":106,"drawing":1010304},{"step":103,"content":"罗睺的身体微微后仰，你能听到椅子吱吱呀呀的声响。","style":3,"log_type":1,"src_id":110301107,"trial_step":107,"drawing":1010304},{"step":104,"speaker":"%u","content":"你的小队呢？你就这么抛下了他们？","style":2,"log_type":1,"src_id":110301108,"trial_step":108,"drawing":1010304},{"step":105,"speaker":"罗睺","content":"别把人都想得太高尚，${PlayerName}。包括FAC的人，不过是一群会为了又多活一天而感到庆幸的普通人罢了。","voice":["vo_trial_10301_1_45"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301109,"trial_step":109,"drawing":1010304},{"step":106,"speaker":"罗睺","content":"在经历了那么多场残酷的战斗之后，是个人都会为自己考虑。","voice":["vo_trial_10301_1_46"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301110,"trial_step":110,"drawing":1010304},{"step":107,"speaker":"罗睺","content":"更何况，我不欠他们的。对他们而言，我也不是什么必不可少的角色。","voice":["vo_trial_10301_1_47"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301111,"trial_step":111,"drawing":1010304},{"step":108,"content":"罗睺的声音阴冷，所描述的事实与记录一致。从伦理上来讲，她也的确没有义务一直待在FAC。","style":3,"log_type":1,"src_id":110301112,"trial_step":112,"drawing":1010304},{"step":109,"content":"然而你却感到一股莫名的怪异。明明逻辑上她所说的话没有问题，但却与这个人表现出的种种性格特质不符。","style":3,"log_type":1,"src_id":110301113,"trial_step":113,"drawing":1010304},{"step":110,"content":"这些说辞仿佛是一座由无数谎言堆砌而成的堡垒，经人刻意设计，每一处细节都严丝合缝，令人难觅破绽。","style":3,"log_type":1,"src_id":110301114,"trial_step":114,"drawing":1010304},{"step":111,"content":"无论这位“设计者”是谁，她一定都拥有着难以想象的巨大能量。这种程度的手段和权力，在整个狄斯城都屈指可数。","style":3,"log_type":1,"src_id":110301115,"trial_step":115,"drawing":1010304},{"step":112,"content":"上庭的大人物、锈火的幕后推手、罗睺口中的“机会”，这些琐碎而难以捉摸的形象，在你的眼中愈发重叠起来。","style":3,"log_type":1,"src_id":110301116,"trial_step":116,"drawing":1010304},{"step":113,"speaker":"%u","content":"那位上庭要员接受你的提议了吗？","voice":["vo_trial_10301_1_48"],"voice_bank":"vo_rahu_trial","style":2,"log_type":1,"src_id":110301117,"trial_step":117,"drawing":1010304},{"step":114,"speaker":"罗睺","content":"？","style":1,"log_type":1,"src_id":110301118,"trial_step":118,"drawing":1010301},{"step":115,"content":"这个问题似乎问住了罗睺，她一时间没有想好该如何回答。","style":3,"log_type":1,"src_id":110301119,"trial_step":119,"drawing":1010301},{"step":116,"speaker":"%u","content":"如今你在MBCC，而不是留在那位大人物身边。","style":2,"log_type":1,"src_id":110301120,"trial_step":120,"drawing":1010301},{"step":117,"speaker":"%u","content":"你被抛弃了？","style":2,"log_type":1,"src_id":110301121,"trial_step":121,"drawing":1010301},{"step":118,"content":"罗睺的神色渐渐冰冷起来。","style":3,"log_type":1,"src_id":110301122,"trial_step":122,"drawing":1010302},{"step":119,"speaker":"%u","content":"还是说，调任到MBCC，就是那位大人物交给你的“好差事”？","style":2,"log_type":1,"src_id":110301123,"trial_step":123,"drawing":1010302},{"step":120,"speaker":"%u","content":"让我想想，你是一位经验丰富、且拥有强大力量的作战人员，不论在哪里都是可以被委以重任的精英。","style":2,"log_type":1,"src_id":110301124,"trial_step":124,"drawing":1010302},{"step":121,"speaker":"%u","content":"放弃这样一位得力助手，将你送到我这里来，能有什么目的？","style":2,"log_type":1,"src_id":110301125,"trial_step":125,"drawing":1010302},{"step":122,"speaker":"%u","content":"来杀我？不，效率太低了。监视我？有这个可能。","style":2,"log_type":1,"src_id":110301126,"trial_step":126,"drawing":1010302},{"step":123,"speaker":"%u","content":"可那位大人物为什么要绕过第九机关直接监视我？是为了锈火的事？又或许与我在流民寨受到的袭击有关……","style":2,"log_type":1,"src_id":110301127,"trial_step":127,"drawing":1010302},{"step":124,"speaker":"罗睺","content":"呵呵呵……","voice":["vo_trial_10301_1_49"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301128,"trial_step":128,"drawing":1010303},{"step":125,"content":"突兀的冷笑打断了你。","style":3,"log_type":1,"src_id":110301129,"trial_step":129,"drawing":1010303},{"step":126,"speaker":"罗睺","content":"我见过很多和你一样，自以为是揣测真相的人。","voice":["vo_trial_10301_1_50"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301130,"trial_step":130,"drawing":1010303},{"step":127,"speaker":"罗睺","content":"你猜，他们的下场是什么？","voice":["vo_trial_10301_1_51"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301131,"trial_step":131,"drawing":1010303},{"step":128,"content":"罗睺的笑容之上覆盖着一层阴影。","style":3,"log_type":1,"src_id":110301132,"trial_step":132,"drawing":1010303},{"step":129,"speaker":"%u","content":"你这是在威胁我？","style":2,"log_type":1,"src_id":110301133,"trial_step":133,"drawing":1010303},{"step":130,"speaker":"罗睺","content":"就当我是来威胁你的吧。","voice":["vo_trial_10301_1_52"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301134,"trial_step":134,"drawing":1010303},{"step":131,"speaker":"罗睺","content":"你的“好奇心”太旺盛了，无论是对真相、还是那位大人物……你的想法几乎都写在脸上。","voice":["vo_trial_10301_1_53"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301135,"trial_step":135,"drawing":1010303},{"step":132,"speaker":"罗睺","content":"不要再妄想自己可以追求“真相”，安心做你这个小机构的长官。这是你唯一的活路。","voice":["vo_trial_10301_1_54"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301136,"trial_step":136,"drawing":1010303},{"step":133,"speaker":"罗睺","content":"你一直以来都做得不错。现在停手，他们或许可以忽视这一点小小的冒犯。","voice":["vo_trial_10301_1_55"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301137,"trial_step":137,"drawing":1010303},{"step":134,"speaker":"罗睺","content":"但如果你一意孤行，呵呵……","voice":["vo_trial_10301_1_56"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301138,"trial_step":138,"drawing":1010303},{"step":135,"content":"罗睺抬头，双眼闪着危险的光芒。","style":3,"log_type":1,"src_id":110301139,"trial_step":139,"drawing":1010303},{"step":136,"speaker":"罗睺","content":"狄斯城是由越界者和叛徒的尸骨筑就的。没有人能保护你，第九机关也不行。","voice":["vo_trial_10301_1_57"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301140,"trial_step":140,"drawing":1010303},{"step":137,"speaker":"罗睺","content":"你惹上的，就是这样的“大人物”。","voice":["vo_trial_10301_1_58"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301141,"trial_step":141,"drawing":1010303},{"step":138,"content":"罗睺的语气无比平静，但隐藏在平静表面下的东西却令你一时间汗毛倒竖。","style":3,"log_type":1,"src_id":110301142,"trial_step":142,"drawing":1010303},{"step":139,"content":"你深吸一口气，尽量平复心情。","style":3,"log_type":1,"src_id":110301143,"trial_step":143,"drawing":1010303},{"step":140,"speaker":"%u","content":"感谢你的忠告，罗睺。","style":2,"log_type":1,"src_id":110301144,"trial_step":144,"drawing":1010303},{"step":141,"speaker":"%u","content":"我想我能够管好自己的好奇心。在得到自己所需情报的同时，不至于越界。","style":2,"log_type":1,"src_id":110301145,"trial_step":145,"drawing":1010303},{"step":142,"speaker":"%u","content":"至少不会像康拉德·凯奇那样。","style":2,"log_type":1,"src_id":110301146,"trial_step":146,"drawing":1010303},{"step":143,"speaker":"罗睺","content":"……康拉德？","voice":["vo_trial_10301_1_59"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301147,"trial_step":147,"drawing":1010301},{"step":144,"content":"听到这个名字，罗睺眼中有复杂的情绪一闪而逝，你捕捉到了。","style":3,"log_type":1,"src_id":110301148,"trial_step":148,"drawing":1010301},{"step":145,"speaker":"%u","content":"你不知道么？","style":2,"log_type":1,"src_id":110301149,"trial_step":149,"drawing":1010301},{"step":146,"speaker":"罗睺","content":"我不清楚你所谓的“知道”是什么意思。","voice":["vo_trial_10301_1_60"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301150,"trial_step":150,"drawing":1010301},{"step":147,"content":"她的面色不再有变化，所有情绪都掩饰于那双冷酷的眼睛之后。","style":3,"log_type":1,"src_id":110301151,"trial_step":151,"drawing":1010301},{"step":148,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":152,"course":6,"drawing":1010301},{"step":149,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":152,"course":6,"drawing":1010301},{"step":150,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":152,"course":6,"drawing":1010301},{"step":151,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":152,"course":6,"drawing":1010301},{"step":152,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":152,"course":6,"drawing":1010301},{"step":153,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":152,"course":6,"drawing":1010301},{"step":154,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":152,"course":6,"drawing":1010301},{"step":155,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":152,"course":6,"drawing":1010301},{"step":156,"content":"康拉德·凯奇，100年加入FAC，与你一样，同处G47小队。103年，他由于负伤错过了内海的行动，与你一同成为当年G47小队的唯二幸存者。","style":2,"log_type":1,"src_id":110301153,"trial_step":153,"drawing":1010301},{"step":157,"content":"在那之后，他接过了前任长官的职位，成为了你的直属上级。这十多年来，你们一直在同一个小队共事。","style":2,"log_type":1,"src_id":110301154,"trial_step":154,"drawing":1010301},{"step":158,"speaker":"%u","content":"——直到█个月前，也就是你去埃丽卡山庄后不久，康拉德的队伍在一次战斗中遭遇了意外……","style":2,"log_type":1,"src_id":110301155,"trial_step":155,"drawing":1010301},{"step":159,"speaker":"%u","content":"简而言之，整支小队只有他一个人活了下来。","style":2,"log_type":1,"src_id":110301156,"trial_step":156,"drawing":1010301},{"step":160,"speaker":"%u","content":"或者说，只有你们两个活了下来。毕竟你名义上依旧属于G47小队。","style":2,"log_type":1,"src_id":110301157,"trial_step":157,"drawing":1010301},{"step":161,"content":"罗睺的瞳孔骤然缩小。令人疑惑的是，她对你所陈述的事实表现出的情绪是强烈的不信任。","style":3,"log_type":1,"src_id":110301158,"trial_step":158,"drawing":1010302},{"step":162,"content":"就好像她对此一无所知。","style":3,"log_type":1,"src_id":110301159,"trial_step":159,"drawing":1010302},{"step":163,"speaker":"%u","content":"听起来很耳熟，不是吗。","style":2,"log_type":1,"src_id":110301160,"trial_step":160,"drawing":1010302},{"step":164,"speaker":"%u","content":"十年前，你们也在同一支队伍。他因伤缺席，而你是战斗中唯一的幸存者。","style":2,"log_type":1,"src_id":110301161,"trial_step":161,"drawing":1010302},{"step":165,"speaker":"%u","content":"我以为你们的关系不错。毕竟，他是你的直属上级，也是你擅自离队前往埃丽卡山庄的担保人……","style":2,"log_type":1,"src_id":110301162,"trial_step":162,"drawing":1010302},{"step":166,"speaker":"罗睺","content":"他究竟怎么了？","voice":["vo_trial_10301_1_61"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301163,"trial_step":163,"drawing":1010302},{"step":167,"content":"罗睺打断了你。","style":3,"log_type":1,"src_id":110301164,"trial_step":164,"drawing":1010302},{"step":168,"speaker":"%u","content":"……不太好。","style":2,"log_type":1,"src_id":110301165,"trial_step":165,"drawing":1010302},{"step":169,"speaker":"%u","content":"FAC方面的说法是，康拉德受到狂厄影响，精神出现严重问题。","style":2,"log_type":1,"src_id":110301166,"trial_step":166,"drawing":1010302},{"step":170,"speaker":"%u","content":"康拉德声称狄斯城的一切都是阴谋，他看到了……嗯，总之，是一些反社会言论。","style":2,"log_type":1,"src_id":110301167,"trial_step":167,"drawing":1010302},{"step":171,"speaker":"%u","content":"不仅如此，他谋划了一起针对重要人物的袭击，严重影响了公共安全。幸好，计划暴露，没有酿成大祸。","style":2,"log_type":1,"src_id":110301168,"trial_step":168,"drawing":1010302},{"step":172,"speaker":"罗睺","content":"所以？这件事和我有什么关系？","voice":["vo_trial_10301_1_62"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301169,"trial_step":169,"drawing":1010302},{"step":173,"content":"不知不觉间，罗睺的表情由怀疑转为警觉。","style":3,"log_type":1,"src_id":110301170,"trial_step":170,"drawing":1010302},{"step":174,"speaker":"%u","content":"不用紧张，暂时还没有怀疑到你头上。只不过……","style":2,"log_type":1,"src_id":110301171,"trial_step":171,"drawing":1010302},{"step":175,"speaker":"%u","content":"只不过，康拉德的治疗很不顺利。他接受过严格的心理训练。但这些心理训练现在反倒成了负面因素。具体表现为拒绝接受医生的治疗，甚至表现出强烈的攻击性。","style":2,"log_type":1,"src_id":110301172,"trial_step":172,"drawing":1010302},{"step":176,"speaker":"%u","content":"有专业机构联系了FAC，声称可以接管他，并为他提供相应治疗。不过FAC方面暂时还没有接受。","style":2,"log_type":1,"src_id":110301173,"trial_step":173,"drawing":1010302},{"step":177,"speaker":"罗睺","content":"……","voice":["vo_trial_10301_1_63"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301174,"trial_step":174,"drawing":1010301},{"step":178,"speaker":"%u","content":"他们选择向我们，拥有丰富的审查沾染狂厄者经验的部门求助……或许也是他们知道你最近被调到了我这里的缘故。","style":2,"log_type":1,"src_id":110301175,"trial_step":175,"drawing":1010301},{"step":179,"speaker":"%u","content":"你看，MBCC在其他部门面前，一向没什么秘密。","style":2,"log_type":1,"src_id":110301176,"trial_step":176,"drawing":1010301},{"step":180,"content":"妮诺","style":3,"log_type":1,"src_id":110301177,"trial_step":177,"drawing":1010301},{"step":181,"speaker":"%u","content":"我想，他们大概没有对我抱太大希望。反倒是更希望你、康拉德昔日的战友，能提供一些帮助。","style":2,"log_type":1,"src_id":110301178,"trial_step":178,"drawing":1010301},{"step":182,"speaker":"%u","content":"当然，你不愿意去的话我也完全理解。我能做的不多，不过是尽可能问出康拉德了解的“真相”，至少让FAC的医疗部门分析出他的心理病因……","style":2,"log_type":1,"src_id":110301179,"trial_step":179,"drawing":1010301},{"step":183,"speaker":"罗睺","content":"我会去的。","voice":["vo_trial_10301_1_64"],"voice_bank":"vo_rahu_trial","style":1,"log_type":1,"src_id":110301180,"trial_step":180,"drawing":1010301},{"step":184,"content":"罗睺的声音短促而坚决。","style":3,"log_type":1,"src_id":110301181,"trial_step":181,"drawing":1010301},{"step":185,"speaker":"%u","content":"很好。","style":2,"log_type":1,"src_id":110301182,"trial_step":182,"drawing":1010301},{"step":186,"speaker":"%u","content":"这是你来管理局之后的第一次外勤任务。希望一切顺利。","style":2,"log_type":1,"src_id":110301183,"trial_step":183,"drawing":1010301},{"step":187,"content":"罗睺没有回应你的话。你们之间达成了某种奇妙的默契。","style":3,"log_type":1,"src_id":110301184,"trial_step":184,"drawing":1010301},{"step":188,"content":"比起帮助过去的战友，她愿意和你一同前往，更多只是为了监视你可能的越界行为。但这都不重要。","style":3,"log_type":1,"src_id":110301185,"trial_step":185,"drawing":1010301},{"step":189,"content":"你已经达成了目的。","style":3,"log_type":1,"src_id":110301186,"trial_step":186,"drawing":1010301}]}