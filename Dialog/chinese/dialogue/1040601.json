{"id":1040601,"chapter_id":1040601,"scene_id":1,"steps":[{"step":1,"content":"N.F.113年12月 深夜12点30分\n福尔图娜剧院前","style":12,"background":1001,"log_type":1,"src_id":140601001,"trial_step":1},{"step":2,"content":"这栋不起眼的三层小楼仍保留着你上次来时的样子。但此时，它已被MBCC的车辆层层包围，车灯照亮了紧闭的大门。","style":3,"background":1001,"log_type":1,"src_id":140601002,"trial_step":2},{"step":3,"speaker":"夜莺","content":"局长，追缉小队准备完毕，是否突入？","voice":["vo_trial_40601_1_3"],"voice_bank":"vo_pearl_trial","style":11,"background":1001,"log_type":1,"src_id":140601003,"trial_step":3},{"step":4,"options":["行动开始"],"style":6,"background":1001,"log_type":1,"src_id":140601004,"trial_step":4,"course":3,"choices":[{"text":"行动开始","goto":5}]},{"step":5,"speaker":"${PlayerName}","content":"行动开始。走吧，该“回来”看看了。","style":2,"background":1001,"log_type":1,"src_id":140601005,"trial_step":5},{"step":6,"content":"室内一片漆黑。","style":3,"background":2171,"log_type":1,"src_id":140601007,"trial_step":7},{"step":7,"content":"今日的福尔图娜少了灯光与欢呼点缀，观众们早已离场，只剩下孤零零的舞台，褪了色，躺在一片死寂中。","style":3,"background":2171,"log_type":1,"src_id":140601008,"trial_step":8},{"step":8,"content":"但你仍能感到潜藏的狂厄波动——有她在，“戏剧”就不会结束。","style":3,"background":2171,"log_type":1,"src_id":140601009,"trial_step":9},{"step":9,"content":"唰——！","style":3,"background":2171,"log_type":1,"src_id":140601010,"trial_step":10},{"step":10,"speaker":"调侃的声音","content":"欢迎——欢迎回到福尔图娜剧院！","voice":["vo_trial_40601_1_11"],"voice_bank":"vo_pearl_trial","style":1,"background":2171,"log_type":1,"src_id":140601011,"trial_step":11},{"step":11,"speaker":"调侃的声音","content":"演出还未开始，请各位观众落座时小心安全，注意脚下~","voice":["vo_trial_40601_1_12"],"voice_bank":"vo_pearl_trial","style":1,"background":2171,"log_type":1,"src_id":140601012,"trial_step":12},{"step":12,"content":"灯光骤然亮起。剧院随着这道不明来处的声音一同复苏。","style":3,"background":2171,"log_type":1,"src_id":140601013,"trial_step":13},{"step":13,"speaker":"追缉队员","content":"局长，小心——！","voice":["vo_trial_40601_1_14"],"voice_bank":"vo_pearl_trial","style":1,"background":2171,"log_type":1,"src_id":140601014,"trial_step":14},{"step":14,"speaker":"调侃的声音","content":"福尔图娜已经为各位准备好了最佳的观赏席位，新来的朋友请先前往二楼，您将从头开始体验今晚的剧本——","voice":["vo_trial_40601_1_15"],"voice_bank":"vo_pearl_trial","style":1,"background":2171,"log_type":1,"src_id":140601015,"trial_step":15},{"step":15,"content":"室内场景随她的介绍开始发生变换，将你与追缉小队的成员彻底隔开。","style":3,"background":2171002,"log_type":1,"src_id":140601016,"trial_step":16},{"step":16,"speaker":"调侃的声音","content":"至于这位亲切的老朋友……","voice":["vo_trial_40601_1_17"],"voice_bank":"vo_pearl_trial","style":1,"background":2171002,"log_type":1,"src_id":140601017,"trial_step":17},{"step":17,"speaker":"调侃的声音","content":"福尔图娜为您准备了一条更特别的入口。请进吧~","voice":["vo_trial_40601_1_18"],"voice_bank":"vo_pearl_trial","style":1,"background":2171002,"log_type":1,"src_id":140601018,"trial_step":18},{"step":18,"content":"空间定格为一条通向剧场深处的走廊，指向其尽头半掩着的小门。","style":3,"background":2174,"log_type":1,"src_id":140601019,"trial_step":19},{"step":19,"options":["推门"],"style":6,"background":2174,"log_type":1,"src_id":140601020,"trial_step":20,"course":3,"choices":[{"text":"推门","goto":21}]},{"step":20,"speaker":"${PlayerName}","content":"……但你明知道我不是来看剧的。","style":2,"background":2174,"log_type":1,"src_id":140601021,"trial_step":21},{"step":21,"content":"这里与剧场中多数房间一样，是由幻象构成的空间。密不透风的墙壁，冰冷的灯光，铁质桌椅……这些元素组成了你最为熟悉的地点，审查室。","style":3,"log_type":1,"src_id":140601025,"trial_step":25,"drawing":1040600},{"step":22,"content":"始作俑者正笑眯眯地坐在审讯桌前，语气轻快又悠闲。","style":3,"log_type":1,"src_id":140601026,"trial_step":26,"drawing":1040600},{"step":23,"speaker":"珀尔夫人","content":"福尔图娜的戏剧一年一次，亲爱的，你回来得太早，演出还没开始呢。","voice":["vo_trial_40601_1_27"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601027,"trial_step":27,"drawing":1040601},{"step":24,"speaker":"珀尔夫人","content":"还是说……你终于被这儿吸引，准备回来当我的男主角了？","female_content":"还是说……你终于被这儿吸引，准备回来当我的女主角了？","voice":["vo_trial_40601_1_28","vo_trial_40601_1_28f"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601028,"trial_step":28,"drawing":1040601},{"step":25,"content":"珀尔夫人轻笑着向你伸出手，看似友好的指尖缠绕着狂厄，只要握上就会被拽入她的演出之中。","style":3,"log_type":1,"src_id":140601029,"trial_step":29,"drawing":1040600},{"step":26,"options":["其他人都去哪了？"],"style":6,"log_type":1,"src_id":140601030,"trial_step":30,"course":3,"drawing":1040600,"choices":[{"text":"其他人都去哪了？","goto":31}]},{"step":27,"speaker":"${PlayerName}","content":"……和我一起进来的人去哪了？","style":2,"log_type":1,"src_id":140601031,"trial_step":31,"drawing":1040600},{"step":28,"speaker":"珀尔夫人","content":"那些小家伙不愿意留下来看戏，好心如我自然是将他们送回去了~","voice":["vo_trial_40601_1_32"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601032,"trial_step":32,"drawing":1040601},{"step":29,"speaker":"珀尔夫人","content":"别担心，看戏本就是你情我愿的事儿，要是观众不开心了，这场戏也就算是演砸了……","voice":["vo_trial_40601_1_33"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601033,"trial_step":33,"drawing":1040601},{"step":30,"speaker":"珀尔夫人","content":"拥抱欲望的演员才是好演员，强迫参演也没意思。","voice":["vo_trial_40601_1_34"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601034,"trial_step":34,"drawing":1040601},{"step":31,"content":"福尔图娜剧场的狂厄之源正坐在你面前。她的能力与这座剧场深度连结在一起，甚至能神不知鬼不觉地将追缉小队的其他成员赶出剧场。","style":3,"log_type":1,"src_id":140601035,"trial_step":35,"drawing":1040601},{"step":32,"content":"女人的手指在桌面上轻点两下，语气中笑意更浓。","style":3,"log_type":1,"src_id":140601036,"trial_step":36,"drawing":1040601},{"step":33,"speaker":"珀尔夫人","content":"但你和他们不一样……我说过，你是我梦寐以求的演员。","voice":["vo_trial_40601_1_37"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601037,"trial_step":37,"drawing":1040603},{"step":34,"speaker":"珀尔夫人","content":"怎么样，要跟我合作吗？","voice":["vo_trial_40601_1_38"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601038,"trial_step":38,"drawing":1040603},{"step":35,"options":["同意","拒绝"],"style":6,"log_type":1,"src_id":140601039,"trial_step":39,"course":3,"drawing":1040603,"choices":[{"text":"同意","goto":40},{"text":"拒绝","goto":42}]},{"step":36,"speaker":"${PlayerName}","content":"好啊。","style":2,"log_type":1,"src_id":140601040,"trial_step":40,"drawing":1040603},{"step":37,"speaker":"${PlayerName}","content":"但在此之前，咱们可以先聊点别的。","style":2,"log_type":1,"src_id":140601041,"trial_step":41,"drawing":1040603,"next":[44]},{"step":38,"speaker":"${PlayerName}","content":"兼职就不必了，我还是更喜欢我的本业。","style":2,"log_type":1,"src_id":140601042,"trial_step":42,"drawing":1040603},{"step":39,"speaker":"${PlayerName}","content":"我今天是来谈另一件事的。","style":2,"log_type":1,"src_id":140601043,"trial_step":43,"drawing":1040603},{"step":40,"speaker":"夜莺","content":"局长，这次情况比较特殊……《禁闭者自由保释规则》刚刚通过，民众对类似事件仍在敏感期，上面希望我们谨慎处理。","voice":["vo_trial_40601_1_44"],"voice_bank":"vo_pearl_trial","style":1,"background":107,"log_type":1,"src_id":140601044,"trial_step":44},{"step":41,"speaker":"夜莺","content":"若您确定对方的沟通意愿强，可以考虑以非强制手段收容。","voice":["vo_trial_40601_1_45"],"voice_bank":"vo_pearl_trial","style":1,"background":107,"log_type":1,"src_id":140601045,"trial_step":45},{"step":42,"speaker":"夜莺","content":"……无论如何，一切以您的安全为重。局长，请小心行动。","voice":["vo_trial_40601_1_46"],"voice_bank":"vo_pearl_trial","style":1,"background":107,"log_type":1,"src_id":140601046,"trial_step":46},{"step":43,"content":"一个人的能力有限。仅靠枷锁，你很难将这位狂级禁闭者强行带离福尔图娜。","style":3,"log_type":1,"src_id":140601047,"trial_step":47,"drawing":1040603},{"step":44,"content":"你需要采取一些<color=#fb9259>特殊手段</color>。","style":3,"log_type":1,"src_id":140601048,"trial_step":48,"drawing":1040603},{"step":45,"speaker":"${PlayerName}","content":"夫人，我想向你提出一项交易。","style":2,"log_type":1,"src_id":140601049,"trial_step":49,"drawing":1040600},{"step":46,"speaker":"${PlayerName}","content":"——从你手中<color=#fb9259>收购</color>福尔图娜剧院。","style":2,"log_type":1,"src_id":140601050,"trial_step":50,"drawing":1040600},{"step":47,"speaker":"珀尔夫人","content":"……","voice":["vo_trial_40601_1_51"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601051,"trial_step":51,"drawing":1040604},{"step":48,"speaker":"珀尔夫人","content":"有意思，我还是第一次遇到胃口这么大的观众。","voice":["vo_trial_40601_1_52"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601052,"trial_step":52,"drawing":1040604},{"step":49,"speaker":"${PlayerName}","content":"在福尔图娜中任何选择都被允许，想必“交易”也包含在里面。","style":2,"log_type":1,"src_id":140601053,"trial_step":53,"drawing":1040604},{"step":50,"speaker":"${PlayerName}","content":"而且，这不正是你擅长的领域吗？","style":2,"log_type":1,"src_id":140601054,"trial_step":54,"drawing":1040604},{"step":51,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":55,"course":6,"drawing":1040600},{"step":52,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":55,"course":6,"drawing":1040600},{"step":53,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":55,"course":6,"drawing":1040600},{"step":54,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":55,"course":6,"drawing":1040600},{"step":55,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":55,"course":6,"drawing":1040600},{"step":56,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":55,"course":6,"drawing":1040600},{"step":57,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":55,"course":6,"drawing":1040600},{"step":58,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":55,"course":6,"drawing":1040600},{"step":59,"content":"福尔图娜剧团成立于N.F.106年，长期于新城外围进行歌舞巡演，其表演在某些圈层中小有名气。\n\nN.F.112年原本的小剧团被收并，重建为如今奢华的沉浸式剧场。","style":10,"log_type":1,"src_id":140601056,"trial_step":56,"drawing":1040600},{"step":60,"content":"剧场现任持有者：“珀尔夫人”。对象出身于富商世家，早年主要进行各类商业活动，是新城小有名气的投资人。\n\n收购福尔图娜后顺势遣散剧团大部分成员并进行改建，一手建立了当下的福尔图娜剧场。\n\n新剧团强调每年仅限一场演出、人员每年轮换、且不会上演重复剧本。","style":10,"log_type":1,"src_id":140601057,"trial_step":57,"drawing":1040600},{"step":61,"content":"此外，情报科收集了早期与该对象相关的所有交易信息——\n包括收购福尔图娜剧场在内，她的投资没有一次失手。","style":10,"log_type":1,"src_id":140601058,"trial_step":58,"drawing":1040600},{"step":62,"speaker":"${PlayerName}","content":"情报科调查了那晚所有演员的身份，部分演员正是去年前来观戏后失踪的观众。","style":2,"log_type":1,"src_id":140601059,"trial_step":59,"drawing":1040600},{"step":63,"speaker":"${PlayerName}","content":"人口失踪再加上狂厄传播，MBCC必须插手管制福尔图娜的演出。","style":2,"log_type":1,"src_id":140601060,"trial_step":60,"drawing":1040600},{"step":64,"speaker":"${PlayerName}","content":"但看样子，你不会直接跟我走。","style":2,"log_type":1,"src_id":140601061,"trial_step":61,"drawing":1040600},{"step":65,"content":"珀尔似乎默认了你的假设，笑着示意你继续。","style":3,"log_type":1,"src_id":140601062,"trial_step":62,"drawing":1040600},{"step":66,"speaker":"${PlayerName}","content":"……所以，我准备换个方式解决问题。","style":2,"log_type":1,"src_id":140601063,"trial_step":63,"drawing":1040600},{"step":67,"speaker":"${PlayerName}","content":"MBCC会给出一个令你满意的价格。","style":2,"log_type":1,"src_id":140601064,"trial_step":64,"drawing":1040600},{"step":68,"speaker":"珀尔夫人","content":"……哎。","voice":["vo_trial_40601_1_65"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601065,"trial_step":65,"drawing":1040603},{"step":69,"speaker":"珀尔夫人","content":"兜兜绕绕，没想到最后还是回了最无聊的环节。","voice":["vo_trial_40601_1_66"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601066,"trial_step":66,"drawing":1040603},{"step":70,"speaker":"珀尔夫人","content":"虽然我暂时还没有把宝贝转手的打算……但也可以听听你的报价。来吧亲爱的，你想给出多少呢？","voice":["vo_trial_40601_1_67"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601067,"trial_step":67,"drawing":1040603},{"step":71,"content":"交易双方皆已坐上谈判桌，拍卖者正等待你的出价。","style":3,"log_type":1,"src_id":140601068,"trial_step":68,"drawing":1040603},{"step":72,"options":["给出报价"],"style":6,"log_type":1,"src_id":140601069,"trial_step":69,"course":3,"drawing":1040603,"choices":[{"text":"给出报价","goto":70}]},{"step":73,"content":"你给出了一个相当可观的价格。可观到必须向上报批的程度。","style":3,"log_type":1,"src_id":140601070,"trial_step":70,"drawing":1040603},{"step":74,"speaker":"${PlayerName}","content":"……目前你的禁闭者身份已然暴露，福尔图娜必不可能再正常营业。","style":2,"log_type":1,"src_id":140601071,"trial_step":71,"drawing":1040600},{"step":75,"speaker":"${PlayerName}","content":"若后续交由市议会，剧场肯定会被强制取缔，彻底消杀后挪做他用……但我可以将剧院的管理权争取到MBCC手上。","style":2,"log_type":1,"src_id":140601072,"trial_step":72,"drawing":1040600},{"step":76,"content":"你一本正经地讲着同僚机构的坏话，演得毫不心虚。","style":3,"log_type":1,"src_id":140601073,"trial_step":73,"drawing":1040600},{"step":77,"speaker":"${PlayerName}","content":"无害的剧团成员会得到妥善安置，而你最重视的剧场会得到最大程度的保留。","style":2,"log_type":1,"src_id":140601074,"trial_step":74,"drawing":1040600},{"step":78,"speaker":"${PlayerName}","content":"管理局会提供一笔资金，他们可以继续演艺活动，也可以转行。定例的后续监察会持续一段时间，但她们的自由不会受限。","style":2,"log_type":1,"src_id":140601075,"trial_step":75,"drawing":1040600},{"step":79,"speaker":"珀尔夫人","content":"但条件是我必须接受收容，跟你离开福尔图娜？","voice":["vo_trial_40601_1_76"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601076,"trial_step":76,"drawing":1040600},{"step":80,"speaker":"${PlayerName}","content":"……没错。","style":2,"log_type":1,"src_id":140601077,"trial_step":77,"drawing":1040600},{"step":81,"content":"你将条件摆上谈判桌。交易的另一方此时正垂下帽檐，似乎正在思考什么。","style":3,"log_type":1,"src_id":140601078,"trial_step":78,"drawing":1040603},{"step":82,"speaker":"珀尔夫人","content":"嗯……听起来很诱人。","voice":["vo_trial_40601_1_79"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601079,"trial_step":79,"drawing":1040603},{"step":83,"speaker":"珀尔夫人","content":"很有分量的提案，亲爱的。考虑周到，我相信你的诚意。","voice":["vo_trial_40601_1_80"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601080,"trial_step":80,"drawing":1040603},{"step":84,"speaker":"珀尔夫人","content":"但福尔图娜估计比你想的值钱一点儿。","voice":["vo_trial_40601_1_81"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601081,"trial_step":81,"drawing":1040601},{"step":85,"speaker":"珀尔夫人","content":"当年这座剧场也算是个烫手山芋，我可是花了好大力气才让这个亏钱买卖由亏转盈……","voice":["vo_trial_40601_1_82"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601082,"trial_step":82,"drawing":1040601},{"step":86,"speaker":"珀尔夫人","content":"既然准备跟我谈判，那得先准备好更有趣的价码才行。","voice":["vo_trial_40601_1_83"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601083,"trial_step":83,"drawing":1040603},{"step":87,"content":"珀尔夫人轻轻拈起桌面上的报告，弹了弹纸面，她的目光锐利而冷静。","style":3,"log_type":1,"src_id":140601084,"trial_step":84,"drawing":1040603},{"step":88,"speaker":"珀尔夫人","content":"让我教你一招吧，亲爱的。","voice":["vo_trial_40601_1_85"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601085,"trial_step":85,"drawing":1040603},{"step":89,"speaker":"珀尔夫人","content":"谈判、交易，比起虚高的金额，出价者更应该注意卖家真正的需求。","voice":["vo_trial_40601_1_86"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601086,"trial_step":86,"drawing":1040603},{"step":90,"speaker":"珀尔夫人","content":"就比如……对我来说，福尔图娜可不仅是一座能赚钱的剧院那么简单。","voice":["vo_trial_40601_1_87"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601087,"trial_step":87,"drawing":1040604},{"step":91,"content":"珀尔夫人的语气陡然一变，谈判桌的气氛瞬间变得危险。禁闭者的强大异能蓄势待发，宛若整座房间都在向你施压。","style":3,"log_type":1,"src_id":140601088,"trial_step":88,"drawing":1040604},{"step":92,"speaker":"珀尔夫人","content":"可爱的福尔图娜……所有人走进它时都能重唤梦想，老人重回幼年，乞丐变为富翁，明明知道自己在扮演，却比任何演员都更加投入……","voice":["vo_trial_40601_1_89"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601089,"trial_step":89,"drawing":1040604},{"step":93,"speaker":"珀尔夫人","content":"这里能让他们在虚假剧目中展露真实的自己，探索生命的另一个选择，直到这些细小却鲜活的渴望迈向结局。","voice":["vo_trial_40601_1_90"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601090,"trial_step":90,"drawing":1040604},{"step":94,"speaker":"珀尔夫人","content":"那份真诚、那份挣扎、那份热情——对我来说，这才是福尔图娜真正的价值！","voice":["vo_trial_40601_1_91"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601091,"trial_step":91,"drawing":1040604},{"step":95,"content":"如你第一次在幕布后见到她时那样，珀尔夫人眼中闪着狂热的光，其中盈满了期待、渴望，以及你难以看懂的复杂情绪。","style":3,"log_type":1,"src_id":140601092,"trial_step":92,"drawing":1040604},{"step":96,"speaker":"珀尔夫人","content":"而我愿为此付出一切。","voice":["vo_trial_40601_1_93"],"voice_bank":"vo_pearl_trial","style":1,"log_type":1,"src_id":140601093,"trial_step":93,"drawing":1040604},{"step":97,"content":"审查室的外壳破碎，空间随着她的话语变化扭曲，但当事人却不紧不慢地从椅子上起身，缓步走到你身边——","style":3,"background":10003,"log_type":1,"src_id":140601094,"trial_step":94},{"step":98,"speaker":"珀尔夫人","content":"我曾在这里看过两次无与伦比的戏，我第一次踏进来的时候……","voice":["vo_trial_40601_1_95"],"voice_bank":"vo_pearl_trial","style":1,"background":10003,"log_type":1,"src_id":140601095,"trial_step":95},{"step":99,"speaker":"珀尔夫人","content":"以及我第一次见到你的时候。","voice":["vo_trial_40601_1_96"],"voice_bank":"vo_pearl_trial","style":1,"background":10003,"log_type":1,"src_id":140601096,"trial_step":96},{"step":100,"speaker":"珀尔夫人","content":"亲爱的，想要我的剧院，就得把最值钱的东西一起买走……你需要再向前迈一步……","voice":["vo_trial_40601_1_97"],"voice_bank":"vo_pearl_trial","style":1,"background":10003,"log_type":1,"src_id":140601097,"trial_step":97},{"step":101,"content":"珀尔夫人发出邀请，她向你伸出手，掌心萦绕着熟悉的狂厄波动。","style":3,"background":10003,"log_type":1,"src_id":140601098,"trial_step":98},{"step":102,"speaker":"珀尔夫人","content":"交易？可以，当然可以！","voice":["vo_trial_40601_1_99"],"voice_bank":"vo_pearl_trial","style":1,"background":10003,"log_type":1,"src_id":140601099,"trial_step":99},{"step":103,"speaker":"珀尔夫人","content":"以两小时为限，我将为你展示我的最后一部剧本。这部剧本该明年上演，但我更想与你一同欣赏。","voice":["vo_trial_40601_1_100"],"voice_bank":"vo_pearl_trial","style":1,"background":10003,"log_type":1,"src_id":140601100,"trial_step":100},{"step":104,"speaker":"珀尔夫人","content":"我希望你能陪我一起见证它，完善它，找到最完美的结局——","voice":["vo_trial_40601_1_101"],"voice_bank":"vo_pearl_trial","style":1,"background":10003,"log_type":1,"src_id":140601101,"trial_step":101},{"step":105,"speaker":"珀尔夫人","content":"再让我感受一次那种热情——这就是我的条件。","voice":["vo_trial_40601_1_102"],"voice_bank":"vo_pearl_trial","style":1,"background":10003,"log_type":1,"src_id":140601102,"trial_step":102},{"step":106,"speaker":"${PlayerName}","content":"……","style":2,"background":10003,"log_type":1,"src_id":140601103,"trial_step":103},{"step":107,"content":"珀尔夫人话中的真诚并非作伪，她的邀请比起交易更像一场赌约，你必须深入险境攫取宝藏。","style":3,"background":10003,"log_type":1,"src_id":140601104,"trial_step":104},{"step":108,"options":["但我不当演员"],"style":6,"background":10003,"log_type":1,"src_id":140601105,"trial_step":105,"course":3,"choices":[{"text":"但我不当演员","goto":106}]},{"step":109,"speaker":"${PlayerName}","content":"但和之前一样，我或许会拒绝你的诱导。","style":2,"background":10003,"log_type":1,"src_id":140601106,"trial_step":106},{"step":110,"speaker":"珀尔夫人","content":"当然可以。","voice":["vo_trial_40601_1_107"],"voice_bank":"vo_pearl_trial","style":1,"background":10003,"log_type":1,"src_id":140601107,"trial_step":107},{"step":111,"speaker":"珀尔夫人","content":"而且你不是早明白了吗？对于一心想走出去的观众，我这小剧场可拦不住你们……","voice":["vo_trial_40601_1_108"],"voice_bank":"vo_pearl_trial","style":1,"background":10003,"log_type":1,"src_id":140601108,"trial_step":108},{"step":112,"content":"你回握住她的手。","style":3,"background":10003,"log_type":1,"src_id":140601109,"trial_step":109},{"step":113,"content":"瞬间，如火般灼热的狂厄自指尖蔓延至全身。与此同时，审查室的伪装彻底破碎，剥离出舞台的本貌。","style":3,"background":2173,"log_type":1,"src_id":140601110,"trial_step":110},{"step":114,"speaker":"珀尔夫人","content":"交易成立，亲爱的。","voice":["vo_trial_40601_1_111"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140601111,"trial_step":111},{"step":115,"speaker":"珀尔夫人","content":"这将是福尔图娜的最后一场演出——","voice":["vo_trial_40601_1_112"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140601112,"trial_step":112},{"step":116,"speaker":"珀尔夫人","content":"可千万、千万别让我失望啊。","voice":["vo_trial_40601_1_113"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140601113,"trial_step":113}]}