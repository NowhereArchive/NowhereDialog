{"id":400401402,"chapter_id":50016,"scene_id":51622,"steps":[{"step":1,"speaker":"嗷呜","content":"呜……骗人，这根本就是普通的糖果……嗷呜……","voice":["vo_event_400401402_2"],"voice_bank":"vo_event_04014","style":1,"background":2019,"log_type":1},{"step":3,"content":"随着嗷呜大魔王被打败，村民们也纷纷获得了自由。","style":3,"background":10000,"log_type":1},{"step":4,"content":"就这样，童话世界又恢复了往日的宁静。","style":3,"background":10000,"log_type":1},{"step":5,"content":"当然，不能忘了拯救了大家的英雄。","style":3,"background":10000,"log_type":1},{"step":6,"content":"虽然她没能吃下勇气糖果，但大家都说——","style":3,"background":4045,"log_type":1},{"step":7,"content":"那个曾经胆小的姑娘，收获了真正的勇气。","style":3,"background":4045,"log_type":1}]}