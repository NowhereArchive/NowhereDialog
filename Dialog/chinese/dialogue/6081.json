{"id":6081,"chapter_id":6,"scene_id":608,"steps":[{"step":1,"speaker":"海拉","content":"这些家伙……还能叫死役吗？砍哪儿都死不了，还能再长出来。","voice":["vo_cgplot_6081001"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":2,"speaker":"死役","content":"咕啊啊啊啊啊啊啊啊——！！！","voice":["vo_cgplot_6081002"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":3,"speaker":"海拉","content":"呵、呵……呵呵，而且还挺齐心。","voice":["vo_cgplot_6081003"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":4,"speaker":"赫卡蒂","content":"看着脚下！","voice":["vo_cgplot_6081004"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":5,"content":"锈蚀污染以惊人的速度析出壮大，侵蚀雕像所在的现实空间。这里整个浸泡在环主的精神污染之中，不服从她意志的你们才是另类。","style":3,"background":511,"log_type":1},{"step":6,"speaker":"赫卡蒂","content":"呜……这就是黑环的力量吗？一切由环的主人决定，她能控制环里的所有。","voice":["vo_cgplot_6081006"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"这样的战斗不会结束，它们没有死亡的概念。","voice":["vo_cgplot_6081007"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":8,"speaker":"海拉","content":"那我们还怎么打？！能回去吗？","voice":["vo_cgplot_6081008"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":9,"speaker":"赫卡蒂","content":"回去的路也被堵住了，这座雕像已经彻底脱离现实了。","voice":["vo_cgplot_6081009"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":10,"options":["向上突围，只能这么做了！"],"jump":[11],"style":6,"background":511,"log_type":1}]}