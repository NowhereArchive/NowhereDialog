{"id":1060703,"chapter_id":1060703,"scene_id":1,"steps":[{"step":1,"speaker":"？？？","content":"我都已经同意把它送走了，你还要怎样！？","voice":["vo_trial_60703_1_1"],"voice_bank":"vo_ll_trial","style":1,"background":2101,"log_type":1,"src_id":160703001,"trial_step":1},{"step":2,"speaker":"？？？","content":"我现在就去！满意了吧！？","voice":["vo_trial_60703_1_2"],"voice_bank":"vo_ll_trial","style":1,"background":2101,"log_type":1,"src_id":160703002,"trial_step":2},{"step":3,"content":"有些气急败坏的声音从楼道里传出，你急忙拉着萝尔莱伊闪到了小花坛的树丛后。","style":3,"background":2101,"log_type":1,"src_id":160703003,"trial_step":3},{"step":4,"content":"下一秒从楼道内走出来的是一位年轻妇人，她愤愤地挂断了电话，用力把手机塞进口袋。她的另一只手上还提着一个宠物包和一个塞得鼓鼓囊囊的大号帆布袋。","style":3,"background":2101,"log_type":1,"src_id":160703004,"trial_step":4},{"step":5,"content":"看到那位年轻妇人的脸时，萝尔莱伊小小地惊呼了一声，朝你点了点头——是艾达没错！","style":3,"background":2101,"log_type":1,"src_id":160703005,"trial_step":5},{"step":6,"content":"只是当目光移到她挺起的大肚子上时，萝尔莱伊惊讶地瞪大了眼睛。","style":3,"background":2101,"log_type":1,"src_id":160703006,"trial_step":6},{"step":7,"speaker":"萝尔莱伊","content":"她……？","voice":["vo_trial_60703_1_7"],"voice_bank":"vo_ll_trial","style":1,"background":2101,"log_type":1,"src_id":160703007,"trial_step":7},{"step":8,"content":"你对萝尔莱伊做了个噤声的手势，等待孕妇稍稍走远了一些之后，带着萝尔莱伊悄悄跟上。","style":3,"background":2101,"log_type":1,"src_id":160703008,"trial_step":8},{"step":9,"content":"她就是艾达没错吧？","style":2,"background":2101,"log_type":1,"src_id":160703009,"trial_step":9},{"step":10,"speaker":"萝尔莱伊","content":"嗯，虽然长大了很多，但我能认出来，很熟悉……她手上提着的，该不会是白菜吧？","voice":["vo_trial_60703_1_10"],"voice_bank":"vo_ll_trial","style":1,"background":2101,"log_type":1,"src_id":160703010,"trial_step":10},{"step":11,"content":"虽然带着你做跟踪这种事有点不好，但毕竟是你的朋友，对吧。","style":2,"background":2101,"log_type":1,"src_id":160703011,"trial_step":11},{"step":12,"speaker":"萝尔莱伊","content":"朋友……嗯，想要和她成为朋友。","voice":["vo_trial_60703_1_12"],"voice_bank":"vo_ll_trial","style":1,"background":2101,"log_type":1,"src_id":160703012,"trial_step":12},{"step":13,"content":"那走吧，跟上去……还有，别告诉夜莺。","style":2,"background":2101,"log_type":1,"src_id":160703013,"trial_step":13},{"step":14,"content":"你们跟着艾达走过一个街区，她气冲冲地一直向前走，仿佛早就知道该去哪里了——最后，你们看着她走进了一家宠物店。","style":3,"background":2219,"log_type":1,"src_id":160703014,"trial_step":14},{"step":15,"content":"你和萝尔莱伊交换了一个疑惑的眼神，也跟了进去。","style":3,"background":2219,"log_type":1,"src_id":160703015,"trial_step":15},{"step":16,"content":"你们走到角落里，一边假装成正在挑选宠物的顾客，一边悄悄关注着艾达的动向。","style":3,"background":1005,"log_type":1,"src_id":160703016,"trial_step":16},{"step":17,"speaker":"店长","content":"下午好，这次是要来给白菜买点什么？它用的这款宠物沐浴液刚到了一批新货，还在打折，要不要囤点？很划算的。","voice":["vo_trial_60703_1_17"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703017,"trial_step":17},{"step":18,"content":"店长熟稔地和艾达打了个招呼，显然后者已经是这家宠物店的常客了。","style":3,"background":1005,"log_type":1,"src_id":160703018,"trial_step":18},{"step":19,"speaker":"艾达","content":"……恐怕之后都用不上了吧。","voice":["vo_trial_60703_1_19"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703019,"trial_step":19},{"step":20,"content":"艾达叹了口气，把手里的东西放到了柜台上，拉开宠物包的拉链，把里面的白色小狗抱了出来。","style":3,"background":1005,"log_type":1,"src_id":160703020,"trial_step":20},{"step":21,"content":"小狗的眼睛亮亮的，一身雪白的卷毛打理得很干净，一看就是被好好照顾和爱护着的。","style":3,"background":1005,"log_type":1,"src_id":160703021,"trial_step":21},{"step":22,"content":"然而它的左前腿却短了一截，走动起来有些艰难，但它还是一瘸一拐地蹭过去友好地舔了舔店主的手。","style":3,"background":1005,"log_type":1,"src_id":160703022,"trial_step":22},{"step":23,"speaker":"萝尔莱伊","content":"白菜的腿怎么了！？它以前腿上没有伤的！","voice":["vo_trial_60703_1_23"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703023,"trial_step":23},{"step":24,"content":"萝尔莱伊捂住嘴，小声地惊呼，你示意她稍安勿躁，继续往下听。","style":3,"background":1005,"log_type":1,"src_id":160703024,"trial_step":24},{"step":25,"content":"艾达轻抚着白菜，一脸愁容，只是没一会儿，她的脸上就开始泛红，还打起了喷嚏。无奈，她只好掏出了一只口罩，紧紧地带上。","style":3,"background":1005,"log_type":1,"src_id":160703025,"trial_step":25},{"step":26,"speaker":"艾达","content":"你知道的，自从怀孕以后我就莫名其妙开始对白菜过敏了，家里人发现后就一直劝我把它送走。","voice":["vo_trial_60703_1_26"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703026,"trial_step":26},{"step":27,"speaker":"艾达","content":"一开始症状没有太严重，只是偶尔打喷嚏，我还是可以勉强顶住他们的压力。但是这些天不行了。","voice":["vo_trial_60703_1_27"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703027,"trial_step":27},{"step":28,"speaker":"艾达","content":"白菜它已经陪了我那么多年，对我来说早就已经和亲人没什么分别了。更何况它有心脏病，还意外伤了腿，我怎么能放心把它交给别人呢？别人会像我一样照顾它吗？","voice":["vo_trial_60703_1_28"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703028,"trial_step":28},{"step":29,"content":"眼见艾达身上都开始泛红，店主连忙接过白菜，把它放到柜台上，又给艾达抹了些舒缓药剂，带她走到了宠物店门口通气的地方。","style":3,"background":1005,"log_type":1,"src_id":160703029,"trial_step":29},{"step":30,"speaker":"艾达","content":"家里已经鸡飞狗跳了好多天，他们威胁我如果再不马上把白菜送走，他们就自己去把它处理掉。","voice":["vo_trial_60703_1_30"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703030,"trial_step":30},{"step":31,"speaker":"艾达","content":"为了这件事我每天都在跟他们大吵大闹，但冷静下来想一想，这样子下去确实也不是个办法……","voice":["vo_trial_60703_1_31"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703031,"trial_step":31},{"step":32,"content":"她摸了摸自己的肚子。","style":3,"background":1005,"log_type":1,"src_id":160703032,"trial_step":32},{"step":33,"speaker":"艾达","content":"毕竟我既然决定要这个小家伙……就得对这个小家伙负责呢。","voice":["vo_trial_60703_1_33"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703033,"trial_step":33},{"step":34,"content":"店长沉默了片刻，也叹了口气。","style":3,"background":1005,"log_type":1,"src_id":160703034,"trial_step":34},{"step":35,"speaker":"店长","content":"也是啊……所以你打算怎么办？","voice":["vo_trial_60703_1_35"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703035,"trial_step":35},{"step":36,"speaker":"艾达","content":"我知道这个请求可能有些冒昧，但是……我可以把它暂时寄养在你这里一段时间吗？我会去找找有没有人愿意领养白菜，在帮它找到新家之前，照顾它的所有花费我都会支付……","voice":["vo_trial_60703_1_36"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703036,"trial_step":36},{"step":37,"speaker":"店长","content":"钱倒是其次，我只是担心它的身体状况可能很难找到新家。毕竟大多数人都应该会更想要一只健康的小狗吧？","voice":["vo_trial_60703_1_37"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703037,"trial_step":37},{"step":38,"content":"店长看着柜台上的小狗，响亮地吹了声口哨，对自己将来命运一无所知的小狗乐呵乐呵地回应了一声，高兴地摇着尾巴转圈圈。","style":3,"background":1005,"log_type":1,"src_id":160703038,"trial_step":38},{"step":39,"speaker":"店长","content":"不过你放心，我会好好照顾它，它找新主人这件事我也会一起帮忙留意……","voice":["vo_trial_60703_1_39"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703039,"trial_step":39},{"step":40,"speaker":"？","content":"哇！好可爱的小狗！它还会转圈诶！","voice":["vo_trial_60703_1_40"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703040,"trial_step":40},{"step":41,"content":"突然，你们的耳边响起了一个稚嫩童声，紧接着一个小小的身影旋风一般钻进宠物店的大门，径直冲到了柜台前，两眼放光地紧盯着白菜。","style":3,"background":1005,"log_type":1,"src_id":160703041,"trial_step":41},{"step":42,"speaker":"女孩","content":"叔叔阿姨，请问我可以抱一抱这只小狗吗！我好喜欢它啊！","voice":["vo_trial_60703_1_42"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703042,"trial_step":42},{"step":43,"content":"艾达显然也是一时没有反应过来，愣了片刻之后，才微笑着点了点头，让店长把白菜小心翼翼地抱到了小女孩的手上。","style":3,"background":1005,"log_type":1,"src_id":160703043,"trial_step":43},{"step":44,"speaker":"艾达","content":"当然可以。不过你要小心一点抱稳哦，它的腿脚不太好。","voice":["vo_trial_60703_1_44"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703044,"trial_step":44},{"step":45,"speaker":"女孩","content":"嗯，我会注意的。","voice":["vo_trial_60703_1_45"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703045,"trial_step":45},{"step":46,"content":"女孩一边逗白菜一边笑嘻嘻地问道。","style":3,"background":1005,"log_type":1,"src_id":160703046,"trial_step":46},{"step":47,"speaker":"女孩","content":"阿姨，小狗叫什么名字呀？","voice":["vo_trial_60703_1_47"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703047,"trial_step":47},{"step":48,"speaker":"艾达","content":"它叫白菜。","voice":["vo_trial_60703_1_48"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703048,"trial_step":48},{"step":49,"speaker":"女孩","content":"哇，好可爱的名字，就和它本身一样可爱！","voice":["vo_trial_60703_1_49"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703049,"trial_step":49},{"step":50,"speaker":"女孩","content":"阿姨，我刚才听到了，你们是要给它找新家吗？","voice":["vo_trial_60703_1_50"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703050,"trial_step":50},{"step":51,"speaker":"艾达","content":"对呀。因为阿姨怀孕了，没法继续好好照顾它了，所以需要帮它找一个能够好好照顾它的新主人。","voice":["vo_trial_60703_1_51"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703051,"trial_step":51},{"step":52,"speaker":"女孩","content":"这样啊……","voice":["vo_trial_60703_1_52"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703052,"trial_step":52},{"step":53,"content":"女孩若有所思地点了点头，这时一对夫妇也走了进来。","style":3,"background":1005,"log_type":1,"src_id":160703053,"trial_step":53},{"step":54,"speaker":"女人","content":"都跟你说了多少次了，不要跑得这么急。你看你，出了那么多汗。","voice":["vo_trial_60703_1_54"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703054,"trial_step":54},{"step":55,"content":"女人虽然嘴上数落着小女孩，但还是疼惜地弯下腰来帮她擦了擦额头上的汗，一旁提着好多购物袋的男人也附和地点了点头。","style":3,"background":1005,"log_type":1,"src_id":160703055,"trial_step":55},{"step":56,"speaker":"男人","content":"对啊，你这样不听话可是会让妈妈担心的哦。","voice":["vo_trial_60703_1_56"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703056,"trial_step":56},{"step":57,"speaker":"女孩","content":"对不起呀爸爸妈妈，我就是看到这只小狗太可爱了，所以才跑得快了一点。","voice":["vo_trial_60703_1_57"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703057,"trial_step":57},{"step":58,"content":"紧接着女孩像献宝一样把怀里的小狗高高举到了夫妇的面前。","style":3,"background":1005,"log_type":1,"src_id":160703058,"trial_step":58},{"step":59,"speaker":"女孩","content":"爸爸妈妈你们看，它叫白菜！是不是很可爱！它正在找新家，我们可不可以带它回家啊？","voice":["vo_trial_60703_1_59"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703059,"trial_step":59},{"step":60,"content":"男人的表情原本十分温和，但在注意到小狗缺了一截的前腿时却僵硬了一瞬。他的脸色阴沉下来，变得有些严厉。","style":3,"background":1005,"log_type":1,"src_id":160703060,"trial_step":60},{"step":61,"speaker":"男人","content":"你想养宠物可以，但这只狗绝对不可以！","voice":["vo_trial_60703_1_61"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703061,"trial_step":61},{"step":62,"content":"女孩似乎一下子被父亲过于突然的转变吓住了，好一会儿才重新鼓起勇气，有些困惑又不甘心地撅起嘴。","style":3,"background":1005,"log_type":1,"src_id":160703062,"trial_step":62},{"step":63,"speaker":"女孩","content":"为什么？","voice":["vo_trial_60703_1_63"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703063,"trial_step":63},{"step":64,"speaker":"男人","content":"你没看到它是残疾的吗！？","voice":["vo_trial_60703_1_64"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703064,"trial_step":64},{"step":65,"speaker":"女孩","content":"那又有什么关系！我很喜欢它，我会好好照顾它的！","voice":["vo_trial_60703_1_65"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703065,"trial_step":65},{"step":66,"content":"女孩一边争辩一边把求助的目光转向一直没有出声的母亲，但她并没有得到想象中的支持。女人避开小孩的目光叹了口气。","style":3,"background":1005,"log_type":1,"src_id":160703066,"trial_step":66},{"step":67,"speaker":"女人","content":"你说你会好好照顾它，或许一天可以，一周可以，一个月也可以，但是一年呢？两年呢？","voice":["vo_trial_60703_1_67"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703067,"trial_step":67},{"step":68,"content":"女人蹲下来，怜爱地摸了摸女孩的头，轻声安慰着。","style":3,"background":1005,"log_type":1,"src_id":160703068,"trial_step":68},{"step":69,"speaker":"女人","content":"照顾生病的小狗，和照顾生病的人一样，是很耗费时间精力的。你还小，还不能理解和体会这些……","voice":["vo_trial_60703_1_69"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703069,"trial_step":69},{"step":70,"speaker":"女孩","content":"可是，我现在能做很多家务了，我一定能照顾好它的！就让我——","voice":["vo_trial_60703_1_70"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703070,"trial_step":70},{"step":71,"content":"女孩还想据理力争些什么，却被硬生生打断。","style":3,"background":1005,"log_type":1,"src_id":160703071,"trial_step":71},{"step":72,"speaker":"女人","content":"宝贝，不要任性。无论你一开始多么的喜欢它、爱它，信誓旦旦地说着什么永远不离不弃，时间长了一样都会感到厌烦。","voice":["vo_trial_60703_1_72"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703072,"trial_step":72},{"step":73,"speaker":"女人","content":"为了照顾它，你要分出很多很多属于你自己的时间。你可能从此不能自己出门找其他小朋友玩，或者不能看电视玩游戏，而是要陪着它治病，你会愿意吗？","voice":["vo_trial_60703_1_73"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703073,"trial_step":73},{"step":74,"speaker":"女人","content":"不仅如此，你还需要给它买药，带它去医院检查……你的所有零花钱都不一定够用，你也没有办法像现在一样随心所欲地买自己喜欢的零食和玩具了。这样也没关系吗？","voice":["vo_trial_60703_1_74"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703074,"trial_step":74},{"step":75,"speaker":"女人","content":"而且最残酷的是，无论你多么悉心地照顾它，它的身体状况都不会有任何改善的可能。它的这辈子都只能是这个样子了，没有办法陪你出门，没有办法和你一起奔跑和玩耍……","voice":["vo_trial_60703_1_75"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703075,"trial_step":75},{"step":76,"speaker":"女人","content":"未来的某一天，你会因为这些而怨恨它，把它看作是一种负担和累赘，进而后悔自己当初的决定吗？","voice":["vo_trial_60703_1_76"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703076,"trial_step":76},{"step":77,"content":"女人絮絮叨叨地说着大道理，几乎没有管女孩听不听得懂，她和男人对视了一会儿，仿佛一起回想起了什么让他们苦不堪言的过去。","style":3,"background":1005,"log_type":1,"src_id":160703077,"trial_step":77},{"step":78,"speaker":"女孩","content":"我……我……","voice":["vo_trial_60703_1_78"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703078,"trial_step":78},{"step":79,"content":"女孩发现自己根本无法回答母亲提出的问题，有些沮丧地垂下了头。","style":3,"background":1005,"log_type":1,"src_id":160703079,"trial_step":79},{"step":80,"content":"这时男人走上来，慈爱地拍了拍她的肩膀。","style":3,"background":1005,"log_type":1,"src_id":160703080,"trial_step":80},{"step":81,"speaker":"男人","content":"爸爸妈妈都是过来人，这条路有多艰难我们是知道的。","voice":["vo_trial_60703_1_81"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703081,"trial_step":81},{"step":82,"speaker":"男人","content":"所以听爸爸妈妈的话，去挑选一只健康的小狗，然后和它一起快乐幸福地长大吧。你明明有那么多选择，为什么偏偏要做出一个未来会让自己后悔的选择呢？","voice":["vo_trial_60703_1_82"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703082,"trial_step":82},{"step":83,"content":"女孩攥紧拳头看了看小狗，又抬头看向她的父亲，做出了一番最后的挣扎和斗争，但最终还是泄气地垮下了肩膀。","style":3,"background":1005,"log_type":1,"src_id":160703083,"trial_step":83},{"step":84,"speaker":"女孩","content":"好吧……","voice":["vo_trial_60703_1_84"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703084,"trial_step":84},{"step":85,"speaker":"男人","content":"对嘛，这才是爸爸妈妈的乖女儿。","voice":["vo_trial_60703_1_85"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703085,"trial_step":85},{"step":86,"speaker":"男人","content":"好了，别难过了。走，为了奖励懂事的宝贝，咱们一起去超市里选一大堆你最喜欢的零食，然后再挑一块最好的牛肉，爸爸回去给你做你最爱吃的炖牛腩！","voice":["vo_trial_60703_1_86"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703086,"trial_step":86},{"step":87,"speaker":"女孩","content":"真、真的吗！","voice":["vo_trial_60703_1_87"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703087,"trial_step":87},{"step":88,"content":"听到这句话的瞬间，女孩的眼睛一下子亮了起来，刚刚所有的沮丧似乎瞬间便被抛到了脑后。","style":3,"background":1005,"log_type":1,"src_id":160703088,"trial_step":88},{"step":89,"speaker":"男人","content":"当然，爸爸什么时候骗过你？","voice":["vo_trial_60703_1_89"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703089,"trial_step":89},{"step":90,"content":"女人也摸了摸女儿的头，笑着开口道。","style":3,"background":1005,"log_type":1,"src_id":160703090,"trial_step":90},{"step":91,"speaker":"女人","content":"既然这么想要养一只小狗，那你有没有考虑过要选哪一个品种呢？","voice":["vo_trial_60703_1_91"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703091,"trial_step":91},{"step":92,"speaker":"女孩","content":"咦？不同品种的小狗除了长得不一样还有什么不一样吗？","voice":["vo_trial_60703_1_92"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703092,"trial_step":92},{"step":93,"speaker":"女人","content":"差别可多了。像是性格脾气啊、生活习性什么的，不同品种的小狗都会有很大的差别呢。","voice":["vo_trial_60703_1_93"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703093,"trial_step":93},{"step":94,"speaker":"女孩","content":"原来如此……","voice":["vo_trial_60703_1_94"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703094,"trial_step":94},{"step":95,"speaker":"女人","content":"这样吧，我们可以回去一起好好做些功课。毕竟挑选一只小狗作为家里的新成员也是一件需要非常慎重考虑的大事嘛！","voice":["vo_trial_60703_1_95"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703095,"trial_step":95},{"step":96,"speaker":"女孩","content":"好耶！妈妈最棒了！","voice":["vo_trial_60703_1_96"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703096,"trial_step":96},{"step":97,"content":"……","style":3,"background":1005,"log_type":1,"src_id":160703097,"trial_step":97},{"step":98,"content":"艾达和店主看着一家三口离去的背影，不约而同地陷入了沉默。只有白菜还在眼巴巴地望着门外摇尾巴，似乎并不明白自己为何会被突然丢下。","style":3,"background":1005,"log_type":1,"src_id":160703098,"trial_step":98},{"step":99,"content":"女人的话虽残酷，却字字都是现实，令人听得心中沉重。但你更为这只小狗感到遗憾和惋惜，不禁也开始担忧起了它的未来。","style":3,"background":1005,"log_type":1,"src_id":160703099,"trial_step":99},{"step":100,"content":"身旁安静得就快凝固的空气让你几乎都要忘了自己还有一个同行者。","style":3,"background":1005,"log_type":1,"src_id":160703100,"trial_step":100},{"step":101,"content":"萝尔莱伊？","style":2,"background":1005,"log_type":1,"src_id":160703101,"trial_step":101},{"step":102,"speaker":"萝尔莱伊","content":"……","voice":["vo_trial_60703_1_102"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703102,"trial_step":102},{"step":103,"content":"你出声唤她，却没能得到任何应答。她始终低着头，静静地站在原地什么反应也没有，垂下的头发将她的大半张脸都藏在了阴影里。","style":3,"background":1005,"log_type":1,"src_id":160703103,"trial_step":103},{"step":104,"content":"你怎么了？是身体不舒服么？来，趁他们还没注意到我们，润一润吧。","style":2,"background":1005,"log_type":1,"src_id":160703104,"trial_step":104},{"step":105,"content":"她没有回答你，沉默良久之后才慢慢地吐出了一句没头没尾的话。","style":3,"background":1005,"log_type":1,"src_id":160703105,"trial_step":105},{"step":106,"speaker":"萝尔莱伊","content":"在我还很小的时候，他们也是这样温柔耐心地对待我的……呵，我几乎都要忘记了。","voice":["vo_trial_60703_1_106"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703106,"trial_step":106},{"step":107,"content":"……什么？","style":2,"background":1005,"log_type":1,"src_id":160703107,"trial_step":107},{"step":108,"content":"你一时没能理解她的意思，却本能地感觉到一阵不安。","style":3,"background":1005,"log_type":1,"src_id":160703108,"trial_step":108},{"step":109,"speaker":"萝尔莱伊","content":"你不敢相信吧。","voice":["vo_trial_60703_1_109"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703109,"trial_step":109},{"step":110,"speaker":"萝尔莱伊","content":"太巧了，那两个人……是我的父母。","voice":["vo_trial_60703_1_110"],"voice_bank":"vo_ll_trial","style":1,"background":1005,"log_type":1,"src_id":160703110,"trial_step":110}]}