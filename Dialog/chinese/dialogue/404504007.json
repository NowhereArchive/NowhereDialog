{"id":404504007,"chapter_id":60005,"scene_id":60518,"steps":[{"step":1,"content":"事件结束，MBCC也准备返回总部。","style":3,"background":1014,"log_type":1},{"step":2,"content":"在收拾房间时，先前怎么尝试都无法打开的模拟装置突然掉在了你的面前。","style":3,"background":1014,"log_type":1},{"step":3,"content":"它的开机键上一闪一闪，像是在呼吸一般。","style":3,"background":1014,"log_type":1},{"step":4,"content":"光并不刺眼，却带着一种不合时宜的节律，仿佛在等待你的回应。","style":3,"background":1014,"log_type":1},{"step":5,"content":"你下意识地触碰了一下光源。","style":3,"background":1014,"log_type":1},{"step":6,"content":"就在这一瞬间，装置忽然自行启动。","style":3,"background":1014,"log_type":1},{"step":8,"content":"没有任何提示音，没有投影展开，也没有熟悉的模拟场景加载流程——只有一股骤然扩散开的狂厄气息。","style":3,"background":10006,"log_type":1},{"step":9,"content":"再睁开眼时——","style":3,"background":10006,"log_type":1},{"step":10,"content":"你已经站在猫眼怪盗们曾经来到的最后一个美术馆中。","style":3,"background":2190,"log_type":1}]}