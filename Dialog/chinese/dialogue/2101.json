{"id":2101,"chapter_id":2,"scene_id":210,"steps":[{"step":1,"speaker":"泰德","content":"表情太难看了，局长，还没找到你的目标吗？我也在找她，找了好久。","voice":["vo_cgplot_2101001"],"voice_bank":"vo_cgplot_02","style":1,"background":50111,"log_type":1},{"step":2,"speaker":"泰德","content":"不如你也来劝劝护理长，把人交出来，大家都好过。","voice":["vo_cgplot_2101002"],"voice_bank":"vo_cgplot_02","style":1,"background":50111,"log_type":1},{"step":3,"content":"泰德的枪口正对着安，这情景勾起令人胆寒的回忆。你还记得他如何拷问布兰德，这次，他的子弹都打在了安的身上。","style":3,"background":50111,"log_type":1},{"step":4,"speaker":"泰德","content":"就算有治愈能力，体力不够了，也撑不了多久。快点交代吧。","voice":["vo_cgplot_2101004"],"voice_bank":"vo_cgplot_02","style":1,"background":50111,"log_type":1},{"step":5,"speaker":"海拉","content":"能撑到我们干掉你就行，混蛋东西！","voice":["vo_cgplot_2101005"],"voice_bank":"vo_cgplot_02","style":1,"background":50111,"log_type":1},{"step":6,"content":"海拉抄起武器大步向前，正要开战，地面突然扎出尖锐的黑色晶刺，将泰德护在后面。","style":3,"background":117,"log_type":1},{"step":7,"content":"灰发的少女再次出现，脸色苍白却面无表情。你注意到她身上出现了某种固态的黑色残渣。","style":3,"background":117,"log_type":1},{"step":8,"speaker":"海拉","content":"你这？！蠢货！你知道自己害了多少人吗？他根本不把你当人看，为什么要帮这种人渣！","voice":["vo_cgplot_2101008"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":9,"speaker":"泰德","content":"呵呵呵……当然因为她的命是我给的，不管发生什么，都会听我命令办事。","voice":["vo_cgplot_2101009"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":10,"speaker":"泰德","content":"我去找人了，你留在这里，别让任何人来碍我的事。","voice":["vo_cgplot_2101010"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":11,"speaker":"泰德","content":"一个都不要放过！","voice":["vo_cgplot_2101011"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":12,"content":"泰德转身离开，少女接到最后的指令，沉默了一会儿，直起身。","style":3,"background":117,"log_type":1},{"step":13,"content":"地上的污染随之变化，聚集着生出一个个怪物。","style":3,"background":117,"log_type":1},{"step":14,"speaker":"赫卡蒂","content":"要追上泰德，必须先解决她。","voice":["vo_cgplot_2101014"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":15,"speaker":"选项","options":["安怎么样了"],"jump":[16],"style":6,"background":117,"log_type":1},{"step":16,"content":"安倒在地上，艰难地看向你。她的声音很微弱，你却明白了她的意思。","style":3,"background":117,"log_type":1},{"step":17,"speaker":"安","content":"阻止她，拜托你……","voice":["vo_cgplot_2101017"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1}]}