{"id":6312,"chapter_id":6,"scene_id":609,"steps":[{"step":1,"content":"她的战斗没有止境，深陷在泥淖之中。不断有污秽堵住她前进的道路。","style":3,"background":602,"log_type":1},{"step":2,"speaker":"卓娅","content":"我的战斗没有结束……永远不会结束……","voice":["vo_cgplot_6212002"],"voice_bank":"vo_cgplot_06","style":1,"background":602,"log_type":1},{"step":3,"speaker":"卓娅","content":"没有起点，没有终点，给我敌人就够了……只有我一个人也够了 ……","voice":["vo_cgplot_6212003"],"voice_bank":"vo_cgplot_06","style":1,"background":602,"log_type":1},{"step":4,"speaker":"卓娅","content":"我会一直……","voice":["vo_cgplot_6212004"],"voice_bank":"vo_cgplot_06","style":1,"background":602,"log_type":1},{"step":5,"content":"她抬起右手，握拳想继续战斗，却看到手腕处烙着的若隐若现的红印。","style":3,"background":602,"log_type":1},{"step":6,"speaker":"卓娅","content":"这是……什么痕迹？","voice":["vo_cgplot_6212006"],"voice_bank":"vo_cgplot_06","style":1,"background":602,"log_type":1},{"step":7,"speaker":"卓娅","content":"有人反抗过我……有人……还在战斗？","voice":["vo_cgplot_6212007"],"voice_bank":"vo_cgplot_06","style":1,"background":602,"log_type":1}]}