{"id":7062,"chapter_id":7,"scene_id":707,"steps":[{"step":1,"content":"你终于挤上前，抓住海拉的手。","style":3,"background":704,"log_type":1},{"step":2,"speaker":"选项","options":["海拉——！！！"],"jump":[3],"style":6,"background":704,"log_type":1},{"step":3,"speaker":"海拉","content":"<size=44>不要——！！</size>","voice":["vo_cgplot_7072003"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":4,"content":"她挥开你的手，看你的眼神中带着前所未有的惊恐，海拉尖叫着消失在人群中。","style":3,"background":704,"log_type":1},{"step":5,"content":"身后传来赫卡蒂焦急的声音。为了保护你不被队伍踩踏，梦魇努力将你拖离人群。","style":3,"background":704,"log_type":1},{"step":6,"speaker":"赫卡蒂","content":"海拉……她只是被幻觉俘获了。","voice":["vo_cgplot_7072006"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"她不是故意那么对你的。","voice":["vo_cgplot_7072007"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":8,"speaker":"选项","options":["我知道"],"jump":[9],"style":6,"background":704,"log_type":1},{"step":9,"content":"你这么告诉自己。","style":3,"background":704,"log_type":1},{"step":10,"speaker":"选项","options":["我们去追她，把她带回来"],"jump":[11],"style":6,"background":704,"log_type":1},{"step":11,"content":"还来得及。必须追上她。","style":3,"background":704,"log_type":1},{"step":12,"speaker":"赫卡蒂","content":"可是，局长……我们追得上吗？","voice":["vo_cgplot_7072012"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":14,"content":"哒哒哒哒哒——","style":3,"background":702,"log_type":1},{"step":15,"speaker":"兔子玩偶","content":"欢迎来到嘉年华！欢迎——！欢迎——！","voice":["vo_cgplot_7072014"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":16,"content":"漫天彩纸纷飞，兔子玩偶还在机械地敲击着胸前的小鼓。","style":3,"background":702,"log_type":1},{"step":17,"content":"披着破烂彩旗的老人还坐在嘉年华门口的台阶上。","style":3,"background":702,"log_type":1},{"step":18,"speaker":"赫卡蒂","content":"……我们……又回来了。","voice":["vo_cgplot_7072017"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":19,"speaker":"老人","content":"离开，乐园不属于人类，停留只会迷失……","voice":["vo_cgplot_7072018"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":20,"speaker":"老人","content":"迷失在去见她的路上，而你永远见不到她……","voice":["vo_cgplot_7072019"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":21,"content":"这就是哈梅尔的力量，这就是<color=#fb9259>无尽嘉年华</color>。别说打败环的主人，你们连靠近她都做不到。","style":3,"background":702,"log_type":1}]}