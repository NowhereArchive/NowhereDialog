{"id":1040603,"chapter_id":1040603,"scene_id":1,"steps":[{"step":1,"content":"随着你点破真相，福尔图娜的最后一层面纱被掀开，疯狂涌动的狂厄终于暴露出来，将你压在座椅上，无法挪动。","style":3,"background":2173002,"log_type":1,"src_id":140603002,"trial_step":2},{"step":2,"content":"幻影演员——那些曾真实存在于福尔图娜中的幽灵也被狂厄影响，外观扭曲变化，表演也逐渐失去逻辑。","style":3,"background":2173002,"log_type":1,"src_id":140603003,"trial_step":3},{"step":3,"speaker":"疯狂的演员","content":"投资人……只要有投资人……就有源源不断的钱……","voice":["vo_trial_40603_1_3"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603004,"trial_step":4},{"step":4,"speaker":"疯狂的演员","content":"福尔图娜的美好将一直……一直存在……","voice":["vo_trial_40603_1_4"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603005,"trial_step":5},{"step":5,"options":["这就是福尔图娜的真相？"],"style":6,"background":2173002,"log_type":1,"src_id":140603006,"trial_step":6,"course":3,"choices":[{"text":"这就是福尔图娜的真相？","goto":7}]},{"step":6,"speaker":"${PlayerName}","content":"投资了这家剧院，然后让那些沉溺欲望幻想的人彻底迷失在“剧目”中，无影无踪地消失……","style":2,"background":2173002,"log_type":1,"src_id":140603007,"trial_step":7},{"step":7,"speaker":"${PlayerName}","content":"而你作为旁观者看他们选择、挣扎，欣赏他们的挣扎沉沦的姿态……","style":2,"background":2173002,"log_type":1,"src_id":140603008,"trial_step":8},{"step":8,"speaker":"珀尔夫人","content":"这里能让他们在虚假剧目中展露真实的自己，探索生命的另一个选择，直到这些细小却鲜活的渴望迈向结局。","voice":["vo_trial_40603_1_8"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603009,"trial_step":9},{"step":9,"speaker":"珀尔夫人","content":"那份真诚、那份挣扎、那份热情——对我来说，这才是福尔图娜真正的价值！","voice":["vo_trial_40603_1_9"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603010,"trial_step":10},{"step":10,"content":"你抬头看向珀尔夫人，她的兴致丝毫没因你的怒气而削减。","style":3,"background":2173002,"log_type":1,"src_id":140603011,"trial_step":11},{"step":11,"speaker":"${PlayerName}","content":"<color=#fb9259>投资人</color>珀尔夫人……你到底在故事中扮演了什么角色？","style":2,"background":2173002,"log_type":1,"src_id":140603012,"trial_step":12},{"step":12,"speaker":"珀尔夫人","content":"一个帮助者……一个观众，一个为他们提供选择的人。","voice":["vo_trial_40603_1_12"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603013,"trial_step":13},{"step":13,"speaker":"珀尔夫人","content":"但很可惜，他们的选择并未导向一个“美好结局”。","voice":["vo_trial_40603_1_13"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603014,"trial_step":14},{"step":14,"speaker":"${PlayerName}","content":"……你明明可以把这段过去藏起来。为什么特意告诉我？","style":2,"background":2173002,"log_type":1,"src_id":140603015,"trial_step":15},{"step":15,"speaker":"珀尔夫人","content":"可能是因为……我很期待，主角登场的高光时刻。","voice":["vo_trial_40603_1_15"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603016,"trial_step":16},{"step":16,"content":"珀尔夫人的手指在你的脸颊上戳了又戳。","style":3,"background":2173002,"log_type":1,"src_id":140603017,"trial_step":17},{"step":17,"speaker":"珀尔夫人","content":"亲爱的，你看起来很生气。","voice":["vo_trial_40603_1_17"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603018,"trial_step":18},{"step":18,"speaker":"珀尔夫人","content":"明明这次如愿当了观众，却不满意剧目的走向吗？","voice":["vo_trial_40603_1_18"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603019,"trial_step":19},{"step":19,"speaker":"珀尔夫人","content":"观众到底是局外人，无权也无法改变故事，除非——","voice":["vo_trial_40603_1_19"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603020,"trial_step":20},{"step":20,"content":"你听懂了她的言外之意。","style":3,"background":2173002,"log_type":1,"src_id":140603021,"trial_step":21},{"step":21,"options":["又到我出手了","不得不出手了"],"style":6,"background":2173002,"log_type":1,"src_id":140603022,"trial_step":22,"course":3,"choices":[{"text":"又到我出手了","goto":23},{"text":"不得不出手了","goto":24}]},{"step":22,"speaker":"${PlayerName}","content":"除非我也成为演员……又到我出手了。","style":2,"background":2173002,"log_type":1,"src_id":140603023,"trial_step":23,"next":[25]},{"step":23,"speaker":"${PlayerName}","content":"除非我也成为演员……不得不出手了。","style":2,"background":2173002,"log_type":1,"src_id":140603024,"trial_step":24},{"step":24,"speaker":"${PlayerName}","content":"……","style":2,"background":2173002,"log_type":1,"src_id":140603025,"trial_step":25},{"step":25,"speaker":"${PlayerName}","content":"……哎。明明这次不想闹大的……","style":2,"background":2173002,"log_type":1,"src_id":140603026,"trial_step":26},{"step":26,"content":"珀尔夫人满意地笑了笑，将手覆在你的手背上。","style":3,"background":2173002,"log_type":1,"src_id":140603027,"trial_step":27},{"step":27,"speaker":"珀尔夫人","content":"剧中的角色都已经做出选择……","voice":["vo_trial_40603_1_27"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603028,"trial_step":28},{"step":28,"speaker":"珀尔夫人","content":"<color=#fb9259>主角</color>又怎么能一直站在场外旁观呢？","voice":["vo_trial_40603_1_28"],"voice_bank":"vo_pearl_trial","style":1,"background":2173002,"log_type":1,"src_id":140603029,"trial_step":29},{"step":29,"content":"枷锁刺破空间，进一步加剧了剧场的动荡。你选择踏上舞台。","style":3,"background":2173,"log_type":1,"src_id":140603031,"trial_step":31},{"step":30,"speaker":"${PlayerName}","content":"这次就不说中二台词，速战速决吧。","style":2,"background":2173,"log_type":1,"src_id":140603032,"trial_step":32},{"step":31,"content":"银白长剑自你们双手交握的地方抽出。你的手腕处传来熟悉的疼痛，但这次丝线再无法阻止你的行动。","style":3,"background":2173,"log_type":1,"src_id":140603033,"trial_step":33},{"step":32,"content":"演员们瞬间转头看向你——他们第一次意识到你的存在，几秒后，疯狂地扑过来。","style":3,"background":2173,"log_type":1,"src_id":140603034,"trial_step":34},{"step":33,"speaker":"疯狂的演员","content":"哈哈、哈哈！投资人——是投资人来了——！","voice":["vo_trial_40603_1_34"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603035,"trial_step":35},{"step":34,"speaker":"疯狂的演员","content":"求求您——帮帮我们——！","voice":["vo_trial_40603_1_35"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603036,"trial_step":36},{"step":35,"content":"你挥动武器，长剑斩断枷锁，划破幕布，在剧场幻境中撕出一条条裂痕。","style":3,"background":2173,"log_type":1,"src_id":140603037,"trial_step":37},{"step":36,"content":"几个身影倒下，又有无数演员前赴后继地冲来。他们的脸十分眼熟——你曾在那晚的剧场中见过几个，都是福尔图娜中选择被幻梦吃掉的人。","style":3,"background":2173,"log_type":1,"src_id":140603038,"trial_step":38},{"step":37,"content":"只是人数越来越多，你渐渐招架不过来了。珀尔仍站在原地，目视你的战斗。","style":3,"background":2173,"log_type":1,"src_id":140603039,"trial_step":39},{"step":38,"speaker":"珀尔夫人","content":"不满足现状的话，就去尽力改变它吧。","voice":["vo_trial_40603_1_39"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603040,"trial_step":40},{"step":39,"speaker":"珀尔夫人","content":"亲爱的${PlayerName}……","voice":["vo_trial_40603_1_40"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603041,"trial_step":41},{"step":40,"speaker":"珀尔夫人","content":"即使是戏，即使徒劳，那也一定足够……","voice":["vo_trial_40603_1_41"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603042,"trial_step":42},{"step":41,"content":"下一秒，你被演员们淹没，落入剧场与幻境的夹缝中。","style":3,"background":2173,"log_type":1,"src_id":140603043,"trial_step":43},{"step":42,"content":"<size=45>——第二幕·现在——</size>","style":14,"background":10000,"is_centered":true,"log_type":1,"src_id":140603045,"trial_step":45},{"step":43,"content":"阴郁男人找到一个无人的角落，四下观察后才警惕地接起电话。","style":3,"background":2171,"log_type":1,"src_id":140603046,"trial_step":46},{"step":44,"speaker":"“道具师先生”","content":"……说过多少次了，装置根本没问题，我检查过了！","voice":["vo_trial_40603_1_46"],"voice_bank":"vo_pearl_trial","style":1,"background":2171,"log_type":1,"src_id":140603047,"trial_step":47},{"step":45,"speaker":"“道具师先生”","content":"为什么只有你掉下去？难道不是因为你的技术不行吗？","voice":["vo_trial_40603_1_47"],"voice_bank":"vo_pearl_trial","style":1,"background":2171,"log_type":1,"src_id":140603048,"trial_step":48},{"step":46,"content":"电话另一端隐隐传来哭声，这让男人更加不耐烦。","style":3,"background":2171,"log_type":1,"src_id":140603049,"trial_step":49},{"step":47,"speaker":"“道具师先生”","content":"话放在这了——想要我赔钱？没门！","voice":["vo_trial_40603_1_49"],"voice_bank":"vo_pearl_trial","style":1,"background":2171,"log_type":1,"src_id":140603050,"trial_step":50},{"step":48,"content":"男人恶狠狠地掐断电话，他喘了几口气，调整状态后再次拨通另一个号码。","style":3,"background":2171,"log_type":1,"src_id":140603051,"trial_step":51},{"step":49,"speaker":"“道具师先生”","content":"……喂？<color=#fb9259>珀尔夫人</color>吗？对，有个家伙把咱们的演出装置弄坏了，还过来碰瓷要钱，如果这事儿不摆平，后面可能还有麻烦……","voice":["vo_trial_40603_1_51"],"voice_bank":"vo_pearl_trial","style":1,"background":2171,"log_type":1,"src_id":140603052,"trial_step":52},{"step":50,"speaker":"“道具师先生”","content":"或许您愿意帮个忙……","voice":["vo_trial_40603_1_52"],"voice_bank":"vo_pearl_trial","style":1,"background":2171,"log_type":1,"src_id":140603053,"trial_step":53},{"step":51,"content":"年轻女人在一堆奢华裙子中挑挑拣拣，选出一件缀满宝石的长裙，转手丢入已经堆成小山的购物框。","style":3,"background":2098,"log_type":1,"src_id":140603054,"trial_step":54},{"step":52,"content":"华服、珠宝、首饰……她将百货大楼的每一家商铺依次逛过，最后拎着战利品站在结账处。","style":3,"background":2098,"log_type":1,"src_id":140603055,"trial_step":55},{"step":53,"speaker":"“演员小姐”","content":"这些，还有这些，都包起来一起结账，记得等会儿给我送去剧院。至于账单……","voice":["vo_trial_40603_1_55"],"voice_bank":"vo_pearl_trial","style":1,"background":2098,"log_type":1,"src_id":140603056,"trial_step":56},{"step":54,"speaker":"“演员小姐”","content":"——老样子，记在<color=#fb9259>珀尔夫人</color>名下吧！","voice":["vo_trial_40603_1_56"],"voice_bank":"vo_pearl_trial","style":1,"background":2098,"log_type":1,"src_id":140603057,"trial_step":57},{"step":55,"speaker":"“演员小姐”","content":"我可是她最欣赏的剧团成员~只是这点小钱而已，她当然愿意为我买单！","voice":["vo_trial_40603_1_57"],"voice_bank":"vo_pearl_trial","style":1,"background":2098,"log_type":1,"src_id":140603058,"trial_step":58},{"step":56,"content":"表演开场，所有团员都在舞台上，只留男人在售票处清点本日的收入。","style":3,"background":2174,"log_type":1,"src_id":140603059,"trial_step":59},{"step":57,"content":"钱财清点完毕，他将钞票放入钱匣，却在记录账本时停下。","style":3,"background":2174,"log_type":1,"src_id":140603060,"trial_step":60},{"step":58,"content":"夜色沉寂，他终于提笔改掉账本上的几个数字，另一只手偷偷伸向了钱匣……","style":3,"background":2174,"log_type":1,"src_id":140603061,"trial_step":61},{"step":59,"content":"你在混沌中下坠，偶尔掉入某段回忆，成为某幕戏中的一员。","style":3,"background":10000,"log_type":1,"src_id":140603063,"trial_step":63},{"step":60,"content":"投资人的金库无穷无尽，永远都是不问缘由地打钱。欲望随着钞票一起膨胀，编织为一个无法抵抗的美梦。","style":3,"background":10000,"log_type":1,"src_id":140603064,"trial_step":64},{"step":61,"content":"——在这里，你可以为所欲为，永远有伟大的“投资人”为你兜底。","style":3,"background":10000,"log_type":1,"src_id":140603065,"trial_step":65},{"step":62,"options":["试图反抗"],"style":6,"background":10000,"log_type":1,"src_id":140603066,"trial_step":66,"course":3,"choices":[{"text":"试图反抗","goto":67}]},{"step":63,"content":"你试图挣脱，但狠狠摔入又一篇回忆。","style":3,"background":10000,"log_type":1,"src_id":140603067,"trial_step":67},{"step":64,"speaker":"“剧团长”","content":"咳、咳咳——","voice":["vo_trial_40603_1_68"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603069,"trial_step":69},{"step":65,"content":"男人醉倒在小巷里，他咒骂着刚才的牌局，却浑身无力直不起身子。","style":3,"background":2016,"log_type":1,"src_id":140603070,"trial_step":70},{"step":66,"speaker":"“剧团长”","content":"明明就差一点……那个**的骗老子梭哈，结果自己保了个本钱……就不该信他提前开牌……","voice":["vo_trial_40603_1_70"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603071,"trial_step":71},{"step":67,"content":"他想掏张钞票打车，但口袋早输得一干二净了。男人不信邪，左右撕扯身上的衣服，却差点呕在街头。","style":3,"background":2016,"log_type":1,"src_id":140603072,"trial_step":72},{"step":68,"speaker":"“剧团长”","content":"**，但没关系，只要给她打个电话，她会给钱的……呕……","voice":["vo_trial_40603_1_72"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603073,"trial_step":73},{"step":69,"speaker":"？？","content":"——给谁打电话呢？","voice":["vo_trial_40603_1_73"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603074,"trial_step":74},{"step":70,"speaker":"“剧团长”","content":"啊……啊！是您，您来了！<color=#fb9259>珀尔夫人</color>！","voice":["vo_trial_40603_1_74"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603075,"trial_step":75},{"step":71,"speaker":"“剧团长”","content":"剧团？没错，福尔图娜很好，大家都很感谢您。","voice":["vo_trial_40603_1_75"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603076,"trial_step":76},{"step":72,"speaker":"“剧团长”","content":"只是……我、我该如何向您开口呢……","voice":["vo_trial_40603_1_76"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603077,"trial_step":77},{"step":73,"content":"男人支支吾吾半晌，最终还是跪倒在对方面前，落下鳄鱼的眼泪。","style":3,"background":2016,"log_type":1,"src_id":140603078,"trial_step":78},{"step":74,"speaker":"“剧团长”","content":"求您了，再帮我最后一次吧！","voice":["vo_trial_40603_1_78"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603079,"trial_step":79},{"step":75,"speaker":"“剧团长”","content":"只要再来一次……我一定能赢！我会把所有的钱都赚回来！到时候不管是福尔图娜还是什么卡特琳娜，一定、一定都能变得更好！","voice":["vo_trial_40603_1_79"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603080,"trial_step":80},{"step":76,"content":"珀尔夫人并未立刻回应男人的胡言乱语。她俯视着地上的酒鬼，良久后开口。","style":3,"background":2016,"log_type":1,"src_id":140603081,"trial_step":81},{"step":77,"speaker":"珀尔夫人","content":"……当然，我当然能帮你。","voice":["vo_trial_40603_1_81"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603082,"trial_step":82},{"step":78,"speaker":"珀尔夫人","content":"但这次，你要仔细思考清楚。","voice":["vo_trial_40603_1_82"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603083,"trial_step":83},{"step":79,"content":"你的视角开始与男人重叠，仿佛此刻你就是他——你看到女人略俯下身，施舍般伸出自己的右手，她拿着一张剧场转让契约书。","style":3,"background":2016,"log_type":1,"src_id":140603084,"trial_step":84},{"step":80,"speaker":"珀尔夫人","content":"这一次，真的要选择我的帮忙吗？","voice":["vo_trial_40603_1_84"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603085,"trial_step":85},{"step":81,"speaker":"“剧团长”","content":"哈哈……哈哈……","voice":["vo_trial_40603_1_85"],"voice_bank":"vo_pearl_trial","style":1,"background":2016,"log_type":1,"src_id":140603086,"trial_step":86},{"step":82,"options":["接受","拒绝"],"style":6,"background":2016,"log_type":1,"src_id":140603087,"trial_step":87,"course":3,"choices":[{"text":"接受","goto":88},{"text":"拒绝","goto":89}]},{"step":83,"content":"你看到自己的手臂伸出去，急切地握住那双援手，并在契约书上签下自己的大名。","style":3,"background":2016,"log_type":1,"src_id":140603088,"trial_step":88,"next":[90]},{"step":84,"content":"可惜，手臂完全不听你的使唤，它急切地握住那双援手，并在契约书上签下自己的大名。","style":3,"background":2016,"log_type":1,"src_id":140603089,"trial_step":89},{"step":85,"content":"交易成立。“剧团长”抱着一叠钞票起身，晃晃悠悠地再次走进赌场。女人目送着他离开的背影。","style":3,"background":2016,"log_type":1,"src_id":140603090,"trial_step":90},{"step":86,"content":"这次你看得清楚：那双手上正闪着属于狂厄的红光。","style":3,"background":2016,"log_type":1,"src_id":140603091,"trial_step":91},{"step":87,"speaker":"${PlayerName}","content":"——！","style":2,"background":2173,"log_type":1,"src_id":140603092,"trial_step":92},{"step":88,"content":"猛然惊醒，你惊觉自己回到了福尔图娜剧场。你正站在舞台中心，而刚刚的一切不过是台上的闹剧。","style":3,"background":2173,"log_type":1,"src_id":140603093,"trial_step":93},{"step":89,"content":"透过层层叠叠的幻影，你看到台下唯一的观众。珀尔夫人坐在一片漆黑之中。","style":3,"background":2173,"log_type":1,"src_id":140603094,"trial_step":94},{"step":90,"options":["他们的死是你做的"],"style":6,"background":4230,"log_type":1,"src_id":140603095,"trial_step":95,"course":3,"choices":[{"text":"他们的死是你做的","goto":96}]},{"step":91,"speaker":"珀尔夫人","content":"……不，他们在结局前就选择了走向堕落。","voice":["vo_trial_40603_1_95"],"voice_bank":"vo_pearl_trial","style":1,"background":4230,"log_type":1,"src_id":140603096,"trial_step":96},{"step":92,"content":"你与珀尔夫人隔着歌舞的演员们对视，她的笑容变得虚幻，似乎在回忆某些久远的过往。","style":3,"background":4230,"log_type":1,"src_id":140603097,"trial_step":97},{"step":93,"speaker":"珀尔夫人","content":"最开始的福尔图娜多好啊……只是一顶简陋的帐篷和一些陈旧的礼服，但他们演得真诚、演得投入。","voice":["vo_trial_40603_1_97"],"voice_bank":"vo_pearl_trial","style":1,"background":4230,"log_type":1,"src_id":140603098,"trial_step":98},{"step":94,"speaker":"珀尔夫人","content":"角色或许虚假，但热情绝对真实。","voice":["vo_trial_40603_1_98"],"voice_bank":"vo_pearl_trial","style":1,"background":4230,"log_type":1,"src_id":140603099,"trial_step":99},{"step":95,"speaker":"珀尔夫人","content":"所有人都能在这里收获笑声和快乐。也没人会在意你帽檐下的金发属于哪个家族。","voice":["vo_trial_40603_1_99"],"voice_bank":"vo_pearl_trial","style":1,"background":4230,"log_type":1,"src_id":140603100,"trial_step":100},{"step":96,"content":"珀尔夫人轻轻抬起帽檐，起身走近舞台。","style":3,"background":2173,"log_type":1,"src_id":140603101,"trial_step":101},{"step":97,"speaker":"珀尔夫人","content":"没错，情绪与欲望会催生狂厄——但那又如何？","voice":["vo_trial_40603_1_101"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603102,"trial_step":102},{"step":98,"speaker":"珀尔夫人","content":"我爱那样的福尔图娜，所以愿意帮它继续经营下去。","voice":["vo_trial_40603_1_102"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603103,"trial_step":103},{"step":99,"options":["但福尔图娜变了"],"style":6,"background":2173,"log_type":1,"src_id":140603104,"trial_step":104,"course":3,"choices":[{"text":"但福尔图娜变了","goto":105}]},{"step":100,"speaker":"珀尔夫人","content":"不是福尔图娜变了，而是里面有些人变了。他们变成了我曾经交易过的那种最无聊的家伙。","voice":["vo_trial_40603_1_104"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603105,"trial_step":105},{"step":101,"speaker":"珀尔夫人","content":"演技虽好……内心却空荡荡的，毫无趣味。","voice":["vo_trial_40603_1_105"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603106,"trial_step":106},{"step":102,"speaker":"珀尔夫人","content":"没人愿意投资无意义的生意，我也是。","voice":["vo_trial_40603_1_106"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603107,"trial_step":107},{"step":103,"speaker":"珀尔夫人","content":"所以……我要让这儿变回最初的样子。","voice":["vo_trial_40603_1_107"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603108,"trial_step":108},{"step":104,"content":"珀尔夫人走进光中，你才看清她的样子——如剧场中所有“演员”一样，命运的丝线也将她连接。","style":3,"background":2173,"log_type":1,"src_id":140603109,"trial_step":109},{"step":105,"content":"“盛大的舞啊，忘记一切挣扎！\n\n“所有人都来跳这支舞啊，直到幸福愈合所有伤疤！\n\n“时间不会停留在某一刹那，\n\n“一直跳着盛大的舞啊！”","style":14,"background":2173,"is_centered":true,"log_type":1,"src_id":140603110,"trial_step":110},{"step":106,"content":"与丝线牵连最深的不是他人……正是剧场的管理人自己。","style":3,"background":2173,"log_type":1,"src_id":140603111,"trial_step":111},{"step":107,"speaker":"珀尔夫人","content":"这里是福尔图娜！为所有人呈上最精彩的戏剧，无与伦比的人生！","voice":["vo_trial_40603_1_111"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603112,"trial_step":112},{"step":108,"speaker":"珀尔夫人","content":"我们约定以一场这样的完美演出做交易……","voice":["vo_trial_40603_1_112"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603113,"trial_step":113},{"step":109,"speaker":"珀尔夫人","content":"希望你不要食言。","voice":["vo_trial_40603_1_113"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603114,"trial_step":114},{"step":110,"content":"代表命运抉择的舞者自她背后的观众席升起。它昭示着表演即将结束，所有沉溺其中的表演者都将被吞噬。","style":3,"background":2173,"log_type":1,"src_id":140603115,"trial_step":115},{"step":111,"content":"但这次的演员只有两人。","style":3,"background":2173,"log_type":1,"src_id":140603116,"trial_step":116},{"step":112,"speaker":"珀尔夫人","content":"以两小时为限，我将为你展示我的最后一部剧本。这部剧本并未完成，我希望你能陪我一起见证它，完善它，找到最完美的结局——","voice":["vo_trial_40603_1_116"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603117,"trial_step":117},{"step":113,"speaker":"珀尔夫人","content":"再让我感受一次那种热情——这就是我的条件。","voice":["vo_trial_40603_1_117"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603118,"trial_step":118},{"step":114,"speaker":"珀尔夫人","content":"来吧，这就是最后一幕戏……","voice":["vo_trial_40603_1_118"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603119,"trial_step":119},{"step":115,"speaker":"珀尔夫人","content":"该做出最后的选择了。","voice":["vo_trial_40603_1_119"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140603120,"trial_step":120}]}