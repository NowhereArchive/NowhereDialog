{"id":400701401,"chapter_id":50019,"scene_id":51909,"steps":[{"step":1,"content":"你终于冲出雾墙。指引你的灯火在雾中闪烁两下，跃入你看不见的盲区。","style":3,"background":2079,"log_type":1},{"step":2,"content":"剪刀声仍环绕在雾中，穷追不舍。","style":3,"background":2079,"log_type":1},{"step":4,"speaker":"提灯","content":"这里……这里！快……","voice":["vo_event_400701401_03"],"voice_bank":"vo_event_07014","style":1,"background":2079,"log_type":1},{"step":5,"content":"大路仍有路灯照亮，至少能够分清前进的方向。","style":3,"background":2079,"log_type":1},{"step":6,"content":"躲避时，你的余光扫过身后一盏三色拼成的异形“街灯”。","style":3,"background":2075,"log_type":1},{"step":7,"content":"然而，你在晃神的瞬间被怪物摁倒在地。寒光一晃，剪刀钉住你的衣领。","style":3,"background":2075,"log_type":1},{"step":8,"speaker":"疯剪子","content":"我的剪刀……我的剪刀……","voice":["vo_event_400701401_07"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":9,"speaker":"疯剪子","content":"是你吧……你拿走了我的剪刀……","voice":["vo_event_400701401_08"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":10,"content":"它动作扭曲，似乎陷入一种难以挣脱的痛苦中，剪子的刀刃也随动作在地面划出深深沟壑。","style":3,"background":2075,"log_type":1},{"step":11,"options":["我不记得自己干过这种事"],"jump":[12],"style":6,"background":2075,"log_type":1},{"step":12,"speaker":"%u","content":"我根本不记得你！","style":2,"background":2075,"log_type":1},{"step":13,"speaker":"疯剪子","content":"……你不记得了？","voice":["vo_event_400701401_12"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":14,"speaker":"疯剪子","content":"你不记得了？！！你怎么能不记得？！！我一点都忘不掉，为什么你可以？！啊啊啊为什么你可以！","voice":["vo_event_400701401_13"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":15,"speaker":"疯剪子","content":"剪刀果然在你手上，你偷走了我的剪刀，你让自己解脱了，可我呢？！","voice":["vo_event_400701401_14"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":16,"speaker":"疯剪子","content":"我还被纠缠，怎么都剪不断，都是你的错！","voice":["vo_event_400701401_15"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":17,"content":"满嘴胡言乱语，你也生气了。","style":3,"background":2075,"log_type":1},{"step":18,"options":["我没有什么剪刀！"],"jump":[19],"style":6,"background":2075,"log_type":1},{"step":19,"speaker":"%u","content":"看看你手里拿的是什么？！好意思找我一个两手空空的人要东西吗？","style":2,"background":2075,"log_type":1},{"step":20,"speaker":"疯剪子","content":"手里的剪刀认得你，剪刀说就是你！","voice":["vo_event_400701401_19"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":21,"content":"又几道劈砍袭来，它根本听不进去，眼里充满怨恨疯狂，对话再无意义，你只能闪身躲开，自求多福。","style":3,"background":2075,"log_type":1}]}