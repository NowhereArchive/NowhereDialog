{"id":404340702,"chapter_id":50088,"scene_id":58882,"steps":[{"step":1,"content":"鬼使神差的，你后退了。","style":3,"background":1033,"log_type":1},{"step":2,"content":"就在你迈步的刹那，深渊的裂缝在你们之间蔓延，黑暗如潮水般涌动。","style":3,"background":1033,"log_type":1},{"step":3,"content":"希露妲的身影在裂缝边缘停滞了一瞬，她的身体缓缓后仰，双眼空洞地望向你。","style":3,"background":1033,"log_type":1},{"step":4,"content":"她似乎想要说些什么，嘴唇微动，却发不出任何声音。","style":3,"background":1033,"log_type":1},{"step":5,"content":"但你似乎看到了她的手，在轻轻敲打着节拍。","style":3,"background":1033,"log_type":1},{"step":6,"content":"<color=#fb9259><size=28><i>“对不起”</color></size></i>","style":3,"background":1033,"is_centered":true,"log_type":1},{"step":7,"content":"<color=#fb9259><i>“对不起”</color></i>","style":3,"background":1033,"is_centered":true,"log_type":1},{"step":8,"content":"它们像一根细线穿透了无数咆哮与嘶吼，扎入你的心脏深处。","style":3,"background":1033,"log_type":1},{"step":9,"content":"鬼影的嚎叫骤然尖锐，像是钢针刺入耳膜，无数双手从黑暗中伸出，抓住希露妲的身体，将她彻底拖入深渊。","style":3,"background":1033,"log_type":1},{"step":10,"content":"曼菲斯特悠然地缩回了墙壁之上，仿佛它早已预见了这一切。","style":3,"background":1033,"log_type":1},{"step":11,"content":"深渊的巨口终于在你眼前缓缓闭合，带着希露妲一同沉入了黑暗。","style":3,"background":1033,"log_type":1}]}