{"id":400302002,"chapter_id":50014,"scene_id":51422,"steps":[{"step":1,"speaker":"海拉","content":"闪开闪开闪开！！海拉无双要来了别挡道！！","voice":["vo_event_03020_35"],"voice_bank":"vo_event_03_p2","style":1,"background":2031,"log_type":1},{"step":2,"content":"她一阵钢管连击铁棒乱舞，竟真的开出一条道来。","style":3,"background":2031,"log_type":1},{"step":3,"content":"旋梯已到底部，在纷飞的石膏像碎块后，索西亚的背影已经近在眼前。枷锁的反应也更为强烈，恩菲尔就在那里！","style":3,"background":2029,"log_type":1},{"step":5,"speaker":"索西亚","content":"……","voice":["vo_event_03020_39"],"voice_bank":"vo_event_03_p2","style":1,"background":2029,"log_type":1},{"step":6,"content":"雕像微微侧身，就在你以为她要抬头的瞬间，眼前突然一片亮白，短暂剥夺了你所有知觉——","style":3,"background":2029,"log_type":1},{"step":7,"options":["海拉？赫卡蒂？"],"jump":[8],"style":6,"background":10006,"log_type":1},{"step":9,"options":["恩菲尔？"],"jump":[10],"style":6,"background":10006,"log_type":1},{"step":10,"content":"知觉回来了。混战消失了，禁闭者们都已不见，这是一个空荡荡的房间，四面都是纯白的墙壁，安静得只能听到你的呼吸。","style":3,"background":4025,"log_type":1},{"step":11,"content":"墙上挂着大小各异的油画。在正中央最大的画像前，站着一个纯白色的女人。她两手交握背在身后，两手放在身前，轻盈飘起的头发纹丝不动。","style":3,"background":4025,"log_type":1},{"step":12,"content":"女人背对着你，面朝画作，安静欣赏着。","style":3,"background":4025,"log_type":1},{"step":13,"options":["……索西亚？"],"jump":[14],"style":6,"background":4025,"log_type":1},{"step":14,"content":"她没有回头，没有回答。但你知道，是她要你来的。","style":3,"background":4025,"log_type":1}]}