{"id":1050102,"chapter_id":1050102,"scene_id":1,"steps":[{"step":1,"speaker":"夜莺","content":"局长，外出许可证明已经获批，您可以带着伊琳娜……","voice":["vo_trial_50102_1_1"],"voice_bank":"vo_heli_trial","style":1,"background":1017,"log_type":1,"src_id":150102001,"trial_step":1},{"step":2,"speaker":"夜莺","content":"这是什么？","voice":["vo_trial_50102_1_2"],"voice_bank":"vo_heli_trial","style":1,"background":1017,"log_type":1,"src_id":150102002,"trial_step":2},{"step":3,"content":"夜莺将一沓文件放在你的办公桌上，便看见了那枚透明的棋子。","style":3,"background":1017,"log_type":1,"src_id":150102003,"trial_step":3},{"step":4,"options":["一枚棋子"],"style":6,"background":1017,"log_type":1,"src_id":150102004,"trial_step":4,"course":3,"choices":[{"text":"一枚棋子","goto":5}]},{"step":5,"content":"伊琳娜送过来的，应该是西洋棋。","style":2,"background":1017,"log_type":1,"src_id":150102005,"trial_step":5},{"step":6,"content":"有钱人还真是喜欢这些精致的东西。","style":2,"background":1017,"log_type":1,"src_id":150102006,"trial_step":6},{"step":7,"content":"透明晶体制作的棋子反射着刺眼的光芒，虽然有些怪异，但总体来说也还能够接受。","style":3,"background":1017,"log_type":1,"src_id":150102007,"trial_step":7},{"step":8,"content":"你拿起桌上的文件，思忖片刻，还是将那枚棋子放进了口袋里。","style":3,"background":1017,"log_type":1,"src_id":150102008,"trial_step":8},{"step":9,"speaker":"夜莺","content":"白砂之海上的航路有98%是由坎贝尔家族所掌握，虽然如今他们都在FAC的监控之下，但带着伊琳娜一同前往……局长，FAC建议您多带些人手。","voice":["vo_trial_50102_1_9"],"voice_bank":"vo_heli_trial","style":1,"background":1017,"log_type":1,"src_id":150102009,"trial_step":9},{"step":10,"content":"我会考虑的，不过，我得先去邀请伊琳娜小姐一起同行再说。","style":2,"background":1017,"log_type":1,"src_id":150102010,"trial_step":10},{"step":11,"content":"房间内，伊琳娜保持着和初见她时那样的姿态端坐着，目光聚集在桌面上的一盘棋里。","style":1,"background":1022,"log_type":1,"src_id":150102011,"trial_step":11},{"step":12,"options":["打扰了，伊琳娜小姐。"],"style":6,"background":1022,"log_type":1,"src_id":150102012,"trial_step":12,"course":3,"choices":[{"text":"打扰了，伊琳娜小姐。","goto":13}]},{"step":13,"content":"伊琳娜没有出声，你当做已经得到了她的默认，走入房内，与她一起盯着桌面上的棋局。","style":3,"background":1022,"log_type":1,"src_id":150102013,"trial_step":13},{"step":14,"speaker":"伊琳娜","content":"如果有什么事的话，局长直说就好了。","voice":["vo_trial_50102_1_14"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102014,"trial_step":14},{"step":15,"speaker":"伊琳娜","content":"百忙之中抽空来我这里，应该不是为了和我一起研究这场残局吧。","voice":["vo_trial_50102_1_15"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102015,"trial_step":15},{"step":16,"content":"据我所知，西洋棋中的残局，也是有胜利的可能的。","style":2,"background":1022,"log_type":1,"src_id":150102016,"trial_step":16},{"step":17,"content":"早就听闻伊琳娜小姐棋艺了得，如果认为现在的状况是残局的话，要不要试着去扭转它？","style":2,"background":1022,"log_type":1,"src_id":150102017,"trial_step":17},{"step":18,"content":"伊琳娜的目光终于从棋盘上收回，看向了你。","style":3,"background":1022,"log_type":1,"src_id":150102018,"trial_step":18},{"step":19,"speaker":"伊琳娜","content":"说吧，你想做什么。","voice":["vo_trial_50102_1_19"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102019,"trial_step":19},{"step":20,"options":["向伊琳娜解释原因"],"style":6,"background":1022,"log_type":1,"src_id":150102020,"trial_step":20,"course":3,"choices":[{"text":"向伊琳娜解释原因","goto":21}]},{"step":21,"content":"感谢你之前的配合，根据调查我们认为，普莱西·坎贝尔的危险性提高，除了你之外，很可能也与其他禁闭者有联系。","style":2,"background":1022,"log_type":1,"src_id":150102021,"trial_step":21},{"step":22,"content":"所以，我要去一趟费沙城，进行调查，希望你可以和我一起去。","style":2,"background":1022,"log_type":1,"src_id":150102022,"trial_step":22},{"step":23,"speaker":"伊琳娜","content":"……你在说什么？","voice":["vo_trial_50102_1_23"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102023,"trial_step":23},{"step":24,"content":"伊琳娜皱起眉头，似乎并不理解你话中的含义。","style":3,"background":1022,"log_type":1,"src_id":150102024,"trial_step":24},{"step":25,"speaker":"伊琳娜","content":"邀请普莱西·坎贝尔的女儿，伊琳娜·坎贝尔，一起回费沙城？","voice":["vo_trial_50102_1_25"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102025,"trial_step":25},{"step":26,"speaker":"伊琳娜","content":"我不知道你是过于自信，还是脑子不清醒了。","voice":["vo_trial_50102_1_26"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102026,"trial_step":26},{"step":27,"speaker":"伊琳娜","content":"你难道就不怕我和我的父亲，借由你的到来，一举攻入狄斯城？","voice":["vo_trial_50102_1_27"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102027,"trial_step":27},{"step":28,"content":"伊琳娜语气中带着一丝嘲讽，反手将棋盘上的一粒黑子，移动到对面的国王附近。","style":3,"background":1022,"log_type":1,"src_id":150102028,"trial_step":28},{"step":29,"speaker":"伊琳娜","content":"局长，这出残局你究竟是想引导向胜利……还是失败？","voice":["vo_trial_50102_1_29"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102029,"trial_step":29},{"step":30,"content":"你在伊琳娜对面的椅子坐下，拿出了外出许可证明，以及那枚透明的棋子。","style":3,"background":1022,"log_type":1,"src_id":150102030,"trial_step":30},{"step":31,"content":"这取决于你把自己置于哪条路上，伊琳娜小姐。","style":2,"background":1022,"log_type":1,"src_id":150102031,"trial_step":31},{"step":32,"content":"你现在是被我收容的禁闭者，只要我想，你就没办法违抗我的命令。但我暂时不会这么做，MBCC需要你，也会帮助你。","style":2,"background":1022,"log_type":1,"src_id":150102032,"trial_step":32},{"step":33,"speaker":"伊琳娜","content":"呵……好一个暂时。","voice":["vo_trial_50102_1_33"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102033,"trial_step":33},{"step":34,"options":["我知道，你在挣脱他。"],"style":6,"background":1022,"log_type":1,"src_id":150102034,"trial_step":34,"course":3,"choices":[{"text":"我知道，你在挣脱他。","goto":35}]},{"step":35,"content":"伊琳娜沉默良久，放在桌面上的两只手紧握着，以至于指甲盖都微微泛白。","style":3,"background":1022,"log_type":1,"src_id":150102035,"trial_step":35},{"step":36,"speaker":"伊琳娜","content":"那……来陪我下一盘棋吧，局长。","voice":["vo_trial_50102_1_36"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102036,"trial_step":36},{"step":37,"speaker":"伊琳娜","content":"在以前，每当我遇上迷茫的事情时，都会找父亲下一盘棋。","voice":["vo_trial_50102_1_37"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102037,"trial_step":37},{"step":38,"speaker":"伊琳娜","content":"运棋的过程中，能让我逐步理清思维，看清前路。","voice":["vo_trial_50102_1_38"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102038,"trial_step":38},{"step":39,"speaker":"伊琳娜","content":"希望你不要拒绝我。","voice":["vo_trial_50102_1_39"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102039,"trial_step":39},{"step":40,"options":["拒绝伊琳娜","答应伊琳娜"],"style":6,"background":1022,"log_type":1,"src_id":150102040,"trial_step":40,"course":3,"choices":[{"text":"拒绝伊琳娜","goto":41},{"text":"答应伊琳娜","goto":44}]},{"step":41,"content":"可是我对西洋棋并不拿手。","style":2,"background":1022,"log_type":1,"src_id":150102041,"trial_step":41},{"step":42,"content":"何止是不拿手，关于规则，你甚至是今天为了调查这枚棋子，才顺带看了一会儿关于棋局的规则。","style":3,"background":1022,"log_type":1,"src_id":150102042,"trial_step":42},{"step":43,"speaker":"伊琳娜","content":"没关系，棋手尊重每一位对手。","voice":["vo_trial_50102_1_43"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102043,"trial_step":43},{"step":44,"content":"你点了点头，稍稍往前一坐，开始了与伊琳娜的对局。","style":3,"background":1022,"log_type":1,"src_id":150102044,"trial_step":44},{"step":45,"content":"但你确定，你应该没有任何获胜的可能。","style":3,"background":1022,"log_type":1,"src_id":150102045,"trial_step":45},{"step":46,"speaker":"伊琳娜","content":"呵呵……","voice":["vo_trial_50102_1_46"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102046,"trial_step":46},{"step":47,"content":"你……笑什么？","style":2,"background":1022,"log_type":1,"src_id":150102047,"trial_step":47},{"step":48,"speaker":"伊琳娜","content":"局长这句话，和我第一次跟父亲下棋的时候说的话很像。","voice":["vo_trial_50102_1_48"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102048,"trial_step":48},{"step":49,"content":"伊琳娜笑着看向你，把棋盘一转，白色的棋子移动到了你的面前。","style":3,"background":1022,"log_type":1,"src_id":150102049,"trial_step":49},{"step":50,"speaker":"伊琳娜","content":"我那个时候说，父亲这么厉害，一定很快就会赢了吧。","voice":["vo_trial_50102_1_50"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102050,"trial_step":50},{"step":51,"speaker":"伊琳娜","content":"然后他将白棋移动到我这一侧，对我说……无论如何，先踏出第一步便是胜利。","voice":["vo_trial_50102_1_51"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102051,"trial_step":51},{"step":52,"content":"在伊琳娜的示意下，你拿起白棋，思考了好一会儿，才决定将白兵向前移动两格。","style":3,"background":1022,"log_type":1,"src_id":150102052,"trial_step":52},{"step":53,"options":["是这样吗？","你在占我便宜？"],"style":6,"background":1022,"log_type":1,"src_id":150102053,"trial_step":53,"course":3,"choices":[{"text":"是这样吗？","goto":54},{"text":"你在占我便宜？","goto":55}]},{"step":54,"speaker":"伊琳娜","content":"嗯，很稳重的第一步。","voice":["vo_trial_50102_1_54"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102054,"trial_step":54,"next":[56]},{"step":55,"speaker":"伊琳娜","content":"您在开玩笑了，这点便宜……奎恩占了可没好处。","voice":["vo_trial_50102_1_55"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102055,"trial_step":55},{"step":56,"speaker":"伊琳娜","content":"不过，当时的那盘棋，确实很快就下完了。","voice":["vo_trial_50102_1_56"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102056,"trial_step":56},{"step":57,"content":"伊琳娜的手指轻轻划过一颗棋子，捻起来，哒地一声落在棋盘上。","style":3,"background":1022,"log_type":1,"src_id":150102057,"trial_step":57},{"step":58,"speaker":"伊琳娜","content":"父亲根本不当我是新手，毫不留情地进攻着，甚至不管“王”的位置。","voice":["vo_trial_50102_1_58"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102058,"trial_step":58},{"step":59,"speaker":"伊琳娜","content":"他用一盘我毫无还手之力的棋局告诉我，商人，就应该要有杀伐果断的决策能力，以及……","voice":["vo_trial_50102_1_59"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102059,"trial_step":59},{"step":60,"speaker":"伊琳娜","content":"任何困境下都不低头认输的韧劲。","voice":["vo_trial_50102_1_60"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102060,"trial_step":60},{"step":61,"content":"虽然我不是商人，我会试着挣扎一下的。","style":2,"background":1022,"log_type":1,"src_id":150102061,"trial_step":61},{"step":62,"content":"看来虽然你输了这盘棋，却得到了普莱西先生的认可。","style":2,"background":1022,"log_type":1,"src_id":150102062,"trial_step":62},{"step":63,"speaker":"伊琳娜","content":"谁知道呢，只不过在我的印象中，我哭得很惨。","voice":["vo_trial_50102_1_63"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102063,"trial_step":63},{"step":64,"content":"小孩子的自尊心，比我们想象的都要强，这样的考验，确实有些狠烈了。","style":2,"background":1022,"log_type":1,"src_id":150102064,"trial_step":64},{"step":65,"speaker":"伊琳娜","content":"只是这样就觉得狠烈了吗？","voice":["vo_trial_50102_1_65"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102065,"trial_step":65},{"step":66,"content":"你面前的人拿起一枚棋子，黑色的“战车”，朝棋盘上一颗白色棋子轻轻一推——原本立着的白棋应声倒地，骨碌骨碌地滚了两圈。","style":3,"background":1022,"log_type":1,"src_id":150102066,"trial_step":66},{"step":67,"content":"伊琳娜将黑棋落在这格棋盘上，自嘲一样地笑了笑。","style":3,"background":1022,"log_type":1,"src_id":150102067,"trial_step":67},{"step":68,"speaker":"伊琳娜","content":"父亲对我的考验，远远不止这一次的“将死”。","voice":["vo_trial_50102_1_68"],"voice_bank":"vo_heli_trial","style":1,"background":1022,"log_type":1,"src_id":150102068,"trial_step":68},{"step":69,"content":"夜幕降临，白砂之海的砂砾，在月光的映衬下，显得愈发清惨。","style":3,"background":10000,"log_type":1,"src_id":150102069,"trial_step":69},{"step":70,"content":"而不远处，一座庞然大物停驻在细细的流沙附近，那是一艘砂海货船，它离流沙离得那么近，仿佛随时都会被圈进这些看上去软弱无力，实则能吞噬一切的漩涡中。","style":3,"background":1007,"log_type":1,"src_id":150102070,"trial_step":70},{"step":71,"speaker":"砂盗头子","content":"上面的货能卸就卸！我们的主要目标还是那个小丫头！","voice":["vo_trial_50102_1_71"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102071,"trial_step":71},{"step":72,"speaker":"砂盗A","content":"头儿，不就是一个小丫头，用得着这么大张旗鼓吗？没了这艘船，她还能活着走出这砂海？","voice":["vo_trial_50102_1_72"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102072,"trial_step":72},{"step":73,"speaker":"砂盗头子","content":"哼，你以为她和你身边那些脂粉叠了十层厚的人一样吗？","voice":["vo_trial_50102_1_73"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102073,"trial_step":73},{"step":74,"speaker":"砂盗头子","content":"她可是坎贝尔家的人！闭着眼睛都能从这砂海跑出去！","voice":["vo_trial_50102_1_74"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102074,"trial_step":74},{"step":75,"speaker":"砂盗头子","content":"而且……这次可是有人花大价钱，要让她……","voice":["vo_trial_50102_1_75"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102075,"trial_step":75},{"step":76,"content":"砂盗们相视一眼，爆发出令人恶心的狂笑。","style":3,"background":1007,"log_type":1,"src_id":150102076,"trial_step":76},{"step":77,"content":"黛丝","style":3,"background":10000,"log_type":1,"src_id":150102077,"trial_step":77},{"step":78,"content":"害怕砂盗？不，她害怕的，是那位“花大价钱”的人。","style":3,"background":10000,"log_type":1,"src_id":150102078,"trial_step":78},{"step":79,"speaker":"少女","content":"爸爸……","voice":["vo_trial_50102_1_79"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102079,"trial_step":79},{"step":80,"content":"砂盗渐渐逼近这个货仓，少女握住手枪，努力让自己平静下来。","style":3,"background":10000,"log_type":1,"src_id":150102080,"trial_step":80},{"step":81,"speaker":"少女","content":"白棋……E3。","voice":["vo_trial_50102_1_81"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102081,"trial_step":81},{"step":82,"speaker":"少女","content":"没有！！！谁都没等，没人会来！！！","voice":["vo_trial_50102_1_82"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102082,"trial_step":82},{"step":83,"speaker":"砂盗B","content":"头儿！下面有个货仓！","voice":["vo_trial_50102_1_83"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102083,"trial_step":83},{"step":84,"speaker":"砂盗头子","content":"那个就是个用来放绳索的，藏不下那么大个人，不过你还是看看，万一藏了什么“值钱货”呢！","voice":["vo_trial_50102_1_84"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102084,"trial_step":84},{"step":85,"speaker":"砂盗B","content":"好嘞！！","voice":["vo_trial_50102_1_85"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102085,"trial_step":85},{"step":86,"speaker":"少女","content":"……F3。","voice":["vo_trial_50102_1_86"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102086,"trial_step":86},{"step":87,"content":"砂盗掀开入口的挡板跳了下去，可不料一转身，就对上了一个黑洞洞的枪口。","style":3,"background":10000,"log_type":1,"src_id":150102087,"trial_step":87},{"step":88,"speaker":"少女","content":"吃！","voice":["vo_trial_50102_1_88"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102088,"trial_step":88},{"step":89,"content":"枪声响起，甚至没多少液体飞溅出来，那位还没来得及报告的砂盗便退出了棋盘。","style":3,"background":10000,"log_type":1,"src_id":150102089,"trial_step":89},{"step":90,"speaker":"砂盗头子","content":"那娘们儿在下面！！射击！！！","voice":["vo_trial_50102_1_90"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102090,"trial_step":90},{"step":91,"content":"少女继续蜷缩着，努力地回击着围攻过来的人。逆行的子弹带着一丝决然的意味，穿过了意图接近她的砂盗。","style":3,"background":10000,"log_type":1,"src_id":150102091,"trial_step":91},{"step":92,"speaker":"砂盗头子","content":"别*文明砂海*的只知道对着入口打！给我直接打甲板！把那些武器给我拿过来！！","voice":["vo_trial_50102_1_92"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102092,"trial_step":92},{"step":93,"content":"闪烁着诡异的红光的大型机枪被几个砂盗抬了上来。砂盗头子按下扳机的刹那间，子弹穿透过坚硬的甲板，砸在少女身边。","style":3,"background":10000,"log_type":1,"src_id":150102093,"trial_step":93},{"step":94,"speaker":"少女","content":"*费沙俚语*这什么鬼东西！！再这么下去……","voice":["vo_trial_50102_1_94"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102094,"trial_step":94},{"step":95,"content":"咔哒一声，少女的手枪戛然而止，只留几缕硝烟。","style":3,"background":10000,"log_type":1,"src_id":150102095,"trial_step":95},{"step":96,"speaker":"少女","content":"糟了！","voice":["vo_trial_50102_1_96"],"voice_bank":"vo_heli_trial","style":1,"background":10000,"log_type":1,"src_id":150102096,"trial_step":96},{"step":97,"content":"听到下面的枪声停下，砂盗头子怪笑一声，拔下了手雷的拉环。","style":3,"background":1007,"log_type":1,"src_id":150102097,"trial_step":97},{"step":98,"speaker":"砂盗头子","content":"我本想至少留着你个漂亮脸蛋，这下看来得让你尝尝我的手段……嘿嘿，哈哈哈哈哈！","voice":["vo_trial_50102_1_98"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102098,"trial_step":98},{"step":99,"content":"手雷滚进了货仓，引信燃烧的气味与汹涌袭来的恐惧抢占着少女的神经，一瞬间，她的眼前昏花一片。","style":3,"background":1007,"log_type":1,"src_id":150102099,"trial_step":99},{"step":100,"speaker":"砂盗头子","content":"能和我们对着干这么久，你还挺有能耐的，不愧是坎贝尔家的人。","voice":["vo_trial_50102_1_100"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102100,"trial_step":100},{"step":101,"speaker":"少女","content":"正因为我是坎贝尔家族的人……","voice":["vo_trial_50102_1_101"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102101,"trial_step":101},{"step":102,"speaker":"少女","content":"至少……我绝不会让属于我们荣耀的舰艇，落在你们这些人手里！","voice":["vo_trial_50102_1_102"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102102,"trial_step":102},{"step":103,"content":"这一瞬间，少女的内心已经做出了她自己的决断——她从楼梯的废墟下爬出来，开始执行着自己决策的每一步。","style":3,"background":1007,"log_type":1,"src_id":150102103,"trial_step":103},{"step":104,"content":"她尽力平静着自己的心神，颤抖着捡起了那颗手雷，握在手里。","style":3,"background":1007,"log_type":1,"src_id":150102104,"trial_step":104},{"step":105,"speaker":"少女","content":"希望你的威力能大点儿，至少把隔壁两个货仓都给炸塌。","voice":["vo_trial_50102_1_105"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102105,"trial_step":105},{"step":106,"speaker":"砂盗头子","content":"你的嘴再硬，难道还能硬得过我的*文明砂海*吗？！哈哈哈哈——！！","voice":["vo_trial_50102_1_106"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102106,"trial_step":106},{"step":107,"content":"少女完全不理会在甲板上笑作一团的砂盗，只专心听着越来越小的嘶嘶声。","style":3,"background":1007,"log_type":1,"src_id":150102107,"trial_step":107},{"step":108,"speaker":"少女","content":"给我……接好！","voice":["vo_trial_50102_1_108"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102108,"trial_step":108},{"step":109,"content":"在最后的瞬间，她将榴弹往后方扔去，并飞身跃向铁板后方的隔断。","style":3,"background":1007,"log_type":1,"src_id":150102109,"trial_step":109},{"step":110,"speaker":"砂盗们","content":"我*文明砂海*的！！","voice":["vo_trial_50102_1_110"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102110,"trial_step":110},{"step":111,"content":"轰——","style":1,"background":1007,"log_type":1,"src_id":150102111,"trial_step":111},{"step":112,"content":"被镶嵌上诡异晶体的手雷，威力是普通的好几倍——它几乎快要将整个甲板炸毁，好几个相邻的货仓也尽数坍塌。","style":3,"background":1007,"log_type":1,"src_id":150102112,"trial_step":112},{"step":113,"speaker":"砂盗头子","content":"啊——先给我把那丫头找出来！！！就算是把这条船拆了，老子也要把她给扬在这砂海里！！","voice":["vo_trial_50102_1_113"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102113,"trial_step":113},{"step":114,"content":"砂盗气红了眼睛，随手抓起一条铁杆，粗暴地扫来扫去，可是不管他们怎么找，这堆废墟里看不到任何生物存在，只有一滩混杂着污秽的液体，一点一点延伸着。","style":3,"background":1007,"log_type":1,"src_id":150102114,"trial_step":114},{"step":115,"speaker":"砂盗A","content":"头儿！！这里有个向上的密道！！！","voice":["vo_trial_50102_1_115"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102115,"trial_step":115},{"step":116,"speaker":"砂盗A","content":"好像……好像是通向驾驶室的！","voice":["vo_trial_50102_1_116"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102116,"trial_step":116},{"step":117,"speaker":"砂盗头子","content":"什么？？！！","voice":["vo_trial_50102_1_117"],"voice_bank":"vo_heli_trial","style":1,"background":1007,"log_type":1,"src_id":150102117,"trial_step":117},{"step":118,"content":"砂盗们闻言急忙跑到护栏上确认情况。果然，船艇已经启动，前半部分，几乎已经陷入流沙之中！","style":3,"background":1007,"log_type":1,"src_id":150102118,"trial_step":118},{"step":119,"speaker":"砂盗头子","content":"你*砂盗俚语*的！老子就算是要死在这条船上，也要拉你一起！！","voice":["vo_trial_50102_1_119"],"voice_bank":"vo_heli_trial","style":1,"background":2002,"log_type":1,"src_id":150102119,"trial_step":119},{"step":120,"content":"砂盗头子抢过一把枪，踢开了操作室的门。","style":3,"background":2002,"log_type":1,"src_id":150102120,"trial_step":120},{"step":121,"content":"少女颤抖着，一手操作摇杆，一手悬停在一颗红色的按钮上。从指尖上滴落的液体，聚集在按钮上，仿佛这颗按钮的红色，是被少女所染成的。","style":3,"background":2002,"log_type":1,"src_id":150102121,"trial_step":121},{"step":122,"speaker":"少女","content":"葬于流沙……或者葬于火焰……","voice":["vo_trial_50102_1_122"],"voice_bank":"vo_heli_trial","style":1,"background":2002,"log_type":1,"src_id":150102122,"trial_step":122},{"step":123,"speaker":"少女","content":"我……咳、我对你们仁慈，还……允许你们选择。","voice":["vo_trial_50102_1_123"],"voice_bank":"vo_heli_trial","style":1,"background":2002,"log_type":1,"src_id":150102123,"trial_step":123},{"step":124,"speaker":"砂盗头子","content":"我选你*砂盗俚语*！！你知不知道是谁来买你的命！是普莱西·坎贝尔！","voice":["vo_trial_50102_1_124"],"voice_bank":"vo_heli_trial","style":1,"background":2002,"log_type":1,"src_id":150102124,"trial_step":124},{"step":125,"speaker":"砂盗头子","content":"你还傻*似的守着他这艘船？！马上*海盗俚语*的给我停下！","voice":["vo_trial_50102_1_125"],"voice_bank":"vo_heli_trial","style":1,"background":2002,"log_type":1,"src_id":150102125,"trial_step":125},{"step":126,"speaker":"少女","content":"嗷呜","voice":["vo_trial_50102_1_126"],"voice_bank":"vo_heli_trial","style":1,"background":2002,"log_type":1,"src_id":150102126,"trial_step":126},{"step":127,"speaker":"少女","content":"我……伊琳娜·坎贝尔……将誓死守护坎贝尔家族的荣耀。","voice":["vo_trial_50102_1_127"],"voice_bank":"vo_heli_trial","style":1,"background":2002,"log_type":1,"src_id":150102127,"trial_step":127},{"step":128,"content":"少女轻轻按下按钮。","style":3,"background":2002,"log_type":1,"src_id":150102128,"trial_step":128},{"step":129,"content":"——最后的意识里，她看到的，除了砂盗早已扭曲的面孔，还有如坎贝尔家族的成年典礼上，父亲亲手燃放的礼炮一般，响亮而刺鼻的爆炸声。","style":3,"background":10006,"log_type":1,"src_id":150102129,"trial_step":129},{"step":130,"speaker":"少女","content":"成年快乐，伊琳娜。","voice":["vo_trial_50102_1_130"],"voice_bank":"vo_heli_trial","style":1,"background":10006,"log_type":1,"src_id":150102130,"trial_step":130}]}