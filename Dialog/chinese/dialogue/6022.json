{"id":6022,"chapter_id":6,"scene_id":602,"steps":[{"step":1,"content":"狂乱的幻影被驱散了。卓娅没有受伤，她半跪在你身后，身上肆虐的火焰此时也渐渐消退。","style":3,"background":503,"log_type":1},{"step":2,"content":"在你面前，站着一个瘦小的身影。","style":3,"background":503,"log_type":1},{"step":3,"content":"像从未得到过保护与温暖，她伤痕累累，瘦骨嶙峋，眼中映着辛迪加的所有残忍颓败，不见任何光芒。","style":3,"background":503,"log_type":1},{"step":4,"speaker":"幼年卓娅","content":"……结束了吗……","voice":["vo_cgplot_6022004"],"voice_bank":"vo_cgplot_06","style":1,"background":503,"log_type":1},{"step":5,"options":["结束了，回来吧"],"jump":[6],"style":6,"background":503,"log_type":1},{"step":6,"content":"你伸手想拥抱她，她便走向你的怀抱，然后径直穿透你。","style":3,"background":503,"log_type":1},{"step":8,"speaker":"幼年卓娅","content":"还没结束吗……还要等到……什么时候……","voice":["vo_cgplot_6022007"],"voice_bank":"vo_cgplot_06","style":1,"background":1013,"log_type":1},{"step":9,"content":"她像幽灵般穿过你的身体，低语着，蹒跚着走向前方，走进辛迪加燃烧的街区。","style":3,"background":1013,"log_type":1}]}