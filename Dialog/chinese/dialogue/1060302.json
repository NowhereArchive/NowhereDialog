{"id":1060302,"chapter_id":1060302,"scene_id":1,"steps":[{"step":1,"speaker":"卡门奈特","content":"让我想想，该从哪里讲起呢……","voice":["vo_trial_60302_1_1"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302002,"trial_step":2,"drawing":1060302},{"step":2,"speaker":"卡门奈特","content":"那么快就进入主菜，未免太无趣了。","voice":["vo_trial_60302_1_2"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302003,"trial_step":3,"drawing":1060302},{"step":3,"speaker":"卡门奈特","content":"想听听，芙兰克家族大小姐，小时候的故事吗？","voice":["vo_trial_60302_1_3"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302004,"trial_step":4,"drawing":1060302},{"step":4,"content":"　　　　　　　　　　　　　　　　<i>——　头盘　 ——</i>","style":14,"log_type":1,"src_id":160302006,"trial_step":6,"drawing":1060302},{"step":5,"options":["你的童年？"],"style":6,"log_type":1,"src_id":160302009,"trial_step":9,"course":3,"drawing":1060302,"choices":[{"text":"你的童年？","goto":10}]},{"step":6,"speaker":"卡门奈特","content":"怎么，局长在期待我曾经单纯天真的样子吗？","voice":["vo_trial_60302_1_4"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302010,"trial_step":10,"drawing":1060300},{"step":7,"speaker":"卡门奈特","content":"很可惜，不存在那样的过去。","voice":["vo_trial_60302_1_5"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302011,"trial_step":11,"drawing":1060300},{"step":8,"speaker":"卡门奈特","content":"芙兰克这个姓氏就已经注定了，那是一段含着金汤匙出生的，极尽奢华的凡俗回忆。","voice":["vo_trial_60302_1_6"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302012,"trial_step":12,"drawing":1060300},{"step":9,"content":"她很平静地阐述着，在她的脸上你看不出喜怒，甚至……捕捉不到怀念。","style":3,"log_type":1,"src_id":160302013,"trial_step":13,"drawing":1060300},{"step":10,"speaker":"卡门奈特","content":"无论是多么尖刻刁钻的要求，都会有一群人双手奉上一切，来满足我。","voice":["vo_trial_60302_1_7"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302014,"trial_step":14,"drawing":1060300},{"step":11,"speaker":"卡门奈特","content":"只为了能在芙兰克家露个脸，他们可以不惜一切代价。","voice":["vo_trial_60302_1_8"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302015,"trial_step":15,"drawing":1060300},{"step":12,"speaker":"卡门奈特","content":"独享整个游乐场，让最当红的歌星来家里表演……对我而言，这些不过是一句话的事。","voice":["vo_trial_60302_1_9"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302016,"trial_step":16,"drawing":1060300},{"step":13,"speaker":"卡门奈特","content":"服饰，珠宝，车表，来自遥远异邦的美食珍馐，甚至……年轻漂亮的男人女人。我能得到一切你想得到或想不到的满足。","voice":["vo_trial_60302_1_10"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302017,"trial_step":17,"drawing":1060300},{"step":14,"options":["但你看上去并不开心","这些还不够满足你吗？"],"style":6,"log_type":1,"src_id":160302018,"trial_step":18,"course":3,"drawing":1060300,"choices":[{"text":"但你看上去并不开心","goto":19},{"text":"这些还不够满足你吗？","goto":21}]},{"step":15,"speaker":"卡门奈特","content":"就像是呼吸，喝水，这不过是我最平凡的日常而已。","voice":["vo_trial_60302_1_11"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302019,"trial_step":19,"drawing":1060301},{"step":16,"speaker":"卡门奈特","content":"你会为MBCC日常重复的工作，感到“开心”吗？日复一日的谄媚，换来的只是最无趣的金钱交易，和麻木的厌烦。","voice":["vo_trial_60302_1_12"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302020,"trial_step":20,"drawing":1060301,"next":[23]},{"step":17,"speaker":"卡门奈特","content":"就像是呼吸，喝水，这不过是我最平凡的日常而已。","voice":["vo_trial_60302_1_13"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302021,"trial_step":21,"drawing":1060301},{"step":18,"speaker":"卡门奈特","content":"你会为MBCC日常重复的工作，感到“满足”吗？日复一日的谄媚，换来的只是最无趣的金钱交易，和麻木的厌烦。","voice":["vo_trial_60302_1_14"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302022,"trial_step":22,"drawing":1060301},{"step":19,"speaker":"局长","content":"但你的“日常”，对于大多数的人而言，是做梦都不敢想的事。","style":2,"log_type":1,"src_id":160302023,"trial_step":23,"drawing":1060301},{"step":20,"content":"你看到过辛迪加的样子，在很多不为人知的角落，多少人只是为了吃饱饭睡好觉，就倾尽了全力，甚至付出了生命。","style":3,"log_type":1,"src_id":160302024,"trial_step":24,"drawing":1060301},{"step":21,"speaker":"卡门奈特","content":"局长，是觉得不公平吗？为了那些生活堪忧的贫民感到愤懑？","voice":["vo_trial_60302_1_15"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302025,"trial_step":25,"drawing":1060301},{"step":22,"content":"她似乎有意在煽动你的情绪，挑起新的话题。","style":3,"log_type":1,"src_id":160302026,"trial_step":26,"drawing":1060301},{"step":23,"speaker":"局长","content":"……我以为我们彼此已经算是熟悉了，你知道这不是我想听的内容，更不是今天审问的重点。","style":2,"log_type":1,"src_id":160302027,"trial_step":27,"drawing":1060301},{"step":24,"speaker":"卡门奈特","content":"啊，看来这盘前菜并不合局长的胃口啊。","voice":["vo_trial_60302_1_16"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302028,"trial_step":28,"drawing":1060302},{"step":25,"speaker":"卡门奈特","content":"那下一道，我想你会喜欢的——","voice":["vo_trial_60302_1_17"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302029,"trial_step":29,"drawing":1060302},{"step":26,"speaker":"卡门奈特","content":"关于我如何一步步，踏入美食的深渊。","voice":["vo_trial_60302_1_18"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302030,"trial_step":30,"drawing":1060302},{"step":27,"content":"　　　　　　　　　　　　　　　　<i>——　汤　 ——</i>","style":14,"log_type":1,"src_id":160302032,"trial_step":32,"drawing":1060302},{"step":28,"speaker":"卡门奈特","content":"宝石有净度，服饰有价签，只要堆满了金钱和物质，就能得到最简单直白的享受，但美食没有那么简单。","voice":["vo_trial_60302_1_19"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302034,"trial_step":34,"drawing":1060302},{"step":29,"speaker":"卡门奈特","content":"即便是用涅槃运输加急送来的北地珍馐，也不一定能比巷口的面食美味。","voice":["vo_trial_60302_1_20"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302035,"trial_step":35,"drawing":1060302},{"step":30,"speaker":"卡门奈特","content":"多奇妙啊，明明只是满足口腹的物质，却依赖手艺人的创造，和最主观的体验。简直就是……","voice":["vo_trial_60302_1_21"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302036,"trial_step":36,"drawing":1060300},{"step":31,"speaker":"局长","content":"艺术品。","style":2,"log_type":1,"src_id":160302037,"trial_step":37,"drawing":1060300},{"step":32,"content":"你脱口而出。显然，卡门奈特对这个回答也很满意。","style":3,"log_type":1,"src_id":160302038,"trial_step":38,"drawing":1060300},{"step":33,"speaker":"卡门奈特","content":"该说不愧是我亲自挑中为我寻回“食材”的人吗？从晚宴开始，我们就一直很有默契呢。","voice":["vo_trial_60302_1_22"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302039,"trial_step":39,"drawing":1060301},{"step":34,"speaker":"卡门奈特","content":"是的，它不需要标签，没有标准的定义，它就像是艺术品，用心制作，用心品味。","voice":["vo_trial_60302_1_23"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302040,"trial_step":40,"drawing":1060301},{"step":35,"content":"谈起美食，卡门奈特似乎回忆起了什么有趣的事情，露出了难以捉摸的笑意。","style":3,"log_type":1,"src_id":160302041,"trial_step":41,"drawing":1060301},{"step":36,"speaker":"局长","content":"你说的真的只是食物吗？","style":2,"log_type":1,"src_id":160302042,"trial_step":42,"drawing":1060301},{"step":37,"speaker":"卡门奈特","content":"是，也不是~","voice":["vo_trial_60302_1_24"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302043,"trial_step":43,"drawing":1060301},{"step":38,"content":"她颇为享受地回味起来。寂静的审讯室里能清晰听见她吞咽口水的声音。","style":3,"log_type":1,"src_id":160302044,"trial_step":44,"drawing":1060301},{"step":39,"speaker":"卡门奈特","content":"你尝过鹅肝脂肪的香气搭配果酱的酸甜，就会期待它们在低温下组合出新的口感。","voice":["vo_trial_60302_1_25"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302045,"trial_step":45,"drawing":1060301},{"step":40,"speaker":"卡门奈特","content":"尝过被咖啡酒浸润的轻盈戚风，就会想象它们被解构成分子甜点后的新意。","voice":["vo_trial_60302_1_26"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302046,"trial_step":46,"drawing":1060301},{"step":41,"speaker":"卡门奈特","content":"而在你尝遍所有现实中的味道之后，一定会去期待——","voice":["vo_trial_60302_1_27"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302047,"trial_step":47,"drawing":1060301},{"step":42,"speaker":"卡门奈特","content":"那些超乎想象的味道……","voice":["vo_trial_60302_1_28"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302048,"trial_step":48,"drawing":1060301},{"step":43,"content":"她唇角的弧度，只让你感到一阵恶寒。","style":3,"log_type":1,"src_id":160302049,"trial_step":49,"drawing":1060301},{"step":44,"speaker":"局长","content":"超乎现实的味道，难道就是指“人”吗。","style":2,"log_type":1,"src_id":160302050,"trial_step":50,"drawing":1060301},{"step":45,"speaker":"卡门奈特","content":"我对人类实体的口感并无兴趣，请不要说得那么残酷。","voice":["vo_trial_60302_1_29"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302051,"trial_step":51,"drawing":1060301},{"step":46,"speaker":"卡门奈特","content":"我享受的，不过是他们的情绪，他们的精神，他们的情感，他们炙热而纯粹的……灵魂。","voice":["vo_trial_60302_1_30"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302052,"trial_step":52,"drawing":1060301},{"step":47,"speaker":"卡门奈特","content":"康兰和格雷格，共同扶持，无私又热忱的样子……我实在是忍不住——","voice":["vo_trial_60302_1_31"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302053,"trial_step":53,"drawing":1060301},{"step":48,"speaker":"卡门奈特","content":"哈~很难用具体的词语定义，那是超越一切料理的美味，是调动了一切感官的极致享受。","voice":["vo_trial_60302_1_32"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302054,"trial_step":54,"drawing":1060301},{"step":49,"content":"她露出迷醉的神色，努力压抑着贪婪的本性。","style":3,"log_type":1,"src_id":160302055,"trial_step":55,"drawing":1060301},{"step":50,"speaker":"卡门奈特","content":"滚烫的，复杂的……好像他们的所有爱意都在舌尖绽开，热流充盈身上的每根血管。","voice":["vo_trial_60302_1_33"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302056,"trial_step":56,"drawing":1060301},{"step":51,"speaker":"卡门奈特","content":"想要守护彼此的决心，沧海不移的爱——这样的珍宝，只能尝一次的话，也太可惜了。","voice":["vo_trial_60302_1_34"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302057,"trial_step":57,"drawing":1060301},{"step":52,"content":"卡门奈特伸出手指，轻轻点了点你手头那张单薄的证物报告。","style":3,"log_type":1,"src_id":160302058,"trial_step":58,"drawing":1060301},{"step":53,"speaker":"卡门奈特","content":"能在芙兰克家族的眼皮底下查到这些，你们已经很努力了吧。","voice":["vo_trial_60302_1_35"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302059,"trial_step":59,"drawing":1060301},{"step":54,"speaker":"卡门奈特","content":"想知道府邸的地下，在装潢前是什么吗？看在MBCC也算帮了我一个忙的份上，我不介意直接告诉你们。","voice":["vo_trial_60302_1_36"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302060,"trial_step":60,"drawing":1060301},{"step":55,"speaker":"卡门奈特","content":"那里……曾是我贮藏“食材”的笼子。","voice":["vo_trial_60302_1_37"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302061,"trial_step":61,"drawing":1060301},{"step":56,"content":"　　　　　　　　　　　　　　　　<i>——　副菜　 ——</i>","style":14,"log_type":1,"src_id":160302063,"trial_step":63,"drawing":1060301},{"step":57,"speaker":"卡门奈特","content":"局长很冷静呢，是已经猜到这个答案了吗？","voice":["vo_trial_60302_1_38"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302065,"trial_step":65,"drawing":1060300},{"step":58,"speaker":"局长","content":"八九不离十。","style":2,"log_type":1,"src_id":160302066,"trial_step":66,"drawing":1060300},{"step":59,"speaker":"局长","content":"你在当初联系MBCC协助找回“珍宝”的时候，就有意隐瞒了你的所指。无论是“食材”还是“人”，你一直都把他们当成自己的所有物。","style":2,"log_type":1,"src_id":160302067,"trial_step":67,"drawing":1060300},{"step":60,"speaker":"局长","content":"再结合手头已有的信息——康兰和格雷格相继失踪，他们曾被你限制自由的答案并不在我的预料之外。","style":2,"log_type":1,"src_id":160302068,"trial_step":68,"drawing":1060300},{"step":61,"speaker":"卡门奈特","content":"但你要的并不只是这个结果，你更想知道他们经历，找到让他们恢复正常的办法，对吗，好心的局长大人。","voice":["vo_trial_60302_1_39"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302069,"trial_step":69,"drawing":1060300},{"step":62,"speaker":"局长","content":"既然知道我要问什么，就别浪费时间了，尽快进入“主菜”吧。","style":2,"log_type":1,"src_id":160302070,"trial_step":70,"drawing":1060300},{"step":63,"speaker":"卡门奈特","content":"心急可吃不到极致的料理。而且，你想要的、能治愈这二人的“解药”，我恐怕无法给出了。","voice":["vo_trial_60302_1_40"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302071,"trial_step":71,"drawing":1060300},{"step":64,"speaker":"选择","options":["为什么？"],"style":6,"log_type":1,"src_id":160302072,"trial_step":72,"course":3,"drawing":1060300,"choices":[{"text":"为什么？","goto":74}]},{"step":65,"speaker":"卡门奈特","content":"我说了，如此绝妙的灵魂，自然不能只尝一次。","voice":["vo_trial_60302_1_41"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302074,"trial_step":74,"drawing":1060303},{"step":66,"speaker":"卡门奈特","content":"但仅仅留他们在身边，是无法为我制造源源不断的佳肴的~","voice":["vo_trial_60302_1_42"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302075,"trial_step":75,"drawing":1060303},{"step":67,"speaker":"卡门奈特","content":"得一次次激发他们彼此强烈的爱意，让他们反反复复地，在绝望的高汤中浸泡——","voice":["vo_trial_60302_1_43"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302076,"trial_step":76,"drawing":1060303},{"step":68,"speaker":"格雷格","content":"求求你，能把我留下，换她离开吗？","voice":["vo_trial_60302_1_44"],"voice_bank":"vo_cab_trial","style":1,"background":1038,"log_type":1,"src_id":160302078,"trial_step":78},{"step":69,"speaker":"卡门奈特","content":"当然~不愧是彼此深爱的伴侣，很有默契，说出了一样的话呢。","voice":["vo_trial_60302_1_45"],"voice_bank":"vo_cab_trial","style":1,"background":1038,"log_type":1,"src_id":160302079,"trial_step":79},{"step":70,"speaker":"格雷格","content":"上一次你说康兰还有价值，那这次呢，她能走了吗，让我留下！","voice":["vo_trial_60302_1_46"],"voice_bank":"vo_cab_trial","style":1,"background":3003,"log_type":1,"src_id":160302081,"trial_step":81},{"step":71,"speaker":"卡门奈特","content":"可以~","voice":["vo_trial_60302_1_47"],"voice_bank":"vo_cab_trial","style":1,"background":3003,"log_type":1,"src_id":160302082,"trial_step":82},{"step":72,"speaker":"格雷格","content":"那这次呢！你一定能答应我了对不对！放了她！","voice":["vo_trial_60302_1_48"],"voice_bank":"vo_cab_trial","style":1,"background":1038,"log_type":1,"src_id":160302084,"trial_step":84},{"step":73,"speaker":"卡门奈特","content":"好~","voice":["vo_trial_60302_1_49"],"voice_bank":"vo_cab_trial","style":1,"background":1038,"log_type":1,"src_id":160302085,"trial_step":85},{"step":74,"content":"残酷的过去在她口中竟像是一出奢华的仪式。","style":3,"log_type":1,"src_id":160302086,"trial_step":86,"drawing":1060303},{"step":75,"speaker":"局长","content":"你骗了他们。","style":2,"log_type":1,"src_id":160302087,"trial_step":87,"drawing":1060303},{"step":76,"speaker":"卡门奈特","content":"我不是一个循规蹈矩的人，你是知道的。","voice":["vo_trial_60302_1_50"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302088,"trial_step":88,"drawing":1060303},{"step":77,"speaker":"局长","content":"……","style":2,"log_type":1,"src_id":160302089,"trial_step":89,"drawing":1060303},{"step":78,"content":"的确，破坏宴会上的荒谬游戏，本就是你们相识相知的契机。","style":3,"log_type":1,"src_id":160302090,"trial_step":90,"drawing":1060303},{"step":79,"content":"芙兰克这个姓氏能有今日的地位，靠的也绝不是遵守诺言。","style":3,"log_type":1,"src_id":160302091,"trial_step":91,"drawing":1060303},{"step":80,"content":"但康兰和格雷格并没有认识到这一点。","style":3,"log_type":1,"src_id":160302092,"trial_step":92,"drawing":1060303},{"step":81,"speaker":"卡门奈特","content":"康兰，我真的很喜欢她。所以知道她被人偷走时，才会不惜动用一切的关系找回她。","voice":["vo_trial_60302_1_51"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302093,"trial_step":93,"drawing":1060300},{"step":82,"speaker":"卡门奈特","content":"她为了自己的小男友来找我对峙时的样子，太可爱了，太美味了。就像是最新鲜的，晶莹剔透的水果。","voice":["vo_trial_60302_1_52"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302094,"trial_step":94,"drawing":1060300},{"step":83,"speaker":"卡门奈特","content":"看到那样的康兰，谁能忍住，不对着她最敏感最滚烫的脖颈——","voice":["vo_trial_60302_1_53"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302095,"trial_step":95,"drawing":1060300},{"step":84,"content":"她并不说完，只是对着自己的手指，故作夸张地轻咬一口。","style":3,"log_type":1,"src_id":160302097,"trial_step":97,"drawing":1060304},{"step":85,"speaker":"卡门奈特","content":"还有格雷格，他看到康兰被我“享用”时的表情，也同样，叫人欲罢不能……","voice":["vo_trial_60302_1_54"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302098,"trial_step":98,"drawing":1060304},{"step":86,"speaker":"卡门奈特","content":"他们为了自己的爱人，甘愿被吸食、被汲取，甘愿沦为餐盘上的玩物！","voice":["vo_trial_60302_1_55"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302099,"trial_step":99,"drawing":1060304},{"step":87,"speaker":"卡门奈特","content":"一次次恳求，一次次相信，又一次次绝望。这是独属于我的，“食材”的循环啊——","voice":["vo_trial_60302_1_56"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302100,"trial_step":100,"drawing":1060304},{"step":88,"speaker":"卡门奈特","content":"多单纯，多善良，多勇敢！就像——","voice":["vo_trial_60302_1_57"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302101,"trial_step":101,"drawing":1060304},{"step":89,"content":"她热切地盯着你的脖子，瞳孔跟着你的动脉一齐跳动。","style":3,"log_type":1,"src_id":160302102,"trial_step":102,"drawing":1060304},{"step":90,"speaker":"卡门奈特","content":"——就像，想要把所有同伴救出晚宴的你一样！！！","voice":["vo_trial_60302_1_58"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302103,"trial_step":103,"drawing":1060304},{"step":91,"speaker":"夜莺","content":"局长，FAC文员传来求助，康兰和格雷格那边有异常情况。","voice":["vo_trial_60302_1_59"],"voice_bank":"vo_cab_trial","style":11,"log_type":1,"src_id":160302104,"trial_step":104,"drawing":1060304},{"step":92,"speaker":"夜莺","content":"格雷格要求见卡门奈特。","voice":["vo_trial_60302_1_60"],"voice_bank":"vo_cab_trial","style":11,"log_type":1,"src_id":160302105,"trial_step":105,"drawing":1060304},{"step":93,"speaker":"局长","content":"？！","style":2,"log_type":1,"src_id":160302106,"trial_step":106,"drawing":1060304},{"step":94,"options":["你对他们做了什么","他为什么想见你"],"style":6,"log_type":1,"src_id":160302107,"trial_step":107,"course":3,"drawing":1060304,"choices":[{"text":"你对他们做了什么","goto":108},{"text":"他为什么想见你","goto":109}]},{"step":95,"speaker":"卡门奈特","content":"嗯哼，只是在那场晚宴结束前，和我失而复得的珍宝们，寒暄了几句。","voice":["vo_trial_60302_1_61"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302108,"trial_step":108,"drawing":1060303,"next":[110]},{"step":96,"speaker":"卡门奈特","content":"或许是因为……在那场晚宴结束前，和我失而复得的珍宝们，寒暄了几句。","voice":["vo_trial_60302_1_62"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302109,"trial_step":109,"drawing":1060303},{"step":97,"speaker":"局长","content":"又给了他们虚假的承诺么？","style":2,"log_type":1,"src_id":160302110,"trial_step":110,"drawing":1060303},{"step":98,"speaker":"卡门奈特","content":"你误会了。我没有给他们什么。","voice":["vo_trial_60302_1_63"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302111,"trial_step":111,"drawing":1060303},{"step":99,"speaker":"卡门奈特","content":"这一切，都是为局长阁下准备的~","voice":["vo_trial_60302_1_64"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302112,"trial_step":112,"drawing":1060303},{"step":100,"speaker":"局长","content":"什么意思？","style":2,"log_type":1,"src_id":160302113,"trial_step":113,"drawing":1060303},{"step":101,"content":"她笑而不语，玩味地看着你。","style":3,"log_type":1,"src_id":160302114,"trial_step":114,"drawing":1060303},{"step":102,"content":"无论这层笑容背后究竟有什么阴谋，你都可以确定——枷锁并不稳定，她的狂厄值正在慢慢攀升。","style":3,"log_type":1,"src_id":160302115,"trial_step":115,"drawing":1060303},{"step":103,"speaker":"局长","content":"夜莺，让FAC先稳住他们的情况，我带卡门奈特稍后就到。","style":2,"log_type":1,"src_id":160302116,"trial_step":116,"drawing":1060303},{"step":104,"speaker":"局长","content":"务必保证康兰和格雷格的性命安全，必要时可以采取武力手段。","style":2,"log_type":1,"src_id":160302117,"trial_step":117,"drawing":1060303},{"step":105,"content":"在你部署工作安排时，卡门奈特的笑容却更加兴奋。","style":3,"log_type":1,"src_id":160302118,"trial_step":118,"drawing":1060303},{"step":106,"speaker":"卡门奈特","content":"明明和我才是故人，你却更担忧他们两个吗？","voice":["vo_trial_60302_1_65"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302119,"trial_step":119,"drawing":1060303},{"step":107,"speaker":"卡门奈特","content":"晚宴的尾声，我答应过你——除了你，<b>不再以他人灵魂为食</b>。我领过了你的奖励，自然不会食言的~","voice":["vo_trial_60302_1_66"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302120,"trial_step":120,"drawing":1060303},{"step":108,"speaker":"局长","content":"你说这话时，最好可以保证，他们不会有什么意外。","style":2,"log_type":1,"src_id":160302121,"trial_step":121,"drawing":1060303},{"step":109,"speaker":"卡门奈特","content":"嗯哼~“主菜”快上桌了，局长……","voice":["vo_trial_60302_1_67"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302122,"trial_step":122,"drawing":1060303},{"step":110,"speaker":"卡门奈特","content":"如果真的出现了意外，那就用你的<color=#fb9259><b>正义</b></color>，你的<color=#fb9259><b>愤怒</b></color>——来阻止我吧。","voice":["vo_trial_60302_1_68"],"voice_bank":"vo_cab_trial","style":1,"log_type":1,"src_id":160302123,"trial_step":123,"drawing":1060303}]}