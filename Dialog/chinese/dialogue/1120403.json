{"id":1120403,"chapter_id":1120403,"scene_id":1,"steps":[{"step":1,"content":"你载着多莉一路驶向新城，途中多莉有一句没一句地说着梦话。","style":3,"background":1018,"log_type":1,"src_id":220403001,"trial_step":1},{"step":2,"content":"大抵都是和棒球有关的，什么“看你怎么接我的本垒打”，“什么时候一起看棒球比赛之类的”。","style":3,"background":1018,"log_type":1,"src_id":220403002,"trial_step":2},{"step":3,"speaker":"多莉","content":"我们这是……在哪？不是要回管理局么？","style":1,"background":1018,"log_type":1,"src_id":220403003,"trial_step":3},{"step":4,"content":"睡得怎么样？","style":2,"background":1018,"log_type":1,"src_id":220403004,"trial_step":4},{"step":5,"content":"你拉下手刹，将车停下。","style":3,"background":1018,"log_type":1,"src_id":220403005,"trial_step":5},{"step":6,"speaker":"多莉","content":"这里是……新城棒球场附近？你带我来这里干什么？打球？","style":1,"background":1018,"log_type":1,"src_id":220403006,"trial_step":6},{"step":7,"speaker":"多莉","content":"……你明明知道我再也不能打棒球的。","style":1,"background":1018,"log_type":1,"src_id":220403007,"trial_step":7},{"step":8,"content":"当然不是打球，是加班。","style":2,"background":1018,"log_type":1,"src_id":220403008,"trial_step":8},{"step":9,"content":"你为多莉打开了车门，眼前的体育场外围满了消防员，以及来来往往的FAC队员。","style":3,"background":1016,"log_type":1,"src_id":220403009,"trial_step":9},{"step":10,"speaker":"多莉","content":"这里……是怎么了？","style":1,"background":1016,"log_type":1,"src_id":220403010,"trial_step":10},{"step":11,"content":"死役袭击了这里。","style":2,"background":1016,"log_type":1,"src_id":220403011,"trial_step":11},{"step":12,"options":["我们需要立即行动"],"style":6,"background":1016,"log_type":1,"src_id":220403012,"trial_step":12,"course":3,"choices":[{"text":"我们需要立即行动","goto":13}]},{"step":13,"speaker":"多莉","content":"抱歉，局长，我……没办法在这里……","style":1,"background":1016,"log_type":1,"src_id":220403013,"trial_step":13},{"step":14,"content":"多莉看着面前自己曾经憧憬的舞台，手中的棒球棍举起又放下。可能是她觉得自己不配在这里挥棒了吧。","style":3,"background":1016,"log_type":1,"src_id":220403014,"trial_step":14},{"step":15,"content":"当然，你拒绝也没什么问题。毕竟这里对你来说意义非凡。","style":2,"background":1016,"log_type":1,"src_id":220403015,"trial_step":15},{"step":16,"content":"轰隆——","style":3,"background":1016,"log_type":1,"src_id":220403016,"trial_step":16},{"step":17,"content":"说话间，新城体育场的地面开始剧烈震动，外墙的砖瓦开始崩塌。","style":3,"background":1016,"log_type":1,"src_id":220403017,"trial_step":17},{"step":18,"speaker":"夜莺","content":"局长，请注意，死役正在加速从地底涌出，请尽快行动。","style":11,"background":1016,"log_type":1,"src_id":220403018,"trial_step":18},{"step":19,"speaker":"夜莺","content":"否则，新城体育场将会有全面坍塌的危险。","style":11,"background":1016,"log_type":1,"src_id":220403019,"trial_step":19},{"step":20,"speaker":"多莉","content":"坍……塌？","style":1,"background":1016,"log_type":1,"src_id":220403020,"trial_step":20},{"step":21,"content":"多莉拒绝行动，请临时更换一名禁闭者。","style":2,"background":1016,"log_type":1,"src_id":220403021,"trial_step":21},{"step":22,"speaker":"多莉","content":"我要参与行动！","style":1,"background":1016,"log_type":1,"src_id":220403022,"trial_step":22},{"step":23,"speaker":"多莉","content":"就算在这里使用能力……也比整个被死役毁掉好！","style":1,"background":1016,"log_type":1,"src_id":220403023,"trial_step":23},{"step":24,"speaker":"多莉","content":"这次我可要把这些死役全都打成肉泥！都是它们害得我变成这样……","style":1,"background":1016,"log_type":1,"src_id":220403024,"trial_step":24},{"step":25,"speaker":"夜莺","content":"那么，任务继续。","style":11,"background":1016,"log_type":1,"src_id":220403025,"trial_step":25},{"step":26,"speaker":"夜莺","content":"任务目标为：尽可能地疏散观众。","style":11,"background":1016,"log_type":1,"src_id":220403026,"trial_step":26},{"step":27,"content":"你向周围的FAC出示了身份证件，与多莉一同进入了新城体育场的内部。","style":3,"background":1016,"log_type":1,"src_id":220403027,"trial_step":27},{"step":28,"content":"死役从地底源源不断地钻出，但好在它们的行动速度并不算快。","style":3,"background":1035,"log_type":1,"src_id":220403028,"trial_step":28},{"step":29,"options":["先救人！"],"style":6,"background":1035,"log_type":1,"src_id":220403029,"trial_step":29,"course":3,"choices":[{"text":"先救人！","goto":30}]},{"step":30,"speaker":"多莉","content":"已经……在了！","style":1,"background":1035,"log_type":1,"src_id":220403030,"trial_step":30},{"step":31,"content":"多莉将棒球棍背在背后，只用拳头将来袭的死役打飞。","style":3,"background":1035,"log_type":1,"src_id":220403031,"trial_step":31},{"step":32,"speaker":"多莉","content":"你安全了……快走。","style":1,"background":1035,"log_type":1,"src_id":220403032,"trial_step":32},{"step":33,"speaker":"观众","content":"可是我的票钱……","style":1,"background":1035,"log_type":1,"src_id":220403033,"trial_step":33},{"step":34,"speaker":"多莉","content":"票什么票，快给我滚！","style":1,"background":1035,"log_type":1,"src_id":220403034,"trial_step":34},{"step":35,"speaker":"多莉","content":"再不走我就把你一起打死。","style":1,"background":1035,"log_type":1,"src_id":220403035,"trial_step":35},{"step":36,"speaker":"观众","content":"我我……我走还不行么！","style":1,"background":1035,"log_type":1,"src_id":220403036,"trial_step":36},{"step":37,"content":"看着慌忙逃离的观众，你只能暗暗叹气，还好多莉还是在认真救人。","style":3,"background":1035,"log_type":1,"src_id":220403037,"trial_step":37},{"step":38,"content":"希望她的情绪不会在救人时爆发，这样麻烦就大了。","style":3,"background":1035,"log_type":1,"src_id":220403038,"trial_step":38},{"step":39,"options":["这次我可以相信你的“情绪”吗？"],"style":6,"background":1035,"log_type":1,"src_id":220403039,"trial_step":39,"course":3,"choices":[{"text":"这次我可以相信你的“情绪”吗？","goto":40}]},{"step":40,"speaker":"多莉","content":"哼……当然可以。","style":1,"background":1035,"log_type":1,"src_id":220403040,"trial_step":40},{"step":41,"content":"你们从东侧一路前往至西侧，一路上救起了许多没来得及逃离的观众。","style":3,"background":1035,"log_type":1,"src_id":220403041,"trial_step":41},{"step":42,"content":"有些人对多莉表示了感谢，有些人则还是被多莉吓走。","style":3,"background":1035,"log_type":1,"src_id":220403042,"trial_step":42},{"step":43,"speaker":"夜莺","content":"正在扫描现场……","style":11,"background":1035,"log_type":1,"src_id":220403043,"trial_step":43},{"step":44,"speaker":"夜莺","content":"还余下一个生命体征，在你们东侧四十三米，观众席座位下。","style":11,"background":1035,"log_type":1,"src_id":220403044,"trial_step":44},{"step":45,"speaker":"夜莺","content":"救出这个人之后，你们就去集中处理体育场中心生成死役的地底洞穴。现在震度4.1，推测在地底还有其他死役，要快速行动！","style":11,"background":1035,"log_type":1,"src_id":220403045,"trial_step":45},{"step":46,"content":"还没等夜莺的话说完，多莉便用自己身上的球棍一棍将面前的座椅全部掀开。","style":3,"background":1035,"log_type":1,"src_id":220403046,"trial_step":46},{"step":47,"content":"果然有一个中年男人在底下瑟瑟发抖。","style":3,"background":1035,"log_type":1,"src_id":220403047,"trial_step":47},{"step":48,"speaker":"多莉","content":"快走。","style":1,"background":1035,"log_type":1,"src_id":220403048,"trial_step":48},{"step":49,"speaker":"中年观众","content":"你你……你们是谁？","style":1,"background":1035,"log_type":1,"src_id":220403049,"trial_step":49},{"step":50,"speaker":"多莉","content":"来救你的，别不识好歹。","style":1,"background":1035,"log_type":1,"src_id":220403050,"trial_step":50},{"step":51,"speaker":"中年观众","content":"救我的……那你们还真是好运。你们出去提我的名字，会在新城棒球俱乐部获得优待的！","style":1,"background":1035,"log_type":1,"src_id":220403051,"trial_step":51},{"step":52,"speaker":"多莉","content":"少废话快走，我还要打那些死役呢。","style":1,"background":1035,"log_type":1,"src_id":220403052,"trial_step":52},{"step":53,"speaker":"中年观众","content":"等等……你的脸……你好像是……","style":1,"background":1035,"log_type":1,"src_id":220403053,"trial_step":53},{"step":54,"content":"中年男人的神情飞速变换。","style":3,"background":1035,"log_type":1,"src_id":220403054,"trial_step":54},{"step":55,"speaker":"中年观众","content":"你是前两年搞砸比赛的那个！那个棒球魔女！","style":1,"background":1035,"log_type":1,"src_id":220403055,"trial_step":55},{"step":56,"speaker":"中年观众","content":"你知不知道！你知不知道！我在那场比赛里下了多少注！","style":1,"background":1035,"log_type":1,"src_id":220403056,"trial_step":56},{"step":57,"speaker":"中年观众","content":"呸。晦气，真是晦气。","style":1,"background":1035,"log_type":1,"src_id":220403057,"trial_step":57},{"step":58,"speaker":"中年观众","content":"怎么会被你这个辛迪加人恶心。啊——啊！！","style":1,"background":1035,"log_type":1,"src_id":220403058,"trial_step":58},{"step":59,"content":"多莉直接对着男人挥出一拳。男人被一拳从玻璃护栏上打落至地面。","style":3,"background":1035,"log_type":1,"src_id":220403059,"trial_step":59},{"step":60,"speaker":"中年观众","content":"你……你怎么敢打我！我可是新城棒球俱乐部的人！","style":1,"background":1035,"log_type":1,"src_id":220403060,"trial_step":60},{"step":61,"speaker":"多莉","content":"我能当没见过这个人么？","style":1,"background":1035,"log_type":1,"src_id":220403061,"trial_step":61},{"step":62,"options":["可以","不可以"],"style":6,"background":1035,"log_type":1,"src_id":220403062,"trial_step":62,"course":3,"choices":[{"text":"可以","goto":63},{"text":"不可以","goto":64}]},{"step":63,"content":"可以，但是烂人也有活下去的权利。","style":2,"background":1035,"log_type":1,"src_id":220403063,"trial_step":63,"next":[65]},{"step":64,"content":"不可以，但我允许你再踢他一脚。","style":2,"background":1035,"log_type":1,"src_id":220403064,"trial_step":64,"next":[65]},{"step":65,"speaker":"中年观众","content":"你……你是她的领导吧？快救救我！救我！","style":1,"background":1035,"log_type":1,"src_id":220403065,"trial_step":65},{"step":66,"content":"你则看向多莉，等待着她的选择。","style":3,"background":1035,"log_type":1,"src_id":220403066,"trial_step":66},{"step":67,"content":"多莉一把抓住男人的衣领，将他举了起来。","style":3,"background":1035,"log_type":1,"src_id":220403067,"trial_step":67},{"step":68,"speaker":"中年观众","content":"啊……我劝你……我劝你好好想想！","style":1,"background":1035,"log_type":1,"src_id":220403068,"trial_step":68},{"step":69,"content":"多莉用力一掷，将男人扔到安全出口。","style":3,"background":1035,"log_type":1,"src_id":220403069,"trial_step":69},{"step":70,"speaker":"多莉","content":"你给我记住！救你的是辛迪加人！","style":1,"background":1035,"log_type":1,"src_id":220403070,"trial_step":70},{"step":71,"speaker":"多莉","content":"而且，马上要站到赛场上的，也是辛迪加人！懂了么！","style":1,"background":1035,"log_type":1,"src_id":220403071,"trial_step":71},{"step":72,"content":"多莉头也不回地走向体育场的中央。","style":3,"background":1035,"log_type":1,"src_id":220403072,"trial_step":72},{"step":73,"content":"地面震动的幅度更加剧烈，似乎有什么东西，要破土而出。","style":3,"background":1035,"log_type":1,"src_id":220403073,"trial_step":73},{"step":74,"speaker":"夜莺","content":"局长！有紧急状况！","style":1,"background":1035,"log_type":1,"src_id":220403074,"trial_step":74},{"step":75,"speaker":"夜莺","content":"有巨型怪物即将出现在新城体育场，任务终止，请立刻撤退！","style":1,"background":1035,"log_type":1,"src_id":220403075,"trial_step":75},{"step":76,"content":"夜莺在通讯器中的声音万分焦急。","style":3,"background":1035,"log_type":1,"src_id":220403076,"trial_step":76},{"step":77,"content":"多莉则像是没听见命令般，径直走向体育场的中央。","style":3,"background":1035,"log_type":1,"src_id":220403077,"trial_step":77},{"step":78,"speaker":"夜莺","content":"禁闭者多莉，停止前进，停止前进！","style":1,"background":1035,"log_type":1,"src_id":220403078,"trial_step":78},{"step":79,"content":"多莉直接摘下耳麦，丢到地上，做好了准备击球的姿势。","style":3,"background":1035,"log_type":1,"src_id":220403079,"trial_step":79},{"step":80,"content":"地面一阵颤动，诡异的怪物从地底钻出后，径直冲向了它面前的对手。","style":3,"background":10000,"log_type":1,"src_id":220403080,"trial_step":80},{"step":81,"speaker":"怪物","content":"吼——","style":1,"background":1036,"log_type":1,"src_id":220403081,"trial_step":81},{"step":82,"speaker":"怪物","content":"恩赐……恩赐！","style":1,"background":1036,"log_type":1,"src_id":220403082,"trial_step":82},{"step":83,"speaker":"多莉","content":"唉……真是讽刺。","style":1,"background":1036,"log_type":1,"src_id":220403083,"trial_step":83},{"step":84,"speaker":"多莉","content":"明明站上了梦寐以求的舞台。","style":1,"background":1036,"log_type":1,"src_id":220403084,"trial_step":84},{"step":85,"speaker":"多莉","content":"却还要做这种苦差事。","style":1,"background":1036,"log_type":1,"src_id":220403085,"trial_step":85},{"step":86,"options":["一点也不讽刺"],"style":6,"background":1036,"log_type":1,"src_id":220403086,"trial_step":86,"course":3,"choices":[{"text":"一点也不讽刺","goto":87}]},{"step":87,"content":"战场就是你的球场，而此刻的球场就是你的战场。","style":2,"background":1036,"log_type":1,"src_id":220403087,"trial_step":87},{"step":88,"content":"只不过，这次你面对的不是观众，而是怪物。","style":2,"background":1036,"log_type":1,"src_id":220403088,"trial_step":88},{"step":89,"speaker":"多莉","content":"哈……你不用这么安慰我的，我都明白。","style":1,"background":1036,"log_type":1,"src_id":220403089,"trial_step":89},{"step":90,"options":["我只是在说事实。"],"style":6,"background":1036,"log_type":1,"src_id":220403090,"trial_step":90,"course":3},{"step":91,"content":"就算你没办法继续打棒球，但有我在，你可以在战场上完成这个梦想。","style":2,"background":1036,"log_type":1,"src_id":220403091,"trial_step":91},{"step":92,"content":"这些怪物们，就是你最强大，也是最好的对手。","style":2,"background":1036,"log_type":1,"src_id":220403092,"trial_step":92},{"step":93,"content":"而我，则是你最好的教练。","style":2,"background":1036,"log_type":1,"src_id":220403093,"trial_step":93},{"step":94,"speaker":"多莉","content":"唉……你的话还是这么多。听着真让人烦。","style":1,"background":1036,"log_type":1,"src_id":220403094,"trial_step":94},{"step":95,"speaker":"多莉","content":"要是我能有个话少点的教练就好了。","style":1,"background":1036,"log_type":1,"src_id":220403095,"trial_step":95},{"step":96,"speaker":"多莉","content":"哈哈……可惜，我没得选。","style":1,"background":1036,"log_type":1,"src_id":220403096,"trial_step":96},{"step":97,"content":"多莉的手伸向背后，抽出了棒球棍。","style":3,"background":1036,"log_type":1,"src_id":220403097,"trial_step":97},{"step":98,"speaker":"多莉","content":"开赛吧，教练。","style":1,"background":1036,"log_type":1,"src_id":220403098,"trial_step":98},{"step":99,"content":"多莉挥出球棒，能力于一瞬间发动。","style":3,"background":1036,"log_type":1,"src_id":220403099,"trial_step":99},{"step":100,"options":["击球！"],"style":6,"background":1036,"log_type":1,"src_id":220403100,"trial_step":100,"course":3,"choices":[{"text":"击球！","goto":101}]},{"step":101,"content":"她高高跃起，抡满了胳膊，用尽全身力气，将球棒砸向这怪物。","style":3,"background":1036,"log_type":1,"src_id":220403101,"trial_step":101},{"step":102,"content":"像是一只追逐着萤火的飞蛾，越靠近所期望的光，则越靠近毁灭。","style":3,"background":1036,"log_type":1,"src_id":220403102,"trial_step":102},{"step":103,"content":"但若飞蛾是毁灭本身呢？","style":3,"background":1036,"log_type":1,"src_id":220403103,"trial_step":103},{"step":104,"content":"好像没人经历过这种情况。","style":3,"background":1036,"log_type":1,"src_id":220403104,"trial_step":104},{"step":105,"content":"怪物发出刺耳的尖哮，如同失去形状般，沉入地面。","style":3,"background":1036,"log_type":1,"src_id":220403105,"trial_step":105},{"step":106,"speaker":"多莉","content":"任务完成！你这次做得还不错嘛，算是为数不多让我能感到开心的任务了。","style":1,"background":1036,"log_type":1,"src_id":220403106,"trial_step":106},{"step":107,"content":"打怪物打得开心？","style":2,"background":1036,"log_type":1,"src_id":220403107,"trial_step":107},{"step":108,"speaker":"多莉","content":"哼，当然比不上教育那个新城胖子开心了。","style":1,"background":1036,"log_type":1,"src_id":220403108,"trial_step":108},{"step":109,"content":"属于她的光，终究还是来临了。","style":3,"background":1036,"log_type":1,"src_id":220403109,"trial_step":109},{"step":110,"speaker":"多莉","content":"所以说，我为什么还要被关在这里？","style":1,"background":1025,"log_type":1,"src_id":220403110,"trial_step":110},{"step":111,"content":"当然是因为你抗命。","style":2,"background":1025,"log_type":1,"src_id":220403111,"trial_step":111},{"step":112,"speaker":"多莉","content":"啊……怎么这样？","style":1,"background":1025,"log_type":1,"src_id":220403112,"trial_step":112},{"step":113,"options":["别抱怨了"],"style":6,"background":1025,"log_type":1,"src_id":220403113,"trial_step":113,"course":3,"choices":[{"text":"别抱怨了","goto":114}]},{"step":114,"content":"我也在和你一起。","style":2,"background":1025,"log_type":1,"src_id":220403114,"trial_step":114},{"step":115,"speaker":"多莉","content":"那你怎么在外面！","style":1,"background":1025,"log_type":1,"src_id":220403115,"trial_step":115},{"step":116,"options":["这是教练特权。"],"style":6,"background":1025,"log_type":1,"src_id":220403116,"trial_step":116,"course":3,"choices":[{"text":"这是教练特权。","goto":117}]},{"step":117,"content":"闲着也是闲着，不如和我说说你那个给三年后自己的信吧。","style":2,"background":1025,"log_type":1,"src_id":220403117,"trial_step":117},{"step":118,"speaker":"多莉","content":"哎呀……不知道不知道，真烦人。","style":1,"background":1025,"log_type":1,"src_id":220403118,"trial_step":118},{"step":119,"content":"致三年后的我：","style":14,"background":10000,"log_type":1,"src_id":220403119,"trial_step":119},{"step":120,"content":"当你再一次看到这封信时\n相信已经站在新城的棒球联盟领奖台上\n准备接受“最佳击球手”这一奖项了吧？","style":14,"background":10000,"log_type":1,"src_id":220403120,"trial_step":120},{"step":121,"content":"哈哈……我当然是开玩笑的\n我也不是没有想过，如果到新城之后\n突然谁都打不过了怎么办？","style":14,"background":10000,"log_type":1,"src_id":220403121,"trial_step":121},{"step":122,"content":"到那时我一定会比现在努力十倍吧\n因为，这就是我的梦想。","style":14,"background":10000,"log_type":1,"src_id":220403122,"trial_step":122},{"step":123,"content":"就算籍籍无名，那我也心甘情愿。","style":14,"background":10000,"log_type":1,"src_id":220403123,"trial_step":123},{"step":124,"content":"毕竟，我已经证明了自己\n我站在了这赛场上，我用尽全力完成了比赛。","style":14,"background":10000,"log_type":1,"src_id":220403124,"trial_step":124},{"step":125,"content":"好了，就写到这里吧。","style":14,"background":10000,"log_type":1,"src_id":220403125,"trial_step":125},{"step":126,"content":"要去新城的话，可得早一点出发\n新城那么大，要是迷路了就不好了。","style":14,"background":10000,"log_type":1,"src_id":220403126,"trial_step":126}]}