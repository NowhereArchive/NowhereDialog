{"id":7072,"chapter_id":7,"scene_id":708,"steps":[{"step":1,"content":"玩偶们被打倒了，也依旧拖着黑色的火焰，向哈梅尔的幻影爬去。","style":3,"background":704,"log_type":1},{"step":2,"speaker":"玩偶们","content":"哈梅尔……哈梅尔……","voice":["vo_cgplot_7082002"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":3,"speaker":"玩偶们","content":"呃啊啊啊——哈梅尔——救救我——！","voice":["vo_cgplot_7082003"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":4,"speaker":"哈梅尔的幻影","content":"我会的，我会的～只要你们爱我，你们会永远爱我的，对吗？","voice":["vo_cgplot_7082004"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":5,"content":"哈梅尔抬起手，黑色火焰从她的掌心蔓延。周围的玩偶们被她魔化，并且不断地被她吞噬！","style":3,"background":704,"log_type":1},{"step":6,"speaker":"哈梅尔的幻影","content":"你呢？","voice":["vo_cgplot_7082006"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":7,"content":"哈梅尔侧过头看向你，脸上依旧带着天真而残忍的笑容。","style":3,"background":704,"log_type":1},{"step":8,"speaker":"哈梅尔的幻影","content":"多好的表演呀，你喜欢吗？","voice":["vo_cgplot_7082008"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":9,"speaker":"选项","options":["你到底是谁？！"],"jump":[10],"style":6,"background":704,"log_type":1},{"step":10,"content":"她发出天真又疯狂的笑声。","style":3,"background":704,"log_type":1},{"step":11,"speaker":"哈梅尔的幻影","content":"哈哈哈……我当然是哈梅尔，是你们最喜欢的<size=44>哈梅尔</size>～！","voice":["vo_cgplot_7082011"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":12,"content":"她手中的黑色火焰开始暴涨，以更快的速度向周围蔓延，吞噬游行，吞噬乐园，向你扑来！","style":3,"background":704,"log_type":1},{"step":13,"speaker":"？？？","content":"住手吧。","voice":["vo_cgplot_7082013"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":15,"content":"就在此时，你们的前面出现了一个高大的傀儡，驱散了黑色火焰。","style":3,"background":704,"log_type":1},{"step":16,"speaker":"哈梅尔的幻影","content":"啊？是你？","voice":["vo_cgplot_7082015"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1}]}