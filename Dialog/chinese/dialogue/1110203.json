{"id":1110203,"chapter_id":1110203,"scene_id":1,"steps":[{"step":1,"content":"距离演讲现场的袭击案件，已经过去两个月了。","style":3,"background":10000,"log_type":1,"src_id":210203001,"trial_step":1},{"step":2,"content":"这两个月里发生了很多事：袭击者被关押，辛迪加街区的人收到了补偿，几家开发商破产……事件有了一个还算“圆满”的结局。","style":3,"background":10000,"log_type":1,"src_id":210203002,"trial_step":2},{"step":3,"content":"除了——","style":3,"background":10000,"log_type":1,"src_id":210203003,"trial_step":3},{"step":4,"speaker":"辰砂","content":"还是没有针对雷根的调查令吗？","style":1,"background":1017,"log_type":1,"src_id":210203004,"trial_step":4},{"step":5,"content":"雷根的后台远比我们想象的复杂，这次能绕过他给辛迪加赔偿，已经很不容易了。","style":2,"background":1017,"log_type":1,"src_id":210203005,"trial_step":5},{"step":6,"content":"你理解辰砂的心情，毕竟只要雷根没有失去权力，蛇眼就随时有可能受到报复。","style":3,"background":1017,"log_type":1,"src_id":210203006,"trial_step":6},{"step":7,"options":["安慰辰砂"],"style":6,"background":1017,"log_type":1,"src_id":210203007,"trial_step":7,"course":3,"choices":[{"text":"安慰辰砂","goto":8}]},{"step":8,"content":"我再给蛇眼打个电话吧。","style":2,"background":1017,"log_type":1,"src_id":210203008,"trial_step":8},{"step":9,"content":"你已经数次给蛇眼打去电话。不出意外的是，这次电话那头仍然是忙音。","style":3,"background":1017,"log_type":1,"src_id":210203009,"trial_step":9},{"step":10,"content":"你们和蛇眼失去了联系。","style":3,"background":1017,"log_type":1,"src_id":210203010,"trial_step":10},{"step":11,"content":"看着你有些懊恼的表情，辰砂反倒安慰起你来。","style":3,"background":1017,"log_type":1,"src_id":210203011,"trial_step":11},{"step":12,"speaker":"辰砂","content":"没关系的，我相信他们会没事的。","style":1,"background":1017,"log_type":1,"src_id":210203012,"trial_step":12},{"step":13,"content":"三天后","style":3,"background":10000,"log_type":1,"src_id":210203013,"trial_step":13},{"step":14,"content":"阿廖沙？！","style":2,"background":1017,"log_type":1,"src_id":210203014,"trial_step":14},{"step":15,"content":"夜莺有些莫名其妙地看着你，无法理解你为什么对这位“阿廖沙”打来的电话如此上心。","style":3,"background":1017,"log_type":1,"src_id":210203015,"trial_step":15},{"step":16,"content":"你从夜莺手中接过电话。","style":3,"background":1017,"log_type":1,"src_id":210203016,"trial_step":16},{"step":17,"content":"阿廖沙队长？之前给你打电话一直打不通。你那边最近怎么样？","style":2,"background":1017,"log_type":1,"src_id":210203017,"trial_step":17},{"step":18,"speaker":"阿廖沙","content":"蛇眼原来的号码已经不用了。","style":11,"background":1017,"log_type":1,"src_id":210203018,"trial_step":18},{"step":19,"speaker":"阿廖沙","content":"你让辰砂接电话。","style":11,"background":1017,"log_type":1,"src_id":210203019,"trial_step":19},{"step":20,"content":"阿廖沙还是老样子完全没给你面子，但现在不是跟他计较的时候。","style":3,"background":1017,"log_type":1,"src_id":210203020,"trial_step":20},{"step":21,"options":["通知辰砂接电话"],"style":6,"background":1017,"log_type":1,"src_id":210203021,"trial_step":21,"course":3,"choices":[{"text":"通知辰砂接电话","goto":22}]},{"step":22,"content":"听到是蛇眼的电话，辰砂火急火燎赶到了你的办公室。","style":3,"background":1017,"log_type":1,"src_id":210203022,"trial_step":22},{"step":23,"content":"辰砂从你手中接过电话，顿了顿，按下了免提键。","style":3,"background":1017,"log_type":1,"src_id":210203023,"trial_step":23},{"step":24,"speaker":"辰砂","content":"你还好吗阿廖沙？雷根有为难你们吗？","style":1,"background":1017,"log_type":1,"src_id":210203024,"trial_step":24},{"step":25,"speaker":"阿廖沙","content":"蛇眼现在已经不做议会的业务了。","style":11,"background":1017,"log_type":1,"src_id":210203025,"trial_step":25},{"step":26,"speaker":"辰砂","content":"是因为上次的事？对不起……","style":1,"background":1017,"log_type":1,"src_id":210203026,"trial_step":26},{"step":27,"speaker":"阿廖沙","content":"不要瞎猜。","style":11,"background":1017,"log_type":1,"src_id":210203027,"trial_step":27},{"step":28,"speaker":"嘈杂声","content":"队长，跟谁打电话呢？不会是辰砂吧？","style":11,"background":1017,"log_type":1,"src_id":210203028,"trial_step":28},{"step":29,"content":"电话那头传来嘈杂的声音。","style":3,"background":1017,"log_type":1,"src_id":210203029,"trial_step":29},{"step":30,"speaker":"阿廖沙","content":"……有什么想问的，就来老地方找我。刚好……我现在有空。","style":11,"background":1017,"log_type":1,"src_id":210203030,"trial_step":30},{"step":31,"content":"阿廖沙毫不客气地挂掉了电话。","style":3,"background":1017,"log_type":1,"src_id":210203031,"trial_step":31},{"step":32,"content":"辰砂握着听筒的手过了好久才放下。","style":3,"background":1017,"log_type":1,"src_id":210203032,"trial_step":32},{"step":33,"content":"我跟你一起去吧。","style":2,"background":1017,"log_type":1,"src_id":210203033,"trial_step":33},{"step":34,"speaker":"辰砂","content":"呃……","style":1,"background":1017,"log_type":1,"src_id":210203034,"trial_step":34},{"step":35,"content":"辰砂有些犹豫。","style":3,"background":1017,"log_type":1,"src_id":210203035,"trial_step":35},{"step":36,"content":"不想让我去吗？","style":2,"background":1017,"log_type":1,"src_id":210203037,"trial_step":37},{"step":37,"speaker":"辰砂","content":"我不是那个意思。","style":1,"background":1017,"log_type":1,"src_id":210203038,"trial_step":38},{"step":38,"content":"你有些调侃地反问辰砂，没想到辰砂却当真了。","style":3,"background":1017,"log_type":1,"src_id":210203039,"trial_step":39,"next":[43]},{"step":39,"content":"该不会是不喜欢我跟着你吧？","style":2,"background":1017,"log_type":1,"src_id":210203040,"trial_step":40},{"step":40,"speaker":"辰砂","content":"怎么可能！","style":1,"background":1017,"log_type":1,"src_id":210203041,"trial_step":41},{"step":41,"content":"面对你的明显的调侃，辰砂居然急了。","style":3,"background":1017,"log_type":1,"src_id":210203042,"trial_step":42},{"step":42,"content":"为了证明没把你当外人，辰砂强烈邀请了你去和她的“家人”会面。","style":3,"background":1017,"log_type":1,"src_id":210203043,"trial_step":43},{"step":43,"content":"你欣然同意，和她一起前往阿廖沙口中的老地方——新城和辛迪加边界的一处旧仓库。","style":3,"background":1008,"log_type":1,"src_id":210203044,"trial_step":44},{"step":44,"speaker":"辰砂","content":"蛇眼就是在这里成立的。三十年前，爸爸……我的父亲，还有阿廖沙他们租下了这里作为宿舍和训练场所。","style":1,"background":1008,"log_type":1,"src_id":210203045,"trial_step":45},{"step":45,"speaker":"辰砂","content":"这里是蛇眼的起点。","style":1,"background":1008,"log_type":1,"src_id":210203046,"trial_step":46},{"step":46,"content":"屋子里传出热闹的话语声。","style":3,"background":1008,"log_type":1,"src_id":210203047,"trial_step":47},{"step":47,"speaker":"辰砂","content":"我们进去吧。","style":1,"background":1008,"log_type":1,"src_id":210203048,"trial_step":48},{"step":48,"options":["推开门"],"style":6,"background":1042,"log_type":1,"src_id":210203049,"trial_step":49,"course":3,"choices":[{"text":"推开门","goto":50}]},{"step":49,"content":"一推开门，香甜的气味和热闹的人声扑面而来。","style":3,"background":1042,"log_type":1,"src_id":210203050,"trial_step":50},{"step":50,"content":"仓库被布置成了一个俱乐部，暖黄色的灯光下，周围的一切都显得很是温馨。","style":3,"background":1042,"log_type":1,"src_id":210203051,"trial_step":51},{"step":51,"speaker":"蛇眼成员1","content":"哟，辰砂，你还带人来啦。","style":1,"background":1042,"log_type":1,"src_id":210203052,"trial_step":52},{"step":52,"content":"老家伙们正围着长桌聊天，见你们来了，热情拉你和辰砂在桌边坐下。","style":3,"background":1042,"log_type":1,"src_id":210203053,"trial_step":53},{"step":53,"speaker":"辰砂","content":"这是我现在的雇主，MBCC的局长，上次任务和大家见过面的。","style":1,"background":1042,"log_type":1,"src_id":210203054,"trial_step":54},{"step":54,"content":"？？","style":3,"background":1042,"log_type":1,"src_id":210203055,"trial_step":55},{"step":55,"content":"他的身前摆着两个空瓶，第三瓶也已下去一半。","style":3,"background":1042,"log_type":1,"src_id":210203056,"trial_step":56},{"step":56,"speaker":"蛇眼成员2","content":"还喝呢，小心明天又头疼到起不来床。","style":1,"background":1042,"log_type":1,"src_id":210203057,"trial_step":57},{"step":57,"content":"面对身旁战友的挖苦，阿廖沙重重把杯子磕在桌上，嘴里吐出一个字——","style":3,"background":1042,"log_type":1,"src_id":210203058,"trial_step":58},{"step":58,"speaker":"阿廖沙","content":"滚。","style":1,"background":1042,"log_type":1,"src_id":210203059,"trial_step":59},{"step":59,"options":["向阿廖沙打招呼","不要打扰阿廖沙"],"style":6,"background":1042,"log_type":1,"src_id":210203060,"trial_step":60,"course":3,"choices":[{"text":"向阿廖沙打招呼","goto":61},{"text":"不要打扰阿廖沙","goto":63}]},{"step":60,"content":"你走到阿廖沙跟前向他打招呼。可他就当你不存在似的，完全没有搭理你。","style":3,"background":1042,"log_type":1,"src_id":210203061,"trial_step":61},{"step":61,"content":"你悻悻而归。","style":3,"background":1042,"log_type":1,"src_id":210203062,"trial_step":62,"next":[64]},{"step":62,"content":"回忆起阿廖沙过去的行事风格，你还是对跟他直接谈话有些心有余悸，于是你转头看向身边热情的蛇眼成员。","style":3,"background":1042,"log_type":1,"src_id":210203063,"trial_step":63},{"step":63,"content":"你们队长怎么了？","style":2,"background":1042,"log_type":1,"src_id":210203064,"trial_step":64},{"step":64,"speaker":"蛇眼成员1","content":"你别见怪，我们老大脾气就是这样的，知道你们要来，他比谁都高兴，结果你们一进门，又这幅鸟样。","style":1,"background":1042,"log_type":1,"src_id":210203065,"trial_step":65},{"step":65,"content":"大家乐呵呵地笑成一团，不断询问辰砂这些年的状况。看得出来，对你的热情是顺带的，他们真的很喜欢辰砂。","style":3,"background":1042,"log_type":1,"src_id":210203066,"trial_step":66},{"step":66,"speaker":"蛇眼成员2","content":"辰砂，说说你这两年的事吧。","style":1,"background":1042,"log_type":1,"src_id":210203067,"trial_step":67},{"step":67,"speaker":"蛇眼成员2","content":"阿廖沙托人去查过，但是一个字也不肯跟多说。","style":1,"background":1042,"log_type":1,"src_id":210203068,"trial_step":68},{"step":68,"speaker":"辰砂","content":"被议会通缉之后后，我一直在辛迪加生活。","style":1,"background":1042,"log_type":1,"src_id":210203069,"trial_step":69},{"step":69,"content":"辰砂在辛迪加好几次帮助平民们躲避黑帮袭击，救了不少人。","style":2,"background":1042,"log_type":1,"src_id":210203070,"trial_step":70},{"step":70,"speaker":"蛇眼成员1","content":"辰砂这孩子真是到哪儿都有出息，从小就是这样一点都没变。","style":1,"background":1042,"log_type":1,"src_id":210203071,"trial_step":71},{"step":71,"content":"哦？小时候就这样吗？","style":2,"background":1042,"log_type":1,"src_id":210203072,"trial_step":72},{"step":72,"speaker":"蛇眼成员1","content":"那还用说。","style":1,"background":1042,"log_type":1,"src_id":210203073,"trial_step":73},{"step":73,"content":"老兵一脸得意的样子。","style":3,"background":1042,"log_type":1,"src_id":210203074,"trial_step":74},{"step":74,"options":["询问辰砂小时候的事"],"style":6,"background":1042,"log_type":1,"src_id":210203075,"trial_step":75,"course":3,"choices":[{"text":"询问辰砂小时候的事","goto":76}]},{"step":75,"speaker":"辰砂","content":"我小时候……也没什么特别的。父亲去世得很早，是蛇眼的各位前辈抚养我长大的。","style":1,"background":1042,"log_type":1,"src_id":210203076,"trial_step":76},{"step":76,"speaker":"蛇眼成员2","content":"辰砂她老爹是我们的战友，以前都是给议会卖命的。84年退役被雇佣返聘，头两年都是在破碎防线接些别人不敢干的活……","style":1,"background":1042,"log_type":1,"src_id":210203077,"trial_step":77},{"step":77,"speaker":"蛇眼成员2","content":"老东西当初动不动就说以后要一起荣华富贵，结果自己先死在内海了……","style":1,"background":1042,"log_type":1,"src_id":210203078,"trial_step":78},{"step":78,"content":"回忆起过去的事，蛇眼老大哥们眼眶开始泛红。","style":3,"background":1042,"log_type":1,"src_id":210203079,"trial_step":79},{"step":79,"speaker":"辰砂","content":"我父亲不在了，但有我替他来蛇眼接班啊。","style":1,"background":1042,"log_type":1,"src_id":210203080,"trial_step":80},{"step":80,"speaker":"蛇眼成员2","content":"我还没说你呢，你说你，新城警校第一名毕业，不去谋个公职……再不济去FAC当个正规军也行啊，干嘛跟我们这些糟老头混在一起。","style":1,"background":1042,"log_type":1,"src_id":210203081,"trial_step":81},{"step":81,"speaker":"蛇眼成员1","content":"呵，要是辰砂没来，我们怕是全死在内海了，哪儿捞得着保护议会的差事。","style":1,"background":1042,"log_type":1,"src_id":210203082,"trial_step":82},{"step":82,"speaker":"蛇眼成员2","content":"可就算是保护议会，照样是要命的活儿，指不定哪天人就没了。辰砂要是出什么闪失，我们怎么跟她老爹交代。","style":1,"background":1042,"log_type":1,"src_id":210203083,"trial_step":83},{"step":83,"content":"见叔叔们又开始为自己操心，辰砂主动安慰道。","style":3,"background":1042,"log_type":1,"src_id":210203084,"trial_step":84},{"step":84,"speaker":"辰砂","content":"我的一切都是蛇眼给的，蛇眼是我的家……回到这里是应该的……","style":1,"background":1042,"log_type":1,"src_id":210203085,"trial_step":85},{"step":85,"speaker":"阿廖沙","content":"够了！","style":1,"background":1042,"log_type":1,"src_id":210203086,"trial_step":86},{"step":86,"content":"一直沉默的阿廖沙突然猛地站起身，朝门外走去。","style":3,"background":1042,"log_type":1,"src_id":210203087,"trial_step":87},{"step":87,"content":"在场的人面面相觑，辰砂更是尴尬不已，不知道哪一句话刺痛了阿廖沙。","style":3,"background":1042,"log_type":1,"src_id":210203088,"trial_step":88},{"step":88,"options":["拦住阿廖沙"],"style":6,"background":1042,"log_type":1,"src_id":210203089,"trial_step":89,"course":3,"choices":[{"text":"拦住阿廖沙","goto":90}]},{"step":89,"content":"不是说好了要和辰砂聊聊吗？辰砂说了这么多，你就没有想和她说的吗？","style":2,"background":1042,"log_type":1,"src_id":210203090,"trial_step":90},{"step":90,"content":"阿廖沙站住脚步，转身直视着辰砂，带着浓烈的愤怒指责道——","style":3,"background":1042,"log_type":1,"src_id":210203091,"trial_step":91},{"step":91,"speaker":"阿廖沙","content":"蛇眼是你的家？！那你现在在哪里？","style":1,"background":1042,"log_type":1,"src_id":210203092,"trial_step":92},{"step":92,"speaker":"阿廖沙","content":"宁可待在那种监狱似的鬼地方，像个犯人一样被使唤，也不愿意回家？！","style":1,"background":1042,"log_type":1,"src_id":210203093,"trial_step":93},{"step":93,"content":"虽然阿廖沙冲着辰砂怒吼，但你清楚他的矛头在指向谁。","style":3,"background":1042,"log_type":1,"src_id":210203094,"trial_step":94},{"step":94,"speaker":"阿廖沙","content":"我看你早就忘了……","style":1,"background":1042,"log_type":1,"src_id":210203095,"trial_step":95},{"step":95,"speaker":"辰砂","content":"我从来都没有忘记。","style":1,"background":1042,"log_type":1,"src_id":210203096,"trial_step":96},{"step":96,"content":"辰砂站起来，注视着阿廖沙的眼睛认真反驳。","style":3,"background":1042,"log_type":1,"src_id":210203097,"trial_step":97},{"step":97,"speaker":"辰砂","content":"如果不是蛇眼供我读书，教会我做人的道理，我不会成长为今天这样。","style":1,"background":1042,"log_type":1,"src_id":210203098,"trial_step":98},{"step":98,"speaker":"辰砂","content":"如果刚进入蛇眼的时候，何塞、老唐……还有你没有保护我，我会死。","style":1,"background":1042,"log_type":1,"src_id":210203099,"trial_step":99},{"step":99,"speaker":"辰砂","content":"正是因为蛇眼一直在保护着我，我才会希望像你们一样，去保护我目所能及的每一个人……","style":1,"background":1042,"log_type":1,"src_id":210203100,"trial_step":100},{"step":100,"content":"说到这里，辰砂的声音低了下去。","style":3,"background":1042,"log_type":1,"src_id":210203101,"trial_step":101},{"step":101,"speaker":"辰砂","content":"我那些不切实际的幻想，保护他人的执念，或许都是出自对你们的憧憬。","style":1,"background":1042,"log_type":1,"src_id":210203102,"trial_step":102},{"step":102,"content":"阿廖沙愣住了，不知该如何作答。过了好一会儿，他才有些不服气地继续说道——","style":3,"background":1042,"log_type":1,"src_id":210203103,"trial_step":103},{"step":103,"speaker":"阿廖沙","content":"那你现在想守护的是谁，难道是这个关住你的家伙吗？","style":1,"background":1042,"log_type":1,"src_id":210203104,"trial_step":104},{"step":104,"speaker":"阿廖沙","content":"连你参加私人聚会都不忘记来监视你？不让你离开，一辈子都要活在那个鬼地方？","style":1,"background":1042,"log_type":1,"src_id":210203105,"trial_step":105},{"step":105,"speaker":"辰砂","content":"你误会了。我是禁闭者，你也知道，禁闭者的身份是我当初被议会通缉最主要的原因。现在离开MBCC只会引来不必要的麻烦。","style":1,"background":1042,"log_type":1,"src_id":210203107,"trial_step":107},{"step":106,"speaker":"辰砂","content":"况且局长并不是你想象的那样。他是个可靠的雇主，是我值得托付性命的重要友人，是我邀请他来的。","style":1,"background":1042,"log_type":1,"src_id":210203108,"trial_step":108},{"step":107,"speaker":"辰砂","content":"留在MBCC并非是局长强迫，是我自己的选择。","style":1,"background":1042,"log_type":1,"src_id":210203109,"trial_step":109},{"step":108,"content":"阿廖沙张开嘴却半天说不出话来。他或许早已接受了现实，只是还不愿意服输罢了。","style":3,"background":1042,"log_type":1,"src_id":210203110,"trial_step":110},{"step":109,"content":"不知如何反驳的阿廖沙最终失魂落魄地走回角落，扑通一声坐下。","style":3,"background":1042,"log_type":1,"src_id":210203111,"trial_step":111,"next":[120]},{"step":110,"speaker":"辰砂","content":"是的。","style":1,"background":1042,"log_type":1,"src_id":210203112,"trial_step":112},{"step":111,"content":"阿廖沙瞪大了眼睛。","style":3,"background":1042,"log_type":1,"src_id":210203113,"trial_step":113},{"step":112,"speaker":"辰砂","content":"局长她，对我来说是非常重要的人。","style":1,"background":1042,"log_type":1,"src_id":210203114,"trial_step":114},{"step":113,"speaker":"辰砂","content":"留在MBCC是我自己的选择。","style":1,"background":1042,"log_type":1,"src_id":210203115,"trial_step":115},{"step":114,"speaker":"阿廖沙","content":"可她……你……","style":1,"background":1042,"log_type":1,"src_id":210203116,"trial_step":116},{"step":115,"content":"阿廖沙语无伦次地咕哝了半天。","style":3,"background":1042,"log_type":1,"src_id":210203117,"trial_step":117},{"step":116,"speaker":"阿廖沙","content":"……","style":1,"background":1042,"log_type":1,"src_id":210203118,"trial_step":118},{"step":117,"content":"不知道该说些什么的阿廖沙最后还是失魂落魄地走回角落，扑通一声坐下。","style":3,"background":1042,"log_type":1,"src_id":210203119,"trial_step":119},{"step":118,"speaker":"蛇眼成员2","content":"孩子大了总不能指望她一直待在你身边吧。老东西，该放手咯。","style":1,"background":1042,"log_type":1,"src_id":210203120,"trial_step":120},{"step":119,"content":"蛇眼成员说笑着，气氛又恢复了融洽。","style":3,"background":1042,"log_type":1,"src_id":210203121,"trial_step":121},{"step":120,"speaker":"蛇眼成员2","content":"庆祝辰砂回家，今天阿廖沙请客！","style":1,"background":1042,"log_type":1,"src_id":210203122,"trial_step":122},{"step":121,"content":"阿廖沙此刻已经光速醉倒在吧台上打起了鼾，自然无法拒绝。","style":3,"background":1042,"log_type":1,"src_id":210203123,"trial_step":123},{"step":122,"content":"大家闹哄哄地开始聚过来。你感觉到好几道不怀好意的目光聚集过来。","style":3,"background":1042,"log_type":1,"src_id":210203124,"trial_step":124},{"step":123,"speaker":"蛇眼成员1","content":"作为我们辰砂的朋友，你得多喝几杯！","style":1,"background":1042,"log_type":1,"src_id":210203126,"trial_step":126,"next":[128]},{"step":124,"speaker":"蛇眼成员1","content":"作为我们辰砂的好·朋·友，你可得多喝几杯！","style":1,"background":1042,"log_type":1,"src_id":210203127,"trial_step":127},{"step":125,"content":"其他蛇眼成员纷纷附和。","style":3,"background":1042,"log_type":1,"src_id":210203128,"trial_step":128},{"step":126,"content":"箭在弦上——你的处境相当“危险”。","style":3,"background":1042,"log_type":1,"src_id":210203129,"trial_step":129},{"step":127,"options":["喝","不喝"],"style":6,"background":1042,"log_type":1,"src_id":210203130,"trial_step":130,"course":3,"choices":[{"text":"喝","goto":131},{"text":"不喝","goto":132}]},{"step":128,"content":"你刚一抬手，辰砂却很自然地挡在了你的身前。","style":3,"background":1042,"log_type":1,"src_id":210203131,"trial_step":131,"next":[133]},{"step":129,"content":"你正准备婉拒，辰砂却很自然地挡在了你的身前。","style":3,"background":1042,"log_type":1,"src_id":210203132,"trial_step":132},{"step":130,"speaker":"辰砂","content":"还有人要来吗？","style":1,"background":1042,"log_type":1,"src_id":210203133,"trial_step":133},{"step":131,"content":"辰砂脸上挂着有些奇怪的笑意，这是你第一次在她脸上看到这样的表情。","style":3,"background":1042,"log_type":1,"src_id":210203134,"trial_step":134},{"step":132,"content":"奇怪的是，看到这幅举动的辰砂，蛇眼的老家伙们开始面面相觑，眼神中纷纷透露出一股莫名的怯意。","style":3,"background":1042,"log_type":1,"src_id":210203135,"trial_step":135},{"step":133,"speaker":"蛇眼成员1","content":"不是吧……","style":1,"background":1042,"log_type":1,"src_id":210203136,"trial_step":136},{"step":134,"speaker":"辰砂","content":"正常喝酒当然没关系，但你们打算正常喝吗？各位叔叔，我可太了解你们了。","style":1,"background":1042,"log_type":1,"src_id":210203137,"trial_step":137},{"step":135,"speaker":"蛇眼成员1","content":"瞧你说的……嘿嘿……","style":1,"background":1042,"log_type":1,"src_id":210203138,"trial_step":138},{"step":136,"speaker":"蛇眼成员2","content":"怕什么，说不定这两年她退步了呢。","style":1,"background":1042,"log_type":1,"src_id":210203139,"trial_step":139},{"step":137,"speaker":"辰砂","content":"试试？","style":1,"background":1042,"log_type":1,"src_id":210203140,"trial_step":140},{"step":138,"content":"令人大跌眼镜的是，没过多久，几个起哄最厉害的就已经倒下了。辰砂回到你身边——她面色平静，甚至脸都没有变红。","style":3,"background":1042,"log_type":1,"src_id":210203141,"trial_step":141},{"step":139,"content":"你……你也太厉害了吧？","style":2,"background":1042,"log_type":1,"src_id":210203142,"trial_step":142},{"step":140,"speaker":"辰砂","content":"替雇主解决不必要的社交麻烦，也是保镖的必修课。","style":1,"background":1042,"log_type":1,"src_id":210203143,"trial_step":143},{"step":141,"content":"辰砂瞥了一眼吧台上的时钟。","style":3,"background":1042,"log_type":1,"src_id":210203144,"trial_step":144},{"step":142,"speaker":"辰砂","content":"我记得您还有工作要做吧。","style":1,"background":1042,"log_type":1,"src_id":210203145,"trial_step":145},{"step":143,"content":"你不想多在这儿待一会儿？","style":2,"background":1042,"log_type":1,"src_id":210203146,"trial_step":146},{"step":144,"content":"辰砂回头看了看老家伙们，眼神温暖又留恋。","style":3,"background":1042,"log_type":1,"src_id":210203147,"trial_step":147},{"step":145,"speaker":"辰砂","content":"总有机会再见的……","style":1,"background":1042,"log_type":1,"src_id":210203148,"trial_step":148},{"step":146,"content":"哐——","style":3,"background":1042,"log_type":1,"src_id":210203149,"trial_step":149},{"step":147,"content":"一声闷响打断了你们的对话，不知何时，阿廖沙醒了过来。他重重摔在地上。辰砂想去扶他，却被一巴掌扇开了手。","style":3,"background":1042,"log_type":1,"src_id":210203150,"trial_step":150},{"step":148,"speaker":"阿廖沙","content":"我还没老到那份儿上。","style":1,"background":1042,"log_type":1,"src_id":210203151,"trial_step":151},{"step":149,"content":"阿廖沙摇摇晃晃地走到你边上。辰砂正打算阻止。没想到他只是看看你，又看看辰砂，摇摇头，长叹一口气。","style":3,"background":1042,"log_type":1,"src_id":210203152,"trial_step":152},{"step":150,"content":"然后重重地拍了拍你的肩膀，两下。","style":3,"background":1042,"log_type":1,"src_id":210203153,"trial_step":153},{"step":151,"content":"你明白这副举动的意思——他接纳你了。","style":3,"background":1042,"log_type":1,"src_id":210203155,"trial_step":155,"next":[159]},{"step":152,"speaker":"蛇眼成员","content":"哇哦——","style":1,"background":1042,"log_type":1,"src_id":210203156,"trial_step":156},{"step":153,"content":"蛇眼成员们笑出了声。阿廖沙的意思很明确——他接纳你了。","style":3,"background":1042,"log_type":1,"src_id":210203157,"trial_step":157}]}