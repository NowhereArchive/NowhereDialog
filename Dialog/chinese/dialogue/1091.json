{"id":1091,"chapter_id":1,"scene_id":112,"steps":[{"step":1,"speaker":"彼岸医师","content":"布兰德医师！！你还活着！","voice":["vo_cgplot_1091001"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":2,"speaker":"泰德","content":"啧。","voice":["vo_cgplot_1091002"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":3,"content":"泰德举枪再次瞄准这个从自己手中幸存的男人。","style":3,"background":122,"log_type":1},{"step":4,"content":"住手，泰德！|……","options":["住手，泰德！","……"],"jump":[5,5],"style":6,"background":122,"log_type":1},{"step":5,"content":"他的枪太快了。子弹射了过去，却在离布兰德半米不到时，被一阵黑色气流弹开。","style":3,"background":122,"log_type":1},{"step":6,"speaker":"赫卡蒂","content":"是狂厄带来的异变，他的力量……很强，跟其他人不是一个等级。","voice":["vo_cgplot_1091006"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":7,"content":"他是禁闭者？不，不是。可他跟那些黑帮狂厄者又完全不同。身边的黑气仿佛受他指挥，更重要的是——","style":3,"background":122,"log_type":1},{"step":8,"content":"有什么在驱使他行动。","style":3,"background":122,"log_type":1},{"step":9,"speaker":"布兰德","content":"…………格雷……韩…………还有……","voice":["vo_cgplot_1091009"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":10,"speaker":"布兰德","content":"……罗拉，别哭了……罗拉……没有人能伤害你了……","voice":["vo_cgplot_1091010"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":11,"speaker":"彼岸医师","content":"这不是真的……布兰德，难道你也……","voice":["vo_cgplot_1091011"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":12,"speaker":"泰德","content":"——！！\n拦住他！别让他靠近！","voice":["vo_cgplot_1091012"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":13,"speaker":"泰德帮众","content":"哈！哈哈！拦住他，拦住他！！我来！让我来！！！","voice":["vo_cgplot_1091013"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":14,"speaker":"海拉","content":"你们疯了！？别去，他——","voice":["vo_cgplot_1091014"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":15,"speaker":"布兰德","content":"…………啊……\n啊啊啊啊啊——！！！","voice":["vo_cgplot_1091015"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":16,"content":"那是一瞬间的事。就像尖锐的咆哮一般，黑色的尖刺呈放射状在布兰德的身上生长，随后立刻扭曲形变。","style":3,"background":50105,"log_type":1},{"step":17,"content":"下一秒，他整个外形都变了，仿佛被失控的愤怒重塑了一般，变成了——真正的怪物。","style":3,"background":50105,"log_type":1},{"step":18,"speaker":"泰德帮众","content":"啊啊啊——————！！","voice":["vo_cgplot_1091018"],"voice_bank":"vo_cgplot_01","style":1,"background":50105,"log_type":1},{"step":19,"speaker":"彼岸医师","content":"布兰德医师——！！","voice":["vo_cgplot_1091019"],"voice_bank":"vo_cgplot_01","style":1,"background":50105,"log_type":1},{"step":20,"speaker":"海拉","content":"这……这是什么东西？这真是……刚刚那个人吗？","voice":["vo_cgplot_1091020"],"voice_bank":"vo_cgplot_01","style":1,"background":50105,"log_type":1},{"step":21,"speaker":"赫卡蒂","content":"已经不是了，这是死役，更强的死役。","voice":["vo_cgplot_1091021"],"voice_bank":"vo_cgplot_01","style":1,"background":50105,"log_type":1},{"step":22,"speaker":"赫卡蒂","content":"海拉，保护局长。","voice":["vo_cgplot_1091022"],"voice_bank":"vo_cgplot_01","style":1,"background":50105,"log_type":1},{"step":23,"speaker":"“布兰德”","content":"伤害你们的……都是……敌人……吼！！！","voice":["vo_cgplot_1091023"],"voice_bank":"vo_cgplot_01","style":1,"background":50105,"log_type":1}]}