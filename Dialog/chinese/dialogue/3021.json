{"id":3021,"chapter_id":3,"scene_id":302,"steps":[{"step":1,"speaker":"司机","content":"关门，要走了！","voice":["vo_cgplot_3012038"],"voice_bank":"vo_cgplot_03","style":1,"background":101,"log_type":1},{"step":2,"speaker":"军团成员","content":"哎哎闹成这样不是我的错哈，总之……先追起来！Go——！","voice":["vo_cgplot_3021002"],"voice_bank":"vo_cgplot_03","style":1,"background":101,"log_type":1},{"step":3,"content":"所有车辆几乎同时踩动油门，飞驰出去。巷子里更钻出十几辆军团机车追在你们后头。","style":3,"background":101,"log_type":1},{"step":4,"speaker":"海拉","content":"啊哈哈，我们真有排面，能让军团出动这么多人迎接——靠，他们掏武器了！","voice":["vo_cgplot_3021004"],"voice_bank":"vo_cgplot_03","style":1,"background":101,"log_type":1},{"step":5,"speaker":"赫卡蒂","content":"后面交给我。","voice":["vo_cgplot_3021005"],"voice_bank":"vo_cgplot_03","style":1,"background":101,"log_type":1},{"step":6,"content":"说着，赫卡蒂推开车门，竟直接迎风攀上梦魇，侧身跳到皮卡后的车厢。","style":3,"background":101,"log_type":1},{"step":7,"speaker":"海拉","content":"要干他们吗？那我也来——","voice":["vo_cgplot_3021007"],"voice_bank":"vo_cgplot_03","style":1,"background":101,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"不用，你手短，打不到。","voice":["vo_cgplot_3021008"],"voice_bank":"vo_cgplot_03","style":1,"background":101,"log_type":1},{"step":9,"speaker":"海拉","content":"我**——","voice":["vo_cgplot_3021009"],"voice_bank":"vo_cgplot_03","style":1,"background":101,"log_type":1},{"step":10,"speaker":"赫卡蒂","content":"待在车里，保护局长。后面的敌人由我解决。","voice":["vo_cgplot_3021010"],"voice_bank":"vo_cgplot_03","style":1,"background":101,"log_type":1}]}