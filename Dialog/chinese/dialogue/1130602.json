{"id":1130602,"chapter_id":1130602,"scene_id":1,"steps":[{"step":1,"content":"琳，拿上你的相机，跟我出门吧。","style":2,"background":1022,"log_type":1,"src_id":230602001,"trial_step":1},{"step":2,"speaker":"琳","content":"怎、怎么了……？","style":1,"background":1022,"log_type":1,"src_id":230602002,"trial_step":2},{"step":3,"content":"面对你的突然造访，琳非常不知所措。","style":3,"background":1022,"log_type":1,"src_id":230602003,"trial_step":3},{"step":4,"content":"你上次不是说喜欢摄影吗？我申请到了外出许可，走，我带你出去采风。","style":2,"background":1022,"log_type":1,"src_id":230602004,"trial_step":4},{"step":5,"content":"自上次审查意外中止后，你一直记挂着想要开导琳的心结，顺便弥补她。","style":3,"background":1022,"log_type":1,"src_id":230602005,"trial_step":5},{"step":6,"speaker":"琳","content":"真……真的可以吗？","style":1,"background":1022,"log_type":1,"src_id":230602006,"trial_step":6},{"step":7,"content":"琳语气犹疑但掩不住满满的期待。","style":3,"background":1022,"log_type":1,"src_id":230602007,"trial_step":7},{"step":8,"content":"放心吧，我都安排好了。","style":2,"background":1022,"log_type":1,"src_id":230602008,"trial_step":8},{"step":9,"content":"琳一路上都颇为忐忑，紧张地攥着她的相机。","style":3,"background":1029,"log_type":1,"src_id":230602009,"trial_step":9},{"step":10,"content":"直到踏上辛迪加的地界，她才切切实实地兴奋起来。","style":3,"background":1029,"log_type":1,"src_id":230602010,"trial_step":10},{"step":11,"speaker":"琳","content":"这里……没有什么变化呢！","style":1,"background":1029,"log_type":1,"src_id":230602011,"trial_step":11},{"step":12,"content":"她一副迫不及待要出发拍照的模样，却迟迟不敢迈出脚步，反倒扭头望向你，似乎在征求什么同意。","style":3,"background":1029,"log_type":1,"src_id":230602012,"trial_step":12},{"step":13,"options":["你还在顾忌什么","你想去哪里都可以"],"style":6,"background":1029,"log_type":1,"src_id":230602013,"trial_step":13,"course":3,"choices":[{"text":"你还在顾忌什么","goto":14},{"text":"你想去哪里都可以","goto":null}]},{"step":14,"content":"我知道，摄影师都比较自由。","style":2,"background":1029,"log_type":1,"src_id":230602014,"trial_step":14},{"step":15,"content":"你们喜欢到处寻找灵感，还总能发现别人察觉不到的独特风景。","style":2,"background":1029,"log_type":1,"src_id":230602015,"trial_step":15},{"step":16,"speaker":"琳","content":"我、我不是什么摄影师……","style":1,"background":1029,"log_type":1,"src_id":230602016,"trial_step":16},{"step":17,"speaker":"琳","content":"我只是会注意到一些……不怎么起眼的角落……","style":1,"background":1029,"log_type":1,"src_id":230602017,"trial_step":17},{"step":18,"speaker":"琳","content":"那个……也可能是我的审美太奇怪了吧！总之，总之……","style":1,"background":1029,"log_type":1,"src_id":230602018,"trial_step":18},{"step":19,"content":"能让你注意到，我想应该会是有趣的地方。","style":2,"background":1029,"log_type":1,"src_id":230602019,"trial_step":19},{"step":20,"content":"我也很感兴趣，带我去看看吧。","style":2,"background":1029,"log_type":1,"src_id":230602020,"trial_step":20},{"step":21,"speaker":"琳","content":"嗯……那、那好吧……","style":1,"background":1029,"log_type":1,"src_id":230602021,"trial_step":21},{"step":22,"content":"你跟在琳身后，看着她像只刚被放出笼子的小动物，步伐逐渐从凝滞试探变为轻盈自在。","style":3,"background":1029,"log_type":1,"src_id":230602022,"trial_step":22},{"step":23,"speaker":"琳","content":"请您跟紧我……我一般走没什么人经过的小巷，它们比较复杂……容易迷路……","style":1,"background":1029,"log_type":1,"src_id":230602023,"trial_step":23},{"step":24,"content":"难为你能摸清这些巷子，真不容易……","style":2,"background":1029,"log_type":1,"src_id":230602024,"trial_step":24},{"step":25,"speaker":"琳","content":"嗯……虽然大路边的景色拍不到了，但也没有办法……","style":1,"background":1029,"log_type":1,"src_id":230602025,"trial_step":25},{"step":26,"speaker":"琳","content":"毕竟我这个样子，比较奇怪……我不想被人看见……","style":1,"background":1029,"log_type":1,"src_id":230602026,"trial_step":26},{"step":27,"speaker":"琳","content":"况且我也……不怎么拍人。","style":1,"background":1029,"log_type":1,"src_id":230602027,"trial_step":27},{"step":28,"speaker":"琳","content":"我喜欢拍那些……不会说话的东西。","style":1,"background":1029,"log_type":1,"src_id":230602028,"trial_step":28},{"step":29,"speaker":"琳","content":"因为它们很安静……不会嘲笑我，也不会对我说教。这会让我觉得……很亲切。","style":1,"background":1029,"log_type":1,"src_id":230602029,"trial_step":29},{"step":30,"content":"像是想起什么似的，琳摸了摸自己的相机，小小声地告诉你。","style":3,"background":1029,"log_type":1,"src_id":230602030,"trial_step":30},{"step":31,"speaker":"琳","content":"但……但我还是有一个朋友，愿意给我当模特拍摄的……","style":1,"background":1029,"log_type":1,"src_id":230602031,"trial_step":31},{"step":32,"content":"这里的朋友？那你们应该很久没有见面了吧。","style":2,"background":1029,"log_type":1,"src_id":230602032,"trial_step":32},{"step":33,"speaker":"琳","content":"嗯……","style":1,"background":1029,"log_type":1,"src_id":230602033,"trial_step":33},{"step":34,"content":"难得出来一趟，要不我们现在去拜访你的朋友？","style":2,"background":1029,"log_type":1,"src_id":230602034,"trial_step":34},{"step":35,"speaker":"琳","content":"可……可以吗？","style":1,"background":1029,"log_type":1,"src_id":230602035,"trial_step":35},{"step":36,"content":"当然，今天的行程由你来安排。","style":2,"background":1029,"log_type":1,"src_id":230602036,"trial_step":36},{"step":37,"speaker":"琳","content":"那、那……那我先谢谢局长先生……！","female_content":"那、那……那我先谢谢局长小姐……！","style":1,"background":1029,"log_type":1,"src_id":230602037,"trial_step":37},{"step":38,"content":"走着走着，琳突然在一块破旧到看不清字迹的路标前停了下来。","style":3,"background":1029,"log_type":1,"src_id":230602038,"trial_step":38},{"step":39,"speaker":"琳","content":"这块路标……对我来讲，有种特殊的意义……","style":1,"background":1029,"log_type":1,"src_id":230602039,"trial_step":39},{"step":40,"content":"琳找好光线和角度，郑重地将它拍了下来。","style":3,"background":1029,"log_type":1,"src_id":230602040,"trial_step":40},{"step":41,"speaker":"琳","content":"它代表着辛迪加的边境，每当我走到这里，就感觉它像是在欢迎我……","style":1,"background":1029,"log_type":1,"src_id":230602041,"trial_step":41},{"step":42,"speaker":"琳","content":"它身后的一切，都可以作为我的取景物……","style":1,"background":1029,"log_type":1,"src_id":230602042,"trial_step":42},{"step":43,"content":"所以说……它是你摄影之路的起点吗？","style":2,"background":1029,"log_type":1,"src_id":230602043,"trial_step":43},{"step":44,"speaker":"琳","content":"也、也可以这么理解吧……","style":1,"background":1029,"log_type":1,"src_id":230602044,"trial_step":44},{"step":45,"content":"琳有些不好意思地敲了敲自己的头盔，转身带着你钻进了另一条小巷中，一路走，一路拍。","style":3,"background":1029,"log_type":1,"src_id":230602045,"trial_step":45},{"step":46,"speaker":"琳","content":"看，局长先生……那种东西，是新城没有的吧？","female_content":"看，局长小姐……那种东西，是新城没有的吧？","style":1,"background":1029,"log_type":1,"src_id":230602046,"trial_step":46},{"step":47,"content":"琳举起相机仰头拍着什么，你凑过去，她便将拍好的照片递给你看。","style":3,"background":1029,"log_type":1,"src_id":230602047,"trial_step":47},{"step":48,"speaker":"琳","content":"这种乱糟糟的老化电线，现在只剩下辛迪加的还没被清理干净了吧……","style":1,"background":1029,"log_type":1,"src_id":230602048,"trial_step":48},{"step":49,"content":"唔……在这张照片里，这些电线莫名给我一种在野蛮生长的感觉。","style":2,"background":1029,"log_type":1,"src_id":230602049,"trial_step":49},{"step":50,"speaker":"琳","content":"您……您也是这么觉得的吗！","style":1,"background":1029,"log_type":1,"src_id":230602050,"trial_step":50},{"step":51,"content":"琳惊喜地仰头，语调也不自觉地高昂起来，用指尖在取景框里比比划划。","style":3,"background":1029,"log_type":1,"src_id":230602051,"trial_step":51},{"step":52,"speaker":"琳","content":"虽然很多人都说它们又脏又乱，但我觉得，它们看上去就像连接城市和天空的血管一样……非常有生命力！","style":1,"background":1029,"log_type":1,"src_id":230602052,"trial_step":52},{"step":53,"speaker":"琳","content":"还是第一次……有人看出了我拍照时想法……","style":1,"background":1029,"log_type":1,"src_id":230602053,"trial_step":53},{"step":54,"content":"那是你的照片表现力本身就不错，我才能感受出来。","style":2,"background":1029,"log_type":1,"src_id":230602054,"trial_step":54},{"step":55,"speaker":"琳","content":"……谢谢！我、我只是，拍我自己想拍的东西罢了……","style":1,"background":1029,"log_type":1,"src_id":230602055,"trial_step":55},{"step":56,"speaker":"琳","content":"那个，您不需要一直夸奖我的……只要您喜欢我的照片，这就足够了……","style":1,"background":1029,"log_type":1,"src_id":230602056,"trial_step":56},{"step":57,"content":"可我就是因为喜欢你的照片，所以才要夸奖你啊？","style":2,"background":1029,"log_type":1,"src_id":230602057,"trial_step":57},{"step":58,"speaker":"琳","content":"诶？……可是，这会让我感觉……很、很害羞……","style":1,"background":1029,"log_type":1,"src_id":230602058,"trial_step":58},{"step":59,"content":"琳紧张地握紧了相机，身体难为情地微微摇晃着，像只随时都要落荒而逃的小兔子。","style":3,"background":1029,"log_type":1,"src_id":230602059,"trial_step":59},{"step":60,"content":"你值得这样的夸奖。","style":2,"background":1029,"log_type":1,"src_id":230602060,"trial_step":60},{"step":61,"speaker":"琳","content":"……","style":1,"background":1029,"log_type":1,"src_id":230602061,"trial_step":61},{"step":62,"content":"头盔上的电子屏似乎有一瞬间的卡壳——她看上去更想逃走了。","style":3,"background":1029,"log_type":1,"src_id":230602062,"trial_step":62},{"step":63,"content":"你笑了笑，决定暂且“放过”这位极度害羞的“兔子小姐”。","style":3,"background":1029,"log_type":1,"src_id":230602063,"trial_step":63},{"step":64,"content":"不知不觉间，你们走过了好几个岔路口，抬眼看去，便望到不远处出现了一座混乱而奇异的庞大建筑。","style":3,"background":904,"log_type":1,"src_id":230602064,"trial_step":64},{"step":65,"content":"前面就是流民寨了……琳，你在找什么？","style":2,"background":904,"log_type":1,"src_id":230602065,"trial_step":65},{"step":66,"speaker":"琳","content":"啊，我在找……","style":1,"background":904,"log_type":1,"src_id":230602066,"trial_step":66},{"step":67,"speaker":"？？？","content":"汪汪汪——","style":1,"background":904,"log_type":1,"src_id":230602067,"trial_step":67},{"step":68,"content":"几声犬吠传来，琳连忙四处张望着，突然一只大黄狗窜到了她的身前。","style":3,"background":904,"log_type":1,"src_id":230602068,"trial_step":68},{"step":69,"content":"小心——","style":2,"background":904,"log_type":1,"src_id":230602069,"trial_step":69},{"step":70,"speaker":"琳","content":"大黄！","style":1,"background":904,"log_type":1,"src_id":230602070,"trial_step":70},{"step":71,"content":"那只大黄狗热情地扑到琳的腿上，友好地甩着尾巴，对她很熟稔的模样。","style":3,"background":904,"log_type":1,"src_id":230602071,"trial_step":71},{"step":72,"content":"难道……它就是你的朋友？","style":2,"background":904,"log_type":1,"src_id":230602072,"trial_step":72},{"step":73,"speaker":"琳","content":"是的！大黄平时住在流民寨里，有时候会跑出来……","style":1,"background":904,"log_type":1,"src_id":230602073,"trial_step":73},{"step":74,"speaker":"琳","content":"它是只好狗狗，之前有个混混想抢我的相机，是大黄帮我把人给吓跑了……","style":1,"background":904,"log_type":1,"src_id":230602074,"trial_step":74},{"step":75,"speaker":"琳","content":"这台相机虽然不值钱，却是爸爸妈妈送给我的，我最重要的宝物……我，很感激大黄……","style":1,"background":904,"log_type":1,"src_id":230602075,"trial_step":75},{"step":76,"speaker":"琳","content":"所以，只要有机会……我就会带吃的来看它，陪它玩……","style":1,"background":904,"log_type":1,"src_id":230602076,"trial_step":76},{"step":77,"speaker":"琳","content":"哎……没想到过去这么久了，它还能认出我……","style":1,"background":904,"log_type":1,"src_id":230602077,"trial_step":77},{"step":78,"content":"对大黄来说，琳肯定也是很重要的朋友吧。","style":2,"background":904,"log_type":1,"src_id":230602078,"trial_step":78},{"step":79,"speaker":"琳","content":"嘿嘿……或许是吧！","style":1,"background":904,"log_type":1,"src_id":230602079,"trial_step":79},{"step":80,"content":"琳陪大黄玩了很久，为它拍下了许多威风活泼的瞬间。","style":3,"background":904,"log_type":1,"src_id":230602080,"trial_step":80},{"step":81,"content":"临别前她蹲在大黄身边抚摸它的脖颈，依依不舍。","style":3,"background":904,"log_type":1,"src_id":230602081,"trial_step":81},{"step":82,"speaker":"琳","content":"再见，大黄……这可能是我们最后一次见面了……","style":1,"background":904,"log_type":1,"src_id":230602082,"trial_step":82},{"step":83,"options":["为什么是最后一次","你们还能再相见的"],"style":6,"background":904,"log_type":1,"src_id":230602083,"trial_step":83,"course":3,"choices":[{"text":"为什么是最后一次","goto":84},{"text":"你们还能再相见的","goto":null}]},{"step":84,"speaker":"琳","content":"……啊？难道我……以后还能再来吗？","style":1,"background":904,"log_type":1,"src_id":230602084,"trial_step":84},{"step":85,"content":"琳错愕地抬头。","style":3,"background":904,"log_type":1,"src_id":230602085,"trial_step":85},{"step":86,"speaker":"琳","content":"我以为这就是最后一次……我可以自由拍照的机会了……","style":1,"background":904,"log_type":1,"src_id":230602086,"trial_step":86},{"step":87,"speaker":"琳","content":"我很感激局长先生给我留下今天的回忆，能让我再次像正常人那样生活……而不是……作为一个怪物。","female_content":"我很感激局长小姐给我留下今天的回忆，能让我再次像正常人那样生活……而不是……作为一个怪物。","style":1,"background":904,"log_type":1,"src_id":230602087,"trial_step":87},{"step":88,"content":"琳，既然你想过正常的生活，那为什么不试着摘下头盔呢？","style":2,"background":904,"log_type":1,"src_id":230602088,"trial_step":88},{"step":89,"content":"摘下头盔，你也会更像一个普通女孩，而不是什么“怪物”了。","style":2,"background":904,"log_type":1,"src_id":230602089,"trial_step":89},{"step":90,"speaker":"琳","content":"……不……不行！","style":1,"background":904,"log_type":1,"src_id":230602090,"trial_step":90},{"step":91,"speaker":"琳","content":"我控制不了那种力量……假如没有头盔的话，我会……我会……","style":1,"background":904,"log_type":1,"src_id":230602091,"trial_step":91},{"step":92,"content":"琳浑身颤抖着，不由自主地向后一点点退去，似乎在害怕你上来将她的头盔摘掉。","style":3,"background":904,"log_type":1,"src_id":230602092,"trial_step":92},{"step":93,"content":"你急忙摆摆手，证明自己没有恶意，轻声安抚道。","style":3,"background":904,"log_type":1,"src_id":230602093,"trial_step":93},{"step":94,"content":"听我说，琳。","style":2,"background":904,"log_type":1,"src_id":230602094,"trial_step":94},{"step":95,"content":"我一直是这么告诉你的——信任我。我拥有名为枷锁的力量，它可以阻止你的能力。","style":2,"background":904,"log_type":1,"src_id":230602095,"trial_step":95},{"step":96,"content":"你担心的情况，我都考虑过了。","style":2,"background":904,"log_type":1,"src_id":230602096,"trial_step":96},{"step":97,"content":"你只需要告诉我，你想不想摘下头盔？","style":2,"background":904,"log_type":1,"src_id":230602097,"trial_step":97},{"step":98,"content":"几步之外的少女听完你的话，陷入了沉默。","style":3,"background":904,"log_type":1,"src_id":230602098,"trial_step":98},{"step":99,"content":"过了许久，她轻声回答。","style":3,"background":904,"log_type":1,"src_id":230602099,"trial_step":99},{"step":100,"speaker":"琳","content":"……我……想。","style":1,"background":904,"log_type":1,"src_id":230602100,"trial_step":100},{"step":101,"content":"那么，请尽情相信我一次吧。","style":2,"background":904,"log_type":1,"src_id":230602101,"trial_step":101},{"step":102,"content":"少女看着你伸向她的手，犹豫了一会儿后，轻轻地牵了上去，指尖的温度传递出小心翼翼的依赖。","style":3,"background":904,"log_type":1,"src_id":230602102,"trial_step":102},{"step":103,"content":"深红色的光芒过后，少女摘下了头盔，却还死死地闭着眼睛，眉心几乎要拧成一团。","style":3,"background":10000,"log_type":1,"src_id":230602104,"trial_step":104},{"step":104,"content":"……琳，睁开眼睛吧。","style":2,"background":10000,"log_type":1,"src_id":230602105,"trial_step":105},{"step":105,"speaker":"琳","content":"我、我害怕……","style":1,"background":10000,"log_type":1,"src_id":230602106,"trial_step":106},{"step":106,"content":"……别怕。无论发生什么，我都会为你承担后果。","style":2,"background":10000,"log_type":1,"src_id":230602107,"trial_step":107},{"step":107,"speaker":"琳","content":"……","style":1,"background":10000,"log_type":1,"src_id":230602108,"trial_step":108},{"step":108,"content":"琳缓缓睁开双眼。","style":3,"background":904,"log_type":1,"src_id":230602109,"trial_step":109},{"step":109,"content":"没有物品被毁，没有人受伤，没有任何恐怖的事情发生，这个世界现在在她的眼中，普通地运行着。","style":3,"background":904,"log_type":1,"src_id":230602110,"trial_step":110},{"step":110,"content":"怎么样，不透过头盔看到的世界，是不是很清晰？","style":2,"background":904,"log_type":1,"src_id":230602111,"trial_step":111},{"step":111,"speaker":"琳","content":"是、是的……","style":1,"background":904,"log_type":1,"src_id":230602112,"trial_step":112},{"step":112,"content":"琳怔怔地望着眼前的景色，泪水止不住地往下淌。","style":3,"background":904,"log_type":1,"src_id":230602113,"trial_step":113},{"step":113,"speaker":"琳","content":"啊……我……怎么，又看不清了……","style":1,"background":904,"log_type":1,"src_id":230602114,"trial_step":114},{"step":114,"content":"走，我们去其他地方看看。","style":2,"background":904,"log_type":1,"src_id":230602115,"trial_step":115},{"step":115,"content":"你牵着琳闯出小巷，来到熙熙攘攘的路口，一路上没有传来任何异样的目光。","style":3,"background":122,"log_type":1,"src_id":230602116,"trial_step":116},{"step":116,"content":"现在你不用躲着人了，想去拍什么都可以。","style":2,"background":122,"log_type":1,"src_id":230602117,"trial_step":117},{"step":117,"speaker":"琳","content":"……好！","style":1,"background":122,"log_type":1,"src_id":230602118,"trial_step":118},{"step":118,"content":"少女光明正大地站在街头，举起相机，用不断闪烁的快门定格住每一个美好的画面。","style":3,"background":122,"log_type":1,"src_id":230602119,"trial_step":119},{"step":119,"content":"没有人知道她拍照时为什么又哭又笑，也没人知道这普普通通的日常对她而言有多么来之不易……除了你。","style":3,"background":122,"log_type":1,"src_id":230602120,"trial_step":120},{"step":120,"options":["摘下头盔的感觉怎么样"],"style":6,"background":122,"log_type":1,"src_id":230602121,"trial_step":121,"course":3,"choices":[{"text":"摘下头盔的感觉怎么样","goto":122}]},{"step":121,"speaker":"琳","content":"感觉……很快乐。从没有这么快乐过……","style":1,"background":122,"log_type":1,"src_id":230602122,"trial_step":122},{"step":122,"speaker":"琳","content":"真好啊……要是我能一直像这样生活的话……","style":1,"background":122,"log_type":1,"src_id":230602123,"trial_step":123},{"step":123,"content":"可以的。","style":2,"background":122,"log_type":1,"src_id":230602124,"trial_step":124},{"step":124,"speaker":"琳","content":"……诶？","style":1,"background":122,"log_type":1,"src_id":230602125,"trial_step":125},{"step":125,"content":"如果你愿意，我能帮助你学会如何控制自己的力量。","style":2,"background":122,"log_type":1,"src_id":230602126,"trial_step":126},{"step":126,"content":"你完全可以重新开始。","style":2,"background":122,"log_type":1,"src_id":230602127,"trial_step":127},{"step":127,"speaker":"琳","content":"但是，我曾伤害过那么多人……","style":1,"background":122,"log_type":1,"src_id":230602128,"trial_step":128},{"step":128,"speaker":"琳","content":"我还配像这样……在阳光底下大大方方地生活吗？","style":1,"background":122,"log_type":1,"src_id":230602129,"trial_step":129},{"step":129,"content":"……那一天，你是故意伤害他们的吗？","style":2,"background":122,"log_type":1,"src_id":230602130,"trial_step":130},{"step":130,"speaker":"琳","content":"不……怎么会……！","style":1,"background":122,"log_type":1,"src_id":230602131,"trial_step":131},{"step":131,"speaker":"琳","content":"当时是他们先……然后我太害怕了……就……","style":1,"background":122,"log_type":1,"src_id":230602132,"trial_step":132},{"step":132,"speaker":"琳","content":"等我清醒过来……才发现一切都无法挽回了……","style":1,"background":122,"log_type":1,"src_id":230602133,"trial_step":133},{"step":133,"content":"之后呢？","style":2,"background":122,"log_type":1,"src_id":230602134,"trial_step":134},{"step":134,"speaker":"琳","content":"之后我逃走了……还不小心跌进了新城的下水道，就一直在里面躲着，直到……被你们发现。","style":1,"background":122,"log_type":1,"src_id":230602135,"trial_step":135},{"step":135,"content":"在我看来……你也已经接受了应受的惩罚。","style":2,"background":122,"log_type":1,"src_id":230602136,"trial_step":136},{"step":136,"speaker":"琳","content":"什么……？","style":1,"background":122,"log_type":1,"src_id":230602137,"trial_step":137},{"step":137,"content":"被管理局收容之前，你在肮脏的下水道里东躲西藏，无家可归。","style":2,"background":122,"log_type":1,"src_id":230602138,"trial_step":138},{"step":138,"content":"来到管理局之后，你不仅失去了人身自由，还得冒着生命危险去解决狂厄危机。","style":2,"background":122,"log_type":1,"src_id":230602139,"trial_step":139},{"step":139,"content":"这么艰难的处境，难道还不够让你得到教训吗？","style":2,"background":122,"log_type":1,"src_id":230602140,"trial_step":140},{"step":140,"speaker":"琳","content":"呜……","style":1,"background":122,"log_type":1,"src_id":230602141,"trial_step":141},{"step":141,"content":"更何况，那些受伤的人，本身也有错。他们犯下的错误，才是这一切悲剧的源头。","style":2,"background":122,"log_type":1,"src_id":230602142,"trial_step":142},{"step":142,"content":"无论是谁，都得为自己作恶的后果付出代价。","style":2,"background":122,"log_type":1,"src_id":230602143,"trial_step":143},{"step":143,"speaker":"琳","content":"可、可我……","style":1,"background":122,"log_type":1,"src_id":230602144,"trial_step":144},{"step":144,"content":"说白了，你只是一名防卫过当的受害者而已。","style":2,"background":122,"log_type":1,"src_id":230602145,"trial_step":145},{"step":145,"content":"虽然你的人生注定和从前不一样了……但我仍希望，你能再次拥有像今天这样快乐的机会。","style":2,"background":122,"log_type":1,"src_id":230602146,"trial_step":146},{"step":146,"content":"听完你所说的话，琳虽然仍流着眼泪，却努力地，挤出了一个小小的笑容。","style":3,"background":122,"log_type":1,"src_id":230602147,"trial_step":147},{"step":147,"speaker":"琳","content":"谢谢您，局长先生……","female_content":"谢谢您，局长小姐……","style":1,"background":122,"log_type":1,"src_id":230602148,"trial_step":148},{"step":148,"speaker":"琳","content":"我真没用……还麻烦您这样费尽心思地开导我……","style":1,"background":122,"log_type":1,"src_id":230602149,"trial_step":149},{"step":149,"content":"人总不能一直被困在过去。琳，只要你有勇气去面对，就可以战胜它的。","style":2,"background":122,"log_type":1,"src_id":230602150,"trial_step":150},{"step":150,"speaker":"琳","content":"勇气……吗……","style":1,"background":122,"log_type":1,"src_id":230602151,"trial_step":151},{"step":151,"content":"像是回想起了什么，琳从兜里掏出两枚糖果。","style":3,"background":122,"log_type":1,"src_id":230602152,"trial_step":152},{"step":152,"speaker":"琳","content":"这是……您和嗷呜给我的勇气糖果，说是吃下去，就能获得真正的勇气……","style":1,"background":122,"log_type":1,"src_id":230602153,"trial_step":153},{"step":153,"speaker":"琳","content":"我一直留着它没有吃掉，大概也是清楚自己，还没有下定决心……","style":1,"background":122,"log_type":1,"src_id":230602154,"trial_step":154},{"step":154,"speaker":"琳","content":"不过现在……是时候了。","style":1,"background":122,"log_type":1,"src_id":230602155,"trial_step":155},{"step":155,"content":"她缓缓地剥开糖纸，将糖果含进嘴里。","style":3,"background":122,"log_type":1,"src_id":230602156,"trial_step":156},{"step":156,"speaker":"琳","content":"唔……真的好甜……","style":1,"background":122,"log_type":1,"src_id":230602157,"trial_step":157},{"step":157,"options":["你获得勇气了吗"],"style":6,"background":122,"log_type":1,"src_id":230602158,"trial_step":158,"course":3,"choices":[{"text":"你获得勇气了吗","goto":159}]},{"step":158,"speaker":"琳","content":"……嗯。","style":1,"background":122,"log_type":1,"src_id":230602159,"trial_step":159},{"step":159,"speaker":"琳","content":"我答应您，我会试着去接受……这份力量带给我的改变……","style":1,"background":122,"log_type":1,"src_id":230602160,"trial_step":160},{"step":160,"speaker":"琳","content":"终有一天，我也想靠自己的努力，再一次……做回那个普通的女孩……","style":1,"background":122,"log_type":1,"src_id":230602161,"trial_step":161},{"step":161,"content":"恭喜你，终于振作起来了。","style":2,"background":122,"log_type":1,"src_id":230602162,"trial_step":162},{"step":162,"content":"每一个关心你的人，都会为感到你高兴的。","style":2,"background":122,"log_type":1,"src_id":230602163,"trial_step":163},{"step":163,"content":"琳的笑容中突然掺杂了一丝苦涩，你意识到，她内心仍有伤痕没有抚平。","style":3,"background":122,"log_type":1,"src_id":230602164,"trial_step":164},{"step":164,"speaker":"琳","content":"嗯……或许吧……","style":1,"background":122,"log_type":1,"src_id":230602165,"trial_step":165}]}