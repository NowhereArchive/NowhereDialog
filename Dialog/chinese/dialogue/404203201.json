{"id":404203201,"chapter_id":50087,"scene_id":58712,"steps":[{"step":1,"content":"距离天亮退潮","style":14,"background":2496,"is_centered":true,"log_type":1},{"step":2,"content":"02:26:35","style":14,"background":2496,"is_centered":true,"log_type":1},{"step":3,"content":"塔顶已经成为海浪和怪物挤压下的最后支点。雨水混着怪物的腐汁灌满裂缝，塔体结构在频繁的冲击中开始震动。","style":3,"background":2496,"log_type":1},{"step":4,"content":"赛托抹开糊住视线的血，看向身后单薄的身影——","style":3,"background":2496,"log_type":1},{"step":5,"content":"${PlayerName}的体力显然告罄，航标灯的光开始不稳定。频闪加剧，灯罩表面甚至出现了裂痕。能量不足，电容无法保持满载，光束逐渐被海雾吞没，照不远也照不高。","style":3,"background":2496,"log_type":1},{"step":6,"content":"但你仍试图扯出一个笑容。","style":3,"background":2496,"log_type":1},{"step":7,"content":"别担心，当年在MBCC体能测试...我好歹也拿过一次B+......","style":2,"background":2496,"log_type":1},{"step":8,"content":"逞能的说辞还没说完，塔顶震动，你力气不支跪倒在地上，你们之间的枷锁也应声溃散。电池组的电量几近归零。","style":3,"background":2496,"log_type":1},{"step":9,"content":"赛托借着微弱的灯光，看见了你满手模糊的血泡。","style":3,"background":2496,"log_type":1},{"step":10,"speaker":"赛托","content":"不能这么下去，光传不出去。舰队要迎接的也不是一具精疲力竭的躯壳。","voice":["vo_event_404203201_10"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":11,"content":"<color=#7683a2><i>会有办法的……快想起来！芬恩一定教过！</i></color>","style":3,"background":2496,"log_type":1},{"step":12,"speaker":"赛托","content":"守塔人守则第一条！信号与敌情监控！全天候观察边境，确保信号畅通，及时报告敌情。作为最前线的守卫，我们无所畏惧，随时准备为城邦献身。","voice":["vo_event_404201302_26"],"voice_bank":"vo_event_42013","style":1,"background":2496,"log_type":1},{"step":13,"speaker":"赛托","content":"守塔人守则第二条！灯塔光源维护……光信号是我们传递信息的最可靠方式，确保灯塔始终正常运行，是我们的首要责任！","voice":["vo_event_404201302_27"],"voice_bank":"vo_event_42013","style":1,"background":2496,"log_type":1},{"step":14,"speaker":"赛托","content":"会有办法的——","voice":["vo_event_404203201_11"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":15,"content":"【回忆】【训练场】","style":18,"background":2447,"log_type":1},{"step":16,"speaker":"芬恩","content":"今天，我们来学守塔人守则第三条！灯塔损坏应急情况——","voice":["vo_event_404203201_23"],"voice_bank":"vo_event_42033","style":1,"background":2447,"log_type":1},{"step":17,"speaker":"芬恩","content":"“如灯塔设备损坏，无法发送信号时，立即使用旗语与其他岗哨或指挥部联系。旗语是一种可靠的通讯方式，确保即使信号塔无法运作，我们依然能够传递关键信息……”","voice":["vo_event_404203201_16"],"voice_bank":"vo_event_42033","style":1,"background":2447,"log_type":1},{"step":18,"content":"沙尘暴席卷的训练场，十二岁的赛托举着旗帜几乎要被狂风吹倒。","style":3,"background":2447,"log_type":1},{"step":19,"speaker":"赛托","content":"做到这些……就能加入守塔人了，对不对！就能……和你们一起去狄斯了？","voice":["vo_event_404203201_15"],"voice_bank":"vo_event_42033","style":1,"background":2447,"log_type":1},{"step":20,"content":"芬恩的刀鞘轻轻敲在她头顶。","style":3,"background":2447,"log_type":1},{"step":21,"speaker":"芬恩","content":"哪有那么简单。记住！旗语不只是信号，更是守塔人把命钉进风浪里的锚！告诉你的敌人和战友——","voice":["vo_event_404203201_18"],"voice_bank":"vo_event_42033","style":1,"background":2447,"log_type":1},{"step":22,"content":"芬恩枯瘦的手突然发力，拉着赛托，将她手中的旗帜捅进狂风！","style":3,"background":2447,"log_type":1},{"step":23,"speaker":"芬恩","content":"我们还没认输！","voice":["vo_event_404203201_20"],"voice_bank":"vo_event_42033","style":1,"background":2447,"log_type":1},{"step":24,"content":"【回忆】","style":18,"background":2496,"log_type":1},{"step":25,"speaker":"赛托","content":"把手给我！","voice":["vo_event_404203201_22"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":26,"content":"要做什么？","style":2,"background":2496,"log_type":1},{"step":27,"content":"你话未说完，她已经撕开自己残存的制服外套，将鲜艳的布条缠上被折断的铁杆，简易的求救旗成型。","style":3,"background":2496,"log_type":1},{"step":28,"speaker":"赛托","content":"西窗的入口还没被这些畜生攻破。你去那儿站着，按我说的做。","voice":["vo_event_404203201_25"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":29,"content":"她用手指在你掌心急速勾画符号，你记得这是求救的信号。她将血旗塞进你怀里，指向唯一未碎的玻璃窗。","style":3,"background":2496,"log_type":1},{"step":30,"speaker":"赛托","content":"记住这个旗语。不断重复，面向大海，不要回头。执行《守塔人守则》第三条。","voice":["vo_event_404203201_27"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":31,"speaker":"赛托","content":"此刻开始，你就是航标灯。","voice":["vo_event_404203201_28"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":32,"content":"没有思考的余地，你被她推到西窗前按她指示的动作举起血旗。第一组旗语挥动——","style":3,"background":2496,"log_type":1},{"step":33,"speaker":"赛托","content":"幅度！","voice":["vo_event_404203201_30"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":34,"content":"你听见武器划破空气后生命体沉闷碎裂的声音，也听见某种钝物撞击塔壁时的震动。但没了枷锁的联系你无法确认赛托的情况。","style":3,"background":2496,"log_type":1},{"step":35,"content":"第二组长旗号——","style":3,"background":2496,"log_type":1},{"step":36,"speaker":"赛托","content":"能看清舰队吗……","voice":["vo_event_404203201_33"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":37,"content":"没有之前清晰，但似乎能看见舰队船头红色的警示灯。支援靠近的速度比预期更快！","style":2,"background":2496,"log_type":1},{"step":38,"speaker":"赛托","content":"足够了，他们能看见这里。","voice":["vo_event_404203201_35"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":39,"content":"第三组旗号，有温热的液体溅到后颈。","style":3,"background":2496,"log_type":1},{"step":40,"speaker":"赛托","content":"节奏乱了！","voice":["vo_event_404203201_37"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":41,"content":"她的警告夹杂着压抑的痛哼。","style":3,"background":2496,"log_type":1},{"step":42,"content":"第四组，你的动作逐渐熟练，但赛托的刀锋慢了半拍。","style":3,"background":2496,"log_type":1},{"step":43,"content":"第十组，喘息变成破碎的抽气声，刀刃碰撞的间隔越来越长、越来越钝。","style":3,"background":2496,"log_type":1},{"step":44,"content":"你一度想分神去看她的情况，但刚一侧头就听见赛托的声音响起。","style":3,"background":2496,"log_type":1},{"step":45,"speaker":"赛托","content":"别停……别回头……","voice":["vo_event_404203201_42"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":46,"content":"你机械地重复着动作，指节发白，旗语没停。","style":3,"background":2496,"log_type":1},{"step":47,"speaker":"赛托","content":"快了，我们就快见到太阳了……","voice":["vo_event_404203201_44"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":48,"content":"身后又是一声撞击，这次带着金属变形的呻吟。空气中血腥味越来越重，黏稠液体漫过脚背，那绝不是怪物的血……","style":3,"background":2496,"log_type":1},{"step":49,"content":"第十五组……","style":3,"background":2496,"log_type":1},{"step":50,"content":"可你的背后却一片寂静。","style":3,"background":2496,"log_type":1},{"step":51,"content":"赛托，你这边怎么样了？","style":2,"background":2496,"log_type":1},{"step":52,"content":"没有回应……","style":3,"background":2496,"log_type":1},{"step":53,"content":"赛托？","style":2,"background":2496,"log_type":1},{"step":54,"speaker":"赛托","content":"……","voice":["vo_event_404203201_51"],"voice_bank":"vo_event_42033","style":1,"background":2496,"log_type":1},{"step":55,"options":["回头查看"],"jump":[56],"style":6,"background":2496,"log_type":1},{"step":56,"content":"【赛托战损cg】【来点激昂悲壮的bgm】","style":18,"background":4661,"log_type":1},{"step":57,"content":"她还在坚持着，一根钢筋从护栏缝隙里伸出，从她肋骨贯穿，将她钉在原地，她干脆将身体支撑在上面。","style":3,"background":4661,"log_type":1},{"step":58,"content":"即便如此，即便眼白完全充血，但她的瞳孔还钉在怪物来袭的方向。","style":3,"background":4661,"log_type":1},{"step":59,"speaker":"脑海的回响","content":"<color=#7683a2><i>朝着那里战斗，为它一直战斗，不让你身后灯塔的光芒熄灭。</i></color>","voice":["vo_event_404203201_69"],"voice_bank":"vo_event_42033","style":1,"background":4661,"log_type":1},{"step":60,"speaker":"脑海的回响","content":"<color=#7683a2><i>我们要一起回去……风风光光地回狄斯！</i></color>","voice":["vo_event_404203201_70"],"voice_bank":"vo_event_42033","style":1,"background":4661,"log_type":1},{"step":61,"speaker":"脑海的回响","content":"<color=#7683a2><i>此刻开始，你就是航标灯。</i></color>","voice":["vo_event_404203201_28"],"voice_bank":"vo_event_42033","style":1,"background":4661,"log_type":1},{"step":62,"speaker":"赛托","content":"不……不能熄灭……","voice":["vo_event_404203201_59"],"voice_bank":"vo_event_42033","style":1,"background":4661,"log_type":1},{"step":63,"content":"她的双唇龟裂，艰难开合，口中几乎已经发不出任何声音——","style":3,"background":4661,"log_type":1},{"step":64,"content":"【战损近景cg】","style":18,"background":4662,"log_type":1},{"step":65,"speaker":"赛托","content":"回……家……","voice":["vo_event_404203201_62"],"voice_bank":"vo_event_42033","style":1,"background":4662,"log_type":1},{"step":67,"content":"黑暗如潮水般漫上来，赛托感觉自己在缓缓下沉。伤口不再疼痛，取而代之的是一种冰冷的麻木感。远处似乎有光，却又遥不可及。","style":3,"background":10000,"log_type":1},{"step":68,"content":"耳边最先响起的是一些脚步声，靴子踏在金属地板上的声音由远及近。","style":3,"background":10000,"log_type":1},{"step":69,"content":"【众队友立绘】","style":18,"background":2500,"log_type":1},{"step":70,"speaker":"赛托","content":"你们……怎么在这儿？","voice":["vo_event_404203201_68"],"voice_bank":"vo_event_42033","style":1,"background":2500,"log_type":1}]}