{"id":3032,"chapter_id":3,"scene_id":303,"steps":[{"step":1,"speaker":"扛刀的禁闭者","content":"……去死吧！","voice":["vo_cgplot_3032001"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":2,"content":"嘶哑沉闷的声音穿过她头盔上的裂缝传到你耳边。她还挣扎着向你移动着，但这次，海拉翻过车盖跳了出来。","style":3,"background":303,"log_type":1},{"step":3,"speaker":"海拉","content":"别让我说第二次，离他远点！","female_content":"别让我说第二次，离她远点！","voice":["vo_cgplot_3032003","vo_cgplot_3032003f"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":4,"content":"她的钢管用力砸向追杀者的头盔，将本已受伤的敌人彻底击退。","style":3,"background":303,"log_type":1},{"step":5,"speaker":"赫卡蒂","content":"还会有追兵的，我们要快点离开这里。","voice":["vo_cgplot_3032005"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":6,"speaker":"喇叭声","content":"哔————","style":1,"background":303,"log_type":1},{"step":7,"content":"前方一辆军团越野车突然发动，一个熟悉的鸭舌帽探出车窗，向你们一挥手。","style":3,"background":303,"log_type":1},{"step":8,"speaker":"司机","content":"哟。这次猫的车还不错，你们要上来吗？","voice":["vo_cgplot_3032008"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":9,"speaker":"海拉","content":"你……还活着？","voice":["vo_cgplot_3032009"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":10,"speaker":"海拉","content":"哼，挺有本事的嘛。","voice":["vo_cgplot_3032010"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":11,"speaker":"司机","content":"公务员总该有钱结款吧，走了。","voice":["vo_cgplot_3032011"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":12,"content":"车沿沙漠公路飞驰远离，你回头看被抛下的追兵，那个女人正慢慢直起身子。","style":3,"background":303,"log_type":1},{"step":13,"content":"她的头盔裂开了两半，半边跌落下来，散落的白发在火焰间飞扬，眼睛紧紧注视着你们离开的方向。","style":3,"background":50301,"log_type":1},{"step":14,"content":"你听到海拉轻轻低呼了一声，声音里满是惊诧。","style":3,"background":50301,"log_type":1},{"step":15,"speaker":"海拉","content":"……九十九？","voice":["vo_cgplot_3032016"],"voice_bank":"vo_cgplot_03","style":1,"background":50301,"log_type":1},{"step":16,"options":["你认识她？"],"jump":[17],"style":6,"background":50301,"log_type":1},{"step":17,"content":"海拉没有回答，愣愣地看着那个女人。你没有细问，此刻另一种强烈不安的预感揪住你的心脏。","style":3,"background":50301,"log_type":1},{"step":18,"content":"你们确实摆脱了身后的追兵，沿着公路驶向黑暗的沙漠，可危机并没有结束。","style":3,"background":303,"log_type":1},{"step":19,"speaker":"赫卡蒂","content":"为什么他们不追来……他们已经追了我们一晚上，为什么现在只是看着？","voice":["vo_cgplot_3032020"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":20,"content":"车子在黑夜中疾驰，前灯照亮一小片飞沙。你有种感觉，这不是逃离……更像在不断靠近前方蛰伏的某种可怖之物。","style":3,"background":303,"log_type":1},{"step":21,"content":"你突然明白了这预感的真正含义——","style":3,"background":303,"log_type":1},{"step":22,"options":["前面也有埋伏，掉头！"],"jump":[23],"style":6,"background":303,"log_type":1},{"step":23,"content":"可已经晚了。","style":3,"background":50302,"log_type":1},{"step":24,"content":"一个人影赫然闯入车灯范围，这个距离根本刹不及车。你们就这么高速向她冲去，可对方根本没有躲避的意思。","style":3,"background":50302,"log_type":1},{"step":25,"content":"她直面你们的冲击，一瞬间你竟觉得——她在笑。","style":3,"background":50302,"log_type":1},{"step":26,"speaker":"司机","content":"……别吧……","voice":["vo_cgplot_3032028"],"voice_bank":"vo_cgplot_03","style":1,"background":50302,"log_type":1},{"step":27,"content":"是她！","style":3,"background":50102,"log_type":1},{"step":28,"content":"接触的瞬间，那个女人猛然挥拳砸向车头，一阵猛烈的冲击下，车和你都被抛起。你眼前一黑，什么都不知道了……","style":3,"background":50302,"log_type":1}]}