{"id":401830001,"chapter_id":52001,"scene_id":52024,"steps":[{"step":1,"speaker":"烟烟","content":"神君何在，于彼明堂；下谕巫祝，上晓阴阳。","voice":["vo_event_401830001_1"],"voice_bank":"vo_event_18300","style":1,"background":512,"log_type":1},{"step":2,"speaker":"玩家","content":"接下来我们要去哪里？","style":2,"background":512,"log_type":1},{"step":3,"speaker":"烟烟","content":"就是那边。","voice":["vo_event_401830001_3"],"voice_bank":"vo_event_18300","style":1,"background":512,"log_type":1},{"step":4,"content":"烟烟合上了手中的书，恭恭敬敬地望向了不远处的奇兰雕像，已然没了先前的活泼劲儿，天不怕地不怕的好奇宝宝竟然还紧张地咽了咽口水。","style":3,"background":512,"log_type":1},{"step":5,"speaker":"选项","options":["烟烟很紧张么？"],"jump":[6],"style":6,"background":512,"log_type":1},{"step":6,"content":"面前小小的巫祭点了点头。","style":3,"background":512,"log_type":1},{"step":7,"speaker":"烟烟","content":"只有通过了神君的考验，才能得到能够射落金乌的神箭。","voice":["vo_event_401830001_8"],"voice_bank":"vo_event_18300","style":1,"background":512,"log_type":1},{"step":8,"speaker":"烟烟","content":"但就算在虞渊城，也很少有巫祭见到过神君的相貌，留下的只有关于神君的传说，所以……烟烟有点害怕。","voice":["vo_event_401830001_9"],"voice_bank":"vo_event_18300","style":1,"background":512,"log_type":1},{"step":9,"speaker":"选项","options":["没事的，大家都会给烟烟加油的"],"jump":[10],"style":6,"background":512,"log_type":1},{"step":10,"content":"你笑眯眯地看向身后两位大兵。","style":3,"background":512,"log_type":1},{"step":11,"speaker":"FAC士兵A","content":"你们这些东洲人天天总是谈论神神鬼鬼的……算了，结果好就好吧。","voice":["vo_event_401830001_11"],"voice_bank":"vo_event_18300","style":1,"background":512,"log_type":1},{"step":12,"speaker":"FAC士兵B","content":"对，你就放心大胆地去吧，我们就在这等你，听你的命令。","voice":["vo_event_401830001_12"],"voice_bank":"vo_event_18300","style":1,"background":512,"log_type":1},{"step":13,"speaker":"FAC士兵A","content":"行吧，这还能听到几声鸟叫，也不算无聊。","voice":["vo_event_401830001_13"],"voice_bank":"vo_event_18300","style":1,"background":512,"log_type":1},{"step":14,"speaker":"FAC士兵B","content":"谁说不是呢，之前来奇兰广场可比这次难受多了，你就加油吧小姑娘！","voice":["vo_event_401830001_14"],"voice_bank":"vo_event_18300","style":1,"background":512,"log_type":1},{"step":15,"speaker":"烟烟","content":"嗯，烟烟一定会加油的！","voice":["vo_event_401830001_15"],"voice_bank":"vo_event_18300","style":1,"background":512,"log_type":1},{"step":16,"content":"听着众人的鼓励，她紧绷着的小脸上终于浮出了一些笑意。","style":3,"background":512,"log_type":1}]}