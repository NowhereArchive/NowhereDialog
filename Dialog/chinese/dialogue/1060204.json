{"id":1060204,"chapter_id":1060204,"scene_id":1,"steps":[{"step":1,"content":"浓烈的黑暗瞬间淹没一切，世界就此安静下来。","style":3,"background":10000,"log_type":1,"src_id":160204001,"trial_step":1},{"step":2,"options":["恩菲尔……？"],"style":6,"background":10000,"log_type":1,"src_id":160204002,"trial_step":2,"course":3,"choices":[{"text":"恩菲尔……？","goto":3}]},{"step":3,"content":"这里看不到边界，只有影影绰绰的东西划过你的眼前，光怪陆离，不知疲倦。","style":3,"background":10000,"log_type":1,"src_id":160204003,"trial_step":3},{"step":4,"content":"但这里的感觉很熟悉，你能认得出来，这是恩菲尔的能力——虚妄之人是恩菲尔的作品，如今你看到的……","style":3,"background":10000,"log_type":1,"src_id":160204004,"trial_step":4},{"step":5,"content":"是恩菲尔自己的恐惧。","style":3,"background":109,"log_type":1,"src_id":160204005,"trial_step":5},{"step":6,"speaker":"恩菲尔","content":"局长你看，原来……我还怕过这些啊……","voice":["vo_trial_60204_1_1"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204006,"trial_step":6},{"step":7,"content":"恩菲尔的声音忽然在黑暗中响起，你往前一看，不远处，恩菲尔背着手，正盯着眼前一个发着光的，像电影荧幕一样的东西。","style":3,"background":109,"log_type":1,"src_id":160204007,"trial_step":7},{"step":8,"content":"里面不断循环着一些你从未见过的恩菲尔。","style":3,"background":109,"log_type":1,"src_id":160204008,"trial_step":8},{"step":9,"speaker":"“小女孩”","content":"哇……！妈妈！蜜蜂蛰我！","voice":["vo_trial_60204_1_2"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204009,"trial_step":9},{"step":10,"speaker":"“小女孩”","content":"好疼……我害怕蜜蜂呜呜呜……我想要一个没有蜜蜂的世界！","voice":["vo_trial_60204_1_3"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204010,"trial_step":10},{"step":11,"content":"小小的人儿举着受伤的手指，扑进一个妇人怀中，眼泪婆娑。","style":3,"background":109,"log_type":1,"src_id":160204011,"trial_step":11},{"step":12,"speaker":"“少女”","content":"呸、呸！","voice":["vo_trial_60204_1_4"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204012,"trial_step":12},{"step":13,"speaker":"“少女”","content":"好烫啊……上面好像被烫掉了一层皮……","voice":["vo_trial_60204_1_5"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204013,"trial_step":13},{"step":14,"speaker":"“少女”","content":"痛……","voice":["vo_trial_60204_1_6"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204014,"trial_step":14},{"step":15,"content":"看着荧幕上，少女将倒满滚烫红茶的杯子推得远远的，恩菲尔不禁笑出了声。","style":3,"background":109,"log_type":1,"src_id":160204015,"trial_step":15},{"step":16,"speaker":"恩菲尔","content":"呵呵……对于小时候来说……","voice":["vo_trial_60204_1_7"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204016,"trial_step":16},{"step":17,"speaker":"恩菲尔","content":"恐惧无非是蛰你的蜜蜂，烫到上颚的红茶。","voice":["vo_trial_60204_1_8"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204017,"trial_step":17},{"step":18,"speaker":"恩菲尔","content":"她们创造出来的东西……稚嫩，生动，天真得不得了。","voice":["vo_trial_60204_1_9"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204018,"trial_step":18},{"step":19,"speaker":"恩菲尔","content":"但也像她们自己一样……脆弱得一碰就碎。","voice":["vo_trial_60204_1_10"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204019,"trial_step":19},{"step":20,"content":"恩菲尔往前走去，末了还朝你招招手。","style":3,"background":109,"log_type":1,"src_id":160204020,"trial_step":20},{"step":21,"speaker":"恩菲尔","content":"记忆深处应该有更多的“画面镌刻”，陪我去看看吧。","voice":["vo_trial_60204_1_11"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204021,"trial_step":21},{"step":22,"speaker":"恩菲尔","content":"它不是叫嚣着……它知道我的软弱，知道我为何迷茫……","voice":["vo_trial_60204_1_12"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204022,"trial_step":22},{"step":23,"speaker":"恩菲尔","content":"那我就去见识一下吧，到底是什么藏在了我的恐惧深处，让我迷茫吧。","voice":["vo_trial_60204_1_13"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204023,"trial_step":23},{"step":24,"content":"你跟了上去，沿着恩菲尔走过的痕迹，慢慢前行着。","style":3,"background":109,"log_type":1,"src_id":160204024,"trial_step":24},{"step":25,"content":"直到眼前又出现了一块荧幕。","style":3,"background":109,"log_type":1,"src_id":160204025,"trial_step":25},{"step":26,"content":"荧幕上的画面，已经不复前面的光亮，它黯淡无比，就像被堆上了厚重的乌云。","style":3,"background":109,"log_type":1,"src_id":160204026,"trial_step":26},{"step":27,"speaker":"恩菲尔","content":"……","style":1,"background":109,"log_type":1,"src_id":160204027,"trial_step":27},{"step":28,"speaker":"恩菲尔","content":"我认得这些云。","voice":["vo_trial_60204_1_15"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204028,"trial_step":28},{"step":29,"content":"恩菲尔望着屏幕，喃喃说到。","style":3,"background":109,"log_type":1,"src_id":160204029,"trial_step":29},{"step":30,"content":"像是应验她的话，荧幕上炸开一道惊雷，晃得人眼花，却依旧无法照亮这片“恐惧”。","style":3,"background":109,"log_type":1,"src_id":160204030,"trial_step":30},{"step":31,"speaker":"“少女”","content":"爸爸……？","voice":["vo_trial_60204_1_16"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204031,"trial_step":31},{"step":32,"speaker":"“少女”","content":"你看见……妈妈了吗？","voice":["vo_trial_60204_1_17"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204032,"trial_step":32},{"step":33,"speaker":"“父亲”","content":"妈妈？妈妈不是在这里吗？","voice":["vo_trial_60204_1_18"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204033,"trial_step":33},{"step":34,"content":"闪电和雷声一并响起，女孩的眼前被照亮——","style":3,"background":109,"log_type":1,"src_id":160204034,"trial_step":34},{"step":35,"content":"她脚下踩着的温热并非自己所想的热水，她鼻翼间闻到的，也并非下雨天特有的土腥味。","style":3,"background":109,"log_type":1,"src_id":160204035,"trial_step":35},{"step":36,"speaker":"“父亲”","content":"好好记下来吧！好好学会它！！！","voice":["vo_trial_60204_1_19"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204036,"trial_step":36},{"step":37,"content":"少女被父亲拎到自己面前扔下，父亲掰着她的脸，不允许她转开。","style":3,"background":109,"log_type":1,"src_id":160204037,"trial_step":37},{"step":38,"speaker":"“父亲”","content":"只有这样……只有这样我才能成功！他们说了，生死之间，一定能有最刺激的灵感！哈哈哈哈！！","voice":["vo_trial_60204_1_20"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204038,"trial_step":38},{"step":39,"speaker":"“父亲”","content":"你会拥有一个……无比成功的父亲！家庭！","voice":["vo_trial_60204_1_21"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204039,"trial_step":39},{"step":40,"content":"少女的所有感官都被放大，可独独听不到任何声音，甚至自己的心跳。","style":3,"background":109,"log_type":1,"src_id":160204040,"trial_step":40},{"step":41,"content":"她看着面前，还在微微起伏颤动的衣角，脑内一片空白。","style":3,"background":109,"log_type":1,"src_id":160204041,"trial_step":41},{"step":42,"speaker":"恩菲尔","content":"快走……","voice":["vo_trial_60204_1_22"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204042,"trial_step":42},{"step":43,"content":"恩菲尔的手紧握起来，微微颤抖着。","style":3,"background":109,"log_type":1,"src_id":160204043,"trial_step":43},{"step":44,"content":"一声尖叫划破沉静，你急忙抬头看去——","style":3,"background":109,"log_type":1,"src_id":160204044,"trial_step":44},{"step":45,"content":"屏幕中，少女被狠狠推开，摔去一边。","style":3,"background":109,"log_type":1,"src_id":160204045,"trial_step":45},{"step":46,"content":"她惊恐地瞪大双眼，看着父亲的錾子，一次又一次地落下。","style":3,"background":109,"log_type":1,"src_id":160204046,"trial_step":46},{"step":47,"content":"这是？！","style":2,"background":109,"log_type":1,"src_id":160204047,"trial_step":47},{"step":48,"content":"荧幕开始倒退，回到了少女被推开的那一幕，然后不断、不断地循环播放。","style":3,"background":109,"log_type":1,"src_id":160204048,"trial_step":48},{"step":49,"speaker":"恩菲尔","content":"……","voice":["vo_trial_60204_1_23"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204049,"trial_step":49},{"step":50,"speaker":"恩菲尔","content":"为什么……为什么在这里会看到她……这不应该。","voice":["vo_trial_60204_1_24"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204050,"trial_step":50},{"step":51,"content":"光暗交织在恩菲尔的脸上，你看不清她的表情，只能听到她的喃喃自语。","style":3,"background":109,"log_type":1,"src_id":160204051,"trial_step":51},{"step":52,"speaker":"恩菲尔","content":"母亲……母亲……","voice":["vo_trial_60204_1_25"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204052,"trial_step":52},{"step":53,"content":"恩菲尔轻声呼唤着，声音飘散而来。","style":3,"background":109,"log_type":1,"src_id":160204053,"trial_step":53},{"step":54,"content":"荧幕上的一切都还在循环往复地播放着，像道一点一点凿刻加深在心里的诅咒。","style":3,"background":109,"log_type":1,"src_id":160204054,"trial_step":54},{"step":55,"options":["我……认得这个人。"],"style":6,"background":109,"log_type":1,"src_id":160204055,"trial_step":55,"course":3,"choices":[{"text":"我……认得这个人。","goto":56}]},{"step":56,"speaker":"恩菲尔","content":"……什么？","voice":["vo_trial_60204_1_26"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204056,"trial_step":56},{"step":57,"content":"推开恩菲尔的人，那个身影，你看了很久，发觉她像极了魔女之夜中，那个为恩菲尔挡下最后一击的人。","style":3,"background":109,"log_type":1,"src_id":160204057,"trial_step":57},{"step":58,"content":"我知道她为什么会在这里……恩菲尔。","style":2,"background":109,"log_type":1,"src_id":160204058,"trial_step":58},{"step":59,"speaker":"恩菲尔","content":"不……她不应该……在那天，她被抽离了我的世界……","voice":["vo_trial_60204_1_27"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204059,"trial_step":59},{"step":60,"speaker":"恩菲尔","content":"我的意识中，从此只剩下了恐惧！","voice":["vo_trial_60204_1_28"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204060,"trial_step":60},{"step":61,"content":"你会无意识地留下那个痕迹，是因为……她把爱烙刻在你的意识深处了。","style":2,"background":109,"log_type":1,"src_id":160204061,"trial_step":61},{"step":62,"content":"所以你一直在恐惧爱，恩菲尔。","style":2,"background":109,"log_type":1,"src_id":160204062,"trial_step":62},{"step":63,"content":"这个……是你的“爱”的来源。","style":2,"background":109,"log_type":1,"src_id":160204063,"trial_step":63},{"step":64,"content":"恩菲尔缓缓抬起头，睁大眼睛看着你，就像荧幕上那个惊诧的少女一样。","style":3,"background":109,"log_type":1,"src_id":160204064,"trial_step":64},{"step":65,"speaker":"恩菲尔","content":"爱……的来源？","voice":["vo_trial_60204_1_29"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204065,"trial_step":65},{"step":66,"speaker":"“虚妄之人”","content":"呵呵呵……是啊，是啊！这就是你一直残存的爱！一直没有抛下的爱！","voice":["vo_trial_60204_1_30"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204066,"trial_step":66},{"step":67,"content":"四周的黑暗躁动不安，那道可怖的声音又一次响了起来，将你们包围在中心。","style":3,"background":10000,"log_type":1,"src_id":160204067,"trial_step":67},{"step":68,"speaker":"“虚妄之人”","content":"因为她，因为所谓的爱！你才会迷茫，止步不前！","voice":["vo_trial_60204_1_31"],"voice_bank":"vo_enfer_trial","style":1,"background":10000,"log_type":1,"src_id":160204068,"trial_step":68},{"step":69,"speaker":"恩菲尔","content":"我是……因为她……她的救赎……她的爱……","voice":["vo_trial_60204_1_32"],"voice_bank":"vo_enfer_trial","style":1,"background":10000,"log_type":1,"src_id":160204069,"trial_step":69},{"step":70,"speaker":"恩菲尔","content":"才会软弱啊……","voice":["vo_trial_60204_1_33"],"voice_bank":"vo_enfer_trial","style":1,"background":10000,"log_type":1,"src_id":160204070,"trial_step":70},{"step":71,"speaker":"“虚妄之人”","content":"是的！！","voice":["vo_trial_60204_1_34"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204071,"trial_step":71},{"step":72,"speaker":"“虚妄之人”","content":"你见证过，你也一定能继承！","voice":["vo_trial_60204_1_35"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204072,"trial_step":72},{"step":73,"speaker":"“虚妄之人”","content":"只有纯粹的恐惧，人类的恐怖！你才能创造出最完美的作品！","voice":["vo_trial_60204_1_36"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204073,"trial_step":73},{"step":74,"speaker":"“虚妄之人”","content":"你不需要爱，你只需要恐惧……害怕……哭嚎！","voice":["vo_trial_60204_1_37"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204074,"trial_step":74},{"step":75,"speaker":"“虚妄之人”","content":"除掉她！砍碎她！放弃！遗忘！抛弃！","voice":["vo_trial_60204_1_38"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204075,"trial_step":75},{"step":76,"speaker":"“虚妄之人”","content":"你知道怎么做。","voice":["vo_trial_60204_1_39"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204076,"trial_step":76},{"step":77,"content":"脚下的黑暗开始翻涌，它们再次化作融化的液体，像沥青一样倾注。","style":3,"background":110,"log_type":1,"src_id":160204077,"trial_step":77},{"step":78,"content":"恩菲尔！不要听它的！！","style":2,"background":110,"log_type":1,"src_id":160204078,"trial_step":78},{"step":79,"content":"你发觉不对劲时，就开始朝恩菲尔跑去，可是不管怎么跑，你们之间的距离好像一点也没有缩短。","style":3,"background":110,"log_type":1,"src_id":160204079,"trial_step":79},{"step":80,"content":"这些记忆是深入你的意识之中的！你被给予的爱，被你深藏在自己的意识深处！","style":2,"background":110,"log_type":1,"src_id":160204080,"trial_step":80},{"step":81,"content":"你是真的想要抹除它们吗？！","style":2,"background":110,"log_type":1,"src_id":160204081,"trial_step":81},{"step":82,"content":"这个东西……所谓的抹除！！根本不是解决你迷茫和软弱的方法！这是逃避！不是面对！","style":2,"background":110,"log_type":1,"src_id":160204082,"trial_step":82},{"step":83,"speaker":"“虚妄之人”","content":"闭嘴……闭嘴闭嘴闭嘴闭嘴！！","voice":["vo_trial_60204_1_40"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204083,"trial_step":83},{"step":84,"speaker":"“虚妄之人”","content":"你……没有恐惧，没有真实！不配，不应该，不能存在在这里！","voice":["vo_trial_60204_1_41"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204084,"trial_step":84},{"step":85,"speaker":"“虚妄之人”","content":"离开她！离开我！离开她！离开我！","voice":["vo_trial_60204_1_42"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204085,"trial_step":85},{"step":86,"content":"你的话似乎惹恼了“虚妄之人”，它尖叫着，掀起了如海啸一般的黑色淤液朝你发起攻击！","style":3,"background":110,"log_type":1,"src_id":160204086,"trial_step":86},{"step":87,"content":"它们变成一道又一道尖刺，像无数黑色的錾子，叮叮作响，撕裂这个空间。","style":3,"background":110,"log_type":1,"src_id":160204087,"trial_step":87},{"step":88,"content":"你……你才应该离开这个地方！","style":2,"background":110,"log_type":1,"src_id":160204088,"trial_step":88},{"step":89,"content":"恩菲尔！这里是你的内心！是你的意识！","style":2,"background":110,"log_type":1,"src_id":160204089,"trial_step":89},{"step":90,"content":"你的一切力量不都来源于此吗！","style":2,"background":110,"log_type":1,"src_id":160204090,"trial_step":90},{"step":91,"speaker":"恩菲尔","content":"可是我的力量……被软弱束缚……","voice":["vo_trial_60204_1_43"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204091,"trial_step":91},{"step":92,"content":"别给我听他废话！","style":2,"background":110,"log_type":1,"src_id":160204092,"trial_step":92},{"step":93,"content":"纯粹的恐惧能让你获得巨大的力量前行，但他会让你与深渊同化，并不能让你渡过深渊。","style":2,"background":110,"log_type":1,"src_id":160204093,"trial_step":93},{"step":94,"content":"飞蛾的破茧，也并不是让自己变得更加纯粹——复杂的花纹，色彩，都是她的惊艳之处。","style":2,"background":110,"log_type":1,"src_id":160204094,"trial_step":94},{"step":95,"content":"至于你说的扑火——谁能保证，飞蛾扑向火焰时，心中只有恐惧？","style":2,"background":110,"log_type":1,"src_id":160204095,"trial_step":95},{"step":96,"content":"恩菲尔身形一震，转过身来，默默地看着你，眼中满是探求。","style":3,"background":110,"log_type":1,"src_id":160204096,"trial_step":96},{"step":97,"content":"说不定，她是因为爱着火焰，所以就算恐惧，也毅然飞向火焰？","style":2,"background":110,"log_type":1,"src_id":160204097,"trial_step":97},{"step":98,"speaker":"恩菲尔","content":"她……爱着火焰吗？","voice":["vo_trial_60204_1_44"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204098,"trial_step":98},{"step":99,"speaker":"恩菲尔","content":"她的力量里，不只是恐惧，还有爱，对吗？","voice":["vo_trial_60204_1_45"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204099,"trial_step":99},{"step":100,"content":"是的。","style":2,"background":110,"log_type":1,"src_id":160204100,"trial_step":100},{"step":101,"options":["不要逃避爱，恩菲尔。"],"style":6,"background":110,"log_type":1,"src_id":160204101,"trial_step":101,"course":3,"choices":[{"text":"不要逃避爱，恩菲尔。","goto":102}]},{"step":102,"content":"“虚妄之人”再次被激怒，它的喉咙呜咽着，就像乌云之中的闷雷。","style":3,"background":110,"log_type":1,"src_id":160204102,"trial_step":102},{"step":103,"content":"它操控着那些黑色的尖刺，一边将恩菲尔完全吞没，一边让它们直接变成了黑色的针雨，向你倾盆而来！","style":3,"background":110,"log_type":1,"src_id":160204103,"trial_step":103},{"step":104,"content":"啧……还是迟了一步吗……","style":2,"background":110,"log_type":1,"src_id":160204104,"trial_step":104},{"step":105,"content":"那我只能……放手一搏了。","style":2,"background":110,"log_type":1,"src_id":160204105,"trial_step":105},{"step":106,"content":"你转身，看着不远处被完全吞噬的恩菲尔，手上红色的枷锁如荆棘般延伸、生长。","style":3,"background":110,"log_type":1,"src_id":160204106,"trial_step":106},{"step":107,"content":"黑雨顺势而下——","style":3,"background":110,"log_type":1,"src_id":160204107,"trial_step":107},{"step":108,"speaker":"？？？","content":"停下吧，你还不配碰他。","female_content":"停下吧，你还不配碰她。","voice":["vo_trial_60204_1_46","vo_trial_60204_1_46f"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204108,"trial_step":108},{"step":109,"content":"黑色的针，停留在你眼前几厘米处，无法动弹。","style":3,"background":110,"log_type":1,"src_id":160204109,"trial_step":109},{"step":110,"content":"你看向枷锁，它明明还差一点，才能触碰到你的禁闭者。","style":3,"background":110,"log_type":1,"src_id":160204110,"trial_step":110},{"step":111,"speaker":"恩菲尔","content":"没错，这里是我的印记，是我的意识……","voice":["vo_trial_60204_1_47"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204111,"trial_step":111},{"step":112,"speaker":"恩菲尔","content":"这里的一切，都该臣服于我。","voice":["vo_trial_60204_1_48"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204112,"trial_step":112},{"step":113,"content":"黑暗中的色彩躁动不安，仿佛被莫大的恐惧追逐，想要逃开这个地方。","style":3,"background":110,"log_type":1,"src_id":160204113,"trial_step":113},{"step":114,"content":"你看到包裹着恩菲尔的黑色液体开始挣扎，明明每动一次，就要消耗巨大的力气，但它依旧不停歇——直到它的胸口处，渐渐出现一个小洞。","style":3,"background":110,"log_type":1,"src_id":160204114,"trial_step":114},{"step":115,"content":"不多时，一双修长的手从洞中伸出来，紧握住那骇人的黑色，狠狠地往两边一撕——","style":3,"background":110,"log_type":1,"src_id":160204115,"trial_step":115},{"step":116,"speaker":"恩菲尔","content":"就凭这个……也想困住我？","voice":["vo_trial_60204_1_49"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204116,"trial_step":116},{"step":117,"content":"那个蓝色的身影，从黑色的厚茧之中蜕出，高傲地抬着头，看着笼罩在自己意识世界的黑影。","style":3,"background":110,"log_type":1,"src_id":160204117,"trial_step":117},{"step":118,"content":"她的眼神，让你回想起了魔女之夜中，当着你的面，凿开地狱之门的人。","style":3,"background":110,"log_type":1,"src_id":160204118,"trial_step":118},{"step":119,"content":"孤傲，不可一世。","style":3,"background":110,"log_type":1,"src_id":160204119,"trial_step":119},{"step":120,"speaker":"恩菲尔","content":"抹除……亦或是埋藏自己的迷茫和软弱？","voice":["vo_trial_60204_1_50"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204120,"trial_step":120},{"step":121,"speaker":"恩菲尔","content":"呵，那只会变得和你一样，最终只能成为百年后就让人遗忘的雕像，永远地在黑暗的地下室中沉睡！","voice":["vo_trial_60204_1_51"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204121,"trial_step":121},{"step":122,"speaker":"恩菲尔","content":"最后……湮灭成灰。","voice":["vo_trial_60204_1_52"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204122,"trial_step":122},{"step":123,"content":"恩菲尔抬起手，握住了她的武器——蓝色的锤与錾。","style":3,"background":110,"log_type":1,"src_id":160204123,"trial_step":123},{"step":124,"content":"她一步步朝你走来，和你一起沐浴在黑色的针雨之下。","style":3,"background":110,"log_type":1,"src_id":160204124,"trial_step":124},{"step":125,"speaker":"恩菲尔","content":"你之所以……被我命名为虚妄，是因为你的一切，不过是自己的妄念，被自己的虚妄所困住。","voice":["vo_trial_60204_1_53"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204125,"trial_step":125},{"step":126,"speaker":"恩菲尔","content":"看不清真实的人，是你。","voice":["vo_trial_60204_1_54"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204126,"trial_step":126},{"step":127,"speaker":"“虚妄之人”","content":"不可能！不可能！她让你软弱，她把你留在了地狱！","voice":["vo_trial_60204_1_55"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204127,"trial_step":127},{"step":128,"speaker":"“虚妄之人”","content":"你一直都是这么想的！我知道！","voice":["vo_trial_60204_1_56"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204128,"trial_step":128},{"step":129,"content":"恩菲尔举起錾子，对着空中的一点，微笑起来。","style":3,"background":110,"log_type":1,"src_id":160204129,"trial_step":129},{"step":130,"speaker":"恩菲尔","content":"是，她让我不得不行走地狱……但我最喜欢的不就是……地狱吗？","voice":["vo_trial_60204_1_57"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204130,"trial_step":130},{"step":131,"speaker":"恩菲尔","content":"我……是你的见证者，但绝不是你的继承者。","voice":["vo_trial_60204_1_58"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204131,"trial_step":131},{"step":132,"speaker":"恩菲尔","content":"你惧怕爱，惧怕爱最后给你带来的地狱……所以才不愿面对。","voice":["vo_trial_60204_1_59"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204132,"trial_step":132},{"step":133,"speaker":"恩菲尔","content":"但我不一样。","voice":["vo_trial_60204_1_60"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204133,"trial_step":133},{"step":134,"content":"恩菲尔拿着蓝色的工具锤，狠狠地敲在錾上，空中的那一点发出一声巨响。","style":3,"background":110,"log_type":1,"src_id":160204134,"trial_step":134},{"step":135,"content":"黑色一点点剥落，露出了一个心形的印记，是恩菲尔所有的作品上，都有的印记。","style":3,"background":110,"log_type":1,"src_id":160204135,"trial_step":135},{"step":136,"speaker":"恩菲尔","content":"我是因为爱……才在这个犹如地狱一样的人间存活下来……","voice":["vo_trial_60204_1_61"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204136,"trial_step":136},{"step":137,"speaker":"恩菲尔","content":"而在这之中，也有人告诉过我……爱可以和恐怖一样，成为我的力量。","voice":["vo_trial_60204_1_62"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204137,"trial_step":137},{"step":138,"content":"恩菲尔走到你的身边，将你扶起，让你和她一起，握住了錾，对准那颗心形的印记。","style":3,"background":110,"log_type":1,"src_id":160204138,"trial_step":138},{"step":139,"speaker":"恩菲尔","content":"我是恐惧的支配者，所以我不会恐惧爱……我会凿穿它……让爱成为我力量的一部分，去不断地创作，撕裂，重生……","voice":["vo_trial_60204_1_63"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204139,"trial_step":139},{"step":140,"speaker":"恩菲尔","content":"直到成为最完美的作品。","voice":["vo_trial_60204_1_64"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204140,"trial_step":140},{"step":141,"content":"恩菲尔看着你，对你说道。","style":3,"background":110,"log_type":1,"src_id":160204141,"trial_step":141},{"step":142,"speaker":"恩菲尔","content":"释放枷锁吧，局长。","voice":["vo_trial_60204_1_65"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204142,"trial_step":142},{"step":143,"speaker":"恩菲尔","content":"我会与你一起破茧。","voice":["vo_trial_60204_1_66"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204143,"trial_step":143},{"step":144,"content":"红色与蓝色的光芒覆盖所有的意识，黑暗被它们吞没，消失无踪。","style":3,"background":10006,"log_type":1,"src_id":160204145,"trial_step":145},{"step":145,"content":"在光芒下，你看到一只鲜艳的，蓝色的飞蛾，从黑色的茧中挣扎着飞出。","style":3,"background":10006,"log_type":1,"src_id":160204146,"trial_step":146},{"step":146,"content":"它的翅膀，带着火光，翩跹飞向远方。","style":3,"background":10006,"log_type":1,"src_id":160204147,"trial_step":147},{"step":147,"content":"远方或许是地狱，但……她一定不再只有恐惧傍身。","style":3,"background":10006,"log_type":1,"src_id":160204148,"trial_step":148}]}