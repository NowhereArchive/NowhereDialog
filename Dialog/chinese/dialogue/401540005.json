{"id":401540005,"chapter_id":50045,"scene_id":45017,"steps":[{"step":1,"speaker":"艾可","content":"~~~~","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":2,"speaker":"艾可","content":"“留不住的琼楼玉宇 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":3,"speaker":"艾可","content":"“所有人的未来凄凄 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":4,"speaker":"艾可","content":"“我想要半熟的和牛五成许。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":5,"speaker":"艾可","content":"“谁想吃干瘪的面包像墙皮 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":6,"speaker":"艾可","content":"“我需要闪耀的金冠和朱玉 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":7,"speaker":"艾可","content":"“来配我高贵的脑袋和身体 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":8,"speaker":"艾可","content":"“亲爱的女士我请求你应许。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":9,"speaker":"艾可","content":"“福尔图娜需要她的主事女 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":10,"speaker":"艾可","content":"“金发女士实现你的愿景 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":11,"speaker":"艾可","content":"“你的请求是她唯一目的 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":12,"speaker":"艾可","content":"“福尔图娜，福尔图娜 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":13,"speaker":"艾可","content":"“嗅到贪婪的魔鬼会侵袭 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":14,"speaker":"艾可","content":"“福尔图娜，福尔图娜 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":15,"speaker":"艾可","content":"“下个故事始于付之一炬 。”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":16,"speaker":"艾可","content":"~~~~","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":17,"speaker":"艾可","content":"“金发女士将王冠拾起。 ”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":18,"speaker":"艾可","content":"“她在包厢中稍作休息。 ”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":19,"speaker":"艾可","content":"“大火是完美的谢幕曲。 ”","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":20,"speaker":"艾可","content":"“欢迎再来福尔图娜，我等你。”","style":1,"background":2173,"is_centered":true,"log_type":1}]}