{"id":402901042,"chapter_id":70045,"scene_id":74505,"steps":[{"step":2,"speaker":"海拉","content":"——看招！","voice":["vo_event_402901042_01"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":3,"content":"海拉抄着钢管狠狠击中面前砂盗的枪把，顺势再抡到这人脸上。","style":3,"background":2290,"log_type":1},{"step":4,"speaker":"海拉","content":"漂亮！海拉再得一分！","voice":["vo_event_402901042_03"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":5,"content":"砂盗捂着鼻子后退两步，稳住身体，恼羞成怒。","style":3,"background":2290,"log_type":1},{"step":6,"speaker":"砂盗首领","content":"*文明砂海*……真是敬酒不吃吃罚酒……兄弟们，给我上家伙！","voice":["vo_event_402901042_05"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":7,"content":"三架火炮从人群后方同时架起，直指海拉的方向。","style":3,"background":2290,"log_type":1},{"step":8,"speaker":"海拉","content":"……我……*文明狄斯*……","voice":["vo_event_402901042_08"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":9,"speaker":"砂盗首领","content":"这可是从狄斯那里抢来的好东西，只要三发炮弹，就能把你们这个破地方轰得连渣都不剩……","voice":["vo_event_402901042_09"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":10,"speaker":"海拉","content":"臭不要脸！","voice":["vo_event_402901042_10"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":11,"speaker":"砂盗首领","content":"哈哈！在砂海，弱小才是原罪！","voice":["vo_event_402901042_11"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":12,"speaker":"砂盗首领","content":"小鬼头，有时间跟我拌嘴，不如看看你的“同伴”们吧。","voice":["vo_event_402901042_12"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":13,"content":"海拉惊觉不对劲，转头发现镇民已经被砂盗包围。","style":3,"background":2290,"log_type":1},{"step":14,"speaker":"砂盗首领","content":"现在，再来选选吧——是想当枪下亡魂，还是把异方晶交出来，然后死个痛快呢？","voice":["vo_event_402901042_14"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":15,"speaker":"海拉","content":"投降？呵呵，放*文明狄斯*屁！","voice":["vo_event_402901042_16"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":16,"content":"砂盗的威胁并不起效，少女上前一步站在人群正前方，用身体拦住后方的镇民。","style":3,"background":2290,"log_type":1},{"step":17,"content":"她讨厌无怨无故的栽赃，更讨厌仗势欺人的混账。她可不在乎砂盗抢来的异方晶又被谁偷了，只想用钢管狠狠把他们都揍开花。","style":3,"background":2290,"log_type":1},{"step":18,"content":"更何况，她不是一个人在战斗。","style":3,"background":2290,"log_type":1},{"step":19,"speaker":"海拉","content":"谁说我要一个人干架了——两个禁闭者对付一帮你们臭鱼烂虾，轻轻松松！","voice":["vo_event_402901042_17"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":20,"content":"砂盗出人意料地愣了下，几秒后似乎反应过来什么，大笑出声。","style":3,"background":2290,"log_type":1},{"step":21,"speaker":"砂盗首领","content":"呵……哈哈哈哈哈行啊，我明白了，原来是这样……","voice":["vo_event_402901042_19"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":22,"speaker":"砂盗首领","content":"不是喊冤吗？没错，我们确实不是什么好人，但那个拿枪的家伙……她的异方晶来源也未必干净。","voice":["vo_event_402901042_20"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":23,"speaker":"海拉","content":"*文明狄斯*！你什么意思，打不过就泼脏水是吧！我告诉你挑拨离间这招在我们这可不管用——","voice":["vo_event_402901042_21"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":24,"speaker":"海拉","content":"——是吧！柯琳！","voice":["vo_event_402901042_22"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":25,"speaker":"海拉","content":"……？","voice":["vo_event_402901042_06"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":26,"content":"海拉猛然转头，准确地在人群后方找到柯琳——这位“可靠的战友”正一条腿跨在墙上，鬼鬼祟祟地准备翻墙过去。","style":3,"background":2290,"log_type":1},{"step":27,"content":"柯琳僵着身子一点点转头，正好和海拉对上视线。","style":3,"background":2290,"log_type":1},{"step":28,"speaker":"海拉","content":"…………你在干嘛？","voice":["vo_event_402901042_24"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":29,"speaker":"海拉","content":"敌人在这边，你往哪儿走呢……？","voice":["vo_event_402901042_25"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":30,"speaker":"柯琳","content":"啊哈哈哈……真快啊，你们这就聊完了？","voice":["vo_event_402901042_26"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":31,"speaker":"柯琳","content":"不着急啊，你们慢慢聊——海拉宝贝刚刚超帅气，加油挺住！图科镇就交给你啦！","voice":["vo_event_402901042_27"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":32,"speaker":"柯琳","content":"我先去办点别的要紧事儿，去去就回~","voice":["vo_event_402901042_28"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":33,"content":"女人抛了个飞吻，下一秒轻巧翻过墙头，彻底消失。","style":3,"background":2290,"log_type":1},{"step":34,"content":"战场上现在只留一群凶神恶煞的砂盗，还有一个目瞪口呆的海拉。","style":3,"background":2290,"log_type":1},{"step":35,"speaker":"砂盗首领","content":"哈！这下就只剩一个挡路的……给我炮口瞄准了，准备开火！","voice":["vo_event_402901042_30"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1},{"step":36,"speaker":"海拉","content":"……","style":1,"background":2290,"log_type":1},{"step":37,"speaker":"海拉","content":"…………","style":1,"background":2290,"log_type":1},{"step":38,"speaker":"海拉","content":"……………………你个大骗子！！！！","voice":["vo_event_402901042_33"],"voice_bank":"vo_event_29104","style":1,"background":2290,"log_type":1}]}