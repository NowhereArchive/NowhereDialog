type":1,"src_id":120404068,"trial_step":68},{"step":69,"content":"负责人憋着一口气，阴狠地质问道：","style":3,"background":1038,"log_type":1,"src_id":120404069,"trial_step":69},{"step":70,"speaker":"N.F. 115/7/26 20:00","content":"你们是怎么找到这个的……","voice":["vo_trial_20404_1_70"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404070,"trial_step":70},{"step":71,"content":"唐两手一摊。","style":3,"background":1038,"log_type":1,"src_id":120404071,"trial_step":71},{"step":72,"speaker":"唐","content":"这你就别管了。","voice":["vo_trial_20404_1_72"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404072,"trial_step":72},{"step":73,"speaker":"唐","content":"总之这些影像在我们手里。除此之外，我们还有其他途径的证据，足够证明你们四院是一所泯灭人性、有悖人伦的魔鬼医院了。","voice":["vo_trial_20404_1_73"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404073,"trial_step":73},{"step":74,"speaker":"唐","content":"如果不想被曝光出去的话，就乖乖答应我们的条件……","voice":["vo_trial_20404_1_74"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404074,"trial_step":74},{"step":75,"speaker":"琼斯","content":"你们休想！","voice":["vo_trial_20404_1_75"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404075,"trial_step":75},{"step":76,"speaker":"琼斯","content":"班彦四院……涅槃不吃这一套。这种所谓的证据威胁不到我们。","voice":["vo_trial_20404_1_76"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404076,"trial_step":76},{"step":77,"content":"……还在嘴硬呢。","style":2,"background":1038,"log_type":1,"src_id":120404077,"trial_step":77},{"step":78,"content":"你装作无奈地看了唐一眼，两人一唱一和地摇着头，顺带叹了一口气。","style":3,"background":1038,"log_type":1,"src_id":120404078,"trial_step":78},{"step":79,"content":"要是在半年前，这么说倒是没问题。","style":2,"background":1038,"log_type":1,"src_id":120404079,"trial_step":79},{"step":80,"content":"但你也不看看如今新城的局势？","style":2,"background":1038,"log_type":1,"src_id":120404080,"trial_step":80},{"step":81,"content":"唐接过了你的话茬。","style":3,"background":1038,"log_type":1,"src_id":120404081,"trial_step":81},{"step":82,"speaker":"唐","content":"那些政客商人都忙着和我们西区谈生意讲合作呢……生怕态度不够坚决舆论声音不够大。","voice":["vo_trial_20404_1_82"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404082,"trial_step":82},{"step":83,"speaker":"唐","content":"然后你们这个地下实验室还在搞那老一套的玩意儿，又是人体实验，又是抓西区的人虐待……这要是被捅出去，政客们可有得作秀了。","voice":["vo_trial_20404_1_83"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404083,"trial_step":83},{"step":84,"speaker":"琼斯","content":"……","voice":["vo_trial_20404_1_84"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404084,"trial_step":84},{"step":85,"speaker":"唐","content":"考虑考虑吧，没资格拒绝的可是你们哦。","voice":["vo_trial_20404_1_85"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404085,"trial_step":85},{"step":86,"content":"负责人沉默了。","style":3,"background":1038,"log_type":1,"src_id":120404086,"trial_step":86},{"step":87,"content":"他思考了半天，终于憋出了几个字：","style":3,"background":1038,"log_type":1,"src_id":120404087,"trial_step":87},{"step":88,"speaker":"琼斯","content":"我的权限不够……我需要咨询院长。","voice":["vo_trial_20404_1_88"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404088,"trial_step":88},{"step":89,"speaker":"唐","content":"早说你做不了主嘛，还省得跟你这个喽啰费这些口舌。","voice":["vo_trial_20404_1_89"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404089,"trial_step":89},{"step":90,"speaker":"琼斯","content":"……","voice":["vo_trial_20404_1_90"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404090,"trial_step":90},{"step":91,"content":"负责人无视了唐的揶揄，拨通桌上的固定电话，在短暂的等待之后，电话那边传来一阵陌生的声音。","style":3,"background":1038,"log_type":1,"src_id":120404091,"trial_step":91},{"step":92,"speaker":"院长","content":"什么事。","style":11,"background":1038,"log_type":1,"src_id":120404092,"trial_step":92},{"step":93,"speaker":"琼斯","content":"院长，MBCC的局长……还有之前那个锈火的通缉犯来找了。","voice":["vo_trial_20404_1_93"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404093,"trial_step":93},{"step":94,"speaker":"琼斯","content":"他们企图勒索四院，要求我们那个新来的西区病人办理转院手续。","voice":["vo_trial_20404_1_94"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404094,"trial_step":94},{"step":95,"speaker":"院长","content":"转院？呵呵……","style":11,"background":1038,"log_type":1,"src_id":120404095,"trial_step":95},{"step":96,"content":"电话那头传来玩味的笑声。","style":3,"background":1038,"log_type":1,"src_id":120404096,"trial_step":96},{"step":97,"speaker":"院长","content":"转去哪里？","style":11,"background":1038,"log_type":1,"src_id":120404097,"trial_step":97},{"step":98,"speaker":"院长","content":"如果我没记错的话，那位玛格丽女士应该是罹患狂厄造成的精神衰弱和阿尔兹海默症，对吧？","style":11,"background":1038,"log_type":1,"src_id":120404098,"trial_step":98},{"step":99,"speaker":"院长","content":"班彦四院是狄斯城最好的精神专科医院。你们就这么简单想把她转走，是在质疑我院的实力么？这对班彦的名声可不太好。","style":11,"background":1038,"log_type":1,"src_id":120404099,"trial_step":99},{"step":100,"content":"院长这一通话，说明了她的态度。","style":3,"background":1038,"log_type":1,"src_id":120404100,"trial_step":100},{"step":101,"content":"你清了清嗓子，提出了早已准备好的“解决方案”。","style":3,"background":1038,"log_type":1,"src_id":120404101,"trial_step":101},{"step":102,"content":"院长阁下，既然你们如此顾及“脸面”，倒不如在西区开个分院好了？","style":2,"background":1038,"log_type":1,"src_id":120404102,"trial_step":102},{"step":103,"content":"正好西区现在面临着狂厄问题，您可以和MBCC合作，以四院的名义开设一家全新的医院。","style":2,"background":1038,"log_type":1,"src_id":120404103,"trial_step":103},{"step":104,"content":"我们可以整合西区现有的医疗资源，包括大名鼎鼎的彼岸诊所，为西区人民创造福祉……","style":2,"background":1038,"log_type":1,"src_id":120404104,"trial_step":104},{"step":105,"content":"新分院的负责人我都想好了，就让达斯医生去吧。您看，也是你们四院的人，够诚意了吧？","style":2,"background":1038,"log_type":1,"src_id":120404105,"trial_step":105},{"step":106,"content":"您甚至可以把新城这边问题比较严重的病人也转移过去，还顺带提高了你院的治愈率……","style":2,"background":1038,"log_type":1,"src_id":120404106,"trial_step":106},{"step":107,"speaker":"院长","content":"嗯……","style":11,"background":1038,"log_type":1,"src_id":120404107,"trial_step":107},{"step":108,"content":"院长阁下，您意下如何？","style":2,"background":1038,"log_type":1,"src_id":120404108,"trial_step":108},{"step":109,"content":"然而，回答的不是院长，而是抢话的执行负责人。","style":3,"background":1038,"log_type":1,"src_id":120404109,"trial_step":109},{"step":110,"speaker":"琼斯","content":"你的意思是要我们出钱出力，还把四院的财产……病人转移过去？！","voice":["vo_trial_20404_1_110"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404110,"trial_step":110},{"step":111,"content":"是的，同时还请你们关停四院现在的地下实验室。","style":2,"background":1038,"log_type":1,"src_id":120404111,"trial_step":111},{"step":112,"speaker":"琼斯","content":"那四院岂不是一点好处都得不到？！","voice":["vo_trial_20404_1_112"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404112,"trial_step":112},{"step":113,"content":"好名声，还不够么？","style":2,"background":1038,"log_type":1,"src_id":120404113,"trial_step":113},{"step":114,"content":"非要说的话，四院过去做的那些龌龊事，我也可以暂时装作看不见。您觉得怎么样？","style":2,"background":1038,"log_type":1,"src_id":120404114,"trial_step":114},{"step":115,"content":"电话那边陷入了沉默。","style":3,"background":1038,"log_type":1,"src_id":120404115,"trial_step":115},{"step":116,"content":"良久之后，你听到了两个字的回答。","style":3,"background":1038,"log_type":1,"src_id":120404116,"trial_step":116},{"step":117,"speaker":"院长","content":"成交。","style":11,"background":1038,"log_type":1,"src_id":120404117,"trial_step":117},{"step":118,"speaker":"琼斯","content":"院长，这……","voice":["vo_trial_20404_1_118"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404118,"trial_step":118},{"step":119,"speaker":"院长","content":"按他们要求的做。","style":11,"background":1038,"log_type":1,"src_id":120404119,"trial_step":119},{"step":120,"content":"院长不容置疑的声音打断了负责人的小小抗议。","style":3,"background":1038,"log_type":1,"src_id":120404120,"trial_step":120},{"step":121,"speaker":"院长","content":"MBCC的局长，呵呵……","style":11,"background":1038,"log_type":1,"src_id":120404121,"trial_step":121},{"step":122,"speaker":"院长","content":"期待和你正式见面的一天。","style":11,"background":1038,"log_type":1,"src_id":120404122,"trial_step":122},{"step":123,"content":"█月25日 18:20 西区班彦分院正门前","style":9,"background":102,"log_type":1,"src_id":120404123,"trial_step":123},{"step":124,"speaker":"唐","content":"倒，倒，倒，OK，停！","voice":["vo_trial_20404_1_124"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404124,"trial_step":124},{"step":125,"speaker":"唐","content":"手脚轻点，这些仪器价格可不便宜……说的就是你！","voice":["vo_trial_20404_1_125"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404125,"trial_step":125},{"step":126,"content":"唐指挥着搬运工将新到的医疗器械从货车上卸下，接着便是安排一楼的医院工作人员查收。","style":3,"background":102,"log_type":1,"src_id":120404126,"trial_step":126},{"step":127,"content":"在做完这一切之后，唐擦了擦额角的汗珠，终于察觉到了你的存在。","style":3,"background":102,"log_type":1,"src_id":120404127,"trial_step":127},{"step":128,"speaker":"唐","content":"哟，今天怎么有空来的？","voice":["vo_trial_20404_1_128"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404128,"trial_step":128},{"step":129,"content":"来看看医院的进度。","style":2,"background":102,"log_type":1,"src_id":120404129,"trial_step":129},{"step":130,"speaker":"唐","content":"不用担心，顺利得很。","voice":["vo_trial_20404_1_130"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404130,"trial_step":130},{"step":131,"speaker":"唐","content":"前两天我去了一趟卫星城，从那边搞来了一批新型号治疗器械，想必也能减轻一点达斯他们的负担……","voice":["vo_trial_20404_1_131"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404131,"trial_step":131},{"step":132,"content":"唐伸了一个懒腰。","style":3,"background":102,"log_type":1,"src_id":120404132,"trial_step":132},{"step":133,"speaker":"唐","content":"嗨呀……等忙完这一阵，医院这边的事差不多也就算告一段落了。","voice":["vo_trial_20404_1_133"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404133,"trial_step":133},{"step":134,"content":"那你是不是该休息一段时间了？","style":2,"background":102,"log_type":1,"src_id":120404134,"trial_step":134},{"step":135,"speaker":"唐","content":"休息什么呀，卫星城和外邦那边还有一大堆的事情等着我去做呢……","voice":["vo_trial_20404_1_135"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404135,"trial_step":135},{"step":136,"speaker":"唐","content":"像我们这种人，天生就是劳碌命，闲不住的。","voice":["vo_trial_20404_1_136"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404136,"trial_step":136},{"step":137,"speaker":"唐","content":"好在……这些努力都是值得的。","voice":["vo_trial_20404_1_137"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404137,"trial_step":137},{"step":138,"content":"夕阳的余晖下，医院门前劳作的工人，远处还在运作的起重机……万事万物都被镀上一层金红色。","style":3,"background":102,"log_type":1,"src_id":120404138,"trial_step":138},{"step":139,"content":"是啊……","style":2,"background":102,"log_type":1,"src_id":120404139,"trial_step":139},{"step":140,"content":"这段时间真是辛苦你了，“大英雄”。","style":2,"background":102,"log_type":1,"src_id":120404140,"trial_step":140},{"step":141,"speaker":"唐","content":"可别大英雄了，这名号我承受不起。","voice":["vo_trial_20404_1_141"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404141,"trial_step":141},{"step":142,"content":"唐连连摆手。","style":3,"background":102,"log_type":1,"src_id":120404142,"trial_step":142},{"step":143,"speaker":"唐","content":"真要给西区的英雄们论资排辈，也轮不到我。","voice":["vo_trial_20404_1_143"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404143,"trial_step":143},{"step":144,"speaker":"唐","content":"我就一小老百姓，犯过错，也倒过霉。靠着运气好活到了现在……如今就是尽自己能尽的一份力，发挥点余热罢了。","voice":["vo_trial_20404_1_144"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404144,"trial_step":144},{"step":145,"content":"……还怪煽情的。","style":2,"background":102,"log_type":1,"src_id":120404145,"trial_step":145},{"step":146,"speaker":"唐","content":"都是真情实感好吧。","voice":["vo_trial_20404_1_146"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404146,"trial_step":146},{"step":147,"speaker":"唐","content":"我现在每天想的就是怎么再给西区多认识几个“朋友”，谈判的时候多争取些利益……","voice":["vo_trial_20404_1_147"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404147,"trial_step":147},{"step":148,"speaker":"唐","content":"想想也真有意思：搁十年前我哪儿懂这些啊，成天就只会打架惹事，上头了还会带着一群人一起犯蠢。","voice":["vo_trial_20404_1_148"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404148,"trial_step":148},{"step":149,"speaker":"唐","content":"如今西区百废待兴，哪哪儿都缺人……还能怎么办呢，赶鸭子上架，硬着头皮学呗。","voice":["vo_trial_20404_1_149"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404149,"trial_step":149},{"step":150,"speaker":"唐","content":"这种时候就特别怀念于连这小子……明明现在的西区，是最适合他那样的聪明人的……","voice":["vo_trial_20404_1_150"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404150,"trial_step":150},{"step":151,"content":"……","style":2,"background":102,"log_type":1,"src_id":120404151,"trial_step":151},{"step":152,"speaker":"唐","content":"唉，不说这些了。差点把正事儿忘了。","voice":["vo_trial_20404_1_152"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404152,"trial_step":152},{"step":153,"content":"唐跳上货车，从车厢里翻出来一束花。","style":3,"background":102,"log_type":1,"src_id":120404153,"trial_step":153},{"step":154,"content":"这就是你说的正事儿？看上哪个小姑娘了？","style":2,"background":102,"log_type":1,"src_id":120404154,"trial_step":154},{"step":155,"speaker":"唐","content":"都什么跟什么啊？","voice":["vo_trial_20404_1_155"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404155,"trial_step":155},{"step":156,"content":"唐有些不满地抱怨着。","style":3,"background":102,"log_type":1,"src_id":120404156,"trial_step":156},{"step":157,"speaker":"唐","content":"今天是玛格丽……我姨妈出院的日子！","voice":["vo_trial_20404_1_157"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404157,"trial_step":157},{"step":158,"content":"唐理了理头发，凑到你跟前问道：","style":3,"background":102,"log_type":1,"src_id":120404158,"trial_step":158},{"step":159,"speaker":"唐","content":"怎么样？","voice":["vo_trial_20404_1_159"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404159,"trial_step":159},{"step":160,"content":"什么怎么样？","style":2,"background":102,"log_type":1,"src_id":120404160,"trial_step":160},{"step":161,"speaker":"唐","content":"我是问你，我现在看上去怎么样，帅不帅？","voice":["vo_trial_20404_1_161"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404161,"trial_step":161},{"step":162,"content":"没看出和平时有什么区别……","style":2,"background":102,"log_type":1,"src_id":120404162,"trial_step":162},{"step":163,"speaker":"唐","content":"怎么这样？我还特意去做了个发型呢，这钱不白花了么？","voice":["vo_trial_20404_1_163"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404163,"trial_step":163},{"step":164,"content":"看着唐有些懊恼的表情，你忍不住笑了笑。","style":3,"background":102,"log_type":1,"src_id":120404164,"trial_step":164},{"step":165,"speaker":"唐","content":"靠，幸灾乐祸是吧？","voice":["vo_trial_20404_1_165"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404165,"trial_step":165},{"step":166,"content":"没有，就是好奇你怎么突然想起来做发型的？这可不像你的风格。","style":2,"background":102,"log_type":1,"src_id":120404166,"trial_step":166},{"step":167,"speaker":"唐","content":"还不是为了我的好姨妈么？","voice":["vo_trial_20404_1_167"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404167,"trial_step":167},{"step":168,"speaker":"唐","content":"你想啊，上次我见到玛格丽的时候，她还记不起我是谁……","voice":["vo_trial_20404_1_168"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404168,"trial_step":168},{"step":169,"speaker":"那么，为了庆祝正义一方的伟大胜利，以及那些即将被彻底曝光的混球恶棍们——干杯！","content":"那从她的角度讲，今天不就是阔别十年的重逢吗？","voice":["vo_trial_20404_1_169"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404169,"trial_step":169},{"step":170,"speaker":"唐","content":"我一个做外甥的，不得重视起来，给老人家一个好印象么……","voice":["vo_trial_20404_1_170"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404170,"trial_step":170},{"step":171,"speaker":"玛格丽","content":"臭小子，又在背后编排我什么呢？","voice":["vo_trial_20404_1_171"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404171,"trial_step":171},{"step":172,"content":"听到身后传来苍老又慈祥的声音，唐一个激灵站直了身体。","style":3,"background":102,"log_type":1,"src_id":120404172,"trial_step":172},{"step":173,"content":"过了一会儿，他下定决心，缓缓转过身，脸上满是少年般羞赧青涩的笑容。","style":3,"background":102,"log_type":1,"src_id":120404173,"trial_step":173},{"step":174,"speaker":"唐","content":"姨妈……","voice":["vo_trial_20404_1_174"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404174,"trial_step":174},{"step":175,"speaker":"玛格丽","content":"你还知道我是你姨妈啊？","voice":["vo_trial_20404_1_175"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404175,"trial_step":175},{"step":176,"content":"老人家颤颤巍巍地走过来，拐杖轻轻地打在唐的身上。","style":3,"background":102,"log_type":1,"src_id":120404176,"trial_step":176},{"step":177,"speaker":"玛格丽","content":"这些年我左等右等见不着你人影，你这臭小子究竟去哪儿了？","voice":["vo_trial_20404_1_177"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404177,"trial_step":177},{"step":178,"speaker":"唐","content":"我……我……","voice":["vo_trial_20404_1_178"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404178,"trial_step":178},{"step":179,"content":"唐张开嘴，想要回答老人家的问题。明明他早就准备好了一整套说辞和借口，可临了大脑却一片空白，说不出半个字。","style":3,"background":102,"log_type":1,"src_id":120404179,"trial_step":179},{"step":180,"content":"眼泪不知何时已经盈满了眼眶。","style":3,"background":102,"log_type":1,"src_id":120404180,"trial_step":180},{"step":181,"speaker":"唐","content":"对不起……","voice":["vo_trial_20404_1_181"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404181,"trial_step":181},{"step":182,"speaker":"玛格丽","content":"哎呦道什么歉啊？怎么还哭了？你看看你，也老大不小的了……","voice":["vo_trial_20404_1_182"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404182,"trial_step":182},{"step":183,"content":"老人家走上前，轻轻抱住了自己的外甥。","style":3,"background":102,"log_type":1,"src_id":120404183,"trial_step":183},{"step":184,"speaker":"玛格丽","content":"哎呀算了算了，你小子以前就这样，遇到什么事也不愿意跟人说……这些年一定受了不少委屈吧。","voice":["vo_trial_20404_1_184"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404184,"trial_step":184},{"step":185,"speaker":"玛格丽","content":"回来了就好，回来了就好……","voice":["vo_trial_20404_1_185"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120404185,"trial_step":185}]}