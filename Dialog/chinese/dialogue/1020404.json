{"id":1020404,"chapter_id":1020404,"scene_id":1,"steps":[{"step":1,"content":"█月16日，15:12，班彦四院主任医师办公室。","style":9,"background":1038,"log_type":1,"src_id":120404001,"trial_step":1},{"step":2,"content":"在那位巨汉护士的带领下，你和唐进入了一间陌生的办公室。","style":3,"background":1038,"log_type":1,"src_id":120404002,"trial_step":2},{"step":3,"speaker":"？？","content":"请坐吧。","voice":["vo_trial_20404_1_3"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404003,"trial_step":3},{"step":4,"speaker":"？？","content":"院长平日里负责管辖的不只是四院，还包括一院二院和班彦医学院，实在是抽不出身……","voice":["vo_trial_20404_1_4"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404004,"trial_step":4},{"step":5,"speaker":"？？","content":"所以这次由我来接待您。","voice":["vo_trial_20404_1_5"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404005,"trial_step":5},{"step":6,"speaker":"？？","content":"自我介绍一下，我是四院的执行负责人琼斯。","voice":["vo_trial_20404_1_6"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404006,"trial_step":6},{"step":7,"speaker":"琼斯","content":"不知MBCC的局长阁下特意来访，所为何事呢？","voice":["vo_trial_20404_1_7"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404007,"trial_step":7},{"step":8,"content":"这位四院的负责人此刻双手交叉，坐姿松弛，脸上还挂着轻松惬意的笑容，显然没有预料到你接下来将会说什么。","style":3,"background":1038,"log_type":1,"src_id":120404008,"trial_step":8},{"step":9,"options":["我是来谈判的。"],"style":6,"background":1038,"log_type":1,"src_id":120404009,"trial_step":9,"course":3,"choices":[{"text":"我是来谈判的。","goto":10}]},{"step":10,"speaker":"琼斯","content":"谈判？","voice":["vo_trial_20404_1_10"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404010,"trial_step":10},{"step":11,"content":"你省去了一切客套和遮掩。这令琼斯有些始料未及。","style":3,"background":1038,"log_type":1,"src_id":120404011,"trial_step":11},{"step":12,"speaker":"琼斯","content":"我不明白您在说什么……","voice":["vo_trial_20404_1_12"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404012,"trial_step":12},{"step":13,"speaker":"唐","content":"别装蒜。你也知道我们来这里是干什么的。","voice":["vo_trial_20404_1_13"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404013,"trial_step":13},{"step":14,"speaker":"唐","content":"把玛格丽交出来，给她办理转院手续，麻溜的，别浪费时间。","voice":["vo_trial_20404_1_14"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404014,"trial_step":14},{"step":15,"speaker":"琼斯","content":"玛格丽是么……呵呵……","voice":["vo_trial_20404_1_15"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404015,"trial_step":15},{"step":16,"content":"琼斯摘下眼镜擦了擦。","style":3,"background":1038,"log_type":1,"src_id":120404016,"trial_step":16},{"step":17,"speaker":"琼斯","content":"哈哈，局长阁下，你要不要听一听你的这位禁闭者手下在说什么？","voice":["vo_trial_20404_1_17"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404017,"trial_step":17},{"step":18,"speaker":"琼斯","content":"你最好认清自己的身份，西区人。一个涅槃的通缉犯，居然敢大摇大摆走进班彦四院，和我谈条件？","voice":["vo_trial_20404_1_18"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404018,"trial_step":18},{"step":19,"content":"他的意思就是我的意思。","style":2,"background":1038,"log_type":1,"src_id":120404019,"trial_step":19},{"step":20,"speaker":"琼斯","content":"……","voice":["vo_trial_20404_1_20"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404020,"trial_step":20},{"step":21,"content":"这位负责人紧紧盯着你们二人，在片刻的沉默后，突然放声大笑起来。","style":3,"background":1038,"log_type":1,"src_id":120404021,"trial_step":21},{"step":22,"speaker":"琼斯","content":"……哈哈哈哈。","voice":["vo_trial_20404_1_22"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404022,"trial_step":22},{"step":23,"content":"琼斯夸张地抹了抹眼角，仿佛真的听到了一个天大的笑话。","style":3,"background":1038,"log_type":1,"src_id":120404023,"trial_step":23},{"step":24,"speaker":"琼斯","content":"老实说吧，玛格丽的确在我们这儿……","voice":["vo_trial_20404_1_24"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404024,"trial_step":24},{"step":25,"speaker":"琼斯","content":"但你们凭什么觉得有资格和我谈条件？！","voice":["vo_trial_20404_1_25"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404025,"trial_step":25},{"step":26,"content":"身后，那位巨汉护士向前挪了一步，面露凶光。","style":3,"background":1038,"log_type":1,"src_id":120404026,"trial_step":26},{"step":27,"speaker":"琼斯","content":"想带走玛格丽，可以，但这个人必须留下……","voice":["vo_trial_20404_1_27"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404027,"trial_step":27},{"step":28,"speaker":"琼斯","content":"想必你们也知道他身上背了多高的悬赏，涅槃会很高兴的……","voice":["vo_trial_20404_1_28"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404028,"trial_step":28},{"step":29,"speaker":"唐","content":"嘿嘿，抱歉哈，我可不想再回你们这个鬼地方了。","voice":["vo_trial_20404_1_29"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404029,"trial_step":29},{"step":30,"speaker":"琼斯","content":"从踏入四院的那一刻起，事态就不归你们控制了。","voice":["vo_trial_20404_1_30"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404030,"trial_step":30},{"step":31,"speaker":"琼斯","content":"上次是达斯把你们来过的消息瞒了下来，这次可就没这么好运了。","voice":["vo_trial_20404_1_31"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404031,"trial_step":31},{"step":32,"content":"听到这番话，唐后退一步躲到了你身后。","style":3,"background":1038,"log_type":1,"src_id":120404032,"trial_step":32},{"step":33,"speaker":"唐","content":"怎么，你们四院想对MBCC的局长动手？","voice":["vo_trial_20404_1_33"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404033,"trial_step":33},{"step":34,"speaker":"琼斯","content":"这倒没有。以你们局长如今的身份，谁敢动他呢？","female_content":"这倒没有。以你们局长如今的身份，谁敢动她呢？","voice":["vo_trial_20404_1_34","vo_trial_20404_1_34f"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404034,"trial_step":34}