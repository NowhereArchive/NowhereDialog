{"id":1031302,"chapter_id":1031302,"scene_id":1,"steps":[{"step":1,"content":"【死恋电台页面】","style":18,"background":10000,"log_type":1,"src_id":131302001,"trial_step":1},{"step":2,"speaker":"洛芙","content":"听说了吗听说了吗？小黛丝，我的乐子人雷达在狂响——前·超级偶像法露儿，要在管理局开直播了！","style":11,"background":2034,"log_type":1,"src_id":131302003,"trial_step":3},{"step":3,"speaker":"小黛丝","content":"略有耳闻，是顶不住舆论压力没招了？还是说在管理局还要粉丝们爆米？","style":11,"background":2034,"log_type":1,"src_id":131302004,"trial_step":4},{"step":4,"speaker":"洛芙","content":"全网都在盯着呢！到底是受害者还是白莲花？洗白还是翻车？这乐子我能吃一年！","style":11,"background":2034,"log_type":1,"src_id":131302005,"trial_step":5},{"step":5,"speaker":"小黛丝","content":"你高兴得太早了。管理局那种地方免费让你看？不是作秀就是钓鱼。到时候直播到一半，画面啪一下切成——“该内容因技术原因无法播放”。","style":11,"background":2034,"log_type":1,"src_id":131302006,"trial_step":6},{"step":6,"speaker":"洛芙","content":"有乐子不看白不看！反正他们敢播我就敢看——我还要开专栏，全程reaction，标题就叫《前偶像直播洗白？乐子人鉴定实录》！","style":11,"background":2034,"log_type":1,"src_id":131302007,"trial_step":7},{"step":7,"speaker":"小黛丝","content":"行。你开。我负责在你被网暴的时候帮你收尸。顺便把你那台破电脑卖了还律师费。","style":11,"background":2034,"log_type":1,"src_id":131302008,"trial_step":8},{"step":8,"speaker":"洛芙","content":"大家锁定我们的频道！不见不散——","style":11,"background":2034,"log_type":1,"src_id":131302009,"trial_step":9},{"step":9,"content":"【转场】管理局","style":18,"background":1022,"log_type":1,"src_id":131302010,"trial_step":10},{"step":10,"content":"「法露儿的24小时——无辜的受害者还是罪有应得的恶魔偶像？」","style":14,"background":1022,"is_centered":true,"log_type":1,"src_id":131302011,"trial_step":11},{"step":11,"content":"【直播镜头】","style":18,"background":1022,"log_type":1,"src_id":131302012,"trial_step":12},{"step":12,"content":"早上七点，工作人员推开监管室的门。","style":3,"background":1022,"log_type":1,"src_id":131302013,"trial_step":13},{"step":13,"speaker":"工作人员","content":"法露儿，该起床了。","voice":["vo_trial_31301_2_13"],"voice_bank":"vo_faluer_trial","style":1,"background":1022,"log_type":1,"src_id":131302014,"trial_step":14},{"step":14,"content":"法露儿已经醒了很久，但她还躺在床上，不起，也不动，就睁着眼睛望着天花板。","style":3,"background":1022,"log_type":1,"src_id":131302015,"trial_step":15},{"step":15,"speaker":"工作人员","content":"法露儿？","voice":["vo_trial_31301_2_15"],"voice_bank":"vo_faluer_trial","style":1,"background":1022,"log_type":1,"src_id":131302016,"trial_step":16},{"step":16,"speaker":"法露儿","content":"起床，是命令吗？","voice":["vo_trial_31301_2_16"],"voice_bank":"vo_faluer_trial","style":1,"background":1022,"log_type":1,"src_id":131302017,"trial_step":17},{"step":17,"speaker":"工作人员","content":"……命令？","voice":["vo_trial_31301_2_17"],"voice_bank":"vo_faluer_trial","style":1,"background":1022,"log_type":1,"src_id":131302018,"trial_step":18},{"step":18,"content":"【闪回】","style":18,"background":1040,"log_type":1,"src_id":131302019,"trial_step":19},{"step":19,"speaker":"${PlayerName}","content":"如果她没有动作，你就“命令”她。","style":1,"background":1040,"log_type":1,"src_id":131302020,"trial_step":20},{"step":20,"content":"【闪回结束】","style":18,"background":1022,"log_type":1,"src_id":131302021,"trial_step":21},{"step":21,"speaker":"工作人员","content":"对，是命令。","voice":["vo_trial_31301_2_21"],"voice_bank":"vo_faluer_trial","style":1,"background":1022,"log_type":1,"src_id":131302022,"trial_step":22},{"step":22,"content":"她一动不动，但肚子发出的咕噜声出卖了她。工作人员没辙地把镜头架在一边。","style":3,"background":1022,"log_type":1,"src_id":131302023,"trial_step":23},{"step":23,"speaker":"工作人员","content":"你不饿吗？早饭时间都过了，等下只能直接去吃午饭了哦。等等，你还没有换衣服没有洗漱吗？","voice":["vo_trial_31301_2_23"],"voice_bank":"vo_faluer_trial","style":1,"background":1022,"log_type":1,"src_id":131302024,"trial_step":24},{"step":24,"content":"【黑屏】","style":18,"background":10000,"log_type":1,"src_id":131302025,"trial_step":25},{"step":25,"content":"镜头被工作人员匆匆盖上，一片漆黑中，传来工作人员温柔的声音和悉悉索索的布料摩擦声。","style":3,"background":10000,"log_type":1,"src_id":131302026,"trial_step":26},{"step":26,"speaker":"法露儿","content":"这件衣服……要怎么穿？","voice":["vo_trial_31301_2_26"],"voice_bank":"vo_faluer_trial","style":1,"background":10000,"log_type":1,"src_id":131302027,"trial_step":27},{"step":27,"speaker":"工作人员","content":"这不是你的衣服吗？你以前是怎么穿的？","voice":["vo_trial_31301_2_27"],"voice_bank":"vo_faluer_trial","style":1,"background":10000,"log_type":1,"src_id":131302028,"trial_step":28},{"step":28,"speaker":"法露儿","content":"以前……有人帮我穿。是这样吗？","voice":["vo_trial_31301_2_28"],"voice_bank":"vo_faluer_trial","style":1,"background":10000,"log_type":1,"src_id":131302029,"trial_step":29},{"step":29,"speaker":"工作人员","content":"不对不对，衣服的前后不对……暗扣也扣错了，这衣服有这么多机关？","voice":["vo_trial_31301_2_29"],"voice_bank":"vo_faluer_trial","style":1,"background":10000,"log_type":1,"src_id":131302030,"trial_step":30},{"step":30,"content":"【黑屏居左文字】","style":18,"background":10000,"log_type":1,"src_id":131302031,"trial_step":31},{"step":31,"content":"【弹幕】\n连衣服都不会穿？太假了吧？\n她以前不是有助理和造型师嘛，这种演出服估计也很难穿吧\n那这也太夸张了，肯定是演的\n不是说她失忆了嘛，连这种生活常识也会丢失吗？太可怕了","style":18,"background":10000,"log_type":1,"src_id":131302032,"trial_step":32},{"step":32,"content":"【转场，指挥室】","style":18,"background":1024104,"log_type":1,"src_id":131302033,"trial_step":33},{"step":33,"content":"…………指挥室里，漆黑的画面中映出你眉头紧锁的发愁面孔。你看着黑屏画面上飘过的评论沉默不语，一时不知道直播到底是个昏招还是个好招。","style":3,"background":1024104,"log_type":1,"src_id":131302034,"trial_step":34},{"step":34,"speaker":"妮诺","content":"我去，直播间已经涌进来几万人了！大家就这么安静地看美少女看了这么久？我的直播间什么时候能有这流量！","voice":["vo_trial_31301_2_34"],"voice_bank":"vo_faluer_trial","style":1,"background":1024104,"log_type":1,"src_id":131302035,"trial_step":35},{"step":35,"speaker":"艾米潘","content":"嘿！我就说直播是个好招吧！局长，要不让咱们其他人也露露脸？顺便带带货给管理局创创收？","voice":["vo_trial_31301_2_35"],"voice_bank":"vo_faluer_trial","style":1,"background":1024104,"log_type":1,"src_id":131302036,"trial_step":36},{"step":36,"content":"你一个手刀劈向艾米潘的脑瓜顶。","style":3,"background":1024104,"log_type":1,"src_id":131302037,"trial_step":37},{"step":37,"content":"直播法露儿的管理局生活已经是一个相当大胆的决定了，你还特意让其他禁闭者规避，只有限地让法露儿一人出镜。","style":3,"background":1024104,"log_type":1,"src_id":131302038,"trial_step":38},{"step":38,"speaker":"艾米潘","content":"哎哟！局长你怎么过河拆桥啊，昨天你可是说我这招是全场唯一靠谱提议呢！","voice":["vo_trial_31301_2_38"],"voice_bank":"vo_faluer_trial","style":1,"background":1024104,"log_type":1,"src_id":131302039,"trial_step":39},{"step":39,"speaker":"${PlayerName}","content":"饶了我吧，我现在甚至有点后悔接受你们这个离谱的直播提议……","style":2,"background":1024104,"log_type":1,"src_id":131302040,"trial_step":40},{"step":40,"content":"算了，你也懒得再挣扎了，直播已经是这帮大聪明提出的最不离谱的建议了。装死总归是不行的，但愿你们这真诚的必杀技真的能堵住民众的怒火。","style":3,"background":1024104,"log_type":1,"src_id":131302041,"trial_step":41},{"step":41,"content":"【转场】","style":18,"background":1022,"log_type":1,"src_id":131302042,"trial_step":42},{"step":42,"content":"很快，镜头恢复了正常。","style":3,"background":1022,"log_type":1,"src_id":131302043,"trial_step":43},{"step":43,"content":"穿衣镜前，法露儿基本穿戴整齐，只剩在最外的一些装饰没有扣好。低头看着自己错位的装饰链和散开的蝴蝶结，她生涩地把纠缠在一起的装饰物解开，又重新对齐。","style":3,"background":1022,"log_type":1,"src_id":131302044,"trial_step":44},{"step":44,"content":"她就这样笨拙地、反复地、毫无怨言地学习如何穿好自己复杂的演出服，整整用了二十分钟。最后终于穿好了，她抬头看向镜头，露出一个浅浅的微笑。","style":3,"background":1022,"log_type":1,"src_id":131302045,"trial_step":45},{"step":45,"speaker":"法露儿","content":"穿好了哦。法露儿是不是很厉害？","voice":["vo_trial_31301_2_45"],"voice_bank":"vo_faluer_trial","style":1,"background":1022,"log_type":1,"src_id":131302046,"trial_step":46},{"step":46,"content":"工作人员被这突如其来的天使微笑暴击，露出了幸福的笑容，继续任劳任怨地帮法露儿整理发型。","style":3,"background":1022,"log_type":1,"src_id":131302047,"trial_step":47},{"step":47,"content":"【弹幕】","style":18,"background":1022,"log_type":1,"src_id":131302048,"trial_step":48},{"step":48,"content":"哦莫是我熟悉的天使微笑\n只有我觉得她的笑容很假吗？\n她是在看镜头吗？这是直播，她以为自己在录综艺？\n你们也太不长记性了，这就又被坏女人骗了？","style":18,"background":1022,"log_type":1,"src_id":131302049,"trial_step":49},{"step":49,"content":"【黑屏结束】","style":18,"background":10000,"log_type":1,"src_id":131302050,"trial_step":50},{"step":50,"content":"【转场】食堂","style":18,"background":2190,"log_type":1,"src_id":131302051,"trial_step":51},{"step":51,"content":"管理局的饮食还算不错，米饭、汤、小菜、一条鱼。","style":3,"background":2190,"log_type":1,"src_id":131302052,"trial_step":52},{"step":52,"content":"法露儿低头看着餐盘，没有动作，只是看着工作人。工作人员显然已经有了经验，张口就是命令的口吻。","style":3,"background":2190,"log_type":1,"src_id":131302053,"trial_step":53},{"step":53,"speaker":"工作人员","content":"法露儿，吃饭。","voice":["vo_trial_31301_2_53"],"voice_bank":"vo_faluer_trial","style":1,"background":2190,"log_type":1,"src_id":131302054,"trial_step":54},{"step":54,"content":"法露儿听话地拿起叉子，叉起一块鱼肉，鱼肉果不其然松散掉落。她再次尝试把鱼肉送到嘴边，但拿起之后又放下了。","style":3,"background":2190,"log_type":1,"src_id":131302055,"trial_step":55},{"step":55,"speaker":"工作人员","content":"怎么了？是菜品不合口味？","voice":["vo_trial_31301_2_55"],"voice_bank":"vo_faluer_trial","style":1,"background":2190,"log_type":1,"src_id":131302056,"trial_step":56},{"step":56,"speaker":"法露儿","content":"不是……鱼有刺。","voice":["vo_trial_31301_2_56"],"voice_bank":"vo_faluer_trial","style":1,"background":2190,"log_type":1,"src_id":131302057,"trial_step":57},{"step":57,"speaker":"法露儿","content":"以前有人把刺挑好再给我吃，但是我不记得是谁了……","voice":["vo_trial_31301_2_57"],"voice_bank":"vo_faluer_trial","style":1,"background":2190,"log_type":1,"src_id":131302058,"trial_step":58},{"step":58,"content":"她把叉子放下。","style":3,"background":2190,"log_type":1,"src_id":131302059,"trial_step":59},{"step":59,"speaker":"法露儿","content":"没有命令的时候，我该做什么呢？为什么那个为我安排好一切的人不见了……","voice":["vo_trial_31301_2_59"],"voice_bank":"vo_faluer_trial","style":1,"background":2190,"log_type":1,"src_id":131302060,"trial_step":60},{"step":60,"content":"她就这样坐在餐桌前，安静地微笑着，落寞又美丽。","style":3,"background":2190,"log_type":1,"src_id":131302061,"trial_step":61},{"step":61,"content":"弹幕开始出现不同的声音：","style":3,"background":2190,"log_type":1,"src_id":131302062,"trial_step":62},{"step":62,"content":"【弹幕】\n我看不下去了 ，共情了家人，她也太可怜了吧？\n等等，你们不觉得她很可怕吗？连吃饭都需要别人告诉她怎么做？\n可怕个屁，她是受害者，你看她生活都不能自理了，除了在管理局被养着她还能做什么？\n她真的只是一个工具吧？那个人是不是她的经纪人？经纪人死了所以她连都不会吃了，可恶的经纪公司到底把她当什么啊？","style":18,"background":2190,"log_type":1,"src_id":131302063,"trial_step":63},{"step":63,"content":"【转场】监控室","style":18,"background":1024104,"log_type":1,"src_id":131302064,"trial_step":64},{"step":64,"content":"你站在监控台前，双手抱胸，一言不发。","style":3,"background":1024104,"log_type":1,"src_id":131302065,"trial_step":65},{"step":65,"content":"屏幕上，法露儿正在镜头前笨拙地倒水，水洒了一桌子，她慌张地擦拭，然后对着镜头不好意思地笑了。","style":3,"background":1024104,"log_type":1,"src_id":131302066,"trial_step":66},{"step":66,"speaker":"夜莺","content":"局长，经过上半天的直播，民众对管理局和法露儿的谴责声量小了一些，虽然还是以黑粉和看热闹的人居多。","voice":["vo_trial_31301_2_66"],"voice_bank":"vo_faluer_trial","style":1,"background":1024104,"log_type":1,"src_id":131302067,"trial_step":67},{"step":67,"content":"你点点头，示意夜莺按计划继续。","style":3,"background":1024104,"log_type":1,"src_id":131302068,"trial_step":68},{"step":68,"content":"【转场】催眠室","style":18,"background":2605,"log_type":1,"src_id":131302069,"trial_step":69},{"step":69,"content":"法露儿靠坐在红丝绒座椅上，手指交叠搭在膝盖。咨询师坐在她对面，擦干桌面，在两人之间的小桌上点燃一根线香。","style":3,"background":2605,"log_type":1,"src_id":131302070,"trial_step":70},{"step":70,"speaker":"咨询师","content":"法露儿，放轻松，我们今天不聊案件，也不聊你的记忆，就随便聊聊你的感觉，好吗？","voice":["vo_trial_31301_2_70"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302071,"trial_step":71},{"step":71,"content":"法露儿微笑，似乎比刚才要放松一些。她的动作很轻，显得乖巧而顺从。","style":3,"background":2605,"log_type":1,"src_id":131302072,"trial_step":72},{"step":72,"speaker":"咨询师","content":"你早上醒来的时候，第一个感觉是什么？","voice":["vo_trial_31301_2_72"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302073,"trial_step":73},{"step":73,"content":"法露儿低下头，想了想，似乎是故意停顿了两秒才抬头。","style":3,"background":2605,"log_type":1,"src_id":131302074,"trial_step":74},{"step":74,"speaker":"法露儿","content":"……冷。","voice":["vo_trial_31301_2_74"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302075,"trial_step":75},{"step":75,"speaker":"咨询师","content":"冷？","voice":["vo_trial_31301_2_75"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302076,"trial_step":76},{"step":76,"speaker":"法露儿","content":"嗯。床单很凉，被子很薄，房间很冷。我不记得以前睡的是什么样的床，但感觉……应该是温暖柔软又宽阔的……","voice":["vo_trial_31301_2_76"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302077,"trial_step":77},{"step":77,"speaker":"法露儿","content":"啊，我没有嫌弃管理局的意思……","voice":["vo_trial_31301_2_77"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302078,"trial_step":78},{"step":78,"speaker":"咨询师","content":"那你还记得以前睡觉前会做什么吗？","voice":["vo_trial_31301_2_78"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302079,"trial_step":79},{"step":79,"speaker":"法露儿","content":"我记不太清了，只记得好像有很多人，有人负责我的起居，有人给我卸妆、热牛奶，还有人很严厉，每天都要督促我练习。","voice":["vo_trial_31301_2_79"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302080,"trial_step":80},{"step":80,"speaker":"咨询师","content":"听起来有不止一个人照顾你。","voice":["vo_trial_31301_2_80"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302081,"trial_step":81},{"step":81,"speaker":"法露儿","content":"嗯，很多人。但是……我不记得他们了，他们的名字、脸、声音，我一点也想不起来。","voice":["vo_trial_31301_2_81"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302082,"trial_step":82},{"step":82,"speaker":"咨询师","content":"法露儿，你有没有过这种感觉——明明不记得一件事，但身体还记得怎么做？","voice":["vo_trial_31301_2_82"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302083,"trial_step":83},{"step":83,"content":"法露儿的眼睛微微亮了一下，像是被咨询师刚好说中了心中所想。","style":3,"background":2605,"log_type":1,"src_id":131302084,"trial_step":84},{"step":84,"speaker":"法露儿","content":"有！有一次，小文给我看她手机里粉丝应援的视频。我看到一个手势，就是大家把手举起来，比一个心，然后往外翻。我的手居然不自觉地跟着动了一下！","voice":["vo_trial_31301_2_84"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302085,"trial_step":85},{"step":85,"speaker":"咨询师","content":"你知道这个手势是什么意思吗？","voice":["vo_trial_31301_2_85"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302086,"trial_step":86},{"step":86,"speaker":"法露儿","content":"我不知道……所以我觉得很难过，我不记得那个手势是什么意思，但我的手还记得。","voice":["vo_trial_31301_2_86"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302087,"trial_step":87},{"step":87,"content":"她的眼睛红了，红得很有层次，先从眼角，再扩散到整个眼眶，泪水盈满眼眶，却克制地没有落下。","style":3,"background":2605,"log_type":1,"src_id":131302088,"trial_step":88},{"step":88,"content":"咨询师被触动了，伸手轻轻拍她的手背安慰。","style":3,"background":2605,"log_type":1,"src_id":131302089,"trial_step":89},{"step":89,"speaker":"咨询师","content":"没关系的，慢慢来。","voice":["vo_trial_31301_2_89"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302090,"trial_step":90},{"step":90,"content":"法露儿低头整理情绪，目光掠过咨询师腕上的手表，映射出她落寞的表情。","style":3,"background":2605,"log_type":1,"src_id":131302091,"trial_step":91},{"step":91,"content":"随即，她扶着椅背缓慢站起身，像是虚弱到需要借力。可她挪动的位置，恰好让灯光落在侧脸，照亮苍白的面颊，也将少女纤细的影子拉得很长。","style":3,"background":2605,"log_type":1,"src_id":131302092,"trial_step":92},{"step":92,"content":"她显得单薄、无助，像一只被迫暴露在镜头前供人观赏的鸟。","style":3,"background":2605,"log_type":1,"src_id":131302093,"trial_step":93},{"step":93,"speaker":"法露儿","content":"女士，我其实……有一件非常在意的事。可以跟您倾诉一下吗？","voice":["vo_trial_31301_2_93"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302094,"trial_step":94},{"step":94,"speaker":"咨询师","content":"当然可以。你现在想到什么，都可以慢慢说。","voice":["vo_trial_31301_2_94"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302095,"trial_step":95},{"step":95,"content":"法露儿垂下眼，鼓足了的勇气般轻声询问。","style":3,"background":2605,"log_type":1,"src_id":131302096,"trial_step":96},{"step":96,"speaker":"法露儿","content":"现在……还会有人支持我吗？","voice":["vo_trial_31301_2_96"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302097,"trial_step":97},{"step":97,"speaker":"法露儿","content":"我的<color=#FFC9F3>露翼</color>们……他们还好吗？有没有人因为我失望？有没有人因为喜欢过我，被别人责怪？","voice":["vo_trial_31301_2_97"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302098,"trial_step":98},{"step":98,"content":"她抬起脸，轻颤的睫毛，微红的眼尾，强忍泪意的表情，被镜头完整捕捉。","style":3,"background":2605,"log_type":1,"src_id":131302099,"trial_step":99},{"step":99,"content":"【弹幕】\n她第一反应居然是担心粉丝……真的假的？\n等等，她不是失忆了吗？\n少来吧，她以前把粉丝礼物丢掉的视频不是还在？\n现在装可怜太晚了。\n案件还没定论吧？感觉她也很混乱。再看看吧。","style":18,"background":2605,"log_type":1,"src_id":131302100,"trial_step":100},{"step":100,"speaker":"咨询师","content":"你知道露翼？你想起什么了吗？","voice":["vo_trial_31301_2_100"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302101,"trial_step":101},{"step":101,"speaker":"法露儿","content":"没有，就连<color=#FFC9F3>露翼</color>这个名字也是从别人那里听来的……","voice":["vo_trial_31301_2_101"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302102,"trial_step":102},{"step":102,"content":"法露儿的脸上满是歉疚，她停顿了一下，像是在仔细辨认堵在胸口的情绪。","style":3,"background":2605,"log_type":1,"src_id":131302103,"trial_step":103},{"step":103,"speaker":"法露儿","content":"可是，在听到这个名字的时候……我觉得有一块很重要的拼图回来了。很温暖。像有人在很远的地方，轻轻呼唤我的名字……","voice":["vo_trial_31301_2_103"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302104,"trial_step":104},{"step":104,"content":"法露儿望向咨询师，语气近乎恳求。","style":3,"background":2605,"log_type":1,"src_id":131302105,"trial_step":105},{"step":105,"speaker":"法露儿","content":"我有一些心里话，想对大家说。可是我怕自己说不好……您可以陪我演练一下吗？","voice":["vo_trial_31301_2_105"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302106,"trial_step":106},{"step":106,"content":"咨询师察觉到她的情绪突然变得充沛，以为这是记忆复苏的突破口，于是点点头。","style":3,"background":2605,"log_type":1,"src_id":131302107,"trial_step":107},{"step":107,"speaker":"咨询师","content":"可以。你可以把我当成他们。","voice":["vo_trial_31301_2_107"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302108,"trial_step":108},{"step":108,"content":"法露儿感激地笑了笑。可下一秒，她的视线却越过心理咨询师的肩膀，她微微偏头，将左脸留给镜头，那是她最漂亮、也最无辜的角度。","style":3,"background":2605,"log_type":1,"src_id":131302109,"trial_step":109},{"step":109,"speaker":"法露儿","content":"好久不见，亲爱的露翼们。","voice":["vo_trial_31301_2_109"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302110,"trial_step":110},{"step":110,"content":"她的声音很轻，所有人都在专心等待她的话语，没有人发弹幕，画面像是被清屏了一般。","style":3,"background":2605,"log_type":1,"src_id":131302111,"trial_step":111},{"step":111,"speaker":"法露儿","content":"我知道，现在一定有很多人在失望，在生气，在怀疑自己是不是喜欢错了人。","voice":["vo_trial_31301_2_111"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302112,"trial_step":112},{"step":112,"speaker":"法露儿","content":"如果真的是这样，对不起。","voice":["vo_trial_31301_2_112"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302113,"trial_step":113},{"step":113,"speaker":"法露儿","content":"我不记得自己有没有弄丢过你们送的礼物，不记得有没有辜负过你们的期待，也不记得那些被我伤害过的人，现在是不是还在痛苦。","voice":["vo_trial_31301_2_113"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302114,"trial_step":114},{"step":114,"speaker":"法露儿","content":"可如果那些都是真的，我不会逃避责任。因为被伤害的人，不该因为我的失忆，就连伤心的资格也一起失去。","voice":["vo_trial_31301_2_114"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302115,"trial_step":115},{"step":115,"content":"【弹幕】\n她还在安抚粉丝……好像是我狭隘了\n……她回应了？她居然没有否认，也没有甩锅。\n这句有点戳到我了。\n她真的很怕粉丝失控吧？万一像以前那个过气偶像一样，变得人人喊打就糟糕了\n感觉她比很多清醒的人都体面。\n你们清醒一点！别被这个女人骗了！她之前把粉丝送的礼物当垃圾一样丢掉你们都忘了？谁真心实意追星谁是大傻子！","style":18,"background":2605,"log_type":1,"src_id":131302116,"trial_step":116},{"step":116,"content":"【转场】","style":18,"background":1024104,"log_type":1,"src_id":131302117,"trial_step":117},{"step":117,"content":"看着弹幕飞快刷新，你觉得事情变得有意思了。","style":3,"background":1024104,"log_type":1,"src_id":131302118,"trial_step":118},{"step":118,"content":"她不需要指责任何人，只要把自己放到足够低的位置，就会有人替她完成剩下的部分。","style":3,"background":1024104,"log_type":1,"src_id":131302119,"trial_step":119},{"step":119,"speaker":"夜莺","content":"要暂停吗，局长？","voice":["vo_trial_31301_2_119"],"voice_bank":"vo_faluer_trial","style":1,"background":1024104,"log_type":1,"src_id":131302120,"trial_step":120},{"step":120,"content":"你点击屏幕，把进度条拉到咨询师安慰法露儿的时候。一道一闪而过的红光出现，你若有所思地又拉回去看了一眼。","style":3,"background":1024104,"log_type":1,"src_id":131302121,"trial_step":121},{"step":121,"speaker":"${PlayerName}","content":"继续，让她说完。","style":2,"background":1024104,"log_type":1,"src_id":131302122,"trial_step":122},{"step":122,"content":"【转场】","style":18,"background":2605,"log_type":1,"src_id":131302123,"trial_step":123},{"step":123,"speaker":"法露儿","content":"所以，请不要因为我，去责怪管理局，更不要责怪正在调查真相的人。他们只是想知道发生了什么，我也是。","voice":["vo_trial_31301_2_123"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302124,"trial_step":124},{"step":124,"speaker":"法露儿","content":"我会配合管理局的一切安排，好好接受调查。如果我真的做错了事，我愿意道歉，愿意补偿，愿意接受惩罚。","voice":["vo_trial_31301_2_124"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302125,"trial_step":125},{"step":125,"speaker":"咨询师","content":"法露儿，案件还没有定论，没有人要求你现在立刻承担一切。","voice":["vo_trial_31301_2_125"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302126,"trial_step":126},{"step":126,"content":"法露儿看着她，轻轻摇头。","style":3,"background":2605,"log_type":1,"src_id":131302127,"trial_step":127},{"step":127,"speaker":"法露儿","content":"可是，总要有人先说对不起。","voice":["vo_trial_31301_2_127"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302128,"trial_step":128},{"step":128,"content":"她的指甲掐进掌心，因为吃痛而面色一变，被咨询师发现了端倪。","style":3,"background":2605,"log_type":1,"src_id":131302129,"trial_step":129},{"step":129,"speaker":"咨询师","content":"你的手——","voice":["vo_trial_31301_2_129"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302130,"trial_step":130},{"step":130,"content":"法露儿想把手藏到身后，被咨询师一把抓住，纤细苍白的手摊开，掌心有着好几道深深浅浅的血痕，指尖也因为焦虑被咬得参差不齐。","style":3,"background":2605,"log_type":1,"src_id":131302131,"trial_step":131},{"step":131,"speaker":"法露儿","content":"没关系的……都是我的错，我不想因为我，再让任何人被责备了。","voice":["vo_trial_31301_2_131"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302132,"trial_step":132},{"step":132,"content":"【弹幕】\n她好懂事，明明她自己也很害怕很焦虑吧。\n她没有卖惨怪谁，反而一直在替所有人说话。\n之前那些说她耍大牌、冷血的人真的该看看这个。\n她明明什么都不记得还在道歉……这和我吃的瓜不一样啊？\n以前那些爆料也不一定全是真的吧？","style":18,"background":2605,"log_type":1,"src_id":131302133,"trial_step":133},{"step":133,"content":"直播间里，质疑没有消失，但发弹幕的人却开始迟疑。而迟疑，就是风向翻转的讯号。","style":3,"background":2605,"log_type":1,"src_id":131302134,"trial_step":134},{"step":134,"speaker":"法露儿","content":"我只是想尽快想起来。想知道自己究竟做错了什么，想知道该怎样弥补，也想知道……我还有没有资格，再回到舞台上。","voice":["vo_trial_31301_2_134"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302135,"trial_step":135},{"step":135,"content":"她轻轻吸了一口气，压住哭腔。","style":3,"background":2605,"log_type":1,"src_id":131302136,"trial_step":136},{"step":136,"speaker":"法露儿","content":"我好像还记得一件事……我真的、真的很想登上舞台，给大家带来幸福和笑容。","voice":["vo_trial_31301_2_136"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302137,"trial_step":137},{"step":137,"speaker":"法露儿","content":"所以，请不要为我争吵，不要替我恨任何人。","voice":["vo_trial_31301_2_137"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302138,"trial_step":138},{"step":138,"content":"她顿了顿，终于抬起眼，晶莹而饱满的泪珠在眼眶打转，像是在穿透镜头，看向每一个直播间里的人。","style":3,"background":2605,"log_type":1,"src_id":131302139,"trial_step":139},{"step":139,"speaker":"法露儿","content":"可是……也请不要忘记我。","voice":["vo_trial_31301_2_139"],"voice_bank":"vo_faluer_trial","style":1,"background":2605,"log_type":1,"src_id":131302140,"trial_step":140},{"step":140,"content":"直播间安静了一瞬。下一秒，弹幕彻底沸腾。","style":3,"background":2605,"log_type":1,"src_id":131302141,"trial_step":141},{"step":141,"content":"【弹幕】\n我们记得你，露翼永远记得你！\n别怕，我们等你回来。\n不要忘记我……我破防了。她真的很需要被好好对待。\n我以前不粉她，现在有点理解为什么那么多人喜欢她了。\n我原谅不了以前的事，但我愿意等真相。\n 妈妈我恋爱了她是天使\n 我原谅她了，我真的原谅她了\n 该死的另有其人！！！\n 我要守护这个笑容！！从今天开始我就是露翼！！\n她只是想被记得啊，只有我一个人觉得她好可怜吗？\n 之前怕被骂我都不敢说话，我一直觉得我担不可能这样对我们！","style":18,"background":2605,"log_type":1,"src_id":131302142,"trial_step":142},{"step":142,"content":"你抬手，直播结束。","style":3,"background":2605,"log_type":1,"src_id":131302143,"trial_step":143},{"step":143,"content":"滋啦——画面应声终止。最后闪烁的雪花屏里，法露儿仍保持着那副快要碎掉的表情。","style":3,"background":10000,"log_type":1,"src_id":131302144,"trial_step":144},{"step":144,"content":"咨询师低头寻找纱布的瞬间，法露儿脸上的泪意迅速淡去。她低头看了一眼掌心的血痕，扬起一抹极浅的笑。","style":3,"background":2605,"log_type":1,"src_id":131302145,"trial_step":145},{"step":145,"content":"而这个只出现了一瞬间的微笑，并没有逃过你的眼睛。","style":3,"background":2605,"log_type":1,"src_id":131302146,"trial_step":146}]}