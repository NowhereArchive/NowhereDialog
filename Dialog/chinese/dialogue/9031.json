{"id":9031,"chapter_id":9,"scene_id":904,"steps":[{"step":1,"speaker":"赫卡蒂","content":"敌人虽然不难对付，但我们不熟悉这里的地形，会有些麻烦。","voice":["vo_cgplot_9031001"],"voice_bank":"vo_cgplot_0903","style":1,"background":904,"log_type":1},{"step":2,"speaker":"海拉","content":"那个小鬼呢？黑帮是冲着他来的，要不先把他拽上车，先送走再说。","voice":["vo_cgplot_9031002"],"voice_bank":"vo_cgplot_0903","style":1,"background":904,"log_type":1},{"step":3,"speaker":"海拉","content":"诶，等等，臭小子你别跑啊？！前面全是黑帮！！喂——","voice":["vo_cgplot_9031003"],"voice_bank":"vo_cgplot_0903","style":1,"background":904,"log_type":1},{"step":4,"speaker":"赫卡蒂","content":"局长，你还好吗？","voice":["vo_cgplot_9031004"],"voice_bank":"vo_cgplot_0903","style":1,"background":904,"log_type":1},{"step":5,"content":"你渐渐落到后面，气有些不顺，脚步慢了下来，也借机观察周围的环境。","style":3,"background":904,"log_type":1},{"step":6,"content":"两边矮楼有人生活的痕迹，门窗却紧锁，有些甚至贴上了胶布。这样的准备对一场突然爆发的巷战来说，显然太充分也太熟练了些。","style":3,"background":1028,"log_type":1},{"step":7,"speaker":"选项","options":["那个少年呢？"],"jump":[8],"style":6,"background":1028,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"还没走远。情况有些不对，黑帮的数量在逐渐减少，但那并不是我们造成的。","voice":["vo_cgplot_9031008"],"voice_bank":"vo_cgplot_0903","style":1,"background":1028,"log_type":1},{"step":9,"speaker":"选项","options":["……我明白了，追上去"],"jump":[10],"style":6,"background":1028,"log_type":1}]}