{"id":404603001,"chapter_id":220100,"scene_id":705,"steps":[{"step":1,"speaker":"鬼魂","content":"<i><color=#dg1f1f>嘶——嘶——</i></color>","style":1,"background":2552105,"log_type":1},{"step":2,"content":"一只鬼影从墙后向你们冲来。离尘挡在你身前，召出几把木剑。","style":3,"background":2552105,"log_type":1},{"step":3,"speaker":"离尘","content":"疾速神威现真形！","voice":["vo_event_404603001_03"],"voice_bank":"vo_event_46031","style":1,"background":2552105,"log_type":1},{"step":4,"content":"木剑直直刺穿怪物的四肢，它嘶吼一声，挣扎着消散。","style":3,"background":2552105,"log_type":1},{"step":6,"content":"在彻底消散前，你看见它化为一张极其光滑的人脸，没有一根毛发，没有一丝褶皱，睁着纯黑的眼睛。","style":3,"background":2552105,"log_type":1},{"step":8,"speaker":"离尘","content":"别看。","voice":["vo_event_404603001_06"],"voice_bank":"vo_event_46031","style":1,"background":2552105,"log_type":1},{"step":9,"content":"她一把把你拽到身后。","style":3,"background":2552105,"log_type":1},{"step":10,"content":"明明离尘已经把那个怪物给击退了，但现在阳界反而更加动荡不安。脚下的地面也呈现出一种极细微的扭曲感。","style":3,"background":2552105,"log_type":1},{"step":11,"content":"亡魂一个接一个，在你们身后穷追不舍。","style":3,"background":2552105,"log_type":1},{"step":12,"speaker":"离尘","content":"诛斩焚烧，化作微尘！","voice":["vo_event_404603001_08"],"voice_bank":"vo_event_46031","style":1,"background":2552105,"log_type":1},{"step":13,"speaker":"鬼魂","content":"<i><color=#dg1f1f>呜啊啊啊啊——！</i></color>","style":1,"background":2552105,"log_type":1},{"step":14,"content":"惨叫声还未来得及完全散去，雾气中，又一道模糊的轮廓贴地滑向你们。","style":3,"background":2552105,"log_type":1},{"step":15,"content":"下一瞬，它猛然收紧身形，朝你们扑来——","style":3,"background":2552105,"log_type":1}]}