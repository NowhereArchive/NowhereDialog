{"id":1020901,"chapter_id":1020901,"scene_id":1,"steps":[{"step":1,"content":"【砂海深处】","style":18,"background":2420,"log_type":1,"src_id":120901001,"trial_step":1},{"step":2,"content":"黑色碎屑溢满天际，狂厄气息躁动翻涌，透过沙幕，隐约能看到两个战斗的身影。","style":3,"background":2420,"log_type":1,"src_id":120901002,"trial_step":2},{"step":3,"content":"敌人极其强大，一瞬间的晃神就可能葬送性命。但女人好像并不在意，只顾一次次对怪物发起猛攻。","style":3,"background":2420,"log_type":1,"src_id":120901003,"trial_step":3},{"step":4,"speaker":"？？？","content":"想要的是……我的胳膊吗？","voice":["vo_trial_404101_1_1"],"voice_bank":"vo_synex_trial","style":1,"background":2420,"log_type":1,"src_id":120901004,"trial_step":4},{"step":5,"content":"风暴中，一块巨石砸中了她，将她横压在地。怪物嚎叫着向那巨石灌注力量，不断增加的重力压得她的锁骨咯吱作响。","style":3,"background":2420,"log_type":1,"src_id":120901005,"trial_step":5},{"step":6,"speaker":"？？？","content":"哈哈哈！没想到你也好这口！","voice":["vo_trial_404101_1_2"],"voice_bank":"vo_synex_trial","style":1,"background":2420,"log_type":1,"src_id":120901006,"trial_step":6},{"step":7,"content":"话音落下，她撞开身上的巨石，再次扑向面前的怪物。","style":3,"background":2420,"log_type":1,"src_id":120901007,"trial_step":7},{"step":8,"content":"这次她得手了。利爪埋进了怪物的身躯，她沿着颈部肌理将怪物的手臂狠狠撕下。","style":3,"background":2420,"log_type":1,"src_id":120901008,"trial_step":8},{"step":9,"content":"怪物发出一声惨叫，用残存的一只手臂将她甩开，重重落入远处沙丘之中。","style":3,"background":2420,"log_type":1,"src_id":120901009,"trial_step":9},{"step":10,"content":"那只庞大的灰烬使徒没有追上来，沙尘中的狂厄随之散去，周遭的砂海回归了寂静。","style":3,"background":2420,"log_type":1,"src_id":120901010,"trial_step":10},{"step":11,"content":"不久后，沙丘攒动，女人从里面冒头出来，呸呸呸地往外吐着沙子。","style":3,"background":2420,"log_type":1,"src_id":120901011,"trial_step":11},{"step":12,"speaker":"？？？","content":"呸呸呸~啊~好爽好爽，虽然还是没打过，不过，有条胳膊也不错。","voice":["vo_trial_404101_1_3"],"voice_bank":"vo_synex_trial","style":1,"background":2420,"log_type":1,"src_id":120901012,"trial_step":12},{"step":13,"content":"那个身影从沙丘里钻出来，捧起了方才撕下的手臂，大口啃食起来。","style":3,"background":2420,"log_type":1,"src_id":120901013,"trial_step":13},{"step":14,"content":"一阵清风吹过，如受到感召一般，几只秘金兽从沙地里探出了头。它们走出沙洞、攀出地表，循着方才战斗的痕迹，小心翼翼地捡拾起战斗后剩下的秘金碎粒。","style":3,"background":2420,"log_type":1,"src_id":120901014,"trial_step":14},{"step":15,"content":"影像定格。按下停止键后，干员又将画面放大了些许，以便让所有人都能看清女人的面貌，以及这诡异的一幕。","style":3,"background":2420,"log_type":1,"src_id":120901015,"trial_step":15},{"step":16,"content":"【搜捕船内】","style":18,"background":2002,"log_type":1,"src_id":120901016,"trial_step":16},{"step":17,"speaker":"第九机关干员","content":"通报MBCC，基本信息已核实完毕。画面中的女性名为“西涅克斯”，曾是坎贝尔家族的暗卫；已查证由坎贝尔家族犯下的恶性案件中，至少有数十起与她相关。","voice":["vo_trial_404101_1_4"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901017,"trial_step":17},{"step":18,"speaker":"第九机关干员","content":"十日前，机关的通缉令发布后，我们得到了她正处在这片砂海中的情报。不过，她的行踪较为隐蔽，之前的搜索里，我们只得到了一些零碎的线索；直到一小时前，我们才捕获了这段较为清晰的录像。","voice":["vo_trial_404101_1_5"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901018,"trial_step":18},{"step":19,"speaker":"第九机关干员","content":"录像中的画面基本验证了我们此前的推测。她来到这片砂海是为了追猎灰烬使徒，并从他们身上获取秘金。她，以及她身边的秘金兽，都要以灰烬使徒产生的秘金碎屑为食。","voice":["vo_trial_404101_1_6"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901019,"trial_step":19},{"step":20,"speaker":"第九机关特工","content":"……除了这些最浅显的信息，请容我为您再补充一项推论。","voice":["vo_trial_404101_1_7"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901020,"trial_step":20},{"step":21,"speaker":"第九机关特工","content":"近些时日，我们在录像所示坐标附近发现了大量灰烬使徒行动的迹象。若目标是为追猎灰烬使徒来到这片砂海，我们很可能在那附近发现她的营地。","voice":["vo_trial_404101_1_8"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901021,"trial_step":21},{"step":22,"speaker":"第九机关特工","content":"另外，秘金兽并不是寿命长久的物种，我们这位目标也显然没有治愈它们的能力。","voice":["vo_trial_404101_1_9"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901022,"trial_step":22},{"step":23,"speaker":"第九机关特工","content":"目标身边的这群秘金兽明显已处于生命末期，行动能力大不如前。处于这种境况的秘金兽很难在砂海中长途跋涉。但若是有营地处在录像中的坐标点附近，影像里成群触动的画面就会很好解释了。","voice":["vo_trial_404101_1_10"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901023,"trial_step":23},{"step":24,"speaker":"第九机关特工","content":"以上就是我们今早收集到的线索与相关推论。至于是否要继续追踪目标，或是进一步搜索她在砂海中的巢穴，我们会等待您的指令。报告结束。","voice":["vo_trial_404101_1_11"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901024,"trial_step":24},{"step":25,"content":"对讲设备闪烁蓝光，这份讯号已被接收。但与此同时，监控船只状态的指示灯却亮起了红光。","style":3,"background":2002,"log_type":1,"src_id":120901025,"trial_step":25},{"step":26,"speaker":"第九机关特工","content":"这是怎么回事？","voice":["vo_trial_404101_1_12"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901026,"trial_step":26},{"step":27,"speaker":"第九机关特工","content":"我去看看，你们在这里别动。","voice":["vo_trial_404101_1_13"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901027,"trial_step":27},{"step":28,"content":"【砂海外景】","style":18,"background":10000,"log_type":1,"src_id":120901028,"trial_step":28},{"step":29,"content":"推开舱门，灼人的热浪裹着砂石迎面而来。特工吃了一惊，下意识退后两步。","style":3,"background":2004,"log_type":1,"src_id":120901029,"trial_step":29},{"step":30,"content":"搜捕船尾从上到下已洞开了一个巨大的裂口，剧烈的风沙由裂口灌入船舱；原本坚硬的金属舱壁被怪力撕碎，参差不齐的边缘像浸着血液的巨齿。","style":3,"background":2004,"log_type":1,"src_id":120901030,"trial_step":30},{"step":31,"speaker":"第九机关特工","content":"这艘船的外壁几周前才加固过……怎么可能？怎么会这样？","voice":["vo_trial_404101_1_14"],"voice_bank":"vo_synex_trial","style":1,"background":2004,"log_type":1,"src_id":120901031,"trial_step":31},{"step":32,"speaker":"第九机关特工","content":"难道是砂兽……不，砂兽不可能有这样的破坏力。","voice":["vo_trial_404101_1_15"],"voice_bank":"vo_synex_trial","style":1,"background":2004,"log_type":1,"src_id":120901032,"trial_step":32},{"step":33,"content":"特工俯下身，想要进一步观察被撕裂的金属边缘。","style":3,"background":2004,"log_type":1,"src_id":120901033,"trial_step":33},{"step":34,"content":"正在此时，一股力量从背后袭向他的腰间。来不及反应，偷袭者的利爪便将他按在了已被撕裂的地面上。","style":3,"background":2004,"log_type":1,"src_id":120901034,"trial_step":34},{"step":35,"speaker":"西涅克斯","content":"你们啊，找到了我的行踪，却懒得做好善后工作。","voice":["vo_trial_404101_1_16"],"voice_bank":"vo_synex_trial","style":1,"background":2004,"log_type":1,"src_id":120901035,"trial_step":35},{"step":36,"speaker":"西涅克斯","content":"看来第九机关并不在意你们的安全，培训的时候，也不怎么上心嘛。","voice":["vo_trial_404101_1_17"],"voice_bank":"vo_synex_trial","style":1,"background":2004,"log_type":1,"src_id":120901036,"trial_step":36},{"step":37,"speaker":"西涅克斯","content":"这可怎么办呢？自己一个人来检查，结果被大坏蛋偷袭了。要不要再喊来一些朋友，让这里热闹起来呢？","voice":["vo_trial_404101_1_18"],"voice_bank":"vo_synex_trial","style":1,"background":2004,"log_type":1,"src_id":120901037,"trial_step":37},{"step":38,"speaker":"第九机关特工","content":"有袭击者！快来增援！","voice":["vo_trial_404101_1_19"],"voice_bank":"vo_synex_trial","style":1,"background":2004,"log_type":1,"src_id":120901038,"trial_step":38},{"step":39,"speaker":"第九机关干员","content":"是西涅克斯！快，快控制住她！","voice":["vo_trial_404101_1_20"],"voice_bank":"vo_synex_trial","style":1,"background":2004,"log_type":1,"src_id":120901039,"trial_step":39},{"step":40,"speaker":"西涅克斯","content":"哈哈哈哈？你们？在这里？想抓我？！","voice":["vo_trial_404101_1_21"],"voice_bank":"vo_synex_trial","style":1,"background":2004,"log_type":1,"src_id":120901040,"trial_step":40},{"step":41,"content":"她的身影骤然消失，留下放肆的大笑声。","style":3,"background":2004,"log_type":1,"src_id":120901041,"trial_step":41},{"step":42,"content":"近身战是西涅克斯的专场。枪弹中她飞快变换着身形逼近每一个赶来的船员，随着她的每一次变化，就会有一只利爪洞穿干员的臂膀。","style":3,"background":2004,"log_type":1,"src_id":120901042,"trial_step":42},{"step":43,"content":"比起“战斗”，这更像是一场血腥的“围猎”。","style":3,"background":2004,"log_type":1,"src_id":120901043,"trial_step":43},{"step":44,"speaker":"第九机关特工","content":"可恶，这样下去……","voice":["vo_trial_404101_1_22"],"voice_bank":"vo_synex_trial","style":1,"background":2004,"log_type":1,"src_id":120901044,"trial_step":44},{"step":45,"content":"【砂船内】","style":18,"background":10000,"log_type":1,"src_id":120901045,"trial_step":45},{"step":46,"content":"特工踉跄着跑回船舱内，按响了仪表盘上的几个数字。","style":3,"background":2002,"log_type":1,"src_id":120901046,"trial_step":46},{"step":47,"content":"指示灯由红转绿，求救信号已成功发出。但搜捕船处在砂海腹地，救援赶到至少要几十分钟。","style":3,"background":2002,"log_type":1,"src_id":120901047,"trial_step":47},{"step":48,"speaker":"西涅克斯","content":"嗨，你在这儿呀~","voice":["vo_trial_404101_1_23"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901048,"trial_step":48},{"step":49,"content":"舱门又一次被撞开，浑身是血的女人站在特工面前，但后者已经没了攻击她的力气。","style":3,"background":2002,"log_type":1,"src_id":120901049,"trial_step":49},{"step":50,"speaker":"西涅克斯","content":"那个表盘上的是什么，求救信号？哈哈哈，说说看吧，这次会是什么人来追捕我？","voice":["vo_trial_404101_1_24"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901050,"trial_step":50},{"step":51,"content":"女人笑眯眯地说着，用手掐住特工的脖颈，将其高高举起。","style":3,"background":2002,"log_type":1,"src_id":120901051,"trial_step":51},{"step":52,"speaker":"西涅克斯","content":"你呢？想我把你的小命留到救援赶来的那天吗？猜猜我今天心情如何？","voice":["vo_trial_404101_1_25"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901052,"trial_step":52},{"step":53,"speaker":"第九机关特工","content":"咳……咳咳……","voice":["vo_trial_404101_1_26"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901053,"trial_step":53},{"step":54,"speaker":"${PlayerName}","content":"西涅克斯，放手。","style":11,"background":2002,"log_type":1,"src_id":120901054,"trial_step":54},{"step":55,"speaker":"西涅克斯","content":"嗯……？","voice":["vo_trial_404101_1_27"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901055,"trial_step":55},{"step":56,"content":"你的声音让西涅克斯一怔。她丢下那特工，四下寻找了一圈，目光最后落在了一只通讯器上。","style":3,"background":2002,"log_type":1,"src_id":120901056,"trial_step":56},{"step":57,"speaker":"西涅克斯","content":"原来是${PlayerName}呀。没想到我们的再一次见面是在这种求救通讯上，真是遗憾。","voice":["vo_trial_404101_1_28"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901057,"trial_step":57},{"step":58,"speaker":"西涅克斯","content":"想让我放了这几条小命倒是也没问题。只不过，亲爱的米诺斯管理局局长，你要用什么来回报我呢？","voice":["vo_trial_404101_1_29"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901058,"trial_step":58},{"step":59,"speaker":"选项","options":["以命换命如何？"],"style":6,"background":2002,"log_type":1,"src_id":120901059,"trial_step":59,"course":3,"choices":[{"text":"以命换命如何？","goto":60}]},{"step":60,"speaker":"西涅克斯","content":"你的吗？你觉得，我要你的命干什么？","voice":["vo_trial_404101_1_30"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901060,"trial_step":60},{"step":61,"speaker":"选项","options":["我们能帮你治好秘金感染的后遗症"],"style":6,"background":2002,"log_type":1,"src_id":120901061,"trial_step":61,"course":3,"choices":[{"text":"我们能帮你治好秘金感染的后遗症","goto":62}]},{"step":62,"content":"她的表情明显怔了一下。但很快，那双狡黠的红眼睛眯了起来。","style":3,"background":2002,"log_type":1,"src_id":120901062,"trial_step":62},{"step":63,"speaker":"西涅克斯","content":"你找到了个不错的理由，说说看。","voice":["vo_trial_404101_1_31"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901063,"trial_step":63},{"step":64,"speaker":"${PlayerName}","content":"我理解你发起这场袭击的缘由。搜捕船上的干员收集到了你的影像，推算出了你与秘金兽扎营的坐标，而你为保护这个秘密展开了报复。","style":11,"background":2002,"log_type":1,"src_id":120901064,"trial_step":64},{"step":65,"speaker":"${PlayerName}","content":"但你误解了这场行动的初衷。我们对你并无敌意，也没想过伤害你身边的那些秘金兽。我清楚你们的身体情况。秘金实验品需要定期摄取秘金才能继续存活，你之所以不断袭击灰烬使徒也是为了获得续命的粮食。","style":11,"background":2002,"log_type":1,"src_id":120901065,"trial_step":65},{"step":66,"speaker":"${PlayerName}","content":"但若你们前来狄斯，局里可以协助进行治疗，找到帮助你们延寿的方法。","style":11,"background":2002,"log_type":1,"src_id":120901066,"trial_step":66},{"step":67,"speaker":"西涅克斯","content":"你是说，只要我放了这群倒霉蛋，你们狄斯城就可以不计前嫌，好好接待我们这些“怪物”，还会帮忙治好身子？","voice":["vo_trial_404101_1_32"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901067,"trial_step":67},{"step":68,"content":"另一端的西涅克斯突然爆发出一阵大笑，声音甚至大到有些失真。","style":3,"background":2002,"log_type":1,"src_id":120901068,"trial_step":68},{"step":69,"speaker":"西涅克斯","content":"哈哈哈哈！！你们这群贵族老爷们骗人话都是批发的吗？想当年阿德莱德也对我说过差不多的话。","voice":["vo_trial_404101_1_33"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901069,"trial_step":69},{"step":70,"speaker":"西涅克斯","content":"但多谢了，这次我已经不会再上当了。这条新狗链，你不如留着自己戴吧。","voice":["vo_trial_404101_1_34"],"voice_bank":"vo_synex_trial","style":1,"background":2002,"log_type":1,"src_id":120901070,"trial_step":70},{"step":71,"speaker":"${PlayerName}","content":"不是这样的，西涅——","style":11,"background":2002,"log_type":1,"src_id":120901071,"trial_step":71},{"step":72,"content":"你的劝阻毫无作用，通讯器中传来一阵尖锐的爆响，屏幕被血色染红，话筒中也只剩下了低沉的嗡鸣声。","style":3,"background":943,"log_type":1,"src_id":120901072,"trial_step":72},{"step":73,"content":"【MBCC办公室】","style":18,"background":1040,"log_type":1,"src_id":120901073,"trial_step":73},{"step":74,"content":"……","style":2,"background":1040,"log_type":1,"src_id":120901074,"trial_step":74},{"step":75,"content":"夜莺，记录一下求助信号的对应坐标，通知对应部门，我需要更多情报，一定要快。","style":2,"background":1040,"log_type":1,"src_id":120901075,"trial_step":75},{"step":76,"content":"必要的话，我得亲自跑一趟砂海了。","style":2,"background":1040,"log_type":1,"src_id":120901076,"trial_step":76}]}