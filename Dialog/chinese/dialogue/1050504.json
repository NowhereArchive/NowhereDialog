{"id":1050504,"chapter_id":1050504,"scene_id":1,"steps":[{"step":1,"content":"很快就到了正式开课的那天，渡鸦极力主张想要在已经建好的几间教室里上课，但在被工人们告知刚装修好的教室的空气里会有不少污染物后便放弃了这个想法。","style":3,"background":1066,"log_type":1,"src_id":150504001,"trial_step":1},{"step":2,"content":"毕竟教学环境无论如何都比不上学生们的安全。","style":3,"background":1066,"log_type":1,"src_id":150504002,"trial_step":2},{"step":3,"content":"于是渡鸦直接大刀阔斧地把桌椅摆在了教学楼外的操场上。","style":3,"background":1066,"log_type":1,"src_id":150504003,"trial_step":3},{"step":4,"content":"你环顾四周，都是年龄不一的孩子。有看上去只有八九岁的，也有看上去像是十五六岁的。","style":3,"background":1066,"log_type":1,"src_id":150504004,"trial_step":4},{"step":5,"content":"能看到这样奇妙的景象，还是要谢谢一旁站在阴影里的那个禁闭者。","style":3,"background":1066,"log_type":1,"src_id":150504005,"trial_step":5},{"step":6,"content":"虽然嘴上说着不愿意，但还是把流浪儿们一股脑地送来了学堂。","style":3,"background":1066,"log_type":1,"src_id":150504006,"trial_step":6},{"step":7,"content":"当然，你还看到了些好东西。","style":3,"background":1066,"log_type":1,"src_id":150504007,"trial_step":7},{"step":8,"content":"一张入学申请书，上面歪歪扭扭地写着两个大字——","style":3,"background":1066,"log_type":1,"src_id":150504008,"trial_step":8},{"step":9,"content":"海拉。","style":3,"background":1066,"log_type":1,"src_id":150504009,"trial_step":9},{"step":10,"content":"不过她本人倒是没来，没准是怕你？你甚至都能想象到她见到你会说什么话。","style":3,"background":1066,"log_type":1,"src_id":150504010,"trial_step":10},{"step":11,"speaker":"海拉","content":"喂，你来这里干嘛，不会是来看我笑话的吧？","voice":["vo_trial_50504_1_11"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504011,"trial_step":11},{"step":12,"content":"你微微一笑，将申请书放回原位，用石头把它们压住后，像个家长一样坐到了教室的最后排。","style":3,"background":1066,"log_type":1,"src_id":150504012,"trial_step":12},{"step":13,"content":"开课已经接近五分钟，但讲台上却仍是空空如也。","style":3,"background":1066,"log_type":1,"src_id":150504013,"trial_step":13},{"step":14,"content":"不过下一瞬间，那个空位便被快速冲进房间的一团漆黑所占据了。","style":3,"background":1066,"log_type":1,"src_id":150504014,"trial_step":14},{"step":15,"speaker":"渡鸦","content":"抱歉抱歉……光想着给亲爱的学生们准备最好的教材了，所以来晚了一点点。","voice":["vo_trial_50504_1_15"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504015,"trial_step":15},{"step":16,"speaker":"渡鸦","content":"从现在起，无论发生什么事，都请同学们保持冷静。","voice":["vo_trial_50504_1_16"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504016,"trial_step":16},{"step":17,"content":"学生们用狐疑的目光看着渡鸦，不知道她想要做什么。","style":3,"background":1066,"log_type":1,"src_id":150504017,"trial_step":17},{"step":18,"speaker":"学生A","content":"老师，会发生什么事情？会爆炸么？","voice":["vo_trial_50504_1_18"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504018,"trial_step":18},{"step":19,"content":"有胆子大的学生举手提问。","style":3,"background":1066,"log_type":1,"src_id":150504019,"trial_step":19},{"step":20,"speaker":"渡鸦","content":"嗯，怎么说呢……准确来说应该是老师为大家准备了一份惊喜。","voice":["vo_trial_50504_1_20"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504020,"trial_step":20},{"step":21,"speaker":"渡鸦","content":"堪比爆炸的惊喜哦。","voice":["vo_trial_50504_1_21"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504021,"trial_step":21},{"step":22,"content":"就在说话间，一只漆黑的乌鸦便扑簌簌地飞到了一个学生的头顶。","style":3,"background":1066,"log_type":1,"src_id":150504022,"trial_step":22},{"step":23,"content":"乌鸦盘旋了几圈，降落到课桌上，放下一摞课本之后便匆匆飞走。","style":3,"background":1066,"log_type":1,"src_id":150504023,"trial_step":23},{"step":24,"speaker":"科希","content":"呵，臭乌鸦，又在显摆。","voice":["vo_trial_50504_1_24"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504024,"trial_step":24},{"step":25,"content":"一侧的阴影暗暗作响，但应该不是在生气。","style":3,"background":1066,"log_type":1,"src_id":150504025,"trial_step":25},{"step":26,"content":"在学生们惊讶的目光注视之下，三五成群的乌鸦不一会儿便完成了书籍的运送。","style":3,"background":1066,"log_type":1,"src_id":150504026,"trial_step":26},{"step":27,"content":"如此浮夸的教材搬运作业，恐怕也只有渡鸦能做到了吧。","style":3,"background":1066,"log_type":1,"src_id":150504027,"trial_step":27},{"step":28,"speaker":"渡鸦","content":"好了，亲爱的同学们，我们就开始在狄斯大学堂的第一节课吧。","voice":["vo_trial_50504_1_28"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504028,"trial_step":28},{"step":29,"speaker":"渡鸦","content":"我叫渡鸦，渡鸦的渡，渡鸦的鸦。当然，你们要是不喜欢的话，也可以叫我的另一个名字——","voice":["vo_trial_50504_1_29"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504029,"trial_step":29},{"step":30,"speaker":"渡鸦","content":"瑞文。","voice":["vo_trial_50504_1_30"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504030,"trial_step":30},{"step":31,"content":"课程平稳地进行着，也不知道是多亏了渡鸦的认真的备课，还是多亏了新城的教材，你在一旁也听得津津有味。","style":3,"background":1066,"log_type":1,"src_id":150504032,"trial_step":32},{"step":32,"content":"时间过得很快，很快就到了历史课的时间。","style":3,"background":1066,"log_type":1,"src_id":150504033,"trial_step":33},{"step":33,"content":"在上课之前，你还在走廊碰到了拿着教案的渡鸦。","style":3,"background":1066,"log_type":1,"src_id":150504034,"trial_step":34},{"step":34,"options":["你准备得怎么样？"],"style":6,"background":1066,"log_type":1,"src_id":150504035,"trial_step":35,"course":3,"choices":[{"text":"你准备得怎么样？","goto":36}]},{"step":35,"speaker":"渡鸦","content":"我说我没准备，你信么？","voice":["vo_trial_50504_1_36"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504036,"trial_step":36},{"step":36,"speaker":"玩家","content":"不信。","style":2,"background":1066,"log_type":1,"src_id":150504037,"trial_step":37},{"step":37,"speaker":"渡鸦","content":"那我说我准备得万无一失，你信么？","voice":["vo_trial_50504_1_38"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504038,"trial_step":38},{"step":38,"speaker":"玩家","content":"也不信。","style":2,"background":1066,"log_type":1,"src_id":150504039,"trial_step":39},{"step":39,"content":"渡鸦嘿嘿一笑。","style":3,"background":1066,"log_type":1,"src_id":150504040,"trial_step":40},{"step":40,"speaker":"渡鸦","content":"看来我们之间的交流已经默契了很多嘛。","voice":["vo_trial_50504_1_41"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504041,"trial_step":41},{"step":41,"content":"渡鸦大踏步地站回了讲台，你则在一旁默默观察着操场上的情况。","style":3,"background":1066,"log_type":1,"src_id":150504042,"trial_step":42},{"step":42,"speaker":"渡鸦","content":"好了，亲爱的同学们，拿出历史教材吧，我们要开始第一节辛迪加历史课了。","voice":["vo_trial_50504_1_43"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504043,"trial_step":43},{"step":43,"speaker":"渡鸦","content":"今天我们不从辛迪加诞生的N.F.81年开讲，我们就先从大家最熟悉的年份开始讲起吧。","voice":["vo_trial_50504_1_44"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504044,"trial_step":44},{"step":44,"content":"渡鸦手握粉笔，转过身去在黑板上歘地画出了一条长线后，开始在上面标起了时间轴。","style":3,"background":1066,"log_type":1,"src_id":150504045,"trial_step":45},{"step":45,"speaker":"渡鸦","content":"我们先从N.F.98年开始吧，亲爱的同学们，请快速翻阅教材，告诉我那一年发生了什么事情。","voice":["vo_trial_50504_1_46"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504046,"trial_step":46},{"step":46,"content":"渡鸦在黑板上点了个点。","style":3,"background":1066,"log_type":1,"src_id":150504047,"trial_step":47},{"step":47,"content":"在一阵书页的哗啦声中，渡鸦闭着眼睛，等待着答案。","style":3,"background":1066,"log_type":1,"src_id":150504048,"trial_step":48},{"step":48,"speaker":"学生C","content":"老师！书上没写！","voice":["vo_trial_50504_1_49"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504049,"trial_step":49},{"step":49,"speaker":"学生A","content":"对啊，这一年上面写的是空白啊。","voice":["vo_trial_50504_1_50"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504050,"trial_step":50},{"step":50,"content":"有几个认字的学生不靠字典已经将全书翻了一遍，但就是没能找到关于N.F.98年的重大事件记载。","style":3,"background":1066,"log_type":1,"src_id":150504051,"trial_step":51},{"step":51,"content":"渡鸦先让学生们坐下，然后翻了几下书，有些浮夸地摆摆手。","style":3,"background":1066,"log_type":1,"src_id":150504052,"trial_step":52},{"step":52,"speaker":"渡鸦","content":"嗨，你瞧瞧老师，怎么能把年份给记错了呢？","voice":["vo_trial_50504_1_53"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504053,"trial_step":53},{"step":53,"speaker":"渡鸦","content":"这是老师的错，老师重新……","voice":["vo_trial_50504_1_54"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504054,"trial_step":54},{"step":54,"speaker":"学生D","content":"老师。","voice":["vo_trial_50504_1_55"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504055,"trial_step":55},{"step":55,"content":"有一个孩子默默举起了手。","style":3,"background":1066,"log_type":1,"src_id":150504056,"trial_step":56},{"step":56,"speaker":"学生D","content":"老师，我知道……虽然书上没写，但是我……可能知道。","voice":["vo_trial_50504_1_57"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504057,"trial_step":57},{"step":57,"content":"渡鸦先是一惊，然后饶有兴味地看着举起手的孩子。","style":3,"background":1066,"log_type":1,"src_id":150504058,"trial_step":58},{"step":58,"speaker":"渡鸦","content":"你说你知道，那就大声告诉大家吧。","voice":["vo_trial_50504_1_59"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504059,"trial_step":59},{"step":59,"speaker":"学生D","content":"嗯，其实……也不算是我知道。是我哥哥告诉我的……他说在那年辛迪加有一个很厉害的组织，叫……","voice":["vo_trial_50504_1_60"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504060,"trial_step":60},{"step":60,"speaker":"学生D","content":"锈火！","voice":["vo_trial_50504_1_61"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504061,"trial_step":61},{"step":61,"content":"此话一出，立刻引爆了寂静的课堂。","style":3,"background":1066,"log_type":1,"src_id":150504062,"trial_step":62},{"step":62,"speaker":"学生A","content":"锈火是那个时候就有的么？","voice":["vo_trial_50504_1_63"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504063,"trial_step":63},{"step":63,"speaker":"学生B","content":"他不会是在胡说吧？","voice":["vo_trial_50504_1_64"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504064,"trial_step":64},{"step":64,"speaker":"学生C","content":"他好像没在乱说，我听说唐大哥似乎也是那时候加入的……","voice":["vo_trial_50504_1_65"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504065,"trial_step":65},{"step":65,"content":"渡鸦连忙拍了拍桌子示意大家安静。","style":3,"background":1066,"log_type":1,"src_id":150504066,"trial_step":66},{"step":66,"content":"接着她便大手一挥，伴着嘶拉的一声——","style":3,"background":1066,"log_type":1,"src_id":150504067,"trial_step":67},{"step":67,"content":"那一页的空白被渡鸦撕掉，乘着风飞到了天空之上。","style":3,"background":1066,"log_type":1,"src_id":150504068,"trial_step":68},{"step":68,"speaker":"渡鸦","content":"很好，这位同学，你回答得非常好。","voice":["vo_trial_50504_1_69"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504069,"trial_step":69},{"step":69,"speaker":"渡鸦","content":"所谓历史呢，就是人们亲身经历过的事情。既然有同学经历过，那便一定是存在的。","voice":["vo_trial_50504_1_70"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504070,"trial_step":70},{"step":70,"speaker":"渡鸦","content":"如果你不认可这段记录，你可以选择把它撕掉。","voice":["vo_trial_50504_1_71"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504071,"trial_step":71},{"step":71,"content":"你在仔细观察着渡鸦的神情，想看出她葫芦里卖的是什么药。","style":3,"background":1066,"log_type":1,"src_id":150504072,"trial_step":72},{"step":72,"content":"但渡鸦没给你时间，继续着她的提问。","style":3,"background":1066,"log_type":1,"src_id":150504073,"trial_step":73},{"step":73,"speaker":"渡鸦","content":"那么N.F.103年发生的大事件又是什么呢？","voice":["vo_trial_50504_1_74"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504074,"trial_step":74},{"step":74,"speaker":"学生B","content":"我知道，是“蚀月行动”！","voice":["vo_trial_50504_1_75"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504075,"trial_step":75},{"step":75,"speaker":"渡鸦","content":"很棒，这位同学查找知识点很快，值得表扬，请坐下吧。","voice":["vo_trial_50504_1_76"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504076,"trial_step":76},{"step":76,"content":"但他并没有坐下。","style":3,"background":1066,"log_type":1,"src_id":150504077,"trial_step":77},{"step":77,"speaker":"渡鸦","content":"这位同学，怎么了？你已经回答完了，为什么还不坐下？","voice":["vo_trial_50504_1_78"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504078,"trial_step":78},{"step":78,"speaker":"学生B","content":"老师，书上没写辛迪加发生的事情，只说了对面城市的事情。","voice":["vo_trial_50504_1_79"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504079,"trial_step":79},{"step":79,"speaker":"渡鸦","content":"哦？是吗？","voice":["vo_trial_50504_1_80"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504080,"trial_step":80},{"step":80,"speaker":"学生B","content":"那一年，我们全家都没有工作了，我的爸爸，我的妈妈，我的姐姐，我……还有我附近的邻居们都一样……但，那年多亏了锈火，我们才得救了！","voice":["vo_trial_50504_1_81"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504081,"trial_step":81},{"step":81,"speaker":"学生C","content":"没错，我们家也是！","voice":["vo_trial_50504_1_82"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504082,"trial_step":82},{"step":82,"speaker":"学生D","content":"我们家也是！","voice":["vo_trial_50504_1_83"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504083,"trial_step":83},{"step":83,"content":"有好几个学生站起来，附和着他。","style":3,"background":1066,"log_type":1,"src_id":150504084,"trial_step":84},{"step":84,"content":"讲台上的渡鸦微微一笑，也一并将书页撕下。","style":3,"background":1066,"log_type":1,"src_id":150504085,"trial_step":85},{"step":85,"speaker":"渡鸦","content":"那么N.F.108年发生的大事件又是什么呢？","voice":["vo_trial_50504_1_86"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504086,"trial_step":86},{"step":86,"speaker":"学生D","content":"是“锈火重建”！","voice":["vo_trial_50504_1_87"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504087,"trial_step":87},{"step":87,"speaker":"学生B","content":"还有辛迪加的英雄“唐”重新回到了锈火！","voice":["vo_trial_50504_1_88"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504088,"trial_step":88},{"step":88,"speaker":"学生D","content":"不对，我怎么听说他背叛过锈火呢！","voice":["vo_trial_50504_1_89"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504089,"trial_step":89},{"step":89,"speaker":"学生B","content":"那你听的肯定是假的，唐只是受伤了，没有背叛！我还听说过他一个很厉害的外号呢，叫——丈二奔雷枪！","voice":["vo_trial_50504_1_90"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504090,"trial_step":90},{"step":90,"content":"渡鸦陆续挑出了十来个年份，每一个年份都有学生回答，也都会有人提出自己的意见，每个学生都将自己所知的历史毫无保留地分享给大家。","style":3,"background":1066,"log_type":1,"src_id":150504091,"trial_step":91},{"step":91,"content":"——","style":3,"background":1066,"log_type":1,"src_id":150504092,"trial_step":92},{"step":92,"content":"下课铃声很快便打断了这场激烈的讨论，一页又一页的纸张飞向了辛迪加的天空，一整本的历史教材也只剩下了封面。","style":3,"background":1066,"log_type":1,"src_id":150504093,"trial_step":93},{"step":93,"content":"孩子们给你的惊喜怎么样？","style":2,"background":915,"log_type":1,"src_id":150504095,"trial_step":95},{"step":94,"speaker":"渡鸦","content":"你说得对，是得给他们一次机会。这些学生拯救了我，他们是这个时代的遗孤，就算知道真相，却也永远光明地看待未来。","voice":["vo_trial_50504_1_96"],"voice_bank":"vo_raven_trial","style":1,"background":915,"log_type":1,"src_id":150504096,"trial_step":96},{"step":95,"speaker":"渡鸦","content":"这里的所有孩子都知道自己生在什么地方，什么时代。但这里没有人抱怨，所有人都希望自己的历史被他人所铭记。","voice":["vo_trial_50504_1_97"],"voice_bank":"vo_raven_trial","style":1,"background":915,"log_type":1,"src_id":150504097,"trial_step":97},{"step":96,"speaker":"渡鸦","content":"太好了，火与灰之上开出了最耀眼的花朵，所有的一切都是值得的。","voice":["vo_trial_50504_1_98"],"voice_bank":"vo_raven_trial","style":1,"background":915,"log_type":1,"src_id":150504098,"trial_step":98},{"step":97,"speaker":"渡鸦","content":"每个人的未来都清晰可见，西区人的未来从来没有如此光明过。","voice":["vo_trial_50504_1_99"],"voice_bank":"vo_raven_trial","style":1,"background":915,"log_type":1,"src_id":150504099,"trial_step":99},{"step":98,"speaker":"渡鸦","content":"如今，那些让人痛苦的过去已经过去，让我们一起展望未来吧。","voice":["vo_trial_50504_1_100"],"voice_bank":"vo_raven_trial","style":1,"background":915,"log_type":1,"src_id":150504100,"trial_step":100},{"step":99,"options":["是啊"],"style":6,"background":915,"log_type":1,"src_id":150504101,"trial_step":101,"course":3,"choices":[{"text":"是啊","goto":102}]},{"step":100,"speaker":"渡鸦","content":"啊，不过在这之前，这批历史教材的钱可以找你报销了不？","voice":["vo_trial_50504_1_102"],"voice_bank":"vo_raven_trial","style":1,"background":915,"log_type":1,"src_id":150504102,"trial_step":102},{"step":101,"speaker":"渡鸦","content":"我要重写一批，再复印个几百份，钱算在你头上应该没问题吧，辛迪加大学堂的名誉校长？","voice":["vo_trial_50504_1_103"],"voice_bank":"vo_raven_trial","style":1,"background":915,"log_type":1,"src_id":150504103,"trial_step":103},{"step":102,"speaker":"玩家","content":"……","style":2,"background":915,"log_type":1,"src_id":150504104,"trial_step":104},{"step":103,"speaker":"学生A","content":"明天有什么课？","voice":["vo_trial_50504_1_106"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504106,"trial_step":106},{"step":104,"speaker":"学生C","content":"上数学课上糊涂了么你？肯定是诗歌课啊。","voice":["vo_trial_50504_1_107"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504107,"trial_step":107},{"step":105,"speaker":"学生A","content":"啊……是啊，数学真的好难，还好洛夫娜老师一直耐心在教我……","voice":["vo_trial_50504_1_108"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504108,"trial_step":108},{"step":106,"speaker":"学生C","content":"瑞文老师和洛夫娜老师居然都是那个时代的人，经历了那种事情还能站在这里给我们上课……真是太神奇了。","voice":["vo_trial_50504_1_109"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504109,"trial_step":109},{"step":107,"speaker":"学生A","content":"是啊，我以后也想要成为瑞文老师那样的人。在无尽的黑暗之中探寻光明！听上去就觉得帅！","voice":["vo_trial_50504_1_110"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504110,"trial_step":110},{"step":108,"speaker":"学生C","content":"你可算了吧，我可不想再经历一次那种连饭都吃不饱的日子了。","voice":["vo_trial_50504_1_111"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504111,"trial_step":111},{"step":109,"speaker":"学生A","content":"嘿嘿，说说而已嘛。毕竟之前瑞文老师在课上说过，遗忘，就是背叛。","voice":["vo_trial_50504_1_112"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504112,"trial_step":112},{"step":110,"speaker":"学生C","content":"只有记住过去痛苦的日子，才会努力走向未来嘛！","voice":["vo_trial_50504_1_113"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504113,"trial_step":113},{"step":111,"speaker":"学生A","content":"对了，你知道有时候总坐在最后一排那个人是谁么？是瑞文老师的熟人么？","voice":["vo_trial_50504_1_114"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504114,"trial_step":114},{"step":112,"speaker":"学生C","content":"何止是熟人！我可是听说两个人总一起吃饭呢，还坐一辆车！","voice":["vo_trial_50504_1_115"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504115,"trial_step":115},{"step":113,"speaker":"学生A","content":"啊？那他们到……哎呦——","female_content":"啊？那她们到……哎呦——","voice":["vo_trial_50504_1_116"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504116,"trial_step":116},{"step":114,"content":"他的话还没说完，便被一颗粉笔头打中了脑门。","style":1,"background":1066,"log_type":1,"src_id":150504117,"trial_step":117},{"step":115,"speaker":"渡鸦","content":"那边两个，在偷偷说什么见不得人的话呢？","voice":["vo_trial_50504_1_118"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504118,"trial_step":118},{"step":116,"content":"两个调皮的学生吓得一哆嗦。","style":3,"background":1066,"log_type":1,"src_id":150504119,"trial_step":119},{"step":117,"speaker":"学生A","content":"咳，瑞文老师……我们在说您厉害呢！","voice":["vo_trial_50504_1_120"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504120,"trial_step":120},{"step":118,"speaker":"学生C","content":"嗯……嗯嗯！","voice":["vo_trial_50504_1_121"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504121,"trial_step":121},{"step":119,"speaker":"渡鸦","content":"呵呵……这样么，那你们两个就给我背诵一下《敬未来》吧。","voice":["vo_trial_50504_1_122"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504122,"trial_step":122},{"step":120,"speaker":"渡鸦","content":"背漏一个字就会有惩罚哦，毕竟那可是我的得意之作。","voice":["vo_trial_50504_1_123"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504123,"trial_step":123},{"step":121,"content":"我在辛迪加的土地，见证绝望，也见证希望","voice":["vo_trial_50504_1_125"],"voice_bank":"vo_raven_trial","style":3,"background":50840,"is_centered":true,"log_type":1,"src_id":150504125,"trial_step":125},{"step":122,"content":"沉醉黑暗，也追寻光明","voice":["vo_trial_50504_1_126"],"voice_bank":"vo_raven_trial","style":3,"background":50821,"is_centered":true,"log_type":1,"src_id":150504126,"trial_step":126},{"step":123,"content":"撰写诗篇，也化为诗篇","voice":["vo_trial_50504_1_127"],"voice_bank":"vo_raven_trial","style":3,"background":50822,"is_centered":true,"log_type":1,"src_id":150504127,"trial_step":127},{"step":124,"content":"为敬那些——锈烬中复燃的火","voice":["vo_trial_50504_1_128"],"voice_bank":"vo_raven_trial","style":3,"background":50811,"is_centered":true,"log_type":1,"src_id":150504128,"trial_step":128},{"step":125,"content":"朽林里咆哮的风","voice":["vo_trial_50504_1_132"],"voice_bank":"vo_raven_trial","style":3,"background":50403,"is_centered":true,"log_type":1,"src_id":150504132,"trial_step":132},{"step":126,"content":"敬暴雨中振翅的燕，淤泥里怒放的花","voice":["vo_trial_50504_1_136"],"voice_bank":"vo_raven_trial","style":3,"background":56,"is_centered":true,"log_type":1,"src_id":150504136,"trial_step":136},{"step":127,"content":"敬理想","voice":["vo_trial_50504_1_140"],"voice_bank":"vo_raven_trial","style":3,"background":50102,"is_centered":true,"log_type":1,"src_id":150504140,"trial_step":140},{"step":128,"content":"敬希望","voice":["vo_trial_50504_1_145"],"voice_bank":"vo_raven_trial","style":3,"background":50820,"is_centered":true,"log_type":1,"src_id":150504145,"trial_step":145},{"step":129,"content":"敬","voice":["vo_trial_50504_1_151"],"voice_bank":"vo_raven_trial","style":3,"background":50837,"is_centered":true,"log_type":1,"src_id":150504151,"trial_step":151},{"step":130,"content":"——未来","voice":["vo_trial_50504_1_163"],"voice_bank":"vo_raven_trial","style":3,"background":1002,"is_centered":true,"log_type":1,"src_id":150504163,"trial_step":163},{"step":131,"speaker":"科希","content":"不过我怎么听说这篇诗本来就没写完呢？","voice":["vo_trial_50504_1_166"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504166,"trial_step":166},{"step":132,"speaker":"科希","content":"你说对吧，原作者？打算什么时候把它补全啊？","voice":["vo_trial_50504_1_167"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504167,"trial_step":167},{"step":133,"content":"流浪儿的首领自阴影中走出，微笑着看着眼前不靠谱的老师。","style":1,"background":1066,"log_type":1,"src_id":150504168,"trial_step":168},{"step":134,"speaker":"渡鸦","content":"哈哈……那个？要不，再说吧？","voice":["vo_trial_50504_1_169"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504169,"trial_step":169},{"step":135,"speaker":"渡鸦","content":"毕竟未来的辛迪加，只会有更多的英雄传说，我可写不过来咯！","voice":["vo_trial_50504_1_170"],"voice_bank":"vo_raven_trial","style":1,"background":1066,"log_type":1,"src_id":150504170,"trial_step":170}]}