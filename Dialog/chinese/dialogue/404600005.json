{"id":404600005,"chapter_id":220100,"scene_id":701,"steps":[{"step":1,"content":"一座残破的石碑突兀地出现在你眼前。","style":3,"background":2559,"log_type":1},{"step":2,"options":["是这里吗？"],"jump":[3],"style":6,"background":2559,"log_type":1},{"step":3,"content":"你向前探查，但突然，大片红色的光芒从石碑下方蔓延而出，带着某种不祥的气息，将你禁锢在原地。","style":3,"background":2559,"log_type":1},{"step":4,"content":"一个巨大的无法名状的身影从石碑后慢慢爬了起来。它背对着你，肢体扭曲，却伸展自如。","style":3,"background":2559,"log_type":1},{"step":5,"content":"它扭动起自己的脖颈，转，转，转。","style":3,"background":2559,"log_type":1},{"step":6,"content":"一双散发着诡异红光的眼睛，望向了你。","style":3,"background":2559,"log_type":1}]}