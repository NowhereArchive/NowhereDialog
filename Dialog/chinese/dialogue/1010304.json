{"id":1010304,"chapter_id":1010304,"scene_id":1,"steps":[{"step":1,"speaker":"瓦尔纳","content":"……罗睺。","voice":["vo_trial_10304_1_1"],"voice_bank":"vo_rahu_trial","style":1,"background":2095,"log_type":1,"src_id":110304001,"trial_step":1},{"step":2,"speaker":"瓦尔纳","content":"罗睺？","voice":["vo_trial_10304_1_2"],"voice_bank":"vo_rahu_trial","style":1,"background":2095,"log_type":1,"src_id":110304002,"trial_step":2},{"step":3,"speaker":"瓦尔纳","content":"罗睺！","voice":["vo_trial_10304_1_3"],"voice_bank":"vo_rahu_trial","style":1,"background":2095,"log_type":1,"src_id":110304003,"trial_step":3},{"step":4,"content":"罗睺猛然回过神，发现队长正在叫自己。","style":3,"background":2095,"log_type":1,"src_id":110304004,"trial_step":4},{"step":5,"speaker":"罗睺","content":"是！长官！","voice":["vo_trial_10304_1_4"],"voice_bank":"vo_rahu_trial","style":1,"background":2095,"log_type":1,"src_id":110304005,"trial_step":5},{"step":6,"speaker":"瓦尔纳","content":"你分神了。","voice":["vo_trial_10304_1_5"],"voice_bank":"vo_rahu_trial","style":1,"background":2095,"log_type":1,"src_id":110304006,"trial_step":6},{"step":7,"speaker":"罗睺","content":"长官，我刚刚在想……","voice":["vo_trial_10304_1_6"],"voice_bank":"vo_rahu_trial","style":1,"background":2095,"log_type":1,"src_id":110304007,"trial_step":7},{"step":8,"speaker":"瓦尔纳","content":"我不需要知道你在想什么。你的模拟作战任务是保护指挥官。","voice":["vo_trial_10304_1_7"],"voice_bank":"vo_rahu_trial","style":1,"background":2095,"log_type":1,"src_id":110304008,"trial_step":8},{"step":9,"speaker":"瓦尔纳","content":"现在，因为你的疏忽，你的“指挥官”阵亡。你辜负了自己的责任。","voice":["vo_trial_10304_1_8"],"voice_bank":"vo_rahu_trial","style":1,"background":2095,"log_type":1,"src_id":110304009,"trial_step":9},{"step":10,"speaker":"罗睺","content":"抱歉……","voice":["vo_trial_10304_1_9"],"voice_bank":"vo_rahu_trial","style":1,"background":2095,"log_type":1,"src_id":110304010,"trial_step":10},{"step":11,"speaker":"瓦尔纳","content":"道歉能换回指挥官的命么？","voice":["vo_trial_10304_1_10"],"voice_bank":"vo_rahu_trial","style":1,"background":2095,"log_type":1,"src_i