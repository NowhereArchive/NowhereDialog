er":"瓦尔纳","content":"嗯……","voice":["vo_trial_10304_1_41"],"voice_bank":"vo_rahu_trial","style":1,"background":2114,"log_type":1,"src_id":110304045,"trial_step":45},{"step":44,"speaker":"瓦尔纳","content":"罗睺，你不在的这段时间，G47小队经历了几次苦战。","voice":["vo_trial_10304_1_42"],"voice_bank":"vo_rahu_trial","style":1,"background":2114,"log_type":1,"src_id":110304046,"trial_step":46},{"step":45,"speaker":"瓦尔纳","content":"约拿和谢尔顿……他们没能挺下来。康拉德也受了伤，会缺席一段时间。这让我不得不考虑队伍的将来。","voice":["vo_trial_10304_1_43"],"voice_bank":"vo_rahu_trial","style":1,"background":2114,"log_type":1,"src_id":110304047,"trial_step":47},{"step":46,"content":"罗睺看向康拉德，他的腿上打着石膏。","style":3,"background":2114,"log_type":1,"src_id":110304048,"trial_step":48},{"step":47,"speaker":"瓦尔纳","content":"如果我出什么意外，就由你来接任队长。","voice":["vo_trial_10304_1_44"],"voice_bank":"vo_rahu_trial","style":1,"background":2114,"log_type":1,"src_id":110304049,"trial_step":49},{"step":48,"speaker":"罗睺","content":"不。","voice":["vo_trial_10304_1_45"],"voice_bank":"vo_rahu_trial","style":1,"background":2114,"log_type":1,"src_id":110304050,"trial_step":50},{"step":49,"speaker":"罗睺","content":"你要一直领导G47小队，我会保护你。","voice":["vo_trial_10304_1_46"],"voice_bank":"vo_rahu_trial","style":1,"background":2114,"log_type":1,"src_id":110304051,"trial_step":51},{"step":50,"content":"瓦尔纳有些无可奈何。","style":3,"background":2114,"log_type":1,"src_id":110304052,"trial_step":52},{"step":51,"speaker":"瓦尔纳","content":"现实一点，罗睺。FAC的人迟早都要死在战场上。我从来没觉得自己会是例外。","voice":["vo_trial_10304_1_47"],"voice_bank":"vo_rahu_trial","style":1,"background":2114,"log_type":1,"src_id":110304053,"trial_step":53},{"step":52,"speaker":"罗睺","content":"……我还没准备好。你一直都是队长。","voice":["vo_trial_10304_1_48"],"voice_bank":"vo_rahu_trial","style":1,"background":2114,"log_type":1,"src_id":110304054,"trial_step":54},{"step":53,"speaker":"瓦尔纳","content":"那就现在开始准备。","voice":["vo_trial_10304_1_49"],"voice_bank":"vo_rahu_trial","style":1,"background":2114,"log_type":1,"src_id":110304055,"trial_step":55},{"step":54,"spe