{"id":8071,"chapter_id":8,"scene_id":807,"steps":[{"step":1,"speaker":"海拉","content":"我们没走错道儿吧？","voice":["vo_cgplot_8071001"],"voice_bank":"vo_cgplot_08","style":1,"background":701,"log_type":1},{"step":2,"speaker":"选项","options":["不可能走错的"],"jump":[3],"style":6,"background":701,"log_type":1},{"step":3,"content":"摩天轮点亮了彩灯，播放着欢乐，在黑环赤光之下、群魔嘶鸣之中缓缓旋转，隐约看到黑色的触须在舞动。","style":3,"background":701,"log_type":1},{"step":4,"content":"如此张扬，如此荒诞，简直是给你的邀请函。","style":3,"background":701,"log_type":1},{"step":5,"speaker":"“哈梅尔”","content":"来呀，来我身边……我知道你的痛苦，恐惧，和空虚，我给你编织好最美的乐园……","voice":["vo_cgplot_8071005"],"voice_bank":"vo_cgplot_08","style":1,"background":701,"log_type":1},{"step":6,"content":"“哈梅尔”的笑声飘荡在整个乐园，直接传递到每个人的心里。","style":3,"background":701,"log_type":1},{"step":7,"speaker":"怪群","content":"是哈梅尔……哈梅尔……","voice":["vo_cgplot_8071007"],"voice_bank":"vo_cgplot_08","style":1,"background":701,"log_type":1},{"step":8,"speaker":"“哈梅尔”","content":"狂欢已经开始，嘉年华会给你一切，你只要爱我就行了——","voice":["vo_cgplot_8071008"],"voice_bank":"vo_cgplot_08","style":1,"background":701,"log_type":1},{"step":9,"speaker":"怪群","content":"填补我……救赎我……我爱你……哈梅尔……","voice":["vo_cgplot_8071009"],"voice_bank":"vo_cgplot_08","style":1,"background":701,"log_type":1},{"step":10,"content":"怪群虔诚地匍匐着前进，像浪潮般一阵阵接近诡异的摩天轮，等待着远方的黑暗将自己吞噬。","style":3,"background":701,"log_type":1},{"step":11,"content":"它们涌向黑环的主人，堵住了所有通往摩天轮的路。","style":3,"background":701,"log_type":1},{"step":12,"speaker":"赫卡蒂","content":"这就是<color=#fb9259>启迪特化</color>的力量，它对别人造成的精神干涉远强于其他禁闭者。在这样的黑环里，她比卓娅更加危险。","voice":["vo_cgplot_8071012"],"voice_bank":"vo_cgplot_08","style":1,"background":701,"log_type":1},{"step":13,"speaker":"赫卡蒂","content":"嘉年华里的所有人都被蛊惑了，走到游行的尽头，只会被她吞噬。","voice":["vo_cgplot_8071013"],"voice_bank":"vo_cgplot_08","style":1,"background":701,"log_type":1},{"step":14,"speaker":"赫卡蒂","content":"局长，你经历了持续的精神攻击，又被那个男人的黑焰直接伤害过。还撑得住吗？","voice":["vo_cgplot_8071014"],"voice_bank":"vo_cgplot_08","style":1,"background":701,"log_type":1},{"step":15,"speaker":"选项","options":["撑得住，不能再拖了"],"jump":[16],"style":6,"background":701,"log_type":1},{"step":16,"speaker":"${PlayerName}","content":"尽快，要在她成长到不可战胜之前，拔除骸。","style":2,"background":701,"log_type":1},{"step":17,"speaker":"赫卡蒂","content":"……明白。海拉，准备战斗。","voice":["vo_cgplot_8071017"],"voice_bank":"vo_cgplot_08","style":1,"background":701,"log_type":1},{"step":18,"speaker":"赫卡蒂","content":"你决定要前进的道路，我们为你打开。","voice":["vo_cgplot_8071018"],"voice_bank":"vo_cgplot_08","style":1,"background":701,"log_type":1}]}