{"id":17002,"chapter_id":17,"scene_id":1701,"steps":[{"step":1,"content":"临上车前，你停下脚步。总觉得身后、水晶宫的方向传来什么声音。","style":3,"background":2415,"log_type":1},{"step":2,"speaker":"选项","options":["出什么事了吗？"],"jump":[3],"style":6,"background":2415,"log_type":1},{"step":3,"speaker":"黑石英","content":"您指MBCC局长从万国会上重金买下一个禁闭者吗？","style":1,"background":2415,"log_type":1},{"step":4,"speaker":"黑石英","content":"更正，是收到贿赂，再更正，收到礼物。","style":1,"background":2415,"log_type":1},{"step":5,"speaker":"${PlayerName}","content":"你可真“幽默”。","style":2,"background":2415,"log_type":1},{"step":6,"speaker":"黑石英","content":"请放心，万国会最重要的首日开幕已经顺利完成，剩下的有FAC和便衣们看着呢。您可以回去休息了。","style":1,"background":2415,"log_type":1},{"step":7,"content":"你笑笑，终于还是上了车。","style":3,"background":2415,"log_type":1},{"step":8,"content":"——大概刚刚真的是错觉吧。","style":3,"background":2415,"log_type":1},{"step":9,"content":"【转场】","style":18,"background":2398,"log_type":1},{"step":10,"content":"红衣女人回到原地，她带来的客人、西比拉已经不见了。","style":3,"background":2398,"log_type":1},{"step":11,"speaker":"护卫","content":"抱歉，被她逃掉了。我们尽快追查。","voice":["vo_cgplot_17002016"],"voice_bank":"vo_cgplot_1700","style":1,"background":2398,"log_type":1},{"step":12,"content":"她俯身，挑起留在地上的麻绳，那是捆客人用的，如今被生生磨断，不少地方还沾了血。","style":3,"background":2398,"log_type":1},{"step":13,"content":"这让她多了些赞赏。","style":3,"background":2398,"log_type":1},{"step":14,"speaker":"红衣女人","content":"才几分钟的骚动，她就能抓住机会逃出去，是个人才。","voice":["vo_cgplot_17002017"],"voice_bank":"vo_cgplot_1700","style":1,"background":2398,"log_type":1},{"step":15,"speaker":"红衣女人","content":"去找她，但不用把人带回来。","voice":["vo_cgplot_17002018"],"voice_bank":"vo_cgplot_1700","style":1,"background":2398,"log_type":1},{"step":16,"content":"护卫点头，心领神会地去了。","style":3,"background":2398,"log_type":1}]}