{"id":404320201,"chapter_id":50088,"scene_id":58873,"steps":[{"step":1,"content":"【外景】","style":18,"background":2511,"log_type":1},{"step":2,"content":"你匆匆赶到了庄园门口，正遇上那名信使离开，那封要命的信件落在了门口的守卫手里。","style":3,"background":2511,"log_type":1},{"step":3,"content":"但面对你的要求，这名守卫丝毫没有动摇，恪守职责。","style":3,"background":2511,"log_type":1},{"step":4,"speaker":"守卫","content":"长官命令过，所有情报信件都必须直接传递给她，不能中途转交给任何人。","voice":["vo_event_404320201_01"],"voice_bank":"vo_event_43202","style":1,"background":2511,"log_type":1},{"step":5,"content":"你眼看着守卫将信件送进了大厅。","style":3,"background":2511,"log_type":1},{"step":6,"content":"【转场、希露妲房间】","style":18,"background":2506,"log_type":1},{"step":7,"content":"很快你就被带进了希露妲的房间。","style":3,"background":2506,"log_type":1},{"step":8,"content":"她先是询问你，得不到回应后便质问你，最后终于失望地开始审问你。","style":3,"background":2506,"log_type":1},{"step":9,"content":"在自白剂的作用下，你也不知道自己都说了些什么。","style":3,"background":2506,"log_type":1},{"step":10,"content":"但没关系……","style":3,"background":2506,"log_type":1},{"step":11,"content":"你恍惚地想。","style":3,"background":2506,"log_type":1},{"step":12,"content":"等到下次再见面的时候，她什么都不会记得，你们又将重新相遇。","style":3,"background":2506,"log_type":1}]}