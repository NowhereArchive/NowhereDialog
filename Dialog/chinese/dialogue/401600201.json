{"id":401600201,"chapter_id":30001,"scene_id":30005,"steps":[{"step":1,"speaker":"艾米潘","content":"累……累死我了，总算……","style":1,"background":66,"log_type":1},{"step":2,"speaker":"露莉艾卡","content":"总算完工了！","style":1,"background":66,"log_type":1},{"step":3,"speaker":"露莉艾卡","content":"和记忆里的一模一样……","style":1,"background":66,"log_type":1},{"step":4,"speaker":"嗷呜","content":"哇，好漂亮！黄毛，你也有厉害的地方嘛！","style":1,"background":66,"log_type":1},{"step":5,"speaker":"嗷呜","content":"场记场记，你快来看！","style":1,"background":66,"log_type":1},{"step":6,"content":"听到嗷呜的呼唤，你拿着手里的玩偶走了过去。","style":3,"background":66,"log_type":1},{"step":8,"content":"眼前精致的舞台让你感到有些惊讶，嗷呜看到你的表情，骄傲地叉起腰仰起头。","style":3,"background":2175,"log_type":1},{"step":9,"speaker":"嗷呜","content":"怎么样，嗷呜是不是很厉害！","style":1,"background":2175,"log_type":1},{"step":10,"speaker":"${PlayerName}","content":"确实厉害，没想到你们竟然搞得像模像样的。","style":2,"background":2175,"log_type":1},{"step":11,"speaker":"艾米潘","content":"明明全是我搭的，你在那里骄傲什么！","style":1,"background":2175,"log_type":1},{"step":12,"speaker":"露莉艾卡","content":"哎呀，局长的玩偶也都做好了！","style":1,"background":2175,"log_type":1},{"step":13,"speaker":"露莉艾卡","content":"不愧是局长，完美还原了角色的特征，这下我们的小剧场一定可以闪爆全场，成为最受欢迎的节目！","style":1,"background":2175,"log_type":1},{"step":14,"speaker":"嗷呜","content":"喔——闪爆全场！最受欢迎！","style":1,"background":2175,"log_type":1},{"step":15,"speaker":"露莉艾卡","content":"局长就好好期待吧！","style":1,"background":2175,"log_type":1},{"step":16,"content":"嗷呜和露莉艾卡干劲满满地把瘫坐在地的艾米潘拽上舞台，抱着玩偶们在舞台上筹划。你也被她们的开心感染，露出了笑容。","style":3,"background":2175,"log_type":1},{"step":17,"speaker":"${PlayerName}","content":"嗯，我很期待。","style":2,"background":2175,"log_type":1}]}