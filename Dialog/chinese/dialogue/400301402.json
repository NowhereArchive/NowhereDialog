{"id":400301402,"chapter_id":50014,"scene_id":51404,"steps":[{"step":1,"content":"艺术馆深处突然传来一阵又一阵的鼓动。","style":3,"background":2025,"log_type":1},{"step":2,"speaker":"赫卡蒂","content":"这幅画……为什么会有这么强大的力量……","voice":["vo_event_03014_34"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":3,"speaker":"赫卡蒂","content":"它……就好像……在读取我的精神……","voice":["vo_event_03014_35"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":4,"speaker":"？？？","content":"他已经死了他已经死了他已经死了——","female_content":"她已经死了她已经死了她已经死了——","voice":["vo_event_03014_36"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":5,"content":"赫卡蒂痛苦地抱住自己的额头。","style":3,"background":2025,"log_type":1},{"step":6,"speaker":"？？？","content":"放弃吧……放弃吧……你没办法——","voice":["vo_event_03014_38"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":7,"speaker":"大丽花导览","content":"它是恐惧之画，会唤醒人们内心的恐惧。","voice":["vo_event_03014_39"],"voice_bank":"vo_event_03_p1b","style":11,"background":2025,"log_type":1},{"step":8,"speaker":"大丽花导览","content":"它会唤醒人们对失去归宿的恐惧，每个人……都会看到不一样的东西。","voice":["vo_event_03014_40"],"voice_bank":"vo_event_03_p1b","style":11,"background":2025,"log_type":1},{"step":9,"speaker":"大丽花导览","content":"比如……她。","voice":["vo_event_03014_41"],"voice_bank":"vo_event_03_p1b","style":11,"background":2025,"log_type":1},{"step":10,"speaker":"雷比尼斯","content":"战斗形态……战斗形态……战斗形态……","voice":["vo_event_03014_42"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":11,"speaker":"赫卡蒂","content":"雷比尼斯！你怎么了？！","voice":["vo_event_03014_43"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":12,"speaker":"赫卡蒂","content":"！……难道，那幅画对你——","voice":["vo_event_03014_44"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":13,"content":"在黑影被逐个击破后，艺术馆内没有像预想中恢复到原来的模样。","style":3,"background":2025,"log_type":1},{"step":14,"content":"而是变得更加狂暴。","style":3,"background":2025,"log_type":1},{"step":15,"content":"有一丝微小的声响钻入了雷比尼斯的脑海。","style":3,"background":2025,"log_type":1},{"step":16,"content":"只有一丝。","style":3,"background":2025,"log_type":1},{"step":17,"speaker":"？？","content":"你来了。","voice":["vo_event_03014_49"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":18,"speaker":"雷比尼斯","content":"……？","style":1,"background":2025,"log_type":1},{"step":19,"speaker":"？？","content":"我还以为，你早就把我给忘了呢。","voice":["vo_event_03014_51"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":20,"speaker":"雷比尼斯","content":"玛……丽……？","voice":["vo_event_03014_52"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":21,"speaker":"？？","content":"哈哈……你居然，想得起这个名字么？","voice":["vo_event_03014_53"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":22,"speaker":"雷比尼斯","content":"玛丽……玛丽？","voice":["vo_event_03014_54"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":23,"speaker":"雷比尼斯","content":"你……是谁？我……又是谁？","voice":["vo_event_03014_55"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":24,"content":"一幕又一幕的画面在雷比尼斯的脑海内闪烁。","style":3,"background":10000,"log_type":1},{"step":25,"content":"午后的餐馆，怡人的香气。","style":3,"background":1005,"log_type":1},{"step":26,"content":"帮派，混乱，打斗，恐惧，暴徒。","style":3,"background":1008,"log_type":1},{"step":27,"content":"来不及的行动……还有，来不及的道歉。","style":3,"background":1029,"log_type":1},{"step":28,"content":"因为自己，没错，都是因为自己。","style":3,"background":1029,"log_type":1},{"step":29,"speaker":"“玛丽”","content":"你是……忘记一切的骗子，不守信用的骗子——雷比尼斯。","voice":["vo_event_03014_70"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":30,"speaker":"“玛丽”","content":"这样吧……久别重逢也不容易。我就再给你一次机会……消灭这里所有的敌人。","voice":["vo_event_03014_71"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":31,"speaker":"“玛丽”","content":"这是作为你主人的……玛丽的命令。","voice":["vo_event_03014_73"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":32,"speaker":"赫卡蒂","content":"这里没有玛丽……你清醒一点！","voice":["vo_event_03014_56"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":33,"content":"赫卡蒂强忍着头痛，准备靠近雷比尼斯。","style":3,"background":2025,"log_type":1},{"step":34,"speaker":"雷比尼斯","content":"准备启动，准备启动。","voice":["vo_event_03014_58"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":35,"speaker":"雷比尼斯","content":"战斗形态启动。","voice":["vo_event_03014_59"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":36,"speaker":"雷比尼斯","content":"不够……完全不够……","voice":["vo_event_03014_60"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":37,"speaker":"雷比尼斯","content":"不够消灭它们，完全不够。","voice":["vo_event_03014_61"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":38,"content":"雷比尼斯的身体噼啪作响，她的禁闭者能量正在不受控制地汹涌溢出。","style":3,"background":2025,"log_type":1},{"step":39,"speaker":"雷比尼斯","content":"“过载模式”准备启动，“过载模式”准备启动。","voice":["vo_event_03014_62"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":40,"speaker":"莎夏","content":"哇！好帅！这才是禁闭者应该有的样子！浑身都在发红光诶！","voice":["vo_event_03014_63"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":41,"speaker":"赫卡蒂","content":"快闪开！","voice":["vo_event_03014_64"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":42,"content":"梦魇推开了莎夏，同时也结结实实地挨了雷比尼斯的好几下攻击。","style":3,"background":2025,"log_type":1},{"step":43,"speaker":"雷比尼斯","content":"消灭……消灭……消灭一切，玛丽的敌人。","voice":["vo_event_03014_66"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":44,"speaker":"雷比尼斯","content":"我不会再让玛丽，被你们伤害了！","voice":["vo_event_03014_67"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":45,"speaker":"雷比尼斯","content":"保护玛丽……是我的使命！","voice":["vo_event_03014_68"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":46,"speaker":"雷比尼斯","content":"过载模式，启动！","voice":["vo_event_03014_69"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1}]}