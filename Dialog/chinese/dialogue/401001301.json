{"id":401001301,"chapter_id":50025,"scene_id":52507,"steps":[{"step":1,"content":"洋房正门","style":12,"background":2094,"log_type":1},{"step":2,"speaker":"怯懦的警卫","content":"又被袭击了吗？听说好多地方都出事了，这一波怎么来得这么快？","voice":["vo_event_401001301_2"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":3,"speaker":"焦躁的警卫","content":"嘘！别分心，别吵，盯好每个角落，刺客随时可能闯进来。","voice":["vo_event_401001301_3"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":4,"speaker":"怯懦的警卫","content":"我们盯着能有什么用？对面可是禁闭者刺客，是怪物。","voice":["vo_event_401001301_4"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":5,"speaker":"怯懦的警卫","content":"FAC的人呢？不是说有人会保证这里的安全吗？她怎么还没来？","voice":["vo_event_401001301_5"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":6,"content":"罗睺并不急着进入，毕竟自己没有“资格”。昨晚花了些时间摸清这建筑的结构，她找了个隐蔽的角落，关注着屋内动静，等待一个时机——","style":3,"background":2094,"log_type":1},{"step":7,"content":"时机很快就来了。","style":3,"background":2094,"log_type":1},{"step":8,"speaker":"怯懦的警卫","content":"啊——！！","voice":["vo_event_401001301_8"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":9,"speaker":"焦躁的警卫","content":"刺客！是刺客！！！刺客闯进洋房了！！！救命啊——！！","voice":["vo_event_401001301_9"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1},{"step":10,"content":"就是现在——","style":3,"background":2094,"log_type":1},{"step":12,"content":"罗睺跃起闯入院落。警卫们看罗睺的眼神早没了厌恶与拒绝，尖叫着向她求救，全然顾不上质疑这个“不合规矩的闯入”，以及英雄略晚的救场。","style":3,"background":2094,"log_type":1},{"step":13,"content":"洋房大门还未被攻破，入侵者就在眼前。那个刺客巧妙地藏起长相，但见到罗睺的瞬间，那人惊讶憎恶的情感显露无疑。","style":3,"background":2094,"log_type":1},{"step":14,"speaker":"阴影中的刺客","content":"……又是你，FAC！","voice":["vo_event_401001301_13"],"voice_bank":"vo_event_10013","style":1,"background":2094,"log_type":1}]}