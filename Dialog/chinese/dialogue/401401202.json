{"id":401401202,"chapter_id":50050,"scene_id":55003,"steps":[{"step":2,"speaker":"伊芙","content":"差点忘了，要给骨头准备生日礼物。","voice":["vo_event_401401202_1"],"voice_bank":"vo_event_14012","style":1,"background":2161,"log_type":1},{"step":3,"speaker":"伊芙","content":"小狗会喜欢什么呢……","voice":["vo_event_401401202_2"],"voice_bank":"vo_event_14012","style":1,"background":2161,"log_type":1},{"step":4,"speaker":"伊芙","content":"看来，得去一趟仓库才行。","voice":["vo_event_401401202_3"],"voice_bank":"vo_event_14012","style":1,"background":2161,"log_type":1},{"step":6,"content":"女孩把怀里的一只铁皮小狗、一个洋娃娃还有一个套娃依次安放在办公桌边，转动轮椅离开，完全没有要让身边那个人帮忙的意思，嘴里念叨着“骨头”“礼物”“生日”……","style":3,"background":2161,"log_type":1},{"step":8,"speaker":"奥利弗","content":"车间好像热闹起来了，不用管吗？","voice":["vo_event_401401202_5"],"voice_bank":"vo_event_14012","style":1,"background":2161,"log_type":1},{"step":9,"speaker":"奥利弗","content":"似乎是新来的玩具惹出麻烦了喔~","voice":["vo_event_401401202_6"],"voice_bank":"vo_event_14012","style":1,"background":2161,"log_type":1},{"step":10,"content":"女孩没有搭话，来到门边，轻轻擦了擦门把手上的灰尘。","style":3,"background":2161,"log_type":1},{"step":11,"speaker":"奥利弗","content":"伊……伊芙？","voice":["vo_event_401401202_8"],"voice_bank":"vo_event_14012","style":1,"background":2161,"log_type":1},{"step":12,"speaker":"伊芙","content":"生日会就要开始了，巴斯和本纳去哪里了？","voice":["vo_event_401401202_9"],"voice_bank":"vo_event_14012","style":1,"background":2161,"log_type":1},{"step":13,"speaker":"伊芙","content":"和他们说了很多次了，今后不必每天都工作的，留在我身边就好。","voice":["vo_event_401401202_10"],"voice_bank":"vo_event_14012","style":1,"background":2161,"log_type":1},{"step":14,"speaker":"伊芙","content":"奥利弗，去帮我把巴斯和本纳找回来吧？","voice":["vo_event_401401202_11"],"voice_bank":"vo_event_14012","style":1,"background":2161,"log_type":1}]}