{"id":2031,"chapter_id":2,"scene_id":203,"steps":[{"step":1,"speaker":"“728”","content":"很好——很好————我感觉很好！力量在涌现，我要复仇！我要复仇！！哈哈哈！","voice":["vo_cgplot_2031001"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":2,"content":"你摁住“728”的手臂，你的手心灼热得发烫，但这并不是枷锁的感觉，他和禁闭者不一样——","style":3,"background":105,"log_type":1},{"step":3,"content":"制约禁闭者时，沿着枷锁，你总能听到某种声音，某种穿透黑暗的呼喊。","style":3,"background":105,"log_type":1},{"step":4,"content":"但在“728”身上，你只感到一种危险的混沌。意识仿佛被吸入一个迅速塌陷的黑洞，疯狂的漩涡开始撕扯着你的精神。","style":3,"background":105,"log_type":1},{"step":5,"speaker":"“728”","content":"不要妨碍我——！给我更多！给我更多！","voice":["vo_cgplot_2031005"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":6,"content":"他突然青筋暴起，挣开束缚，手中攥起一个红色小瓶，大笑着捏碎。红色液体快速钻进他的皮肤。","style":3,"background":105,"log_type":1},{"step":7,"content":"男人的口中涌现出黑雾，而在黑雾之下，你看到他的身体正在发生变化。","style":3,"background":105,"log_type":1},{"step":8,"speaker":"“728”","content":"哈哈哈哈——！我——自由——了————！我————","voice":["vo_cgplot_2031008"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":9,"content":"刷——","style":3,"background":105,"log_type":1},{"step":10,"content":"在他彻底变异之前，一道寒光削过他的手，他的身体僵住，然后摔倒在地，再也没了动静。","style":3,"background":105,"log_type":1},{"step":11,"speaker":"艾恩","content":"竟敢在我的诊所里碰这种东西……这群疯子！","voice":["vo_cgplot_2031011"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":12,"speaker":"赫卡蒂","content":"控制住了吗？","voice":["vo_cgplot_2031012"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":13,"speaker":"艾恩","content":"不，可能已经来不及了。","voice":["vo_cgplot_2031013"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":14,"speaker":"海拉","content":"艾恩，这边！有人不对劲！","voice":["vo_cgplot_2031014"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":15,"content":"在意料之外的地方，一个老人发生了异变。","style":3,"background":105,"log_type":1},{"step":16,"content":"他只是一个普通人，在床上颤抖着，身上散发出阵阵不祥的雾气。","style":3,"background":105,"log_type":1},{"step":17,"speaker":"老人","content":"够了……为什么会是这样……","voice":["vo_cgplot_2031017"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":18,"speaker":"老人","content":"……杰米死了……我们明明……明明什么都没做……为什么……","voice":["vo_cgplot_2031018"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":19,"speaker":"艾恩","content":"728号的崩坏造成的冲击太大，现在其他病人也受到影响。","voice":["vo_cgplot_2031019"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":20,"speaker":"艾恩","content":"停下！别再想了，稳住你的情绪！","voice":["vo_cgplot_2031020"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":21,"speaker":"老人","content":"为……什……咕啊啊啊啊啊——！！","voice":["vo_cgplot_2031021"],"voice_bank":"vo_cgplot_02","style":1,"background":105,"log_type":1},{"step":22,"content":"他的身体开始发生变化，伴随着一声吼叫，在你的面前瞬间成为了死役。","style":3,"background":105,"log_type":1}]}