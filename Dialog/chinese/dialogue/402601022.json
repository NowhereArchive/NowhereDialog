{"id":402601022,"chapter_id":50070,"scene_id":57002,"steps":[{"step":1,"speaker":"远处的声音","content":"是暗网袭击！","voice":["vo_event_402601022_01"],"voice_bank":"vo_event_26101","style":1,"background":2253,"log_type":1},{"step":2,"speaker":"远处的声音","content":"局长！局长回答我！！","voice":["vo_event_402601022_02"],"voice_bank":"vo_event_26101","style":1,"background":2253,"log_type":1},{"step":3,"content":"你倒在地上，似乎听到同伴的呼声。","style":3,"background":2253,"log_type":1},{"step":4,"content":"流光的天网分割世界，分割中一切再次错乱，扭曲失真，唯独把你锁在沉重的牢笼。能抓住的唯一现实是怀中紧抱的陌生少女。","style":3,"background":2253,"log_type":1},{"step":5,"content":"可她的身体已经被解离得所剩无几。","style":3,"background":2253,"log_type":1},{"step":6,"speaker":"少女","content":"……我先……找到了你……","voice":["vo_event_402601022_05"],"voice_bank":"vo_event_26101","style":1,"background":2253,"log_type":1},{"step":7,"speaker":"少女","content":"……这次……该你来……","voice":["vo_event_402601022_06"],"voice_bank":"vo_event_26101","style":1,"background":2253,"log_type":1},{"step":8,"speaker":"选项","options":["坚持住……"],"jump":[9],"style":6,"background":2253,"log_type":1},{"step":9,"content":"一道白光直接刺穿你们二人，你的话被瞬间截断，怀中的人颤动一下，消失了。剩你一人消化这个事实。","style":3,"background":2253,"log_type":1},{"step":10,"content":"胸前被开出的巨大空洞正在快速愈合聚拢，纷杂噪声干扰你的意识，要向你灌输什么又要从你手中夺走什么，几乎要把你撕裂。","style":3,"background":2253,"log_type":1},{"step":11,"content":"在彻底失去知觉前，你看到掉落在地的雪糕。","style":3,"background":2253,"log_type":1},{"step":12,"content":"雪糕已经融化，露出干瘪的木条。","style":3,"background":2253,"log_type":1},{"step":13,"content":"而木条上，流光闪过，一行异常的字符串掠过你眼前，然后快速被消解，就像从未存在过。","style":3,"background":2253,"log_type":1},{"step":14,"content":"<size=44>sesquipedalian.tmesis.xanthocyanopsy</size>","style":14,"background":2253,"is_centered":true,"log_type":1}]}