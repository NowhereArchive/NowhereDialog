{"id":6071,"chapter_id":6,"scene_id":607,"steps":[{"step":1,"content":"蹬、蹬、蹬蹬——你们尽全力快跑着，略过不断增长的污染、恍惚的死役，尽快登上铁皮阶梯。","style":3,"background":511,"log_type":1},{"step":2,"speaker":"海拉","content":"我没记错的话，这秃头像有一百多米高，至少得爬三四十层楼。","voice":["vo_cgplot_6071002"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":3,"speaker":"海拉","content":"这样下去，等我们跑到卓娅面前，也不可能有力气跟她打。","voice":["vo_cgplot_6071003"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":4,"speaker":"赫卡蒂","content":"局长还好吗？你的体力……","voice":["vo_cgplot_6071004"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":5,"options":["没事，我还能坚持"],"jump":[6],"style":6,"background":511,"log_type":1},{"step":6,"content":"倒不如说你根本不觉得累，战斗决心仿佛真的化为你的力量，让你不知疲惫。","style":3,"background":511,"log_type":1},{"step":7,"content":"这种怪异的现象不是第一次发生了。黑环内的法则被人的意志影响着，日常习惯的规则显然出现轻微偏移。","style":3,"background":511,"log_type":1},{"step":8,"speaker":"选项","options":["要相信我们能更快到达"],"jump":[9],"style":6,"background":511,"log_type":1},{"step":9,"content":"通过联系卓娅精神的枷锁，也许你也能干涉这个领域。你不确定，但值得一试。","style":3,"background":511,"log_type":1},{"step":10,"content":"同时，你的直觉、第六感、预见性也被大大增强，像有个声音在不停催促着：","style":3,"background":511,"log_type":1},{"step":11,"content":"<color=#7683a2><i>快一点，再快一点，来不及了——</i></color>","style":3,"background":511,"log_type":1},{"step":12,"speaker":"卓娅？","content":"吼——————！！","voice":["vo_cgplot_6071012"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":13,"speaker":"海拉&赫卡蒂","content":"我了个去啊——！！\n站稳！","voice":["vo_cgplot_6071013"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":14,"content":"一声沉重的咆哮自上而下震荡了整个雕像，又由内而外震撼整个黑环。","style":3,"background":511,"log_type":1},{"step":15,"content":"雕像外。","style":18,"background":509,"log_type":1},{"step":16,"speaker":"澈","content":"！！","voice":["vo_cgplot_6071016"],"voice_bank":"vo_cgplot_06","style":1,"background":509,"log_type":1},{"step":17,"content":"雕像顶部，一直跟混沌对抗的白光突然消失了。","style":3,"background":509,"log_type":1},{"step":18,"speaker":"澈","content":"白逸……！","voice":["vo_cgplot_6071018"],"voice_bank":"vo_cgplot_06","style":1,"background":509,"log_type":1},{"step":20,"content":"压制黑环的力量消失了，塔内像突然解除了某种封印，像被解除蛊惑一般，所有呆滞的死役像突然回过神来，他们转头，看向你们。","style":3,"background":511,"log_type":1},{"step":21,"speaker":"海拉","content":"……啊呀呀，上头那个拉仇恨的大哥是不是倒了？","voice":["vo_cgplot_6071021"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":22,"speaker":"赫卡蒂","content":"局长小心，现在……死役要攻击我们了！","voice":["vo_cgplot_6071022"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1}]}