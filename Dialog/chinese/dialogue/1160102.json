{"id":1160102,"chapter_id":1160102,"scene_id":1,"steps":[{"step":1,"speaker":"艾瑞尔","content":"局长……禁闭者回家探望真的没关系吗？\n会不会太麻烦您了。","voice":["vo_trial_160101_1_55"],"style":1,"background":1018,"log_type":1,"src_id":260102001,"trial_step":1},{"step":2,"content":"看着身穿新城治安官制服的你，艾瑞尔不禁表现出了她的担忧。","style":3,"background":1018,"log_type":1,"src_id":260102002,"trial_step":2},{"step":3,"options":["不麻烦","我已经打点好了"],"style":6,"background":1018,"log_type":1,"src_id":260102003,"trial_step":3,"course":3,"choices":[{"text":"不麻烦","goto":4},{"text":"我已经打点好了","goto":null}]},{"step":4,"content":"你的罪案性质较轻，这点程度的通融还是可以实现的。","style":2,"background":1018,"log_type":1,"src_id":260102004,"trial_step":4},{"step":5,"content":"不过，我们身份敏感，不便于在新城公开。","style":2,"background":1018,"log_type":1,"src_id":260102005,"trial_step":5},{"step":6,"content":"所以从现在起，你不是禁闭者，我也不是MBCC的局长。","style":2,"background":1018,"log_type":1,"src_id":260102006,"trial_step":6},{"step":7,"content":"我是帮助失踪少女重返家园的新城治安官。","style":2,"background":1018,"log_type":1,"src_id":260102007,"trial_step":7},{"step":8,"speaker":"艾瑞尔","content":"我明白了，局……${PlayerName}。","style":1,"background":1018,"log_type":1,"src_id":260102008,"trial_step":8},{"step":9,"content":"管理局的车在斯宾塞家门前停下。","style":3,"background":1018,"log_type":1,"src_id":260102009,"trial_step":9},{"step":10,"content":"艾瑞尔站在门外，抓着门把手，却迟迟没有将门推开。","style":3,"background":3003,"log_type":1,"src_id":260102010,"trial_step":10},{"step":11,"options":["怎么了？"],"style":6,"background":3003,"log_type":1,"src_id":260102011,"trial_step":11,"course":3,"choices":[{"text":"怎么了？","goto":12}]},{"step":12,"speaker":"艾瑞尔","content":"您说，我这么多天没有回来，父亲对我会比平时更关心些吗？","style":1,"background":3003,"log_type":1,"src_id":260102012,"trial_step":12},{"step":13,"content":"她自顾自无奈地摇摇头。","style":3,"background":3003,"log_type":1,"src_id":260102013,"trial_step":13},{"step":14,"speaker":"艾瑞尔","content":"如果真的在意我的话，早就该在新城的大街小巷都贴满我的寻人启事了吧……","style":1,"background":3003,"log_type":1,"src_id":260102014,"trial_step":14},{"step":15,"speaker":"艾瑞尔","content":"果然还是我自作多情了吗……","style":1,"background":3003,"log_type":1,"src_id":260102015,"trial_step":15},{"step":16,"content":"艾瑞尔深吸一口气，将雕着斯宾塞家纹的大门推开。","style":3,"background":10000,"log_type":1,"src_id":260102016,"trial_step":16},{"step":17,"speaker":"艾瑞尔","content":"父亲……我回来了。","style":1,"background":1038,"log_type":1,"src_id":260102017,"trial_step":17},{"step":18,"content":"艾瑞尔有些局促地进入书房，试探着沙发上中年男人的态度。","style":3,"background":1038,"log_type":1,"src_id":260102018,"trial_step":18},{"step":19,"content":"男人专注于手中的报纸，连眉毛都没有抬一下。","style":3,"background":1038,"log_type":1,"src_id":260102019,"trial_step":19},{"step":20,"content":"直到艾瑞尔走到他的面前，他才有了些反应。","style":3,"background":1038,"log_type":1,"src_id":260102020,"trial_step":20},{"step":21,"speaker":"葛昂辛","content":"艾瑞尔？听管家说你失踪了。","style":1,"background":1038,"log_type":1,"src_id":260102021,"trial_step":21},{"step":22,"speaker":"葛昂辛","content":"知道回来就行。","style":1,"background":1038,"log_type":1,"src_id":260102022,"trial_step":22},{"step":23,"speaker":"艾瑞尔","content":"父亲就不想知道这些天艾瑞尔经历了什么吗？","style":1,"background":1038,"log_type":1,"src_id":260102023,"trial_step":23},{"step":24,"speaker":"葛昂辛","content":"我每天需要知道的事情很多，没什么必要的话就不用告诉我了。","style":1,"background":1038,"log_type":1,"src_id":260102024,"trial_step":24},{"step":25,"speaker":"艾瑞尔","content":"我……要不是这名治安官的帮助，我，我就再也见不到您了！","style":1,"background":1038,"log_type":1,"src_id":260102025,"trial_step":25},{"step":26,"content":"她不自觉地提高了音量，急切地想要争辩。","style":3,"background":1038,"log_type":1,"src_id":260102026,"trial_step":26},{"step":27,"speaker":"葛昂辛","content":"那你带着你那位治安官朋友随便玩玩吧，就当是表达谢意了。","style":1,"background":1038,"log_type":1,"src_id":260102027,"trial_step":27},{"step":28,"speaker":"葛昂辛","content":"嗯，你哥哥姐姐最近做出了不少成绩，新的产品线给家族带来了很多红利。","style":1,"background":1038,"log_type":1,"src_id":260102028,"trial_step":28},{"step":29,"speaker":"葛昂辛","content":"你也该向他们学习了。","style":1,"background":1038,"log_type":1,"src_id":260102029,"trial_step":29},{"step":30,"content":"葛昂辛的目光锁定在新闻上，不曾回头看过艾瑞尔一眼。","style":3,"background":1038,"log_type":1,"src_id":260102030,"trial_step":30},{"step":31,"speaker":"艾瑞尔","content":"就没有和家族产业无关的话题了吗……","style":1,"background":1038,"log_type":1,"src_id":260102031,"trial_step":31},{"step":32,"speaker":"葛昂辛","content":"你今天的话格外的多。","style":1,"background":1038,"log_type":1,"src_id":260102032,"trial_step":32},{"step":33,"speaker":"艾瑞尔","content":"或许是太久没有见到父亲了，所以有些想念。","style":1,"background":1038,"log_type":1,"src_id":260102033,"trial_step":33},{"step":34,"speaker":"葛昂辛","content":"那你跟我能聊什么？是你毫无进步的艺术造诣，还是你对家族产业的贡献？","style":1,"background":1038,"log_type":1,"src_id":260102034,"trial_step":34},{"step":35,"speaker":"艾瑞尔","content":"可以说说日常父女间的话题啊，例如父亲的身体，最近有更健朗一些吗？","style":1,"background":1038,"log_type":1,"src_id":260102035,"trial_step":35},{"step":36,"content":"艾瑞尔似乎还想做出最后的挣扎，固执甚至有些绝望地想要从父亲那里引出些不一样的反应。","style":3,"background":1038,"log_type":1,"src_id":260102036,"trial_step":36},{"step":37,"speaker":"葛昂辛","content":"我的身体有营养师操心。你只需要管好你自己，在家族需要你的时候派上用场。","style":1,"background":1038,"log_type":1,"src_id":260102037,"trial_step":37},{"step":38,"speaker":"艾瑞尔","content":"家族需要我的时候……？","style":1,"background":1038,"log_type":1,"src_id":260102038,"trial_step":38},{"step":39,"speaker":"葛昂辛","content":"怎么？这么大了还不明白自己的责任吗？","style":1,"background":1038,"log_type":1,"src_id":260102039,"trial_step":39},{"step":40,"speaker":"葛昂辛","content":"用你的婚姻给家族换来利益，就是你对斯宾塞家唯一有用的地方。","style":1,"background":1038,"log_type":1,"src_id":260102040,"trial_step":40},{"step":41,"speaker":"艾瑞尔","content":"……我也有自己想做的事啊，我不是只为了家族而活的。","style":1,"background":1038,"log_type":1,"src_id":260102041,"trial_step":41},{"step":42,"content":"这也许是艾瑞尔第一次当着父亲的面表达对他的反抗和自己的想法。她的双手攥紧衣角，声音也在发抖，但依旧勇敢而坚定地说出了自己想说的话。","style":3,"background":1038,"log_type":1,"src_id":260102042,"trial_step":42},{"step":43,"speaker":"艾瑞尔","content":"您知道吗，我最近救了一个人……","style":1,"background":1038,"log_type":1,"src_id":260102043,"trial_step":43},{"step":44,"speaker":"葛昂辛","content":"哈哈！好！好！","style":1,"background":1038,"log_type":1,"src_id":260102044,"trial_step":44},{"step":45,"speaker":"葛昂辛","content":"这些狂厄，到处犯下罪行，死不足惜。就该通通赶到锈河去！","style":1,"background":1038,"log_type":1,"src_id":260102045,"trial_step":45},{"step":46,"content":"他对着手头的报纸新闻称快，全然不在意艾瑞尔究竟说了什么。","style":3,"background":1038,"log_type":1,"src_id":260102046,"trial_step":46},{"step":47,"speaker":"葛昂辛","content":"对了，你刚刚说什么？","style":1,"background":1038,"log_type":1,"src_id":260102047,"trial_step":47},{"step":48,"speaker":"艾瑞尔","content":"我说……","style":1,"background":1038,"log_type":1,"src_id":260102048,"trial_step":48},{"step":49,"content":"你看见艾瑞尔紧握拳头，肩膀在轻轻战栗。","style":3,"background":1038,"log_type":1,"src_id":260102049,"trial_step":49},{"step":50,"speaker":"艾瑞尔","content":"我说……我是禁闭者了。","style":1,"background":1038,"log_type":1,"src_id":260102050,"trial_step":50},{"step":51,"content":"艾瑞尔，我们不是说好了……","style":2,"background":1038,"log_type":1,"src_id":260102051,"trial_step":51},{"step":52,"content":"葛昂辛终于合上了报纸，将视线落在女儿身上。","style":3,"background":1038,"log_type":1,"src_id":260102052,"trial_step":52},{"step":53,"speaker":"葛昂辛","content":"够了！你可以继续去搞你的慈善事业，如果你觉得那样能让你有一些成就感。","style":1,"background":1038,"log_type":1,"src_id":260102053,"trial_step":53},{"step":54,"speaker":"葛昂辛","content":"但你必须牢记斯宾塞家的立场，不能拿这样的事情开玩笑。","style":1,"background":1038,"log_type":1,"src_id":260102054,"trial_step":54},{"step":55,"speaker":"艾瑞尔","content":"我没有开玩笑……","style":1,"background":1038,"log_type":1,"src_id":260102055,"trial_step":55},{"step":56,"content":"艾瑞尔伸出右手，一颗光球在她的右手不断凝结。","style":3,"background":1038,"log_type":1,"src_id":260102056,"trial_step":56},{"step":57,"speaker":"艾瑞尔","content":"您放心，我的能力没有太大的危害，我正在学着掌控它帮助别人……","style":1,"background":1038,"log_type":1,"src_id":260102057,"trial_step":57},{"step":58,"speaker":"葛昂辛","content":"别过来！","style":1,"background":1038,"log_type":1,"src_id":260102058,"trial_step":58},{"step":59,"content":"葛昂辛一把将报纸扔到艾瑞尔脚边，气愤地喘着粗气。","style":3,"background":1038,"log_type":1,"src_id":260102059,"trial_step":59},{"step":60,"speaker":"葛昂辛","content":"你……！你变成这幅样子回到家族，究竟是什么居心！","style":1,"background":1038,"log_type":1,"src_id":260102060,"trial_step":60},{"step":61,"speaker":"艾瑞尔","content":"我只是想在被MBCC拘管前，最后见您一面。","style":1,"background":1038,"log_type":1,"src_id":260102061,"trial_step":61},{"step":62,"speaker":"葛昂辛","content":"见我？我看你是要用这恶心的能力，报复我、报复家族！","style":1,"background":1038,"log_type":1,"src_id":260102062,"trial_step":62},{"step":63,"speaker":"艾瑞尔","content":"我从没有这样想过，父……","style":1,"background":1038,"log_type":1,"src_id":260102063,"trial_step":63},{"step":64,"speaker":"葛昂辛","content":"别叫我父亲！听着就让人反胃。","style":1,"background":1038,"log_type":1,"src_id":260102064,"trial_step":64},{"step":65,"speaker":"葛昂辛","content":"我命令你，禁闭者艾瑞尔，滚出斯宾塞家，不然——","style":1,"background":1038,"log_type":1,"src_id":260102065,"trial_step":65},{"step":66,"content":"他从书桌下拿出一把老式手枪。","style":3,"background":1038,"log_type":1,"src_id":260102066,"trial_step":66},{"step":67,"speaker":"艾瑞尔","content":"您不会开枪的，对不对？","style":1,"background":1038,"log_type":1,"src_id":260102067,"trial_step":67},{"step":68,"speaker":"葛昂辛","content":"面对你这样居心叵测的家族叛徒可说不定！","style":1,"background":1038,"log_type":1,"src_id":260102068,"trial_step":68},{"step":69,"options":["你要杀了自己的女儿吗？"],"style":6,"background":1038,"log_type":1,"src_id":260102069,"trial_step":69,"course":3,"choices":[{"text":"你要杀了自己的女儿吗？","goto":70}]},{"step":70,"speaker":"葛昂辛","content":"差点忘了，小治安官您还在呢。","style":1,"background":1038,"log_type":1,"src_id":260102070,"trial_step":70},{"step":71,"speaker":"葛昂辛","content":"我只是看到禁闭者擅自闯入民宅，正当防卫而已。","style":1,"background":1038,"log_type":1,"src_id":260102071,"trial_step":71},{"step":72,"content":"这是她自己的家。","style":2,"background":1038,"log_type":1,"src_id":260102072,"trial_step":72},{"step":73,"speaker":"葛昂辛","content":"已经不是了。","style":1,"background":1038,"log_type":1,"src_id":260102073,"trial_step":73},{"step":74,"content":"葛昂辛端起枪，对准了艾瑞尔。","style":3,"background":1038,"log_type":1,"src_id":260102074,"trial_step":74},{"step":75,"speaker":"葛昂辛","content":"能站在我面前，已经是我对禁闭者最大的宽容了。","style":1,"background":1038,"log_type":1,"src_id":260102075,"trial_step":75},{"step":76,"options":["阻拦葛昂辛","维护艾瑞尔"],"style":6,"background":1038,"log_type":1,"src_id":260102076,"trial_step":76,"course":3,"choices":[{"text":"阻拦葛昂辛","goto":77},{"text":"维护艾瑞尔","goto":null}]},{"step":77,"content":"艾瑞尔虽然是禁闭者，但她没有什么恶念！","style":2,"background":1038,"log_type":1,"src_id":260102077,"trial_step":77},{"step":78,"content":"她这次回来也只是因为思念父亲。","style":2,"background":1038,"log_type":1,"src_id":260102078,"trial_step":78},{"step":79,"speaker":"葛昂辛","content":"呵……禁闭者的嘴最会骗人了！","style":1,"background":1038,"log_type":1,"src_id":260102079,"trial_step":79},{"step":80,"speaker":"葛昂辛","content":"没有恶念？那是因为时候未到！","style":1,"background":1038,"log_type":1,"src_id":260102080,"trial_step":80},{"step":81,"speaker":"葛昂辛","content":"我就让你看看，什么是禁闭者最邪恶的嘴脸！","style":1,"background":1038,"log_type":1,"src_id":260102081,"trial_step":81},{"step":82,"content":"砰——！！！","style":3,"background":1038,"log_type":1,"src_id":260102082,"trial_step":82},{"step":83,"content":"艾瑞尔不可置信地低头，看着左肩的弹孔。","style":3,"background":1038,"log_type":1,"src_id":260102083,"trial_step":83},{"step":84,"speaker":"艾瑞尔","content":"我是……我是您的女儿啊？","style":1,"background":1038,"log_type":1,"src_id":260102084,"trial_step":84},{"step":85,"content":"砰——！！！","style":3,"background":1038,"log_type":1,"src_id":260102085,"trial_step":85},{"step":86,"content":"葛昂辛的手扣动扳机，第二颗子弹径直朝着艾瑞尔飞去。","style":3,"background":1038,"log_type":1,"src_id":260102086,"trial_step":86},{"step":87,"speaker":"艾瑞尔","content":"……！！","style":1,"background":1038,"log_type":1,"src_id":260102087,"trial_step":87},{"step":88,"content":"光芒爆发而出，客厅被艾瑞尔的能力影响，不住震荡着。","style":3,"background":1038,"log_type":1,"src_id":260102088,"trial_step":88},{"step":89,"content":"子弹被艾瑞尔的光球所抵挡，葛昂辛手中的枪被打落。","style":3,"background":1038,"log_type":1,"src_id":260102089,"trial_step":89},{"step":90,"speaker":"葛昂辛","content":"哈哈哈哈……我就知道，我就知道！","style":1,"background":1038,"log_type":1,"src_id":260102090,"trial_step":90},{"step":91,"speaker":"葛昂辛","content":"看到了吧，小治安官，她刚刚想要谋杀自己的父亲！！！","style":1,"background":1038,"log_type":1,"src_id":260102091,"trial_step":91},{"step":92,"speaker":"葛昂辛","content":"这就是禁闭者真正的嘴脸！是斯宾塞家永远的敌人！","style":1,"background":1038,"log_type":1,"src_id":260102092,"trial_step":92},{"step":93,"content":"艾瑞尔捂住左肩的伤口，失望地看着这个被她称为父亲的男人。","style":3,"background":1038,"log_type":1,"src_id":260102093,"trial_step":93},{"step":94,"speaker":"艾瑞尔","content":"果然是这样的结果啊……\n局长，我们走吧……","style":1,"background":1038,"log_type":1,"src_id":260102094,"trial_step":94},{"step":95,"content":"她没有解释，也没有争辩，在你的搀扶下，怔怔地走出了书房，走出了斯宾塞家的大门。","style":3,"background":3003,"log_type":1,"src_id":260102095,"trial_step":95},{"step":96,"options":["关心她的伤势","安抚她的情绪"],"style":6,"background":3003,"log_type":1,"src_id":260102096,"trial_step":96,"course":3,"choices":[{"text":"关心她的伤势","goto":97},{"text":"安抚她的情绪","goto":null}]},{"step":97,"speaker":"艾瑞尔","content":"局长放心，我很好。","style":1,"background":3003,"log_type":1,"src_id":260102097,"trial_step":97},{"step":98,"speaker":"艾瑞尔","content":"我的目的，已经达到了……咳咳咳……","style":1,"background":3003,"log_type":1,"src_id":260102098,"trial_step":98},{"step":99,"content":"别说话了，你流了很多血，我马上让医疗队过来支援。","style":2,"background":3003,"log_type":1,"src_id":260102099,"trial_step":99},{"step":100,"speaker":"艾瑞尔","content":"局长……可以拜托您一件事情吗？","style":1,"background":3003,"log_type":1,"src_id":260102100,"trial_step":100},{"step":101,"content":"艾瑞尔的面色苍白，额头冒出了不少冷汗。","style":3,"background":3003,"log_type":1,"src_id":260102101,"trial_step":101},{"step":102,"content":"等回去再说不行吗？","style":2,"background":3003,"log_type":1,"src_id":260102102,"trial_step":102},{"step":103,"speaker":"艾瑞尔","content":"我……我怕自己回去之后，就后悔了……","style":1,"background":3003,"log_type":1,"src_id":260102103,"trial_step":103},{"step":104,"content":"好吧，我答应你，什么事？","style":2,"background":3003,"log_type":1,"src_id":260102104,"trial_step":104},{"step":105,"speaker":"艾瑞尔","content":"我希望能让父亲觉得，他今天已经一枪将艾瑞尔打死了……","style":1,"background":3003,"log_type":1,"src_id":260102105,"trial_step":105},{"step":106,"content":"为什么？这就是你一定要回来看看的目的吗？","style":2,"background":3003,"log_type":1,"src_id":260102106,"trial_step":106},{"step":107,"speaker":"艾瑞尔","content":"是我太天真，还抱有不切实际的幻想……我总是在想，万一呢？万一他在面对自己的女儿时，会有不一样的态度呢……","style":1,"background":3003,"log_type":1,"src_id":260102107,"trial_step":107},{"step":108,"speaker":"艾瑞尔","content":"现在，亲耳听到了他的答复，我终于可以死心了……或许，这就是对所有人而言……","style":1,"background":3003,"log_type":1,"src_id":260102108,"trial_step":108},{"step":109,"speaker":"艾瑞尔","content":"HUSH……你们为什么会在这里？","style":1,"background":3003,"log_type":1,"src_id":260102109,"trial_step":109},{"step":110,"content":"艾瑞尔无力地靠在你肩上，呼吸逐渐微弱。","style":3,"background":3003,"log_type":1,"src_id":260102110,"trial_step":110},{"step":111,"content":"远远地，你听见了汽车驶来的声音。","style":3,"background":3003,"log_type":1,"src_id":260102111,"trial_step":111},{"step":112,"content":"艾瑞尔！醒醒！医疗队到了！","style":2,"background":3003,"log_type":1,"src_id":260102112,"trial_step":112},{"step":113,"content":"艾瑞尔！！！","style":2,"background":10000,"log_type":1,"src_id":260102113,"trial_step":113}]}