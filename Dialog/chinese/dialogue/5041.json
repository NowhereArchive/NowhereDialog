{"id":5041,"chapter_id":5,"scene_id":506,"steps":[{"step":1,"content":"09:20  广场大道——FAC第三防线","style":9,"background":504,"log_type":1},{"step":2,"speaker":"036","content":"压制他们！","voice":["vo_cgplot_5041002"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":3,"content":"标记为036的重甲士兵一挥手，数个FAC士兵齐齐举枪，对着你果断开火，尽数打在离你们不远的地面上。","style":3,"background":504,"log_type":1},{"step":4,"speaker":"海拉","content":"**！他们真的想杀了${PlayerName}吗？","voice":["vo_cgplot_5041004"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":5,"speaker":"厄尔希","content":"这不是普通子弹！","voice":["vo_cgplot_5041005"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":6,"content":"射入地面的“子弹”突然闪起蓝光。你看到所有禁闭者身体一滞。","style":3,"background":504,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"冷静，是短时反狂厄装置，对死役专用，我们扛得住。","voice":["vo_cgplot_5041007"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":8,"speaker":"厄尔希","content":"是佯攻，看前面！","voice":["vo_cgplot_5041008"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":9,"content":"正说着，那巨大的白盔甲已横冲而来。他身先士卒，速度和冲击力都过于惊人，所有人大吃一惊。","style":3,"background":504,"log_type":1},{"step":10,"speaker":"海拉","content":"哇————！！","voice":["vo_cgplot_5041010"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":11,"speaker":"厄尔希","content":"趴下！","voice":["vo_cgplot_5041011"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":12,"content":"他从风衣中抓出一把圆形磁片，手中异能弧光闪动，磁片被转化成了炸弹，随即被甩向冲来的敌人。","style":3,"background":504,"log_type":1},{"step":13,"content":"连环爆炸阻碍了部分士兵，但带头者却毫不迟疑，扛住冲击竟加速向你们冲来。","style":3,"background":504,"log_type":1},{"step":14,"speaker":"厄尔希","content":"啧，离得太近，不能用大威力的炸弹了。那家伙果然……","voice":["vo_cgplot_5041014"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":15,"speaker":"厄尔希","content":"你们要小心！他不是普通人！","voice":["vo_cgplot_5041015"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":16,"content":"梦魇疾冲上前，白盔甲被撞了个趔趄，左手像是脱臼了，却没有丝毫退怯的意图，稳住脚步的瞬间，他单手挥动战斧压制梦魇。","style":3,"background":504,"log_type":1},{"step":17,"speaker":"FAC重甲队长","content":"趁现在，把他夺回来！","female_content":"趁现在，把她夺回来！","voice":["vo_cgplot_5041017","vo_cgplot_5041017f"],"voice_bank":"vo_cgplot_05","style":1,"background":504,"log_type":1},{"step":18,"content":"更多FAC士兵自他身后冲向你们！","style":3,"background":504,"log_type":1}]}