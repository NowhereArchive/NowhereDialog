{"id":1050602,"chapter_id":1050602,"scene_id":1,"steps":[{"step":1,"content":"眼前的女子端坐在审讯椅上，看上去，像随时能进行一场电视广播。","style":3,"log_type":1,"src_id":150602003,"trial_step":3,"drawing":1050600},{"step":2,"content":"见到你进来，她笑着和你打了个招呼。","style":3,"log_type":1,"src_id":150602004,"trial_step":4,"drawing":1050600},{"step":3,"speaker":"雷温","content":"再次见面，我很高兴，${PlayerName}局长。","voice":["vo_trial_50602_1_1"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602005,"trial_step":5,"drawing":1050601},{"step":4,"content":"你手里拿着刚更新的资料，看着眼前笑意温柔的女子，无声地吸了口气。","style":3,"log_type":1,"src_id":150602006,"trial_step":6,"drawing":1050600},{"step":5,"options":["我也很高兴","我们才分开几个小时"],"style":6,"log_type":1,"src_id":150602007,"trial_step":7,"course":3,"drawing":1050600,"choices":[{"text":"我也很高兴","goto":8},{"text":"我们才分开几个小时","goto":null}]},{"step":6,"speaker":"雷温","content":"你看起来有点紧张？","voice":["vo_trial_50602_1_4"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602008,"trial_step":8,"drawing":1050600},{"step":7,"speaker":"雷温","content":"紧张什么，你和我不是看到了吗？最后的危机……也已经被消除了，我也坐在你的面前了。","voice":["vo_trial_50602_1_5"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602009,"trial_step":9,"drawing":1050600},{"step":8,"content":"最后的危机？是那个老式终端，还是……","style":3,"log_type":1,"src_id":150602010,"trial_step":10,"drawing":1050600},{"step":9,"content":"从电视台回来的时候，我看到通知了。","style":2,"log_type":1,"src_id":150602011,"trial_step":11,"drawing":1050600},{"step":10,"content":"你的电台节目被无限期暂停……","style":2,"log_type":1,"src_id":150602012,"trial_step":12,"drawing":1050600},{"step":11,"speaker":"雷温","content":"嗯，我知道。","voice":["vo_trial_50602_1_9"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602013,"trial_step":13,"drawing":1050600},{"step":12,"speaker":"雷温","content":"那是我亲自去谈的。","voice":["vo_trial_50602_1_10"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602014,"trial_step":14,"drawing":1050600},{"step":13,"content":"你亲自去的吗？","style":2,"log_type":1,"src_id":150602015,"trial_step":15,"drawing":1050600},{"step":14,"speaker":"雷温","content":"对……其实我早就做好了要来这里的准备，外面的世界……没必要留下我的痕迹。","voice":["vo_trial_50602_1_12"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602016,"trial_step":16,"drawing":1050600},{"step":15,"content":"你的痕迹……","style":2,"log_type":1,"src_id":150602017,"trial_step":17,"drawing":1050600},{"step":16,"content":"你翻开手边的文件，里面放着你在出门前整理的资料。","style":3,"log_type":1,"src_id":150602018,"trial_step":18,"drawing":1050600},{"step":17,"content":"所以……你才去消除了那些，接到过凌晨三点来电的人的……记忆？","style":2,"log_type":1,"src_id":150602019,"trial_step":19,"drawing":1050600},{"step":18,"content":"雷温似乎没料到你能查到这些，稍微愣了一下。","style":3,"log_type":1,"src_id":150602020,"trial_step":20,"drawing":1050602},{"step":19,"speaker":"雷温","content":"你……你怎么知道？","voice":["vo_trial_50602_1_17"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602021,"trial_step":21,"drawing":1050602},{"step":20,"content":"我可是米诺斯危机管理局的局长，既然知道了这个电台造成了狂厄事件，自然是要好好调查的。","style":2,"log_type":1,"src_id":150602022,"trial_step":22,"drawing":1050602},{"step":21,"content":"这是我的工作~","style":2,"log_type":1,"src_id":150602023,"trial_step":23,"drawing":1050602},{"step":22,"speaker":"雷温","content":"说的也是~","voice":["vo_trial_50602_1_20"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602024,"trial_step":24,"drawing":1050601},{"step":23,"speaker":"雷温","content":"凌晨三点的电台……我主持它的时候，想法很单纯：想倾听观众的声音，疗愈他们在白日受到的伤痛，或是夜晚无法纾解的情绪。","voice":["vo_trial_50602_1_21"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602025,"trial_step":25,"drawing":1050600},{"step":24,"speaker":"雷温","content":"我原本想让它成为为人带来温暖的节目。显然，结果不尽如人意。","voice":["vo_trial_50602_1_22"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602026,"trial_step":26,"drawing":1050600},{"step":25,"content":"雷温依旧笑着，可她的眼神垂下去，看着地面，似乎还在为说出那些事实而积攒勇气。","style":3,"log_type":1,"src_id":150602027,"trial_step":27,"drawing":1050600},{"step":26,"speaker":"雷温","content":"怪谈、流言，内容控制，不停不休的声讨，它们带来了巨大的压力。最后，我不仅没能带来温暖，反而成为了“声浪” 的加害者。","voice":["vo_trial_50602_1_24"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602028,"trial_step":28,"drawing":1050600},{"step":27,"speaker":"雷温","content":"现在祸源消失了，是件好事。","voice":["vo_trial_50602_1_25"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602029,"trial_step":29,"drawing":1050600},{"step":28,"options":["真的……消失了吗？"],"style":6,"log_type":1,"src_id":150602030,"trial_step":30,"course":3,"drawing":1050600,"choices":[{"text":"真的……消失了吗？","goto":31}]},{"step":29,"content":"雷温的声音顿了顿，继而耸耸肩膀。","style":3,"log_type":1,"src_id":150602031,"trial_step":31,"drawing":1050600},{"step":30,"speaker":"雷温","content":"是啊，电台停播，那台最后的老式终端也已经被毁……不会再有……凌晨三点的来电了。","voice":["vo_trial_50602_1_28"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602032,"trial_step":32,"drawing":1050600},{"step":31,"content":"可是……现在外面，似乎还是有人接到了来电。","style":2,"log_type":1,"src_id":150602033,"trial_step":33,"drawing":1050600},{"step":32,"content":"听到你的话，雷温的眉头皱了起来。","style":3,"log_type":1,"src_id":150602034,"trial_step":34,"drawing":1050604},{"step":33,"speaker":"雷温","content":"不可能。","voice":["vo_trial_50602_1_31"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602035,"trial_step":35,"drawing":1050604},{"step":34,"speaker":"雷温","content":"我的力量或许还不足以毁掉那个终端，但是你来了……","voice":["vo_trial_50602_1_32"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602036,"trial_step":36,"drawing":1050604},{"step":35,"speaker":"雷温","content":"有你的力量，它不可能还能逃走……","voice":["vo_trial_50602_1_33"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602037,"trial_step":37,"drawing":1050604},{"step":36,"content":"可这是事实。","style":2,"log_type":1,"src_id":150602038,"trial_step":38,"drawing":1050604},{"step":37,"content":"你将平板推至雷温面前，上面飞速刷屏的词条，让她有点措手不及。","style":3,"log_type":1,"src_id":150602039,"trial_step":39,"drawing":1050602},{"step":38,"content":"案件侦破后，<color=#fb9259>“凌晨三点的来电”</color>词条搜索量明显滑落，你在察觉有人在人为消除相关人员的记忆后，让情报科的人员辅助消除相关痕迹，处理善后。","style":3,"log_type":1,"src_id":150602040,"trial_step":40,"drawing":1050602},{"step":39,"content":"但就在刚才，词条很快又攀升上来，热度持续增加。这次兴起的流言内容与先前极其相似。","style":3,"log_type":1,"src_id":150602041,"trial_step":41,"drawing":1050602},{"step":40,"content":"<size=42><color=#7683a2>【Dismyth论坛】【讨论区】</color>【凌晨三点的来电再次出现】</size>\n\n<color=#fb9259>匿名用户</color>：深夜来电又出现了！如果半夜三点还没睡觉，就有可能收到一个未知号码的电话……那个女人会给你讲一个故事，再问一个问题。\n\n<color=#fb9259>匿名用户</color>：一定要接，一定要答！挂断电话的人和答错问题的人都会奇异身亡！","style":10,"log_type":1,"src_id":150602042,"trial_step":42},{"step":41,"speaker":"雷温","content":"它……它做了什么？！","voice":["vo_trial_50602_1_39"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602043,"trial_step":43,"drawing":1050603},{"step":42,"speaker":"雷温","content":"它明明已经毁掉了……","voice":["vo_trial_50602_1_40"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602044,"trial_step":44,"drawing":1050603},{"step":43,"content":"但的确，它的内部，还残留着狂厄的痕迹，并且……在我到达大楼前，我周围的所有人，几乎都接到了一个无声的电话，包括我。","style":2,"log_type":1,"src_id":150602045,"trial_step":45,"drawing":1050603},{"step":44,"speaker":"雷温","content":"不对，那是我只对你一个人拨打的……","voice":["vo_trial_50602_1_42"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602046,"trial_step":46,"drawing":1050603},{"step":45,"content":"可是如果我没记错，那个电话，和我对话的应该是“另一个人”？而且……那个时间，你应该已经失去意识了才对。","style":2,"log_type":1,"src_id":150602047,"trial_step":47,"drawing":1050603},{"step":46,"speaker":"雷温","content":"……","voice":["vo_trial_50602_1_44"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602048,"trial_step":48,"drawing":1050603},{"step":47,"content":"你盯着雷温的眼睛看去，她败下阵来，率先移开了目光。","style":3,"log_type":1,"src_id":150602049,"trial_step":49,"drawing":1050604},{"step":48,"speaker":"雷温","content":"对不起，是我没有全部告诉你。","voice":["vo_trial_50602_1_46"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602050,"trial_step":50,"drawing":1050604},{"step":49,"content":"现在说也不迟，这个环节，就是为此而存在的。","style":2,"log_type":1,"src_id":150602051,"trial_step":51,"drawing":1050600},{"step":50,"speaker":"雷温","content":"最初，我们在世界结束时融合，有一股力量逃了出去……它导致我的能力变得不完整……","voice":["vo_trial_50602_1_48"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602052,"trial_step":52,"drawing":1050600},{"step":51,"speaker":"雷温","content":"并且……它一直在重新挑起那些人对凌晨三点来电的记忆。","voice":["vo_trial_50602_1_49"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602053,"trial_step":53,"drawing":1050600},{"step":52,"speaker":"雷温","content":"我是真心希望他们能不记得这些……这对于拨打过或者倾听过电台节目的人来说，几乎不是什么好的回忆。","voice":["vo_trial_50602_1_50"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602054,"trial_step":54,"drawing":1050600},{"step":53,"speaker":"雷温","content":"被拉入奇怪的世界，变成怪异头部的人，被操控着说违心的话，从众的话。","voice":["vo_trial_50602_1_51"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602055,"trial_step":55,"drawing":1050600},{"step":54,"speaker":"雷温","content":"我一直在找它，想要销毁它……夺回自己的力量，也……消灭“源头”。","voice":["vo_trial_50602_1_52"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602056,"trial_step":56,"drawing":1050600},{"step":55,"content":"雷温看着证物袋里的老式终端，好像下一秒，老式终端的指示灯又会亮起来似的。","style":3,"log_type":1,"src_id":150602057,"trial_step":57,"drawing":1050600},{"step":56,"speaker":"雷温","content":"可是我发现，失去这部分力量，我无法控制它，也没有办法清除，它将我压制，妄图再利用我故伎重演。","voice":["vo_trial_50602_1_54"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602058,"trial_step":58,"drawing":1050603},{"step":57,"speaker":"雷温","content":"我……我骗它，说我现在的力量和情绪，不足以再造就一个世界……但……加上另一个人的力量，一定可以……","voice":["vo_trial_50602_1_55"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602059,"trial_step":59,"drawing":1050603},{"step":58,"content":"她抬起头来，有些不好意思地看着你。","style":3,"log_type":1,"src_id":150602060,"trial_step":60,"drawing":1050603},{"step":59,"speaker":"雷温","content":"我用那个终端给你打了电话……我本想，和你一起毁掉那个终端的……但我没想到，它还能给那么多人打出电话……","voice":["vo_trial_50602_1_57"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602061,"trial_step":61,"drawing":1050603},{"step":60,"content":"原来如此……","style":2,"log_type":1,"src_id":150602062,"trial_step":62,"drawing":1050603},{"step":61,"content":"在电梯里时，我其实已经发现不是你给我打电话了，但你们又是源于相同的狂厄力量。","style":2,"log_type":1,"src_id":150602063,"trial_step":63,"drawing":1050603},{"step":62,"content":"加之之前，我已经调查到你在抹除关于这个电台的信息，所以我才赌了一把，我以为自己赌赢了。","style":2,"log_type":1,"src_id":150602064,"trial_step":64,"drawing":1050603},{"step":63,"content":"你把证物袋拿到中央，询问着雷温。","style":3,"log_type":1,"src_id":150602065,"trial_step":65,"drawing":1050603},{"step":64,"speaker":"雷温","content":"锁起来吧……","voice":["vo_trial_50602_1_63"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602067,"trial_step":67,"drawing":1050604},{"step":65,"content":"锁起来？","style":2,"log_type":1,"src_id":150602068,"trial_step":68,"drawing":1050604},{"step":66,"speaker":"雷温","content":"嗯，这里一定有那种，能完全隔离狂厄力量的密室吧，将它放在那里，保证它无法影响外界。","voice":["vo_trial_50602_1_65"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602069,"trial_step":69,"drawing":1050604},{"step":67,"speaker":"雷温","content":"只要时间足够长，这样的流言……总是会散的，大家不会记得这个怪谈，这个节目。","voice":["vo_trial_50602_1_66"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602070,"trial_step":70,"drawing":1050604},{"step":68,"speaker":"雷温","content":"世界上有意思的事情和声音每天都在翻新，总会过去的。","voice":["vo_trial_50602_1_67"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602071,"trial_step":71,"drawing":1050604},{"step":69,"content":"真的要这么做吗？哪怕你的力量无法恢复？","style":2,"log_type":1,"src_id":150602072,"trial_step":72,"drawing":1050604},{"step":70,"speaker":"雷温","content":"我的力量也……不是什么好的力量不是吗？","voice":["vo_trial_50602_1_69"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602073,"trial_step":73,"drawing":1050604},{"step":71,"speaker":"雷温","content":"它让我给大家带来了那么多麻烦……而且它也没办法让我的现在的状况变得更加好。","voice":["vo_trial_50602_1_70"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602074,"trial_step":74,"drawing":1050604},{"step":72,"content":"说完，雷温低下头，不再愿意交流。","style":3,"log_type":1,"src_id":150602075,"trial_step":75,"drawing":1050604},{"step":73,"speaker":"雷温","content":"尝试什么……？","voice":["vo_trial_50602_1_74"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602078,"trial_step":78,"drawing":1050602},{"step":74,"content":"再使用一次，我会释放枷锁的力量，我相信能够得到些线索。","style":2,"log_type":1,"src_id":150602079,"trial_step":79,"drawing":1050602},{"step":75,"content":"雷温的脸上明显露出迟疑的神色。","style":3,"log_type":1,"src_id":150602080,"trial_step":80,"drawing":1050602},{"step":76,"content":"没事，有我在，我不信……它还真的能再创造一个世界。","style":2,"log_type":1,"src_id":150602081,"trial_step":81,"drawing":1050602},{"step":77,"content":"听见你这么说，雷温便点了点头，她拿起那个开裂的终端，放在了耳边。","style":3,"log_type":1,"src_id":150602082,"trial_step":82,"drawing":1050600},{"step":78,"content":"你见她已经准备好，举起右手，发动了自己的枷锁。","style":3,"log_type":1,"src_id":150602083,"trial_step":83,"drawing":1050600},{"step":79,"speaker":"雷温","content":"………………啊…………","voice":["vo_trial_50602_1_81"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602085,"trial_step":85,"drawing":1050600},{"step":80,"content":"一瞬间，终端的听筒里似乎传来了什么声音。雷温的声音里带着抑制不住的惊慌。你这才发现她的脸色无比苍白，她死死咬着嘴唇，似乎从里面听到了什么。","style":3,"log_type":1,"src_id":150602086,"trial_step":86,"drawing":1050603},{"step":81,"speaker":"雷温","content":"为什么……为什么不能呢？永远不能改变吗？","voice":["vo_trial_50602_1_83"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602087,"trial_step":87,"drawing":1050603},{"step":82,"speaker":"雷温","content":"……不对，我不是……","voice":["vo_trial_50602_1_84"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602088,"trial_step":88,"drawing":1050603},{"step":83,"content":"雷温越发激动，她抓住终端机的手指用力到发白。审查室的空间随着她的负面情绪开始扭曲，带着狂厄的声音刺激着你的鼓膜。","style":3,"log_type":1,"src_id":150602089,"trial_step":89,"drawing":1050603},{"step":84,"speaker":"雷温","content":"不是我的错！是你们……你们根本就不愿意听我的声音！","voice":["vo_trial_50602_1_86"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602090,"trial_step":90,"drawing":1050603},{"step":85,"speaker":"雷温","content":"是你们把我推出去……是我自己太软弱……是我……","voice":["vo_trial_50602_1_87"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602091,"trial_step":91,"drawing":1050603},{"step":86,"speaker":"雷温","content":"既然如此，干脆把你们都——！","voice":["vo_trial_50602_1_88"],"voice_bank":"vo_eleven_trial","style":1,"log_type":1,"src_id":150602092,"trial_step":92,"drawing":1050605},{"step":87,"options":["抢夺电话！"],"style":6,"log_type":1,"src_id":150602093,"trial_step":93,"course":3,"drawing":1050605,"choices":[{"text":"抢夺电话！","goto":94}]},{"step":88,"content":"雷温！松手，放开它！","style":2,"log_type":1,"src_id":150602094,"trial_step":94,"drawing":1050605},{"step":89,"content":"雷温并未反抗，你的手抓住终端，却难以把它夺走。终端机上传来一股极其强大的吸力，让你无法动弹，只能眼睁睁看着空间继续扭曲、挤压，慢慢失去意识。","style":3,"log_type":1,"src_id":150602095,"trial_step":95,"drawing":1050605},{"step":90,"content":"混乱中，你似乎也听到了来自话筒另一侧的窃窃私语——一个暴躁且充满恶意的声音。","style":3,"background":10000,"log_type":1,"src_id":150602097,"trial_step":97},{"step":91,"speaker":"？？？","content":"一个故事，加一个问题。","voice":["vo_trial_50602_1_94"],"voice_bank":"vo_eleven_trial","style":1,"background":10000,"log_type":1,"src_id":150602098,"trial_step":98},{"step":92,"speaker":"？？？","content":"我的问题是……雷温，你真的……找回了你想要的声音吗？","voice":["vo_trial_50602_1_95"],"voice_bank":"vo_eleven_trial","style":1,"background":10000,"log_type":1,"src_id":150602099,"trial_step":99},{"step":93,"content":"（电流声音，越来越大，闪白屏）","style":18,"background":10006,"log_type":1,"src_id":150602100,"trial_step":100},{"step":94,"content":"（电流声音，越来越大，闪白屏）","style":18,"background":10006,"log_type":1,"src_id":150602101,"trial_step":101},{"step":95,"content":"电流声戛然而止。与此同时，周遭世界停止旋转，你的双脚终于落于地面。","style":3,"background":2142,"log_type":1,"src_id":150602102,"trial_step":102},{"step":96,"content":"熟悉的街道，陌生的人流。夜色低沉，压抑的气氛弥漫在这条街道。","style":3,"background":2142,"log_type":1,"src_id":150602103,"trial_step":103},{"step":97,"content":"灯火通明，死气沉沉。","style":3,"background":2142,"log_type":1,"src_id":150602104,"trial_step":104},{"step":98,"content":"下次再也不随便说话了……怎么知道这么快打脸，真的又给我创了个世界……","style":2,"background":2142,"log_type":1,"src_id":150602105,"trial_step":105},{"step":99,"options":["观察四周"],"style":6,"background":2142,"log_type":1,"src_id":150602106,"trial_step":106,"course":3,"choices":[{"text":"观察四周","goto":107}]},{"step":100,"content":"尽管你一眼看出这里和雷温曾经创造的世界一样，但明显力量弱了很多很多。","style":3,"background":2142,"log_type":1,"src_id":150602107,"trial_step":107},{"step":101,"content":"一眼能望到的尽头是纯黑色的，一点光都没有，唯一能看到的路上，无数西装革履的路人与你擦肩而过，奔向唯一一栋大楼。","style":3,"background":2142,"log_type":1,"src_id":150602108,"trial_step":108},{"step":102,"content":"伫立在人潮之中的只剩下你，雷温消失了。","style":3,"background":2142,"log_type":1,"src_id":150602109,"trial_step":109},{"step":103,"content":"突然，有人从后方抓住你的胳膊。","style":3,"background":2142,"log_type":1,"src_id":150602110,"trial_step":110},{"step":104,"speaker":"路人A","content":"……你…………","voice":["vo_trial_50602_1_107"],"voice_bank":"vo_eleven_trial","style":1,"background":2142,"log_type":1,"src_id":150602111,"trial_step":111},{"step":105,"speaker":"路人A","content":"……你……工作……","voice":["vo_trial_50602_1_108"],"voice_bank":"vo_eleven_trial","style":1,"background":2142,"log_type":1,"src_id":150602112,"trial_step":112},{"step":106,"options":["挣脱"],"style":6,"background":2142,"log_type":1,"src_id":150602113,"trial_step":113,"course":3,"choices":[{"text":"挣脱","goto":114}]},{"step":107,"content":"大哥，有话好好说，现在确实是我的工作时间，但……","style":2,"background":2142,"log_type":1,"src_id":150602114,"trial_step":114},{"step":108,"speaker":"路人A","content":"不行，工作是义务，必须去工作……！","voice":["vo_trial_50602_1_111"],"voice_bank":"vo_eleven_trial","style":1,"background":2142,"log_type":1,"src_id":150602115,"trial_step":115},{"step":109,"speaker":"路人A","content":"到时间了……你也该去……工作…………","voice":["vo_trial_50602_1_112"],"voice_bank":"vo_eleven_trial","style":1,"background":2142,"log_type":1,"src_id":150602116,"trial_step":116},{"step":110,"content":"和异世界里遇到的人一样，怪异脑袋的西装男一手抓住你的胳膊，另一只手僵硬地指向远处的大楼。","style":3,"background":2142,"log_type":1,"src_id":150602117,"trial_step":117},{"step":111,"content":"可……我的工作不在这里……","style":2,"background":2142,"log_type":1,"src_id":150602118,"trial_step":118},{"step":112,"speaker":"路人A","content":"工作不能推迟……必须现在就出发………………","voice":["vo_trial_50602_1_115"],"voice_bank":"vo_eleven_trial","style":1,"background":2142,"log_type":1,"src_id":150602119,"trial_step":119},{"step":113,"content":"它的力度越来越大，几乎是强制将你扯向写字楼的方向。","style":3,"background":2142,"log_type":1,"src_id":150602120,"trial_step":120},{"step":114,"content":"……去那里工作啊……","style":2,"background":2142,"log_type":1,"src_id":150602121,"trial_step":121},{"step":115,"content":"好，我去，我马上就去……","style":2,"background":2142,"log_type":1,"src_id":150602122,"trial_step":122},{"step":116,"content":"反正，除了那里，我也哪儿都去不了啊。","style":2,"background":2142,"log_type":1,"src_id":150602123,"trial_step":123}]}