e_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104137,"trial_step":137},{"step":138,"content":"小女孩走了过来，少年却只是不自觉地后退。他不属于这里，他只是个辛迪加的混混，他撬了亚伯的车，他……杀过人。","style":3,"background":1038,"log_type":1,"src_id":110104138,"trial_step":138},{"step":139,"content":"可小女孩还是走过来，牵起了他的手。","style":3,"background":1038,"log_type":1,"src_id":110104139,"trial_step":139},{"step":140,"speaker":"薇拉","content":"哥哥！","voice":["vo_trial_10104_1_43"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104140,"trial_step":140},{"step":141,"content":"她甜甜地笑着。","style":3,"background":1038,"log_type":1,"src_id":110104141,"trial_step":141},{"step":142,"speaker":"薇拉","content":"我们一起回家吧！","voice":["vo_trial_10104_1_44"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104142,"trial_step":142},{"step":143,"content":"唰——","style":3,"background":1013,"log_type":1,"src_id":110104143,"trial_step":143},{"step":144,"content":"尖锐的利爪在迪蒙的脸上留下伤痕。他惊醒过来，刚刚有一瞬间，他失神了。","style":3,"background":1013,"log_type":1,"src_id":110104144,"trial_step":144},{"step":145,"content":"身上的伤口在增加，迪蒙的眼前变得有些模糊。","style":3,"background":1013,"log_type":1,"src_id":110104145,"trial_step":145},{"step":146,"speaker":"迪蒙","content":"那只是过去的幻影。","voice":["vo_trial_10104_1_45"],"voice_bank":"vo_dimeng_trial","style":1,"background":1013,"log_type":1,"src_id":110104146,"trial_step":146},{"step":147,"content":"迪蒙告诫着自己。战斗中分神是极其危险的，那个家伙还需要更多时间疏散民众，自己不能就这么倒下。","style":3,"background":1013,"log_type":1,"src_id":110104147,"trial_step":147},{"step":148,"content":"得益于禁闭者的能力，左手的伤口已经结了一层浅浅的痂。","style":3,"background":1013,"log_type":1,"src_id":110104148,"trial_step":148},{"step":149,"content":"周身的疼痛刺激着他近乎麻痹的神经，带来久违的清醒。","style":3,"background":1013,"log_type":1,"src_id":110104149,"trial_step":149},{"step":150,"speaker":"迪蒙","content":"这样的错误，不会再犯第二次。","voice":["vo_trial_10104_1_46"],"voice_bank":"vo_dimeng_trial","style":1,"background":1013,"log_type":1,"src_id":110104150,"trial_step":150},{"step":151,"speaker":"薇拉","content":"哥哥，你要吃……","voice":["vo_trial_10104_1_47"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104151,"trial_step":151},{"step":152,"content":"少年的上半身遍布可怖的伤疤。他的脸有些红，赶紧穿上了衬衫。","style":3,"background":1038,"log_type":1,"src_id":110104152,"trial_step":152},{"step":153,"speaker":"薇拉","content":"你身上的这些是……","voice":["vo_trial_10104_1_48"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104153,"trial_step":153},{"step":154,"speaker":"薇拉","content":"爸爸说，哥哥你以前过得很辛苦。你过去的爸爸还会打你，原来是真的……","voice":["vo_trial_10104_1_49"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104154,"trial_step":154},{"step":155,"speaker":"薇拉","content":"不过放心！我们的爸爸是天底下最好的爸爸！除非我乱吃东西吃坏肚子，他从来不骂我。","voice":["vo_trial_10104_1_50"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104155,"trial_step":155},{"step":156,"speaker":"薇拉","content":"我和爸爸都会保护你的，以后谁都不敢欺负你啦！","voice":["vo_trial_10104_1_51"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104156,"trial_step":156},{"step":157,"speaker":"薇拉","content":"哥哥，你要走了吗？","voice":["vo_trial_10104_1_52"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104157,"trial_step":157},{"step":158,"content":"少年有些尴尬地点了点头。他特意选了这么早的时间出门，只因不知如何面对离别。","style":3,"background":1038,"log_type":1,"src_id":110104158,"trial_step":158},{"step":159,"speaker":"迪蒙","content":"我要去新城警官学院。亚伯……父亲他有很多事情要做，我想，我至少应该学些东西，替他分担压力。","voice":["vo_trial_10104_1_53"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104159,"trial_step":159},{"step":160,"speaker":"薇拉","content":"我知道……","voice":["vo_trial_10104_1_54"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104160,"trial_step":160},{"step":161,"content":"女孩的声音有些委屈。","style":3,"background":1038,"log_type":1,"src_id":110104161,"trial_step":161},{"step":162,"speaker":"薇拉","content":"可我还是舍不得你走。","voice":["vo_trial_10104_1_55"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104162,"trial_step":162},{"step":163,"content":"少年微笑着抚摸着女孩的头。","style":3,"background":1038,"log_type":1,"src_id":110104163,"trial_step":163},{"step":164,"speaker":"迪蒙","content":"放心，用不了多久，我就会回来的。","voice":["vo_trial_10104_1_56"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104164,"trial_step":164},{"step":165,"speaker":"迪蒙","content":"抱歉，薇拉，我回来得太晚了……","voice":["vo_trial_10104_1_57"],"voice_bank":"vo_dimeng_trial","style":1,"background":1013,"log_type":1,"src_id":110104165,"trial_step":165},{"step":166,"content":"迪蒙抚摸着胸前口袋里的笔记本，喃喃自语。","style":3,"background":1013,"log_type":1,"src_id":110104166,"trial_step":166},{"step":167,"content":"那是他浑身上下，最后一片没有被浸透的地方。","style":3,"background":1013,"log_type":1,"src_id":110104167,"trial_step":167},{"step":168,"speaker":"迪蒙","content":"我早该和你聊聊的，薇拉，在我犯下这一切罪行之前……","voice":["vo_trial_10104_1_58"],"voice_bank":"vo_dimeng_trial","style":1,"background":1013,"log_type":1,"src_id":110104168,"trial_step":168},{"step":169,"content":"迪蒙直直地站着。他感觉很累了，就连身上的铠甲，都因沾染污秽而变得沉重起来。","style":3,"background":1013,"log_type":1,"src_id":110104169,"trial_step":169},{"step":170,"content":"他该休息一会儿，就一会。或许该找谁聊聊，哪怕是幻影也好。","style":3,"background":1013,"log_type":1,"src_id":110104170,"trial_step":170},{"step":171,"content":"迪蒙闭上眼睛，眼睑之下，只有无边的黑暗。","style":3,"background":1013,"log_type":1,"src_id":110104171,"trial_step":171},{"step":172,"content":"青年背着包，有些踌躇地敲了敲门，却一直没有人回应。他一拧门把手，发现门并没有锁。","style":3,"background":1038,"log_type":1,"src_id":110104172,"trial_step":172},{"step":173,"content":"屋子里黑黢黢的。","style":3,"background":1038,"log_type":1,"src_id":110104173,"trial_step":173},{"step":174,"content":"啪——","style":3,"background":1038,"log_type":1,"src_id":110104174,"trial_step":174},{"step":175,"speaker":"薇拉","content":"生日快乐！","voice":["vo_trial_10104_1_59"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104175,"trial_step":175},{"step":176,"content":"家中的灯突然打开，漫天的彩带从天而降，少女站在背后，手上捧着蛋糕。","style":3,"background":1038,"log_type":1,"src_id":110104176,"trial_step":176},{"step":177,"content":"青年转过身，脸上露出温暖的笑容。","style":3,"background":1038,"log_type":1,"src_id":110104177,"trial_step":177},{"step":178,"speaker":"迪蒙","content":"谢谢……","voice":["vo_trial_10104_1_60"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104178,"trial_step":178},{"step":179,"content":"他一边将粘在少女头上的彩带摘下，一边朝着沙发上的男人点了点头。","style":3,"background":1038,"log_type":1,"src_id":110104179,"trial_step":179},{"step":180,"speaker":"亚伯","content":"咳咳。","voice":["vo_trial_10104_1_61"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104180,"trial_step":180},{"step":181,"content":"男人从沙发上站了起来。这几年，他老得很快。但看到养子回来，脸上的皱纹也舒展开了。","style":3,"background":1038,"log_type":1,"src_id":110104181,"trial_step":181},{"step":182,"speaker":"亚伯","content":"宣布个好消息。","voice":["vo_trial_10104_1_62"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104182,"trial_step":182},{"step":183,"speaker":"亚伯","content":"虽然现在还没有完全确定，但基于你最近的表现，大约在一个月后，就能升任特遣队队长了。","voice":["vo_trial_10104_1_63"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104183,"trial_step":183},{"step":184,"speaker":"薇拉","content":"真的吗？！","voice":["vo_trial_10104_1_64"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104184,"trial_step":184},{"step":185,"content":"少女惊喜地睁大了眼睛。","style":3,"background":1038,"log_type":1,"src_id":110104185,"trial_step":185},{"step":186,"speaker":"薇拉","content":"你是天底下最棒的哥哥！","voice":["vo_trial_10104_1_65"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104186,"trial_step":186},{"step":187,"speaker":"薇拉","content":"哥，我听说有人想……伤害爸爸……是真的吗？","voice":["vo_trial_10104_1_66"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104187,"trial_step":187},{"step":188,"content":"青年一脸疲惫，但听到了少女的问题，还是微笑着回答。","style":3,"background":1038,"log_type":1,"src_id":110104188,"trial_step":188},{"step":189,"speaker":"迪蒙","content":"嗯，父亲这次竞选得罪了一些人。","voice":["vo_trial_10104_1_67"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104189,"trial_step":189},{"step":190,"content":"少女满脸担忧和焦急。","style":3,"background":1038,"log_type":1,"src_id":110104190,"trial_step":190},{"step":191,"speaker":"薇拉","content":"那怎么办……","voice":["vo_trial_10104_1_68"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104191,"trial_step":191},{"step":192,"speaker":"迪蒙","content":"放心，我会保护他。","voice":["vo_trial_10104_1_69"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104192,"trial_step":192},{"step":193,"content":"沉默了一会儿，少女勉强笑了出来。","style":3,"background":1038,"log_type":1,"src_id":110104193,"trial_step":193},{"step":194,"speaker":"薇拉","content":"嗯，哥哥，我相信你。","voice":["vo_trial_10104_1_70"],"voice_bank":"vo_dimeng_trial","style":1,"background":1038,"log_type":1,"src_id":110104194,"trial_step":194},{"step":195,"speaker":"迪蒙","content":"你不该相信我的。","voice":["vo_trial_10104_1_71"],"voice_bank":"vo_dimeng_trial","style":1,"background":1013,"log_type":1,"src_id":110104195,"trial_step":195},{"step":196,"content":"迪蒙用最后的力气拧断压面前死役的脖子。他的身体终于不堪重负，跪倒在地。","style":3,"background":1013,"log_type":1,"src_id":110104196,"trial_step":196},{"step":197,"content":"四周的废墟碎石和融化消解，迪蒙再一次回到了那个八平米的小房间里。","style":3,"background":1013,"log_type":1,"src_id":110104197,"trial_step":197},{"step":198,"speaker":"迪蒙","content":"我辜负了你……","voice":["vo_trial_10104_1_72"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110104198,"trial_step":198},{"step":199,"content":"薇拉的遗骨静静躺在那里，没有回应迪蒙。","style":3,"background":1034,"log_type":1,"src_id":110104199,"trial_step":199},{"step":200,"speaker":"迪蒙","content":"我是个懦夫，一事无成的废物……我不值得你信任……","voice":["vo_trial_10104_1_73"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110104200,"trial_step":200},{"step":201,"speaker":"迪蒙","content":"我没能保护得了亚伯，连你也……","voice":["vo_trial_10104_1_74"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110104201,"trial_step":201},{"step":202,"content":"男人干燥皴裂的嘴唇上下开合阖着。","style":3,"background":1034,"log_type":1,"src_id":110104202,"trial_step":202},{"step":203,"content":"可面对眼前的少女，他却再无法说出一个字。","style":3,"background":1034,"log_type":1,"src_id":110104203,"trial_step":203},{"step":204,"content":"下一刻，迪蒙猛地站起身，发出凄厉的嘶吼。","style":3,"background":1013,"log_type":1,"src_id":110104204,"trial_step":204},{"step":205,"speaker":"迪蒙","content":"呃啊啊啊啊啊啊啊啊啊！！！","voice":["vo_trial_10104_1_75"],"voice_bank":"vo_dimeng_trial","style":1,"background":1013,"log_type":1,"src_id":110104205,"trial_step":205},{"step":206,"content":"自背后伺机偷袭的死役被迪蒙举到半空中，悲鸣之后，梦一般的幻觉被冲刷殆尽。","style":3,"background":1013,"log_type":1,"src_id":110104206,"trial_step":206},{"step":207,"content":"胸前口袋里的笔记本，掉了出来，翻在最后一页。","style":3,"background":1013,"log_type":1,"src_id":110104207,"trial_step":207},{"step":208,"content":"亲爱的哥哥，向你问好。","style":10,"background":10000,"log_type":1,"src_id":110104208,"trial_step":208},{"step":209,"content":"已经过去一年了，我还是不知道这里究竟是什么地方。每天都会有新的面孔来，也会有旧面孔消失。我每天都会从窗口朝外看，希望能从人群中找到你，但又会庆幸，你不在其中。\n\n    请原谅我有这种想法……大概是因为我太久太久，没有见到过你了。\n\n    今天看到窗外的夕阳时，我又想起我们第一次相遇的情景：我和爸爸带着你回家，我们走在家门前的小路上。一路上你都不愿意讲话，我只能一直看着路边的风景。好在，那天的夕阳很美，就和今天的一样。\n\n    抱歉，我或许没办法再坚持下去了。\n\n    我不知道别的人怎么想，但我希望你知道，无论你在做些什么，无论他们怎么说，我都愿意相信你。我始终……感激着与你的相遇。\n\n    愿你能平安幸福地度过每一天。","voice":["vo_trial_10104_1_76"],"voice_bank":"vo_dimeng_trial","style":10,"background":10000,"log_type":1,"src_id":110104209,"trial_step":209},{"step":210,"content":"你的妹妹 薇拉","style":10,"background":10000,"log_type":1,"src_id":110104210,"trial_step":210},{"step":211,"content":"男人抬起头，眼泪沿着面颊，滴落在地面上。","style":3,"background":1013,"log_type":1,"src_id":110104211,"trial_step":211},{"step":212,"speaker":"迪蒙","content":"薇……拉……","voice":["vo_trial_10104_1_77"],"voice_bank":"vo_dimeng_trial","style":1,"background":1013,"log_type":1,"src_id":110104212,"trial_step":212},{"step":213,"content":"他最后一次念出那个名字。一切的幻象与回忆，都消失了。","style":3,"background":1013,"log_type":1,"src_id":110104213,"trial_step":213},{"step":214,"speaker":"迪蒙","content":"谢谢你……","voice":["vo_trial_10104_1_78"],"voice_bank":"vo_dimeng_trial","style":1,"background":1013,"log_type":1,"src_id":110104214,"trial_step":214},{"step":215,"content":"四周死役的尸体堆积如山，原本挥之不去的可怖哀嚎，也再听不到了。","style":3,"background":1013,"log_type":1,"src_id":110104215,"trial_step":215},{"step":216,"speaker":"迪蒙","content":"我……做到了……","voice":["vo_trial_10104_1_79"],"voice_bank":"vo_dimeng_trial","style":1,"background":1013,"log_type":1,"src_id":110104216,"trial_step":216},{"step":217,"content":"什么都不剩下了。死役、战斗、承诺，温暖，曾经牵挂和信任自己的家人……","style":3,"background":1013,"log_type":1,"src_id":110104217,"trial_step":217},{"step":218,"content":"一切都在夜晚锈河刺骨的寒风中，消散了。","style":3,"background":1013,"log_type":1,"src_id":110104218,"trial_step":218},{"step":219,"content":"他笑了，然后闭上眼睛，倒在地上。盔甲撞击地面，发出沉闷的声响。","style":3,"background":1013,"log_type":1,"src_id":110104219,"trial_step":219},{"step":220,"content":"……醒……醒……","style":2,"background":10000,"log_type":1,"src_id":110104220,"trial_step":220},{"step":221,"content":"迪……蒙……","style":2,"background":10000,"log_type":1,"src_id":110104221,"trial_step":221},{"step":222,"content":"迪蒙！醒醒！！！","style":2,"background":10000,"log_type":1,"src_id":110104222,"trial_step":222},{"step":223,"content":"我说过，我会回来的……","style":2,"background":10000,"log_type":1,"src_id":110104223,"trial_step":223},{"step":224,"content":"你还不可以死！！","style":2,"background":10000,"log_type":1,"src_id":110104224,"trial_step":224}]}