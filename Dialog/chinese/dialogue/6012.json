{"id":6012,"chapter_id":6,"scene_id":601,"steps":[{"step":1,"content":"战斗结束了，混沌的黑影消失了，赫罗的残象也无处可寻。","style":3,"background":601,"log_type":1},{"step":2,"content":"但卓娅还在前方，揪着一个敌人，一拳又一拳，重重地打下去。","style":3,"background":601,"log_type":1},{"step":3,"speaker":"少年卓娅","content":"啊啊啊！","voice":["vo_cgplot_6012003"],"voice_bank":"vo_cgplot_06","style":1,"background":601,"log_type":1},{"step":4,"content":"仔细看，那不是军团长的装束。她还称不上高大，满身绷带，攻击很疯狂，却少了异于常人的力量——还是年轻人尚未成熟的拳头。","style":3,"background":601,"log_type":1},{"step":5,"content":"年轻的卓娅唯有暴怒的破坏冲动一如既往，甚至更为炽烈。","style":3,"background":601,"log_type":1},{"step":6,"speaker":"少年卓娅","content":"<size=44>去死！！！</size>","voice":["vo_cgplot_6012006"],"voice_bank":"vo_cgplot_06","style":1,"background":601,"log_type":1},{"step":7,"content":"她的怒吼声已经沙哑，拳头紧握，人已迷失在愤怒之中。","style":3,"background":601,"log_type":1},{"step":8,"speaker":"选项","options":["卓娅，别打了"],"jump":[9],"style":6,"background":601,"log_type":1},{"step":9,"speaker":"？？","content":"叫你住手！别**上头了！！","voice":["vo_cgplot_6012009"],"voice_bank":"vo_cgplot_06","style":1,"background":601,"log_type":1},{"step":10,"content":"一只手猛地拽住她扬起的拳头，这让杀红了眼的卓娅更加暴躁。她猛地回头愤怒地瞪视阻止她的人，却怔住了。","style":3,"background":601,"log_type":1},{"step":11,"content":"那是一个高大的中年男子，穿着治安官的制服。","style":3,"background":601,"log_type":1},{"step":12,"speaker":"少年卓娅","content":"……莱格特？","voice":["vo_cgplot_6012012"],"voice_bank":"vo_cgplot_06","style":1,"background":601,"log_type":1},{"step":13,"content":"她怔怔地说出这个名字，周围的雾气渐渐流动起来，漫过你的视野。","style":3,"background":601,"log_type":1}]}