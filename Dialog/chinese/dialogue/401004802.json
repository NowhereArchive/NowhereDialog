{"id":401004802,"chapter_id":50025,"scene_id":52524,"steps":[{"step":1,"content":"众人赶到公园时，战斗已经结束了。","style":3,"background":2100,"log_type":1},{"step":2,"content":"满园花草被斩碎，死役残骸遍地，加洛法诺被踩在脚下。她身上单瞳的符文不断燃烧，但再也掀不起水花，烧着烧着最终黯淡湮灭。","style":3,"background":2100,"log_type":1},{"step":3,"content":"最后，战场中央只剩罗睺一人。所有的污染都向她聚拢吸附。剑盾厚重而锋利，战衣满是血污。","style":3,"background":4152,"log_type":1},{"step":4,"speaker":"安全负责人","content":"那个刺客还活着吗？","voice":["vo_event_401004802_4"],"voice_bank":"vo_event_10048","style":1,"background":4152,"log_type":1},{"step":5,"speaker":"安全负责人","content":"又是……新的怪物？","voice":["vo_event_401004802_5"],"voice_bank":"vo_event_10048","style":1,"background":4152,"log_type":1},{"step":6,"speaker":"罗睺","content":"……瑟琳呢？","voice":["vo_event_401004802_6"],"voice_bank":"vo_event_10048","style":1,"background":4152,"log_type":1},{"step":7,"speaker":"“代理”","content":"……","voice":["vo_event_401004802_7"],"voice_bank":"vo_event_10048","style":1,"background":4152,"log_type":1},{"step":8,"content":"代理眉头紧皱，很快转身要走。却被另一人拦住了。","style":3,"background":4152,"log_type":1},{"step":9,"content":"瑟琳拦下代理，一句话也没说，只是直直地看着蓝雨中那个近乎失控的野兽。半响，她独自向前，走进被撕碎的花园。","style":3,"background":4152,"log_type":1},{"step":10,"speaker":"瑟琳","content":"没想到这里被破坏成这样……我很喜欢这个花园的。","voice":["vo_event_401004802_9"],"voice_bank":"vo_event_10048","style":1,"background":2100,"log_type":1},{"step":11,"speaker":"瑟琳","content":"为什么要回来？","voice":["vo_event_401004802_10"],"voice_bank":"vo_event_10048","style":1,"background":2100,"log_type":1},{"step":12,"speaker":"瑟琳","content":"不是说过，完成你的任务，无论发生什么都不要回头吗？","voice":["vo_event_401004802_11"],"voice_bank":"vo_event_10048","style":1,"background":2100,"log_type":1},{"step":13,"content":"蓝雨和污染交织着搅动她的意识，人们看不清罗睺的表情，隔着面罩，她的喘息很重，像疲劳又压抑的恶鬼。只剩下一个意识。","style":3,"background":2100,"log_type":1},{"step":14,"speaker":"罗睺","content":"……使用05257885的……是你吗？","voice":["vo_event_401004802_14"],"voice_bank":"vo_event_10048","style":1,"background":2100,"log_type":1},{"step":15,"speaker":"瑟琳","content":"……","style":1,"background":2100,"log_type":1},{"step":16,"speaker":"瑟琳","content":"就为这种事？","voice":["vo_event_401004802_16"],"voice_bank":"vo_event_10048","style":1,"background":2100,"log_type":1},{"step":17,"content":"瑟琳叹了口气。","style":3,"background":2100,"log_type":1},{"step":18,"speaker":"瑟琳","content":"测试失败了，罗睺。你亲手阻断了自己的路，我对你很失望。","voice":["vo_event_401004802_18"],"voice_bank":"vo_event_10048","style":1,"background":2100,"log_type":1}]}