{"id":402901021,"chapter_id":70045,"scene_id":74503,"steps":[{"step":2,"content":"一辆破破烂烂的车飞速飙过，扬起一阵烟尘。后方，砂盗的车队紧追不舍。","style":3,"background":2007,"log_type":1},{"step":3,"speaker":"海拉","content":"**，姐姐会飙车？！太帅了！","voice":["vo_event_402901021_02"],"voice_bank":"vo_event_29102","style":1,"background":2007,"log_type":1},{"step":4,"speaker":"柯琳","content":"喜欢吗？","voice":["vo_event_402901021_03"],"voice_bank":"vo_event_29102","style":1,"background":2007,"log_type":1},{"step":5,"speaker":"海拉","content":"喜欢！以前那笨蛋开车太守规矩，慢吞吞可没劲了，这次让我坐个够！","voice":["vo_event_402901021_04"],"voice_bank":"vo_event_29102","style":1,"background":2007,"log_type":1},{"step":6,"content":"看着海拉兴奋的脸，赏金猎人爽朗一笑。","style":3,"background":2007,"log_type":1},{"step":7,"speaker":"柯琳","content":"那就好，大砂海上没人管，爱开多快开多快，来吧小海拉！油门你来踩！","voice":["vo_event_402901021_06"],"voice_bank":"vo_event_29102","style":1,"background":2007,"log_type":1},{"step":8,"speaker":"海拉","content":"wow——啊？","voice":["vo_event_402901021_07"],"voice_bank":"vo_event_29102","style":1,"background":2007,"log_type":1},{"step":9,"content":"说着柯琳从驾驶座上跃起，提溜着海拉的后衣领像捉小鸡崽般把她拎到驾驶座。自己转身举枪向后。","style":3,"background":2007,"log_type":1},{"step":10,"speaker":"海拉","content":"啊？？？不是不是，我只会坐别人的车，自己没驾照啊！你给我回来！","voice":["vo_event_402901021_09"],"voice_bank":"vo_event_29102","style":1,"background":2007,"log_type":1},{"step":11,"speaker":"柯琳","content":"哈哈你手短啊宝贝，负责驾驶最合适啦，没问题的！","voice":["vo_event_402901021_10"],"voice_bank":"vo_event_29102","style":1,"background":2007,"log_type":1},{"step":12,"speaker":"柯琳","content":"一看你就天赋异禀，大冒险的主人公当然不会翻车——加油随便开，记得握紧方向盘哦！","voice":["vo_event_402901021_11"],"voice_bank":"vo_event_29102","style":1,"background":2007,"log_type":1},{"step":13,"speaker":"柯琳","content":"至于我嘛……","voice":["vo_event_402901021_12"],"voice_bank":"vo_event_29102","style":1,"background":2007,"log_type":1},{"step":14,"content":"柯琳装子弹上膛。","style":3,"background":2007,"log_type":1},{"step":15,"speaker":"柯琳","content":"我得带你们看看这场独属于砂海的大冒险！","voice":["vo_event_402901000_02"],"voice_bank":"vo_event_29100","style":1,"background":2007,"log_type":1},{"step":16,"speaker":"海拉","content":"你*文明狄斯*——！","voice":["vo_event_402901021_15"],"voice_bank":"vo_event_29102","style":1,"background":2007,"log_type":1}]}