{"id":402902021,"chapter_id":70045,"scene_id":74509,"steps":[{"step":1,"content":"【砂海集市】","style":18,"background":2297,"log_type":1},{"step":2,"content":"砂海集市一如既往的热闹，小贩叫卖揽客，旅人川流不息。","style":3,"background":2297,"log_type":1},{"step":3,"content":"突然，有人停了下来。人们纷纷止步在一块木板下，很快将路堵死。所有人都在窃窃私语，好奇地看向告示栏旁的少女。","style":3,"background":2297,"log_type":1},{"step":4,"speaker":"海拉","content":"——走过路过不要错过，瞧一瞧看一看了啊！","voice":["vo_event_402902021_04"],"voice_bank":"vo_event_29202","style":1,"background":2297,"log_type":1},{"step":5,"content":"一大把全新的通缉令糊满了整面墙壁。","style":3,"background":2297,"log_type":1},{"step":6,"content":"原先砂盗们狰狞的画像已然瞧不见了，变成图科人或犯蠢或可笑的古怪画像，带着一连串悬赏金额盖在他们上头，压得严严实实。","style":3,"background":2297,"log_type":1},{"step":7,"speaker":"海拉","content":"砂海最坏、最恶心的大骗局就此揭晓！邪恶诈骗团伙人均影帝级表现！三分真情演到你流泪！","voice":["vo_event_402902021_05"],"voice_bank":"vo_event_29202","style":1,"background":2297,"log_type":1},{"step":8,"speaker":"海拉","content":"现在呢，他们惹到了不该惹的人！MBCC都听说过吧？局长都听说过吧？","voice":["vo_event_402902021_09"],"voice_bank":"vo_event_29202","style":1,"background":2297,"log_type":1},{"step":9,"speaker":"海拉","content":"谁能上来带我回图科一起复仇，本大爷就代表MBCC，调动${PlayerName}的工资——重重地赏你！","voice":["vo_event_402902021_10"],"voice_bank":"vo_event_29202","style":1,"background":2297,"log_type":1},{"step":10,"content":"围观的人多，但其中看热闹的人也多。","style":3,"background":2297,"log_type":1},{"step":11,"content":"有几个人半信半疑，上前和海拉沟通交涉，但没一会就摇着头离开。旁观者见状更认为她只是在哗众取宠，看够了热闹转身就走。","style":3,"background":2297,"log_type":1},{"step":12,"content":"半天下来，竟没一个人愿意接单。","style":3,"background":2297,"log_type":1},{"step":13,"content":"不过海拉也不急，慢悠悠地收好小板凳准备打道回府。一边走，一边装模做样地嘀咕。","style":3,"background":2297,"log_type":1},{"step":14,"speaker":"海拉","content":"哎，看来今天也没有招募到合适的人呢，中午又热人又少，还是回去睡大觉吧~","voice":["vo_event_402902021_16"],"voice_bank":"vo_event_29202","style":1,"background":2297,"log_type":1},{"step":15,"content":"假装没看到跟在后面的黑影，海拉转身进入小巷。","style":3,"background":2297,"log_type":1},{"step":16,"content":"接着，麻袋和闷棍一起落下。","style":3,"background":2297,"log_type":1},{"step":17,"speaker":"海拉","content":"唔——！","voice":["vo_event_402902021_19"],"voice_bank":"vo_event_29202","style":1,"background":10000,"log_type":1},{"step":18,"content":"【黑屏】","style":18,"background":10000,"log_type":1},{"step":19,"speaker":"海拉","content":"*文明狄斯*，脑袋……疼死了……","voice":["vo_event_402902021_22"],"voice_bank":"vo_event_29202","style":1,"background":10000,"log_type":1},{"step":20,"content":"不知过了多久，意识逐渐回笼。","style":3,"background":10000,"log_type":1},{"step":21,"content":"落在后脑的闷棍比预想中更疼。耳边有人在说话，但声音忽远忽近，听不真切。","style":3,"background":10000,"log_type":1},{"step":22,"speaker":"？？？","content":"她怎么还不醒？你是不是下手太重了，不会是真敲坏了吧？","voice":["vo_event_402902021_25"],"voice_bank":"vo_event_29202","style":1,"background":10000,"log_type":1},{"step":23,"speaker":"？？？","content":"不、不能吧！我也没使多大劲啊！比起平时这已经很轻了……！","voice":["vo_event_402902021_26"],"voice_bank":"vo_event_29202","style":1,"background":10000,"log_type":1},{"step":24,"speaker":"？？？","content":"别急，好像醒了。","voice":["vo_event_402902021_27"],"voice_bank":"vo_event_29202","style":1,"background":10000,"log_type":1},{"step":25,"content":"声音愈发清晰，眼前亮光闪动，黑暗开始褪去——","style":3,"background":10000,"log_type":1},{"step":27,"speaker":"海拉","content":"这是……图科？","voice":["vo_event_402902021_30"],"voice_bank":"vo_event_29202","style":1,"background":2292,"log_type":1},{"step":28,"speaker":"柯琳","content":"对啊，就是图科，你做梦都想回来“复仇”的图科~","voice":["vo_event_402902021_33"],"voice_bank":"vo_event_29202","style":1,"background":2292,"log_type":1},{"step":29,"content":"几张笑嘻嘻的脸直接闯入视线，柯琳和一群图科人正蹲在她身边，笑眯眯地低头看着她。","style":3,"background":2292,"log_type":1},{"step":30,"content":"……低头？","style":3,"background":2292,"log_type":1},{"step":31,"content":"身体四周传来异常的束缚感。海拉僵硬地低下头——面前只有一片平坦的地面，看不见半点身子。","style":3,"background":2292,"log_type":1},{"step":32,"speaker":"海拉","content":"？！！！！！！！","style":1,"background":2292,"log_type":1},{"step":33,"content":"她被直接“种”在了地里。","style":3,"background":2292,"log_type":1},{"step":34,"content":"柯琳拿着通缉令，随手抖了抖。","style":3,"background":2292,"log_type":1},{"step":35,"speaker":"柯琳","content":"按你说的来啊——只要有人带你回图科、帮你报仇，就重重有赏。","voice":["vo_event_402902021_35"],"voice_bank":"vo_event_29202","style":1,"background":2292,"log_type":1},{"step":36,"speaker":"柯琳","content":"现在我已经完成了一半了，后一半儿……等你把MBCC局长的工资打我账上，我们再交接？","voice":["vo_event_402902021_36"],"voice_bank":"vo_event_29202","style":1,"background":2292,"log_type":1},{"step":37,"speaker":"海拉","content":"呸！想得美，这钱我扔水沟里也不给你，一群就会骗人和敲闷棍的卑鄙小人！","voice":["vo_event_402902021_37"],"voice_bank":"vo_event_29202","style":1,"background":2292,"log_type":1},{"step":38,"content":"周身的土壤并没被压实，海拉猛地挣出一只手，用力锤在柯琳脸上。","style":3,"background":2292,"log_type":1},{"step":39,"content":"什么计划什么报仇——先打一顿出口气再说！","style":3,"background":2292,"log_type":1}]}