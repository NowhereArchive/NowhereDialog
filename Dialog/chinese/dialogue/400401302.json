{"id":400401302,"chapter_id":50016,"scene_id":51621,"steps":[{"step":1,"content":"一场恶战后，琳的体力所剩无几。但嗷呜大魔王的声音却还是遥不可及。","style":3,"background":10000,"log_type":1},{"step":2,"speaker":"村民","content":"琳？是你么？琳！","voice":["vo_event_400401302_3"],"voice_bank":"vo_event_04013","style":1,"background":4041,"log_type":1},{"step":3,"speaker":"村民","content":"别管我们！去找糖果……你现在没办法赢过它的，你要好好的！","voice":["vo_event_400401302_4"],"voice_bank":"vo_event_04013","style":1,"background":4041,"log_type":1},{"step":4,"content":"村民们的声音虚弱地传出山洞。","style":3,"background":4041,"log_type":1},{"step":5,"speaker":"琳","content":"……","style":1,"background":4041,"log_type":1},{"step":6,"speaker":"琳","content":"呜……大家……对不起……","voice":["vo_event_400401302_7"],"voice_bank":"vo_event_04013","style":1,"background":4042,"log_type":1},{"step":7,"content":"于是琳还是放弃了进入洞窟，继续去寻找勇气糖果。","style":3,"background":4042,"log_type":1}]}