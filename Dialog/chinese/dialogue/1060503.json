{"id":1060503,"chapter_id":1060503,"scene_id":1,"steps":[{"step":1,"speaker":"伊芙","content":"或许我现在有点明白那些谎言是什么了……","voice":["vo_trial_60503_1_1"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503001,"trial_step":1},{"step":2,"content":"伊芙在自己的病房里，看着窗外的辛迪加街道，掏出了一本问诊所借来的笔记本。","style":3,"background":111,"log_type":1,"src_id":160503002,"trial_step":2},{"step":3,"content":"她用彩色的蜡笔，像童话书似的，在上面记录着什么——","style":3,"background":111,"log_type":1,"src_id":160503003,"trial_step":3},{"step":4,"content":"局长，这是你将我留在诊所的第四天。\n今天也是莉莉手术的日子，我撒了谎。\n医师说，如果污染部分能够切除，莉莉就能活下来。\n我骗莉莉，手术很简单的，一点都不痛。\n我大概懂了，谎言是糖果那样的东西吧？\n它治不了病，但是能让我们此时此刻，尝到一些甜味。","voice":["vo_trial_60503_1_4"],"voice_bank":"vo_eve_trial","style":13,"background":111,"log_type":1,"src_id":160503004,"trial_step":4},{"step":5,"speaker":"莉莉","content":"伊芙姐姐，你在写什么？","voice":["vo_trial_60503_1_5"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503005,"trial_step":5},{"step":6,"content":"一个小脑袋突然凑过来趴在伊芙膝盖上，伊芙没有推开。","style":3,"background":111,"log_type":1,"src_id":160503006,"trial_step":6},{"step":7,"speaker":"伊芙","content":"在写一个问题的回答。","voice":["vo_trial_60503_1_7"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503007,"trial_step":7},{"step":8,"speaker":"伊芙","content":"我和问问题的人约好了，等他回来，就要告诉他我的选择。","female_content":"我和问问题的人约好了，等她回来，就要告诉她我的选择。","voice":["vo_trial_60503_1_8"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503008,"trial_step":8},{"step":9,"speaker":"伊芙","content":"是继续睡下去，还是睁开眼睛。","voice":["vo_trial_60503_1_9"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503009,"trial_step":9},{"step":10,"content":"莉莉不理解，抱着那只修好的娃娃，陪伊芙看着窗外。但她很快就觉得无聊了，开始炫耀起自己身上的新变化——","style":3,"background":111,"log_type":1,"src_id":160503010,"trial_step":10},{"step":11,"speaker":"莉莉","content":"快看！我安上了和护士姐姐一样的义肢！","voice":["vo_trial_60503_1_11"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503011,"trial_step":11},{"step":12,"speaker":"莉莉","content":"医师们就像伊芙姐姐修玩具一样把我修好了！和新的一样！","voice":["vo_trial_60503_1_12"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503012,"trial_step":12},{"step":13,"speaker":"伊芙","content":"切除污染的手术，疼吗？","voice":["vo_trial_60503_1_13"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503013,"trial_step":13},{"step":14,"speaker":"莉莉","content":"疼！疼死了！但是我很坚强哦~我忍过来了！","voice":["vo_trial_60503_1_14"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503014,"trial_step":14},{"step":15,"speaker":"莉莉","content":"瞧，我的手好灵活，一点事都没有！","voice":["vo_trial_60503_1_15"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503015,"trial_step":15},{"step":16,"speaker":"伊芙","content":"嗯，真好。","voice":["vo_trial_60503_1_16"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503016,"trial_step":16},{"step":17,"speaker":"莉莉","content":"伊芙姐姐的腿，什么时候也能站起来吗？","voice":["vo_trial_60503_1_17"],"voice_bank":"vo_eve_trial","style":1,"background":111,"log_type":1,"src_id":160503017,"trial_step":17},{"step":18,"content":"伊芙怔了怔，她似乎还没来得及思考这件事。","style":3,"background":111,"log_type":1,"src_id":160503018,"trial_step":18},{"step":19,"content":"今天，依然没有你的消息。\n要是能直接告诉你就好了，今天我接受了单独的会诊。\n医师说，我的心理状况好多了，狂厄很稳定，身上的神经也正在康复和活跃。\n我能感觉到，是你种在我身体里的枷锁带来了安定的力量。","voice":["vo_trial_60503_1_20"],"voice_bank":"vo_eve_trial","style":13,"background":120,"log_type":1,"src_id":160503020,"trial_step":20},{"step":20,"speaker":"小护士","content":"写给谁的？","voice":["vo_trial_60503_1_21"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160503021,"trial_step":21},{"step":21,"content":"小护士突然从后面拍了拍伊芙的肩膀，吓得她赶紧合上了本子。","style":3,"background":120,"log_type":1,"src_id":160503022,"trial_step":22},{"step":22,"speaker":"小护士","content":"别藏啦，我知道你在写什么。可是那个人很忙诶，他真的会看到吗？","female_content":"别藏啦，我知道你在写什么。可是那个人很忙诶，她真的会看到吗？","voice":["vo_trial_60503_1_23"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160503023,"trial_step":23},{"step":23,"speaker":"伊芙","content":"当然会！","voice":["vo_trial_60503_1_24"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160503024,"trial_step":24},{"step":24,"speaker":"伊芙","content":"他在玩具屋里看了我以前的故事。这次一定也会耐心看完的。","female_content":"她在玩具屋里看了我以前的故事。这次一定也会耐心看完的。","voice":["vo_trial_60503_1_25"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160503025,"trial_step":25},{"step":25,"speaker":"小护士","content":"好好好，那就给这个人一个惊喜吧~","voice":["vo_trial_60503_1_26"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160503026,"trial_step":26},{"step":26,"content":"小护士递给伊芙一份报告。","style":3,"background":120,"log_type":1,"src_id":160503027,"trial_step":27},{"step":27,"speaker":"伊芙","content":"这是什么？","voice":["vo_trial_60503_1_28"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160503028,"trial_step":28},{"step":28,"speaker":"小护士","content":"是医师们对你新的评估。","voice":["vo_trial_60503_1_29"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160503029,"trial_step":29},{"step":29,"speaker":"小护士","content":"好消息，伊芙，你能站起来！","voice":["vo_trial_60503_1_30"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160503030,"trial_step":30},{"step":30,"content":"我的义肢有一些反应了，会在无意识的时候开始抽动。\n当然，距离完全康复，还要很久很久很久呢，那个时候，你一定已经回来了吧。\n明明是个好消息，我却高兴不起来……\n听说辛迪加爆发了很严重的暴乱，大街上到处是流窜的禁闭者。\n好多流血受伤的人被送进了诊所。\n不知道你怎么样了。","voice":["vo_trial_60503_1_32"],"voice_bank":"vo_eve_trial","style":13,"background":116,"log_type":1,"src_id":160503032,"trial_step":32},{"step":31,"speaker":"莉莉","content":"他们……没事吧？","voice":["vo_trial_60503_1_33"],"voice_bank":"vo_eve_trial","style":1,"background":116,"log_type":1,"src_id":160503033,"trial_step":33},{"step":32,"content":"莉莉小心地躲在伊芙的轮椅后面。","style":3,"background":116,"log_type":1,"src_id":160503034,"trial_step":34},{"step":33,"speaker":"莉莉","content":"一定发生了什么对吧？大家都不肯告诉我。最近护士姐姐好忙，都没空陪我玩了。","voice":["vo_trial_60503_1_35"],"voice_bank":"vo_eve_trial","style":1,"background":116,"log_type":1,"src_id":160503035,"trial_step":35},{"step":34,"content":"诊所空前忙乱，一台台担架被抬进又送出，散发出让人不快的气味。到处是护理和医师高声沟通支援的声音。","style":3,"background":116,"log_type":1,"src_id":160503036,"trial_step":36},{"step":35,"content":"伊芙握住了莉莉的手，轻轻拍了拍。就像局长安抚她时做的那样。","style":3,"background":116,"log_type":1,"src_id":160503037,"trial_step":37},{"step":36,"speaker":"伊芙","content":"没事的，诊所的哥哥姐姐们那么厉害，一定能解决好这些问题的，你不用担心。","voice":["vo_trial_60503_1_38"],"voice_bank":"vo_eve_trial","style":1,"background":116,"log_type":1,"src_id":160503038,"trial_step":38},{"step":37,"speaker":"伊芙","content":"护理姐姐很忙，我来陪你玩吧。","voice":["vo_trial_60503_1_39"],"voice_bank":"vo_eve_trial","style":1,"background":116,"log_type":1,"src_id":160503039,"trial_step":39},{"step":38,"speaker":"伊芙","content":"给你讲个故事，好不好？","voice":["vo_trial_60503_1_40"],"voice_bank":"vo_eve_trial","style":1,"background":116,"log_type":1,"src_id":160503040,"trial_step":40},{"step":39,"speaker":"莉莉","content":"是那些玩具家人的故事吗？莉莉已经听过了。","voice":["vo_trial_60503_1_41"],"voice_bank":"vo_eve_trial","style":1,"background":116,"log_type":1,"src_id":160503041,"trial_step":41},{"step":40,"speaker":"伊芙","content":"那就讲一个没听过的，关于灰色布娃娃的故事。不过我也是第一次讲，还不是很熟悉呢。","voice":["vo_trial_60503_1_42"],"voice_bank":"vo_eve_trial","style":1,"background":116,"log_type":1,"src_id":160503042,"trial_step":42},{"step":41,"speaker":"伊芙","content":"传说，有一个灰色布娃娃，他勇敢，坚强，善良，像每个故事里的主角一样。","female_content":"传说，有一个灰色布娃娃，她勇敢，坚强，善良，像每个故事里的主角一样。","voice":["vo_trial_60503_1_43"],"voice_bank":"vo_eve_trial","style":1,"background":116,"log_type":1,"src_id":160503043,"trial_step":43},{"step":42,"speaker":"伊芙","content":"那个布娃娃总爱说些大道理，很多人不理解他，连他自己有时候也会对自己的选择产生怀疑。","female_content":"那个布娃娃总爱说些大道理，很多人不理解她，连她自己有时候也会对自己的选择产生怀疑。","voice":["vo_trial_60503_1_44"],"voice_bank":"vo_eve_trial","style":1,"background":116,"log_type":1,"src_id":160503044,"trial_step":44},{"step":43,"speaker":"伊芙","content":"但是在白色小熊的眼里，描绘美好明天的布娃娃，却好像闪着金光……","voice":["vo_trial_60503_1_45"],"voice_bank":"vo_eve_trial","style":1,"background":116,"log_type":1,"src_id":160503045,"trial_step":45},{"step":44,"content":"膝前传来均匀的呼吸，莉莉不知什么时候就已经枕在伊芙身边睡着了。","style":3,"background":116,"log_type":1,"src_id":160503046,"trial_step":46},{"step":45,"content":"今天弗朗西斯离开了，听说是被狂厄武器的碎片误伤的。\n他留给卢娜的画像，明明马上就要完成了。\n我见到那幅画的样子了，歪歪扭扭的，像小学生的涂鸦。\n但是上面的卢娜笑得那么开心，就好像真的还在给大家讲笑话一样。","voice":["vo_trial_60503_1_48"],"voice_bank":"vo_eve_trial","style":13,"background":104,"log_type":1,"src_id":160503048,"trial_step":48},{"step":46,"content":"莉莉已经康复了，她的家人要来接她离开，他们要去更安全的地方躲一躲。\n局长，你说我有“明天”，有改变谎言、让理想和希望践行的选择。\n我选好了，我想去找你所说的“理想”，去看看前面的景色。","voice":["vo_trial_60503_1_49"],"voice_bank":"vo_eve_trial","style":13,"background":104,"log_type":1,"src_id":160503049,"trial_step":49},{"step":47,"content":"你什么时候，会来接我呢？","voice":["vo_trial_60503_1_50"],"voice_bank":"vo_eve_trial","style":13,"background":104,"log_type":1,"src_id":160503050,"trial_step":50},{"step":48,"content":"伊芙合上了笔记，看着大家为弗朗西斯送上最后一程。","style":3,"background":104,"log_type":1,"src_id":160503051,"trial_step":51},{"step":49,"content":"小护士有些虚脱地靠在伊芙边上，她已经好几天没能好好睡一觉了。","style":3,"background":104,"log_type":1,"src_id":160503052,"trial_step":52},{"step":50,"speaker":"伊芙","content":"他以后就有用不完的画笔了，彩虹是他的调色盘。","voice":["vo_trial_60503_1_53"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160503053,"trial_step":53},{"step":51,"speaker":"小护士","content":"噗……伊芙什么时候也开始说这种话了？","voice":["vo_trial_60503_1_54"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160503054,"trial_step":54},{"step":52,"content":"伊芙没有回答，她摘下手套给小护士擦了擦眼泪。","style":3,"background":104,"log_type":1,"src_id":160503055,"trial_step":55},{"step":53,"speaker":"伊芙","content":"昨天晚上，义肢连接的地方有些痛，是快要好起来了吗？","voice":["vo_trial_60503_1_56"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160503056,"trial_step":56},{"step":54,"speaker":"小护士","content":"真的吗？！你有感觉了！","voice":["vo_trial_60503_1_57"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160503057,"trial_step":57},{"step":55,"speaker":"小护士","content":"我这就给你找医师看看！","voice":["vo_trial_60503_1_58"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160503058,"trial_step":58},{"step":56,"content":"小护士噌的一下从地上跳起来，嘟嘟囔囔地跑开了。","style":3,"background":104,"log_type":1,"src_id":160503059,"trial_step":59},{"step":57,"speaker":"小护士","content":"太好了，伊芙的腿要好起来了……","voice":["vo_trial_60503_1_60"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160503060,"trial_step":60},{"step":58,"speaker":"伊芙","content":"嗯，都会好起来的。","voice":["vo_trial_60503_1_61"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160503061,"trial_step":61},{"step":59,"speaker":"伊芙","content":"谎言，会一个个成真……","voice":["vo_trial_60503_1_62"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160503062,"trial_step":62},{"step":60,"content":"伊芙坐着轮椅来到诊所的门口，好不容易修缮的诊所现在又破破烂烂的了，但没有人有心思再修缮了。","style":3,"background":104,"log_type":1,"src_id":160503063,"trial_step":63},{"step":61,"content":"空荡荡的马路，灰色的世界，偶尔飘落几片夹着火星的飞絮。","style":3,"background":100,"log_type":1,"src_id":160503064,"trial_step":64},{"step":62,"speaker":"伊芙","content":"街上的人越来越少了，辛迪加似乎发生了什么大事，大家都往那边去了吧。","voice":["vo_trial_60503_1_65"],"voice_bank":"vo_eve_trial","style":1,"background":100,"log_type":1,"src_id":160503065,"trial_step":65},{"step":63,"speaker":"伊芙","content":"局长也在那边吗？在为了你的理想，为了所有人的明天……","voice":["vo_trial_60503_1_66"],"voice_bank":"vo_eve_trial","style":1,"background":100,"log_type":1,"src_id":160503066,"trial_step":66},{"step":64,"content":"一张材质粗糙的纸飘落诊所门口，上面似乎印着一些鲜红的文字。","style":3,"background":100,"log_type":1,"src_id":160503067,"trial_step":67},{"step":65,"content":"仅仅一瞬间，伊芙就在那张纸上瞥见了那个眼熟的名字。","style":3,"background":100,"log_type":1,"src_id":160503068,"trial_step":68},{"step":66,"content":"伊芙确认了来往没有FAC的机甲车后，小心地来到了路边。","style":3,"background":100,"log_type":1,"src_id":160503069,"trial_step":69},{"step":67,"content":"她弯下身想要捡起那张纸，但手刚触到地面，就已经看清了纸上的字——","style":3,"background":100,"log_type":1,"src_id":160503070,"trial_step":70},{"step":68,"content":"<color=#dg1f1f>讣告</color>\n<color=#dg1f1f>致我们的朋友，同伴，和领袖，${PlayerName}。</color>","style":13,"background":100,"log_type":1,"src_id":160503071,"trial_step":71}]}