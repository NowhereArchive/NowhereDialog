{"id":404320802,"chapter_id":50088,"scene_id":58866,"steps":[{"step":1,"content":"你装作受伤地倒了下去，却没料到海伦娜结结实实地在你身上绊了过去。","style":3,"background":2174,"log_type":1},{"step":2,"speaker":"海伦娜","content":"呀啊——！","voice":["vo_event_404320802_01"],"voice_bank":"vo_event_43208","style":1,"background":2174,"log_type":1},{"step":3,"content":"尖锐的高跟鞋在你身上碾过，你清楚地听见肋骨发出悲鸣。","style":3,"background":2174,"log_type":1},{"step":4,"content":"——大概是内出血了。","style":3,"background":2174,"log_type":1},{"step":5,"speaker":"海伦娜","content":"${PlayerName}！${PlayerName}你怎么样！","voice":["vo_event_404320802_04"],"voice_bank":"vo_event_43208","style":1,"background":2174,"log_type":1},{"step":6,"content":"她吓得赶紧蹲下来看你的伤势，你艰难地喘息。","style":3,"background":2174,"log_type":1},{"step":7,"content":"但就在这时——","style":3,"background":2174,"log_type":1},{"step":8,"content":"（红光+枪声）","style":18,"background":2174,"log_type":1},{"step":9,"content":"海伦娜一声不响地倒了下去。","style":3,"background":2174,"log_type":1},{"step":10,"content":"你捂住胸前的伤，视线被浓烟与火光遮蔽。","style":3,"background":2174,"log_type":1},{"step":11,"content":"似乎看到火海中有个漆黑的人影，向你举起了枪。","style":3,"background":2174,"log_type":1},{"step":12,"speaker":"嘶哑的声音","content":"狄斯——万岁！","voice":["vo_event_404320802_11"],"voice_bank":"vo_event_43208","style":1,"background":2174,"log_type":1},{"step":13,"content":"（黑屏）","style":18,"background":10000,"log_type":1},{"step":14,"content":"（红光+枪声）","style":18,"background":10000,"log_type":1}]}