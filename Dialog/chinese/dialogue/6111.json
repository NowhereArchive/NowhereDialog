{"id":6111,"chapter_id":6,"scene_id":614,"steps":[{"step":1,"content":"这就是污染的核心，环的主人。","style":3,"background":508,"log_type":1},{"step":2,"speaker":"受骸者","content":"……呼。","voice":["vo_cgplot_6111002"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":3,"speaker":"海拉","content":"那就是……卓娅？","voice":["vo_cgplot_6111003"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":4,"speaker":"海拉","content":"看起来完全不像。","voice":["vo_cgplot_6111004"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":5,"speaker":"赫卡蒂","content":"这个怪物吞噬了两个禁闭者，厄尔希也在里面。","voice":["vo_cgplot_6111005"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":6,"speaker":"赫卡蒂","content":"他大概远比我们遇到的任何敌人都要强大。要小心。","voice":["vo_cgplot_6111006"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":7,"content":"你能感受到一个熟悉的邪恶气息，听到它令人作呕的心跳——它跟遗产很像，但还没彻底活跃。","style":3,"background":508,"log_type":1},{"step":8,"content":"他身上有着不少新鲜的伤，也许这给你们争取了时间，可制造伤痕的人，并不在这里。","style":3,"background":508,"log_type":1},{"step":9,"speaker":"赫卡蒂","content":"它需要时间恢复身上的伤。那个司机的“朋友”很可能也是强大的禁闭者，而且拥有我们不知道的力量……","voice":["vo_cgplot_6111009"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":10,"speaker":"赫卡蒂","content":"如果我们早一点到达，合力战斗的话……","voice":["vo_cgplot_6111010"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":11,"speaker":"海拉","content":"别那么多如果了，那人八成已经死了，再不动手，等着怪物醒来，我们也得搭上小命！","voice":["vo_cgplot_6111011"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":12,"content":"她将水管甩了出去，砸向受骸者——却被某种结界一般的东西弹开了。","style":3,"background":508,"log_type":1},{"step":13,"speaker":"海拉","content":"我*？！","voice":["vo_cgplot_6111013"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":14,"speaker":"赫卡蒂","content":"是结界！难道在黑环的覆盖下，所有对受骸者的攻击都会被拒绝吗？","voice":["vo_cgplot_6111014"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":15,"speaker":"赫卡蒂","content":"再这么拖下去的话——","voice":["vo_cgplot_6111015"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":16,"speaker":"海拉","content":"是那些怪物！我该不会闹醒它了吧?","voice":["vo_cgplot_6111016"],"voice_bank":"vo_cgplot_06","style":1,"background":508,"log_type":1},{"step":18,"content":"受骸者身边涌出了一个又一个……是一大群狂暴的死役。它们的战意显然远胜于之前的任意一场战斗。","style":3,"background":508,"log_type":1}]}