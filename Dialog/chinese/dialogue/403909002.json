{"id":403909002,"chapter_id":21000106,"scene_id":606,"steps":[{"step":1,"content":"【场景、深渊】（黑景即可）","style":18,"background":10000,"log_type":1},{"step":2,"content":"你在下坠。","style":3,"background":10000,"log_type":1},{"step":3,"content":"肉体仿佛已经融化，你的思维毫无阻碍地融入了漆黑的深渊。","style":3,"background":10000,"log_type":1},{"step":4,"content":"不可思议的舒心感让你更加恐惧。","style":3,"background":10000,"log_type":1},{"step":5,"content":"是你的指路，将船员们带进了深渊。他们信任你、依赖你，而你将他们送进了深渊的口中。","style":3,"background":10000,"log_type":1},{"step":6,"content":"你不想这么做的。","style":3,"background":10000,"log_type":1},{"step":7,"content":"你不想这么做的，为什么，难道自己的本质深处，真的与殒星——","style":3,"background":10000,"log_type":1},{"step":8,"content":"数不尽的红光在眼前浮现，耳畔响起了他们临终的悲鸣。","style":3,"background":10000,"log_type":1},{"step":10,"content":"红光撕开深渊的一角，透过层层污秽扭曲的水纹，你看到一轮遥远的幻月，脑海深处响起熟悉而诡异的笑声。","style":3,"background":10125,"log_type":1},{"step":11,"content":"呵呵，早听我的不好吗？我都邀请过你了，把力量借给你了，明明成为我就能吃掉它，可你呀……总是那么顽固，狂妄，自以为是，却在关键问题上摇摆不定……","voice":["vo_event_403909002_02"],"voice_bank":"vo_event_39092","style":1,"background":10125,"log_type":1},{"step":12,"content":"就是因为这样，你才连那种半死的废物都赢不了……一败涂地……","voice":["vo_event_403909002_03"],"voice_bank":"vo_event_39092","style":1,"background":10125,"log_type":1},{"step":13,"speaker":"选项","options":["我还没——"],"jump":[14],"style":6,"background":10125,"log_type":1},{"step":14,"content":"枷锁断裂，身下的漩涡猛地将你裹挟吸入，深渊污秽快速没过你的视野，堵塞远光，随着“它”的笑声远去，那幻月也消失在你的视野。","style":3,"background":10125,"log_type":1},{"step":15,"content":"你伸手向前，用自己的力量拼死挣扎，于是混沌中也凝聚出几个纠缠的人影。","style":3,"background":4386,"log_type":1},{"step":16,"content":"【魔化内海组立绘的黑渐变】","style":18,"background":4386,"log_type":1},{"step":17,"content":"她们看起来是那么熟悉，让人安心，她们向你伸手——","style":3,"background":4386,"log_type":1},{"step":18,"speaker":"选项","options":["握住她们的手"],"jump":[19],"style":6,"background":4386,"log_type":1},{"step":19,"content":"好多只手猛地抓住你，顺着你的手臂一路拉扯爬上来，舔舐你撕咬你，迫切渴望与你融为一体。","style":3,"background":4386,"log_type":1},{"step":20,"speaker":"“同伴”","content":"不想死……向导！带我们回去！！！","voice":["vo_event_403909002_11"],"voice_bank":"vo_event_39092","style":1,"background":4386,"log_type":1},{"step":21,"speaker":"${PlayerName}","content":"——！！","style":2,"background":4386,"log_type":1},{"step":22,"content":"你惊叫却失声，被恐惧吞没，试图逃亡。而在你逃亡的方向，一个女人张开双臂迎接你，紧紧抱住你。","style":3,"background":4386,"log_type":1},{"step":23,"speaker":"选项","options":["你是——？"],"jump":[24],"style":6,"background":4386,"log_type":1},{"step":24,"content":"她拥抱你，挡住所有攻击，不断安抚你的恐惧，柔声劝慰着，听上去欣喜若狂。","style":3,"background":4386,"log_type":1},{"step":25,"speaker":"？？","content":"不要紧的，不要害怕，你本来就比所有人都接近深渊。不用恐惧未知，不用害怕牺牲。","voice":["vo_event_403909002_16"],"voice_bank":"vo_event_39092","style":1,"background":4386,"log_type":1},{"step":26,"speaker":"？？","content":"这便是命运的指引，你我注定会再次相遇。这便是祂给予我的……最好的馈赠。走吧，向导，我们一起——","voice":["vo_event_403909002_17"],"voice_bank":"vo_event_39092","style":1,"background":4386,"log_type":1},{"step":27,"speaker":"？？","content":"唯有你，知晓回归它的路。","voice":["vo_event_403909002_18"],"voice_bank":"vo_event_39092","style":1,"background":4386,"log_type":1},{"step":28,"speaker":"？？","content":"你就是它本身——","voice":["vo_event_403909002_19"],"voice_bank":"vo_event_39092","style":1,"background":4386,"log_type":1},{"step":29,"speaker":"选项","options":["不是！！"],"jump":[30],"style":6,"background":4386,"log_type":1},{"step":30,"content":"提一个真正的耳坠吊饰的特效，之前的都太差了。拿个耳坠的图片或者小模型弄一下都可以，认真弄一个","style":18,"background":4386,"log_type":1},{"step":31,"content":"【音效：钢琴的一个音，看看有么有什么典故音，拉长——】","style":18,"background":4386,"log_type":1},{"step":32,"speaker":"${PlayerName}","content":"！","style":2,"background":4386,"log_type":1},{"step":33,"content":"【闪白】全黑屏，2秒，注意一下音效，补一个无音乐的空旷环境氛围音","style":18,"background":10000,"log_type":1},{"step":34,"content":"你被吞没了。","style":3,"background":10000,"log_type":1},{"step":35,"content":"又或是，掉进了某个裂隙。","style":3,"background":10000,"log_type":1},{"step":36,"content":"周围没有光，没有声音，也没有任何人。你触不到地面、墙壁，或是天顶，悬浮着，就像浮于真空，或是深海，或是——","style":3,"background":10000,"log_type":1},{"step":37,"content":"【微弱的钢琴音，缓慢，遥远，提音效】","style":18,"background":10000,"log_type":1},{"step":38,"speaker":"选项","options":["……钢琴？"],"jump":[39],"style":6,"background":10000,"log_type":1},{"step":39,"content":"那琴声悠久而遥远，仿佛故人的叹息，你懵懵懂懂地支起身体，循着琴声的方向向前——","style":3,"background":10000,"log_type":1},{"step":40,"content":"【泛白至全白屏1秒后退出】","style":18,"background":10006,"log_type":1}]}