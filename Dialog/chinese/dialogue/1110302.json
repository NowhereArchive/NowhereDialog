006,"log_type":1,"src_id":210302221,"trial_step":221},{"step":247,"content":"感觉全身突然充满力量的卡瓦卡瓦，对着城寨的方向伸出右手。","style":3,"background":2006,"log_type":1,"src_id":210302221,"trial_step":221},{"step":248,"content":"就像一口气打开黑暗房间内的所有照明设备一样。","style":3,"background":2006,"log_type":1,"src_id":210302221,"trial_step":221},{"step":249,"speaker":"卡瓦卡瓦","content":"啊……啊啊啊啊啊——","style":1,"background":2006,"log_type":1,"src_id":210302221,"trial_step":221},{"step":250,"content":"下一秒，城寨的木墙上到处都闪烁起湛蓝色的光亮。几乎所有砂盗都被半球形的防御力场瞬间包裹。","style":3,"background":2006,"log_type":1,"src_id":210302222,"trial_step":222},{"step":251,"content":"他们惊慌失措地扣动扳机，但子弹却被防御力场反弹到内部四处飞溅，反而对他们自己造成了不小的伤害。","style":3,"background":2006,"log_type":1,"src_id":210302223,"trial_step":223},{"step":252,"options":["开始行动！"],"style":6,"background":2006,"log_type":1,"src_id":210302224,"trial_step":224,"course":3,"choices":[{"text":"开始行动！","goto":225}]},{"step":253,"content":"早已受够了窝囊气的队员们一跃而出，用最快速度向着城寨奔去。","style":3,"background":2006,"log_type":1,"src_id":210302225,"trial_step":225},{"step":254,"content":"而一直守在卡瓦卡瓦身边的赫卡蒂，更是早就发动梦魇，将城寨大门轰成了碎片。","style":3,"background":2006,"log_type":1,"src_id":210302226,"trial_step":226},{"step":255,"speaker":"卡瓦卡瓦","content":"成……成功了！","style":1,"background":2006,"log_type":1,"src_id":210302227,"trial_step":227},{"step":256,"content":"第一次这么大规模发动能力的少年脱力坐到了地上，他脸上由衷的喜悦是疲惫无法遮掩的。","style":3,"background":2006,"log_type":1,"src_id":210302228,"trial_step":228},{"step":257,"speaker":"赫卡蒂","content":"干得不错，有一些禁闭者的样子了。","style":1,"background":2006,"log_type":1,"src_id":210302229,"trial_step":229},{"step":258,"content":"后续的清剿作战并没有花费太多功夫。失去远程火力的优势，面对贴到近身的禁闭者，这些砂盗完全失去了抵抗的资本。","style":3,"background":2006,"log_type":1,"src_id":210302230,"trial_step":230},{"step":259,"speaker":"行动组成员2","content":"仔细检查他们每一个人的束带！随身的利器要全部收缴！受伤的也要立刻进行包扎！","style":1,"background":2006,"log_type":1,"src_id":210302231,"trial_step":231},{"step":260,"content":"“茉莉”","style":3,"background":2006,"log_type":1,"src_id":210302232,"trial_step":232},{"step":261,"speaker":"行动组成员2","content":"一小队继续收容，二小队把气垫船开进来，优先进行淡水补给作业！","style":1,"background":2006,"log_type":1,"src_id":210302233,"trial_step":233},{"step":262,"speaker":"行动组成员2","content":"局长，还有什么指示么？","style":1,"background":2006,"log_type":1,"src_id":210302234,"trial_step":234},{"step":263,"options":["暂时没有"],"style":6,"background":2006,"log_type":1,"src_id":210302235,"trial_step":235,"course":3,"choices":[{"text":"暂时没有","goto":236}]},{"step":264,"content":"大家的表现都很好。","style":2,"background":2006,"log_type":1,"src_id":210302236,"trial_step":236},{"step":265,"content":"一场酣畅淋漓的胜利让所有人都忘记了砂海的酷热。但好运好像并不总是会常伴左右。","style":3,"background":2006,"log_type":1,"src_id":210302237,"trial_step":237},{"step":266,"speaker":"卡瓦卡瓦","content":"局长！刚才信标网络发出了警告，有一个规模庞大的砂暴正迅速接近这里。","style":1,"background":2006,"log_type":1,"src_id":210302238,"trial_step":238},{"step":267,"content":"还有多少时间？","style":2,"background":2006,"log_type":1,"src_id":210302239,"trial_step":239},{"step":268,"speaker":"卡瓦卡瓦","content":"来不及了，气垫船不能出去，我们必须就地躲避。","style":1,"background":2006,"log_type":1,"src_id":210302240,"trial_step":240},{"step":269,"content":"这些天在砂海中共同的经历，尤其是刚才那场战斗，让你已经完全相信了眼前这个年轻的砂海地质学者。卡瓦卡瓦的计算肯定不会出错。","style":3,"background":2006,"log_type":1,"src_id":210302241,"trial_step":241},{"step":270,"options":["准备原地扎营"],"style":6,"background":2006,"log_type":1,"src_id":210302242,"trial_step":242,"course":3,"choices":[{"text":"准备原地扎营","goto":243}]},{"step":271,"content":"……赫卡蒂！让一小队把那些砂盗转移到地窖里去！我去通知气垫船那边，让他们直接开进城寨的车库。","style":2,"background":2006,"log_type":1,"src_id":210302243,"trial_step":243},{"step":272,"content":"好在城寨有着完整的城墙和生活设施。砂航船的补给还能再撑几天，只需安心在这里等待砂暴离去即可。","style":3,"background":2006,"log_type":1,"src_id":210302244,"trial_step":244},{"step":273,"speaker":"卡瓦卡瓦","content":"那我呢那我呢？","style":1,"background":2006,"log_type":1,"src_id":210302245,"trial_step":245},{"step":274,"content":"年轻的沙漠学者似乎正期待着你的指令。","style":3,"background":2006,"log_type":1,"src_id":210302246,"trial_step":246},{"step":275,"content":"如果大家有什么