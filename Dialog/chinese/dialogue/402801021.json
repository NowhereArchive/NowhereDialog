{"id":402801021,"chapter_id":30001,"scene_id":30016,"steps":[{"step":1,"content":"<size=55>激斗！\n\n看板位争夺战！</size>","style":14,"background":2288,"is_centered":true,"log_type":1},{"step":3,"content":"激烈的战斗破坏了地面，击碎了砂石。","style":3,"background":2282,"log_type":1},{"step":4,"content":"在废墟的中心，一团黑影在喃喃低语着。","style":3,"background":2282,"log_type":1},{"step":5,"speaker":"？？","content":"我，即是#@**！","style":1,"background":2282,"log_type":1},{"step":6,"speaker":"海拉","content":"那是……紫色的衣服……还有军团的标志……","style":1,"background":2282,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"战斗力估算中……50，500，5000……无法计算。","style":1,"background":2282,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"是军团长卓娅的投影。","style":1,"background":2282,"log_type":1},{"step":9,"speaker":"海拉","content":"不是，这根本完全不像啊！不管是立绘上还是人设上来说完全就不是一个人！","style":1,"background":2282,"log_type":1},{"step":10,"speaker":"赫卡蒂","content":"没错，这只是代号dark模拟的禁闭者，虽然会出现人设崩坏的情况，但他们的力量却也是货真价实的。","style":1,"background":2282,"log_type":1},{"step":11,"speaker":"赫卡蒂","content":"但……去吧海拉，我会帮你的。","style":1,"background":2282,"log_type":1},{"step":12,"speaker":"海拉","content":"……真的假的？我打卓娅老大？","style":1,"background":2282,"log_type":1},{"step":13,"content":"在赫卡蒂的声援之下，海拉一步一步靠近颓坐在地上的卓娅，想要触碰她，解开她的束缚。","style":3,"background":2282,"log_type":1},{"step":14,"speaker":"卓娅","content":"休想……","style":1,"background":2282,"log_type":1},{"step":15,"speaker":"海拉","content":"啊卓娅老大你冷静一点，我们只是想救你！","style":1,"background":2282,"log_type":1},{"step":16,"speaker":"卓娅","content":"想碰我的位置？哼，打赢我再说吧！","style":1,"background":2282,"log_type":1},{"step":17,"speaker":"卓娅","content":"我即是……APP图标！","style":1,"background":2282,"log_type":1},{"step":18,"speaker":"海拉","content":"……你不是军团吗！这肯定不是卓娅老大！","style":1,"background":2282,"log_type":1},{"step":19,"speaker":"赫卡蒂","content":"这里的吐槽满分，海拉。","style":1,"background":2282,"log_type":1}]}