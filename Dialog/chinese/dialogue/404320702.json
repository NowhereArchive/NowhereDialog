{"id":404320702,"chapter_id":50088,"scene_id":58865,"steps":[{"step":1,"content":"你抓着海伦娜的手，与她一同随着守卫向庄园的另一端撤离。","style":3,"background":2503,"log_type":1},{"step":2,"speaker":"海伦娜","content":"我、我们这是要去哪儿！","voice":["vo_event_404320702_01"],"voice_bank":"vo_event_43207","style":1,"background":2503,"log_type":1},{"step":3,"speaker":"守卫","content":"别说话了，快点跟上！","voice":["vo_event_404320702_02"],"voice_bank":"vo_event_43207","style":1,"background":2503,"log_type":1},{"step":4,"content":"震动还在持续，很快，整个走廊都变得浓烟滚滚。","style":3,"background":2503,"log_type":1},{"step":5,"content":"爆炸并未停止，看来主楼这里也被设置了炸药。","style":3,"background":2503,"log_type":1},{"step":6,"content":"你感觉到海伦娜的手在剧烈颤抖，她的指甲几乎嵌入你的掌心。","style":3,"background":2503,"log_type":1},{"step":7,"content":"她的高跟鞋实在跑不快，你们逐渐掉了队，跌跌撞撞地穿过昏暗的走廊，耳边充斥着砖石崩裂的声响。","style":3,"background":2174,"log_type":1},{"step":8,"content":"时候差不多了，现在正是可以趁乱从海伦娜身上拿走那封致命信件的时候。","style":3,"background":2174,"log_type":1},{"step":9,"options":["绊倒海伦娜","装作受伤"],"style":34,"background":2174,"log_type":1}]}