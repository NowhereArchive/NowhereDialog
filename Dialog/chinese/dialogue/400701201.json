{"id":400701201,"chapter_id":50019,"scene_id":51903,"steps":[{"step":2,"content":"钟声飘荡在街道上空，你走过下个巷口。","style":3,"background":2079,"log_type":1},{"step":3,"content":"铛——铛——钟声持续，你路过几个居民，心里默数着数字。","style":3,"background":2079,"log_type":1},{"step":4,"content":"一、二、三……九、十、十一……","style":3,"background":2079,"log_type":1},{"step":5,"content":"十二、十三……？","style":3,"background":2079,"log_type":1},{"step":6,"content":"钟声在这个诡异的次数上戛然而止。同时，不远处传来一声极度恐惧的惨叫。","style":3,"background":2079,"log_type":1},{"step":7,"speaker":"居民","content":"啊——？！！","voice":["vo_event_400701201_07"],"voice_bank":"vo_event_07012","style":1,"background":2079,"log_type":1},{"step":8,"content":"一阵潮冷的空气与你擦肩而过，它来自你的身后，小巷的尾处。","style":3,"background":2079,"log_type":1},{"step":9,"speaker":"居民","content":"那、那是什么东西……？","voice":["vo_event_400701201_09"],"voice_bank":"vo_event_07012","style":1,"background":2079,"log_type":1},{"step":10,"content":"一片不祥的灰雾逐渐蔓延，而在那怪诞的雾气之中，缓缓蠕动着某些更为怪异的丝状物。","style":3,"background":2079,"log_type":1},{"step":11,"content":"它们逐渐纠缠、盘绕，最后竟逐个直立起身，变成一个个诡异的怪物！","style":3,"background":2079,"log_type":1},{"step":12,"speaker":"？？","content":"吼……吼………………！！","style":1,"background":2079,"log_type":1},{"step":13,"content":"它们伸出“手”，瞬间将惨叫的居民拖入雾中。下一秒，浓雾吞噬天空，夜色覆盖了整条街道。","style":3,"background":2079,"log_type":1},{"step":14,"options":["跑！"],"jump":[15],"style":6,"background":2079,"log_type":1},{"step":15,"content":"浓雾和惊恐已在不知不觉间笼罩一切，只有远处还剩几点光源。","style":3,"background":10000,"log_type":1},{"step":16,"speaker":"居民","content":"呀——？！","voice":["vo_event_400701201_16"],"voice_bank":"vo_event_07012","style":1,"background":10000,"log_type":1},{"step":17,"content":"有人跌倒了，怪物不会放过这个机会。","style":3,"background":10000,"log_type":1},{"step":18,"speaker":"居民","content":"疯剪子？！不要、不要过来！！","voice":["vo_event_400701201_18"],"voice_bank":"vo_event_07012","style":1,"background":10000,"log_type":1},{"step":19,"options":["帮忙","继续跑"],"jump":[20,23],"style":6,"background":10000,"log_type":1},{"step":21,"content":"但显然和你角力的怪物更加强大。下一秒，女孩被拖入雾中，只在你的视网膜中印下一张慌乱的脸。","style":3,"background":10000,"log_type":1},{"step":23,"content":"下一秒，女孩被拖入雾中，只在你的视网膜中印下一张慌乱的脸。","style":3,"background":10000,"log_type":1},{"step":24,"content":"在女孩被拖走的一瞬间，你看到了缠绕在她身上的东西：柔韧的深色长线，带着诡异的生命力。","style":3,"background":10000,"log_type":1},{"step":25,"options":["那是？！"],"jump":[26],"style":6,"background":10000,"log_type":1},{"step":26,"content":"——那是人类发丝独有的光泽。","style":3,"background":10000,"log_type":1}]}