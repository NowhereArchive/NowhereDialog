{"id":8052,"chapter_id":8,"scene_id":805,"steps":[{"step":1,"speaker":"海拉","content":"吓死我了，你干嘛伸手乱摸东西，一摸就睡，还怎么叫都叫不起来。","voice":["vo_cgplot_8052001"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":2,"speaker":"海拉","content":"知不知道自己睡了多久啊？！","voice":["vo_cgplot_8052002"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":3,"speaker":"赫卡蒂","content":"是幻境吗？","voice":["vo_cgplot_8052003"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":4,"speaker":"选项","options":["对，我抓住“她”了"],"jump":[5],"style":6,"background":710,"log_type":1},{"step":5,"content":"被你抓住的人跪在地上，赤色的荆棘刺穿了她黑色的裙摆，禁锢她的舞步。你不能对这个崩坏之物施以枷锁，却能用枷锁限制她的行动。","style":3,"background":710,"log_type":1},{"step":6,"speaker":"“哈梅尔”","content":"好疼……好烫……放我出去，放开我……","voice":["vo_cgplot_8052006"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":7,"speaker":"选项","options":["在消灭你之前，我有话要问你"],"jump":[8],"style":6,"background":710,"log_type":1},{"step":8,"speaker":"“哈梅尔”","content":"不要……","voice":["vo_cgplot_8052008"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":9,"speaker":"“哈梅尔”","content":"我是哈梅尔，为什么要欺负哈梅尔……","voice":["vo_cgplot_8052009"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":10,"content":"她开始抽泣，声音竟越来越小，像是要退回到婴儿的年纪。","style":3,"background":710,"log_type":1},{"step":11,"speaker":"“哈梅尔”","content":"骗子……骗子……说好要保护我，说好所有人都喜欢我，为什么……","voice":["vo_cgplot_8052011"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":12,"speaker":"“哈梅尔”","content":"……","voice":["vo_cgplot_8052012"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":13,"speaker":"赫卡蒂","content":"局长，退后！","voice":["vo_cgplot_8052013"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":14,"content":"漆黑的火焰再次席卷而来，击碎了围困她的枷锁，这力量却并不是她放出的。","style":3,"background":710,"log_type":1},{"step":15,"content":"一个高瘦的人影掠过，挥舞手中撑开的黑伞将你们击退，他抱起哭泣的少女走向一旁。","style":3,"background":50801,"log_type":1},{"step":16,"speaker":"海拉","content":"是谁？！","voice":["vo_cgplot_8052016"],"voice_bank":"vo_cgplot_08","style":1,"background":50801,"log_type":1},{"step":17,"content":"男人没有回应，他为“哈梅尔”撑着伞，温柔地安抚她虚幻的身影。","style":3,"background":50801,"log_type":1},{"step":18,"speaker":"撑伞的男人","content":"没事了，没事了……我来保护你，我来爱你……","voice":["vo_cgplot_8052018"],"voice_bank":"vo_cgplot_08","style":1,"background":50801,"log_type":1}]}