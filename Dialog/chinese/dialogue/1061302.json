{"id":1061302,"chapter_id":1061302,"scene_id":1,"steps":[{"step":1,"content":"//黑屏","style":18,"background":10000,"log_type":1,"src_id":161302001,"trial_step":1},{"step":2,"speaker":"？？？","content":"救……救命……","voice":["vo_trial_61301_2_1"],"voice_bank":"vo_jichuan_trial","style":1,"background":10000,"log_type":1,"src_id":161302002,"trial_step":2},{"step":3,"speaker":"？？？","content":"救救我……","voice":["vo_trial_61301_2_2"],"voice_bank":"vo_jichuan_trial","style":1,"background":10000,"log_type":1,"src_id":161302003,"trial_step":3},{"step":4,"content":"//BG：古风室内","style":18,"background":2570,"log_type":1,"src_id":161302004,"trial_step":4},{"step":5,"speaker":"霁川","content":"……！！！","voice":["vo_trial_61301_2_3"],"voice_bank":"vo_jichuan_trial","style":1,"background":2570,"log_type":1,"src_id":161302005,"trial_step":5},{"step":6,"content":"一夜风雪未歇，狂风裹挟着鹅毛大雪猛烈拍打着窗棂，屋外天地间一片苍茫，春日里刚发的新绿全被掩埋。","style":3,"background":2570,"log_type":1,"src_id":161302006,"trial_step":6},{"step":7,"content":"炉火噼啪作响，却驱散不尽周身寒意。霁川裹着披风，望着窗外眉头紧锁。","style":3,"background":2570,"log_type":1,"src_id":161302007,"trial_step":7},{"step":8,"speaker":"？？？","content":"救救我……","voice":["vo_trial_61301_2_4"],"voice_bank":"vo_jichuan_trial","style":1,"background":2570,"log_type":1,"src_id":161302008,"trial_step":8},{"step":9,"content":"她耳边反复回响着断断续续的呼救声，那声音微弱得像风中残烛，却又清晰地穿透风雪，缠绕在她心头。她披上了外套。","style":3,"background":2570,"log_type":1,"src_id":161302010,"trial_step":10},{"step":10,"speaker":"霁川母亲","content":"川儿，你要去哪儿？","voice":["vo_trial_61301_2_5"],"voice_bank":"vo_jichuan_trial","style":1,"background":2570,"log_type":1,"src_id":161302011,"trial_step":11},{"step":11,"speaker":"霁川","content":"我听到有人在求救，或许是遇到了什么麻烦，我想去看看。","voice":["vo_trial_61301_2_6"],"voice_bank":"vo_jichuan_trial","style":1,"background":2570,"log_type":1,"src_id":161302012,"trial_step":12},{"step":12,"speaker":"霁川父亲","content":"我们这院子方圆几里都没有人家。你是不是听错了，兴许是风声。","voice":["vo_trial_61301_2_7"],"voice_bank":"vo_jichuan_trial","style":1,"background":2570,"log_type":1,"src_id":161302013,"trial_step":13},{"step":13,"speaker":"霁川","content":"不是风声，我听得很清楚，是人的声音，很虚弱。","voice":["vo_trial_61301_2_8"],"voice_bank":"vo_jichuan_trial","style":1,"background":2570,"log_type":1,"src_id":161302014,"trial_step":14},{"step":14,"speaker":"泥娃子","content":"……阿川，要不等雪小一点再去吧。这天气太奇怪了，我总觉得心里发毛。","voice":["vo_trial_61301_2_9"],"voice_bank":"vo_jichuan_trial","style":1,"background":2570,"log_type":1,"src_id":161302015,"trial_step":15},{"step":15,"speaker":"霁川","content":"就是因为这天气反常……我总预感，有什么不好的事情要发生。","voice":["vo_trial_61301_2_10"],"voice_bank":"vo_jichuan_trial","style":1,"background":2570,"log_type":1,"src_id":161302016,"trial_step":16},{"step":16,"content":"见霁川如此坚持，众人知道劝不住她。","style":3,"background":2570,"log_type":1,"src_id":161302017,"trial_step":17},{"step":17,"speaker":"霁川父亲","content":"那穿厚点，爹煮着姜汤等你回来。","voice":["vo_trial_61301_2_11"],"voice_bank":"vo_jichuan_trial","style":1,"background":2570,"log_type":1,"src_id":161302018,"trial_step":18},{"step":18,"speaker":"霁川","content":"……好！","voice":["vo_trial_61301_2_12"],"voice_bank":"vo_jichuan_trial","style":1,"background":2570,"log_type":1,"src_id":161302019,"trial_step":19},{"step":19,"content":"她推开屋门，一股寒风夹杂着雪沫子瞬间灌了进来，让她忍不住打了个寒颤。","style":3,"background":10006,"log_type":1,"src_id":161302020,"trial_step":20},{"step":20,"content":"她往前走了几步，忍不住回头看了一眼。","style":3,"background":10006,"log_type":1,"src_id":161302021,"trial_step":21},{"step":21,"content":"父亲母亲和泥娃子站在窗边关切地望着她，屋内烛火通明，霁川知道那是为她而亮的。","style":3,"background":10006,"log_type":1,"src_id":161302022,"trial_step":22},{"step":22,"speaker":"？？？","content":"……救命……救救我们……","voice":["vo_trial_61301_2_13"],"voice_bank":"vo_jichuan_trial","style":1,"background":10006,"log_type":1,"src_id":161302023,"trial_step":23},{"step":23,"content":"远方再次响起求救声，霁川不再回头，坚定地朝着声音传来的方向走去。","style":3,"background":10006,"log_type":1,"src_id":161302024,"trial_step":24},{"step":24,"content":"//黑屏","style":18,"background":10006,"log_type":1,"src_id":161302025,"trial_step":25},{"step":25,"content":"没了病痛的阻遏，霁川在风雪中快步穿梭，身手矫健。","style":3,"background":10006,"log_type":1,"src_id":161302026,"trial_step":26},{"step":26,"content":"风雪迷眼，好在耳边的呼救声从未停歇，且愈发清晰。","style":3,"background":10006,"log_type":1,"src_id":161302027,"trial_step":27},{"step":27,"content":"呼——","style":3,"background":10006,"log_type":1,"src_id":161302028,"trial_step":28},{"step":28,"content":"又一阵如刀般的狂风，霁川险些摔倒。","style":3,"background":10006,"log_type":1,"src_id":161302029,"trial_step":29},{"step":29,"content":"她几乎有一半的腿都陷在雪地里，刺骨的寒意凿进她的骨缝，领口灌入雪水，冻得她牙关颤颤。","style":3,"background":10006,"log_type":1,"src_id":161302030,"trial_step":30},{"step":30,"speaker":"霁川","content":"沿路的枝干全都吐了芽，明明都是盛春时节了，这倒春寒来得太蹊跷……","voice":["vo_trial_61301_2_14"],"voice_bank":"vo_jichuan_trial","style":1,"background":10006,"log_type":1,"src_id":161302031,"trial_step":31},{"step":31,"content":"未等霁川细想，呼救声打断了她的思绪。","style":3,"background":10006,"log_type":1,"src_id":161302032,"trial_step":32},{"step":32,"speaker":"？？？","content":"救命……救救我们……","voice":["vo_trial_61301_2_15"],"voice_bank":"vo_jichuan_trial","style":1,"background":10006,"log_type":1,"src_id":161302033,"trial_step":33},{"step":33,"content":"那声音近在咫尺，霁川猛地抬头。这才发现自己竟已行至山下村庄附近，眼前是一所低矮的木棚屋，屋顶的积雪几乎要将屋子压塌了。","style":3,"background":2576,"log_type":1,"src_id":161302034,"trial_step":34},{"step":34,"content":"屋子里不断传来呼救声，霁川连忙上前。","style":3,"background":2576,"log_type":1,"src_id":161302035,"trial_step":35},{"step":35,"content":"靠近一看，棚屋的门窗已然被及腰的积雪封死。","style":3,"background":2576,"log_type":1,"src_id":161302036,"trial_step":36},{"step":36,"speaker":"？？？","content":"江姑娘！救命啊！这雪快要把我们埋了……","voice":["vo_trial_61301_2_16"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302037,"trial_step":37},{"step":37,"speaker":"霁川","content":"你认识我？别慌，我想办法救你们出来！","voice":["vo_trial_61301_2_17"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302038,"trial_step":38},{"step":38,"content":"霁川伸手试图拨开门口的积雪，只需要一些时间……","style":3,"background":2576,"log_type":1,"src_id":161302039,"trial_step":39},{"step":39,"content":"咔嚓！","style":3,"background":2576,"log_type":1,"src_id":161302040,"trial_step":40},{"step":40,"content":"棚屋屋顶的木板发出不堪承重的呻吟，屋内的妇人也跟着发出一声惊叫。","style":3,"background":2576,"log_type":1,"src_id":161302041,"trial_step":41},{"step":41,"speaker":"霁川","content":"没事的，还有空间——抓住它！","voice":["vo_trial_61301_2_18"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302042,"trial_step":42},{"step":42,"content":"霁川将自己随身的梅枝武器探入木板之间，成功将受困的妇人拉出了空地。","style":3,"background":2576,"log_type":1,"src_id":161302043,"trial_step":43},{"step":43,"content":"就在她们脱困的下一秒，木屋轰然坍塌。惊吓的哭声传来。","style":3,"background":2576,"log_type":1,"src_id":161302044,"trial_step":44},{"step":44,"content":"霁川这才注意到，妇人怀中还抱着一个婴儿，面色青紫，早已被冻得气息微弱。","style":3,"background":2576,"log_type":1,"src_id":161302045,"trial_step":45},{"step":45,"speaker":"霁川","content":"别怕，我带你们去安全的地方。腿脚有没有受伤，还能走吗？","voice":["vo_trial_61301_2_19"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302046,"trial_step":46},{"step":46,"speaker":"灾民","content":"能、能走……","voice":["vo_trial_61301_2_20"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302047,"trial_step":47},{"step":47,"speaker":"灾民","content":"江姑娘，再往前还有几户人家，都是些老弱，刚才还在喊救命呢，如今都没声了……","voice":["vo_trial_61301_2_21"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302048,"trial_step":48},{"step":48,"speaker":"霁川","content":"放心吧，他们交给我。","voice":["vo_trial_61301_2_22"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302049,"trial_step":49},{"step":49,"speaker":"霁川","content":"我刚刚来的路上看见一处客栈，陈设还算完善，应当能撑过这场大雪。你带着孩子去那儿避避。","voice":["vo_trial_61301_2_23"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302050,"trial_step":50},{"step":50,"content":"霁川安顿好妇人，转身往巷道深处去。","style":3,"background":2576,"log_type":1,"src_id":161302051,"trial_step":51},{"step":51,"content":"可越往前，求救声便越多。不仅仅有被困的，还有被坍塌的屋梁压住只剩一口气的，还有麻木地抱着亲人尸体不肯撒手的……","style":3,"background":2576,"log_type":1,"src_id":161302052,"trial_step":52},{"step":52,"speaker":"霁川","content":"大家别慌——房屋结构完好的，留在室内避险。房屋受损、恐有不稳的，请前往镇北客栈！踏雪而行，务必保全自身，注意脚下——","voice":["vo_trial_61301_2_24"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302053,"trial_step":53},{"step":53,"speaker":"霁川","content":"眼下御寒物资紧缺，各家若有短缺都可报上，我一定尽力筹措——","voice":["vo_trial_61301_2_25"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302054,"trial_step":54},{"step":54,"content":"霁川在摇摇欲坠的木宅间不断穿梭。即使是健康的身体也难免力竭，她却毫无停顿，从厚重的积雪下，一家接一家地拖出被困的人。","style":3,"background":2576,"log_type":1,"src_id":161302055,"trial_step":55},{"step":55,"content":"然而一人之力，于这天灾而言只是杯水车薪。","style":3,"background":2576,"log_type":1,"src_id":161302056,"trial_step":56},{"step":56,"content":"就在她四处奔走时，她听见不远处传来绝望的呼声——","style":3,"background":2576,"log_type":1,"src_id":161302057,"trial_step":57},{"step":57,"speaker":"灾民女甲","content":"孩子……我的孩子！她没气了……","voice":["vo_trial_61301_2_26"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302058,"trial_step":58},{"step":58,"content":"那是她最早救出的那名妇人。那妇人没有霁川那样轻巧的身手，带着孩子在雪地里跋涉艰难，此刻才刚刚赶到客栈门口没来得及进去躲躲。","style":3,"background":2576,"log_type":1,"src_id":161302059,"trial_step":59},{"step":59,"content":"霁川一直绷紧的神经似乎断了弦，她脚步虚浮地赶到妇人身边。好在，她能看出那孩子还留着一线生机。","style":3,"background":2576,"log_type":1,"src_id":161302060,"trial_step":60},{"step":60,"speaker":"霁川","content":"她没事，她会没事的。来……把孩子给我。","voice":["vo_trial_61301_2_27"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302061,"trial_step":61},{"step":61,"content":"霁川想将孩子接过来救治，妇人却死死护住不肯松手。","style":3,"background":2576,"log_type":1,"src_id":161302062,"trial_step":62},{"step":62,"speaker":"灾民女甲","content":"不行，不行……她冷，她冷……","voice":["vo_trial_61301_2_28"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302063,"trial_step":63},{"step":63,"content":"妇人惶然的神情让霁川心头一恸，她没再强求，而是将自己的手按上了孩子的心口，缓缓地为其注入生机。","style":3,"background":2576,"log_type":1,"src_id":161302064,"trial_step":64},{"step":64,"content":"终于，孩子的皮肤渐渐有了血色，襁褓中传来了微弱的啼哭声。","style":3,"background":2576,"log_type":1,"src_id":161302065,"trial_step":65},{"step":65,"content":"妇人抱着孩子喜极而泣，跪在地上向霁川连连磕头。霁川正要将她扶起，动作却突然一滞——","style":3,"background":2576,"log_type":1,"src_id":161302066,"trial_step":66},{"step":66,"speaker":"霁川","content":"咳——！咳咳咳！","voice":["vo_trial_61301_2_29"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302067,"trial_step":67},{"step":67,"content":"一大口淤黑的血咳出，溅在雪地上触目惊心。随即，一股熟悉的、刺穿脏腑的剧痛狠狠攥紧了她的五脏六腑。","style":3,"background":2576,"log_type":1,"src_id":161302068,"trial_step":68},{"step":68,"content":"周围的村民被这骇人景象镇住，一时无人敢动。","style":3,"background":2576,"log_type":1,"src_id":161302069,"trial_step":69},{"step":69,"content":"可最被吓到的是霁川自己……她太熟悉这样的疼痛了，这陪伴了她数年的、如影随形的“污染”，此刻正再次从内部啃噬她的生机，蚕食她的骨血与温度。","style":3,"background":2576,"log_type":1,"src_id":161302070,"trial_step":70},{"step":70,"content":"她看着自己刚刚运功结束的手，这双刚刚为一个婴孩续上生机的手，正在飞速流失它最后的热度。","style":3,"background":2576,"log_type":1,"src_id":161302071,"trial_step":71},{"step":71,"content":"见她快要栽倒，灾民中一个小娃娃眼疾手快地扶住了她。","style":3,"background":2576,"log_type":1,"src_id":161302072,"trial_step":72},{"step":72,"speaker":"灾民小孩","content":"姐姐，你的身子好冰啊，你是不是也生病了？","voice":["vo_trial_61301_2_30"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302073,"trial_step":73},{"step":73,"speaker":"霁川","content":"这……这不是病。是我无论逃往哪里，都躲不掉的倒计时。","voice":["vo_trial_61301_2_31"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302074,"trial_step":74},{"step":74,"content":"那孩子没有听懂其中的含义。霁川强撑一个微笑，擦掉嘴角的血迹，拍拍那孩子的头。","style":3,"background":2576,"log_type":1,"src_id":161302075,"trial_step":75},{"step":75,"speaker":"霁川","content":"我无妨，外面冷，你快找个地方躲起来吧。你的爸爸妈妈呢？","voice":["vo_trial_61301_2_32"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302076,"trial_step":76},{"step":76,"content":"那孩子远远地指了指远处，那里停放着许多盖着白麻布的简易担架。","style":3,"background":2576,"log_type":1,"src_id":161302077,"trial_step":77},{"step":77,"content":"霁川将那孩子拢进怀里，把自己最后一点体温分给她。","style":3,"background":2576,"log_type":1,"src_id":161302078,"trial_step":78},{"step":78,"speaker":"霁川","content":"可能，这个奇怪的世界对我们都不公平。","voice":["vo_trial_61301_2_33"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302079,"trial_step":79},{"step":79,"content":"这里真的是死后世界吗？那为何要让她再次经历这样的无能为力。","style":3,"background":2576,"log_type":1,"src_id":161302080,"trial_step":80},{"step":80,"content":"那孩子似乎感受到霁川的低落，忍不住贴紧了她，惶惶不安地寻求慰藉。","style":3,"background":2576,"log_type":1,"src_id":161302081,"trial_step":81},{"step":81,"speaker":"灾民小孩","content":"姐姐……这雪是不是永远不会停了？","voice":["vo_trial_61301_2_34"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302082,"trial_step":82},{"step":82,"content":"霁川没有回答，她牵起那孩子的手。","style":3,"background":2576,"log_type":1,"src_id":161302083,"trial_step":83},{"step":83,"speaker":"霁川","content":"走吧，我带你找个暖和的地方。","voice":["vo_trial_61301_2_35"],"voice_bank":"vo_jichuan_trial","style":1,"background":2576,"log_type":1,"src_id":161302084,"trial_step":84},{"step":84,"content":"雪迟早会停，但这个摇摇欲坠的小镇、这些人、以及她的身体……不一定能坚持到云开时。","style":3,"background":2576,"log_type":1,"src_id":161302085,"trial_step":85},{"step":85,"content":"//黑屏","style":18,"background":10000,"log_type":1,"src_id":161302086,"trial_step":86},{"step":86,"content":"//BG：山路","style":18,"background":2575,"log_type":1,"src_id":161302087,"trial_step":87},{"step":87,"content":"你已经在湿滑的山路上艰难跋涉了许久，双腿已经从一开始的酸沉慢慢变成了麻木的钝痛。","style":3,"background":2575,"log_type":1,"src_id":161302088,"trial_step":88},{"step":88,"content":"一个约莫十岁出头的东洲孩子在前方带着路，她似乎很是熟悉山中道路，因此年纪虽小，脚步依旧稳健。","style":3,"background":2575,"log_type":1,"src_id":161302089,"trial_step":89},{"step":89,"speaker":"阿宝","content":"少侠，再往前走一些就到了……你是不是累了？","voice":["vo_trial_61301_2_36"],"voice_bank":"vo_jichuan_trial","style":1,"background":2575,"log_type":1,"src_id":161302090,"trial_step":90},{"step":90,"options":["没事","我还能坚持"],"style":6,"background":2575,"log_type":1,"src_id":161302091,"trial_step":91,"course":3,"choices":[{"text":"没事","goto":92},{"text":"我还能坚持","goto":92}]},{"step":91,"speaker":"阿宝","content":"没想到你看起来文文弱弱的，却能调动那么多厉害的大人物来帮忙找霜儿姐姐。","voice":["vo_trial_61301_2_37"],"voice_bank":"vo_jichuan_trial","style":1,"background":2575,"log_type":1,"src_id":161302092,"trial_step":92},{"step":92,"speaker":"阿宝","content":"少侠，你是不是传说中的武林盟主之类的……","voice":["vo_trial_61301_2_38"],"voice_bank":"vo_jichuan_trial","style":1,"background":2575,"log_type":1,"src_id":161302093,"trial_step":93},{"step":93,"speaker":"${PlayerName}","content":"我只是认识的朋友多了些。","style":2,"background":2575,"log_type":1,"src_id":161302094,"trial_step":94},{"step":94,"speaker":"阿宝","content":"哦……哎呀！少侠你的脚流血了！","voice":["vo_trial_61301_2_39"],"voice_bank":"vo_jichuan_trial","style":1,"background":2575,"log_type":1,"src_id":161302095,"trial_step":95},{"step":95,"content":"你一愣，低头看去，黑色的靴子被雪水浸湿看不出血迹，但你刚刚踩出的脚印却将积雪染红了一片。","style":3,"background":2575,"log_type":1,"src_id":161302096,"trial_step":96},{"step":96,"content":"你的脚早就已经冻得僵麻，竟不知鞋底是何时被划破的。","style":3,"background":2575,"log_type":1,"src_id":161302097,"trial_step":97},{"step":97,"speaker":"阿宝","content":"哎呀！你在这儿等着，我下山去喊人……","voice":["vo_trial_61301_2_40"],"voice_bank":"vo_jichuan_trial","style":1,"background":2575,"log_type":1,"src_id":161302098,"trial_step":98},{"step":98,"speaker":"${PlayerName}","content":"不碍事，小伤而已，找到霁川要紧。","style":2,"background":2575,"log_type":1,"src_id":161302099,"trial_step":99},{"step":99,"speaker":"${PlayerName}","content":"你不是说快到了吗？快走吧，也不差这一段路了。","style":2,"background":2575,"log_type":1,"src_id":161302100,"trial_step":100},{"step":100,"content":"阿宝犹豫了片刻，接着往前走，但还是稍稍放慢了脚步。","style":3,"background":2575,"log_type":1,"src_id":161302101,"trial_step":101},{"step":101,"speaker":"阿宝","content":"就在前头，那山洞藏得很深，我也是挖野菜的时候不小心摔了一跤才发现的。我一看，呀！这不是镇上爱讲故事吹牛的霜儿姐姐吗！","voice":["vo_trial_61301_2_41"],"voice_bank":"vo_jichuan_trial","style":1,"background":2575,"log_type":1,"src_id":161302102,"trial_step":102},{"step":102,"speaker":"阿宝","content":"哦对了，其实应该叫她霁川姐姐才对。我也是后来才知道，原来霜儿姐姐就是那个超级厉害的山庄庄主！","voice":["vo_trial_61301_2_42"],"voice_bank":"vo_jichuan_trial","style":1,"background":2575,"log_type":1,"src_id":161302103,"trial_step":103},{"step":103,"speaker":"阿宝","content":"刚找到的时候，姐姐偶尔会说胡话，一直喊着“爹”“娘”什么的，后来又在喊“好冷”“救他们”……我听不懂，只能守着她。","voice":["vo_trial_61301_2_43"],"voice_bank":"vo_jichuan_trial","style":1,"background":2575,"log_type":1,"src_id":161302104,"trial_step":104},{"step":104,"speaker":"阿宝","content":"喏，到了——","voice":["vo_trial_61301_2_44"],"voice_bank":"vo_jichuan_trial","style":1,"background":2575,"log_type":1,"src_id":161302105,"trial_step":105},{"step":105,"content":"阿宝突然停住脚步，抬手拨开身前的枯木杂草，在那风雪掩盖的山壁间，竟藏着一个狭小的山洞入口。","style":3,"background":2575,"log_type":1,"src_id":161302106,"trial_step":106},{"step":106,"content":"你弯腰钻进山洞，洞内比外界暖和些许，却弥漫着一股潮湿的霉味，混着一丝淡淡的草药香。","style":3,"background":940104,"log_type":1,"src_id":161302107,"trial_step":107},{"step":107,"content":"走在你前面的阿宝侧身让开，你一眼便看到了不远处的干草堆上，正躺着一个纤细的身影。","style":3,"background":940104,"log_type":1,"src_id":161302108,"trial_step":108},{"step":108,"options":["靠近"],"style":6,"background":940104,"log_type":1,"src_id":161302109,"trial_step":109,"course":3,"choices":[{"text":"靠近","goto":110}]},{"step":109,"content":"她身上还盖着一件小小的老旧棉衣，那似乎是阿宝留下的。棉衣下露出的白裙有些弄脏了。搭在棉衣上的那只手枯瘦粗糙，指尖泛着不正常的青白。","style":3,"background":940104,"log_type":1,"src_id":161302110,"trial_step":110},{"step":110,"content":"你缓缓蹲下身，借着洞口透进来的微弱日光，一点点凑近那张苍白的脸庞，指尖轻轻拨开凌乱的发丝，露出了眉间那颗你万分熟悉的红痣。","style":3,"background":940104,"log_type":1,"src_id":161302111,"trial_step":111},{"step":111,"content":"你假想过无数次与霁川再次遇见的情景。可能是霁川早就已经寻得了康复之法，仍扮成丐帮少女的样子耍你；可能是她精神矍铄，再次隐于帘后摆出一派世外高人的派头。","style":3,"background":940104,"log_type":1,"src_id":161302112,"trial_step":112},{"step":112,"content":"却不想是如今，从未见过的虚弱和狼狈。","style":3,"background":940104,"log_type":1,"src_id":161302113,"trial_step":113},{"step":113,"speaker":"${PlayerName}","content":"没错，是她。","style":2,"background":940104,"log_type":1,"src_id":161302114,"trial_step":114},{"step":114,"content":"百感交集下，你只是吐出这几个字，为她掖了掖那件旧棉衣。她看起来是如此的安静，静得你不敢去探她的鼻息。","style":3,"background":940104,"log_type":1,"src_id":161302115,"trial_step":115},{"step":115,"speaker":"霁川","content":"……雪……要救他们……","voice":["vo_trial_61301_2_45"],"voice_bank":"vo_jichuan_trial","style":1,"background":940104,"log_type":1,"src_id":161302116,"trial_step":116},{"step":116,"content":"霁川的声音轻不可闻。但足以给你牵挂了良久的期盼一个答案——她真的还活着。","style":3,"background":940104,"log_type":1,"src_id":161302117,"trial_step":117},{"step":117,"content":"你伸手握住霁川瘦得几乎只剩皮包骨的手腕，尝试用枷锁建立链接。","style":3,"background":940104,"log_type":1,"src_id":161302118,"trial_step":118},{"step":118,"speaker":"阿宝","content":"她怎么样？还好吗？","voice":["vo_trial_61301_2_46"],"voice_bank":"vo_jichuan_trial","style":1,"background":940104,"log_type":1,"src_id":161302119,"trial_step":119},{"step":119,"speaker":"${PlayerName}","content":"很不乐观，她现在全靠最后一点求生意志在对抗体内的狂厄侵蚀，但我能感觉到她的这股意志也在慢慢消散，必须先把她的意识稳定下来。","style":2,"background":940104,"log_type":1,"src_id":161302120,"trial_step":120},{"step":120,"speaker":"阿宝","content":"啊……那、那有什么我能帮得上忙的吗？","voice":["vo_trial_61301_2_47"],"voice_bank":"vo_jichuan_trial","style":1,"background":940104,"log_type":1,"src_id":161302121,"trial_step":121},{"step":121,"speaker":"${PlayerName}","content":"得辛苦你去洞外开阔的地方守着，我已经联系了专业的医疗救援团队，需要你接应一下。","style":2,"background":940104,"log_type":1,"src_id":161302122,"trial_step":122},{"step":122,"speaker":"阿宝","content":"包在我身上！那你呢？","voice":["vo_trial_61301_2_48"],"voice_bank":"vo_jichuan_trial","style":1,"background":940104,"log_type":1,"src_id":161302123,"trial_step":123},{"step":123,"speaker":"${PlayerName}","content":"她把自己的意识困住了，并不知道自己的处境。我要再找到她一次，叫醒她。","style":2,"background":940104,"log_type":1,"src_id":161302124,"trial_step":124},{"step":124,"content":"//黑屏","style":18,"background":10000,"log_type":1,"src_id":161302125,"trial_step":125},{"step":125,"content":"枷锁连接将你带进霁川的精神疆域，可你双脚尚未站稳，就被一股狂暴的风雪裹挟。","style":3,"background":10000,"log_type":1,"src_id":161302126,"trial_step":126},{"step":126,"content":"放眼望去，目之所及尽是遮天蔽日的白。","style":3,"background":10006,"log_type":1,"src_id":161302127,"trial_step":127},{"step":127,"content":"天地之大，你竟不知该往何处去。","style":3,"background":10006,"log_type":1,"src_id":161302128,"trial_step":128}]}