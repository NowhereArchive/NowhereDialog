{"id":400701402,"chapter_id":50019,"scene_id":51909,"steps":[{"step":1,"speaker":"疯剪子","content":"藏到哪里了，你藏到哪里了？","voice":["vo_event_400701402_01"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":2,"speaker":"疯剪子","content":"肚子里吗？脑子里吗？切开来看看，就在你这里！","voice":["vo_event_400701402_02"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":3,"content":"它咆哮着向你冲来，你下意识地抬手向它，而看到你的动作，那个发狂的人竟下意识刹住了车。","style":3,"background":2075,"log_type":1},{"step":4,"speaker":"疯剪子","content":"这是？！唔啊！！","voice":["vo_event_400701402_04"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":5,"content":"它突然露出惊恐的表情，这让你勇气倍增。","style":3,"background":2075,"log_type":1},{"step":6,"options":["我不会输的！"],"jump":[7],"style":6,"background":2075,"log_type":1},{"step":9,"content":"什么事情都没有发生。你干抬着手，不知道自己为什么会这么做，而对方似乎也有些惊讶。","style":3,"background":2075,"log_type":1},{"step":10,"speaker":"疯剪子","content":"……","voice":["vo_event_400701402_09"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":11,"speaker":"%u","content":"……","style":2,"background":2075,"log_type":1},{"step":12,"speaker":"%u","content":"我说了……我什么都不记得……","style":2,"background":2075,"log_type":1},{"step":13,"content":"短暂的沉默后，你比对方先反应过来，立刻行动。","style":3,"background":2075,"log_type":1},{"step":14,"options":["跑！","看后面！剪刀！"],"jump":[15,15],"style":6,"background":2075,"log_type":1},{"step":15,"content":"你大喊一声指向它身后，接着不管三七二十一转身就跑。","style":3,"background":2075,"log_type":1},{"step":16,"content":"可还没迈出一步就被绊倒在地。漆黑中，一把诡异的头发早已缠住你的脚踝。","style":3,"background":2075,"log_type":1},{"step":17,"speaker":"疯剪子","content":"你逃不了的，你也一样，逃不了的！！呀——","voice":["vo_event_400701402_17"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":20,"content":"叮铃——","style":3,"background":10000,"log_type":1},{"step":21,"content":"身后的灯突然亮了。","style":3,"background":10000,"log_type":1},{"step":22,"speaker":"疯剪子","content":"？？","voice":["vo_event_400701402_21"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":23,"content":"你慢慢睁开眼。雾气在迅速褪去，那些诡异的发丝生物如同避光的昆虫般四散逃离。","style":3,"background":2075,"log_type":1},{"step":24,"content":"那位疯剪子也不例外。它不甘地尖叫着，伴随雾霭消失在街角。","style":3,"background":2075,"log_type":1},{"step":25,"content":"身后的店门被谁拉开，悦耳的铜铃声在你耳边作响。","style":3,"background":2075,"log_type":1},{"step":26,"speaker":"？？","content":"……你怎么来了？","voice":["vo_event_400701402_25"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":27,"speaker":"？？","content":"不是说好在家休息，等我下班吗？","voice":["vo_event_400701402_26"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":29,"content":"好熟悉的声音，随之而至的是淡淡的香气，安抚你还未平缓的呼吸。","style":3,"background":4118,"log_type":1},{"step":30,"content":"女子已走到你面前，伸手捋了捋你蓬乱的头发，声音带着些怜惜。","style":3,"background":4119,"log_type":1},{"step":32,"speaker":"？？","content":"……又把自己搞得这么狼狈，这么回去可不行……","voice":["vo_event_400701402_29"],"voice_bank":"vo_event_07014","style":1,"background":4122,"log_type":1},{"step":33,"speaker":"？？","content":"来，手给我。回家前，我先帮你打理一下。","voice":["vo_event_400701402_30"],"voice_bank":"vo_event_07014","style":1,"background":4122,"log_type":1}]}