{"id":1030303,"chapter_id":1030303,"scene_id":1,"steps":[{"step":1,"speaker":"娜恰","content":"传说中，有一个怪物的乐园。","voice":["vo_trial_30303_1_1"],"voice_bank":"vo_snake_trial","style":1,"background":10000,"log_type":1,"src_id":130303001,"trial_step":1},{"step":2,"speaker":"娜恰","content":"但……她其实也不知道，那里真的能获得专属于怪物的，永恒的欢愉吗？","voice":["vo_trial_30303_1_2"],"voice_bank":"vo_snake_trial","style":1,"background":10000,"log_type":1,"src_id":130303002,"trial_step":2},{"step":3,"content":"黑暗中，娜恰的声音变得悲伤，你似乎看见了那个游荡在新城彩灯之下，寻找快乐的女孩。","style":3,"background":10000,"log_type":1,"src_id":130303003,"trial_step":3},{"step":4,"speaker":"娜恰","content":"女孩自幼生得怪异……她的眼睛，她的耳朵，她身上奇怪的胎记，被无数人取笑，害怕。","voice":["vo_trial_30303_1_3"],"voice_bank":"vo_snake_trial","style":1,"background":10000,"log_type":1,"src_id":130303004,"trial_step":4},{"step":5,"speaker":"娜恰","content":"她和正常人格格不入，所以她才无法在人类之中，找到自己的快乐。","voice":["vo_trial_30303_1_4"],"voice_bank":"vo_snake_trial","style":1,"background":10000,"log_type":1,"src_id":130303005,"trial_step":5},{"step":6,"content":"周围的暗色中仿佛有什么东西在涌动，那些翻腾的东西，渐渐地，渐渐地，变成了你极为熟悉的场景。","style":3,"background":10000,"log_type":1,"src_id":130303006,"trial_step":6},{"step":7,"speaker":"玩家","content":"这里是无尽嘉年华？！","style":2,"background":802,"log_type":1,"src_id":130303007,"trial_step":7},{"step":8,"speaker":"带蛇的女孩/娜恰","content":"是啊……是无尽嘉年华，这里是怪物的乐园，这里一定会接纳我，让我找到快乐吧？","voice":["vo_trial_30303_1_5"],"voice_bank":"vo_snake_trial","style":1,"background":802,"log_type":1,"src_id":130303008,"trial_step":8},{"step":9,"content":"娜恰的声音又一次和故事中的人物重合在一起。","style":3,"background":802,"log_type":1,"src_id":130303009,"trial_step":9},{"step":10,"content":"剧场上，她和她的眼神里，也是一样的无光。但这晦暗中却又透着渴望。","style":3,"background":802,"log_type":1,"src_id":130303010,"trial_step":10},{"step":11,"speaker":"玩家","content":"娜恰，你进不去的。","style":2,"background":802,"log_type":1,"src_id":130303011,"trial_step":11},{"step":12,"speaker":"选项","options":["你是人类。"],"style":6,"background":802,"log_type":1,"src_id":130303012,"trial_step":12,"course":3,"choices":[{"text":"你是人类。","goto":13}]},{"step":13,"content":"听到你的呼喊，“娜恰”转过头来，对着台下的你笑了笑。","style":3,"background":802,"log_type":1,"src_id":130303013,"trial_step":13},{"step":14,"speaker":"娜恰","content":"我是……人类？","voice":["vo_trial_30303_1_6"],"voice_bank":"vo_snake_trial","style":1,"background":802,"log_type":1,"src_id":130303014,"trial_step":14},{"step":15,"speaker":"娜恰","content":"你是在做梦吗？","voice":["vo_trial_30303_1_7"],"voice_bank":"vo_snake_trial","style":1,"background":802,"log_type":1,"src_id":130303015,"trial_step":15},{"step":16,"content":"娜恰继续朝前走去，但乐园的死役已经开始躁动。","style":3,"background":801,"log_type":1,"src_id":130303016,"trial_step":16},{"step":17,"content":"它们发现了这位不速之客，它们冲上去，将她赶走。","style":3,"background":801,"log_type":1,"src_id":130303017,"trial_step":17},{"step":18,"speaker":"娜恰","content":"为什么……为什么要拒绝我？！","voice":["vo_trial_30303_1_8"],"voice_bank":"vo_snake_trial","style":1,"background":801,"log_type":1,"src_id":130303018,"trial_step":18},{"step":19,"content":"她的瘦小的身躯摇摇欲坠，死役划伤了她的脸颊，手臂，还有腹部。","style":3,"background":801,"log_type":1,"src_id":130303019,"trial_step":19},{"step":20,"content":"乐园扭曲的大门里传来一阵又一阵的怒吼——","style":3,"background":801,"log_type":1,"src_id":130303020,"trial_step":20},{"step":21,"speaker":"死役","content":"走开，走开，你不属于这里，这里不是你的乐园！","voice":["vo_trial_30303_1_9"],"voice_bank":"vo_snake_trial","style":1,"background":801,"log_type":1,"src_id":130303021,"trial_step":21},{"step":22,"speaker":"玩家","content":"娜恰，不要再往前走了！","style":2,"background":801,"log_type":1,"src_id":130303022,"trial_step":22},{"step":23,"speaker":"玩家","content":"你会被死役吞噬的！那里不是你想象中的乐园！","style":2,"background":801,"log_type":1,"src_id":130303023,"trial_step":23},{"step":24,"speaker":"玩家","content":"它只会……让你……让现在的你……更加痛苦。","style":2,"background":801,"log_type":1,"src_id":130303024,"trial_step":24},{"step":25,"speaker":"娜恰","content":"哈……哈……","voice":["vo_trial_30303_1_10"],"voice_bank":"vo_snake_trial","style":1,"background":801,"log_type":1,"src_id":130303025,"trial_step":25},{"step":26,"speaker":"娜恰","content":"为什么……为什么？！","voice":["vo_trial_30303_1_11"],"voice_bank":"vo_snake_trial","style":1,"background":801,"log_type":1,"src_id":130303026,"trial_step":26},{"step":27,"speaker":"娜恰","content":"快乐，快乐是奢侈品，是梦幻之物……","voice":["vo_trial_30303_1_12"],"voice_bank":"vo_snake_trial","style":1,"background":801,"log_type":1,"src_id":130303027,"trial_step":27},{"step":28,"speaker":"娜恰","content":"我明明已经为自己找寻了那么多的快乐，但我始终无法获得美梦，无法感受到真正的快乐！","voice":["vo_trial_30303_1_13"],"voice_bank":"vo_snake_trial","style":1,"background":801,"log_type":1,"src_id":130303028,"trial_step":28},{"step":29,"content":"娜恰义无反顾地冲进乐园，却一次又一次地被打倒在地，拖出乐园。","style":3,"background":710,"log_type":1,"src_id":130303029,"trial_step":29},{"step":30,"speaker":"娜恰","content":"我只是……","voice":["vo_trial_30303_1_14"],"voice_bank":"vo_snake_trial","style":1,"background":710,"log_type":1,"src_id":130303030,"trial_step":30},{"step":31,"speaker":"娜恰","content":"只是……","voice":["vo_trial_30303_1_15"],"voice_bank":"vo_snake_trial","style":1,"background":710,"log_type":1,"src_id":130303031,"trial_step":31},{"step":32,"speaker":"娜恰","content":"想永远都感受到快乐啊！！！","voice":["vo_trial_30303_1_16"],"voice_bank":"vo_snake_trial","style":1,"background":710,"log_type":1,"src_id":130303032,"trial_step":32},{"step":33,"content":"娜恰再没有力气站起来了，她躺在乐园门外，看着灰霾一片的天空，耳边传来蛇虫鼠蚁爬行靠近的声音。","style":3,"background":710,"log_type":1,"src_id":130303033,"trial_step":33},{"step":34,"content":"她的情绪，她的感觉，她的执拗，顺着枷锁一点不落地传达给你。","style":3,"background":710,"log_type":1,"src_id":130303034,"trial_step":34},{"step":35,"content":"你的牙齿紧咬，眼睛通红，感受着她曾经承受过的一切。","style":3,"background":710,"log_type":1,"src_id":130303035,"trial_step":35},{"step":36,"content":"无尽嘉年华的周围漆黑一片，娜恰无力地躺在地上，偏执地渴求着自己的快乐。","style":3,"background":710,"log_type":1,"src_id":130303036,"trial_step":36},{"step":37,"content":"你正准备强行唤醒娜恰，却听到了令人毛骨悚然的声音。","style":3,"background":710,"log_type":1,"src_id":130303037,"trial_step":37},{"step":38,"content":"那是翅膀扑扇的声音，你感受到娜恰被这样的声音吸引，抬起头，往前看去——","style":3,"background":710,"log_type":1,"src_id":130303038,"trial_step":38},{"step":39,"content":"一个熟悉的身影，像是被娜恰的偏执吸引过来一样，翕动着口器，释放着晶莹的液体。","style":3,"background":710,"log_type":1,"src_id":130303039,"trial_step":39},{"step":40,"speaker":"玩家","content":"这是玛芙？！它在释放梦露！娜恰，立刻离开这……！","style":2,"background":710,"log_type":1,"src_id":130303040,"trial_step":40},{"step":41,"speaker":"娜恰","content":"好甜……好甜……","voice":["vo_trial_30303_1_17"],"voice_bank":"vo_snake_trial","style":1,"background":710,"log_type":1,"src_id":130303041,"trial_step":41},{"step":42,"speaker":"娜恰","content":"喜欢这个味道……它……是我的快乐吗？","voice":["vo_trial_30303_1_18"],"voice_bank":"vo_snake_trial","style":1,"background":710,"log_type":1,"src_id":130303042,"trial_step":42},{"step":43,"speaker":"玛芙","content":"嘻嘻……快乐，快乐，这个，你喜欢的，喜欢的快乐。","voice":["vo_trial_30303_1_19"],"voice_bank":"vo_snake_trial","style":1,"background":710,"log_type":1,"src_id":130303043,"trial_step":43},{"step":44,"content":"仅在瞬间，玛芙便将你和娜恰拉进了纯白的梦境。","style":3,"background":10006,"log_type":1,"src_id":130303044,"trial_step":44},{"step":45,"content":"娜恰还是那般跪坐在地上，喃喃自语着关于快乐的味道，对这个纯白的梦境无动于衷。","style":3,"background":10006,"log_type":1,"src_id":130303045,"trial_step":45},{"step":46,"speaker":"玛芙","content":"奇怪，真奇怪……","voice":["vo_trial_30303_1_20"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303046,"trial_step":46},{"step":47,"speaker":"玛芙","content":"执念，巨大的执念，但是……一片空白……","voice":["vo_trial_30303_1_21"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303047,"trial_step":47},{"step":48,"speaker":"玛芙","content":"你没有快乐！没有！什么都吃不到！你没有快乐！没有！","voice":["vo_trial_30303_1_22"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303048,"trial_step":48},{"step":49,"content":"娜恰的动作停了下来，她以一种诡异的，扭曲的姿势，转头看向玛芙。","style":3,"background":10006,"log_type":1,"src_id":130303049,"trial_step":49},{"step":50,"speaker":"娜恰","content":"你……再说一次？","voice":["vo_trial_30303_1_23"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303050,"trial_step":50},{"step":51,"speaker":"玛芙","content":"你的梦，空白，空白！没有快乐！哈哈哈！你没有快乐！我很饿……！","voice":["vo_trial_30303_1_24"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303051,"trial_step":51},{"step":52,"speaker":"娜恰","content":"我找了很久……很久……我找不到。我也想我能拥有……","voice":["vo_trial_30303_1_25"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303052,"trial_step":52},{"step":53,"speaker":"娜恰","content":"你竟然想吃掉我的快乐？","voice":["vo_trial_30303_1_26"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303053,"trial_step":53},{"step":54,"speaker":"玛芙","content":"你没有那种东西。","voice":["vo_trial_30303_1_27"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303054,"trial_step":54},{"step":55,"content":"枷锁猛烈地跳动起来——这是遇见强大的禁闭者时才会出现的征兆。","style":3,"background":10006,"log_type":1,"src_id":130303055,"trial_step":55},{"step":56,"content":"或许是自己过分的执迷，亦或者是无尽嘉年华的影响，娜恰所感染的狂厄早就超出了范围值。","style":3,"background":10006,"log_type":1,"src_id":130303056,"trial_step":56},{"step":57,"speaker":"娜恰","content":"解决掉你，说不定，我能获得快乐呢？","voice":["vo_trial_30303_1_28"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303057,"trial_step":57},{"step":58,"content":"娜恰的小蛇突然出现在玛芙身上，死死地缠住了它，娜恰的手指划过玛芙心脏的位置，轻轻地拍打着。","style":3,"background":10006,"log_type":1,"src_id":130303058,"trial_step":58},{"step":59,"speaker":"娜恰","content":"只要一瞬间……你也会很快乐的。","voice":["vo_trial_30303_1_29"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303059,"trial_step":59},{"step":60,"speaker":"玛芙","content":"别！别！放过我，我给你快乐！让我活着！活着！快乐！","voice":["vo_trial_30303_1_30"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303060,"trial_step":60},{"step":61,"content":"玛芙的翅膀停止扇动，瘫倒在了纯白之中。它蠕动着身子，将一团粘稠的东西吐了出来，味道甜腻恶心。","style":3,"background":10006,"log_type":1,"src_id":130303061,"trial_step":61},{"step":62,"speaker":"玛芙","content":"我的心脏，是梦露。给你，梦露能让你快乐！","voice":["vo_trial_30303_1_31"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303062,"trial_step":62},{"step":63,"speaker":"娜恰","content":"我就是喝了它，才到了这个地方。你以为……我还会再信这样的蠢话吗？","voice":["vo_trial_30303_1_32"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303063,"trial_step":63},{"step":64,"speaker":"娜恰","content":"但……我接受你的臣服。","voice":["vo_trial_30303_1_33"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303064,"trial_step":64},{"step":65,"content":"娜恰捏着玛芙的心脏，幻化成一只小瓶子，径直走出了这个一片白的世界。","style":3,"background":10006,"log_type":1,"src_id":130303065,"trial_step":65},{"step":66,"content":"你认出这个瓶子了——那就是妙梦瓶！","style":3,"background":10006,"log_type":1,"src_id":130303066,"trial_step":66},{"step":67,"speaker":"娜恰","content":"我……没有快乐。","voice":["vo_trial_30303_1_34"],"voice_bank":"vo_snake_trial","style":1,"background":710,"log_type":1,"src_id":130303067,"trial_step":67},{"step":68,"content":"回到现实的娜恰，意识已经癫狂混乱，彼此连接着的你们，似乎在乐园的门口，看到了一支马戏团车队，从锈河中游荡而过。","style":3,"background":710,"log_type":1,"src_id":130303068,"trial_step":68},{"step":69,"content":"它的后面跟随着魑魅魍魉无数被狂厄感染的怪物，一起朝着一个红色污染的诡异入口前进，随之消失。","style":3,"background":710,"log_type":1,"src_id":130303069,"trial_step":69},{"step":70,"speaker":"娜恰","content":"和我一样的怪物……","voice":["vo_trial_30303_1_35"],"voice_bank":"vo_snake_trial","style":1,"background":710,"log_type":1,"src_id":130303070,"trial_step":70},{"step":71,"content":"娜恰拿着妙梦瓶，独自一人在街头巷尾漫无目的地游荡着。","style":14,"background":10005,"log_type":1,"src_id":130303071,"trial_step":71},{"step":72,"content":"她想要继续寻找快乐，可是那一片白茫茫的梦境，让她根本无法静下心来。","style":14,"background":10005,"log_type":1,"src_id":130303072,"trial_step":72},{"step":73,"speaker":"娜恰","content":"这里所有人……都没有快乐。","voice":["vo_trial_30303_1_36"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303073,"trial_step":73},{"step":74,"content":"她放眼望去，好像目之所及，全是哀嚎，全是苦难——","style":3,"background":2016,"log_type":1,"src_id":130303074,"trial_step":74},{"step":75,"content":"昏暗的后巷中，一位老人匍匐在地上，苦苦地向面前站着的人哀求。","style":3,"background":2016,"log_type":1,"src_id":130303075,"trial_step":75},{"step":76,"content":"被声音吸引，娜恰停下了脚步，远远地望着他们。","style":3,"background":2016,"log_type":1,"src_id":130303076,"trial_step":76},{"step":77,"speaker":"老人","content":"求求你，发发善心吧，家里还有瘫的和小的等着我养，我不能没有这份工作啊！","voice":["vo_trial_30303_1_37"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303077,"trial_step":77},{"step":78,"speaker":"年轻人","content":"你求我也没用，我已经尽力了，不然刚才就直接打死你们了！","voice":["vo_trial_30303_1_38"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303078,"trial_step":78},{"step":79,"speaker":"年轻人","content":"快走吧！等下老板来了，就迟了！","voice":["vo_trial_30303_1_39"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303079,"trial_step":79},{"step":80,"speaker":"？？？","content":"怎么还没解决啊？！","voice":["vo_trial_30303_1_40"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303080,"trial_step":80},{"step":81,"speaker":"？？？","content":"你是不是也不想活了？！","voice":["vo_trial_30303_1_41"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303081,"trial_step":81},{"step":82,"content":"包围着后巷的楼房，其中一扇门被粗暴的推开，一个大腹便便的男人出现在你们面前。","style":3,"background":2016,"log_type":1,"src_id":130303082,"trial_step":82},{"step":83,"speaker":"年轻人","content":"老板！我、我这就把他们撵走！","voice":["vo_trial_30303_1_42"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303083,"trial_step":83},{"step":84,"speaker":"老板","content":"撵了十分钟了！你要是也不想干活就直说！","voice":["vo_trial_30303_1_43"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303084,"trial_step":84},{"step":85,"speaker":"老板","content":"这点活儿都做不好，是不是还等着我亲自来啊？！","voice":["vo_trial_30303_1_44"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303085,"trial_step":85},{"step":86,"speaker":"年轻人","content":"不是不是，我这就撵！这就撵！","voice":["vo_trial_30303_1_45"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303086,"trial_step":86},{"step":87,"content":"年轻人把抱着自己大腿的老人扯开，不停地推搡，任凭老人如何哭喊，也没有停下。","style":3,"background":2016,"log_type":1,"src_id":130303087,"trial_step":87},{"step":88,"speaker":"年轻人","content":"快走吧，我真的救不了你，再这样下去，我也要死了，能少死一个人，就少死一个吧！","voice":["vo_trial_30303_1_46"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303088,"trial_step":88},{"step":89,"speaker":"娜恰","content":"结果这五光十色的新城……最下面，也是和辛迪加一样的黑。","voice":["vo_trial_30303_1_47"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303089,"trial_step":89},{"step":90,"speaker":"娜恰","content":"这些阴暗的后巷，好似无底洞一般，一点一点地吞没所有被快乐抛弃的人。","voice":["vo_trial_30303_1_48"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303090,"trial_step":90},{"step":91,"content":"娜恰看着眼前的一切，像在讲故事一样，不愠不火地说着。","style":3,"background":2016,"log_type":1,"src_id":130303091,"trial_step":91},{"step":92,"speaker":"娜恰","content":"你好可怜啊……","voice":["vo_trial_30303_1_49"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303092,"trial_step":92},{"step":93,"speaker":"娜恰","content":"因为我是怪物，所以我没办法用我的方式，获得快乐，你是人类，说不定你可以……","voice":["vo_trial_30303_1_50"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303093,"trial_step":93},{"step":94,"speaker":"娜恰","content":"那……想不想获得快乐？","voice":["vo_trial_30303_1_51"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303094,"trial_step":94},{"step":95,"speaker":"娜恰","content":"我来告诉你们如何获得快乐，好不好？","voice":["vo_trial_30303_1_52"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303095,"trial_step":95},{"step":96,"speaker":"老人","content":"你……你是谁……？","voice":["vo_trial_30303_1_53"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303096,"trial_step":96},{"step":97,"speaker":"老人","content":"是谁都好，帮帮我吧，救救我吧！","voice":["vo_trial_30303_1_54"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303097,"trial_step":97},{"step":98,"content":"后巷的墙根旁，堆满了垃圾，那些装满昂贵饮品的瓶子，在被人吃干抹净后，一视同仁地丢弃在这后巷，碎成两半。","style":3,"background":2016,"log_type":1,"src_id":130303098,"trial_step":98},{"step":99,"speaker":"娜恰","content":"好……好……当身边的人皆为苦楚者，当你被绝望包围时……","voice":["vo_trial_30303_1_55"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303099,"trial_step":99},{"step":100,"speaker":"娜恰","content":"哭吧，愤怒吧，哀恸吧……然后……行动吧。","voice":["vo_trial_30303_1_56"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303100,"trial_step":100},{"step":101,"content":"娜恰依旧在低语着，混杂着老人的哭喊，年轻人的碎语。","style":3,"background":2016,"log_type":1,"src_id":130303101,"trial_step":101},{"step":102,"content":"你看见娜恰——亦或者是你，枷锁和娜恰的能力，捆绑着你们的情绪与感官，连在一起。","style":3,"background":2016,"log_type":1,"src_id":130303102,"trial_step":102},{"step":103,"content":"你能清晰地感受到，你们握住了老人的手，朝废弃的瓶子伸去——","style":3,"background":2016,"log_type":1,"src_id":130303103,"trial_step":103},{"step":104,"speaker":"选项","options":["挣扎"],"style":6,"background":2016,"log_type":1,"src_id":130303104,"trial_step":104,"course":3,"choices":[{"text":"挣扎","goto":105}]},{"step":105,"speaker":"玩家","content":"娜恰，不要这么做！你这不是在帮她！","style":2,"background":2016,"log_type":1,"src_id":130303105,"trial_step":105},{"step":106,"speaker":"玩家","content":"这样解决不了她的问题，没办法让她快乐起来的！","style":2,"background":2016,"log_type":1,"src_id":130303106,"trial_step":106},{"step":107,"speaker":"娜恰","content":"别乱想，别害怕，这只是一个故事——或者，就当是一场演出吧！","voice":["vo_trial_30303_1_57"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303107,"trial_step":107},{"step":108,"content":"老人手握上了碎瓶子，转身看着不远处还在骂人的老板。娜恰的声音带上了一丝兴奋的战栗，不停地鼓动着。","style":3,"background":2016,"log_type":1,"src_id":130303108,"trial_step":108},{"step":109,"speaker":"娜恰","content":"是的，就是这样，去获得你的快乐吧！","voice":["vo_trial_30303_1_58"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303109,"trial_step":109},{"step":110,"content":"尖锐的撕裂声和惨叫交织在一起，难闻的味道顿时充盈整个鼻腔。","style":3,"background":2016,"log_type":1,"src_id":130303110,"trial_step":110},{"step":111,"speaker":"选项","options":["……"],"style":6,"background":2016,"log_type":1,"src_id":130303111,"trial_step":111,"course":3,"choices":[{"text":"……","goto":112}]},{"step":112,"speaker":"老人","content":"不……不……怎么会这样！！","voice":["vo_trial_30303_1_59"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303112,"trial_step":112},{"step":113,"speaker":"老人","content":"我没有想要下手的，没有……是她……是她……","voice":["vo_trial_30303_1_60"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303113,"trial_step":113},{"step":114,"speaker":"娜恰","content":"太好啦！就是这么做！解决掉一切，是不是就好多了？","voice":["vo_trial_30303_1_61"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303114,"trial_step":114},{"step":115,"speaker":"娜恰","content":"怎么样，你感受到快乐了吗？","voice":["vo_trial_30303_1_62"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303115,"trial_step":115},{"step":116,"content":"娜恰手舞足蹈地看着跪在地上的老人，但老人浑身颤抖，脸色雪白，完全不回应娜恰。","style":3,"background":2016,"log_type":1,"src_id":130303116,"trial_step":116},{"step":117,"speaker":"娜恰","content":"你好像……不快乐啊……怎么会呢……但你确实发抖的厉害……","voice":["vo_trial_30303_1_63"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303117,"trial_step":117},{"step":118,"speaker":"娜恰","content":"我知道了……这样获得的快乐只有一瞬，抵不过你从前受到的伤害对吗？","voice":["vo_trial_30303_1_64"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303118,"trial_step":118},{"step":119,"speaker":"娜恰","content":"那……你来试试这个吧？","voice":["vo_trial_30303_1_65"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130303119,"trial_step":119},{"step":120,"content":"你看着娜恰将妙梦瓶拿出来，握着老人颤颤巍巍的双手，让她喝了下去——","style":3,"background":2016,"log_type":1,"src_id":130303120,"trial_step":120},{"step":121,"content":"娜恰的梦境，即是玛芙的心脏所依附的世界，在纯白的世界里，突然出现了一副动态的挂画，挂画里，老人和小孩笑着，而娜恰站在挂画前，静静地欣赏着。","style":3,"background":10006,"log_type":1,"src_id":130303121,"trial_step":121},{"step":122,"speaker":"娜恰","content":"这是快乐吗？是她的快乐……？","voice":["vo_trial_30303_1_66"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303122,"trial_step":122},{"step":123,"content":"娜恰看着这幅画，想了很久很久，随即突然地欢欣起来，像小孩子得到了糖果一样。","style":3,"background":10006,"log_type":1,"src_id":130303123,"trial_step":123},{"step":124,"speaker":"娜恰","content":"我知道了，我明白了！","voice":["vo_trial_30303_1_67"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303124,"trial_step":124},{"step":125,"speaker":"娜恰","content":"原来，这样我就能获得快乐了！","voice":["vo_trial_30303_1_68"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303125,"trial_step":125},{"step":126,"speaker":"娜恰","content":"我要像玛芙一样！帮助别人，让别人喝下梦露，给别人带去快乐！这样我的梦境里，也会有快乐啦！","voice":["vo_trial_30303_1_69"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303126,"trial_step":126},{"step":127,"speaker":"娜恰","content":"你们的快乐，装饰我的梦境……我就能获得快乐！我的梦境不会再是一片空白！","voice":["vo_trial_30303_1_70"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303127,"trial_step":127},{"step":128,"speaker":"娜恰","content":"所以……","voice":["vo_trial_30303_1_71"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303128,"trial_step":128},{"step":129,"speaker":"娜恰","content":"让我给你带去快乐吧？","voice":["vo_trial_30303_1_72"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303129,"trial_step":129},{"step":130,"speaker":"娜恰","content":"喝下去，你会获得永无止境的快乐和美梦。","voice":["vo_trial_30303_1_73"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303130,"trial_step":130},{"step":131,"speaker":"娜恰","content":"这是对你的奖赏，这是你应该得到的……","voice":["vo_trial_30303_1_74"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303131,"trial_step":131},{"step":132,"content":"脑海里的声音久久回荡，娜恰向你缓缓走来。","style":3,"background":10006,"log_type":1,"src_id":130303132,"trial_step":132},{"step":133,"content":"她张开双手，好像要拥抱你一样。","style":3,"background":10006,"log_type":1,"src_id":130303133,"trial_step":133},{"step":134,"content":"你缓缓地抬头——","style":3,"background":10006,"log_type":1,"src_id":130303134,"trial_step":134},{"step":135,"speaker":"玩家","content":"不要再迷惑我。","style":2,"background":10006,"log_type":1,"src_id":130303136,"trial_step":136},{"step":136,"speaker":"娜恰","content":"？！","voice":["vo_trial_30303_1_75"],"voice_bank":"vo_snake_trial","style":1,"background":10006,"log_type":1,"src_id":130303137,"trial_step":137},{"step":137,"content":"你已经知道来龙去脉了——娜恰的妙梦瓶，以及玛芙。","style":3,"background":10006,"log_type":1,"src_id":130303138,"trial_step":138},{"step":138,"speaker":"玩家","content":"剧场该落幕了，娜恰。","style":2,"background":10006,"log_type":1,"src_id":130303139,"trial_step":139},{"step":139,"content":"你不能再放任娜恰下去了。","style":3,"background":10006,"log_type":1,"src_id":130303140,"trial_step":140},{"step":140,"content":"环绕在你周围的迷雾散去，审查室黑灰色的墙壁渐渐清明——你们一直都在审查室里。","style":3,"background":1000,"log_type":1,"src_id":130303141,"trial_step":141},{"step":141,"content":"只是审查室的地上，还多了一些像是马戏团中变魔术使用的道具，天知道娜恰从哪里拿出来的。","style":3,"background":1000,"log_type":1,"src_id":130303142,"trial_step":142},{"step":142,"content":"在你的面前，你正紧紧握住娜恰的手腕，而她，手中拿着一瓶粉色的液体，似乎想要灌进你的嘴里。","style":3,"background":1000,"log_type":1,"src_id":130303143,"trial_step":143},{"step":143,"speaker":"娜恰","content":"你……清醒过来了？！","voice":["vo_trial_30303_1_76"],"voice_bank":"vo_snake_trial","style":1,"background":1000,"log_type":1,"src_id":130303144,"trial_step":144},{"step":144,"speaker":"娜恰","content":"明明……就差这么一点。","voice":["vo_trial_30303_1_77"],"voice_bank":"vo_snake_trial","style":1,"background":1000,"log_type":1,"src_id":130303145,"trial_step":145},{"step":145,"speaker":"娜恰","content":"你马上……就能感受……感受我的“快乐”了！","voice":["vo_trial_30303_1_78"],"voice_bank":"vo_snake_trial","style":1,"background":1000,"log_type":1,"src_id":130303146,"trial_step":146},{"step":146,"speaker":"玩家","content":"你的异能很厉害，娜恰。","style":2,"background":1000,"log_type":1,"src_id":130303147,"trial_step":147},{"step":147,"speaker":"玩家","content":"但……你是我枷锁之下的禁闭者。","style":2,"background":1000,"log_type":1,"src_id":130303148,"trial_step":148},{"step":148,"content":"你依旧握着她的手腕，将她拉近，直直地看着她青灰色的眼睛。","style":3,"background":1000,"log_type":1,"src_id":130303149,"trial_step":149},{"step":149,"speaker":"选项","options":["这是最后一瓶梦露吗？"],"style":6,"background":1000,"log_type":1,"src_id":130303150,"trial_step":150,"course":3,"choices":[{"text":"这是最后一瓶梦露吗？","goto":151}]},{"step":150,"speaker":"娜恰","content":"……","style":1,"background":1000,"log_type":1,"src_id":130303151,"trial_step":151},{"step":151,"speaker":"玩家","content":"妙梦瓶果然还是能继续使用，对吗？","style":2,"background":1000,"log_type":1,"src_id":130303152,"trial_step":152},{"step":152,"speaker":"娜恰","content":"哈哈哈……是啊，是啊……因为我还需要快乐，我还想要让你体会快乐！","voice":["vo_trial_30303_1_79"],"voice_bank":"vo_snake_trial","style":1,"background":1000,"log_type":1,"src_id":130303153,"trial_step":153},{"step":153,"content":"娜恰笑着，眼睛里却盛满了泪水——这一幕你记得，在审查娜恰之前，你们就是这么相遇的。","style":3,"background":1000,"log_type":1,"src_id":130303154,"trial_step":154},{"step":154,"speaker":"玩家","content":"为什么要哭呢？我感受到你在变得越来越虚弱，你的精神在被蚕食。","style":2,"background":1000,"log_type":1,"src_id":130303155,"trial_step":155},{"step":155,"speaker":"玩家","content":"你在被妙梦瓶操控……是吗？娜恰。","style":2,"background":1000,"log_type":1,"src_id":130303156,"trial_step":156},{"step":156,"speaker":"玩家","content":"告诉我，它在哪里，我会救你的，娜恰。","style":2,"background":1000,"log_type":1,"src_id":130303157,"trial_step":157},{"step":157,"content":"娜恰摇了摇头，借着你的力气支撑着自己握着梦露的手。","style":3,"background":1000,"log_type":1,"src_id":130303158,"trial_step":158},{"step":158,"speaker":"娜恰","content":"不入梦境……不追求快乐……是找不到它的。","voice":["vo_trial_30303_1_80"],"voice_bank":"vo_snake_trial","style":1,"background":1000,"log_type":1,"src_id":130303159,"trial_step":159},{"step":159,"speaker":"娜恰","content":"你……真的能……","voice":["vo_trial_30303_1_81"],"voice_bank":"vo_snake_trial","style":1,"background":1000,"log_type":1,"src_id":130303160,"trial_step":160},{"step":160,"speaker":"玩家","content":"既然如此，那我就遂了你的心愿吧。","style":2,"background":1000,"log_type":1,"src_id":130303161,"trial_step":161},{"step":161,"content":"你就着娜恰的手，将那粉色的液体一饮而尽。","style":3,"background":1000,"log_type":1,"src_id":130303162,"trial_step":162},{"step":162,"content":"甜腻的感觉从舌尖蔓延到胃里，叫人头皮发麻。","style":3,"background":10000,"log_type":1,"src_id":130303163,"trial_step":163},{"step":163,"speaker":"玩家","content":"你是我的禁闭者……我所说的一切，你都会做到的。","style":2,"background":10000,"log_type":1,"src_id":130303164,"trial_step":164},{"step":164,"speaker":"玩家","content":"让我……坠入你的梦境。","style":2,"background":10000,"log_type":1,"src_id":130303165,"trial_step":165}]}