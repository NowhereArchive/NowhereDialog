{"id":401102000,"chapter_id":50027,"scene_id":52705,"steps":[{"step":1,"content":"嘟——嘟——咔！","style":18,"background":1058,"log_type":1},{"step":2,"speaker":"道尔","content":"喂？忙着呢谁啊！","voice":["vo_event_401101401_2"],"voice_bank":"vo_event_11014","style":11,"background":1058,"log_type":1},{"step":3,"speaker":"克里斯蒂娜","content":"探长探长，我知道内森在哪儿了！地方发给你不一定对，我先过去探路！","voice":["vo_event_401101401_3"],"voice_bank":"vo_event_11014","style":1,"background":1058,"log_type":1},{"step":4,"speaker":"道尔","content":"啊？别！危险啊丫头！等我们一起——","voice":["vo_event_401101401_4"],"voice_bank":"vo_event_11014","style":11,"background":1058,"log_type":1},{"step":5,"speaker":"克里斯蒂娜","content":"等不了了！","voice":["vo_event_401101401_5"],"voice_bank":"vo_event_11014","style":1,"background":1058,"log_type":1},{"step":6,"content":"她从一座垃圾山上一跃而下，脚一崴劈头盖脸滚了下来，来不及喊疼，又手脚并用地爬起来往前跑。","style":3,"background":1058,"log_type":1},{"step":7,"speaker":"克里斯蒂娜","content":"犯人确实先抓住了内森，但她没有立刻动手要人命。内森对应着花笺的第二句，按犯人计划他应该是第二个被“开花”的人。","voice":["vo_event_401101401_7"],"voice_bank":"vo_event_11014","style":1,"background":1058,"log_type":1},{"step":8,"speaker":"克里斯蒂娜","content":"万一还有救呢，万一我赶上了呢！要是来得及，他就不用死了！","voice":["vo_event_401101401_8"],"voice_bank":"vo_event_11014","style":1,"background":1058,"log_type":1},{"step":9,"speaker":"道尔","content":"可万一凶手也在现场——","voice":["vo_event_401101401_9"],"voice_bank":"vo_event_11014","style":11,"background":1058,"log_type":1},{"step":10,"content":"她最好在，克里斯还有很多话要对业师说。就算在这里碰不上，她也一定会追上去，一定要找到那个白发的禁闭者。","style":3,"background":1058,"log_type":1},{"step":11,"speaker":"克里斯蒂娜","content":"我找到了！","voice":["vo_event_401101401_10"],"voice_bank":"vo_event_11014","style":1,"background":1019,"log_type":1},{"step":12,"speaker":"克里斯蒂娜","content":"——？！","voice":["vo_event_401101401_11"],"voice_bank":"vo_event_11014","style":1,"background":1019,"log_type":1},{"step":13,"content":"克里斯握着电话的手剧烈颤抖着，被眼前景象震惊，懊恼、无力以及更深层的愤怒不断震动她的心。","style":3,"background":1019,"log_type":1},{"step":14,"speaker":"道尔","content":"喂？喂？丫头，你还好吗？说话啊！","voice":["vo_event_401101401_13"],"voice_bank":"vo_event_11014","style":11,"background":1019,"log_type":1},{"step":15,"speaker":"克里斯蒂娜","content":"探长……找到现场了。对不起，我来晚了。","voice":["vo_event_401101401_14"],"voice_bank":"vo_event_11014","style":1,"background":1019,"log_type":1},{"step":16,"content":"N.F. 113年8月9日 17:36\n锈河东岸\n“溃裂之墙”案发现场","style":12,"background":2119,"log_type":1},{"step":17,"speaker":"克里斯蒂娜","content":"花开得太厉害，这附近也很危险，让大家一定带好防护，最好叫上FAC。","voice":["vo_event_401101401_17"],"voice_bank":"vo_event_11014","style":1,"background":2119,"log_type":1},{"step":18,"speaker":"克里斯蒂娜","content":"在你们来之前，我会先对现场做初步调查……","voice":["vo_event_401101401_18"],"voice_bank":"vo_event_11014","style":1,"background":2119,"log_type":1},{"step":19,"content":"挂了电话后，克里斯深呼吸。刺眼的狂厄之花冲击她的神经，搅动过去混沌的记忆。克里斯必须努力控制一切可能出现的生理反应，她一定要克服障碍，不能倒在这里。","style":3,"background":2119,"log_type":1},{"step":20,"content":"逝者不可追，她没能挽救一个人的生命。那现在能做的，就是找到真相。","style":3,"background":2119,"log_type":1}]}