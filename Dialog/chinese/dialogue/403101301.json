{"id":403101301,"chapter_id":21000105,"scene_id":502,"steps":[{"step":1,"speaker":"拉格纳","content":"还没找到吗？","voice":["vo_event_403101301_1"],"voice_bank":"vo_event_31013","style":1,"background":2310,"log_type":1},{"step":2,"speaker":"戴尔","content":"没有……派尔琪雅，你那边呢？","voice":["vo_event_403101301_2"],"voice_bank":"vo_event_31013","style":11,"background":2310,"log_type":1},{"step":3,"content":"你们已经寻找了十几分钟，然而只在原本的指定位置找到寥寥几个采集器，其他的却已不见了踪影。","style":3,"background":2310,"log_type":1},{"step":4,"speaker":"派尔琪雅","content":"海底的地形变化提前了，上次标注的定位都找过，没有。","voice":["vo_event_403101301_4"],"voice_bank":"vo_event_31013","style":11,"background":2310,"log_type":1},{"step":5,"content":"通讯器里派尔琪雅的声音难得有了些起伏，听得出来，眼前的状况也已经脱离了她的掌控。","style":3,"background":2310,"log_type":1},{"step":6,"speaker":"派尔琪雅","content":"只剩下一个可能的区域……","voice":["vo_event_403101301_6"],"voice_bank":"vo_event_31013","style":11,"background":2310,"log_type":1},{"step":8,"content":"你们四个不约而同地看向眼前的巨大空洞。","style":3,"background":4384,"log_type":1},{"step":9,"content":"在过去的十几分钟里，你们一直默契地忽视了那个空洞。","style":3,"background":4384,"log_type":1},{"step":10,"content":"是个人都能感觉到那里面有什么东西，某种恐怖的存在，你们都不愿提起最坏的可能。","style":3,"background":4384,"log_type":1},{"step":11,"speaker":"派尔琪雅","content":"采集器，应该就在下面。","voice":["vo_event_403101301_10"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":12,"speaker":"戴尔","content":"呵呵……在“深渊”里啊……还真是棘手。","voice":["vo_event_403101301_11"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":13,"content":"深渊，这是你第一次从队员们口中听到这个巨大空洞的称呼。黑暗、冰冷、寂静，潜藏着莫大的危机，真是个再贴切不过的名字。","style":3,"background":2308,"log_type":1},{"step":14,"speaker":"派尔琪雅","content":"……回去吧。","voice":["vo_event_403101301_13"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":15,"speaker":"拉格纳","content":"回去？！","voice":["vo_event_403101301_14"],"voice_bank":"vo_event_31013","style":1,"background":2308,"log_type":1},{"step":16,"content":"面对派尔琪雅平静的话语，拉格纳的声音反而提高了一个八度。","style":3,"background":2308,"log_type":1},{"step":17,"speaker":"拉格纳","content":"不能回去！采集器可是深潜组的命根子！源津他们所有的研究都赌在上面了！","voice":["vo_event_403101301_16"],"voice_bank":"vo_event_31013","style":1,"background":2308,"log_type":1},{"step":18,"speaker":"派尔琪雅","content":"可是……","voice":["vo_event_403101301_17"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":19,"content":"派尔琪雅的声音有些犹豫。","style":3,"background":2308,"log_type":1},{"step":20,"speaker":"派尔琪雅","content":"我们还从未下潜探查过深渊，对里面的情况一无所知。","voice":["vo_event_403101301_19"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":21,"speaker":"派尔琪雅","content":"……我感觉得到，很危险。","voice":["vo_event_403101301_20"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":22,"content":"从这位“无畏到让人担忧”的潜水员口中听到“危险”二字之后，气氛变得更紧张了。","style":3,"background":2308,"log_type":1},{"step":23,"speaker":"派尔琪雅","content":"或许……等到下一次潮汐，地形再次变动，采集器会回到深渊之上，那时候……","voice":["vo_event_403101301_22"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":24,"speaker":"戴尔","content":"概率太低了，我们赌不起。","voice":["vo_event_403101301_23"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":25,"content":"无线电里传来戴尔有些沙哑的声音。","style":3,"background":2308,"log_type":1},{"step":26,"speaker":"戴尔","content":"物资很紧张，技术组不可能再给我们造一批采集器了。","voice":["vo_event_403101301_25"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":27,"speaker":"拉格纳","content":"是啊，怎么能眼睁睁看着大伙半年来的努力就这么白费呢……","voice":["vo_event_403101301_26"],"voice_bank":"vo_event_31013","style":1,"background":2308,"log_type":1},{"step":28,"speaker":"派尔琪雅","content":"……","voice":["vo_event_403101301_27"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":29,"speaker":"派尔琪雅","content":"那我去吧。","voice":["vo_event_403101301_28"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":30,"content":"派尔琪雅顿了顿，像是在坚定某种想法。","style":3,"background":2308,"log_type":1},{"step":31,"speaker":"派尔琪雅","content":"我一个人去就好。你们先把现有的这几个带回去。","voice":["vo_event_403101301_30"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":32,"speaker":"拉格纳","content":"那绝对不行！怎么能让你一个人下去！","voice":["vo_event_403101301_31"],"voice_bank":"vo_event_31013","style":1,"background":2308,"log_type":1},{"step":33,"speaker":"派尔琪雅","content":"……","voice":["vo_event_403101301_32"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":34,"speaker":"拉格纳","content":"我干这行大半辈子了，怎么能让一个小姑娘独自下魔窟。不就是个海坑吗，咱们一起去。","voice":["vo_event_403101301_33"],"voice_bank":"vo_event_31013","style":1,"background":2308,"log_type":1},{"step":35,"speaker":"派尔琪雅","content":"可是……","voice":["vo_event_403101301_34"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":36,"speaker":"戴尔","content":"我们相信你的直觉和能力。可单凭你一个人，不可能把采集器都带上来。就算是你，也需要同伴的帮助。","voice":["vo_event_403101301_35"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":37,"speaker":"派尔琪雅","content":"……","voice":["vo_event_403101301_36"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1},{"step":38,"content":"良久，你听到无线电里传来轻轻的叹息。","style":3,"background":2308,"log_type":1},{"step":39,"speaker":"派尔琪雅","content":"遇到异常，就返回，不要勉强……","voice":["vo_event_403101301_38"],"voice_bank":"vo_event_31013","style":11,"background":2308,"log_type":1}]}