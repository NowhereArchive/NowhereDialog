{"id":1040604,"chapter_id":1040604,"scene_id":1,"steps":[{"step":1,"content":"<size=45>——第三幕·未来——</size>","style":14,"background":10000,"is_centered":true,"log_type":1,"src_id":140604001,"trial_step":1},{"step":2,"content":"巨大的裙摆笼罩在舞台上方，即将吞噬所有被丝线牵扯的演员。","style":3,"background":2173,"log_type":1,"src_id":140604002,"trial_step":2},{"step":3,"content":"其他幻影在不知不觉中早已消失，只剩你和珀尔夫人。","style":3,"background":2173,"log_type":1,"src_id":140604003,"trial_step":3},{"step":4,"options":["你离不开福尔图娜"],"style":6,"background":2173,"log_type":1,"src_id":140604004,"trial_step":4,"course":3,"choices":[{"text":"你离不开福尔图娜","goto":5}]},{"step":5,"speaker":"${PlayerName}","content":"……我没想到，最走不出这里的人是你。","style":2,"background":2173,"log_type":1,"src_id":140604005,"trial_step":5},{"step":6,"content":"你看到无数丝线从高处垂落，密密麻麻地连接在珀尔身上各处。","style":3,"background":2173,"log_type":1,"src_id":140604006,"trial_step":6},{"step":7,"content":"福尔图娜是珀尔夫人选择的“美梦”，她早就被无数丝线捆绑，无法离开这里。","style":3,"background":2173,"log_type":1,"src_id":140604007,"trial_step":7},{"step":8,"speaker":"珀尔夫人","content":"如果每场演出都如眼下这般精彩，我当然愿意永远留在这。","voice":["vo_trial_40604_1_8"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140604008,"trial_step":8},{"step":9,"speaker":"珀尔夫人","content":"我希望你也能留下，成为我剧院中最优秀的演员……","voice":["vo_trial_40604_1_9"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140604009,"trial_step":9},{"step":10,"content":"她不紧不慢地看着你，嘴角还挂着轻松的笑容。","style":3,"background":2173,"log_type":1,"src_id":140604010,"trial_step":10},{"step":11,"speaker":"珀尔夫人","content":"但你应该更喜欢自己选择结局。","voice":["vo_trial_40604_1_11"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140604011,"trial_step":11},{"step":12,"content":"随着她扬手，你感觉自己的手臂也被丝线牵起，剑尖直指珀尔夫人。","style":3,"background":2173,"log_type":1,"src_id":140604012,"trial_step":12},{"step":13,"speaker":"珀尔夫人","content":"斩断所有命运、重定剧本……英雄的弧光还差最后一步。","voice":["vo_trial_40604_1_13"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140604013,"trial_step":13},{"step":14,"speaker":"珀尔夫人","content":"是扔下这座舞台，封锁剧院与无法离开此处的禁闭者……","voice":["vo_trial_40604_1_14"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140604014,"trial_step":14},{"step":15,"speaker":"珀尔夫人","content":"或者在此战胜“我”，把我带走。","voice":["vo_trial_40604_1_15"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140604015,"trial_step":15},{"step":16,"speaker":"珀尔夫人","content":"${PlayerName}，你想好了吗？","voice":["vo_trial_40604_1_16"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140604016,"trial_step":16},{"step":17,"content":"金发女人眼中闪着灼热的光，你熟悉的疯狂在其中涌动。","style":3,"background":2173,"log_type":1,"src_id":140604017,"trial_step":17},{"step":18,"content":"你必须给出选择——就此离场，还是继续在舞台上战斗？","style":3,"background":2173,"log_type":1,"src_id":140604018,"trial_step":18},{"step":19,"options":["继续饰演","拒绝饰演"],"style":6,"background":2173,"log_type":1,"src_id":140604019,"trial_step":19,"course":3,"choices":[{"text":"继续饰演","goto":20},{"text":"拒绝饰演","goto":31}]},{"step":20,"content":"在答案脱口而出的瞬间，银白色的剑光划过，你用长剑切断了身上的桎梏。","style":3,"background":2173,"log_type":1,"src_id":140604020,"trial_step":20},{"step":21,"speaker":"${PlayerName}","content":"这剑挺好使，再借我用一次吧。","style":2,"background":2173,"log_type":1,"src_id":140604021,"trial_step":21},{"step":22,"content":"你提起长剑，再次挥向珀尔头顶的丝线。舞者似乎察觉到异动，幕布式的裙摆摇摆下落，势要遮住下方的珀尔夫人。","style":3,"background":2173,"log_type":1,"src_id":140604022,"trial_step":22},{"step":23,"content":"银光落下，裙摆被割为两截，你离珀尔的距离越来越近。","style":3,"background":2173,"log_type":1,"src_id":140604023,"trial_step":23},{"step":24,"content":"“唰——”银白色的长剑深深没入舞者的胸口。","style":3,"background":2173,"log_type":1,"src_id":140604024,"trial_step":24},{"step":25,"speaker":"命运抉择","content":"如此美丽的身姿……","voice":["vo_trial_40604_1_25"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140604025,"trial_step":25},{"step":26,"speaker":"命运抉择","content":"这……就是我一直渴求的……","voice":["vo_trial_40604_1_26"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140604026,"trial_step":26},{"step":27,"speaker":"${PlayerName}","content":"台词念完了？那就该退场了！","style":2,"background":2173,"log_type":1,"src_id":140604027,"trial_step":27},{"step":28,"content":"刀锋向下，彻底斩断连接珀尔与舞者的所有丝线。下一个瞬间，你脚下一空，舞台开始崩塌——你知道，幻境开始消失，这幕戏要结束了。","style":3,"background":2173,"log_type":1,"src_id":140604028,"trial_step":28},{"step":29,"content":"你试图抓住什么，却不可避免地向舞台深处坠落。","style":3,"background":2173,"log_type":1,"src_id":140604029,"trial_step":29},{"step":30,"content":"在失去意识的前一秒，一只手抓住了你。","style":3,"background":2173,"log_type":1,"src_id":140604030,"trial_step":30,"next":[44]},{"step":31,"content":"你将银剑举至身前。哐当，它落在地上。","style":3,"background":2173,"log_type":1,"src_id":140604031,"trial_step":31},{"step":32,"speaker":"${PlayerName}","content":"比起这把剑，我还有更顺手的武器。","style":2,"background":2173,"log_type":1,"src_id":140604032,"trial_step":32},{"step":33,"content":"枷锁迸发，尖刺从你与珀尔身上蔓延生长，迅速攀上那些阻碍你的丝线。你以枷锁拉扯丝线，挣扎向前走去。","style":3,"background":2173,"log_type":1,"src_id":140604033,"trial_step":33},{"step":34,"content":"舞者似乎察觉到异动，幕布式的裙摆摇摆旋转，似乎要拉断你与珀尔间的枷锁。","style":3,"background":2173,"log_type":1,"src_id":140604034,"trial_step":34},{"step":35,"speaker":"${PlayerName}","content":"比起演员，我更愿意当破坏舞台的捣乱分子。","style":2,"background":2173,"log_type":1,"src_id":140604035,"trial_step":35},{"step":36,"speaker":"${PlayerName}","content":"来吧！","style":2,"background":2173,"log_type":1,"src_id":140604036,"trial_step":36},{"step":37,"content":"枷锁再次爆发，深深埋入舞者的胸口。枷锁与丝线角力，将你和珀尔层层包裹其中，左右拉扯——","style":3,"background":2173,"log_type":1,"src_id":140604037,"trial_step":37},{"step":38,"content":"嘭。你听到某根线断裂的声音。紧接着声音连接成片。","style":3,"background":2173,"log_type":1,"src_id":140604038,"trial_step":38},{"step":39,"speaker":"命运抉择","content":"如此美丽的身姿……","voice":["vo_trial_40604_1_39"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140604039,"trial_step":39},{"step":40,"speaker":"命运抉择","content":"这……就是我一直渴求的……","voice":["vo_trial_40604_1_40"],"voice_bank":"vo_pearl_trial","style":1,"background":2173,"log_type":1,"src_id":140604040,"trial_step":40},{"step":41,"content":"混乱中你看不清舞台，但脚下的地面开始崩塌——你知道，幻境开始消失，这幕戏要结束了。","style":3,"background":2173,"log_type":1,"src_id":140604041,"trial_step":41},{"step":42,"content":"你试图抓住什么，却不可避免地向舞台深处坠落。","style":3,"background":2173,"log_type":1,"src_id":140604042,"trial_step":42},{"step":43,"content":"在失去意识的前一秒，一只手抓住了你。","style":3,"background":2173,"log_type":1,"src_id":140604043,"trial_step":43},{"step":44,"content":"意识模糊，你隐约感觉有人牵着你向前走。","style":3,"background":10000,"log_type":1,"src_id":140604045,"trial_step":45},{"step":45,"content":"音乐与歌舞声自某处传来。她为你撩开面前的帐帘，欢闹的声音就突然大了起来。","style":3,"background":10000,"log_type":1,"src_id":140604046,"trial_step":46},{"step":46,"speaker":"？？","content":"好了，亲爱的，我们到了。","voice":["vo_trial_40604_1_47"],"voice_bank":"vo_pearl_trial","style":1,"background":10000,"log_type":1,"src_id":140604047,"trial_step":47},{"step":47,"speaker":"？？","content":"睁眼吧。","voice":["vo_trial_40604_1_48"],"voice_bank":"vo_pearl_trial","style":1,"background":10000,"log_type":1,"src_id":140604048,"trial_step":48},{"step":48,"content":"你正站在某座帐篷的最角落。在你的前方，一群身着滑稽戏服的演员正在舞台中心摆着夸张的动作。","style":3,"background":2011,"log_type":1,"src_id":140604049,"trial_step":49},{"step":49,"speaker":"舞台上的演员","content":"来吧，让音乐奏响！让人们安眠在柔软梦乡——","voice":["vo_trial_40604_1_50"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604050,"trial_step":50},{"step":50,"speaker":"舞台上的演员","content":"来吧，让音乐奏响！让舞蹈轻摇熟睡者的小床——","voice":["vo_trial_40604_1_51"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604051,"trial_step":51},{"step":51,"content":"某人将自己扮为一国之主，是仙林的王后；他们的神情骄傲，高贵，优雅，不顾一切地在舞台上唱着，跳着，放肆歌舞。","style":3,"background":2011,"log_type":1,"src_id":140604052,"trial_step":52},{"step":52,"content":"舞台简陋、戏服陈旧——但你能感受到舞台上喷薄欲出的真诚与热情，让你也不禁沉沦在他们的表演中。","style":3,"background":2011,"log_type":1,"src_id":140604053,"trial_step":53},{"step":53,"content":"直到谢幕时你才恍然惊醒。","style":3,"background":2011,"log_type":1,"src_id":140604054,"trial_step":54},{"step":54,"speaker":"珀尔夫人","content":"怎么样，好看吗？","voice":["vo_trial_40604_1_55"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604055,"trial_step":55},{"step":55,"content":"珀尔夫人一直站在你身边，笑着望向舞台。","style":3,"background":2011,"log_type":1,"src_id":140604056,"trial_step":56},{"step":56,"options":["这是哪儿？"],"style":6,"background":2011,"log_type":1,"src_id":140604057,"trial_step":57,"course":3,"choices":[{"text":"这是哪儿？","goto":58}]},{"step":57,"speaker":"珀尔夫人","content":"这是最初的福尔图娜，是我看的第一场戏。","voice":["vo_trial_40604_1_58"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604058,"trial_step":58},{"step":58,"content":"演员们此时已经将角色的假面摘下，热情地拥抱着前排稀稀拉拉的客人。","style":3,"background":2011,"log_type":1,"src_id":140604059,"trial_step":59},{"step":59,"content":"你看见他们的脸——有的看着很眼熟，你在那晚的表演中也见过。","style":3,"background":2011,"log_type":1,"src_id":140604060,"trial_step":60},{"step":60,"speaker":"珀尔夫人","content":"那会儿我刚出来自己单干，年轻气盛，讨厌人和人之间的虚与委蛇，却又想不清自己想要什么。","voice":["vo_trial_40604_1_61"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604061,"trial_step":61},{"step":61,"speaker":"珀尔夫人","content":"……直到某天，我走进这顶帐篷。","voice":["vo_trial_40604_1_62"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604062,"trial_step":62},{"step":62,"speaker":"珀尔夫人","content":"他们演得真诚、演得投入，明明是虚假的角色，却比这座城市的任何人都要沉浸……","voice":["vo_trial_40604_1_63"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604063,"trial_step":63},{"step":63,"speaker":"珀尔夫人","content":"这就是我想要的。","voice":["vo_trial_40604_1_64"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604064,"trial_step":64},{"step":64,"content":"你与珀尔夫人藏在阴影处，如局外人一样围观这场热闹的谢幕。","style":3,"background":2011,"log_type":1,"src_id":140604065,"trial_step":65},{"step":65,"speaker":"${PlayerName}","content":"所以你最后自己接手了福尔图娜。","style":2,"background":2011,"log_type":1,"src_id":140604066,"trial_step":66},{"step":66,"speaker":"珀尔夫人","content":"因为舍不得啊~","voice":["vo_trial_40604_1_67"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604067,"trial_step":67},{"step":67,"speaker":"珀尔夫人","content":"看过最好的表演，才会忍不住想留下它，想要一遍遍再次体验观演时的震撼与心跳。","voice":["vo_trial_40604_1_68"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604068,"trial_step":68},{"step":68,"speaker":"珀尔夫人","content":"只可惜，好戏难得。","voice":["vo_trial_40604_1_69"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604069,"trial_step":69},{"step":69,"options":["那你现在满足了吗？"],"style":6,"background":2011,"log_type":1,"src_id":140604070,"trial_step":70,"course":3,"choices":[{"text":"那你现在满足了吗？","goto":71}]},{"step":70,"speaker":"${PlayerName}","content":"那今天的演出让你满意了吗？","style":2,"background":2011,"log_type":1,"src_id":140604071,"trial_step":71},{"step":71,"speaker":"珀尔夫人","content":"嗯……","voice":["vo_trial_40604_1_72"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604072,"trial_step":72},{"step":72,"content":"她没有直接回答，反而把问题抛回给你。","style":3,"background":2011,"log_type":1,"src_id":140604073,"trial_step":73},{"step":73,"speaker":"珀尔夫人","content":"你呢，喜欢这场演出吗？","voice":["vo_trial_40604_1_74"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604074,"trial_step":74},{"step":74,"options":["太危险了","不够刺激"],"style":6,"background":2011,"log_type":1,"src_id":140604075,"trial_step":75,"course":3,"choices":[{"text":"太危险了","goto":76},{"text":"不够刺激","goto":77}]},{"step":75,"speaker":"${PlayerName}","content":"还不错，就是危险系数太高。","style":2,"background":2011,"log_type":1,"src_id":140604076,"trial_step":76,"next":[78]},{"step":76,"speaker":"${PlayerName}","content":"不如我在外面的“冒险”刺激。","style":2,"background":2011,"log_type":1,"src_id":140604077,"trial_step":77},{"step":77,"speaker":"珀尔夫人","content":"哈哈~不愧是我钦定的主演~","voice":["vo_trial_40604_1_78"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604078,"trial_step":78},{"step":78,"speaker":"珀尔夫人","content":"也是，你从没让我失望过。","voice":["vo_trial_40604_1_79"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604079,"trial_step":79},{"step":79,"speaker":"珀尔夫人","content":"你是个优秀的孩子。如此优秀，甚至让我觉得仅把你困在剧场中是一种浪费。","voice":["vo_trial_40604_1_80"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604080,"trial_step":80},{"step":80,"speaker":"珀尔夫人","content":"这出戏本该停在谢幕，但……我突然有点舍不得让它结束了。","voice":["vo_trial_40604_1_81"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604081,"trial_step":81},{"step":81,"content":"剧场中洒下无数闪片，细碎地反射着光。你借此看清了珀尔夫人的表情——不知何时，她转头望向你，笑容如此温柔。","style":3,"background":2011,"log_type":1,"src_id":140604082,"trial_step":82},{"step":82,"speaker":"${PlayerName}","content":"那就跟我一起走吧。","style":2,"background":2011,"log_type":1,"src_id":140604083,"trial_step":83},{"step":83,"speaker":"${PlayerName}","content":"既然这么看好我，不如跟我一起出去看看。我有比这些都精彩一万倍的故事。","style":2,"background":2011,"log_type":1,"src_id":140604084,"trial_step":84},{"step":84,"speaker":"${PlayerName}","content":"就像当初的福尔图娜一样——这才是最一本万利的<color=#fb9259>投资</color>。","style":2,"background":2011,"log_type":1,"src_id":140604085,"trial_step":85},{"step":85,"content":"金色卷发的女人将视线重新投回舞台。剧场中响起告别的萨克斯曲，但这次旋律并不忧伤，反而像是某种新篇章的启程。","style":3,"background":2011,"log_type":1,"src_id":140604086,"trial_step":86},{"step":86,"content":"片刻后，珀尔夫人慢慢开口。","style":3,"background":2011,"log_type":1,"src_id":140604087,"trial_step":87},{"step":87,"speaker":"珀尔夫人","content":"……听上去不错。","voice":["vo_trial_40604_1_88"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604088,"trial_step":88},{"step":88,"speaker":"珀尔夫人","content":"我很满意今晚的演出，如交易最初约定的那样，我愿意来到你身边，将福尔图娜交给你……","voice":["vo_trial_40604_1_89"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604089,"trial_step":89},{"step":89,"speaker":"珀尔夫人","content":"见证你的选择、挣扎……见证你的结局。","voice":["vo_trial_40604_1_90"],"voice_bank":"vo_pearl_trial","style":1,"background":2011,"log_type":1,"src_id":140604090,"trial_step":90},{"step":90,"content":"你们二人手指交叠的地方红光闪动，契约正式结成。","style":3,"background":2011,"log_type":1,"src_id":140604091,"trial_step":91},{"step":91,"speaker":"${PlayerName}","content":"……放心，绝对不会让你无聊的。","style":2,"background":2011,"log_type":1,"src_id":140604092,"trial_step":92},{"step":92,"content":"▉编号：MBCC-S-033\n▉档案：福尔图娜事件后续监管记录","style":12,"background":10000,"log_type":1,"src_id":140604094,"trial_step":94},{"step":93,"content":"收容行动结束后，禁闭者珀尔夫人自愿与局长回到MBCC，并接受了最深程度枷锁。\n\n监察期限中，对象表现无异常，并未再进行任何戏剧相关的创意活动。\n\n与管理局中禁闭者关系良好。偶尔会观察到对象近乎“调戏”的举动，但本人称其为邀请演员。\n此外并无任何越轨过激行为。\n\n\n判断：禁闭者珀尔夫人威胁性低，符合《禁闭者自由保释规则》部分条例，予以外出自由。","style":10,"background":10000,"log_type":1,"src_id":140604095,"trial_step":95},{"step":94,"content":"福尔图娜剧院由MBCC正式接手。\n\n在排除室内所有狂厄污染后，剧场再次投入使用。","style":10,"background":10000,"log_type":1,"src_id":140604096,"trial_step":96},{"step":95,"content":"*附录：\n剧团长珀尔夫人离开后，剩下的成员自发集结组成了一支新剧团，并继续在福尔图娜中进行表演活动。\n\n剧团会定期向禁闭者珀尔夫人寄送演出票。对象偶尔会前往福尔图娜，于开演后默默入场，谢幕前离开。\n\n局长${PlayerName}判断此类行为无危害，允以继续。","style":10,"background":10000,"log_type":1,"src_id":140604097,"trial_step":97},{"step":96,"content":"一个月后\n夜晚9点46分\n福尔图娜剧院内","style":12,"background":2172,"log_type":1,"src_id":140604099,"trial_step":99},{"step":97,"content":"剧院内座无虚席，故事正值结尾，所有观众的目光都聚焦在舞台上。","style":3,"background":2172,"log_type":1,"src_id":140604100,"trial_step":100},{"step":98,"content":"戴宽檐帽的女人单独坐在观众席的最后一排，看得不算认真，手指在扶手上轻轻敲打。","style":3,"background":2172,"log_type":1,"src_id":140604101,"trial_step":101},{"step":99,"content":"有人趁着昏暗的灯光坐在她身边。","style":3,"background":2172,"log_type":1,"src_id":140604102,"trial_step":102},{"step":100,"speaker":"${PlayerName}","content":"嘘……我来晚了，现在演到哪里了？","style":2,"background":2172,"log_type":1,"src_id":140604103,"trial_step":103},{"step":101,"speaker":"珀尔夫人","content":"嗯……男主角刚经历过一番生死离别，最终不畏黑暗打倒强敌，与自己在旅途上结识的一百零八个伙伴过上了幸福圆满的生活。","female_content":"嗯……女主角刚经历过一番生死离别，最终不畏黑暗打倒强敌，与自己在旅途上结识的一百零八个伙伴过上了幸福圆满的生活。","voice":["vo_trial_40604_1_104","vo_trial_40604_1_104f"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604104,"trial_step":104},{"step":102,"options":["听起来好俗套","听起来好奇怪"],"style":6,"background":2172,"log_type":1,"src_id":140604105,"trial_step":105,"course":3,"choices":[{"text":"听起来好俗套","goto":106},{"text":"听起来好奇怪","goto":107}]},{"step":103,"speaker":"${PlayerName}","content":"好俗套的故事……演得真是这个？","style":2,"background":2172,"log_type":1,"src_id":140604106,"trial_step":106,"next":[108]},{"step":104,"speaker":"${PlayerName}","content":"好奇怪的故事……演得真是这个？","style":2,"background":2172,"log_type":1,"src_id":140604107,"trial_step":107},{"step":105,"speaker":"珀尔夫人","content":"当然是逗你的，还没演到最后呢。","voice":["vo_trial_40604_1_108"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604108,"trial_step":108},{"step":106,"speaker":"${PlayerName}","content":"这么说我至少赶上了结局。","style":2,"background":2172,"log_type":1,"src_id":140604109,"trial_step":109},{"step":107,"content":"话音未落，珀尔夫人身侧传来细小的震动声。这位刚赶来的观众拿起终端机，又不得不再次起身。","style":3,"background":2172,"log_type":1,"src_id":140604110,"trial_step":110},{"step":108,"speaker":"${PlayerName}","content":"……抱歉，管理局有急事，我……","style":2,"background":2172,"log_type":1,"src_id":140604111,"trial_step":111},{"step":109,"speaker":"珀尔夫人","content":"回去吧。放心，我会回来给你转述结局的。","voice":["vo_trial_40604_1_112"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604112,"trial_step":112},{"step":110,"content":"迟到的观众匆匆离开。此时故事刚好位于结尾的高潮段落，演员嘶声裂肺的呐喊遮盖了离场的脚步声。","style":3,"background":2172,"log_type":1,"src_id":140604113,"trial_step":113},{"step":111,"content":"女人继续看着舞台。片刻后，突然低头。","style":3,"background":2172,"log_type":1,"src_id":140604114,"trial_step":114},{"step":112,"speaker":"珀尔夫人","content":"……噗。","voice":["vo_trial_40604_1_115"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604115,"trial_step":115},{"step":113,"speaker":"珀尔夫人","content":"呵呵……","voice":["vo_trial_40604_1_116"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604116,"trial_step":116},{"step":114,"content":"珀尔夫人低笑出声。","style":3,"background":2172,"log_type":1,"src_id":140604117,"trial_step":117},{"step":115,"speaker":"珀尔夫人","content":"${PlayerName}，我可爱、正直又天真的孩子……","voice":["vo_trial_40604_1_118"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604118,"trial_step":118},{"step":116,"content":"珀尔夫人不自觉地摩梭手腕：那里曾印下你的烙痕。这是她的枷锁，也是她踏入新“剧场”的入场券。","style":3,"background":2172,"log_type":1,"src_id":140604119,"trial_step":119},{"step":117,"speaker":"珀尔夫人","content":"好久没这么做生意，差点以为自己手生了，但结果还不错。","voice":["vo_trial_40604_1_120"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604120,"trial_step":120},{"step":118,"speaker":"珀尔夫人","content":"虽然是以自己为饵，但很值得。他足够优秀，不愧是我亲自挑选的“主角”……","female_content":"虽然是以自己为饵……但很值得。她足够优秀，不愧是我亲自挑选的“主角”……","voice":["vo_trial_40604_1_121","vo_trial_40604_1_121f"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604121,"trial_step":121},{"step":119,"speaker":"珀尔夫人","content":"<i>辛迪加动乱已经结束，但明眼人都能看出狄斯将迎来一场剧变。</i>","voice":["vo_trial_40604_1_122"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604122,"trial_step":122},{"step":120,"speaker":"珀尔夫人","content":"<i>市议会、西区、FAC，还有那个不可言说的上庭……这些势力都将入场，在新舞台上展开博弈。</i>","voice":["vo_trial_40604_1_123"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604123,"trial_step":123},{"step":121,"speaker":"珀尔夫人","content":"<i>狄斯就是个好戏即将上演的大剧场，只是这次——观众席也被涵括在舞台之上。</i>","voice":["vo_trial_40604_1_124"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604124,"trial_step":124},{"step":122,"speaker":"珀尔夫人","content":"……最真实的感动，取材于最真实的故事。要想观察表演，就必须深入舞台。","voice":["vo_trial_40604_1_125"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604125,"trial_step":125},{"step":123,"speaker":"珀尔夫人","content":"看，我已经为自己找好了最佳的观众席位。","voice":["vo_trial_40604_1_126"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604126,"trial_step":126},{"step":124,"content":"演出结束，所有演员涌上舞台进行最后的谢幕。观众起立，为今晚的演出献上掌声。气氛一如她第一次踏入福尔图娜那晚——","style":3,"background":2172,"log_type":1,"src_id":140604127,"trial_step":127},{"step":125,"content":"热烈、真诚，让心脏狂跳不已。","style":3,"background":2172,"log_type":1,"src_id":140604128,"trial_step":128},{"step":126,"content":"女人也跟着慢慢起身，优雅地向舞台致敬。","style":3,"background":2172,"log_type":1,"src_id":140604129,"trial_step":129},{"step":127,"speaker":"珀尔夫人","content":"我最最期待的新章节就要开演了……这次演出没有时限，谢幕就意味着完结。","voice":["vo_trial_40604_1_130"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604130,"trial_step":130},{"step":128,"speaker":"珀尔夫人","content":"我可是把所有本钱都给你了，${PlayerName}。","voice":["vo_trial_40604_1_131"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604131,"trial_step":131},{"step":129,"speaker":"珀尔夫人","content":"你可千万、千万别让我失望呀。","voice":["vo_trial_40604_1_132"],"voice_bank":"vo_pearl_trial","style":1,"background":2172,"log_type":1,"src_id":140604132,"trial_step":132}]}