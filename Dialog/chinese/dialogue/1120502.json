{"id":1120502,"chapter_id":1120502,"scene_id":1,"steps":[{"step":1,"content":"你们守在这里。","style":2,"background":121,"log_type":1,"src_id":220502001,"trial_step":1},{"step":2,"content":"在上一个据点，海拉和军团的人发生了些口角。把她留在这里盯梢显然是更好的选择。","style":3,"background":121,"log_type":1,"src_id":220502002,"trial_step":2},{"step":3,"speaker":"海拉","content":"说得跟谁稀罕进去似的。","style":1,"background":121,"log_type":1,"src_id":220502003,"trial_step":3},{"step":4,"content":"海拉撇撇嘴，但也还是乖乖留在了原地。","style":3,"background":121,"log_type":1,"src_id":220502004,"trial_step":4},{"step":5,"content":"你和赫罗走进建筑的入口，军团据点的内景呈现在你眼前。","style":3,"background":120,"log_type":1,"src_id":220502005,"trial_step":5},{"step":6,"content":"一如既往的钢铁与水泥，符合军团的风格。","style":3,"background":120,"log_type":1,"src_id":220502006,"trial_step":6},{"step":7,"content":"只不过这栋建筑有些老旧。","style":3,"background":120,"log_type":1,"src_id":220502007,"trial_step":7},{"step":8,"speaker":"蓝尼","content":"赫罗？你怎么也跟来了？","style":1,"background":120,"log_type":1,"src_id":220502008,"trial_step":8},{"step":9,"speaker":"赫罗","content":"蓝尼，情况怎么样了？","style":1,"background":120,"log_type":1,"src_id":220502009,"trial_step":9},{"step":10,"speaker":"蓝尼","content":"情况？哦，你说治安局那群废物啊。","style":1,"background":120,"log_type":1,"src_id":220502010,"trial_step":10},{"step":11,"speaker":"蓝尼","content":"被打跑了，这几天都没有据点遇袭，估计是怕了。","style":1,"background":120,"log_type":1,"src_id":220502011,"trial_step":11},{"step":12,"speaker":"蓝尼","content":"找咱们军团的麻烦，也不掂掂自己的斤两。","style":1,"background":120,"log_type":1,"src_id":220502012,"trial_step":12},{"step":13,"content":"他说话时一副满不在乎的样子，可身上的大大小小的伤疤却总让人觉得他在逞强。","style":3,"background":120,"log_type":1,"src_id":220502013,"trial_step":13},{"step":14,"speaker":"老杰","content":"……过来！","style":1,"background":120,"log_type":1,"src_id":220502014,"trial_step":14},{"step":15,"content":"另一个军团成员——似乎是叫老杰的家伙将你拉到一边。","style":3,"background":120,"log_type":1,"src_id":220502015,"trial_step":15},{"step":16,"speaker":"老杰","content":"你怎么把赫罗带来了？不是让你保护她的吗？","style":1,"background":120,"log_type":1,"src_id":220502016,"trial_step":16},{"step":17,"content":"如你所见，我正在保护她。","style":2,"background":120,"log_type":1,"src_id":220502017,"trial_step":17},{"step":18,"speaker":"老杰","content":"保护她你还把她带回辛迪加趟这浑水？你忘了你承诺过卓娅老大了吗？！","style":1,"background":120,"log_type":1,"src_id":220502018,"trial_step":18},{"step":19,"content":"这是我和赫罗共同的判断。","style":2,"background":120,"log_type":1,"src_id":220502019,"trial_step":19},{"step":20,"content":"我们正在寻找厄尔希留下的情报。","style":2,"background":120,"log_type":1,"src_id":220502020,"trial_step":20},{"step":21,"content":"听到厄尔希的名字，老杰的面色沉了下去。","style":3,"background":120,"log_type":1,"src_id":220502021,"trial_step":21},{"step":22,"content":"只要能找到正确的情报，第九机关就有借口下场，清除治安局残留的党羽。","style":2,"background":120,"log_type":1,"src_id":220502022,"trial_step":22},{"step":23,"content":"赫罗的安全问题，以及你们军团面对的威胁，都能被一次性解决。","style":2,"background":120,"log_type":1,"src_id":220502023,"trial_step":23},{"step":24,"speaker":"老杰","content":"少给我来这套！除了你，新城的狗腿子我一个也不信！","style":1,"background":120,"log_type":1,"src_id":220502024,"trial_step":24},{"step":25,"content":"军团成员骤然提高的音量引得赫罗侧目。老杰不得不再次压低声音。","style":3,"background":120,"log_type":1,"src_id":220502025,"trial_step":25},{"step":26,"speaker":"老杰","content":"算了，至少我相信赫罗。这俩小崽子……是我看着长大的。","style":1,"background":120,"log_type":1,"src_id":220502026,"trial_step":26},{"step":27,"speaker":"老杰","content":"厄尔希的房间在301，但他留在这里的东西不多，你们自己找吧。","style":1,"background":120,"log_type":1,"src_id":220502027,"trial_step":27},{"step":28,"content":"你们一行人进入了301房间。可经过十几分钟的搜寻，你发现这里并没有你们想要的东西。","style":3,"background":120,"log_type":1,"src_id":220502028,"trial_step":28},{"step":29,"content":"……也不在这里。","style":2,"background":120,"log_type":1,"src_id":220502029,"trial_step":29},{"step":30,"content":"赫罗紧缩眉头，思索着更多可能。","style":3,"background":120,"log_type":1,"src_id":220502030,"trial_step":30},{"step":31,"content":"之前提到的军团据点我们都已经去过一遍了，情报还能藏在哪里？","style":2,"background":120,"log_type":1,"src_id":220502031,"trial_step":31},{"step":32,"speaker":"赫罗","content":"……只剩下拖车场了。","style":1,"background":120,"log_type":1,"src_id":220502032,"trial_step":32},{"step":33,"speaker":"蓝尼","content":"拖车场？那里不是早就被废弃了吗？","style":1,"background":120,"log_type":1,"src_id":220502033,"trial_step":33},{"step":34,"speaker":"赫罗","content":"运输队离开后，我和厄尔希继续在那里住了两年。","style":1,"background":120,"log_type":1,"src_id":220502034,"trial_step":34},{"step":35,"speaker":"赫罗","content":"发生了一些……误会之后，我就没再回去过。但厄尔希还时不时会去那里。","style":1,"background":120,"log_type":1,"src_id":220502035,"trial_step":35},{"step":36,"content":"那里很隐蔽吗？","style":2,"background":120,"log_type":1,"src_id":220502036,"trial_step":36},{"step":37,"speaker":"赫罗","content":"还行，毕竟值钱的东西早就被拿走了，现在几乎没人会去那里。","style":1,"background":120,"log_type":1,"src_id":220502037,"trial_step":37},{"step":38,"content":"很适合作为秘密据点，不是吗？","style":2,"background":120,"log_type":1,"src_id":220502038,"trial_step":38},{"step":39,"content":"赫罗点了点头。","style":3,"background":120,"log_type":1,"src_id":220502039,"trial_step":39},{"step":40,"content":"事不宜迟，赶紧出发吧。","style":2,"background":120,"log_type":1,"src_id":220502040,"trial_step":40},{"step":41,"speaker":"赫罗","content":"好。","style":1,"background":120,"log_type":1,"src_id":220502041,"trial_step":41},{"step":42,"speaker":"老杰","content":"等等。","style":1,"background":120,"log_type":1,"src_id":220502042,"trial_step":42},{"step":43,"speaker":"赫罗","content":"老杰？","style":1,"background":120,"log_type":1,"src_id":220502043,"trial_step":43},{"step":44,"speaker":"老杰","content":"你们在辛迪加晃悠大半天了，难保不被什么眼线盯上。","style":1,"background":120,"log_type":1,"src_id":220502044,"trial_step":44},{"step":45,"speaker":"老杰","content":"蓝尼，丹尼，凯文，过来，我们一起去。","style":1,"background":120,"log_type":1,"src_id":220502045,"trial_step":45},{"step":46,"speaker":"赫罗","content":"据点的防守怎么办？","style":1,"background":120,"log_type":1,"src_id":220502046,"trial_step":46},{"step":47,"speaker":"老杰","content":"几天没有进攻了。这里到旧拖车场也就20分钟脚程，不至于这么倒霉。","style":1,"background":120,"log_type":1,"src_id":220502047,"trial_step":47},{"step":48,"speaker":"老杰","content":"而且他们的目标归根结底还是你。我不放心……","style":1,"background":120,"log_type":1,"src_id":220502048,"trial_step":48},{"step":49,"content":"老杰看向赫罗，眼中满是关切。","style":3,"background":120,"log_type":1,"src_id":220502049,"trial_step":49},{"step":50,"content":"赫罗又看向你，似乎是在寻求意见。","style":3,"background":120,"log_type":1,"src_id":220502050,"trial_step":50},{"step":51,"options":["同意他们跟去"],"style":6,"background":120,"log_type":1,"src_id":220502051,"trial_step":51,"course":3,"choices":[{"text":"同意他们跟去","goto":52}]},{"step":52,"content":"……那就一起去吧。","style":2,"background":120,"log_type":1,"src_id":220502052,"trial_step":52},{"step":53,"content":"你有些无奈地叹了口气。","style":3,"background":120,"log_type":1,"src_id":220502053,"trial_step":53},{"step":54,"speaker":"海拉","content":"也太【文明用语】的破了吧。","style":1,"background":305,"log_type":1,"src_id":220502054,"trial_step":54},{"step":55,"speaker":"海拉","content":"而且还有股臭味……这里真的能住人吗？","style":1,"background":305,"log_type":1,"src_id":220502055,"trial_step":55},{"step":56,"speaker":"海拉","content":"臭矮子，我知道你为什么这么多年不回来了。厄尔希这人……","style":1,"background":305,"log_type":1,"src_id":220502056,"trial_step":56},{"step":57,"speaker":"赫卡蒂","content":"海拉……","style":1,"background":305,"log_type":1,"src_id":220502057,"trial_step":57},{"step":58,"content":"在赫卡蒂的提醒下，海拉察觉到自己的失言，瘪了瘪嘴没再说话。","style":3,"background":305,"log_type":1,"src_id":220502058,"trial_step":58},{"step":59,"speaker":"赫罗","content":"前面。","style":1,"background":305,"log_type":1,"src_id":220502059,"trial_step":59},{"step":60,"content":"赫罗似乎没有在意。在她的带领下，一行人来到一辆锈迹斑斑的房车前。","style":3,"background":305,"log_type":1,"src_id":220502060,"trial_step":60},{"step":61,"content":"赫罗走到车门前，朝左下角踹了两脚，抓住门把手狠狠摇晃几下，接着猛地一推。","style":3,"background":305,"log_type":1,"src_id":220502061,"trial_step":61},{"step":62,"content":"随着令人牙酸的嘎吱声，车门被打开了。","style":3,"background":305,"log_type":1,"src_id":220502062,"trial_step":62},{"step":63,"speaker":"海拉","content":"这开门方式也太……","style":1,"background":305,"log_type":1,"src_id":220502063,"trial_step":63},{"step":64,"content":"与外面的破败锈迹不同，房车里面似乎一直在被人精心维护着。餐桌、灶台一应俱全，虽然陈旧，但很干净。","style":3,"background":1034,"log_type":1,"src_id":220502064,"trial_step":64},{"step":65,"content":"窗台的多肉植物绿油油的，看得出来它的主人最近回来给它补过水。","style":3,"background":1034,"log_type":1,"src_id":220502065,"trial_step":65},{"step":66,"speaker":"赫罗","content":"房间在左面。","style":1,"background":1034,"log_type":1,"src_id":220502066,"trial_step":66},{"step":67,"content":"赫罗出声提醒。","style":3,"background":1034,"log_type":1,"src_id":220502067,"trial_step":67},{"step":68,"content":"进入房间，除了一张双层床外，便是书桌周围堆满的一摞摞纸张。","style":3,"background":1034,"log_type":1,"src_id":220502068,"trial_step":68},{"step":69,"speaker":"海拉","content":"……先出去了，反正我在这儿也帮不上忙。","style":1,"background":1034,"log_type":1,"src_id":220502069,"trial_step":69},{"step":70,"content":"海拉拽着赫卡蒂走出了房车。","style":3,"background":1034,"log_type":1,"src_id":220502070,"trial_step":70},{"step":71,"content":"你和赫罗，以及另外几名队员开始翻阅起了面前的情报。","style":3,"background":1034,"log_type":1,"src_id":220502071,"trial_step":71},{"step":72,"content":"一个小时过去，厄尔希积攒的情报已被排除过半。可你们还是没能发现目标情报。","style":3,"background":1034,"log_type":1,"src_id":220502072,"trial_step":72},{"step":73,"content":"这期间，赫罗一直显得有些心不在焉。","style":3,"background":1034,"log_type":1,"src_id":220502073,"trial_step":73},{"step":74,"content":"赫罗。","style":2,"background":1034,"log_type":1,"src_id":220502074,"trial_step":74},{"step":75,"speaker":"赫罗","content":"……","style":1,"background":1034,"log_type":1,"src_id":220502075,"trial_step":75},{"step":76,"speaker":"赫罗","content":"嗯？","style":1,"background":1034,"log_type":1,"src_id":220502076,"trial_step":76},{"step":77,"content":"赫罗又走神了。","style":3,"background":1034,"log_type":1,"src_id":220502077,"trial_step":77},{"step":78,"content":"你能理解她。兄长刚刚死去不久，在这个处处充满回忆的地方，保持冷静都是相当难得的事情。","style":3,"background":1034,"log_type":1,"src_id":220502078,"trial_step":78},{"step":79,"content":"休息一会儿吧。","style":2,"background":1034,"log_type":1,"src_id":220502079,"trial_step":79},{"step":80,"speaker":"赫罗","content":"……好。","style":1,"background":1034,"log_type":1,"src_id":220502080,"trial_step":80},{"step":81,"content":"赫罗也知道自己现在的状态只会拖慢进度，于是默默走出了房间。","style":3,"background":1034,"log_type":1,"src_id":220502081,"trial_step":81},{"step":82,"content":"你跟了过去。","style":3,"background":1034,"log_type":1,"src_id":220502082,"trial_step":82},{"step":83,"options":["安慰赫罗"],"style":6,"background":1034,"log_type":1,"src_id":220502083,"trial_step":83,"course":3,"choices":[{"text":"安慰赫罗","goto":84}]},{"step":84,"content":"别太难过……","style":2,"background":1034,"log_type":1,"src_id":220502084,"trial_step":84},{"step":85,"content":"你憋了半天，终究也没能憋出什么有用的话。","style":3,"background":1034,"log_type":1,"src_id":220502085,"trial_step":85},{"step":86,"speaker":"赫罗","content":"我说过，我不是小孩子。","style":1,"background":1034,"log_type":1,"src_id":220502086,"trial_step":86},{"step":87,"content":"我明白那种感受。","style":2,"background":1034,"log_type":1,"src_id":220502087,"trial_step":87},{"step":88,"speaker":"赫罗","content":"你也失去过重要的人吗？","style":1,"background":1034,"log_type":1,"src_id":220502088,"trial_step":88},{"step":89,"content":"赫罗突如其来的回应让你一时有些窘迫。","style":3,"background":1034,"log_type":1,"src_id":220502089,"trial_step":89},{"step":90,"content":"我……呃……","style":2,"background":1034,"log_type":1,"src_id":220502090,"trial_step":90},{"step":91,"content":"赫罗微微一笑，只是笑意中满是苦涩。","style":3,"background":1034,"log_type":1,"src_id":220502091,"trial_step":91},{"step":92,"speaker":"赫罗","content":"你和哥哥一样，嘴太笨了，连安慰人的话都不会说。","style":1,"background":1034,"log_type":1,"src_id":220502092,"trial_step":92},{"step":93,"speaker":"赫罗","content":"你很走运，没经历过这样的事……","style":1,"background":1034,"log_type":1,"src_id":220502093,"trial_step":93},{"step":94,"speaker":"赫罗","content":"可我经历过，所有事情，一桩桩一件件，我都记得……","style":1,"background":1034,"log_type":1,"src_id":220502094,"trial_step":94},{"step":95,"speaker":"赫罗","content":"爸爸妈妈走了之后，我和哥哥就住在这里。","style":1,"background":1034,"log_type":1,"src_id":220502095,"trial_step":95},{"step":96,"speaker":"赫罗","content":"他能把面包带回家，会教训欺负我的臭小子，街头的混混都打不过他。","style":1,"background":1034,"log_type":1,"src_id":220502096,"trial_step":96},{"step":97,"speaker":"赫罗","content":"真的特别厉害。","style":1,"background":1034,"log_type":1,"src_id":220502097,"trial_step":97},{"step":98,"content":"赫罗摩挲着餐桌，那里整齐地摆放着两副餐具。","style":3,"background":1034,"log_type":1,"src_id":220502098,"trial_step":98},{"step":99,"speaker":"赫罗","content":"后来他加入了车队，干两人份活，每天回家都很累。","style":1,"background":1034,"log_type":1,"src_id":220502099,"trial_step":99},{"step":100,"speaker":"赫罗","content":"我心里很不是滋味，可又不知道该怎么做，就只是那么看着。","style":1,"background":1034,"log_type":1,"src_id":220502100,"trial_step":100},{"step":101,"speaker":"赫罗","content":"再后来有一天，他被车队的叔叔们带回来。没了一条腿。","style":1,"background":1034,"log_type":1,"src_id":220502101,"trial_step":101},{"step":102,"speaker":"赫罗","content":"我很害怕，害怕他跟爸爸妈妈一样离开。","style":1,"background":1034,"log_type":1,"src_id":220502102,"trial_step":102},{"step":103,"speaker":"赫罗","content":"哥哥他因为痛整宿睡不着觉，我就在边上哭了一整宿。可我还是帮不上忙。我不会处理伤口，没法安慰他，也不能减轻他的痛苦。","style":1,"background":1034,"log_type":1,"src_id":220502103,"trial_step":103},{"step":104,"speaker":"赫罗","content":"那天我才意识到，一定要赶紧长大，帮上他的忙。","style":1,"background":1034,"log_type":1,"src_id":220502104,"trial_step":104},{"step":105,"speaker":"赫罗","content":"我加入了车队。后来，车队变成了军团。","style":1,"background":1034,"log_type":1,"src_id":220502105,"trial_step":105},{"step":106,"speaker":"赫罗","content":"可我越是努力想要证明自己，他就越是阻拦。","style":1,"background":1034,"log_type":1,"src_id":220502106,"trial_step":106},{"step":107,"speaker":"赫罗","content":"他总是觉得我是那个只会躲在他身后的臭小鬼，所有事都该他一个人扛着。","style":1,"background":1034,"log_type":1,"src_id":220502107,"trial_step":107},{"step":108,"speaker":"赫罗","content":"我好生气啊，越生气就越要和他吵架。到后来，连理都不想理他了。","style":1,"background":1034,"log_type":1,"src_id":220502108,"trial_step":108},{"step":109,"content":"赫罗用手臂抹了抹眼睛。","style":3,"background":1034,"log_type":1,"src_id":220502109,"trial_step":109},{"step":110,"speaker":"赫罗","content":"${PlayerName}，我是不是真的很笨。","style":1,"background":1034,"log_type":1,"src_id":220502110,"trial_step":110},{"step":111,"speaker":"赫罗","content":"明明是最重要的家人，却连句正常的话都说不出口。","style":1,"background":1034,"log_type":1,"src_id":220502111,"trial_step":111},{"step":112,"speaker":"赫罗","content":"我明明……我明明……","style":1,"background":1034,"log_type":1,"src_id":220502112,"trial_step":112},{"step":113,"content":"多日来压抑的情绪终于化作决堤的泪水，自通红的眼眶里涌出。","style":3,"background":1034,"log_type":1,"src_id":220502113,"trial_step":113},{"step":114,"content":"半晌，抽噎渐渐平复。","style":3,"background":1034,"log_type":1,"src_id":220502114,"trial_step":114},{"step":115,"speaker":"赫罗","content":"哥哥已经死了。","style":1,"background":1034,"log_type":1,"src_id":220502115,"trial_step":115},{"step":116,"speaker":"赫罗","content":"我不能再做躲在他身后的臭小鬼了。","style":1,"background":1034,"log_type":1,"src_id":220502116,"trial_step":116},{"step":117,"content":"赫罗擦干眼泪，露出叫人心疼的笑容。","style":3,"background":1034,"log_type":1,"src_id":220502117,"trial_step":117},{"step":118,"speaker":"赫罗","content":"抱歉，${PlayerName}，让你听了这么多抱怨，一定很无聊吧。","style":1,"background":1034,"log_type":1,"src_id":220502118,"trial_step":118},{"step":119,"content":"怎么会呢。","style":2,"background":1034,"log_type":1,"src_id":220502119,"trial_step":119},{"step":120,"speaker":"赫罗","content":"……我刚刚想起来，哥哥他有个藏东西的坏习惯。","style":1,"background":1034,"log_type":1,"src_id":220502120,"trial_step":120},{"step":121,"content":"赫罗转过身回到书房，拉开书桌的抽屉，将它们的底板一一撬开，从里面取出几本笔记。","style":3,"background":1034,"log_type":1,"src_id":220502121,"trial_step":121},{"step":122,"speaker":"赫罗","content":"果然，他以前就喜欢在这些地方藏东西。","style":1,"background":1034,"log_type":1,"src_id":220502122,"trial_step":122},{"step":123,"content":"赫罗翻找了片刻，打开其中一本笔记。她的眼眶还有些红，但神色却平静又坚决。","style":3,"background":1034,"log_type":1,"src_id":220502123,"trial_step":123},{"step":124,"speaker":"赫罗","content":"达达利昂、布里斯、马西，我记得这几个名字。","style":1,"background":1034,"log_type":1,"src_id":220502124,"trial_step":124},{"step":125,"speaker":"赫罗","content":"治安局的人就是和他们交易的。","style":1,"background":1034,"log_type":1,"src_id":220502125,"trial_step":125},{"step":126,"content":"你接过笔记本，上面记录了这几个人与治安局接触、销毁废弃狂厄武器的记录。","style":3,"background":1034,"log_type":1,"src_id":220502126,"trial_step":126},{"step":127,"content":"只要找到记录中的地点，就足够给治安局的人定罪——不过，那是第九机关的事情了。","style":3,"background":1034,"log_type":1,"src_id":220502127,"trial_step":127},{"step":128,"content":"你们的工作已经完成了。","style":3,"background":1034,"log_type":1,"src_id":220502128,"trial_step":128},{"step":129,"speaker":"行动人员","content":"要是厄尔希能早点把这个交给局长……事情本不该发展到这一步的。","style":1,"background":1034,"log_type":1,"src_id":220502129,"trial_step":129},{"step":130,"content":"一旁的行动人员表现出惋惜。","style":3,"background":1034,"log_type":1,"src_id":220502130,"trial_step":130},{"step":131,"speaker":"赫罗","content":"后悔是没有意义的。","style":1,"background":1034,"log_type":1,"src_id":220502131,"trial_step":131},{"step":132,"speaker":"赫罗","content":"更何况，那时候哥哥没办法信任你们。","style":1,"background":1034,"log_type":1,"src_id":220502132,"trial_step":132},{"step":133,"speaker":"行动人员","content":"那他至少应该告诉其他人。","style":1,"background":1034,"log_type":1,"src_id":220502133,"trial_step":133},{"step":134,"speaker":"赫罗","content":"军团的敌人够多了。那样只会加重大家的负担。","style":1,"background":1034,"log_type":1,"src_id":220502134,"trial_step":134},{"step":135,"content":"不知何时起，赫罗已经开始像厄尔希和卓娅那样思考了。","style":3,"background":1034,"log_type":1,"src_id":220502135,"trial_step":135},{"step":136,"content":"确认完情报，你给MBCC和第九机关的人分别发去信息。","style":3,"background":1034,"log_type":1,"src_id":220502136,"trial_step":136},{"step":137,"options":["收队，尽快撤离"],"style":6,"background":1034,"log_type":1,"src_id":220502137,"trial_step":137,"course":3,"choices":[{"text":"收队，尽快撤离","goto":138}]},{"step":138,"content":"大家响应了你的命令，整理完需要带走的资料后便迅速走出了房车。","style":3,"background":305,"log_type":1,"src_id":220502138,"trial_step":138},{"step":139,"content":"只有赫罗依依不舍地回头看了一眼。","style":3,"background":305,"log_type":1,"src_id":220502139,"trial_step":139},{"step":140,"speaker":"赫罗","content":"我还会回来的……但是现在，该说再见了……","style":1,"background":305,"log_type":1,"src_id":220502140,"trial_step":140},{"step":141,"content":"轰——","style":3,"background":305,"log_type":1,"src_id":220502141,"trial_step":141},{"step":142,"content":"不远处的爆炸打断了这场温情的告别。","style":3,"background":305,"log_type":1,"src_id":220502142,"trial_step":142},{"step":143,"content":"几声枪响之后，海拉架着蓝尼冲了回来。","style":3,"background":305,"log_type":1,"src_id":220502143,"trial_step":143},{"step":144,"speaker":"海拉","content":"你们怎么还在这儿磨磨蹭蹭的啊？治安局的都找过来了！","style":1,"background":305,"log_type":1,"src_id":220502144,"trial_step":144},{"step":145,"content":"海拉大口喘着粗气，一旁的赫卡蒂帮她说明了状况——","style":3,"background":305,"log_type":1,"src_id":220502145,"trial_step":145},{"step":146,"speaker":"赫卡蒂","content":"对方人数过百，持有狂厄武器。","style":1,"background":305,"log_type":1,"src_id":220502146,"trial_step":146},{"step":147,"speaker":"赫卡蒂","content":"我们被包围了。","style":1,"background":305,"log_type":1,"src_id":220502147,"trial_step":147}]}