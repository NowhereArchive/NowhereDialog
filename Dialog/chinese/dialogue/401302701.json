{"id":401302701,"chapter_id":50040,"scene_id":54015,"steps":[{"step":1,"speaker":"雷温","content":"谢谢你，${PlayerName}。","voice":["vo_event_401302701_1"],"voice_bank":"vo_event_13027","style":1,"background":1001003,"log_type":1},{"step":2,"speaker":"雷温","content":"我想当的不是这样的主播，我想听到的不是这样的声音。","voice":["vo_event_401302701_2"],"voice_bank":"vo_event_13027","style":1,"background":1001003,"log_type":1},{"step":3,"speaker":"雷温","content":"我真正想要的是更温柔，更善良的话……更美好的语言。我想听到那样的话，而不是这种……","voice":["vo_event_401302701_3"],"voice_bank":"vo_event_13027","style":1,"background":1001003,"log_type":1},{"step":4,"content":"坠落的风包裹着你们，发出尖锐的呼啸声，可是你们彼此的声音，都能非常清晰地传达到对方耳中。","style":3,"background":1001003,"log_type":1},{"step":5,"speaker":"${PlayerName}","content":"你的声音，和平时不一样了。","style":2,"background":1001003,"log_type":1},{"step":6,"speaker":"${PlayerName}","content":"不，或许一样，但……意义已经不同了。","style":2,"background":1001003,"log_type":1},{"step":7,"speaker":"雷温","content":"是的，所以，我要谢谢你……","voice":["vo_event_401302701_7"],"voice_bank":"vo_event_13027","style":1,"background":1001003,"log_type":1},{"step":8,"speaker":"雷温","content":"要谢谢你让我认识到，我应该说出自己真正想要的东西……","voice":["vo_event_401302701_8"],"voice_bank":"vo_event_13027","style":1,"background":1001003,"log_type":1},{"step":10,"content":"最后一颗星星落下，整座大楼被毁于一旦。这个世界也开始慢慢地崩塌。","style":3,"background":10000,"log_type":1},{"step":11,"content":"这个世界找回了她的声音——诡异的紫色开始剥落，一点点地透出如日出一般的红色光芒。","style":3,"background":10000,"log_type":1},{"step":12,"speaker":"${PlayerName}","content":"结束了雷温，让我们回到现实吧……我知道，你已经找到了自己最想说的，最想做的，对吗？","style":2,"background":2142003,"log_type":1},{"step":13,"speaker":"雷温","content":"是的……我喜欢，盼望着……","voice":["vo_event_401302701_12"],"voice_bank":"vo_event_13027","style":1,"background":2142003,"log_type":1},{"step":14,"speaker":"雷温","content":"这个世界，全都是充满爱，充满善意，充满……“好”的声音。","voice":["vo_event_401302701_13"],"voice_bank":"vo_event_13027","style":1,"background":2142003,"log_type":1},{"step":15,"speaker":"雷温","content":"全部都是。","voice":["vo_event_401302701_14"],"voice_bank":"vo_event_13027","style":1,"background":2142003,"log_type":1},{"step":16,"content":"雷温看着你，微笑着，期待着。","style":3,"background":2142003,"log_type":1},{"step":17,"content":"——猛然间，剧烈的疼痛穿过你的意识，那是枷锁的警告。","style":3,"background":2142003,"log_type":1},{"step":18,"content":"在这个世界破碎的最后一瞬。","style":3,"background":10000,"log_type":1}]}