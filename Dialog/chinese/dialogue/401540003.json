{"id":401540003,"chapter_id":50045,"scene_id":45011,"steps":[{"step":1,"speaker":"吟游诗人","content":"~~~~","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":2,"speaker":"吟游诗人","content":"“冻僵的手指结束寒冷的一天 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":3,"speaker":"吟游诗人","content":"“空空的肚皮还是没什么改变。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":4,"speaker":"吟游诗人","content":"“金发的女士有一天出现 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":5,"speaker":"吟游诗人","content":"“台上的国王跌得很显眼 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":6,"speaker":"吟游诗人","content":"“她抬起帽檐笑靥如花 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":7,"speaker":"吟游诗人","content":"“满箱金币辉煌如她的金发 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":8,"speaker":"吟游诗人","content":"“还要吗？还要吗？ ”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":9,"speaker":"吟游诗人","content":"“有钱不赚是傻瓜 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":10,"speaker":"吟游诗人","content":"“还要啊！还要啊！”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":11,"speaker":"吟游诗人","content":"“加些蜜糖才融洽。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":12,"speaker":"吟游诗人","content":"“但福尔图娜，要小心啊。”","style":1,"background":1069,"is_centered":true,"log_type":1}]}