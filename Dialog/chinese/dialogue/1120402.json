{"id":1120402,"chapter_id":1120402,"scene_id":1,"steps":[{"step":1,"speaker":"夜莺","content":"禁闭者多莉，还醒着么？","style":1,"background":1025,"log_type":1,"src_id":220402001,"trial_step":1},{"step":2,"speaker":"夜莺","content":"有指派给你的任务，请准备一下。","style":1,"background":1025,"log_type":1,"src_id":220402002,"trial_step":2},{"step":3,"speaker":"夜莺","content":"局长，禁闭室已经解除锁定了。","style":1,"background":1025,"log_type":1,"src_id":220402003,"trial_step":3},{"step":4,"speaker":"夜莺","content":"管理局内还有其他要事，我先行一步。","style":1,"background":1025,"log_type":1,"src_id":220402004,"trial_step":4},{"step":5,"content":"还没来得及目送夜莺离去，禁闭室中蜷成一团的人便有了动静。","style":3,"background":1025,"log_type":1,"src_id":220402005,"trial_step":5},{"step":6,"speaker":"多莉","content":"……嗯？","style":1,"background":1025,"log_type":1,"src_id":220402006,"trial_step":6},{"step":7,"speaker":"多莉","content":"嗯！！！","style":1,"background":1025,"log_type":1,"src_id":220402007,"trial_step":7},{"step":8,"content":"原本刚刚被夜莺喊醒的多莉在看到你之后一瞬间便来了精神。","style":3,"background":1025,"log_type":1,"src_id":220402008,"trial_step":8},{"step":9,"speaker":"多莉","content":"局长！你终于来了！","style":1,"background":1025,"log_type":1,"src_id":220402009,"trial_step":9},{"step":10,"speaker":"多莉","content":"嘿嘿……是要去出任务了么！这几天我已经要无聊到要爆炸了！","style":1,"background":1025,"log_type":1,"src_id":220402010,"trial_step":10},{"step":11,"options":["是","不是"],"style":6,"background":1025,"log_type":1,"src_id":220402011,"trial_step":11,"course":3,"choices":[{"text":"是","goto":12},{"text":"不是","goto":15}]},{"step":12,"speaker":"多莉","content":"那我们还等什么！赶紧出发吧！","style":1,"background":1025,"log_type":1,"src_id":220402012,"trial_step":12},{"step":13,"speaker":"多莉","content":"早打完，就可以早备战新城棒球联盟！","style":1,"background":1025,"log_type":1,"src_id":220402013,"trial_step":13},{"step":14,"speaker":"多莉","content":"你说对吧，局长！","style":1,"background":1025,"log_type":1,"src_id":220402014,"trial_step":14,"next":[19]},{"step":15,"speaker":"多莉","content":"你怎么骗人！不是说好了么！","style":1,"background":1025,"log_type":1,"src_id":220402015,"trial_step":15},{"step":16,"content":"这不算是任务。","style":2,"background":1025,"log_type":1,"src_id":220402016,"trial_step":16},{"step":17,"content":"算是第31次……测试吧。","style":2,"background":1025,"log_type":1,"src_id":220402017,"trial_step":17},{"step":18,"speaker":"多莉","content":"啧，无所谓，反正我肯定能控制住自己。","style":1,"background":1025,"log_type":1,"src_id":220402018,"trial_step":18,"next":[19]},{"step":19,"content":"那再好不过。对了，这个给你。","style":2,"background":1025,"log_type":1,"src_id":220402019,"trial_step":19},{"step":20,"content":"你把棒球棍扔给多莉，她则高兴地像只小狗一样跳起来，一把将其接住后放在脸上蹭来蹭去。","style":3,"background":1025,"log_type":1,"src_id":220402020,"trial_step":20},{"step":21,"speaker":"多莉","content":"真是想死你了！没了你，我连觉都睡不安稳！","style":1,"background":1025,"log_type":1,"src_id":220402021,"trial_step":21},{"step":22,"content":"你这不是挺精神的？","style":2,"background":1025,"log_type":1,"src_id":220402022,"trial_step":22},{"step":23,"content":"多莉瞪了你一眼。","style":3,"background":1025,"log_type":1,"src_id":220402023,"trial_step":23},{"step":24,"speaker":"多莉","content":"顺便问一下，能骑摩托车过去么？","style":1,"background":1025,"log_type":1,"src_id":220402024,"trial_step":24},{"step":25,"speaker":"多莉","content":"我可是好久没有体验过那种一路飞驰的感觉了！","style":1,"background":1025,"log_type":1,"src_id":220402025,"trial_step":25},{"step":26,"content":"你摇了摇头，拍了下口袋。","style":3,"background":1025,"log_type":1,"src_id":220402026,"trial_step":26},{"step":27,"options":["想一路飞驰也不一定要骑摩托车"],"style":6,"background":1025,"log_type":1,"src_id":220402027,"trial_step":27,"course":3,"choices":[{"text":"想一路飞驰也不一定要骑摩托车","goto":28}]},{"step":28,"content":"破败的锈河风景在你的两侧快速掠过，行驶过高危区域后，你将驾驶模式调为了自动。","style":3,"background":1018,"log_type":1,"src_id":220402029,"trial_step":29},{"step":29,"speaker":"多莉","content":"唉……看着这地方，居然还有点怀念。","style":1,"background":1018,"log_type":1,"src_id":220402030,"trial_step":30},{"step":30,"speaker":"多莉","content":"那时候感觉自己谁都不怕，最后却差点在死役堆送了命。","style":1,"background":1018,"log_type":1,"src_id":220402031,"trial_step":31},{"step":31,"options":["你为什么要来锈河？"],"style":6,"background":1018,"log_type":1,"src_id":220402032,"trial_step":32,"course":3,"choices":[{"text":"你为什么要来锈河？","goto":33}]},{"step":32,"content":"维持生计？","style":2,"background":1018,"log_type":1,"src_id":220402033,"trial_step":33},{"step":33,"speaker":"多莉","content":"这你就小看我了，我怎么可能做这种事。","style":1,"background":1018,"log_type":1,"src_id":220402034,"trial_step":34},{"step":34,"speaker":"导航","content":"即将在前方左转，路况颠簸，请系好安全带。","style":11,"background":1018,"log_type":1,"src_id":220402035,"trial_step":35},{"step":35,"speaker":"多莉","content":"管理局的导航看来不怎么熟悉锈河嘛。","style":1,"background":1018,"log_type":1,"src_id":220402036,"trial_step":36},{"step":36,"speaker":"多莉","content":"这么走的话，可是会碰到死役的。","style":1,"background":1018,"log_type":1,"src_id":220402037,"trial_step":37},{"step":37,"speaker":"死役","content":"吼——！","style":1,"background":1018,"log_type":1,"src_id":220402038,"trial_step":38},{"step":38,"content":"多莉的话还没说完，一只死役便从垃圾堆后飞速冲出，你连忙切换到手动驾驶状态，开始全力加速。","style":3,"background":1018,"log_type":1,"src_id":220402039,"trial_step":39},{"step":39,"content":"死役的听力与速度极强，它在发现声响后，便向你们冲来。","style":3,"background":1018,"log_type":1,"src_id":220402040,"trial_step":40},{"step":40,"speaker":"多莉","content":"这是变异种，很难缠哦。需要我下车解决它么？","style":1,"background":1018,"log_type":1,"src_id":220402041,"trial_step":41},{"step":41,"options":["这不是你今天的目标","我还能搞定"],"style":6,"background":1018,"log_type":1,"src_id":220402042,"trial_step":42,"course":3,"choices":[{"text":"这不是你今天的目标","goto":43},{"text":"我还能搞定","goto":null}]},{"step":42,"speaker":"多莉","content":"这样啊……那你加油。","style":1,"background":1018,"log_type":1,"src_id":220402043,"trial_step":43},{"step":43,"content":"你踩满油门，但死役的速度仍旧不减，一直衔在车后。","style":3,"background":1018,"log_type":1,"src_id":220402044,"trial_step":44},{"step":44,"speaker":"多莉","content":"看你蛮辛苦的，既然不让我战斗的话，那我就——帮你开车好了！","style":1,"background":1018,"log_type":1,"src_id":220402045,"trial_step":45},{"step":45,"content":"她从后座探出身子，一把抢过了车载导航仪。","style":3,"background":1018,"log_type":1,"src_id":220402046,"trial_step":46},{"step":46,"options":["你干什么！","你别乱来！"],"style":6,"background":1018,"log_type":1,"src_id":220402047,"trial_step":47,"course":3,"choices":[{"text":"你干什么！","goto":48},{"text":"你别乱来！","goto":null}]},{"step":47,"speaker":"多莉","content":"放心——我再熟悉这里不过了。","style":1,"background":1018,"log_type":1,"src_id":220402048,"trial_step":48},{"step":48,"content":"她在这导航仪上七拐八拐地画了几条线，皱了皱眉，最后点下了确定。","style":3,"background":1018,"log_type":1,"src_id":220402049,"trial_step":49},{"step":49,"speaker":"导航","content":"路径已更改，修正路线中。","style":11,"background":1018,"log_type":1,"src_id":220402050,"trial_step":50},{"step":50,"content":"汽车从锈河的垃圾堆上高高跃起后，撞开了堆积如山的垃圾，落在了沟壑的另一侧。","style":3,"background":1018,"log_type":1,"src_id":220402051,"trial_step":51},{"step":51,"speaker":"多莉","content":"芜——！刺激！对付这种傻大个，就是要绕晕它才行！","style":1,"background":1018,"log_type":1,"src_id":220402052,"trial_step":52},{"step":52,"content":"死役被远远甩在后面，你们则继续朝着目标点驶去。","style":3,"background":1018,"log_type":1,"src_id":220402053,"trial_step":53},{"step":53,"content":"你当时就这么去的新城？","style":2,"background":1018,"log_type":1,"src_id":220402054,"trial_step":54},{"step":54,"speaker":"多莉","content":"当然。","style":1,"background":1018,"log_type":1,"src_id":220402055,"trial_step":55},{"step":55,"speaker":"多莉","content":"这是从辛迪加到新城最快，也最方便的方法了。","style":1,"background":1018,"log_type":1,"src_id":220402056,"trial_step":56},{"step":56,"options":["也是最危险的途径。"],"style":2,"background":1018,"log_type":1,"src_id":220402057,"trial_step":57,"course":3,"choices":[{"text":"也是最危险的途径。","goto":58}]},{"step":57,"content":"为什么要这么做，你难道不怕西区条例？","style":2,"background":1018,"log_type":1,"src_id":220402058,"trial_step":58},{"step":58,"speaker":"多莉","content":"西区条例……嘁，都是笑话。","style":1,"background":1018,"log_type":1,"src_id":220402059,"trial_step":59},{"step":59,"speaker":"多莉","content":"就算我在新城被发现、被遣返，对我来说都没有任何损失。","style":1,"background":1018,"log_type":1,"src_id":220402060,"trial_step":60},{"step":60,"speaker":"多莉","content":"审批的时间慢上加慢，路费更是难以支付。最主要的是，我等不了。","style":1,"background":1018,"log_type":1,"src_id":220402061,"trial_step":61},{"step":61,"content":"等什么，是棒球比赛么？","style":2,"background":1018,"log_type":1,"src_id":220402062,"trial_step":62},{"step":62,"speaker":"多莉","content":"当然。我想去最高的舞台，和强者交手。辛迪加早就没有我的对手了。","style":1,"background":1018,"log_type":1,"src_id":220402063,"trial_step":63},{"step":63,"content":"她的回答斩钉截铁，没有一丝犹豫。","style":3,"background":1018,"log_type":1,"src_id":220402064,"trial_step":64},{"step":64,"content":"可新城和辛迪加水火不容，你这么做，不怕被辛迪加人骂么？","style":2,"background":1018,"log_type":1,"src_id":220402065,"trial_step":65},{"step":65,"speaker":"多莉","content":"噗……哈哈哈。","style":1,"background":1018,"log_type":1,"src_id":220402066,"trial_step":66},{"step":66,"speaker":"多莉","content":"说实话，我完全没有考虑过。","style":1,"background":1018,"log_type":1,"src_id":220402067,"trial_step":67},{"step":67,"options":["……这回答还是挺像你的。"],"style":2,"background":1018,"log_type":1,"src_id":220402068,"trial_step":68,"course":3,"choices":[{"text":"……这回答还是挺像你的。","goto":69}]},{"step":68,"speaker":"多莉","content":"如果非要有一个理由就是……我想让那些新城人看看，就算是辛迪加人，也能打好棒球。","style":1,"background":1018,"log_type":1,"src_id":220402069,"trial_step":69},{"step":69,"content":"一声合成的电子音打断了她的话语。","style":3,"background":1018,"log_type":1,"src_id":220402070,"trial_step":70},{"step":70,"speaker":"导航","content":"已抵达目标点，请下车。","style":11,"background":1018,"log_type":1,"src_id":220402071,"trial_step":71},{"step":71,"speaker":"多莉","content":"管理局的车质量就是好啊，我那辆摩托要是这么开早就报废了。","style":1,"background":1019,"log_type":1,"src_id":220402072,"trial_step":72},{"step":72,"speaker":"多莉","content":"你应该还没忘记我们之前的约定吧？","style":1,"background":1019,"log_type":1,"src_id":220402073,"trial_step":73},{"step":73,"content":"你点点头。","style":3,"background":1019,"log_type":1,"src_id":220402074,"trial_step":74},{"step":74,"speaker":"死役","content":"哈——————","style":1,"background":1019,"log_type":1,"src_id":220402075,"trial_step":75},{"step":75,"content":"似乎是感受到了人类的气息，死役开始向你们聚集而来。","style":3,"background":1019,"log_type":1,"src_id":220402076,"trial_step":76},{"step":76,"content":"望着涌向车辆的死役们，你向多莉下达了指令。","style":3,"background":1019,"log_type":1,"src_id":220402077,"trial_step":77},{"step":77,"options":["开始战斗！"],"style":6,"background":1019,"log_type":1,"src_id":220402078,"trial_step":78,"course":3,"choices":[{"text":"开始战斗！","goto":79}]},{"step":78,"speaker":"多莉","content":"看我的吧！","style":1,"background":1019,"log_type":1,"src_id":220402079,"trial_step":79},{"step":79,"content":"你的话音还未落下，多莉的身影如同一支利箭，直直地刺入这群死役的中心。","style":3,"background":1019,"log_type":1,"src_id":220402080,"trial_step":80},{"step":80,"content":"她用力抡动手中的金属球棒，将死役们一个又一个从她的身边击打而出。","style":3,"background":1019,"log_type":1,"src_id":220402081,"trial_step":81},{"step":81,"content":"但即使强如多莉，在不使用能力的情况下，单凭身体强度对抗死役还是太过勉强。","style":3,"background":1019,"log_type":1,"src_id":220402082,"trial_step":82},{"step":82,"speaker":"多莉","content":"啧……还以为能轻松赢下赌局的。","style":1,"background":1019,"log_type":1,"src_id":220402083,"trial_step":83},{"step":83,"speaker":"多莉","content":"希望不是你在算计我。离我远一点，我要一口气把它们都清理干净。","style":1,"background":1019,"log_type":1,"src_id":220402084,"trial_step":84},{"step":84,"options":["千万别失控"],"style":6,"background":1019,"log_type":1,"src_id":220402085,"trial_step":85,"course":3,"choices":[{"text":"千万别失控","goto":86}]},{"step":85,"speaker":"多莉","content":"好……好……","style":1,"background":1019,"log_type":1,"src_id":220402086,"trial_step":86},{"step":86,"speaker":"多莉","content":"我会的……","style":1,"background":1019,"log_type":1,"src_id":220402087,"trial_step":87},{"step":87,"speaker":"多莉","content":"我会的……啊啊啊啊啊！","style":1,"background":1019,"log_type":1,"src_id":220402088,"trial_step":88},{"step":88,"content":"死役的数量仍不见少，你在给她下达了“不要攻击我”的指令后开始后退。","style":3,"background":1019,"log_type":1,"src_id":220402089,"trial_step":89},{"step":89,"content":"多莉开始如在管理局的测试中一样，开始释放着她的能量。","style":3,"background":1019,"log_type":1,"src_id":220402090,"trial_step":90},{"step":90,"content":"不一样的是，这次测试中，她的手里多了一根棒球棍。","style":3,"background":1019,"log_type":1,"src_id":220402091,"trial_step":91},{"step":91,"speaker":"多莉","content":"啊啊啊啊啊——","style":1,"background":1019,"log_type":1,"src_id":220402092,"trial_step":92},{"step":92,"content":"她像是一具不知疲倦的战斗机器，带着摧毁一切的力量，穿梭在这锈河之上。","style":3,"background":1019,"log_type":1,"src_id":220402093,"trial_step":93},{"step":93,"content":"她的速度越来越快，越来越快，快到你的眼睛几近无法捕捉。","style":3,"background":1019,"log_type":1,"src_id":220402094,"trial_step":94},{"step":94,"content":"这是你第一次如此近距离观察战斗中的多莉。","style":3,"background":1019,"log_type":1,"src_id":220402095,"trial_step":95},{"step":95,"content":"也是第一次感受多莉的力量这么拼命地在撕扯着你的意识。","style":3,"background":1019,"log_type":1,"src_id":220402096,"trial_step":96},{"step":96,"speaker":"多莉","content":"去……死！","style":1,"background":1019,"log_type":1,"src_id":220402097,"trial_step":97},{"step":97,"content":"她每挥下一棒，束缚着她的枷锁便被扯开一分。","style":3,"background":1019,"log_type":1,"src_id":220402098,"trial_step":98},{"step":98,"speaker":"多莉","content":"……我……能控制住……","style":1,"background":1019,"log_type":1,"src_id":220402099,"trial_step":99},{"step":99,"content":"这早已不是多莉与死役的战斗，而是她和自己的战斗。","style":3,"background":1019,"log_type":1,"src_id":220402100,"trial_step":100},{"step":100,"content":"你看到多莉的表情扭曲，似乎在拼命控制着自己的情绪。","style":3,"background":1019,"log_type":1,"src_id":220402101,"trial_step":101},{"step":101,"speaker":"多莉","content":"为什么……","style":1,"background":1019,"log_type":1,"src_id":220402102,"trial_step":102},{"step":102,"speaker":"多莉","content":"没有用……啊！","style":1,"background":1019,"log_type":1,"src_id":220402103,"trial_step":103},{"step":103,"content":"可惜的是，尽管她比每一次都清醒，可身体还是不受控制地挥着球棒。","style":3,"background":1019,"log_type":1,"src_id":220402104,"trial_step":104},{"step":104,"speaker":"多莉","content":"停下……给我……停下！","style":1,"background":1019,"log_type":1,"src_id":220402105,"trial_step":105},{"step":105,"content":"情况急转直下，你必须做出行动。","style":3,"background":1019,"log_type":1,"src_id":220402106,"trial_step":106},{"step":106,"options":["控制多莉","不控制多莉"],"style":6,"background":1019,"log_type":1,"src_id":220402107,"trial_step":107,"course":3,"choices":[{"text":"控制多莉","goto":108},{"text":"不控制多莉","goto":110}]},{"step":107,"content":"你集中精神操控枷锁，想要解除多莉的能力。","style":3,"background":1019,"log_type":1,"src_id":220402108,"trial_step":108},{"step":108,"content":"但多莉的速度实在太快，你只得仓促释放枷锁。","style":3,"background":1019,"log_type":1,"src_id":220402109,"trial_step":109,"next":[112]},{"step":109,"content":"你打算相信多莉。","style":3,"background":1019,"log_type":1,"src_id":220402110,"trial_step":110},{"step":110,"content":"但望着向你疾驰而来的身影，你只得做出改变，准备释放枷锁。","style":3,"background":1019,"log_type":1,"src_id":220402111,"trial_step":111,"next":[112]},{"step":111,"content":"她的身形一顿，这并不能算得上是干扰。","style":3,"background":1019,"log_type":1,"src_id":220402113,"trial_step":113},{"step":112,"content":"在摇了摇头之后，她继续向你挥棒。为躲过她的攻击，你只能继续使用枷锁。","style":3,"background":1019,"log_type":1,"src_id":220402114,"trial_step":114},{"step":113,"content":"你仍在尝试着，虽然起到了一些效果，但并不能将她的状态完全解除。","style":3,"background":1019,"log_type":1,"src_id":220402116,"trial_step":116},{"step":114,"speaker":"多莉","content":"啊啊……啊啊啊啊……躲……开！！","style":1,"background":1019,"log_type":1,"src_id":220402117,"trial_step":117},{"step":115,"content":"尽管可以吐出完整的语句，但多莉仍不能夺回身体的控制权。","style":3,"background":1019,"log_type":1,"src_id":220402118,"trial_step":118},{"step":116,"content":"你冷静心神，闭上眼睛。决定再试最后一次。","style":3,"background":10000,"log_type":1,"src_id":220402119,"trial_step":119},{"step":117,"speaker":"多莉","content":"啊……啊！！","style":1,"background":10000,"log_type":1,"src_id":220402120,"trial_step":120},{"step":118,"content":"声音越来越近，越来越近。就好像即将有一阵飓风扑到你的面前，将你从这大地之上抹去。","style":3,"background":10000,"log_type":1,"src_id":220402121,"trial_step":121},{"step":119,"options":["停下！"],"style":6,"background":10000,"log_type":1,"src_id":220402122,"trial_step":122,"course":3,"choices":[{"text":"停下！","goto":123}]},{"step":120,"content":"一切声音戛然而止。","style":3,"background":10000,"log_type":1,"src_id":220402123,"trial_step":123},{"step":121,"content":"额头上传来的是棒球棍冰凉的金属触感。","style":3,"background":10000,"log_type":1,"src_id":220402124,"trial_step":124},{"step":122,"content":"睁开眼睛，多莉如同一尊冰雕般定格在你的面前，她的嘴巴翕动着，除了能够大口喘气外，无法发出一点声音。","style":3,"background":1019,"log_type":1,"src_id":220402125,"trial_step":125},{"step":123,"content":"和上次任务一样，多莉的状态被你及时解除了。一切只是有惊无险。","style":3,"background":1019,"log_type":1,"src_id":220402126,"trial_step":126},{"step":124,"options":["这下你该相信了吧。"],"style":6,"background":1019,"log_type":1,"src_id":220402127,"trial_step":127,"course":3,"choices":[{"text":"这下你该相信了吧。","goto":128}]},{"step":125,"content":"你的能力不仅和你的情绪有关，更多的是和这东西有关。","style":2,"background":1019,"log_type":1,"src_id":220402128,"trial_step":128},{"step":126,"content":"你伸出手，将那根悬停在你额头上的棒球棍重新放回她的手上。","style":3,"background":1019,"log_type":1,"src_id":220402129,"trial_step":129},{"step":127,"content":"棒球对于多莉来说，是如同生命般的存在。","style":3,"background":1019,"log_type":1,"src_id":220402130,"trial_step":130},{"step":128,"content":"你不知道该怎么安慰她，但你觉得，相比一直骗她，不如直接让她知道真相。","style":3,"background":1019,"log_type":1,"src_id":220402131,"trial_step":131},{"step":129,"content":"你再一次告知了她最沉重的事实——","style":3,"background":1019,"log_type":1,"src_id":220402132,"trial_step":132},{"step":130,"options":["实验，失败了"],"style":6,"background":1019,"log_type":1,"src_id":220402133,"trial_step":133,"course":3,"choices":[{"text":"实验，失败了","goto":134}]},{"step":131,"speaker":"多莉","content":"呜……呜呜……","style":1,"background":1019,"log_type":1,"src_id":220402134,"trial_step":134},{"step":132,"content":"得知消息的多莉并没有再次狂暴。而是如同断了线的木偶般，无力地瘫坐在地上。","style":3,"background":1019,"log_type":1,"src_id":220402135,"trial_step":135},{"step":133,"speaker":"多莉","content":"那我……那我……该怎么办才好。","style":1,"background":1019,"log_type":1,"src_id":220402136,"trial_step":136},{"step":134,"speaker":"多莉","content":"我只会……只会打棒球。打不了棒球的话……还不如就这么死了。","style":1,"background":1019,"log_type":1,"src_id":220402137,"trial_step":137},{"step":135,"content":"……","style":2,"background":1019,"log_type":1,"src_id":220402138,"trial_step":138},{"step":136,"speaker":"多莉","content":"我……都想起来了。","style":1,"background":1019,"log_type":1,"src_id":220402139,"trial_step":139},{"step":137,"content":"她抱着膝盖，泣不成声。","style":3,"background":1019,"log_type":1,"src_id":220402140,"trial_step":140},{"step":138,"speaker":"多莉","content":"就在刚才的战斗中，我想起自己为什么……会变成这样。","style":1,"background":1019,"log_type":1,"src_id":220402141,"trial_step":141},{"step":139,"speaker":"多莉","content":"在去新城时……我被死役袭击。拼命挥动球棒抵抗，在我快要死掉时，获得了这能力。","style":1,"background":1019,"log_type":1,"src_id":220402142,"trial_step":142},{"step":140,"speaker":"多莉","content":"只要挥动球棒，能力就会不自觉地发动。","style":1,"background":1019,"log_type":1,"src_id":220402143,"trial_step":143},{"step":141,"speaker":"多莉","content":"我就只是个……挥棒的机器！","style":1,"background":1019,"log_type":1,"src_id":220402144,"trial_step":144},{"step":142,"speaker":"多莉","content":"哈哈……我真傻，怎么能把这么重要的事忘掉呢……还写什么给三年后自己的信……哈哈哈。","style":1,"background":1019,"log_type":1,"src_id":220402145,"trial_step":145},{"step":143,"content":"多莉跪坐在地上，双眼无神。","style":3,"background":1019,"log_type":1,"src_id":220402146,"trial_step":146},{"step":144,"speaker":"多莉","content":"很愚蠢吧，我只能不停地，不停地挥棒。","style":1,"background":1019,"log_type":1,"src_id":220402147,"trial_step":147},{"step":145,"speaker":"多莉","content":"……像个机器人一样，每挥一棒……下一棒就更快。","style":1,"background":1019,"log_type":1,"src_id":220402148,"trial_step":148},{"step":146,"speaker":"多莉","content":"局长……是你赢了，我没办法回到球场，我只会用球棒毁掉球场。","style":1,"background":1019,"log_type":1,"src_id":220402149,"trial_step":149},{"step":147,"speaker":"多莉","content":"我越是挥棒，就离球场越远。","style":1,"background":1019,"log_type":1,"src_id":220402150,"trial_step":150},{"step":148,"speaker":"多莉","content":"就让我……这么烂掉吧。","style":1,"background":1019,"log_type":1,"src_id":220402151,"trial_step":151},{"step":149,"content":"或许是发动能力用尽了力量，也可能是想要单纯静一静。","style":3,"background":1018,"log_type":1,"src_id":220402153,"trial_step":153},{"step":150,"content":"多莉上车后便蜷缩在车的后座，没过一会儿便平稳地睡着了。","style":3,"background":1018,"log_type":1,"src_id":220402154,"trial_step":154},{"step":151,"speaker":"导航","content":"有来自“夜莺”的通话，请接听。","style":11,"background":1018,"log_type":1,"src_id":220402155,"trial_step":155},{"step":152,"options":["接听"],"style":6,"background":1018,"log_type":1,"src_id":220402156,"trial_step":156,"course":3,"choices":[{"text":"接听","goto":157}]},{"step":153,"speaker":"夜莺","content":"局长，您现在还在新城附近么？","style":11,"background":1018,"log_type":1,"src_id":220402157,"trial_step":157},{"step":154,"options":["在。"],"style":2,"background":1018,"log_type":1,"src_id":220402158,"trial_step":158,"course":3,"choices":[{"text":"在。","goto":159}]},{"step":155,"speaker":"夜莺","content":"太好了。","style":11,"background":1018,"log_type":1,"src_id":220402159,"trial_step":159},{"step":156,"content":"夜莺好像长出了一口气。","style":3,"background":1018,"log_type":1,"src_id":220402160,"trial_step":160},{"step":157,"options":["有什么事？"],"style":2,"background":1018,"log_type":1,"src_id":220402161,"trial_step":161,"course":3,"choices":[{"text":"有什么事？","goto":162}]},{"step":158,"speaker":"夜莺","content":"新城体育场遭到了死役袭击，因为还在比赛，FAC的作战小队没办法将观众全部救出，需要我们协助处理。","style":11,"background":1018,"log_type":1,"src_id":220402162,"trial_step":162},{"step":159,"content":"稍等，我们马上就过去。","style":2,"background":1018,"log_type":1,"src_id":220402163,"trial_step":163},{"step":160,"speaker":"导航","content":"已更改目标地点为“新城体育场”。","style":11,"background":1018,"log_type":1,"src_id":220402164,"trial_step":164},{"step":161,"content":"挂断电话，你又瞄了一眼后座的多莉，还有那根就算睡着也被她死死攥在手里的球棒。","style":3,"background":1018,"log_type":1,"src_id":220402165,"trial_step":165},{"step":162,"content":"或许，还有机会。","style":3,"background":1018,"log_type":1,"src_id":220402166,"trial_step":166}]}