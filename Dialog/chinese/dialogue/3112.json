{"id":3112,"chapter_id":3,"scene_id":311,"steps":[{"step":1,"speaker":"海拉","content":"呼——呼——给你揉揉，还疼不疼了？","voice":["vo_cgplot_3112001"],"voice_bank":"vo_cgplot_03","style":1,"background":302,"log_type":1},{"step":2,"speaker":"海拉","content":"呜呜，我们${PlayerName}怎么被揍成猪头了，我都还没这么打过你呢……好端端的，惹他们干嘛啦？","voice":["vo_cgplot_3112002"],"voice_bank":"vo_cgplot_03","style":1,"background":302,"log_type":1},{"step":3,"content":"你想说其实没那么疼，但看两人难得关心你的样子……","style":3,"background":302,"log_type":1},{"step":4,"content":"就这么着吧。","style":3,"background":302,"log_type":1},{"step":5,"options":["你们怎么找到我的？"],"jump":[6],"style":6,"background":302,"log_type":1},{"step":6,"content":"毕竟从中央电梯到这里也并不是什么好走的路。","style":3,"background":302,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"……","voice":["vo_cgplot_3112007"],"voice_bank":"vo_cgplot_03","style":1,"background":302,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"就像局长能通过枷锁找到禁闭者，我们也一样能感应你的存在。","voice":["vo_cgplot_3112008"],"voice_bank":"vo_cgplot_03","style":1,"background":302,"log_type":1},{"step":9,"speaker":"赫卡蒂","content":"虽然很微弱，但我听到你的呼唤了，从枷锁的另一头。","voice":["vo_cgplot_3112009"],"voice_bank":"vo_cgplot_03","style":1,"background":302,"log_type":1},{"step":10,"speaker":"赫卡蒂","content":"还好有它在，我才能回到你身边。","voice":["vo_cgplot_3112010"],"voice_bank":"vo_cgplot_03","style":1,"background":302,"log_type":1},{"step":11,"content":"她的声音还是那么淡漠无波澜，与此同时，梦魇游荡到你身边，轻轻蹭了蹭你。","style":3,"background":302,"log_type":1}]}