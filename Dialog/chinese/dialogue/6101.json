{"id":6101,"chapter_id":6,"scene_id":612,"steps":[{"step":1,"content":"在枷锁的另一头，污秽再次阻断了你和卓娅的联系。让你头痛欲裂。","style":3,"background":511,"log_type":1},{"step":2,"speaker":"混沌的声音","content":"<color=#dg1f1f><size=30><i>又是你……又是你！</color></i></size>","voice":["vo_cgplot_6101002"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":3,"speaker":"混沌的声音","content":"<color=#dg1f1f><i>滚回去，不要碰她，她是我的！环是我的！！放开她！</color></i>","voice":["vo_cgplot_6101003"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":4,"options":["不！"],"jump":[5],"style":6,"background":511,"log_type":1},{"step":5,"content":"你不想输给它，不想将卓娅拱手让人，如果在这里松手，那你将永远失去她了。","style":3,"background":511,"log_type":1},{"step":6,"content":"但这里并不只有你在。","style":3,"background":511,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"局长！呃……！！","voice":["vo_cgplot_6101007"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":8,"speaker":"海拉","content":"放手……不行了……快放手！！","voice":["vo_cgplot_6101008"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":9,"speaker":"混沌的声音","content":"<color=#dg1f1f><size=44>放开！！</size></color>","voice":["vo_cgplot_6101009"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":10,"content":"该怎么办？！","style":3,"background":511,"log_type":1},{"step":11,"speaker":"？？","content":"……放手。","voice":["vo_cgplot_6101011"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":12,"content":"一个低沉的声音在你脑中响起，他来自枷锁的另一头，却没有那种疯狂和暴戾。像是劝诱。","style":3,"background":511,"log_type":1},{"step":13,"speaker":"？？","content":"还没到时候……还有机会……","voice":["vo_cgplot_6101013"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":14,"speaker":"？？","content":"……上前……我……给你……指路……","voice":["vo_cgplot_6101014"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":15,"options":["你是……谁？"],"jump":[16],"style":6,"background":511,"log_type":1},{"step":16,"content":"那个声音远去了，随之消散的还有枷锁的光芒。你再也感受不到卓娅的气息，但却并不觉得失去了她。","style":3,"background":511,"log_type":1},{"step":17,"content":"而在眼前，堵截你们的污染怪物们像被扰乱了一般，露出迷茫的神色。","style":3,"background":511,"log_type":1},{"step":18,"speaker":"海拉","content":"哈、哈……怎么回事？那个大哥又睡醒了？","voice":["vo_cgplot_6101018"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":19,"options":["不知道，但我想我们快到了"],"jump":[20],"style":6,"background":511,"log_type":1},{"step":20,"content":"大家还能战斗吗？","style":2,"background":511,"log_type":1},{"step":21,"speaker":"海拉","content":"哈……哈……就算我想跑，你也不会走的吧？","voice":["vo_cgplot_6101021"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":22,"speaker":"海拉","content":"既然都快到秃子头顶了，那就一口气爬上去吧，结束这一切！","voice":["vo_cgplot_6101022"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1}]}