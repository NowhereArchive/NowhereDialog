{"id":7421,"chapter_id":7,"scene_id":710,"steps":[{"step":1,"content":"只剩你一个人了。","style":3,"background":702,"log_type":1},{"step":2,"speaker":"兔子玩偶","content":"欢迎来到嘉年华！欢迎来到嘉年华！","voice":["vo_cgplot_7101002"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":3,"speaker":"兔子玩偶","content":"欢迎——！欢迎——！","voice":["vo_cgplot_7101003"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":4,"content":"兔子玩偶欢快地打着它的小鼓，仿佛在嘲讽你的不自量力。","style":3,"background":702,"log_type":1},{"step":5,"content":"你太不自量力了。你以为只要坚持战斗，就能不断前进。你低估了这群魔幻象，低估了哈梅尔。","style":3,"background":702,"log_type":1},{"step":6,"content":"是你把那两人带进黑环，而今你失去了她们。","style":3,"background":702,"log_type":1},{"step":7,"speaker":"老人","content":"回去吧，离开这里。","voice":["vo_cgplot_7101007"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":8,"speaker":"老人","content":"停留只会迷失，迷失在去见她的路上……","voice":["vo_cgplot_7101008"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":9,"speaker":"老人","content":"这是哈梅尔的乐园，她不想见你，你就永远见不到她。","voice":["vo_cgplot_7101009"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":10,"speaker":"选项","options":["我不回去"],"jump":[11],"style":6,"background":702,"log_type":1},{"step":11,"content":"那两个人为你而来，强忍着恐惧和痛苦，仅仅因为你需要，她们就再次踏入黑环。明明只是你的问题，你却把她们卷进来，身陷险境。","style":3,"background":702,"log_type":1},{"step":12,"content":"你没有退路，你不能走。要夺回她们，必须夺回她们。事到如今更不能停止战斗，你向前迈进。","style":3,"background":702,"log_type":1},{"step":13,"speaker":"老人","content":"你一个人又能做什么？","voice":["vo_cgplot_7101013"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":14,"content":"——至少已经无可失去。","style":3,"background":702,"log_type":1},{"step":15,"content":"可就在你往前走出一步时，一个人拽住了你的手。","style":3,"background":702,"log_type":1},{"step":16,"speaker":"【空场】","content":"淡入赫卡蒂垂头立绘","style":18,"background":702,"log_type":1},{"step":17,"speaker":"选项","options":["赫卡蒂？"],"jump":[18],"style":6,"background":702,"log_type":1},{"step":18,"speaker":"赫卡蒂","content":"………………不要……","voice":["vo_cgplot_7101018"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":19,"speaker":"赫卡蒂","content":"……不要去……求求你……","voice":["vo_cgplot_7101019"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":20,"content":"赫卡蒂颤声呓语着，不知道是怎样痛苦的梦境，竟让一向面无表情的她变得如此脆弱。","style":3,"background":702,"log_type":1},{"step":21,"content":"你想起来，在这之前她也曾几次这样欲言又止，勉强跟上你的命令。","style":3,"background":702,"log_type":1},{"step":22,"content":"原来这就是她一直说不出口的话。她这么不安，为了你。","style":3,"background":702,"log_type":1},{"step":23,"speaker":"老人","content":"回去吧，她也希望你能回去。","voice":["vo_cgplot_7101023"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":24,"speaker":"选项","options":["……我不回去"],"jump":[25],"style":6,"background":702,"log_type":1},{"step":25,"content":"你独自背负了很久，紧绷了很久，在你心中黑环从未结束，沉重地压迫着你的所有，无从顾及其它一切。","style":3,"background":702,"log_type":1},{"step":26,"content":"但奇怪的是，如今看到有人如此真切地为你惶恐不安、为你拼命，你独自背负的东西却被轻轻卸下了。","style":3,"background":702,"log_type":1},{"step":27,"content":"枷锁的那头，迷雾紧锁的深处，还有人牵挂着你。仅仅明了这一点，眼前闭塞的困境就不再令人绝望。","style":3,"background":702,"log_type":1},{"step":28,"speaker":"赫卡蒂","content":"……求求……你……求……","voice":["vo_cgplot_7101028"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":29,"content":"她还不肯放手，你没有用力挣脱，而是转过身，轻轻抱住她。","style":3,"background":702,"log_type":1},{"step":31,"speaker":"赫卡蒂","content":"……求……你……","voice":["vo_cgplot_7101030"],"voice_bank":"vo_cgplot_07","style":1,"background":50702,"log_type":1},{"step":32,"speaker":"选项","options":["赫卡蒂，我没事的"],"jump":[33],"style":6,"background":50702,"log_type":1},{"step":33,"speaker":"玩家","content":"幻境的主人没有敌意，我只是去找她谈谈。","style":2,"background":50702,"log_type":1},{"step":34,"speaker":"玩家","content":"更重要的是，枷锁还在，仍然联系着你们和我。我不是一个人在战斗。","style":2,"background":50702,"log_type":1},{"step":35,"speaker":"玩家","content":"谢谢你们一直保护我。","style":2,"background":50702,"log_type":1},{"step":36,"speaker":"赫卡蒂","content":"……不要……不……","voice":["vo_cgplot_7101035"],"voice_bank":"vo_cgplot_07","style":1,"background":50702,"log_type":1},{"step":37,"speaker":"选项","options":["放手吧……这一次，换我保护你们"],"jump":[38],"style":6,"background":50702,"log_type":1},{"step":38,"content":"赫卡蒂的手颤抖着，试图握紧你。锁骨处浮现的红光却让她渐渐难以坚持。","style":3,"background":50702,"log_type":1},{"step":40,"content":"她终于松开了手。这是你第一次授予的枷锁，是禁闭者无法违抗的命令。","style":3,"background":50702,"log_type":1},{"step":41,"content":"你引领着不再反抗的赫卡蒂，走到老人面前，半跪下来，保持平视地对他说话。","style":3,"background":702,"log_type":1},{"step":42,"speaker":"老人","content":"回去……你……","voice":["vo_cgplot_7101039"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":43,"speaker":"选项","options":["老先生，我要去见哈梅尔了"],"jump":[44],"style":6,"background":702,"log_type":1},{"step":44,"speaker":"玩家","content":"能拜托你帮忙照看这个孩子吗？我想在你身边，她会很安全的。","style":2,"background":702,"log_type":1},{"step":45,"speaker":"老人","content":"乐园不欢迎你……哈梅尔她不会见你……","voice":["vo_cgplot_7101043"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":46,"speaker":"选项","options":["没关系，是我去见她"],"jump":[47],"style":6,"background":702,"log_type":1},{"step":47,"speaker":"老人","content":"……你要一个人去……？","voice":["vo_cgplot_7101045"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":48,"speaker":"选项","options":["是的，我要把她们带回来"],"jump":[49],"style":6,"background":702,"log_type":1},{"step":49,"speaker":"${PlayerName}","content":"我最重要的人们被困在嘉年华，我不能让她们孤独地留在那儿。","style":2,"background":702,"log_type":1},{"step":50,"speaker":"老人","content":"……最重要的人……","voice":["vo_cgplot_7101048"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":51,"content":"他恍惚间抬眼看你，试图回忆什么，又像在努力看清你。","style":3,"background":702,"log_type":1},{"step":52,"speaker":"老人","content":"……我也一样……","voice":["vo_cgplot_7101050"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":53,"speaker":"老人","content":"我也想……带她回来……","voice":["vo_cgplot_7101051"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":54,"content":"他的声音变了。老人从怀里掏出了一个吊坠，打开吊坠，里面是一张微旧的照片。","style":3,"background":702,"log_type":1},{"step":55,"content":"照片中是一个美丽的女子，海蓝色的长发，玫红色的双眸。她静静看着镜头，温柔地笑着。","style":3,"background":702,"log_type":1},{"step":56,"speaker":"选项","options":["她是谁……？"],"jump":[57],"style":6,"background":702,"log_type":1},{"step":57,"content":"老人没有回答你的问题，只颤抖着喃喃自语。","style":3,"background":702,"log_type":1},{"step":58,"speaker":"老人","content":"我也想再见到她……我想再看她跳舞……","voice":["vo_cgplot_7101056"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":59,"speaker":"老人","content":"拜托你……带她回来……","voice":["vo_cgplot_7101057"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":60,"speaker":"呵呵，亚伯那事儿才过几年啊，贝纳戴特还对议长的位置有想法……这次之后卡文迪许家族恐怕再也爬不起来咯。","content":"……别让她孤单一人……我本不想……让她孤单一人……","voice":["vo_cgplot_7101058"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":61,"speaker":"老人","content":"我想……向她道歉……","voice":["vo_cgplot_7101059"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":62,"content":"他抬头看你，透过那浑浊的双眼，你看到跟照片中相似的玫红色的眼瞳。","style":3,"background":702,"log_type":1},{"step":63,"speaker":"选项","options":["我会的"],"jump":[64],"style":6,"background":702,"log_type":1},{"step":64,"content":"你接过老人的吊坠。","style":3,"background":702,"log_type":1},{"step":65,"content":"幻境放大了你的感官，你感受到吊坠上沉重的思念，以及某种熟悉的气息——禁闭者的气息，幻境主人的气息。","style":3,"background":702,"log_type":1},{"step":66,"speaker":"选项","options":["枷锁，带我去画中人的所在"],"jump":[67],"style":6,"background":702,"log_type":1},{"step":67,"content":"紧握吊坠的手中泛起红光，凝成荆棘，向前蜿蜒，你跟了上去。","style":3,"background":702,"log_type":1},{"step":68,"content":"穿过无数次折返的入口，穿过纷飞的彩带——","style":3,"background":702,"log_type":1},{"step":69,"content":"穿过游行，音乐声和狂欢声渐渐飘远——","style":3,"background":704,"log_type":1},{"step":70,"content":"在枷锁的指引下，你找到一片宁静的湖水，见到了画中的女子。","style":3,"background":10006,"log_type":1},{"step":71,"content":"氤氲水汽之间，一个个相框在湖面沉浮。湖的中央，她身着白色舞裙，斜倚相框，在静止的时光中浅眠。","style":3,"background":50703,"log_type":1},{"step":72,"speaker":"选项","options":["哈梅尔……？"],"jump":[73],"style":6,"background":50703,"log_type":1},{"step":73,"content":"她微睁双眼。","style":3,"background":50703,"log_type":1},{"step":74,"speaker":"哈梅尔","content":"……观众来了……","voice":["vo_cgplot_7101070"],"voice_bank":"vo_cgplot_07","style":1,"background":50704,"log_type":1},{"step":75,"speaker":"哈梅尔","content":"要开始跳舞了……","voice":["vo_cgplot_7101071"],"voice_bank":"vo_cgplot_07","style":1,"background":50704,"log_type":1},{"step":77,"content":"她的脚尖轻轻点触着湖面，泛起涟漪，舞者登上了她的舞台。","style":3,"background":708,"log_type":1}]}