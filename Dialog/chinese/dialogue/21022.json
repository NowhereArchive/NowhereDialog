{"id":21022,"chapter_id":19,"scene_id":1902,"steps":[{"step":2,"speaker":"萨依娜","content":"可恶，追！","voice":["vo_cgplot_21032002"],"voice_bank":"vo_cgplot_2103","style":1,"background":2000,"log_type":1},{"step":3,"content":"眼睁睁看着两人消失在眼前，萨依娜暗骂一声就要即刻追上去。","style":3,"background":2000,"log_type":1},{"step":4,"content":"一个矫健的人影先一步拦在她面前。","style":3,"background":2000,"log_type":1},{"step":5,"speaker":"萨依娜","content":"你要干什么？！","voice":["vo_cgplot_21032200"],"voice_bank":"vo_cgplot_2103","style":1,"background":2000,"log_type":1},{"step":6,"speaker":"荷尔加","content":"回去，这是命令！","voice":["vo_cgplot_21032201"],"voice_bank":"vo_cgplot_2103","style":1,"background":2000,"log_type":1},{"step":7,"content":"那是来自远邦大家长的威压，让她有些喘不过气来。这次行动确实是由荷尔加带队的……可仇恨与怒火已经冲灭了她的理智，她依旧梗着脖子与之对视。","style":3,"background":2000,"log_type":1},{"step":8,"speaker":"萨依娜","content":"凭什么，狄斯的老鼠都敢钻进去我们有什么不敢？","voice":["vo_cgplot_21032202"],"voice_bank":"vo_cgplot_2103","style":1,"background":2000,"log_type":1},{"step":9,"speaker":"荷尔加","content":"没有普通人能在这种烈度的灰烬之潮里生还，什么都没准备，你想让大家跟着你送死吗？","voice":["vo_cgplot_21032203"],"voice_bank":"vo_cgplot_2103","style":1,"background":2000,"log_type":1},{"step":10,"speaker":"萨依娜","content":"那就我一个人去，贪生怕死的人尽管留在后面！说得跟你多在乎我们一样，同胞被欺辱牺牲的时候你不站出来，现在连两个被费沙抛弃、脱离狄斯保护的老鼠都不敢追！","voice":["vo_cgplot_21032204"],"voice_bank":"vo_cgplot_2103","style":1,"background":2000,"log_type":1},{"step":11,"content":"<size=52><b>啪——！</size></b>","style":3,"background":10006,"log_type":1},{"step":12,"content":"突如其来的力道让萨依娜的神智断线了数秒，反应过来的时候右脸痛得像是被枪对着轰过。","style":3,"background":2000,"log_type":1},{"step":13,"content":"荷尔加没再理会她的叫嚣，而是从车上掏出两副防护用具，丢到萨依娜的身上。","style":3,"background":2000,"log_type":1},{"step":14,"speaker":"荷尔加","content":"蠢到这种程度，就算活着回来也别说是我的人！","voice":["vo_cgplot_21032207"],"voice_bank":"vo_cgplot_2103","style":1,"background":2000,"log_type":1},{"step":16,"content":"与此同时，伤痕带内……","style":3,"background":2456,"log_type":1},{"step":17,"content":"伊帕希娅摇晃着脑袋，从滚筒洗衣机般的混乱中清醒过来。放眼望去，眼前是一片空旷的灰雾。","style":3,"background":2456,"log_type":1},{"step":18,"speaker":"伊帕希娅","content":"……玛格丽塔小姐？……锈先生？","voice":["vo_cgplot_21051001"],"voice_bank":"vo_cgplot_2105","style":1,"background":2456,"log_type":1}]}