{"id":404300102,"chapter_id":50088,"scene_id":58802,"steps":[{"step":1,"content":"【黑屏、落雨】","style":18,"background":10000,"log_type":1},{"step":2,"content":"几近破碎的意识空间内，空气中弥漫着雨水的腥气。","style":3,"background":10000,"log_type":1},{"step":3,"content":"不远处的半空中飘摇着细碎的光点。而在光点没照亮的地方，无尽的黑暗吞噬一切。","style":3,"background":10000,"log_type":1},{"step":4,"content":"你隐约感知到黑暗中的危险，于是循着那些光点向意识深处走去。","style":3,"background":10000,"log_type":1},{"step":5,"content":"【白色交互点】","style":26,"background":10000,"log_type":1},{"step":6,"content":"当你触及到那些白色光点时，有人声从四面八方依稀传来。","style":3,"background":10000123,"log_type":1},{"step":7,"speaker":"不知名的问话","content":"你的姓名？","voice":["vo_event_404300102_06"],"voice_bank":"vo_event_43001","style":1,"background":10000123,"log_type":1},{"step":8,"speaker":"女人的声音","content":"希露妲·赫德莱茵。","voice":["vo_event_404300102_07"],"voice_bank":"vo_event_43001","style":1,"background":10000123,"log_type":1},{"step":9,"content":"【第二个交互点】","style":26,"background":10000123,"log_type":1},{"step":10,"speaker":"不知名的问话","content":"你的身份是什么？","voice":["vo_event_404300102_09"],"voice_bank":"vo_event_43001","style":1,"background":10000124,"log_type":1},{"step":11,"speaker":"女人的声音","content":"我将作为一名研究学者前往狄斯大学，研究电波与通讯。","voice":["vo_event_404300102_10"],"voice_bank":"vo_event_43001","style":1,"background":10000124,"log_type":1},{"step":12,"content":"【第三个交互点】","style":26,"background":10000124,"log_type":1},{"step":13,"speaker":"不知名的问话","content":"你实际的任务是什么？","voice":["vo_event_404300102_12"],"voice_bank":"vo_event_43001","style":1,"background":10000125,"log_type":1},{"step":14,"speaker":"女人的声音","content":"支援宗主城情报保密局，监视狄斯境内的情报，将其破译后传递回来。","voice":["vo_event_404300102_13"],"voice_bank":"vo_event_43001","style":1,"background":10000125,"log_type":1},{"step":15,"speaker":"女人的声音","content":"<color=#fb9259>同时……在此期间，向城邦证明自己的“价值”。</color>","voice":["vo_event_404300102_14"],"voice_bank":"vo_event_43001","style":1,"background":10000125,"log_type":1},{"step":16,"content":"（缓慢白屏后展示污染CG）","style":18,"background":10006,"hide_button":true,"log_type":1},{"step":17,"content":"穿过那些残存虚弱的意识，你来到了这片黑暗中唯一的落脚处。","style":3,"background":10006,"log_type":1},{"step":18,"content":"（动态CG-污染，逐步摇晃到脸部）","style":30,"background":10000,"log_type":1},{"step":19,"content":"你找到她了。","style":3,"background":10000,"log_type":1},{"step":20,"content":"她蜷身在狂厄化作的污泥当中，缠绕着身体的污染与荆棘似乎在拒绝任何人的靠近。","style":3,"background":10000,"log_type":1},{"step":22,"options":["喊她的名字","尝试攻击她","跟她谈谈条件"],"jump":[23,26,30,0,32],"style":17,"background":10000,"log_type":1},{"step":23,"speaker":"局长","content":"希露妲，是你吗？","style":2,"background":10000,"log_type":1},{"step":24,"content":"她的眼睛微颤，好像听到了你的声音，但没有更多动作。","style":3,"background":10000,"log_type":1},{"step":25,"options":["尝试攻击她"],"jump":[22],"style":7,"background":10000,"log_type":1},{"step":26,"content":"毕竟是宗主城的间谍，你也没必要对她太过客气，面对那些阻挡了你的狂厄污秽时，你毫不犹豫地对她使用了枷锁。","style":3,"background":10000,"log_type":1},{"step":28,"content":"枷锁迅速扫清了周围的狂厄，却在撞到她身上的荆棘时失去了效果，你意识到那不是狂厄对她的束缚，而是另外的力量。","style":3,"background":10000,"log_type":1},{"step":29,"options":["跟她谈谈条件"],"jump":[22],"style":7,"background":10000,"log_type":1},{"step":30,"content":"条件只能跟听得见、听得懂的人谈，显然现在的她没有这个能力。","style":3,"background":10000,"log_type":1},{"step":31,"content":"（全部选择完毕）","jump":[22],"style":7,"background":10000,"log_type":1},{"step":32,"content":"你试过了各种方法之后，眼前这几乎濒死的女人终于有了一丝反应，她的眼珠动了动，目光落到了你的身上。","style":3,"background":10000,"log_type":1},{"step":33,"speaker":"希露妲","content":"这里……是我的大脑。","voice":["vo_event_404300102_31"],"voice_bank":"vo_event_43001","style":1,"background":10000,"log_type":1},{"step":34,"speaker":"希露妲","content":"你……是谁？你是怎么进来的？","voice":["vo_event_404300102_32"],"voice_bank":"vo_event_43001","style":1,"background":10000,"log_type":1},{"step":37,"options":["拿出真实身份，要求她配合调查","编造一个她可以接受的身份"],"voice":["vo_event_404300102_32"],"voice_bank":"vo_event_43001","style":34,"background":10000,"log_type":1}]}