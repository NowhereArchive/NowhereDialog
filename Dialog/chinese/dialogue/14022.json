{"id":14022,"chapter_id":14,"scene_id":1404,"steps":[{"step":1,"content":"HUSH曾有绝对优势，它们进入战场后迅速逼退袭击者，破坏很多狂厄傀儡，控制了局势。","style":3,"background":2337,"log_type":1},{"step":2,"content":"但环顾四周，这显然不是最终的胜利。","style":3,"background":2337,"log_type":1},{"step":3,"content":"在你蹲下查看残破不堪的HUSH废甲时，同僚递来一份报告。","style":3,"background":2337,"log_type":1},{"step":4,"speaker":"FAC士兵","content":"狂厄场污染很重，只有一台HUSH机体留下少量数据，这是它从紧急启动到被彻底破坏前的能耗曲线。","voice":["vo_cgplot_14022005"],"voice_bank":"vo_cgplot_1402","style":1,"background":2337,"log_type":1},{"step":5,"content":"你接过报表，细看。","style":3,"background":2337,"log_type":1},{"step":6,"speaker":"${PlayerName}","content":"启动后立刻进入战斗状态，能耗在正常作战水平，16分钟左右开始下滑。HUSH占了优势，控制住局面。然后……","style":2,"background":2337,"log_type":1},{"step":7,"speaker":"${PlayerName}","content":"这是……？","style":2,"background":2337,"log_type":1},{"step":8,"content":"18分左右，本来已经退出战斗状态的机体能耗竟再次攀升，并一直暴涨超过警告阈值。","style":3,"background":2315,"log_type":1},{"step":9,"speaker":"FAC士兵","content":"是的，战斗还在继续……","voice":["vo_cgplot_14022010"],"voice_bank":"vo_cgplot_1402","style":1,"background":2315,"log_type":1}]}