8,"drawing":1050502},{"step":85,"speaker":"渡鸦","content":"不过有一点你说对了，之前想引起你的注意，的确跟之前受伤了有关。","voice":["vo_trial_50501_1_81"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501079,"trial_step":79,"drawing":1050502},{"step":86,"content":"渡鸦很努力地想抬起右边的胳膊，但却只能抬到和椅子的扶手水平。","style":3,"log_type":1,"src_id":150501080,"trial_step":80,"drawing":1050500},{"step":87,"content":"你看向她的胳膊，紫色的披肩之下，掩藏着白色的绷带——那应该是当时为了帮你脱困才受的伤。","style":3,"log_type":1,"src_id":150501081,"trial_step":81,"drawing":1050500},{"step":88,"speaker":"玩家","content":"抱歉，没想到会变成这样……","style":2,"log_type":1,"src_id":150501082,"trial_step":82,"drawing":1050500},{"step":89,"speaker":"渡鸦","content":"哈哈，那都是过去的事了，别在乎别在乎，我伤得也没你想得那么重，只是没以前那么方便了。","voice":["vo_trial_50501_1_85"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501083,"trial_step":83,"drawing":1050502},{"step":90,"speaker":"渡鸦","content":"没办法像过去那样精准地使用能力，续航上也比原先差了一截。","voice":["vo_trial_50501_1_86"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501084,"trial_step":84,"drawing":1050503},{"step":91,"speaker":"渡鸦","content":"所以，关于你刚才说的“单凭你自己的能力就可以办到”那句……","voice":["vo_trial_50501_1_87"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501085,"trial_step":85,"drawing":1050503},{"step":92,"speaker":"渡鸦","content":"很遗憾，办不到。也正因如此，我需要一位可靠的盟友帮助……也就是你。","voice":["vo_trial_50501_1_88"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501086,"trial_step":86,"drawing":1050503},{"step":93,"content":"你看着渡鸦的眼睛。末了，叹了口气。","style":3,"log_type":1,"src_id":150501087,"trial_step":87,"drawing":1050503},{"step":94,"options":["你想要我帮你做什么？"],"style":6,"log_type":1,"src_id":150501088,"trial_step":88,"course":3,"drawing":1050503,"choices":[{"text":"你想要我帮你做什么？","goto":89}]},{"step":95,"speaker":"渡鸦","content":"我想……","voice":["vo_trial_50501_1_91"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501089,"trial_step":89,"drawing":1050503},{"step":96,"content":"渡鸦顿了顿，但似乎又像是想起什么事情一样笑了笑。","style":3,"log_type":1,"src_id":150501090,"trial_step":90,"drawing":1050503},{"step":97,"speaker":"渡鸦","content":"在那个地方，重新建一座学校，建一座真正意义上属于辛迪加孩子们的学校。","voice":["vo_trial_50501_1_93"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501091,"trial_step":91,"drawing":1050502},{"step":98,"speaker":"玩家","content":"那锈火的人呢，他们没帮你？","style":2,"log_type":1,"src_id":150501092,"trial_step":92,"drawing":1050502},{"step":99,"speaker":"渡鸦","content":"我曾经的那位“建筑师”朋友倒是的确答应过我……","voice":["vo_trial_50501_1_95"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501093,"trial_step":93,"drawing":1050502},{"step":100,"speaker":"渡鸦","content":"可惜，他已经无法履约了。","voice":["vo_trial_50501_1_96"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501094,"trial_step":94,"drawing":1050502},{"step":101,"speaker":"渡鸦","content":"这种时候，去揭锈火剩下那些人的伤疤，未免也太不近人情了。","voice":["vo_trial_50501_1_97"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501095,"trial_step":95,"drawing":1050504},{"step":102,"speaker":"渡鸦","content":"更何况，他们如今也有自己的事要做。我自然也没有资格去让他们扔下手中的工作来帮我。","voice":["vo_trial_50501_1_98"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501096,"trial_step":96,"drawing":1050504},{"step":103,"speaker":"渡鸦","content":"我所有的依靠，就只有你了。拜托你，为了辛迪加孩子们的未来……","voice":["vo_trial_50501_1_99"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501097,"trial_step":97,"drawing":1050504},{"step":104,"content":"渡鸦此刻的眼神，出奇地清澈真诚，甚至带着些许雾气，仿佛下一刻就要流出眼泪。","style":3,"log_type":1,"src_id":150501098,"trial_step":98,"drawing":1050504},{"step":105,"content":"“演技一如既往”，你腹诽着，却还是忍不住思考起她这次的请求。","style":3,"log_type":1,"src_id":150501099,"trial_step":99,"drawing":1050504},{"step":106,"content":"虽然这家伙有点想一出是一出的，但办学校这件事，她似乎挺认真的。","style":3,"log_type":1,"src_id":150501100,"trial_step":100,"drawing":1050504},{"step":107,"content":"虽然她为了“向你求助”，搞了一出莫名其妙、南辕北辙的大戏，但倒也努力控制在了合理的范围——毕竟除了浪费了你和MBCC员工的时间外，没有造成其他实际损失。","style":3,"log_type":1,"src_id":150501101,"trial_step":101,"drawing":1050504},{"step":108,"content":"建一所学校对于MBCC的施工队来说应该不是一件难事。不过你总觉得有更麻烦的事在后面等着你。","style":3,"log_type":1,"src_id":150501102,"trial_step":102,"drawing":1050504},{"step":109,"content":"你深吸了一口气，准备和渡鸦好好聊聊。","style":3,"log_type":1,"src_id":150501103,"trial_step":103,"drawing":1050504},{"step":110,"options":["我帮你建学校","我最近有点忙……"],"style":6,"log_type":1,"src_id":150501104,"trial_step":104,"course":3,"drawing":1050504,"choices":[{"text":"我帮你建学校","goto":105},{"text":"我最近有点忙……","goto":null}]},{"step":111,"speaker":"玩家","content":"我……","style":2,"log_type":1,"src_id":150501105,"trial_step":105,"drawing":1050504},{"step":112,"speaker":"渡鸦","content":"你想帮我了？","voice":["vo_trial_50501_1_108"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501106,"trial_step":106,"drawing":1050502},{"step":113,"content":"在你刚说出第一个字的时候，面前的禁闭者便咧嘴笑了起来，一点没有了刚刚那副泫然欲泣的表情。","style":3,"log_type":1,"src_id":150501107,"trial_step":107,"drawing":1050502},{"step":114,"speaker":"玩家","content":"……","style":2,"log_type":1,"src_id":150501108,"trial_step":108,"drawing":1050502},{"step":115,"speaker":"玩家","content":"我想知道，你为什么对重建学校这么执着。","style":2,"log_type":1,"src_id":150501109,"trial_step":109,"drawing":1050502},{"step":116,"speaker":"渡鸦","content":"很简单，孩子是西区的未来。想要这片土地能重新崛起，教育是必不可少的。","voice":["vo_trial_50501_1_112"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501110,"trial_step":110,"drawing":1050502},{"step":117,"options":["那学校的老师呢？"],"style":6,"log_type":1,"src_id":150501111,"trial_step":111,"course":3,"drawing":1050502,"choices":[{"text":"那学校的老师呢？","goto":112}]},{"step":118,"speaker":"渡鸦","content":"远在天边，近在眼前——","voice":["vo_trial_50501_1_114"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501112,"trial_step":112,"drawing":1050502},{"step":119,"speaker":"渡鸦","content":"当然是由鄙人亲自担任。","voice":["vo_trial_50501_1_115"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501113,"trial_step":113,"drawing":1050503},{"step":120,"speaker":"玩家","content":"……别的老师呢。","style":2,"log_type":1,"src_id":150501114,"trial_step":114,"drawing":1050503},{"step":121,"speaker":"渡鸦","content":"你是不相信辛迪加一流记者的文学素养，还是不相信狄斯诗人的绝代风华，又还是不相信锈火模范成员的学习能力？","voice":["vo_trial_50501_1_117"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501115,"trial_step":115,"drawing":1050503},{"step":122,"speaker":"渡鸦","content":"况且，在锈火的时候，我还教过一阵那帮流浪儿，这么说来，除了没有教师资格证，我应该和全才的老师直接画上等号。","voice":["vo_trial_50501_1_118"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501116,"trial_step":116,"drawing":1050503},{"step":123,"speaker":"玩家","content":"我听说那些孩子在你去新城那阵跑得一个都不剩。","style":2,"log_type":1,"src_id":150501117,"trial_step":117,"drawing":1050503},{"step":124,"speaker":"渡鸦","content":"啧……","voice":["vo_trial_50501_1_120"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501118,"trial_step":118,"drawing":1050501},{"step":125,"speaker":"渡鸦","content":"哦~你睡觉的时候，这里关着的禁闭者们可也没剩下几个。","voice":["vo_trial_50501_1_121"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501119,"trial_step":119,"drawing":1050502},{"step":126,"speaker":"玩家","content":"……","style":2,"log_type":1,"src_id":150501120,"trial_step":120,"drawing":1050502},{"step":127,"content":"眼见呛得你有些面色不善，渡鸦又赶忙转变口风。","style":3,"log_type":1,"src_id":150501121,"trial_step":121,"drawing":1050502},{"step":128,"speaker":"渡鸦","content":"啊呀，咱们先别互相损了……你想想辛迪加的未来啊。","voice":["vo_trial_50501_1_124"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501122,"trial_step":122,"drawing":1050502},{"step":129,"speaker":"渡鸦","content":"正所谓“皮之不存，毛将焉附？”，老师也好，学生也好，在学校没建起之前，他们也只是辛迪加的成年人和孩子。","voice":["vo_trial_50501_1_125"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501123,"trial_step":123,"drawing":1050502},{"step":130,"speaker":"渡鸦","content":"但是等学校建好，他们的身份就有了被重新定义的基础。到时候锈火那边估计也忙完了。我就把洛夫娜他们都叫过来，这师资问题不就解决了吗？","voice":["vo_trial_50501_1_126"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501124,"trial_step":124,"drawing":1050502},{"step":131,"speaker":"渡鸦","content":"学生自然也是不缺，到时候让流浪儿那帮孩子重新回来上课就行了。","voice":["vo_trial_50501_1_127"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501125,"trial_step":125,"drawing":1050502},{"step":132,"speaker":"渡鸦","content":"怎么样，听完我说的，是不是觉得只差一个学校，就可以给辛迪加重新带回希望了？","voice":["vo_trial_50501_1_128"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501126,"trial_step":126,"drawing":1050502},{"step":133,"content":"你下意识点了点头，却又立马发觉还有些不对。","style":3,"log_type":1,"src_id":150501127,"trial_step":127,"drawing":1050502},{"step":134,"options":["学校的教材呢？"],"style":6,"log_type":1,"src_id":150501128,"trial_step":128,"course":3,"drawing":1050502,"choices":[{"text":"学校的教材呢？","goto":129}]},{"step":135,"speaker":"玩家","content":"出版社联系好了么，书号申请到了没有？用不用我帮你？","style":2,"log_type":1,"src_id":150501129,"trial_step":129,"drawing":1050502},{"step":136,"speaker":"渡鸦","content":"……","voice":["vo_trial_50501_1_132"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501130,"trial_step":130,"drawing":1050501},{"step":137,"speaker":"渡鸦","content":"这个嘛……","voice":["vo_trial_50501_1_133"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501131,"trial_step":131,"drawing":1050501},{"step":138,"content":"面对着你的关切，渡鸦反而罕见地别开了头，不与你的视线相交。","style":3,"log_type":1,"src_id":150501132,"trial_step":132,"drawing":1050501},{"step":139,"speaker":"玩家","content":"在没有其他的老师之前，你总不会打算只教孩子们写诗吧。","style":2,"log_type":1,"src_id":150501133,"trial_step":133,"drawing":1050501},{"step":140,"speaker":"渡鸦","content":"我好歹也是从新城正经大学毕……出来的，当然也考虑过，只是目前来说，我没有能出教材的预算。","voice":["vo_trial_50501_1_136"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501134,"trial_step":134,"drawing":1050501},{"step":141,"speaker":"渡鸦","content":"哎呀，在流民寨的那阵时间，我自己也写过几十册教材，编了几百首诗歌，但光是这样就已经用掉了我几年的时间了。剩下的全部现编确实有些困难……","voice":["vo_trial_50501_1_137"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501135,"trial_step":135,"drawing":1050501},{"step":142,"speaker":"渡鸦","content":"所以这次我打算用最快的方法——","voice":["vo_trial_50501_1_138"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501136,"trial_step":136,"drawing":1050503},{"step":143,"speaker":"玩家","content":"最快的方法？","style":2,"log_type":1,"src_id":150501137,"trial_step":137,"drawing":1050503},{"step":144,"speaker":"渡鸦","content":"当然就是“借”上几本新城的教材……改改之后直接用呗。","voice":["vo_trial_50501_1_140"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501138,"trial_step":138,"drawing":1050503},{"step":145,"speaker":"玩家","content":"这方面你的道德底线到是挺灵活的。","style":2,"log_type":1,"src_id":150501139,"trial_step":139,"drawing":1050503},{"step":146,"speaker":"渡鸦","content":"读书人的事，不就是互相借鉴学习嘛，不丢人的。","voice":["vo_trial_50501_1_142"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501140,"trial_step":140,"drawing":1050502},{"step":147,"speaker":"渡鸦","content":"除了“借”，我还打算找人多画点插画放进去。辛迪加的那些孩子聪明倒是聪明，就是不怎么喜欢看字。","voice":["vo_trial_50501_1_143"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501141,"trial_step":141,"drawing":1050502},{"step":148,"speaker":"渡鸦","content":"等换上带图的教材，小鬼们肯定喜欢得不得了。到时候把我的那些名作也加在图里，让文学之名重新在这片土地上传颂……","voice":["vo_trial_50501_1_144"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501142,"trial_step":142,"drawing":1050502},{"step":149,"content":"渡鸦越说越兴奋，眼里闪着光，甚至开始手舞足蹈。","style":3,"log_type":1,"src_id":150501143,"trial_step":143,"drawing":1050502},{"step":150,"content":"你看着面前的“诗人”，不禁感叹，锈火这群人自始至终都没变过。","style":3,"log_type":1,"src_id":150501144,"trial_step":144,"drawing":1050502},{"step":151,"content":"就算是一缕渺茫的微光，他们也会不顾一切地追逐。","style":3,"log_type":1,"src_id":150501145,"trial_step":145,"drawing":1050502},{"step":152,"speaker":"于连","content":"希望是很宝贵的东西，即使是不理智的，也有着巨大的能量。","voice":["vo_trial_50501_1_149"],"voice_bank":"vo_raven_trial","style":1,"background":926,"log_type":1,"src_id":150501147,"trial_step":147,"drawing":1050502},{"step":153,"content":"是啊，就算一无所有，她也想带给孩子们希望。","style":3,"log_type":1,"src_id":150501148,"trial_step":148,"drawing":1050502},{"step":154,"speaker":"玩家","content":"那，学校名字定好了么？","style":2,"log_type":1,"src_id":150501149,"trial_step":149,"drawing":1050502},{"step":155,"speaker":"渡鸦","content":"当然早就想好了，就叫——","voice":["vo_trial_50501_1_152"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501150,"trial_step":150,"drawing":1050502},{"step":156,"speaker":"渡鸦","content":"辛迪加大学堂！","voice":["vo_trial_50501_1_153"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501151,"trial_step":151,"drawing":1050502},{"step":157,"content":"渡鸦高高举起先前由本人所说不能举起的右臂，向你高声诉说着学校的名字。","style":3,"log_type":1,"src_id":150501152,"trial_step":152,"drawing":1050502},{"step":158,"options":["……"],"style":6,"log_type":1,"src_id":150501153,"trial_step":153,"course":3,"drawing":1050502,"choices":[{"text":"……","goto":154}]},{"step":159,"speaker":"玩家","content":"你不是说自己受伤了么？","style":2,"log_type":1,"src_id":150501154,"trial_step":154,"drawing":1050502},{"step":160,"content":"渡鸦像触电一样将自己的右臂缩了回去。","style":3,"log_type":1,"src_id":150501155,"trial_step":155,"drawing":1050501},{"step":161,"speaker":"渡鸦","content":"嘶……啊……疼疼疼疼疼疼疼……这是回光返照，回光返照。","voice":["vo_trial_50501_1_158"],"voice_bank":"vo_raven_trial","style":1,"log_type":1,"src_id":150501156,"trial_step":156,"drawing":1050501},{"step":162,"speaker":"玩家","content":"……","style":2,"log_type":1,"src_id":150501157,"trial_step":157,"drawing":1050501},{"step":163,"content":"果然还是不能放心她一个人建学校。","style":3,"log_type":1,"src_id":150501158,"trial_step":158,"drawing":1050501}]}