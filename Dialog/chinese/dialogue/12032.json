{"id":12032,"chapter_id":12,"scene_id":1203,"steps":[{"step":1,"speaker":"“锈火成员”","content":"怎、怎么可能？就两个小丫头，我们这么多人，怎么会输？","voice":["vo_cgplot_12032001"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":2,"speaker":"“锈火成员”","content":"她刚刚说什么“局长”……","voice":["vo_cgplot_12032002"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":3,"speaker":"“锈火成员”","content":"我知道了！！她们是上头的人，是那些权贵养的*文明锈火*。是过来破坏锈火行动的！她们才不配当禁闭者！我们才是！！","voice":["vo_cgplot_12032003"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":4,"speaker":"“锈火成员”","content":"来呀！一起上，再去流民寨找人，人多的是呢！","voice":["vo_cgplot_12032004"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":5,"speaker":"赫卡蒂","content":"……在流民寨是吗？局长在流民寨吗？","voice":["vo_cgplot_12032005"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":6,"speaker":"赫卡蒂","content":"梦魇！","voice":["vo_cgplot_12032006"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":7,"content":"梦魇一声咆哮，清出一条道路，赫卡蒂直接跳上它的爪子，向流民寨方向撞去。","style":3,"background":935,"log_type":1},{"step":8,"speaker":"“锈火成员”","content":"拦住她！！干掉她！","voice":["vo_cgplot_12032008"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":9,"speaker":"海拉","content":"你们……在这叫什么呢……你姑奶奶我还在这里呢，兔崽子们想去哪儿啊……？","voice":["vo_cgplot_12032009"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":10,"content":"海拉水管抵地，勉强支撑着身体站了起来。","style":3,"background":935,"log_type":1},{"step":11,"content":"枷锁带来的负担太重，加上众多“禁闭者”的围攻，她还是受了伤。","style":3,"background":935,"log_type":1},{"step":12,"speaker":"海拉","content":"*文明狄斯*的，赫卡蒂你也跑太快了，我追不上啊……稍微等我一下，这点擦伤明明马上就好……","voice":["vo_cgplot_12032012"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":13,"speaker":"海拉","content":"*文明狄斯*的好痛……这个臭狗屎枷锁怎么偏偏在这个时候出毛病……猪头，笨*……你不在，看看那个笨蛋变成啥样了……","voice":["vo_cgplot_12032013"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":14,"content":"咆哮的混混们从后面追来，要赶上赫卡蒂离开的方向。","style":3,"background":935,"log_type":1},{"step":15,"speaker":"海拉","content":"但……也没办法，谁让那个人是${PlayerName}呢……你要是没了，赫卡蒂又得被关回那个实验室了。","voice":["vo_cgplot_12032015"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":16,"speaker":"海拉","content":"拦不住的话，就好好加油吧，赫卡蒂……去把${PlayerName}找回来……","voice":["vo_cgplot_12032016","vo_cgplot_12032016f"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":17,"speaker":"海拉","content":"后面这群家伙不会挡你道的。","voice":["vo_cgplot_12032017"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1},{"step":18,"speaker":"海拉","content":"我……不会让他们挡道的！！","voice":["vo_cgplot_12032018"],"voice_bank":"vo_cgplot_1203","style":1,"background":935,"log_type":1}]}