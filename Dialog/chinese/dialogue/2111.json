{"id":2111,"chapter_id":2,"scene_id":211,"steps":[{"step":1,"speaker":"安","content":"咳咳……我还好，谢谢你们……","voice":["vo_cgplot_2111001"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":2,"speaker":"安","content":"那孩子呢？她怎么样了？","voice":["vo_cgplot_2111002"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":3,"content":"灰发少女还挡在泰德离去的路上，她已经濒临崩溃，污染几乎侵染了每一个细胞，但她没有任何让步的意思。","style":3,"background":117,"log_type":1},{"step":4,"speaker":"海拉","content":"死也不让道呢，接下来她想亲自战斗吗？","voice":["vo_cgplot_2111004"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":5,"speaker":"赫卡蒂","content":"局长，不要犹豫。你还有任务，不能让泰德抢先。","voice":["vo_cgplot_2111005"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":6,"speaker":"安","content":"请等一等……","voice":["vo_cgplot_2111006"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":7,"content":"安勉强撑起身子，护理服上的血印又扩大了许多。","style":3,"background":117,"log_type":1},{"step":8,"speaker":"安","content":"我和你们一起战斗，让我来阻止她。","voice":["vo_cgplot_2111008"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":9,"content":"她颤抖着捡起一支注射器，握在手心——药剂的颜色变了，在注射了这管橙色药剂之后，她站了起来。","style":3,"background":117,"log_type":1},{"step":10,"speaker":"赫卡蒂","content":"那是强心针吗？她用能力改变了药剂属性。","voice":["vo_cgplot_2111010"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":11,"speaker":"海拉","content":"等等，你的伤！这太勉强了，会死人的！","voice":["vo_cgplot_2111011"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":12,"speaker":"安","content":"你在担心我吗？谢谢，我没事的。","voice":["vo_cgplot_2111012"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":13,"speaker":"安","content":"真正痛苦的人，是她。","voice":["vo_cgplot_2111013"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":14,"speaker":"安","content":"她的身体已经到了极限，再这么战斗下去，她很快就会被狂厄拖垮。","voice":["vo_cgplot_2111014"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":15,"speaker":"灰发少女","content":"…………","voice":["vo_cgplot_2111015"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":16,"speaker":"赫卡蒂","content":"没用的，那个人的行为模式已经固定了，她放弃了思考，只有泰德的命令能让她行动。","voice":["vo_cgplot_2111016"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":17,"speaker":"安","content":"她不想变成怪物，她只是……想回去。","voice":["vo_cgplot_2111017"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1},{"step":18,"speaker":"安","content":"我答应过，一定会救她的。","voice":["vo_cgplot_2111018"],"voice_bank":"vo_cgplot_02","style":1,"background":117,"log_type":1}]}