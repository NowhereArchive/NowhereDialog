{"id":1060401,"chapter_id":1060401,"scene_id":1,"steps":[{"step":1,"speaker":"花园成员A","content":"今天还顺利吗？没有被人发现吧。","voice":["vo_trial_60401_1_1"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401003,"trial_step":3},{"step":2,"speaker":"花园成员B","content":"放心，没有暴露。隐瞒身份也是刺客的必备技能。","voice":["vo_trial_60401_1_2"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401004,"trial_step":4},{"step":3,"speaker":"花园成员B","content":"只是恐怕还要委屈业师，继续和我们藏在这里了。","voice":["vo_trial_60401_1_3"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401005,"trial_step":5},{"step":4,"speaker":"花园成员B","content":"业师？","voice":["vo_trial_60401_1_5"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401007,"trial_step":7},{"step":5,"speaker":"花园成员A","content":"嘘——别打扰业师，继续保持对周围的警惕就好。","voice":["vo_trial_60401_1_6"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401008,"trial_step":8},{"step":6,"speaker":"花园成员B","content":"对了，今天上街的时候顺路转了转，发现一处废弃的公寓。","voice":["vo_trial_60401_1_7"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401009,"trial_step":9},{"step":7,"speaker":"花园成员B","content":"那里有很大的落地窗，阳光很好。还有一个天井，空间足够容纳我们所有人。","voice":["vo_trial_60401_1_8"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401010,"trial_step":10},{"step":8,"speaker":"花园成员A","content":"能容纳十几人的公寓，在辛迪加很少见吧，怎么会荒废？","voice":["vo_trial_60401_1_9"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401011,"trial_step":11},{"step":9,"speaker":"花园成员B","content":"很有可能是爆发过狂厄。不过对我们禁闭者倒是没有什么影响。","voice":["vo_trial_60401_1_10"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401012,"trial_step":12},{"step":10,"speaker":"花园成员B","content":"要搬去那儿住吗，业师？","voice":["vo_trial_60401_1_11"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401013,"trial_step":13},{"step":11,"content":"小屋里的众人将视线投向了窗边的白发女子。但她却好像没有听见大家的讨论，看着外面来来往往的人，兀自出神。","style":3,"background":1034,"log_type":1,"src_id":160401014,"trial_step":14},{"step":12,"speaker":"可可莉克","content":"啊，叫我吗？我说过，没有花园也没有业师了，叫我可可莉克大人就好。","voice":["vo_trial_60401_1_13"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401015,"trial_step":15},{"step":13,"speaker":"花园成员B","content":"可可莉克大人，我发现了一个很好的地方，可以作为花园的新家。","voice":["vo_trial_60401_1_14"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401016,"trial_step":16},{"step":14,"speaker":"可可莉克","content":"都说了没有花园了！咳咳咳……","voice":["vo_trial_60401_1_15"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401017,"trial_step":17},{"step":15,"content":"突然发作的脾气把众人吓得不敢作声。","style":3,"background":1034,"log_type":1,"src_id":160401018,"trial_step":18},{"step":16,"speaker":"花园成员A","content":"您的身体……","voice":["vo_trial_60401_1_17"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401019,"trial_step":19},{"step":17,"speaker":"可可莉克","content":"我没事……忙你们的去吧。","voice":["vo_trial_60401_1_18"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401020,"trial_step":20},{"step":18,"content":"像是意识到了自己的失态，可可莉克重新蜷缩回窗边。","style":3,"background":1034,"log_type":1,"src_id":160401021,"trial_step":21},{"step":19,"speaker":"瑟琳","content":"我可以给你生命，给你时间让你找到新的花园，也让你们彻底远离一切风波。","voice":["vo_trial_60401_1_21"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160401023,"trial_step":23},{"step":20,"content":"<color=#7683a2><i>呵……你最后还是操控我了吧……不然我怎么会这么蠢，居然信你的鬼话……</i></color>","voice":["vo_trial_60401_1_22"],"voice_bank":"vo_coquelicot_trial","style":3,"background":10006,"log_type":1,"src_id":160401024,"trial_step":24},{"step":21,"content":"<color=#7683a2><i>上庭的混蛋……你到哪里去了……又把她们藏哪儿了……</i></color>","voice":["vo_trial_60401_1_23"],"voice_bank":"vo_coquelicot_trial","style":3,"background":10006,"log_type":1,"src_id":160401025,"trial_step":25},{"step":22,"speaker":"可可莉克","content":"得快点找到她们……","voice":["vo_trial_60401_1_24"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401026,"trial_step":26},{"step":23,"content":"可可莉克有些不支地摔倒在泥潭里。白色的精致睡裙全是泥水。","style":3,"background":2108,"log_type":1,"src_id":160401027,"trial_step":27},{"step":24,"content":"换做平时她肯定会嫌弃地回去洗上一个温泉花瓣浴，但现在，和满身的伤痕血污相比，已经不算什么了。","style":3,"background":2108,"log_type":1,"src_id":160401028,"trial_step":28},{"step":25,"speaker":"？？？","content":"业师！我找到她们了！","voice":["vo_trial_60401_1_27"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401029,"trial_step":29},{"step":26,"speaker":"可可莉克","content":"蓟！只有这些吗……剩下的人呢？","voice":["vo_trial_60401_1_28"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401030,"trial_step":30},{"step":27,"speaker":"可可莉克","content":"加洛法诺呢！","voice":["vo_trial_60401_1_29"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401031,"trial_step":31},{"step":28,"content":"她们低下头没有回答。看着眼前重伤受挫的花园众人，一股滚烫的甜腥从可可莉克喉咙中涌出。","style":3,"background":2108,"log_type":1,"src_id":160401032,"trial_step":32},{"step":29,"content":"借着微弱的路灯，她们也终于看清了可可莉克满身的血痕。","style":3,"background":2108,"log_type":1,"src_id":160401033,"trial_step":33},{"step":30,"speaker":"可可莉克","content":"咳咳咳！咳咳……","voice":["vo_trial_60401_1_32"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401034,"trial_step":34},{"step":31,"speaker":"蓟","content":"业师！您怎么也受伤了！伤得那么重……","voice":["vo_trial_60401_1_33"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401035,"trial_step":35},{"step":32,"speaker":"可可莉克","content":"我没关系……你们什么时候见过我有事？","voice":["vo_trial_60401_1_34"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401036,"trial_step":36},{"step":33,"speaker":"可可莉克","content":"先别说那么多了，那群穿铠甲的狗鼻子可灵了。黄毛丫头为我们争取了时间，别让他们找到了。","voice":["vo_trial_60401_1_35"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401037,"trial_step":37},{"step":34,"speaker":"蓟","content":"克里斯蒂娜说，她们大多被送到辛迪加。我们去找她们，只要大家回来，花园还会——","voice":["vo_trial_60401_1_36"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401038,"trial_step":38},{"step":35,"content":"灯光昏暗的巷子尽头，装甲的声音匆匆而过。","style":3,"background":2108,"log_type":1,"src_id":160401039,"trial_step":39},{"step":36,"speaker":"可可莉克","content":"……听好了，花园在与FAC的对峙中，全军覆没。","voice":["vo_trial_60401_1_38"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401040,"trial_step":40},{"step":37,"speaker":"可可莉克","content":"以后，没有花园了。","voice":["vo_trial_60401_1_39"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401041,"trial_step":41},{"step":38,"speaker":"可可莉克","content":"话音未落，一道橙色人影便带着“禁闭者”能力从通风口飞跃而出，刹那间馆内所有系统全部瘫痪。","voice":["vo_trial_60401_1_40"],"voice_bank":"vo_coquelicot_trial","style":1,"background":2108,"log_type":1,"src_id":160401042,"trial_step":42},{"step":39,"content":"可可莉克没有抬头，好像是忌惮对上那些炙热而盼望的眼神。","style":3,"background":2108,"log_type":1,"src_id":160401043,"trial_step":43},{"step":40,"content":"她只是扶起一位重伤的同伴，用法杖支撑住身体，带着她们离开。","style":3,"background":2108,"log_type":1,"src_id":160401044,"trial_step":44},{"step":41,"content":"<color=#7683a2><i>还是别告诉她们了，白担心不说，还给自己添乱。</i></color>","voice":["vo_trial_60401_1_43"],"voice_bank":"vo_coquelicot_trial","style":3,"background":10006,"log_type":1,"src_id":160401045,"trial_step":45},{"step":42,"content":"<color=#7683a2><i>我的时间不多了，七天……再做些什么吧？</i></color>","voice":["vo_trial_60401_1_44"],"voice_bank":"vo_coquelicot_trial","style":3,"background":10006,"log_type":1,"src_id":160401046,"trial_step":46},{"step":43,"speaker":"可可莉克","content":"唔……","voice":["vo_trial_60401_1_46"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401048,"trial_step":48},{"step":44,"speaker":"花园成员A","content":"业师！您没事吧！是之前的伤又复发了吗？","voice":["vo_trial_60401_1_47"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401049,"trial_step":49},{"step":45,"speaker":"花园成员B","content":"上庭那个臭女人，我迟早要找她算账！","voice":["vo_trial_60401_1_48"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401050,"trial_step":50},{"step":46,"speaker":"花园成员A","content":"业师都不是她的对手……我们要怎么做，好不容易在辛迪加找到了一些同伴，又要出去当活靶子吗？","voice":["vo_trial_60401_1_49"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401051,"trial_step":51},{"step":47,"speaker":"花园成员B","content":"可……她伤了我们那么多花园的人，难道就不管了吗！","voice":["vo_trial_60401_1_50"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401052,"trial_step":52},{"step":48,"speaker":"可可莉克","content":"咳咳……谁说不管了……","voice":["vo_trial_60401_1_51"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401053,"trial_step":53},{"step":49,"speaker":"可可莉克","content":"花园的字典里没有“忍气吞声”，欠我的，我一定夺回来。","voice":["vo_trial_60401_1_52"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401054,"trial_step":54},{"step":50,"speaker":"可可莉克","content":"我不会让那些花朵白白受罪的。","voice":["vo_trial_60401_1_53"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401055,"trial_step":55},{"step":51,"content":"<color=#7683a2><i>只是，还需要一个时机，一个“被动”的机会。</i></color>","voice":["vo_trial_60401_1_54"],"voice_bank":"vo_coquelicot_trial","style":3,"background":1034,"log_type":1,"src_id":160401056,"trial_step":56},{"step":52,"speaker":"花园成员A","content":"业师在窗边坐了多少天了？","voice":["vo_trial_60401_1_55"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1051,"log_type":1,"src_id":160401057,"trial_step":57},{"step":53,"speaker":"花园成员B","content":"嘘，可能是在想事情吧，别去打扰她。","voice":["vo_trial_60401_1_56"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1051,"log_type":1,"src_id":160401058,"trial_step":58},{"step":54,"speaker":"花园成员B","content":"来厨房帮我吧，该给大家准备晚饭了。","voice":["vo_trial_60401_1_57"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1051,"log_type":1,"src_id":160401059,"trial_step":59},{"step":55,"content":"<color=#7683a2><i>时间，还剩五天。那家伙可真够坐得住的……</i></color>","voice":["vo_trial_60401_1_58"],"voice_bank":"vo_coquelicot_trial","style":3,"background":1051,"log_type":1,"src_id":160401060,"trial_step":60},{"step":56,"speaker":"花园成员A","content":"我去打听过了，那间废弃公寓确实曾受到过死役的影响。","voice":["vo_trial_60401_1_59"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401061,"trial_step":61},{"step":57,"speaker":"花园成员A","content":"曾经被黑帮占领过一段时间，但似乎因为火拼惨败，黑帮也离开了。","voice":["vo_trial_60401_1_60"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401062,"trial_step":62},{"step":58,"speaker":"花园成员B","content":"那或许我们可以住过去，重新建起一个安身的据点。","voice":["vo_trial_60401_1_61"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401063,"trial_step":63},{"step":59,"speaker":"花园成员B","content":"在新的据点，加倍地训练。总有一天要替所有花园人，讨回公道。","voice":["vo_trial_60401_1_62"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401064,"trial_step":64},{"step":60,"speaker":"花园成员A","content":"那我要在天井种很多花，做个天井花园……","voice":["vo_trial_60401_1_63"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401065,"trial_step":65},{"step":61,"speaker":"花园成员A","content":"那些被破坏的花，一定还会重新长出来的。","voice":["vo_trial_60401_1_64"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1034,"log_type":1,"src_id":160401066,"trial_step":66},{"step":62,"speaker":"花园成员B","content":"嗯，业师一定也