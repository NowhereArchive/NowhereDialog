{"id":400704201,"chapter_id":50019,"scene_id":51906,"steps":[{"step":1,"content":"咔嚓，咔嚓。","style":3,"background":2080,"log_type":1},{"step":2,"content":"迷雾中的剪刀声仍未停歇，你想快跑几步跟上那团灯火。","style":3,"background":2080,"log_type":1},{"step":3,"content":"至少，多个伴也好。","style":3,"background":2080,"log_type":1},{"step":4,"content":"但灯火闪烁，移动到了离你更远的地方。","style":3,"background":2080,"log_type":1}]}