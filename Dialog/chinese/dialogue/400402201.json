{"id":400402201,"chapter_id":50016,"scene_id":51626,"steps":[{"step":1,"speaker":"小黛丝","content":"这么一直被追杀不是个办法，我得找个机会和他们谈谈。","voice":["vo_event_400402201_1"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":2,"speaker":"洛芙","content":"你疯了黛丝。你来辛迪加也不是一年两年了，总该知道混帮派的都是些什么货色吧？","voice":["vo_event_400402201_2"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":3,"speaker":"小黛丝","content":"就算是混帮派的，也还是能讲道理的吧。","voice":["vo_event_400402201_3"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":4,"speaker":"小黛丝","content":"至少得弄清楚那个“老大的儿子”究竟是怎么回事。","voice":["vo_event_400402201_4"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":5,"speaker":"嗷呜","content":"说到这个！谈判这种事情我可懂了。","voice":["vo_event_400402201_5"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":6,"speaker":"嗷呜","content":"电影里的人都会穿上一身最沉稳帅气的衣服，在昏暗的房间里，看着特别吓人！","voice":["vo_event_400402201_6"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":7,"speaker":"嗷呜","content":"只要是正常人就会被你的气质吓住，不敢对你动手动脚，气势上也就矮了一头。到时候还不是你说什么就是什么。","voice":["vo_event_400402201_7"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":8,"speaker":"洛芙","content":"黛丝，她说得好像很有道理诶。","voice":["vo_event_400402201_8"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":9,"speaker":"小黛丝","content":"你认真的吗？","voice":["vo_event_400402201_9"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":10,"speaker":"洛芙","content":"该不会是怯场了吧？","voice":["vo_event_400402201_10"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":11,"speaker":"小黛丝","content":"好吧……我演……","voice":["vo_event_400402201_11"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":13,"speaker":"“教母”黛丝","content":"“包菜沙拉，包菜沙拉……”","voice":["vo_event_400402201_15"],"voice_bank":"vo_event_04022","style":1,"background":4049,"log_type":1},{"step":14,"speaker":"“教母”黛丝","content":"“告诉我，那个男孩是谁，他到底做了什么，让你如此不尊重我？”","voice":["vo_event_400402201_16"],"voice_bank":"vo_event_04022","style":1,"background":4049,"log_type":1},{"step":15,"speaker":"帮派小弟","content":"“我……”","voice":["vo_event_400402201_17"],"voice_bank":"vo_event_04022","style":1,"background":4049,"log_type":1},{"step":16,"speaker":"“教母”黛丝","content":"“这不是威胁，而是一个忠告，包菜沙拉。告诉我你的答案，否则……”","voice":["vo_event_400402201_19"],"voice_bank":"vo_event_04022","style":1,"background":4050,"log_type":1},{"step":17,"speaker":"“教母”黛丝","content":"“我会给你一个无法拒绝的条件。”","voice":["vo_event_400402201_20"],"voice_bank":"vo_event_04022","style":1,"background":4050,"log_type":1},{"step":19,"speaker":"小黛丝","content":"我、我会给你一、一个无法拒绝的条、条件。","voice":["vo_event_400402201_22"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":20,"speaker":"帮派成员","content":"噗……","voice":["vo_event_400402201_23"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":21,"speaker":"帮派成员","content":"噗哈哈哈哈哈哈，这个人在说什么鬼玩……","voice":["vo_event_400402201_24"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":23,"content":"帮派成员的话只说了一半便晕了过去，嗷呜仔细观瞧，发现是洛芙把手中的道具枪扔了出去，正中他的眉心。","style":3,"background":2046,"log_type":1},{"step":24,"speaker":"洛芙","content":"唉，果然还是不行吗？黛丝，啧啧，天赋不太行啊。看看我，只用了两遍就入戏了。","voice":["vo_event_400402201_26"],"voice_bank":"vo_event_04024","style":1,"background":2046,"log_type":1},{"step":25,"speaker":"小黛丝","content":"我要是会演戏，当初就不会从新城逃出来了。","voice":["vo_event_400402201_27"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":26,"speaker":"嗷呜","content":"看来黛丝姐姐确实不太适合演戏。原来不是每个人都像洛芙姐姐那样天赋异禀的啊……","voice":["vo_event_400402201_28"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":27,"speaker":"小黛丝","content":"……","voice":["vo_event_400402201_29"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":28,"speaker":"洛芙","content":"走了走了，这里肯定也藏不住了。","voice":["vo_event_400402201_30"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":29,"speaker":"小黛丝","content":"都怪那个什么“老大的儿子”……","voice":["vo_event_400402201_31"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":30,"speaker":"洛芙","content":"哈？","voice":["vo_event_400402201_32"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":31,"speaker":"小黛丝","content":"要不是因为他，我才不会受此奇耻大辱……我一定要把他给抓出来，然后把他……","voice":["vo_event_400402201_33"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":32,"speaker":"？？","content":"！！","voice":["vo_event_400402201_34"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":33,"content":"一声响动从办公桌的抽屉后传来，打断了黛丝的碎碎念。","style":3,"background":2046,"log_type":1},{"step":34,"speaker":"小黛丝","content":"什么动静？！有人躲在那儿？出来！","voice":["vo_event_400402201_35"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":35,"speaker":"？？","content":"啊！别、别杀我！","voice":["vo_event_400402201_36"],"voice_bank":"vo_event_04022","style":1,"background":2046,"log_type":1},{"step":36,"content":"少年慌忙起身，手中的海报稀里哗啦撒了一地。","style":3,"background":2046,"log_type":1}]}