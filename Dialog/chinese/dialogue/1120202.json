{"id":1120202,"chapter_id":1120202,"scene_id":1,"steps":[{"step":1,"content":"夜色降临，整个锈河岸边瞬间陷入黑暗。","style":3,"background":1019,"log_type":1,"src_id":220202001,"trial_step":1},{"step":2,"content":"堆砌的垃圾和受到污染的河流混为一体，散发着刺鼻的气味。","style":3,"background":1019,"log_type":1,"src_id":220202002,"trial_step":2},{"step":3,"content":"阴暗的角落里，几只不可名状的生物，淌着脓黑恶臭的液体，一动不动地看着不远处的人类。","style":3,"background":1019,"log_type":1,"src_id":220202003,"trial_step":3},{"step":4,"options":["……"],"style":6,"background":1019,"log_type":1,"src_id":220202004,"trial_step":4,"course":3,"choices":[{"text":"……","goto":5}]},{"step":5,"content":"背后传来几声死役的低吼，还未等你反应过来，死役便已经中枪倒地。","style":3,"background":1019,"log_type":1,"src_id":220202005,"trial_step":5},{"step":6,"speaker":"夜莺","content":"狙击完成，局长，您要小心点……您可是来完成任务的。","style":11,"background":1019,"log_type":1,"src_id":220202006,"trial_step":6},{"step":7,"content":"多谢，我会注意的。","style":2,"background":1019,"log_type":1,"src_id":220202007,"trial_step":7},{"step":8,"content":"数小时前——","style":10,"background":10000,"log_type":1,"src_id":220202008,"trial_step":8},{"step":9,"speaker":"夜莺","content":"FAC的紧急任务命令。","style":1,"background":107,"log_type":1,"src_id":220202009,"trial_step":9},{"step":10,"content":"夜莺将一份警戒密封的文档传输过来。","style":3,"background":107,"log_type":1,"src_id":220202010,"trial_step":10},{"step":11,"speaker":"夜莺","content":"任务要求立即前往锈河，以温蒂作为诱饵，调查狂厄武器原料来源。","style":1,"background":107,"log_type":1,"src_id":220202011,"trial_step":11},{"step":12,"speaker":"夜莺","content":"并且弄清前灾变污染清理小队事件真相。","style":1,"background":107,"log_type":1,"src_id":220202012,"trial_step":12},{"step":13,"speaker":"夜莺","content":"确定了与本应死亡的前灾变污染清理小队有关，上面对此十分重视。","style":1,"background":107,"log_type":1,"src_id":220202013,"trial_step":13},{"step":14,"speaker":"夜莺","content":"这是我们近距离接触到死役贩卖组织的唯一机会！","style":1,"background":107,"log_type":1,"src_id":220202014,"trial_step":14},{"step":15,"content":"我知道该怎么做。","style":2,"background":107,"log_type":1,"src_id":220202015,"trial_step":15},{"step":16,"speaker":"夜莺","content":"支援会在距离你们5公里外的地方等候指令，但狙击手将会时刻待命。","style":1,"background":107,"log_type":1,"src_id":220202016,"trial_step":16},{"step":17,"speaker":"夜莺","content":"如果有需要，随时都能启动。","style":1,"background":107,"log_type":1,"src_id":220202017,"trial_step":17},{"step":18,"content":"正盘算着如何进行任务，电锯的轰鸣声擦着耳朵飞过，那个被射杀的死役，就这样钉在了垃圾堆里，瞬间咽气。","style":3,"background":1019,"log_type":1,"src_id":220202018,"trial_step":18},{"step":19,"content":"……温蒂。","style":2,"background":1019,"log_type":1,"src_id":220202019,"trial_step":19},{"step":20,"speaker":"温蒂","content":"啊……这就被吓到了？哈哈哈……小局长，这就是锈河啊！","style":1,"background":1019,"log_type":1,"src_id":220202020,"trial_step":20},{"step":21,"speaker":"温蒂","content":"遍地都是怪物，它们是怪物，我也是怪物！你也是！哈哈哈！","style":1,"background":1019,"log_type":1,"src_id":220202021,"trial_step":21},{"step":22,"speaker":"温蒂","content":"要是害怕的话……就趁早回去你的庇护所吧！","style":1,"background":1019,"log_type":1,"src_id":220202022,"trial_step":22},{"step":23,"options":["没有"],"style":6,"background":1019,"log_type":1,"src_id":220202023,"trial_step":23,"course":3,"choices":[{"text":"没有","goto":24}]},{"step":24,"content":"小场面而已，当然，谢谢你帮我。","style":2,"background":1019,"log_type":1,"src_id":220202024,"trial_step":24},{"step":25,"speaker":"温蒂","content":"哼哼。","style":1,"background":1019,"log_type":1,"src_id":220202025,"trial_step":25},{"step":26,"content":"躲在角落里的怪物，似乎在惧怕温蒂，不再贸然上前，而是在原地不甘心地低吠着。","style":3,"background":1019,"log_type":1,"src_id":220202026,"trial_step":26},{"step":27,"options":["它们很怕你"],"style":6,"background":1019,"log_type":1,"src_id":220202027,"trial_step":27,"course":3,"choices":[{"text":"它们很怕你","goto":28}]},{"step":28,"speaker":"温蒂","content":"嘻嘻……这就是锈河——","style":1,"background":1019,"log_type":1,"src_id":220202028,"trial_step":28},{"step":29,"speaker":"温蒂","content":"你要费尽心思，变成怪物，才能活下去……","style":1,"background":1019,"log_type":1,"src_id":220202029,"trial_step":29},{"step":30,"speaker":"温蒂","content":"垃圾堆里的罐头，不知哪里来的蛆虫，都是活下去的力量！","style":1,"background":1019,"log_type":1,"src_id":220202030,"trial_step":30},{"step":31,"speaker":"温蒂","content":"嘿嘿嘿……实在不行，那些怪物，也能让你撑过一两天的。","style":1,"background":1019,"log_type":1,"src_id":220202031,"trial_step":31},{"step":32,"speaker":"温蒂","content":"走吧，局长。坐在高墙之后，凭着那些小飞虫，可是看不清锈河全貌的。","style":1,"background":1019,"log_type":1,"src_id":220202032,"trial_step":32},{"step":33,"content":"温蒂再次将手里的链锯往后甩去，不远处的一台无人侦察机顺势跌进角落，炸得那些怪物咿呀怪叫。","style":3,"background":1019,"log_type":1,"src_id":220202033,"trial_step":33},{"step":34,"speaker":"温蒂","content":"嘻嘻嘻嘻嘻……久违的惨叫声！","style":1,"background":1019,"log_type":1,"src_id":220202034,"trial_step":34},{"step":35,"content":"或许是因为回到了熟悉的地方，温蒂的情绪变得有些亢奋。","style":3,"background":1019,"log_type":1,"src_id":220202035,"trial_step":35},{"step":36,"content":"你一直说想回来锈河看看。","style":2,"background":1019,"log_type":1,"src_id":220202036,"trial_step":36},{"step":37,"content":"鉴于你这几次的谈话都很配合，我向上面申请了让你同行。","style":2,"background":1019,"log_type":1,"src_id":220202037,"trial_step":37},{"step":38,"speaker":"温蒂","content":"同行？这么多人？","style":1,"background":1019,"log_type":1,"src_id":220202038,"trial_step":38},{"step":39,"content":"……只有我和你。","style":2,"background":1019,"log_type":1,"src_id":220202039,"trial_step":39},{"step":40,"speaker":"温蒂","content":"呵……","style":1,"background":1019,"log_type":1,"src_id":220202040,"trial_step":40},{"step":41,"content":"温蒂嗤笑一声，突然拽着你的手加快脚步，闪入一片废墟。","style":3,"background":1019,"log_type":1,"src_id":220202041,"trial_step":41},{"step":42,"content":"温蒂？！","style":2,"background":1019,"log_type":1,"src_id":220202042,"trial_step":42},{"step":43,"content":"你心道不好，附近的废墟大多是黑环爆炸遗留产物，磁场力混乱。","style":3,"background":1019,"log_type":1,"src_id":220202043,"trial_step":43},{"step":44,"content":"隐蔽在耳边的通讯系统响了几声电流音后，完全失去了作用，无法呼叫支援，也扰乱了自己的定位系统。","style":3,"background":1019,"log_type":1,"src_id":220202044,"trial_step":44},{"step":45,"content":"所幸的是温蒂在不多时便停了下来，定定地向前看着，见你跟上后，将你扯到身边，指了指前方。","style":3,"background":1019,"log_type":1,"src_id":220202045,"trial_step":45},{"step":46,"content":"这个是？！","style":2,"background":1019,"log_type":1,"src_id":220202046,"trial_step":46},{"step":47,"content":"月光下你看到几个身穿着黑色斗篷的人正在挖着什么。","style":3,"background":1019,"log_type":1,"src_id":220202047,"trial_step":47},{"step":48,"content":"这个时间……怎么还会有人游荡在锈河？！","style":2,"background":1019,"log_type":1,"src_id":220202048,"trial_step":48},{"step":49,"content":"然而，不一会儿，随着锈河潮湿的气息一起飘来一阵独特的气味，令人汗毛倒竖……","style":3,"background":1019,"log_type":1,"src_id":220202049,"trial_step":49},{"step":50,"content":"这些人正在挖的是掩埋残骸的坑！！","style":2,"background":1019,"log_type":1,"src_id":220202050,"trial_step":50},{"step":51,"content":"你是指认了这些人吗？他们是你的同伴？","style":2,"background":1019,"log_type":1,"src_id":220202051,"trial_step":51},{"step":52,"speaker":"温蒂","content":"不。","style":1,"background":1019,"log_type":1,"src_id":220202052,"trial_step":52},{"step":53,"speaker":"温蒂","content":"他们是魔鬼……","style":1,"background":1019,"log_type":1,"src_id":220202053,"trial_step":53},{"step":54,"speaker":"温蒂","content":"在黑暗里……按捺很久了，趁我不在……挖掘尸体……","style":1,"background":1019,"log_type":1,"src_id":220202054,"trial_step":54},{"step":55,"speaker":"温蒂","content":"但是他们不知道……我消失了，又出现了……哈哈哈哈……","style":1,"background":1019,"log_type":1,"src_id":220202055,"trial_step":55},{"step":56,"speaker":"温蒂","content":"看来这是……锈河给我的任务啊。","style":1,"background":1019,"log_type":1,"src_id":220202056,"trial_step":56},{"step":57,"content":"任务？你要去清理那些死役的残骸？还是……","style":2,"background":1019,"log_type":1,"src_id":220202057,"trial_step":57},{"step":58,"speaker":"温蒂","content":"这些人可不是什么好人，能动手的吧，是能动手的吧！","style":1,"background":1019,"log_type":1,"src_id":220202058,"trial_step":58},{"step":59,"content":"巡查了这么久才抓到他们的踪迹，你担心温蒂的举动会打草惊蛇，轻轻抓住了她的手，将她留在了自己身边。","style":3,"background":1019,"log_type":1,"src_id":220202059,"trial_step":59},{"step":60,"content":"温蒂，不要轻举妄动。","style":2,"background":1019,"log_type":1,"src_id":220202060,"trial_step":60},{"step":61,"speaker":"贩尸人B","content":"咳咳、这味道，也太**难闻了……","style":1,"background":1019,"log_type":1,"src_id":220202061,"trial_step":61},{"step":62,"speaker":"贩尸人A","content":"抱怨个*啊，这么大声。","style":1,"background":1019,"log_type":1,"src_id":220202062,"trial_step":62},{"step":63,"speaker":"贩尸人A","content":"虽然那什么收割者很长时间没出现了，但也不能掉以轻心！","style":1,"background":1019,"log_type":1,"src_id":220202063,"trial_step":63},{"step":64,"speaker":"贩尸人A","content":"这里挖完了，听说他们在南边又发现了几个埋了这玩意的坑。","style":1,"background":1019,"log_type":1,"src_id":220202064,"trial_step":64},{"step":65,"speaker":"贩尸人A","content":"等下过去都给挖了！这个月的量就好交差了！","style":1,"background":1019,"log_type":1,"src_id":220202065,"trial_step":65},{"step":66,"content":"埋在别的地方……就算他们不是这条运输链上的人，现在他们的所作所为也足够逮捕他们了。","style":2,"background":1019,"log_type":1,"src_id":220202066,"trial_step":66},{"step":67,"content":"温蒂，你……","style":2,"background":1019,"log_type":1,"src_id":220202067,"trial_step":67},{"step":68,"speaker":"温蒂","content":"南边？你们竟然……对他们出手了……！","style":1,"background":1019,"log_type":1,"src_id":220202068,"trial_step":68},{"step":69,"speaker":"温蒂","content":"不能！不能放过你们！","style":1,"background":1019,"log_type":1,"src_id":220202069,"trial_step":69},{"step":70,"content":"此时你才发现，温蒂早已挣脱了你的手，死死地盯着那群人。","style":3,"background":1019,"log_type":1,"src_id":220202070,"trial_step":70},{"step":71,"content":"齿缝紧紧摩擦着发出让人不悦的噪音，温蒂紧握着链锯，仿佛随时都要冲出去。","style":3,"background":1019,"log_type":1,"src_id":220202071,"trial_step":71},{"step":72,"options":["摁住她"],"style":6,"background":1019,"log_type":1,"src_id":220202072,"trial_step":72,"course":3,"choices":[{"text":"摁住她","goto":73}]},{"step":73,"content":"冷静一点，温蒂，如果你是想通风报信让他们逃走，我必须明确地跟你说，这是……","style":2,"background":1019,"log_type":1,"src_id":220202073,"trial_step":73},{"step":74,"content":"话还没有说完，温蒂便冲了出去。","style":3,"background":1019,"log_type":1,"src_id":220202074,"trial_step":74},{"step":75,"content":"但出乎意料的是，温蒂并没有让那些人逃走，反而是举起了链锯。","style":3,"background":1019,"log_type":1,"src_id":220202075,"trial_step":75},{"step":76,"speaker":"贩尸人B","content":"等等！有人冲过来了！","style":1,"background":1019,"log_type":1,"src_id":220202076,"trial_step":76},{"step":77,"speaker":"贩尸人A","content":"是谁？！你是来抢尸体的？！","style":1,"background":1019,"log_type":1,"src_id":220202077,"trial_step":77},{"step":78,"speaker":"贩尸人A","content":"不对！！这个声音和武器……","style":1,"background":1019,"log_type":1,"src_id":220202078,"trial_step":78},{"step":79,"speaker":"贩尸人A","content":"是“锈河的收割者”！！！！","style":1,"background":1019,"log_type":1,"src_id":220202079,"trial_step":79},{"step":80,"content":"你急忙追上温蒂，但所幸温蒂暂时没有做什么出格的事。","style":3,"background":1019,"log_type":1,"src_id":220202080,"trial_step":80},{"step":81,"content":"没有将人放走，也没有把人都杀了，而是将两人惩罚一顿，踩着他们的手腕控制住行动。","style":3,"background":1019,"log_type":1,"src_id":220202081,"trial_step":81},{"step":82,"speaker":"温蒂","content":"嘻嘻嘻……锈河的耗子……","style":1,"background":1019,"log_type":1,"src_id":220202082,"trial_step":82},{"step":83,"content":"那两人被温蒂狠狠地限制住，嘴里一会儿破口大骂，一会儿苦苦求饶。","style":3,"background":1019,"log_type":1,"src_id":220202083,"trial_step":83},{"step":84,"content":"你正准备查看这两人的身份时，发现了一点异样。","style":3,"background":1019,"log_type":1,"src_id":220202084,"trial_step":84},{"step":85,"content":"等等……你们身上这是？！","style":2,"background":1019,"log_type":1,"src_id":220202085,"trial_step":85},{"step":86,"content":"FAC一直认为，在锈河边进行尸体买卖的，是灾变清理部队的剩余逃跑人员。","style":3,"background":1019,"log_type":1,"src_id":220202086,"trial_step":86},{"step":87,"content":"可出现在你面前的贩尸人却并非你们所想的那样。","style":3,"background":1019,"log_type":1,"src_id":220202087,"trial_step":87},{"step":88,"content":"他们脖子上的标志意味着他们都是来自黑水协会的人——面容也无法和资料库里的反叛人员面容匹配。","style":3,"background":1019,"log_type":1,"src_id":220202088,"trial_step":88},{"step":89,"options":["这可真是出人意料……"],"style":6,"background":1019,"log_type":1,"src_id":220202089,"trial_step":89,"course":3,"choices":[{"text":"这可真是出人意料……","goto":90}]},{"step":90,"content":"冤家路窄啊。","style":2,"background":1019,"log_type":1,"src_id":220202090,"trial_step":90},{"step":91,"speaker":"温蒂","content":"小局长，让我动手怎么样？这些人都可都是坏人，是垃圾，混蛋……","style":1,"background":1019,"log_type":1,"src_id":220202091,"trial_step":91},{"step":92,"speaker":"贩尸人A","content":"局、局长？！等等，难道你是管理局的局长？！","style":1,"background":1019,"log_type":1,"src_id":220202092,"trial_step":92},{"step":93,"options":["是。"],"style":6,"background":1019,"log_type":1,"src_id":220202093,"trial_step":93,"course":3,"choices":[{"text":"是。","goto":94}]},{"step":94,"content":"是我，你们决定投降了吗？","style":2,"background":1019,"log_type":1,"src_id":220202094,"trial_step":94},{"step":95,"speaker":"贩尸人A","content":"啊~你真是FAC的人啊~！那、那就好说啦！","style":1,"background":1019,"log_type":1,"src_id":220202095,"trial_step":95},{"step":96,"speaker":"贩尸人A","content":"我们商量、商量商量！","style":1,"background":1019,"log_type":1,"src_id":220202096,"trial_step":96},{"step":97,"options":["你想商量什么？"],"style":6,"background":1019,"log_type":1,"src_id":220202097,"trial_step":97,"course":3,"choices":[{"text":"你想商量什么？","goto":98}]},{"step":98,"speaker":"贩尸人A","content":"嘿嘿，不要这么紧张嘛！我们谈一笔交易！","style":1,"background":1019,"log_type":1,"src_id":220202098,"trial_step":98},{"step":99,"speaker":"贩尸人A","content":"我们合作一下，你呢，就当没见过我，向上面报告说没发现异常。","style":1,"background":1019,"log_type":1,"src_id":220202099,"trial_step":99},{"step":100,"speaker":"贩尸人A","content":"我们呢，干完这笔买卖，就分你们几成钱，怎么样！","style":1,"background":1019,"log_type":1,"src_id":220202100,"trial_step":100},{"step":101,"content":"两位盗窃残骸的人跪在地上，谄媚地笑着。","style":3,"background":1019,"log_type":1,"src_id":220202101,"trial_step":101},{"step":102,"speaker":"贩尸人A","content":"你们也别担心，这种合作啊，很早之前就有过了！","style":1,"background":1019,"log_type":1,"src_id":220202102,"trial_step":102},{"step":103,"speaker":"贩尸人A","content":"我们以前的老大，就和你们一个、一个什么清理部队？哎，我们都叫它送葬人的！完成了不少交易！那个队长，嘿，可真是个明白人！","style":1,"background":1019,"log_type":1,"src_id":220202103,"trial_step":103},{"step":104,"content":"送葬人？送葬人就是秘密污染清理部队？","style":2,"background":1019,"log_type":1,"src_id":220202104,"trial_step":104},{"step":105,"content":"听到熟悉的名词，你不由自主地看了一眼温蒂。她的身体随着贩尸人的讲述，渐渐变得僵硬。","style":3,"background":1019,"log_type":1,"src_id":220202105,"trial_step":105},{"step":106,"speaker":"贩尸人A","content":"对对，就是什么污染清理部队，反正是你们FAC旗下的！他们可通透！","style":1,"background":1019,"log_type":1,"src_id":220202106,"trial_step":106},{"step":107,"speaker":"贩尸人A","content":"你们那上头，让人去干那么危险的活儿，还不给人发好的装备。","style":1,"background":1019,"log_type":1,"src_id":220202107,"trial_step":107},{"step":108,"speaker":"贩尸人A","content":"嘿，叫受到污染的人光着去收拾死役，那不就成了死役生产基地了！","style":1,"background":1019,"log_type":1,"src_id":220202108,"trial_step":108},{"step":109,"options":["不可能……"],"style":6,"background":1019,"log_type":1,"src_id":220202109,"trial_step":109,"course":3,"choices":[{"text":"不可能……","goto":110}]},{"step":110,"speaker":"贩尸人A","content":"哈！什么不可能！毕竟这就是些小喽啰！","style":1,"background":1019,"log_type":1,"src_id":220202110,"trial_step":110},{"step":111,"speaker":"贩尸人A","content":"上面不就是这么想的么！小喽啰的命算什么！反正最后都得死！","style":1,"background":1019,"log_type":1,"src_id":220202111,"trial_step":111},{"step":112,"options":["我可不认同你的说法"],"style":6,"background":1019,"log_type":1,"src_id":220202112,"trial_step":112,"course":3,"choices":[{"text":"我可不认同你的说法","goto":113}]},{"step":113,"speaker":"贩尸人A","content":"不认同就不认同吧，但你好好想想这笔交易！","style":1,"background":1019,"log_type":1,"src_id":220202113,"trial_step":113},{"step":114,"speaker":"贩尸人A","content":"和当时送葬人的队长一样！！","style":1,"background":1019,"log_type":1,"src_id":220202114,"trial_step":114},{"step":115,"speaker":"贩尸人A","content":"让你们跑到这个地方调查，说白了就是想让你们送死！是吧！局长！","style":1,"background":1019,"log_type":1,"src_id":220202115,"trial_step":115},{"step":116,"content":"盗尸者喋喋不休地说着，像极了挣扎在泥泞里的苍蝇。","style":3,"background":1019,"log_type":1,"src_id":220202116,"trial_step":116},{"step":117,"content":"而你留意到，温蒂很久没有出声了……尤其是，在他们的嘴里，听到关于送葬人的消息时。","style":3,"background":1019,"log_type":1,"src_id":220202117,"trial_step":117},{"step":118,"content":"温蒂，把这些人先捆……你做什么？！","style":2,"background":1019,"log_type":1,"src_id":220202118,"trial_step":118},{"step":119,"speaker":"温蒂","content":"哈哈哈……送葬人？我就是送葬人啊！","style":1,"background":1019,"log_type":1,"src_id":220202119,"trial_step":119},{"step":120,"speaker":"温蒂","content":"想不到，原来是你们啊……","style":1,"background":1019,"log_type":1,"src_id":220202120,"trial_step":120},{"step":121,"speaker":"贩尸人A","content":"你是送葬人！？我听说他们队的人好像都没了，没想到还有人活着啊！","style":1,"background":1019,"log_type":1,"src_id":220202121,"trial_step":121},{"step":122,"speaker":"贩尸人A","content":"啊哈哈哈既然你就是队里的人，那就更应该明白上头那些家伙对你们有多差吧！","style":1,"background":1019,"log_type":1,"src_id":220202122,"trial_step":122},{"step":123,"speaker":"贩尸人A","content":"不如就跟你们队长一样……","style":1,"background":1019,"log_type":1,"src_id":220202123,"trial_step":123},{"step":124,"content":"温蒂冲过来，一脚踩上盗尸者的头，飞快转动的电锯插入他脑袋旁边的地里，扬起泥土与碎石。","style":3,"background":1019,"log_type":1,"src_id":220202124,"trial_step":124},{"step":125,"speaker":"温蒂","content":"你对我们的队长记忆……还真是深刻。","style":1,"background":1019,"log_type":1,"src_id":220202125,"trial_step":125},{"step":126,"speaker":"温蒂","content":"是……我们是送葬人！","style":1,"background":1019,"log_type":1,"src_id":220202126,"trial_step":126},{"step":127,"speaker":"温蒂","content":"面对肮脏的世界，有些人必须走出来，直面污染。","style":1,"background":1019,"log_type":1,"src_id":220202127,"trial_step":127},{"step":128,"speaker":"温蒂","content":"我们背负着沉重的责任……为大家清扫出一条光明道路出来！","style":1,"background":1019,"log_type":1,"src_id":220202128,"trial_step":128},{"step":129,"speaker":"温蒂","content":"可那个叛徒！出卖了我们所有人！！","style":1,"background":1019,"log_type":1,"src_id":220202129,"trial_step":129},{"step":130,"speaker":"贩尸人A","content":"这、这都是很正常的事！","style":1,"background":1019,"log_type":1,"src_id":220202130,"trial_step":130},{"step":131,"speaker":"贩尸人A","content":"你看看你们这活儿，又没有防护，又没有红利！","style":1,"background":1019,"log_type":1,"src_id":220202131,"trial_step":131},{"step":132,"speaker":"贩尸人A","content":"上头那些人就是拿你们当块破抹布！用了就扔！","style":1,"background":1019,"log_type":1,"src_id":220202132,"trial_step":132},{"step":133,"speaker":"贩尸人A","content":"你们队长这么做完全可以理解啊！","style":1,"background":1019,"log_type":1,"src_id":220202133,"trial_step":133},{"step":134,"speaker":"温蒂","content":"可以理解？","style":1,"background":1019,"log_type":1,"src_id":220202134,"trial_step":134},{"step":135,"speaker":"贩尸人A","content":"是啊！你看看你们，连防护设备都没几个好的！","style":1,"background":1019,"log_type":1,"src_id":220202135,"trial_step":135},{"step":136,"speaker":"贩尸人A","content":"我记得当时，你们队里还有比你小的人吧，你们队长提起过。","style":1,"background":1019,"log_type":1,"src_id":220202136,"trial_step":136},{"step":137,"speaker":"贩尸人A","content":"啧啧，小小年纪，裹着几块破铜烂铁就冲在最前面……","style":1,"background":1019,"log_type":1,"src_id":220202137,"trial_step":137},{"step":138,"speaker":"温蒂","content":"是啊……是啊……他！！！","style":1,"background":1019,"log_type":1,"src_id":220202138,"trial_step":138},{"step":139,"speaker":"温蒂","content":"在任务中被完全感染……成为了和我一样的疯子！","style":1,"background":1019,"log_type":1,"src_id":220202139,"trial_step":139},{"step":140,"speaker":"温蒂","content":"我想要救他……可队长一直在跟我说，他没救了！","style":1,"background":1019,"log_type":1,"src_id":220202140,"trial_step":140},{"step":141,"speaker":"温蒂","content":"最后留给我的只有他的衣服和名牌……","style":1,"background":1019,"log_type":1,"src_id":220202141,"trial_step":141},{"step":142,"content":"温蒂揪起那人的衣领，强迫他与自己对视。","style":3,"background":1019,"log_type":1,"src_id":220202142,"trial_step":142},{"step":143,"speaker":"温蒂","content":"我葬送了一个，两个，三个……人。","style":1,"background":1019,"log_type":1,"src_id":220202143,"trial_step":143},{"step":144,"speaker":"温蒂","content":"那么多人离我而去，只能在肮脏的垃圾堆里腐烂！","style":1,"background":1019,"log_type":1,"src_id":220202144,"trial_step":144},{"step":145,"speaker":"温蒂","content":"我不接受他的、他们的结局！！不能！","style":1,"background":1019,"log_type":1,"src_id":220202145,"trial_step":145},{"step":146,"speaker":"温蒂","content":"他……他该死……他背叛了我们的信条！！我要一个一个……一个一个全部全部解决这些……叛徒！！","style":1,"background":1019,"log_type":1,"src_id":220202146,"trial_step":146},{"step":147,"speaker":"温蒂","content":"你们……你们这些混蛋，同流合污的垃圾，毫无人性的狗！","style":1,"background":1019,"log_type":1,"src_id":220202147,"trial_step":147},{"step":148,"content":"举起链锯，温蒂按下了开关并释放自己能力，一副要抹除一切的模样。","style":3,"background":1019,"log_type":1,"src_id":220202148,"trial_step":148},{"step":149,"speaker":"温蒂","content":"你们……那些地方碰到他们了？……都别想要了！","style":1,"background":1019,"log_type":1,"src_id":220202149,"trial_step":149},{"step":150,"speaker":"温蒂","content":"哈哈哈……瞧瞧，瞧瞧……这肮脏的，摔倒在泥巴里的蛋糕！没有价值的东西！让我统统切碎吧！","style":1,"background":1019,"log_type":1,"src_id":220202150,"trial_step":150},{"step":151,"speaker":"温蒂","content":"队长也好，死役也好，贩卖样本的人也好！都是垃圾！都是污秽！","style":1,"background":1019,"log_type":1,"src_id":220202151,"trial_step":151},{"step":152,"speaker":"温蒂","content":"我是送葬人……是清理者！","style":1,"background":1019,"log_type":1,"src_id":220202152,"trial_step":152},{"step":153,"speaker":"温蒂","content":"不能让污染物……流向世界！","style":1,"background":1019,"log_type":1,"src_id":220202153,"trial_step":153},{"step":154,"content":"局长","style":3,"background":1019,"log_type":1,"src_id":220202154,"trial_step":154},{"step":155,"content":"住手！","style":2,"background":1019,"log_type":1,"src_id":220202156,"trial_step":156},{"step":156,"speaker":"温蒂","content":"滚开！","style":1,"background":1019,"log_type":1,"src_id":220202157,"trial_step":157},{"step":157,"speaker":"温蒂","content":"你想要和他们交易？！","style":1,"background":1019,"log_type":1,"src_id":220202158,"trial_step":158},{"step":158,"speaker":"温蒂","content":"你也要背叛我吗？！","style":1,"background":1019,"log_type":1,"src_id":220202159,"trial_step":159},{"step":159,"content":"温蒂的声音中饱含着愤怒与悲伤，力气也变得出奇的大。","style":3,"background":1019,"log_type":1,"src_id":220202160,"trial_step":160},{"step":160,"speaker":"夜莺","content":"局长，禁闭者情绪极度不稳定！需要立即启用狙击手……","style":11,"background":1019,"log_type":1,"src_id":220202161,"trial_step":161},{"step":161,"options":["不需要！"],"style":6,"background":1019,"log_type":1,"src_id":220202162,"trial_step":162,"course":3,"choices":[{"text":"不需要！","goto":163}]},{"step":162,"content":"你不想动用狙击手，也不想使用能力。","style":3,"background":1019,"log_type":1,"src_id":220202163,"trial_step":163},{"step":163,"content":"温蒂，我相信你，我相信你刚才说的都是真的！","style":2,"background":1019,"log_type":1,"src_id":220202164,"trial_step":164},{"step":164,"content":"链锯已经压在了肩上，剧烈的疼痛让你说话都不再完整。","style":3,"background":1019,"log_type":1,"src_id":220202165,"trial_step":165},{"step":165,"content":"嘶……！","style":2,"background":1019,"log_type":1,"src_id":220202166,"trial_step":166},{"step":166,"content":"温蒂，听我说，你不能因为杀掉这两个人而坐实罪行！","style":2,"background":1019,"log_type":1,"src_id":220202167,"trial_step":167},{"step":167,"content":"我……想，想成为你的同伴，想……不，我能成为、现在、以后你都可以依靠的人！请你……相信我！","style":2,"background":1019,"log_type":1,"src_id":220202168,"trial_step":168},{"step":168,"speaker":"温蒂","content":"……","style":1,"background":1019,"log_type":1,"src_id":220202169,"trial_step":169},{"step":169,"content":"温蒂的怒吼停了下来，充血的眼睛愣愣地看着你，一动不动。","style":3,"background":1019,"log_type":1,"src_id":220202170,"trial_step":170},{"step":170,"speaker":"温蒂","content":"为什么……","style":1,"background":1019,"log_type":1,"src_id":220202171,"trial_step":171},{"step":171,"speaker":"温蒂","content":"为什么想成为我的同伴……成为我的同伴，只会变成疯子！变成尸体！","style":1,"background":1019,"log_type":1,"src_id":220202172,"trial_step":172},{"step":172,"speaker":"温蒂","content":"你真的……愿意吗……","style":1,"background":1019,"log_type":1,"src_id":220202173,"trial_step":173},{"step":173,"content":"你看见温蒂的手，挥舞而下，吱吱作响。","style":3,"background":1019,"log_type":1,"src_id":220202177,"trial_step":177},{"step":174,"content":"液体溅进你的眼里，让你忍不住闭上眼睛——一片漆黑与腥臭。","style":3,"background":1019,"log_type":1,"src_id":220202178,"trial_step":178},{"step":175,"content":"……","style":2,"background":1019,"log_type":1,"src_id":220202179,"trial_step":179},{"step":176,"speaker":"温蒂","content":"清理，清理完毕。","style":1,"background":1019,"log_type":1,"src_id":220202180,"trial_step":180},{"step":177,"speaker":"温蒂","content":"肮脏的家伙。","style":1,"background":1019,"log_type":1,"src_id":220202181,"trial_step":181},{"step":178,"content":"由于温蒂的冲动，导致该条线索链断裂。","style":10,"background":10000,"log_type":1,"src_id":220202182,"trial_step":182},{"step":179,"content":"FAC认定了温蒂和送葬人与黑水协会勾结，并为了掩盖送葬人叛逃走私狂厄武器而灭口。","style":10,"background":10000,"log_type":1,"src_id":220202183,"trial_step":183},{"step":180,"content":"温蒂未来将面临极严重的处罚，而送葬人……也被下达了清缴命令，连尸体都不允许放过。","style":10,"background":10000,"log_type":1,"src_id":220202184,"trial_step":184}]}