{"id":1030301,"chapter_id":1030301,"scene_id":1,"steps":[{"step":1,"content":"这片黑暗很熟悉。","style":3,"background":10000,"log_type":1,"src_id":130301001,"trial_step":1},{"step":2,"content":"这种感觉也很熟悉——像一条蛇缠绕在你的脖子上，冰冷，窒息。","style":3,"background":10000,"log_type":1,"src_id":130301002,"trial_step":2},{"step":3,"speaker":"玩家","content":"娜恰……？！","style":2,"background":10000,"log_type":1,"src_id":130301003,"trial_step":3},{"step":4,"speaker":"娜恰","content":"嘻嘻……你猜猜，这里是梦里……还是……现实里呀？","voice":["vo_trial_30301_1_1"],"voice_bank":"vo_snake_trial","style":1,"background":10000,"log_type":1,"src_id":130301004,"trial_step":4},{"step":5,"speaker":"娜恰","content":"又可能……两者都不是，你我都在……痛苦之中……","voice":["vo_trial_30301_1_2"],"voice_bank":"vo_snake_trial","style":1,"background":10000,"log_type":1,"src_id":130301005,"trial_step":5},{"step":6,"content":"黑暗中，娜恰的身影一点点浮现。她压制着你，青色的眼瞳微微颤抖。","style":3,"background":10000,"log_type":1,"src_id":130301006,"trial_step":6},{"step":7,"content":"可一滴温热的液体落在你的唇角，顺着纹路渗进嘴里——舌尖上弥漫开一股淡淡的咸味，那是眼泪。","style":3,"background":10000,"log_type":1,"src_id":130301007,"trial_step":7},{"step":8,"content":"你……在哭？","style":2,"background":10000,"log_type":1,"src_id":130301008,"trial_step":8},{"step":9,"content":"脖颈上的束缚感愈发强烈，你来不及细想这滴眼泪意味着什么了，现在便是最好的时机——","style":3,"background":10000,"log_type":1,"src_id":130301009,"trial_step":9},{"step":10,"content":"红光闪过，荆棘一般的纹路从你的手心蔓延至娜恰身上。","style":3,"background":10000,"log_type":1,"src_id":130301011,"trial_step":11},{"step":11,"content":"精神相连的那一瞬间，无数痛苦，悲伤，怨恨的呐喊涌入你的意识。","style":3,"background":10000,"log_type":1,"src_id":130301012,"trial_step":12},{"step":12,"content":"黑暗褪去，你的耳边一片嗡鸣。而你怀中的人，却提醒着你，刚才的一切都不是幻觉。","style":3,"background":2016,"log_type":1,"src_id":130301013,"trial_step":13},{"step":13,"speaker":"士兵","content":"找到局长了！！快！医疗小队！","voice":["vo_trial_30301_1_43"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130301014,"trial_step":14},{"step":14,"speaker":"士兵","content":"局长，你不要紧吧？！那个禁闭者呢？！突然就带走你，像变戏法一样……","voice":["vo_trial_30301_1_44"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130301015,"trial_step":15},{"step":15,"speaker":"玩家","content":"不要紧，她晕过去了，我已经对她使用过枷锁，但她的状况有点不对劲……","style":2,"background":2016,"log_type":1,"src_id":130301016,"trial_step":16},{"step":16,"speaker":"玩家","content":"先收队回管理局。给她最好的治疗环境，我需要尽快和她谈谈。","style":2,"background":2016,"log_type":1,"src_id":130301017,"trial_step":17},{"step":17,"speaker":"士兵","content":"是！","voice":["vo_trial_30301_1_45"],"voice_bank":"vo_snake_trial","style":1,"background":2016,"log_type":1,"src_id":130301018,"trial_step":18},{"step":18,"content":"距离“妙梦瓶”事件已经过去十天，这十天里，你们一直在寻找娜恰的下落，以防再次发生梦露事件。","style":3,"background":1040,"log_type":1,"src_id":130301019,"trial_step":19},{"step":19,"content":"可想在森林里找寻一条善于伪装的蛇，并非易事，而且这段时间里，什么异常都没有发生。","style":3,"background":1040,"log_type":1,"src_id":130301020,"trial_step":20},{"step":20,"content":"这样平和的场面，你始终都无法放心——娜恰还未能成功收容，平和的日子最容易让人放松警惕，她或许在等待反扑的机会。","style":3,"background":1040,"log_type":1,"src_id":130301021,"trial_step":21},{"step":21,"content":"但没想到，在最近的这次行动中，娜恰“自投罗网”了。","style":3,"background":1040,"log_type":1,"src_id":130301022,"trial_step":22},{"step":22,"speaker":"娜恰","content":"嘶……好亮……","voice":["vo_trial_30301_1_3"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301025,"trial_step":25,"drawing":1030302},{"step":23,"speaker":"娜恰","content":"你们管理局，就是这么对待刚刚苏醒的人？","voice":["vo_trial_30301_1_4"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301026,"trial_step":26,"drawing":1030302},{"step":24,"speaker":"娜恰","content":"啊~我懂了，在你们眼里……禁闭者可能，都不是人吧~","voice":["vo_trial_30301_1_5"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301027,"trial_step":27,"drawing":1030303},{"step":25,"speaker":"玩家","content":"我不是这个意思。","style":2,"log_type":1,"src_id":130301028,"trial_step":28,"drawing":1030303},{"step":26,"speaker":"玩家","content":"你刚醒来就让你来审查室确实有点辛苦你……但我们之间……有很多事还没有解决。","style":2,"log_type":1,"src_id":130301029,"trial_step":29,"drawing":1030303},{"step":27,"speaker":"娜恰","content":"是啊，是啊……很多事情，光能照到的，光照不到的……","voice":["vo_trial_30301_1_6"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301030,"trial_step":30,"drawing":1030303},{"step":28,"speaker":"娜恰","content":"局长要管的事情，还真多啊~哈哈~","voice":["vo_trial_30301_1_7"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301031,"trial_step":31,"drawing":1030303},{"step":29,"speaker":"玩家","content":"为了能尽快解决，我就直说了……妙梦瓶，现在在哪里？","style":2,"log_type":1,"src_id":130301032,"trial_step":32,"drawing":1030303},{"step":30,"speaker":"娜恰","content":"……","voice":["vo_trial_30301_1_8"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301033,"trial_step":33,"drawing":1030301},{"step":31,"speaker":"娜恰","content":"这重要吗？不管它在哪里，现在……我在你的手里呀？","voice":["vo_trial_30301_1_9"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301034,"trial_step":34,"drawing":1030305},{"step":32,"content":"娜恰轻轻地朝你眨了眨眼，语气里满是撒娇的意味。","style":3,"log_type":1,"src_id":130301035,"trial_step":35,"drawing":1030305},{"step":33,"speaker":"玩家","content":"作为局长，我必须得谨慎一些才行。","style":2,"log_type":1,"src_id":130301036,"trial_step":36,"drawing":1030305},{"step":34,"speaker":"玩家","content":"毕竟……我见过的“自投罗网”的禁闭者，好像总会更加危险一点。","style":2,"log_type":1,"src_id":130301037,"trial_step":37,"drawing":1030305},{"step":35,"speaker":"娜恰","content":"看来局长经历过一些不太好的事情呢……怎么样，要不要再试试“梦露”？说不定能忘记这些让你痛苦的经历呢？","voice":["vo_trial_30301_1_10"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301038,"trial_step":38,"drawing":1030304},{"step":36,"speaker":"娜恰","content":"哎呀，你看我，差点忘了……","voice":["vo_trial_30301_1_11"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301039,"trial_step":39,"drawing":1030304},{"step":37,"speaker":"娜恰","content":"梦露……没办法给你快乐呀~","voice":["vo_trial_30301_1_12"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301040,"trial_step":40,"drawing":1030303},{"step":38,"content":"娜恰歪着头，带着一丝笑意，露出了自己的牙尖尖。","style":3,"log_type":1,"src_id":130301041,"trial_step":41,"drawing":1030303},{"step":39,"speaker":"娜恰","content":"不过没关系。快乐……快乐只要创造就能有的。","voice":["vo_trial_30301_1_13"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301042,"trial_step":42,"drawing":1030303},{"step":40,"speaker":"娜恰","content":"你知道如何创造快乐，对吧~你见过的，你也去过的。","voice":["vo_trial_30301_1_14"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301043,"trial_step":43,"drawing":1030303},{"step":41,"speaker":"玩家","content":"创造快乐……你果然还没对梦露死心？","style":2,"log_type":1,"src_id":130301044,"trial_step":44,"drawing":1030303},{"step":42,"content":"娜恰的手指绕了绕眼前的发丝，对着你的眼睛欣赏了好半天，才开口说道。","style":3,"log_type":1,"src_id":130301045,"trial_step":45,"drawing":1030303},{"step":43,"speaker":"娜恰","content":"玛芙已经被你消灭了……为什么还要怕梦露呀？","voice":["vo_trial_30301_1_15"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301046,"trial_step":46,"drawing":1030301},{"step":44,"speaker":"玩家","content":"我怕的是你带走的妙梦瓶。","style":2,"log_type":1,"src_id":130301047,"trial_step":47,"drawing":1030301},{"step":45,"speaker":"娜恰","content":"……","style":1,"log_type":1,"src_id":130301048,"trial_step":48,"drawing":1030301},{"step":46,"options":["询问最初梦露来源"],"style":6,"log_type":1,"src_id":130301049,"trial_step":49,"course":3,"drawing":1030301,"choices":[{"text":"询问最初梦露来源","goto":50}]},{"step":47,"speaker":"玩家","content":"你说过，“玛芙”制造了<color=#e45515>最初的梦露</color>，用它蛊惑人类，榨干他们的精神，把人变成死役。那不是FAC记录在案的狂厄变种，强大，且隐秘。","style":2,"log_type":1,"src_id":130301050,"trial_step":50,"drawing":1030301},{"step":48,"speaker":"娜恰","content":"问这个做什么？","voice":["vo_trial_30301_1_16"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301051,"trial_step":51,"drawing":1030302},{"step":49,"speaker":"玩家","content":"你说自己遇到它是意外……是什么样的意外？你在什么时候，在哪里遇到它？它到底来自哪里？","style":2,"log_type":1,"src_id":130301052,"trial_step":52,"drawing":1030302},{"step":50,"content":"像是对你的问题并不感兴趣，娜恰转过了头，盯着一旁墙上的计时器，随着秒数打起了拍子。","style":3,"log_type":1,"src_id":130301053,"trial_step":53,"drawing":1030302},{"step":51,"speaker":"娜恰","content":"我不记得了，况且……我觉得这个也不重要。","voice":["vo_trial_30301_1_17"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301054,"trial_step":54,"drawing":1030302},{"step":52,"speaker":"玩家","content":"你是不记得了，还是根本就没有这件事？","style":2,"log_type":1,"src_id":130301055,"trial_step":55,"drawing":1030302},{"step":53,"speaker":"娜恰","content":"什么意思……","voice":["vo_trial_30301_1_18"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301056,"trial_step":56,"drawing":1030302},{"step":54,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":57,"course":6,"drawing":1030302},{"step":55,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":57,"course":6,"drawing":1030302},{"step":56,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":57,"course":6,"drawing":1030302},{"step":57,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":57,"course":6,"drawing":1030302},{"step":58,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":57,"course":6,"drawing":1030302},{"step":59,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":57,"course":6,"drawing":1030302},{"step":60,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":57,"course":6,"drawing":1030302},{"step":61,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":57,"course":6,"drawing":1030302},{"step":62,"content":"最初，管理局在调查禁闭者档案时，并没有发现什么东西，但通过第九机关的深度调查后，你从一些关于娜恰的身份信息，找到了些许线索。","style":3,"log_type":1,"src_id":130301058,"trial_step":58,"drawing":1030302},{"step":63,"speaker":"玩家","content":"我有理由怀疑，梦露和那只怪物……是你自己的异能所产生的。","style":2,"log_type":1,"src_id":130301059,"trial_step":59,"drawing":1030302},{"step":64,"content":"娜恰瞥了一眼你桌面上的卷宗，依旧不愿意转过来看你。","style":3,"log_type":1,"src_id":130301060,"trial_step":60,"drawing":1030302},{"step":65,"speaker":"玩家","content":"几年前，新城一度非常流行饲养宠物蛇，社交平台上也火过一阵一位“能和蛇对话的女孩”。","style":2,"log_type":1,"src_id":130301061,"trial_step":61,"drawing":1030302},{"step":66,"speaker":"娜恰","content":"……","style":1,"log_type":1,"src_id":130301062,"trial_step":62,"drawing":1030302},{"step":67,"speaker":"玩家","content":"但在不久后，发生了一起宠物蛇袭击主人的惨案。于是从那次之后，新城颁布法令，禁止市民饲养巨型宠物蛇，否则后果自负。","style":2,"log_type":1,"src_id":130301063,"trial_step":63,"drawing":1030302},{"step":68,"speaker":"玩家","content":"时至今日，治安局依旧找不到宠物主人的下落，最后只能下达的判决结果为：“错误方式饲养宠物蛇导致的惨案。”","style":2,"log_type":1,"src_id":130301064,"trial_step":64,"drawing":1030302},{"step":69,"speaker":"玩家","content":"那个能和蛇对话的女孩，就是你吧，娜恰。和事件受害人家里的蛇对话。","style":2,"log_type":1,"src_id":130301065,"trial_step":65,"drawing":1030302},{"step":70,"speaker":"娜恰","content":"是又怎么样呢？他们沉浸在醉人的快乐中时，我已经不在那里啦~","voice":["vo_trial_30301_1_19"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301066,"trial_step":66,"drawing":1030303},{"step":71,"speaker":"玩家","content":"是的，我知道。","style":2,"log_type":1,"src_id":130301067,"trial_step":67,"drawing":1030303},{"step":72,"speaker":"玩家","content":"我调查过，这家人确实是通过一些不符合规则的渠道购买宠物的，但调查这条渠道路线的时候，我发现了一些不对劲的地方。","style":2,"log_type":1,"src_id":130301068,"trial_step":68,"drawing":1030303},{"step":73,"speaker":"玩家","content":"在他们的购买记录上，除了标注宠物的数量，重量，状态之外，还有一个加注。","style":2,"log_type":1,"src_id":130301069,"trial_step":69,"drawing":1030303},{"step":74,"content":"你指了指照片上的手写记录。","style":3,"log_type":1,"src_id":130301070,"trial_step":70,"drawing":1030303},{"step":75,"speaker":"玩家","content":"“储备粮”。没写种类，也没写重量，只写了简简单单的一个字，活。","style":2,"log_type":1,"src_id":130301071,"trial_step":71,"drawing":1030303},{"step":76,"speaker":"娜恰","content":"是，这也是我。","voice":["vo_trial_30301_1_20"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301072,"trial_step":72,"drawing":1030302},{"step":77,"speaker":"娜恰","content":"所以你就认为是我做的？","voice":["vo_trial_30301_1_21"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301073,"trial_step":73,"drawing":1030302},{"step":78,"speaker":"选项","options":["这只是合理怀疑罢了"],"style":6,"log_type":1,"src_id":130301074,"trial_step":74,"course":3,"drawing":1030302,"choices":[{"text":"这只是合理怀疑罢了","goto":75}]},{"step":79,"content":"娜恰看着你，嘴巴撅上了天，一副不开心的模样。","style":3,"log_type":1,"src_id":130301075,"trial_step":75,"drawing":1030302},{"step":80,"speaker":"娜恰","content":"他们玩蛇把自己搭进去，竟然能赖上我，局长真是不讲道理。","voice":["vo_trial_30301_1_22"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301076,"trial_step":76,"drawing":1030302},{"step":81,"speaker":"娜恰","content":"再说了，虽然他们把我签给了一家娱乐公司，但某种意义上来说，反而让我脱离了苦海。","voice":["vo_trial_30301_1_23"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301077,"trial_step":77,"drawing":1030302},{"step":82,"speaker":"娜恰","content":"呵~我开开心心过我的日子不好么，何必还跟他们纠缠不清呢。","voice":["vo_trial_30301_1_24"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301078,"trial_step":78,"drawing":1030303},{"step":83,"content":"娜恰还是那幅笑眯眯的模样，似乎断定你无法将她怎么样。","style":3,"log_type":1,"src_id":130301079,"trial_step":79,"drawing":1030303},{"step":84,"content":"确实，第一个案子当时已经结案了，警察查了没问题。而且她那时已经进了□□娱乐公司，怎么还能说跟她有关系呢？","style":3,"log_type":1,"src_id":130301080,"trial_step":80,"drawing":1030303},{"step":85,"content":"看来她不准备跟你坦诚什么。你看着她的眼睛，决定先转移话题。","style":3,"log_type":1,"src_id":130301081,"trial_step":81,"drawing":1030303},{"step":86,"speaker":"选项","options":["好，那先不聊这个"],"style":6,"log_type":1,"src_id":130301082,"trial_step":82,"course":3,"drawing":1030303,"choices":[{"text":"好，那先不聊这个","goto":83}]},{"step":87,"speaker":"玩家","content":"我们另外聊聊你提到的娱乐公司。","style":2,"log_type":1,"src_id":130301083,"trial_step":83,"drawing":1030303},{"step":88,"speaker":"娜恰","content":"怎么？他们签下我可是合法合规的，那家人……给我办了个临时身份证。","voice":["vo_trial_30301_1_25"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301084,"trial_step":84,"drawing":1030301},{"step":89,"speaker":"玩家","content":"我追究的也不是这个。","style":2,"log_type":1,"src_id":130301085,"trial_step":85,"drawing":1030301},{"step":90,"speaker":"娜恰","content":"……","style":1,"log_type":1,"src_id":130301086,"trial_step":86,"drawing":1030301},{"step":91,"speaker":"玩家","content":"你与蛇的表演，大获成功，因此成为了新城地下猎奇剧场的红人，还经常被邀请去驻场演出。","style":2,"log_type":1,"src_id":130301087,"trial_step":87,"drawing":1030301},{"step":92,"speaker":"玩家","content":"你为这家娱乐公司带来了巨额的收入，因此，在发生了几起事件时，他们选择了……为你掩盖。","style":2,"log_type":1,"src_id":130301088,"trial_step":88,"drawing":1030301},{"step":93,"speaker":"娜恰","content":"是吗？这破公司能多给我点分红就不错了，竟然还为我压下了案子吗？","voice":["vo_trial_30301_1_26"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301089,"trial_step":89,"drawing":1030301},{"step":94,"content":"测试音效的打断逻辑","style":3,"log_type":1,"src_id":2,"trial_step":90,"course":6,"drawing":1030301},{"step":95,"content":"播放一个长音效，会有个前奏，稍等一会儿。","style":3,"log_type":1,"src_id":2,"trial_step":90,"course":6,"drawing":1030301},{"step":96,"content":"播放相同音效，会继续延续。","style":3,"log_type":1,"src_id":2,"trial_step":90,"course":6,"drawing":1030301},{"step":97,"content":"暂停配置音效，这里测试一下打断。","style":3,"log_type":1,"src_id":2,"trial_step":90,"course":6,"drawing":1030301},{"step":98,"content":"播放一个稍短的音效，在这里等待它结束。","style":3,"log_type":1,"src_id":2,"trial_step":90,"course":6,"drawing":1030301},{"step":99,"content":"配置同名音效，看能否再次播放。","style":3,"log_type":1,"src_id":2,"trial_step":90,"course":6,"drawing":1030301},{"step":100,"content":"结束测试。","style":18,"log_type":1,"src_id":2,"trial_step":90,"course":6,"drawing":1030301},{"step":101,"speaker":"玩家","content":"和宠物案的受害人一样，这些人都突然失去了踪影，什么都没找到。加上这家娱乐公司的压制，最后不了了之。","style":2,"log_type":1,"src_id":130301091,"trial_step":91,"drawing":1030301},{"step":102,"speaker":"玩家","content":"当然，以我们的权限，能调查到的肯定不只是这些。","style":2,"log_type":1,"src_id":130301092,"trial_step":92,"drawing":1030301},{"step":103,"speaker":"玩家","content":"比如，无论是宠物案件，还是娱乐公司宾客失踪……案发现场都像被怪物大肆破坏了一番一样，非常惨痛。","style":2,"log_type":1,"src_id":130301093,"trial_step":93,"drawing":1030301},{"step":104,"content":"这样的惨状也几乎都指向了一些不同寻常的怪物……死役。","style":2,"log_type":1,"src_id":130301094,"trial_step":94,"drawing":1030301},{"step":105,"speaker":"娜恰","content":"……","style":1,"log_type":1,"src_id":130301095,"trial_step":95,"drawing":1030301},{"step":106,"speaker":"玩家","content":"从那个时候开始，你就在使用梦露了……使用梦露折磨他们，对吗？","style":2,"log_type":1,"src_id":130301096,"trial_step":96,"drawing":1030301},{"step":107,"speaker":"娜恰","content":"那又如何……我都说了，我这是在创造快乐！在帮助他们筑造美梦！！","voice":["vo_trial_30301_1_27"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301097,"trial_step":97,"drawing":1030304},{"step":108,"speaker":"娜恰","content":"吐出黑泥又怎么样？变成了死役又如何！那些痛苦的回忆本就该舍弃！你……为什么不愿意喝下梦露！我要你们的快乐！你们的美梦！","voice":["vo_trial_30301_1_28"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301098,"trial_step":98,"drawing":1030304},{"step":109,"content":"娜恰几乎是朝你吼出了这句话，她的肩膀上下耸动着，不停地喘气，像是用尽了全身的力气。","style":3,"log_type":1,"src_id":130301099,"trial_step":99,"drawing":1030304},{"step":110,"content":"你知道娜恰对快乐的执着，但在14区时，她设计引发骚乱时，都没有像现在这样……目无章法和歇斯底里。","style":3,"log_type":1,"src_id":130301100,"trial_step":100,"drawing":1030304},{"step":111,"content":"——枷锁在疯狂跳动，你依稀感受到了娜恰的情绪——她就像被什么东西捏住了生命一般，疯狂得无以复加。","style":3,"log_type":1,"src_id":130301101,"trial_step":101,"drawing":1030304},{"step":112,"speaker":"娜恰","content":"你……不懂他们的喜乐，那就更无法理解他们的痛苦……","voice":["vo_trial_30301_1_29"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301102,"trial_step":102,"drawing":1030304},{"step":113,"speaker":"玩家","content":"你一样没有理解他们的痛苦……你只是无视了它们。","style":2,"log_type":1,"src_id":130301103,"trial_step":103,"drawing":1030304},{"step":114,"speaker":"玩家","content":"沉溺在美梦里面并不能解决一切，娜恰。","style":2,"log_type":1,"src_id":130301104,"trial_step":104,"drawing":1030304},{"step":115,"speaker":"玩家","content":"我曾遇见过一位沉浸在自己乐园中的禁闭者，我不知道自己是否帮助了她，但这样的沉浸带给她的是痛苦。","style":2,"log_type":1,"src_id":130301105,"trial_step":105,"drawing":1030304},{"step":116,"speaker":"玩家","content":"我不希望你也这样。","style":2,"log_type":1,"src_id":130301106,"trial_step":106,"drawing":1030304},{"step":117,"content":"你站起身来，离开了座位，走到娜恰面前，注视着她。","style":3,"log_type":1,"src_id":130301107,"trial_step":107,"drawing":1030304},{"step":118,"speaker":"娜恰","content":"你为什么笃定我会因此痛苦？","voice":["vo_trial_30301_1_30"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301108,"trial_step":108,"drawing":1030304},{"step":119,"speaker":"娜恰","content":"你无法体验快乐和美梦，却在这里大言不惭地批判我的行为？","voice":["vo_trial_30301_1_31"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301109,"trial_step":109,"drawing":1030304},{"step":120,"content":"娜恰微微抬头，像是希望求得回答的小孩子一样盯着你。","style":3,"log_type":1,"src_id":130301110,"trial_step":110,"drawing":1030304},{"step":121,"speaker":"玩家","content":"我不是在批判你。","style":2,"log_type":1,"src_id":130301111,"trial_step":111,"drawing":1030304},{"step":122,"speaker":"玩家","content":"娜恰，从以前到现在，梦游者的症状一直在恶化，梦露则在逐渐变强，如果继续放任自己的能力和妙梦瓶，你一定会比现在更痛苦……","style":2,"log_type":1,"src_id":130301112,"trial_step":112,"drawing":1030304},{"step":123,"speaker":"玩家","content":"不要再妄想沉迷梦境了，也不要再使用梦露了，告诉我妙梦瓶的位置好吗？","style":2,"log_type":1,"src_id":130301113,"trial_step":113,"drawing":1030304},{"step":124,"content":"娜恰不再说话，审查室陷入沉默。","style":3,"log_type":1,"src_id":130301114,"trial_step":114,"drawing":1030302},{"step":125,"speaker":"选项","options":["这很重要"],"style":6,"log_type":1,"src_id":130301115,"trial_step":115,"course":3,"drawing":1030302,"choices":[{"text":"这很重要","goto":116}]},{"step":126,"speaker":"玩家","content":"继续沉溺在这种无法带来真正的幸福的梦里，是很危险的，娜恰。","style":2,"log_type":1,"src_id":130301116,"trial_step":116,"drawing":1030302},{"step":127,"content":"面对沉默的娜恰，你继续劝导着，可她始终不为所动。","style":3,"log_type":1,"src_id":130301117,"trial_step":117,"drawing":1030302},{"step":128,"speaker":"娜恰","content":"呵呵……我的快乐啊，梦境啊……局长，你之前问过我，为什么要回来。","voice":["vo_trial_30301_1_32"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301118,"trial_step":118,"drawing":1030303},{"step":129,"content":"许久过后，娜恰再次开口，语气里却是如坠入冰窖一般的寒意。","style":3,"log_type":1,"src_id":130301119,"trial_step":119,"drawing":1030303},{"step":130,"content":"你脖颈一凉，发现一条不知道从哪里出现的小蛇缠绕上了你的脖颈，在你耳边嘶嘶作响。","style":3,"log_type":1,"src_id":130301120,"trial_step":120,"drawing":1030303},{"step":131,"content":"娜恰端坐在椅子上看着你，眼眸中映着寒意。","style":3,"log_type":1,"src_id":130301121,"trial_step":121,"drawing":1030303},{"step":132,"speaker":"玩家","content":"梦露对我没用。","style":2,"log_type":1,"src_id":130301122,"trial_step":122,"drawing":1030303},{"step":133,"speaker":"娜恰","content":"我知道。","voice":["vo_trial_30301_1_33"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301123,"trial_step":123,"drawing":1030303},{"step":134,"speaker":"娜恰","content":"我是为了兑现对你的承诺，最后的时间里，我要给你快乐。所以，我只是想邀请你欣赏一场……盛大的马戏。","voice":["vo_trial_30301_1_34"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301124,"trial_step":124,"drawing":1030303},{"step":135,"content":"娜恰微微朝前倾身，像是蛊惑人一般对你说道。","style":3,"log_type":1,"src_id":130301125,"trial_step":125,"drawing":1030303},{"step":136,"speaker":"娜恰","content":"局长……能否将你的手给我？","voice":["vo_trial_30301_1_35"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301126,"trial_step":126,"drawing":1030303},{"step":137,"content":"你抬起双手，娜恰轻轻地握住，举至唇边。她的手掌冰凉，和你颈间的那条蛇一样。","style":3,"log_type":1,"src_id":130301127,"trial_step":127,"drawing":1030303},{"step":138,"speaker":"娜恰","content":"好乖呀，局长，就不怕我做些什么吗？","voice":["vo_trial_30301_1_36"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301128,"trial_step":128,"drawing":1030303},{"step":139,"speaker":"玩家","content":"你应该能感应到，枷锁已经缠绕在你身上了。","style":2,"log_type":1,"src_id":130301129,"trial_step":129,"drawing":1030303},{"step":140,"speaker":"娜恰","content":"呵呵……是的，我……能感应到。","voice":["vo_trial_30301_1_37"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301130,"trial_step":130,"drawing":1030301},{"step":141,"speaker":"玩家","content":"所以……你现在完全在我的控制之下……害怕的，或许应该是你。","style":2,"log_type":1,"src_id":130301131,"trial_step":131,"drawing":1030301},{"step":142,"speaker":"娜恰","content":"你不是很有自信，自己不会迷失在梦境吗？那跟我再赌一次吧，你赌自己能打碎扭曲的一切找到答案，我赌……我就赌上一切，来给你快乐吧。","voice":["vo_trial_30301_1_38"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301132,"trial_step":132,"drawing":1030301},{"step":143,"content":"枷锁确实能强迫她说出是什么人给了她梦露，妙梦瓶如今在什么地方——可这没办法解决最根本的事情。","style":3,"log_type":1,"src_id":130301133,"trial_step":133,"drawing":1030301},{"step":144,"content":"你不管、也不怕她接下来要对你做什么，你只知道，你必须要像打破梦境一般，把她对快乐和美梦的扭曲执念给打碎。","style":3,"log_type":1,"src_id":130301134,"trial_step":134,"drawing":1030301},{"step":145,"speaker":"玩家","content":"那……就交给你了。","style":2,"log_type":1,"src_id":130301135,"trial_step":135,"drawing":1030301},{"step":146,"content":"你看着娜恰尖尖的犬齿，对她微微一笑。","style":3,"log_type":1,"src_id":130301136,"trial_step":136,"drawing":1030301},{"step":147,"content":"枷锁在轻轻颤动，撩拨着你与娜恰的精神，你们似是对对方毫无保留，又似是对对方隐瞒了全部。","style":3,"log_type":1,"src_id":130301137,"trial_step":137,"drawing":1030301},{"step":148,"speaker":"娜恰","content":"好~好的呀~亲爱的局长，亲爱的观众……","voice":["vo_trial_30301_1_39"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301138,"trial_step":138,"drawing":1030305},{"step":149,"speaker":"娜恰","content":"让我们一起，去欣赏令人快乐的，最盛大的马戏吧！","voice":["vo_trial_30301_1_40"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301139,"trial_step":139,"drawing":1030305},{"step":150,"content":"面前的人说罢，轻轻地吻上了你的指尖——","style":3,"log_type":1,"src_id":130301140,"trial_step":140,"drawing":1030305},{"step":151,"speaker":"玩家","content":"嘶！","style":2,"log_type":1,"src_id":130301141,"trial_step":141,"drawing":1030305},{"step":152,"content":"指尖蓦地传来一下刺痛，你看到你的指尖，露出点点猩红。","style":3,"log_type":1,"src_id":130301142,"trial_step":142,"drawing":1030305},{"step":153,"speaker":"娜恰","content":"真是抱歉……局长。","voice":["vo_trial_30301_1_41"],"voice_bank":"vo_snake_trial","style":1,"log_type":1,"src_id":130301143,"trial_step":143,"drawing":1030305},{"step":154,"content":"娜恰没有放开你的手，反而攥得更紧，她吻上你的指尖，久久不愿放开。","style":3,"log_type":1,"src_id":130301144,"trial_step":144,"drawing":1030305},{"step":155,"content":"你的眼前开始变得朦胧，你能感受到是有什么东西顺着指尖破损的地方游走上来，让你变得昏沉。","style":3,"background":10000,"log_type":1,"src_id":130301145,"trial_step":145,"drawing":1030305},{"step":156,"content":"你仍能意识到你还在审查室，可是周围渐起的白雾，却让你不由自主地跟随那道酥麻的感觉，沉溺进去……","style":3,"background":10000,"log_type":1,"src_id":130301146,"trial_step":146,"drawing":1030305},{"step":157,"speaker":"娜恰","content":"<color=#e45515>清醒之人不入梦境……那就来到我的故事之中吧……</color>","voice":["vo_trial_30301_1_42"],"voice_bank":"vo_snake_trial","style":14,"background":10000,"log_type":1,"src_id":130301147,"trial_step":147,"drawing":1030305}]}