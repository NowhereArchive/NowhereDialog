{"id":4102,"chapter_id":4,"scene_id":410,"steps":[{"step":1,"speaker":"卓娅","content":"…………","style":1,"background":405,"log_type":1},{"step":2,"content":"屠戮结束，她身上暴走的杀气却仍未消散，脚踏碎刃，满身狂意，像是在寻找下一个猎物般，她眼中再次燃起火焰。","style":3,"background":405,"log_type":1},{"step":3,"content":"那火焰几乎失控，燃烧着，伴随着石坛中的心跳声逐渐暴走。","style":3,"background":405,"log_type":1},{"step":4,"content":"遗产没有随着爪牙的覆灭而沉寂，它颤动着，一个混沌的声音不知从何处传来，在你脑海深处响起——","style":3,"background":405,"log_type":1},{"step":5,"speaker":"混沌的声音","content":"<color=#dg1f1f>……强大的……想要……想要她……来…………</color>","voice":["vo_cgplot_4102005"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":6,"content":"这是遗产、是狂厄的蛊惑！","style":3,"background":405,"log_type":1},{"step":7,"options":["卓娅，离开石坛，不要被污染了！"],"jump":[8],"style":6,"background":405,"log_type":1},{"step":8,"speaker":"卓娅","content":"……","style":1,"background":405,"log_type":1},{"step":9,"content":"她给你的回应只有难以压制的愤怒。","style":3,"background":405,"log_type":1},{"step":10,"content":"就在这时，一双满是污秽的手抓住了卓娅。","style":3,"background":405,"log_type":1},{"step":11,"speaker":"赫罗","content":"你……终于来了……","voice":["vo_cgplot_4102011"],"voice_bank":"vo_cgplot_04","style":1,"background":50404,"log_type":1}]}