{"id":400703401,"chapter_id":50019,"scene_id":51923,"steps":[{"step":1,"content":"你停在了浓雾最中心——一个熟悉的家门前。","style":3,"background":10000,"log_type":1},{"step":2,"options":["推门进入"],"jump":[3],"style":6,"background":10000,"log_type":1},{"step":3,"content":"这里是一片虚无的异空间。浓雾弥漫，那些曾经规矩摆放的零碎物品都漂浮在空中，你依稀记得它原本的模样。","style":3,"background":2074,"log_type":1},{"step":4,"content":"松软的床褥，洁净的衬衫，记忆中喷香的早餐——你对一切有印象，但记忆在随着印象中那些令人安心的香气迅速褪去。","style":3,"background":2074,"log_type":1},{"step":5,"content":"在彻底忘记之前，你要尽快找到她。","style":3,"background":2074,"log_type":1},{"step":6,"options":["那个上锁的行李箱"],"jump":[7],"style":6,"background":2074,"log_type":1},{"step":7,"content":"行李箱不见了，或许是被主人带走了。那个小小的行李箱装不了多少东西，主人走得很匆忙。","style":3,"background":2074,"log_type":1},{"step":8,"content":"——又或者，毫无留恋。","style":3,"background":2074,"log_type":1},{"step":9,"content":"你听到一些响动。怀抱最后一丝希望，你找到了声响发出的房间。","style":3,"background":2074,"log_type":1},{"step":10,"options":["敲门"],"jump":[11],"style":6,"background":2074,"log_type":1},{"step":11,"content":"门没有锁，门板在你的动作下微微敞开。","style":3,"background":2074,"log_type":1},{"step":12,"content":"你看到了那熟悉的长发。","style":3,"background":2074,"log_type":1},{"step":13,"speaker":"模糊的身影","content":"我是剪断烦恼的理发师，我擅长处理这种事。","voice":["vo_event_400703302_84"],"voice_bank":"vo_event_07033","style":1,"background":2075,"log_type":1},{"step":14,"content":"——一团乱发聚成的阴影盘踞在中央，低声呢喃着，声音空洞，带着些许悲伤。","style":3,"background":2074,"log_type":1},{"step":15,"speaker":"乱发的阴影","content":"非走不可吗……非走不可吗……","voice":["vo_event_400703401_17"],"voice_bank":"vo_event_07034","style":1,"background":2074,"log_type":1},{"step":16,"speaker":"乱发的阴影","content":"可我……","voice":["vo_event_400703401_18"],"voice_bank":"vo_event_07034","style":1,"background":2074,"log_type":1},{"step":17,"speaker":"乱发的阴影","content":"想留下……","voice":["vo_event_400703401_19"],"voice_bank":"vo_event_07034","style":1,"background":2074,"log_type":1},{"step":18,"content":"这就是浓雾的中心，是被疯剪子遗弃的，属于她的烦恼。","style":3,"background":2074,"log_type":1}]}