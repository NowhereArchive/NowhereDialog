{"id":1020403,"chapter_id":1020403,"scene_id":1,"steps":[{"step":1,"content":"█月14日，2:41，局长办公室。","style":9,"background":1017,"log_type":1,"src_id":120403001,"trial_step":1},{"step":2,"content":"你在办公室翻阅着达斯医生给的文件。","style":3,"background":1017,"log_type":1,"src_id":120403002,"trial_step":2},{"step":3,"content":"这是一份标准的新城病历单。然而，其中的内容却与正常的诊断和治疗相去甚远。","style":3,"background":1017,"log_type":1,"src_id":120403003,"trial_step":3},{"step":4,"content":"姓名：多尼 性别：男 年龄：█ 病历号：█████████\n诊断：患者为禁闭者，西区人，同时是恐怖组织“锈火”的首领。在BR-002中受到重度狂厄污染，后受到清理人标记，因而幸存。\n104-105年期间，多次受到标记控制、处理锈火相关事宜，造成IV级精神伤害。精神抗性较高，适配率低，无法完成人偶化改造，被送至本院进行后续处理。\n目前患者表现为重度精神分裂。语言能力丧失、对外界刺激无反应。作为狂厄级禁闭者，有较高的试验和研究价值。经上级判断，交由B4实验室进行后续研究和处理。","style":10,"background":1017,"log_type":1,"src_id":120403004,"trial_step":4},{"step":5,"content":"你继续翻看着，后面的内容更加令人触目惊心。","style":3,"background":1017,"log_type":1,"src_id":120403005,"trial_step":5},{"step":6,"content":"治疗说明：\n106年█月█日 正式投入禁闭者力量增强试验项目\n106年█月█日 尝试使用电击、酸液、高温、冰冻等方式进行外部刺激，患者三度濒死，但M值未有明显提升。","style":10,"background":1017,"log_type":1,"src_id":120403006,"trial_step":6},{"step":7,"content":"107年█月█日 患者脑部活动偏弱，无法产生必要的情绪反馈。仅在疑似梦见BR-002场景时会产生较强的精神波动。该波动会伤害患者本身。虽然患者因此长期不具备反抗能力，却也严重拖延了项目进度。","style":10,"background":1017,"log_type":1,"src_id":120403007,"trial_step":7},{"step":8,"content":"107年█月█日 即日起，每隔两周将患者交由精神科进行治疗。B4实验室希望能借此方法一定程度上恢复该患者的精神水平，以期在后续实验中能够收获效果。","style":10,"background":1017,"log_type":1,"src_id":120403008,"trial_step":8},{"step":9,"content":"108年█月█日 B4实验室认为该患者已失去研究价值。无害化处理的申请被上级否决。考虑到患者缺乏基本的单独行动能力，允许增加精神科医生治疗的频率。但依旧需要派遣专员监视情况。如有异常，则对该患者以及相关人员进行无害化处理。","style":10,"background":1017,"log_type":1,"src_id":120403009,"trial_step":9},{"step":10,"speaker":"唐","content":"这么晚了，还不睡么？","voice":["vo_trial_20403_1_10"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403010,"trial_step":10},{"step":11,"content":"唐脸上挂着笑，手却没闲着，把那份文件丢到了办公室书架的最上面。","style":3,"background":1017,"log_type":1,"src_id":120403011,"trial_step":11},{"step":12,"speaker":"唐","content":"走你！","voice":["vo_trial_20403_1_12"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403012,"trial_step":12},{"step":13,"speaker":"唐","content":"这种满篇官话的病历可说不清四院的情况。你想知道真相的话，倒不如直接来找我。","voice":["vo_trial_20403_1_13"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403013,"trial_step":13},{"step":14,"content":"……","style":2,"background":1017,"log_type":1,"src_id":120403014,"trial_step":14},{"step":15,"speaker":"唐","content":"怎么，怕伤害到我脆弱的情感？","voice":["vo_trial_20403_1_15"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403015,"trial_step":15},{"step":16,"speaker":"唐","content":"哎呀没事的，你唐sir向来看得开。这都过去多少年了……","voice":["vo_trial_20403_1_16"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403016,"trial_step":16},{"step":17,"speaker":"唐","content":"来来来，赶紧的，等天亮了咱们还得再去趟新城呢。有什么想问的就赶紧问吧。","voice":["vo_trial_20403_1_17"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403017,"trial_step":17},{"step":18,"content":"唐拖来一张椅子，坐在了你面前。","style":3,"background":1017,"log_type":1,"src_id":120403018,"trial_step":18},{"step":19,"content":"他的表情十分轻松，仿佛真的已经不在意当年发生的事情了。","style":3,"background":1017,"log_type":1,"src_id":120403019,"trial_step":19},{"step":20,"content":"……","style":2,"background":1017,"log_type":1,"src_id":120403020,"trial_step":20},{"step":21,"content":"你略微思索了几秒，问出了第一个问题。","style":3,"background":1017,"log_type":1,"src_id":120403021,"trial_step":21},{"step":22,"options":["班彦四院究竟是什么情况？"],"style":6,"background":1017,"log_type":1,"src_id":120403022,"trial_step":22,"course":3,"choices":[{"text":"班彦四院究竟是什么情况？","goto":23}]},{"step":23,"speaker":"唐","content":"涅槃集团的下属机构。","voice":["vo_trial_20403_1_23"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403023,"trial_step":23},{"step":24,"content":"唐给出了一个非常简短的回答。","style":3,"background":1017,"log_type":1,"src_id":120403024,"trial_step":24},{"step":25,"speaker":"唐","content":"精神病院只是伪装，实际上四院只是表面上隶属班彦系统，真正的幕后控制者只有涅槃。","voice":["vo_trial_20403_1_25"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403025,"trial_step":25},{"step":26,"speaker":"唐","content":"它的功能就是做做人体实验，顺便帮涅槃解决那些不方便明着解决的“问题”。","voice":["vo_trial_20403_1_26"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403026,"trial_step":26},{"step":27,"speaker":"唐","content":"像达斯那种人，做的是他们明面上的“主营业务”，是给新城人看的幌子。","voice":["vo_trial_20403_1_27"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403027,"trial_step":27},{"step":28,"content":"上次聊的时候，你对我有所隐瞒。","style":2,"background":1017,"log_type":1,"src_id":120403028,"trial_step":28},{"step":29,"speaker":"唐","content":"嗐……","voice":["vo_trial_20403_1_29"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403029,"trial_step":29},{"step":30,"content":"唐有些不好意思地挠了挠头。","style":3,"background":1017,"log_type":1,"src_id":120403030,"trial_step":30},{"step":31,"speaker":"唐","content":"这不是担心你正义感爆棚，一怒之下带着人去四院把他们全突突了么？","voice":["vo_trial_20403_1_31"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403031,"trial_step":31},{"step":32,"content":"……我在你眼中就是这种性格么？","style":2,"background":1017,"log_type":1,"src_id":120403032,"trial_step":32},{"step":33,"speaker":"唐","content":"开玩笑开玩笑，主要我是来求你办事的，总给你树敌也不太好……","voice":["vo_trial_20403_1_33"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403033,"trial_step":33},{"step":34,"speaker":"唐","content":"我的错！下次有什么事我都第一时间说清楚，绝不隐瞒！","voice":["vo_trial_20403_1_34"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403034,"trial_step":34},{"step":35,"content":"……好。下一个问题。","style":2,"background":1017,"log_type":1,"src_id":120403035,"trial_step":35},{"step":36,"content":"你那之后的经历，是什么样？","style":2,"background":1017,"log_type":1,"src_id":120403036,"trial_step":36},{"step":37,"speaker":"唐","content":"什么之后的经历？","voice":["vo_trial_20403_1_37"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403037,"trial_step":37},{"step":38,"content":"我刚才看到的是，B4实验室认定你“失去研究价值”……","style":2,"background":1017,"log_type":1,"src_id":120403038,"trial_step":38},{"step":39,"speaker":"唐","content":"哦，那段啊。","voice":["vo_trial_20403_1_39"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403039,"trial_step":39},{"step":40,"speaker":"唐","content":"那之后我还是被关在那个实验室的病房里，不过倒是不怎么被拽去做实验了。大概他们是真的对我失去兴趣了吧。","voice":["vo_trial_20403_1_40"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403040,"trial_step":40},{"step":41,"speaker":"唐","content":"达斯医生倒是时不时下来，给我开点药、做做理疗什么的。","voice":["vo_trial_20403_1_41"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403041,"trial_step":41},{"step":42,"speaker":"唐","content":"然后……转机就来了。","voice":["vo_trial_20403_1_42"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403042,"trial_step":42},{"step":43,"content":"唐故作神秘地笑了笑，身体微微前倾。","style":3,"background":1017,"log_type":1,"src_id":120403043,"trial_step":43},{"step":44,"content":"转机？","style":2,"background":1017,"log_type":1,"src_id":120403044,"trial_step":44},{"step":45,"speaker":"唐","content":"没错！就是桑吉。","voice":["vo_trial_20403_1_45"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403045,"trial_step":45},{"step":46,"speaker":"唐","content":"你敢信么，一个西区的小老头，伪装成清洁工、孤身一人潜入了涅槃的地盘……还真就让他找到我了。","voice":["vo_trial_20403_1_46"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403046,"trial_step":46},{"step":47,"speaker":"唐","content":"之后就是我俩珠联璧合、合而为一、一锤定音……当然，主要还是靠他里里外外地忙活，才把情报传出去，搞了不少事儿。","voice":["vo_trial_20403_1_47"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403047,"trial_step":47},{"step":48,"speaker":"唐","content":"哦对了，后面还有那个自称诗人的女人。她也是，不知道怎么地就来了四院，愣是被她绕开守卫混进了地下设施。","voice":["vo_trial_20403_1_48"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403048,"trial_step":48},{"step":49,"speaker":"唐","content":"她告诉了我于连修建流民寨的事，还说锈火现在复活了。我听完这些消息心里那叫一个高兴啊，就感觉脑子一激灵……","voice":["vo_trial_20403_1_49"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403049,"trial_step":49},{"step":50,"speaker":"唐","content":"你猜怎么着？病当场就好了，之后再也没犯过。要不怎么老有人说“好消息赛过灵丹妙药”呢……","voice":["vo_trial_20403_1_50"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403050,"trial_step":50},{"step":51,"speaker":"唐","content":"当然啊，我不是在说达斯医生水平不行。要不是他之前给我治疗，加上一直护着我不让四院的人天天“做试验”，我估计都活不到那天。","voice":["vo_trial_20403_1_51"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403051,"trial_step":51},{"step":52,"content":"唐在描述自己的那段经历时，脸上的笑容始终如一。","style":3,"background":1017,"log_type":1,"src_id":120403052,"trial_step":52},{"step":53,"content":"很难想象那段地狱般的经历，在如今的他口中，却是如此云淡风轻。","style":3,"background":1017,"log_type":1,"src_id":120403053,"trial_step":53},{"step":54,"content":"只不过，事实恐怕并不都像他说的那般轻松。","style":3,"background":1017,"log_type":1,"src_id":120403054,"trial_step":54},{"step":55,"content":"你的精神痊愈，是在桑吉找到你之后很久才发生的事，对吧？","style":2,"background":1017,"log_type":1,"src_id":120403055,"trial_step":55},{"step":56,"content":"唐露出一副便秘似的表情，你继续追问道：","style":3,"background":1017,"log_type":1,"src_id":120403056,"trial_step":56},{"step":57,"content":"在那之前，就算他找到了你，也无法和你对话。因为当时的你“语言能力丧失、对外界刺激无反应”。","style":2,"background":1017,"log_type":1,"src_id":120403057,"trial_step":57},{"step":58,"content":"达斯医生也没办法庇护你，毕竟如今的他甚至自身难保。","style":2,"background":1017,"log_type":1,"src_id":120403058,"trial_step":58},{"step":59,"content":"那种被人监禁折磨的日子，一直持续到了112年，对么？","style":2,"background":1017,"log_type":1,"src_id":120403059,"trial_step":59},{"step":60,"content":"面对你一连串的问题，唐的笑容带上了些许无奈。","style":3,"background":1017,"log_type":1,"src_id":120403060,"trial_step":60},{"step":61,"speaker":"唐","content":"我觉得吧……其实也没必要分得那么清楚。","voice":["vo_trial_20403_1_61"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403061,"trial_step":61},{"step":62,"speaker":"唐","content":"反正最艰难的日子都已经过去了，我自己也早就不在意了，何必斤斤计较自己受过多少罪呢。","voice":["vo_trial_20403_1_62"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403062,"trial_step":62},{"step":63,"content":"在说这番话的时候，唐的表情十分真诚，眉眼间也没有一丝阴霾。","style":3,"background":1017,"log_type":1,"src_id":120403063,"trial_step":63},{"step":64,"content":"你忽然意识到，你似乎的确对“还原真相”有些过分执着了。","style":3,"background":1017,"log_type":1,"src_id":120403064,"trial_step":64},{"step":65,"content":"抱歉……","style":2,"background":1017,"log_type":1,"src_id":120403065,"trial_step":65},{"step":66,"speaker":"唐","content":"别别别，别道歉，我真没在意……嘶，别整这套，你看鸡皮疙瘩都掉了一地了。","voice":["vo_trial_20403_1_66"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403066,"trial_step":66},{"step":67,"content":"唐连连摆手。面对你真情实感的道歉，他反倒表现得颇为不自在。","style":3,"background":1017,"log_type":1,"src_id":120403067,"trial_step":67},{"step":68,"speaker":"唐","content":"说回正事吧，还想知道什么，赶紧问，哈……","voice":["vo_trial_20403_1_68"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403068,"trial_step":68},{"step":69,"content":"唐假模假样地打了个哈欠。","style":3,"background":1017,"log_type":1,"src_id":120403069,"trial_step":69},{"step":70,"speaker":"唐","content":"这个点了你不困我还困呢。","voice":["vo_trial_20403_1_70"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403070,"trial_step":70},{"step":71,"content":"你想了想，又问出了一个问题。","style":3,"background":1017,"log_type":1,"src_id":120403071,"trial_step":71},{"step":72,"content":"你当时为什么要让渡鸦回流民寨，告诉他们你死了？","style":2,"background":1017,"log_type":1,"src_id":120403072,"trial_step":72},{"step":73,"content":"唐正襟危坐，神秘兮兮地回答道：","style":3,"background":1017,"log_type":1,"src_id":120403073,"trial_step":73},{"step":74,"speaker":"唐","content":"我要是告诉你，因为我一眼就看出那个“大诗人”不靠谱，你信不？","voice":["vo_trial_20403_1_74"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403074,"trial_step":74},{"step":75,"content":"……我信。","style":2,"background":1017,"log_type":1,"src_id":120403075,"trial_step":75},{"step":76,"content":"你们相视一眼，几秒的沉默后，两人都放声笑了出来。","style":3,"background":1017,"log_type":1,"src_id":120403076,"trial_step":76},{"step":77,"speaker":"唐","content":"哈哈哈哈哈哈……","voice":["vo_trial_20403_1_77"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403077,"trial_step":77},{"step":78,"speaker":"唐","content":"第一次发现在背后说人坏话这么爽，哈哈哈……","voice":["vo_trial_20403_1_78"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403078,"trial_step":78},{"step":79,"content":"一边笑着，唐一边继续解释：","style":3,"background":1017,"log_type":1,"src_id":120403079,"trial_step":79},{"step":80,"speaker":"唐","content":"我当时就觉得，这姐们儿满嘴跑火车，怕是不太容易得到流民寨的信任。要是出去了说我还活着，八成当场就被轰出去。","voice":["vo_trial_20403_1_80"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403080,"trial_step":80},{"step":81,"speaker":"唐","content":"但你也知道，她人倒是不错，又是个禁闭者，要是能加入流民寨，一定能帮上大忙。","voice":["vo_trial_20403_1_81"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403081,"trial_step":81},{"step":82,"content":"所以你就给她编了这么一套说辞？","style":2,"background":1017,"log_type":1,"src_id":120403082,"trial_step":82},{"step":83,"speaker":"唐","content":"主要还是靠她自己，我就给补充了点细节。但是没想到效果这么好——大诗人顺利入伙，稳住了流民寨那边，还在后来出了大力气……","voice":["vo_trial_20403_1_83"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403083,"trial_step":83},{"step":84,"speaker":"唐","content":"回头想起来，这一手还真是没搞错。要是让大诗人到处宣传我活着，还让流民寨的人知道我被涅槃囚禁……","voice":["vo_trial_20403_1_84"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403084,"trial_step":84},{"step":85,"speaker":"唐","content":"不信倒还好，万一他们真信了，一群人上了头来涅槃老巢送死，那可就坏了事儿了。","voice":["vo_trial_20403_1_85"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403085,"trial_step":85},{"step":86,"content":"你点点头，继续问道：","style":3,"background":1017,"log_type":1,"src_id":120403086,"trial_step":86},{"step":87,"content":"等你后来痊愈了，又和桑吉里应外合……","style":2,"background":1017,"log_type":1,"src_id":120403087,"trial_step":87},{"step":88,"content":"以你的能力，没考虑过逃跑么？","style":2,"background":1017,"log_type":1,"src_id":120403088,"trial_step":88},{"step":89,"speaker":"唐","content":"那自然是想过的。","voice":["vo_trial_20403_1_89"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403089,"trial_step":89},{"step":90,"speaker":"唐","content":"不过当时我身上还有清理人的标记，先不提逃走之后有多大把握不被抓回去……","voice":["vo_trial_20403_1_90"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403090,"trial_step":90},{"step":91,"speaker":"唐","content":"单是留在四院里的人，我也放心不下。","voice":["vo_trial_20403_1_91"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403091,"trial_step":91},{"step":92,"content":"你担心涅槃有可能报复达斯他们？","style":2,"background":1017,"log_type":1,"src_id":120403092,"trial_step":92},{"step":93,"speaker":"唐","content":"对。","voice":["vo_trial_20403_1_93"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403093,"trial_step":93},{"step":94,"speaker":"唐","content":"而且不是有可能，是一定会报复。","voice":["vo_trial_20403_1_94"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403094,"trial_step":94},{"step":95,"speaker":"唐","content":"允许达斯给我治疗是为了让我在做实验的时候能有点用。要是真治好了，还让我逃了，那达斯肯定要背大锅的。","voice":["vo_trial_20403_1_95"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403095,"trial_step":95},{"step":96,"speaker":"唐","content":"本来达斯就和他们不对付，还知道那么多不该知道的东西……以涅槃那一点下限没有的手段，能不能让他活命都不一定呢。","voice":["vo_trial_20403_1_96"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403096,"trial_step":96},{"step":97,"speaker":"唐","content":"所以我索性就多在那边待了几年。","voice":["vo_trial_20403_1_97"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403097,"trial_step":97},{"step":98,"content":"唐一脸得意。","style":3,"background":1017,"log_type":1,"src_id":120403098,"trial_step":98},{"step":99,"speaker":"唐","content":"这下反而灯下黑了，四院的人到最后也没发现我是在装疯，哈哈哈哈。","voice":["vo_trial_20403_1_99"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403099,"trial_step":99},{"step":100,"content":"你是说你装疯装到112年都没被识破？这么厉害？","style":2,"background":1017,"log_type":1,"src_id":120403100,"trial_step":100},{"step":101,"speaker":"唐","content":"要不怎么当演技派呢……当然，也是多亏了桑吉和达斯配合。","voice":["vo_trial_20403_1_101"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403101,"trial_step":101},{"step":102,"speaker":"唐","content":"我跟你说，我也装过一次死，结果演得太像了，被四院的人直接送去焚尸炉了……","voice":["vo_trial_20403_1_102"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403102,"trial_step":102},{"step":103,"content":"？","style":2,"background":1017,"log_type":1,"src_id":120403103,"trial_step":103},{"step":104,"content":"那你怎么办？","style":2,"background":1017,"log_type":1,"src_id":120403104,"trial_step":104},{"step":105,"speaker":"唐","content":"还能怎么办，诈尸呗。","voice":["vo_trial_20403_1_105"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403105,"trial_step":105},{"step":106,"speaker":"唐","content":"给那几个孙子吓了一跳，关了我一个月禁闭。","voice":["vo_trial_20403_1_106"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403106,"trial_step":106},{"step":107,"speaker":"唐","content":"那之后我就不怎么想着逃跑了。","voice":["vo_trial_20403_1_107"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403107,"trial_step":107},{"step":108,"speaker":"唐","content":"唉，也不是不想，是真没办法……","voice":["vo_trial_20403_1_108"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403108,"trial_step":108},{"step":109,"content":"那你最后是怎么逃出来的？","style":2,"background":1017,"log_type":1,"src_id":120403109,"trial_step":109},{"step":110,"content":"唐双手一摊。","style":3,"background":1017,"log_type":1,"src_id":120403110,"trial_step":110},{"step":111,"speaker":"唐","content":"老实说，我也不太清楚。","voice":["vo_trial_20403_1_111"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403111,"trial_step":111},{"step":112,"speaker":"唐","content":"突然有一天，上庭那边一纸调令过来，我就被带去执委会了。","voice":["vo_trial_20403_1_112"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403112,"trial_step":112},{"step":113,"content":"调令是谁签署的，你知道么？","style":2,"background":1017,"log_type":1,"src_id":120403113,"trial_step":113},{"step":114,"speaker":"唐","content":"调令上签字的是清理人X，至于是不是她就不一定了。","voice":["vo_trial_20403_1_114"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403114,"trial_step":114},{"step":115,"content":"不怕有什么阴谋？","style":2,"background":1017,"log_type":1,"src_id":120403115,"trial_step":115},{"step":116,"speaker":"唐","content":"这有什么可怕的。","voice":["vo_trial_20403_1_116"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403116,"trial_step":116},{"step":117,"speaker":"唐","content":"不管是X还是别的什么人干的，结果就是把我放出来了对不对。","voice":["vo_trial_20403_1_117"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403117,"trial_step":117},{"step":118,"speaker":"唐","content":"这说明那个上庭佬八成和我们是站在一边的，就想给涅槃添堵呢。","voice":["vo_trial_20403_1_118"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403118,"trial_step":118},{"step":119,"speaker":"唐","content":"要是上庭真是铁板一块，都跟涅槃一个德性，那才没救了呢。","voice":["vo_trial_20403_1_119"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403119,"trial_step":119},{"step":120,"content":"你点了点头。唐这个观点倒是和你以往的认知不谋而合。","style":3,"background":1017,"log_type":1,"src_id":120403120,"trial_step":120},{"step":121,"content":"顺着这个想法延伸下去，你突然意识到了什么，脸上不禁露出了笑意。","style":3,"background":1017,"log_type":1,"src_id":120403121,"trial_step":121},{"step":122,"speaker":"唐","content":"想啥呢？怎么突然一脸坏笑？","voice":["vo_trial_20403_1_122"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403122,"trial_step":122},{"step":123,"content":"唐看着你这副表情，有些不解。","style":3,"background":1017,"log_type":1,"src_id":120403123,"trial_step":123},{"step":124,"content":"我在想……既然上庭不是铁板一块，那想必我把一些事情捅出去的时候，上面未必会出面保住他们吧？","voice":["vo_trial_20403_1_124"],"voice_bank":"vo_don_trial","style":2,"background":1017,"log_type":1,"src_id":120403124,"trial_step":124},{"step":125,"speaker":"唐","content":"靠！打小报告是吧？","voice":["vo_trial_20403_1_125"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403125,"trial_step":125},{"step":126,"content":"对，就是打小报告。","style":2,"background":1017,"log_type":1,"src_id":120403126,"trial_step":126},{"step":127,"content":"现在新城那边正是舆论风向变天的时候，一大批政客等着机会表明态度呢。","style":2,"background":1017,"log_type":1,"src_id":120403127,"trial_step":127},{"step":128,"content":"这种时候我们把四院和涅槃的旧账翻出来，你猜会怎么样？","style":2,"background":1017,"log_type":1,"src_id":120403128,"trial_step":128},{"step":129,"content":"又或者，我们可以选择……不捅出去。","style":2,"background":1017,"log_type":1,"src_id":120403129,"trial_step":129},{"step":130,"speaker":"唐","content":"你是说……","voice":["vo_trial_20403_1_130"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403130,"trial_step":130},{"step":131,"content":"没错，就是你想的那样。","style":2,"background":1017,"log_type":1,"src_id":120403131,"trial_step":131},{"step":132,"content":"有的牌，留在手里比打出去更有威慑力……","style":2,"background":1017,"log_type":1,"src_id":120403132,"trial_step":132},{"step":133,"speaker":"唐","content":"这一手好哇……又不会打草惊蛇，又不至于让他们狗急跳墙。还能坐地起价……","voice":["vo_trial_20403_1_133"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403133,"trial_step":133},{"step":134,"content":"唐一拍大腿，猛地站起身。","style":3,"background":1017,"log_type":1,"src_id":120403134,"trial_step":134},{"step":135,"speaker":"唐","content":"可以，就这么干！","voice":["vo_trial_20403_1_135"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403135,"trial_step":135},{"step":136,"speaker":"唐","content":"我去联络联络之前的朋友，给四院的人整波大的……","voice":["vo_trial_20403_1_136"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403136,"trial_step":136},{"step":137,"content":"看着唐满脸干劲，你有些无奈地指了指时钟。","style":3,"background":1017,"log_type":1,"src_id":120403137,"trial_step":137},{"step":138,"content":"……你要不要先看看时间？","style":2,"background":1017,"log_type":1,"src_id":120403138,"trial_step":138},{"step":139,"content":"都这个点了，你确定你能联络到你的朋友？","style":2,"background":1017,"log_type":1,"src_id":120403139,"trial_step":139},{"step":140,"content":"唐笑着挠了挠头。","style":3,"background":1017,"log_type":1,"src_id":120403140,"trial_step":140},{"step":141,"speaker":"唐","content":"确实确实，还是先睡觉吧。","voice":["vo_trial_20403_1_141"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403141,"trial_step":141},{"step":142,"content":"唐转过身，打了个哈欠。","style":3,"background":1017,"log_type":1,"src_id":120403142,"trial_step":142},{"step":143,"speaker":"唐","content":"你也早点睡，成天熬夜小心把身体搞垮了。","voice":["vo_trial_20403_1_143"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403143,"trial_step":143},{"step":144,"content":"谢谢唐sir关心。不过，我之前睡得够久了……","style":2,"background":1017,"log_type":1,"src_id":120403144,"trial_step":144},{"step":145,"speaker":"唐","content":"哈哈，说得也是。","voice":["vo_trial_20403_1_145"],"voice_bank":"vo_don_trial","style":1,"background":1017,"log_type":1,"src_id":120403145,"trial_step":145}]}