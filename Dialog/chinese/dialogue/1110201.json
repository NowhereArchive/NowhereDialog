":1,"log_type":1,"src_id":210201094,"trial_step":94,"drawing":1110203},{"step":106,"content":"蛇眼还是给议会和新城权贵干活的安保公司，阿廖沙听起来也很有精神。","style":2,"log_type":1,"src_id":210201095,"trial_step":95,"drawing":1110203},{"step":107,"speaker":"辰砂","content":"是吗……","voice":["vo_trial_110201_1_96"],"voice_bank":"vo_beisefenni_trial","style":1,"log_type":1,"src_id":210201096,"trial_step":96,"drawing":1110203},{"step":108,"content":"他向我提了一个相当离谱的要求，关于你的。","style":2,"log_type":1,"src_id":210201097,"trial_step":97,"drawing":1110203},{"step":109,"content":"辰砂疑惑地眨了眨眼。","style":3,"log_type":1,"src_id":210201098,"trial_step":98,"drawing":1110203},{"step":110,"content":"他要我放你出去，让你去接手一个任务。","style":2,"log_type":1,"src_id":210201099,"trial_step":99,"drawing":1110203},{"step":111,"content":"测试全屏类文本对演出效果的支持","style":14,"background":50409,"log_type":1,"src_id":3,"trial_step":100,"course":6,"drawing":1110203},{"step":112,"content":"转场…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":100,"course":6,"drawing":1110203},{"step":113,"content":"音效及语音…………………………………………………………………………","voice":["vo_cgplot_100002"],"voice_bank":"vo_cgplot_00","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":100,"course":6,"drawing":1110203},{"step":114,"content":"一次性特效…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":100,"course":6,"drawing":1110203},{"step":115,"content":"循环特效…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":100,"course":6,"drawing":1110203},{"step":116,"content":"循环特效…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":100,"course":6,"drawing":1110203},{"step":117,"content":"蛇眼想调用你，去保护议会的现任副议长。","style":2,"log_type":1,"src_id":210201101,"trial_step":101,"drawing":1110203},{"step":118,"content":"这位副议长近期计划在新城召开巡回演讲。就在最近，他收到了死亡威胁。","style":2,"log_type":1,"src_id":210201102,"trial_step":102,"drawing":1110203},{"step":119,"content":"虽然离开岗位多年，但作为顶尖从业者，辰砂还是很快进入了状态。","style":3,"log_type":1,"src_id":210201103,"trial_step":103,"drawing":1110201},{"step":120,"speaker":"辰砂","content":"情报部门有什么线索吗？","voice":["vo_trial_110201_1_104"],"voice_bank":"vo_beisefenni_trial","style":1,"log_type":1,"src_id":210201104,"trial_step":104,"drawing":1110201},{"step":121,"content":"没有。那家伙每天给雷根的个人终端发威胁信，用的都是虚拟IP。情报部门完全追查不到有用的信息。","style":2,"log_type":1,"src_id":210201105,"trial_step":105,"drawing":1110201},{"step":122,"content":"辰砂沉吟片刻，很快给出了她的意见。","style":3,"log_type":1,"src_id":210201106,"trial_step":106,"drawing":1110201},{"step":123,"speaker":"辰砂","content":"发出威胁的人以技术见长，需要配备短波通讯设备和电磁干扰装置。嗯……必须还得提防遥控炸弹……","voice":["vo_trial_110201_1_107"],"voice_bank":"vo_beisefenni_trial","style":1,"log_type":1,"src_id":210201107,"trial_step":107,"drawing":1110201},{"step":124,"content":"看来你已经做好准备了。","style":2,"log_type":1,"src_id":210201108,"trial_step":108,"drawing":1110201},{"step":125,"content":"辰砂抬起头，愣了一会儿。","style":3,"log_type":1,"src_id":210201109,"trial_step":109,"drawing":1110203},{"step":126,"speaker":"辰砂","content":"……我是禁闭者，为你工作，不该因为私事外出。","voice":["vo_trial_110201_1_110"],"voice_bank":"vo_beisefenni_trial","style":1,"log_type":1,"src_id":210201110,"trial_step":110,"drawing":1110203},{"step":127,"content":"自八年前狂厄患者刺杀议员的案件之后，高官举行活动，MBCC都有义务提供安保协力——当然要看对方有没有需求。你去的话，不算私事。","style":2,"log_type":1,"src_id":210201111,"trial_step":111,"drawing":1110203},{"step":128,"speaker":"辰砂","content":"蛇眼足够保护好雷根了，用不上我的。","voice":["vo_trial_110201_1_112"],"voice_bank":"vo_beisefenni_trial","style":1,"log_type":1,"src_id":210201112,"trial_step":112,"drawing":1110203},{"step":129,"content":"辰砂有些犹豫，或许是还没做好与昔日队友见面的准备。","style":3,"log_type":1,"src_id":210201113,"trial_step":113,"drawing":1110203},{"step":130,"content":"我一开始是这么跟阿廖沙说的：这么重要的任务，你确定她能行吗，况且，她还是个禁闭者，需要被监管。","style":2,"log_type":1,"src_id":210201114,"trial_step":114,"drawing":1110203},{"step":131,"content":"阿廖沙却说，“辰砂和其他禁闭者不一样！”","style":2,"log_type":1,"src_id":210201115,"trial_step":115,"drawing":1110203},{"step":132,"content":"还有桌上这些履历——你猜是谁寄来的？","style":2,"log_type":1,"src_id":210201116,"trial_step":116,"drawing":1110203},{"step":133,"speaker":"辰砂","content":"我……","voice":["vo_trial_110201_1_117"],"voice_bank":"vo_beisefenni_trial","style":1,"log_type":1,"src_id":210201117,"trial_step":117,"drawing":1110203},{"step":134,"content":"给你的同事们一点信任吧，这次的任务，应该就是他们争取来的。","style":2,"log_type":1,"src_id":210201118,"trial_step":118,"drawing":1110203},{"step":135,"content":"他们或许早就原谅你了，只是你还没原谅自己。","style":2,"log_type":1,"src_id":210201119,"trial_step":119,"drawing":1110203},{"step":136,"content":"短暂的沉默之后，辰砂的眼神变得坚决起来。","style":3,"log_type":1,"src_id":210201120,"trial_step":120,"drawing":1110203},{"step":137,"speaker":"辰砂","content":"如果真的是阿廖沙他们的意愿……那我的确不该再辜负他们。","voice":["vo_trial_110201_1_121"],"voice_bank":"vo_beisefenni_trial","style":1,"log_type":1,"src_id":210201121,"trial_step":121,"drawing":1110201},{"step":138,"speaker":"辰砂","content":"我接受这个任务。","voice":["vo_trial_110201_1_122"],"voice_bank":"vo_beisefenni_trial","style":1,"log_type":1,"src_id":210201122,"trial_step":122,"drawing":1110201},{"step":139,"content":"那就没问题了。顺带一提，出于MBCC的监管责任，我必须全程陪同，毕竟……","style":2,"log_type":1,"src_id":210201123,"trial_step":123,"drawing":1110201},{"step":140,"speaker":"辰砂","content":"我理解。","voice":["vo_trial_110201_1_124"],"voice_bank":"vo_beisefenni_trial","style":1,"log_type":1,"src_id":210201124,"trial_step":124,"drawing":1110201},{"step":141,"speaker":"辰砂","content":"您放心，我会遵守规定的。","voice":["vo_trial_110201_1_126"],"voice_bank":"vo_beisefenni_trial","style":1,"log_type":1,"src_id":210201126,"trial_step":126,"drawing":1110201,"next":[128]},{"step":142,"speaker":"辰砂","content":"您放心，我会一直在您视线之内。","voice":["vo_trial_110201_1_127"],"voice_bank":"vo_beisefenni_trial","style":1,"log_type":1,"src_id":210201127,"trial_step":127,"drawing":1110201}]}