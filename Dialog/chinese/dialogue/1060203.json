{"id":1060203,"chapter_id":1060203,"scene_id":1,"steps":[{"step":1,"content":"从美术馆出来，恩菲尔带你前往靠近郊区的一座府邸。","style":3,"background":3003,"log_type":1,"src_id":160203001,"trial_step":1},{"step":2,"content":"黑色的大理石门雕，让你想起了美术馆的那一扇“地狱之门”。","style":3,"background":3003,"log_type":1,"src_id":160203002,"trial_step":2},{"step":3,"content":"见你看着门口，恩菲尔猜出了你在想什么。","style":3,"background":3003,"log_type":1,"src_id":160203003,"trial_step":3},{"step":4,"speaker":"恩菲尔","content":"害怕了？","voice":["vo_trial_60203_1_1"],"voice_bank":"vo_enfer_trial","style":1,"background":3003,"log_type":1,"src_id":160203004,"trial_step":4},{"step":5,"speaker":"恩菲尔","content":"放心吧，它没有那种力量。","voice":["vo_trial_60203_1_2"],"voice_bank":"vo_enfer_trial","style":1,"background":3003,"log_type":1,"src_id":160203005,"trial_step":5},{"step":6,"content":"恩菲尔笑笑，拉着你往宅院深处走去。","style":3,"background":3003,"log_type":1,"src_id":160203006,"trial_step":6},{"step":7,"content":"你们绕过一片疏于打理的花园，如果这些枯萎的花都开了的话，一定和那幅油画上的一样。","style":3,"background":3003,"log_type":1,"src_id":160203007,"trial_step":7},{"step":8,"speaker":"恩菲尔","content":"从花园后面的小房间进去，再往下走，就是我的工作间了。","voice":["vo_trial_60203_1_3"],"voice_bank":"vo_enfer_trial","style":1,"background":3003,"log_type":1,"src_id":160203008,"trial_step":8},{"step":9,"speaker":"恩菲尔","content":"小心一点，那里的台阶有些陡。","voice":["vo_trial_60203_1_4"],"voice_bank":"vo_enfer_trial","style":1,"background":3003,"log_type":1,"src_id":160203009,"trial_step":9},{"step":10,"content":"推开门，一级一级走下去，你和恩菲尔渐渐没入黑暗。","style":3,"background":2031,"log_type":1,"src_id":160203010,"trial_step":10},{"step":11,"content":"你正担心，恩菲尔啪地点亮了一盏雕成龇牙咧嘴的小精灵的灯。","style":3,"background":2031,"log_type":1,"src_id":160203011,"trial_step":11},{"step":12,"content":"惨白的灯光照亮了脚下的路，却没来由地让人觉得这里直通地狱。","style":3,"background":2031,"log_type":1,"src_id":160203012,"trial_step":12},{"step":13,"speaker":"恩菲尔","content":"不过……在二十年前，这里也是我父亲的工作室。","voice":["vo_trial_60203_1_5"],"voice_bank":"vo_enfer_trial","style":1,"background":2031,"log_type":1,"src_id":160203013,"trial_step":13},{"step":14,"speaker":"恩菲尔","content":"他在这里创作出了无数作品……","voice":["vo_trial_60203_1_6"],"voice_bank":"vo_enfer_trial","style":1,"background":2031,"log_type":1,"src_id":160203014,"trial_step":14},{"step":15,"speaker":"恩菲尔","content":"包括那尊雕塑，真实之人。","voice":["vo_trial_60203_1_7"],"voice_bank":"vo_enfer_trial","style":1,"background":2031,"log_type":1,"src_id":160203015,"trial_step":15},{"step":16,"content":"看来……是个很有故事的工作间。","style":2,"background":2031,"log_type":1,"src_id":160203016,"trial_step":16},{"step":17,"speaker":"恩菲尔","content":"那你想听听……在它肚子里发生的故事吗？","voice":["vo_trial_60203_1_8"],"voice_bank":"vo_enfer_trial","style":1,"background":2031,"log_type":1,"src_id":160203017,"trial_step":17},{"step":18,"content":"恩菲尔走在你的前面，她抬起头来，仰视着你，而你微微低头。","style":3,"background":2031,"log_type":1,"src_id":160203018,"trial_step":18},{"step":19,"speaker":"恩菲尔","content":"有没有发现，我们现在的姿势……很适合拥抱。","voice":["vo_trial_60203_1_9"],"voice_bank":"vo_enfer_trial","style":1,"background":2031,"log_type":1,"src_id":160203019,"trial_step":19},{"step":20,"options":["你需要一个拥抱吗"],"style":6,"background":2031,"log_type":1,"src_id":160203020,"trial_step":20,"course":3,"choices":[{"text":"你需要一个拥抱吗","goto":21}]},{"step":21,"speaker":"恩菲尔","content":"权当听故事的报酬吧，不过，先欠着。","voice":["vo_trial_60203_1_10"],"voice_bank":"vo_enfer_trial","style":1,"background":2031,"log_type":1,"src_id":160203021,"trial_step":21},{"step":22,"content":"恩菲尔继续向下走去，她打开一盏盏灯，白得晃眼的光亮一点点延伸，跟随着恩菲尔所讲述的故事缓缓铺开。","style":3,"background":1049,"log_type":1,"src_id":160203022,"trial_step":22},{"step":23,"speaker":"恩菲尔","content":"我虽然出生于艺术世家……但那两个人的结合，毫无艺术可言。","voice":["vo_trial_60203_1_11"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203023,"trial_step":23},{"step":24,"speaker":"恩菲尔","content":"就和培育名种猫一样，优秀的基因和优秀的基因结合，一定会诞生出更优秀的细胞。","voice":["vo_trial_60203_1_12"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203024,"trial_step":24},{"step":25,"speaker":"恩菲尔","content":"呵……","voice":["vo_trial_60203_1_13"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203025,"trial_step":25},{"step":26,"content":"恩菲尔按下开关，白色的光芒冲刷而下，为她渡上一层脆弱而刺眼的光芒。","style":3,"background":1049,"log_type":1,"src_id":160203026,"trial_step":26},{"step":27,"speaker":"恩菲尔","content":"我的母亲尝试着爱枕边人，尝试着经营这个在外人看来，美满又富有艺术气息的家。","voice":["vo_trial_60203_1_14"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203027,"trial_step":27},{"step":28,"speaker":"恩菲尔","content":"她极为擅长画油画，便在我会走的时候，就教我如何握笔。","voice":["vo_trial_60203_1_15"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203028,"trial_step":28},{"step":29,"content":"踏完最后一级台阶，你感受到自己进入了一个宽阔的空间，灯一盏接一盏的打开，你看着恩菲尔往前走去。","style":3,"background":1049,"log_type":1,"src_id":160203029,"trial_step":29},{"step":30,"content":"眼前的女孩讲着故事，顺手从工作台上拿起一只长长的錾，手法像是画油画一般，在空中挥舞了一会儿，最终无力地垂下。","style":3,"background":1049,"log_type":1,"src_id":160203030,"trial_step":30},{"step":31,"content":"就像是颜料画出了画布，这幅画也就失去了意义。","style":3,"background":1049,"log_type":1,"src_id":160203031,"trial_step":31},{"step":32,"speaker":"恩菲尔","content":"可索西亚说得没错——爱又能带来什么呢？","voice":["vo_trial_60203_1_16"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203032,"trial_step":32},{"step":33,"speaker":"恩菲尔","content":"她还是躺在了他的脚下。","voice":["vo_trial_60203_1_17"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203033,"trial_step":33},{"step":34,"content":"叮咚一声，那把长长的錾子掉落在了地上。","style":3,"background":1049,"log_type":1,"src_id":160203034,"trial_step":34},{"step":35,"content":"恩菲尔没有理会，径直走到工作室深处，那是这里唯一还淹没在黑暗中的地方。","style":3,"background":1049,"log_type":1,"src_id":160203035,"trial_step":35},{"step":36,"speaker":"恩菲尔","content":"雷雨天总是能带给人不一样的刺激，他需要灵感，需要闪电或是炸雷般刻骨铭心的灵光一闪。","voice":["vo_trial_60203_1_18"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203036,"trial_step":36},{"step":37,"speaker":"恩菲尔","content":"所以，他不顾她的哭泣和哀求，也不顾寻声而来的我……疼痛能唤起真实，恐惧能带来灵感——他毫不犹豫地要求我们为他奉献。","voice":["vo_trial_60203_1_19"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203037,"trial_step":37},{"step":38,"content":"恩菲尔瞥了一眼脚下的錾子，陷入回忆的眼神中赤裸裸的全是冰冷。","style":3,"background":1049,"log_type":1,"src_id":160203038,"trial_step":38},{"step":39,"speaker":"恩菲尔","content":"錾锤声一下又一下，外面疾风骤雨，最后……他将她恐惧的表情刻在了我的脑海深处……也完成了他的杰作……","voice":["vo_trial_60203_1_20"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203039,"trial_step":39},{"step":40,"speaker":"恩菲尔","content":"我第一次明白何为恐惧，而恐惧又代表了什么……","voice":["vo_trial_60203_1_21"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203040,"trial_step":40},{"step":41,"content":"恩菲尔回头看着你，你略显惊讶的表情让她非常满意。","style":3,"background":1049,"log_type":1,"src_id":160203041,"trial_step":41},{"step":42,"speaker":"恩菲尔","content":"是真实，是力量。","voice":["vo_trial_60203_1_22"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203042,"trial_step":42},{"step":43,"speaker":"恩菲尔","content":"我原以为我也会就此定格在那里……没想到……","voice":["vo_trial_60203_1_23"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203043,"trial_step":43},{"step":44,"speaker":"恩菲尔","content":"可能因为他需要一个见证者吧！我是他的见证者，见证了他的突破——再也没有人会说他比不上自己的妻子，再也没有人会说他没有拿不出手的作品了。","voice":["vo_trial_60203_1_24"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203044,"trial_step":44},{"step":45,"speaker":"恩菲尔","content":"他将妻子给予的一切，化作了一尊雕像，那他最出名的作品，真实之人。","voice":["vo_trial_60203_1_25"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203045,"trial_step":45},{"step":46,"content":"这个故事，好像和你在贝尔芬格说给我听的不太一样。","style":2,"background":1049,"log_type":1,"src_id":160203046,"trial_step":46},{"step":47,"speaker":"恩菲尔","content":"嗯~你猜猜……哪个是真的，哪个是假的？","voice":["vo_trial_60203_1_26"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203047,"trial_step":47},{"step":48,"content":"只要是你说的，那都有可能是真的。","style":2,"background":1049,"log_type":1,"src_id":160203048,"trial_step":48},{"step":49,"content":"恩菲尔笑而不语，打开了她面前的最后一盏灯。","style":3,"background":1049,"log_type":1,"src_id":160203049,"trial_step":49},{"step":50,"content":"灯光之下，整个工坊清晰可见。各种雕刻工具，随意摆放，布满石屑和碎块。","style":3,"background":1049,"log_type":1,"src_id":160203050,"trial_step":50},{"step":51,"content":"而更令人汗毛倒竖的，是在恩菲尔的前方，工坊的深处，静静地立着一尊纯白的雕像。","style":3,"background":1049,"log_type":1,"src_id":160203051,"trial_step":51},{"step":52,"content":"明明是纯白色，却让人觉得扭曲，阴暗，冰冷。他脸上的表情和肢体动作无不显示他正在经历巨大的恐惧。","style":3,"background":1049,"log_type":1,"src_id":160203052,"trial_step":52},{"step":53,"speaker":"恩菲尔","content":"身为他的见证者，后继者，我自然也要和他一样，拿出足以震惊世人的作品来。","voice":["vo_trial_60203_1_27"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203053,"trial_step":53},{"step":54,"content":"8月20日，BR-004黑环爆炸，你的父亲失踪……","style":2,"background":1049,"log_type":1,"src_id":160203054,"trial_step":54},{"step":55,"content":"所以他是……","style":2,"background":1049,"log_type":1,"src_id":160203055,"trial_step":55},{"step":56,"speaker":"恩菲尔","content":"对世界，对自然毫不忠心之人，灵感总是会很快枯竭……","voice":["vo_trial_60203_1_28"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203056,"trial_step":56},{"step":57,"speaker":"恩菲尔","content":"他找到我，他说他是爱着我的，所以我必须像母亲一样，为了这个家，为了他……","voice":["vo_trial_60203_1_29"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203057,"trial_step":57},{"step":58,"speaker":"恩菲尔","content":"但我一直记得那个雷雨天。","voice":["vo_trial_60203_1_30"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203058,"trial_step":58},{"step":59,"speaker":"恩菲尔","content":"所以我……也让他成就了我的作品，我和他一样……拥有了被世人所赞颂的作品。","voice":["vo_trial_60203_1_31"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203059,"trial_step":59},{"step":60,"speaker":"恩菲尔","content":"要来欣赏一下吗？我的成名作。","voice":["vo_trial_60203_1_32"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203060,"trial_step":60},{"step":61,"content":"恩菲尔又一次对你伸出了手。","style":3,"background":1049,"log_type":1,"src_id":160203061,"trial_step":61},{"step":62,"content":"可明明她已经将自己对父亲的恐惧封印在了这尊雕塑中，为什么她的手，还是在颤抖呢？","style":3,"background":1049,"log_type":1,"src_id":160203062,"trial_step":62},{"step":63,"options":["好。"],"style":3,"background":1049,"log_type":1,"src_id":160203063,"trial_step":63,"course":3,"choices":[{"text":"好。","goto":64}]},{"step":64,"content":"你走上前去，和恩菲尔一起观看着。","style":3,"background":1049,"log_type":1,"src_id":160203064,"trial_step":64},{"step":65,"speaker":"恩菲尔","content":"那是……极致的景象。灵感裹挟着恐惧，惊悚，畏怯，喷涌而出。","voice":["vo_trial_60203_1_33"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203065,"trial_step":65},{"step":66,"speaker":"恩菲尔","content":"我在那轮红色的焰火里，再次明确了我的内心，明确了我一直创作的作品都是为了什么。","voice":["vo_trial_60203_1_34"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203066,"trial_step":66},{"step":67,"speaker":"恩菲尔","content":"他将恐惧刻印在我的意识深处，给了我巨大的力量……","voice":["vo_trial_60203_1_35"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203067,"trial_step":67},{"step":68,"speaker":"恩菲尔","content":"因此行走在地狱的我，窥视真实的我，理应将这一切都展示出来。","voice":["vo_trial_60203_1_36"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203068,"trial_step":68},{"step":69,"content":"她沉醉地说着，仿佛又回忆起了那个时候所见的景象。","style":3,"background":1049,"log_type":1,"src_id":160203069,"trial_step":69},{"step":70,"content":"然而待你看清那尊雕塑后，你的背上冒出一阵阵冷汗。不只是因为这尊雕像从内而外散发的恐惧气息，而是你认出来了……","style":3,"background":1049,"log_type":1,"src_id":160203070,"trial_step":70},{"step":71,"content":"在魔女之夜中，一个幻像击破了索西亚的恐惧，这尊雕塑……和那个幻像一模一样！","style":3,"background":1049,"log_type":1,"src_id":160203071,"trial_step":71},{"step":72,"content":"恩菲尔……这尊雕塑，并没有在魔女之夜上展出，对吗？","style":2,"background":1049,"log_type":1,"src_id":160203072,"trial_step":72},{"step":73,"speaker":"恩菲尔","content":"当然，他……一直被我存放在这里。","voice":["vo_trial_60203_1_37"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203073,"trial_step":73},{"step":74,"content":"但是……","style":2,"background":1049,"log_type":1,"src_id":160203074,"trial_step":74},{"step":75,"content":"索西亚的恐惧幻想，是被他击破的。","style":2,"background":1049,"log_type":1,"src_id":160203075,"trial_step":75},{"step":76,"speaker":"恩菲尔","content":"……不可能。","voice":["vo_trial_60203_1_38"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203076,"trial_step":76},{"step":77,"speaker":"恩菲尔","content":"我已经征服了……我不会屈服于他的恐惧了，为什么……？！","voice":["vo_trial_60203_1_39"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203077,"trial_step":77},{"step":78,"content":"隔着一道玻璃外壳，恩菲尔狠狠地盯着自己创作出来的雕塑。","style":3,"background":1049,"log_type":1,"src_id":160203078,"trial_step":78},{"step":79,"content":"她一点一点地扫视着，像是要看穿曾经的自己是如何将它创作出来的。","style":3,"background":1049,"log_type":1,"src_id":160203079,"trial_step":79},{"step":80,"content":"可是，当她看到雕塑的胸前时，却愣在了原地。","style":3,"background":1049,"log_type":1,"src_id":160203080,"trial_step":80},{"step":81,"speaker":"恩菲尔","content":"为什么……这里也有？！","voice":["vo_trial_60203_1_40"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203081,"trial_step":81},{"step":82,"content":"你也看清楚了——在这尊扭曲的雕塑的胸前，有一个小小的，心形的凹痕。","style":3,"background":1049,"log_type":1,"src_id":160203082,"trial_step":82},{"step":83,"speaker":"恩菲尔","content":"哈哈哈……原来……原来，在那个雨夜里……我就已经被软弱所禁锢了啊……","voice":["vo_trial_60203_1_41"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203083,"trial_step":83},{"step":84,"speaker":"恩菲尔","content":"所以我才会……才会被你击破吗？！","voice":["vo_trial_60203_1_42"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203084,"trial_step":84},{"step":85,"content":"这是她的作品，是她自以为将恐惧征服的作品，也是她被恐惧彻底束缚的缘由……","style":3,"background":1049,"log_type":1,"src_id":160203085,"trial_step":85},{"step":86,"content":"恩菲尔低声笑了起来，她的双手贴在玻璃上，指甲划过的声音让人不适。","style":3,"background":1049,"log_type":1,"src_id":160203086,"trial_step":86},{"step":87,"speaker":"恩菲尔","content":"我明明应该和他一样，变得更加厉害，创造出完美的，令人发觉内心恐惧的作品！","voice":["vo_trial_60203_1_43"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203087,"trial_step":87},{"step":88,"speaker":"恩菲尔","content":"让所有人都见证世界的真实模样！","voice":["vo_trial_60203_1_44"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203088,"trial_step":88},{"step":89,"speaker":"恩菲尔","content":"可是为什么……我会惧怕他！为什么我会软弱？！为什么要束缚我呢……？","voice":["vo_trial_60203_1_45"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203089,"trial_step":89},{"step":90,"content":"周围的温度蓦然下降，惨白的灯泡发出令人不悦的电流声。","style":3,"background":1049,"log_type":1,"src_id":160203090,"trial_step":90},{"step":91,"content":"玻璃罩内的雕塑一动不动，却没来由地让人觉得……它正在等待一个，向你们扑来的契机。","style":3,"background":1049,"log_type":1,"src_id":160203091,"trial_step":91},{"step":92,"content":"意识之中的枷锁猛烈地跳动了一下，刺痛了你的精神——你感受到一股熟悉的力量正在苏醒。","style":3,"background":1049,"log_type":1,"src_id":160203092,"trial_step":92},{"step":93,"options":["进行安抚"],"style":6,"background":1049,"log_type":1,"src_id":160203093,"trial_step":93,"course":3,"choices":[{"text":"进行安抚","goto":94}]},{"step":94,"content":"你并不软弱，也绝对能创作出完美的作品！","style":2,"background":1049,"log_type":1,"src_id":160203094,"trial_step":94},{"step":95,"content":"如果这个痕迹就是你的软弱和迷茫，我会跟你一起找到它存在的理由，再一起解决。","style":2,"background":1049,"log_type":1,"src_id":160203095,"trial_step":95},{"step":96,"content":"你的异能在波动，这不是好的预兆，恩菲尔，冷静一点。","style":2,"background":1049,"log_type":1,"src_id":160203096,"trial_step":96},{"step":97,"content":"恩菲尔低着头，好像完全没有把你的话听进去。","style":3,"background":1049,"log_type":1,"src_id":160203097,"trial_step":97},{"step":98,"content":"你抬起手，正准备将她拉回来——","style":3,"background":1049,"log_type":1,"src_id":160203098,"trial_step":98},{"step":99,"speaker":"破碎声","content":"啪——！！","style":1,"background":1049,"log_type":1,"src_id":160203099,"trial_step":99},{"step":100,"content":"不过一瞬间，围住雕塑的玻璃橱窗在震动之中破碎，飞溅的玻璃渣划破了你的脸颊，留下了一道红色的痕迹。","style":3,"background":1049,"log_type":1,"src_id":160203100,"trial_step":100},{"step":101,"content":"恩菲尔！不要陷进去！你现在的能力还不太稳定，小心……！","style":2,"background":1049,"log_type":1,"src_id":160203101,"trial_step":101},{"step":102,"speaker":"？？？","content":"呵呵呵呵呵……","voice":["vo_trial_60203_1_46"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203102,"trial_step":102},{"step":103,"speaker":"？？？","content":"愤怒吧……惊诧吧……","voice":["vo_trial_60203_1_47"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203103,"trial_step":103},{"step":104,"content":"诡异的声音打断了你的话，你惊讶地发现，那尊名为虚妄之人的雕塑，竟然好像沥青一般开始慢慢融化。","style":3,"background":1049,"log_type":1,"src_id":160203104,"trial_step":104},{"step":105,"content":"恩菲尔，你的异能在暴走！它又开始影响周围的艺术品了！","style":2,"background":1049,"log_type":1,"src_id":160203105,"trial_step":105},{"step":106,"content":"你现在的状态很危险，来，把手给我！","style":2,"background":1049,"log_type":1,"src_id":160203106,"trial_step":106},{"step":107,"speaker":"“虚妄之人”","content":"闭嘴！","voice":["vo_trial_60203_1_48"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203107,"trial_step":107},{"step":108,"content":"纯白色的液体突然变硬，直直地向你刺来，将你逼退，不得不远离恩菲尔。","style":3,"background":1049,"log_type":1,"src_id":160203108,"trial_step":108},{"step":109,"content":"而那些融化的，柔软的液体，趁你无法靠近恩菲尔，裹住了恩菲尔的脚底，一点点地往上吞咽。","style":3,"background":1049,"log_type":1,"src_id":160203109,"trial_step":109},{"step":110,"speaker":"“虚妄之人”","content":"我知道你……只有我知道你……","voice":["vo_trial_60203_1_49"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203110,"trial_step":110},{"step":111,"speaker":"“虚妄之人”","content":"你想要寻找……你的软弱……你的迷茫！","voice":["vo_trial_60203_1_50"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203111,"trial_step":111},{"step":112,"speaker":"“虚妄之人”","content":"她的爱……他的爱……让你软弱！让你无知！是你创造完美的最大阻碍！","female_content":"她的爱……她的爱……让你软弱！让你无知！是你创造完美的最大阻碍！","voice":["vo_trial_60203_1_51","vo_trial_60203_1_51f"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203112,"trial_step":112},{"step":113,"speaker":"“虚妄之人”","content":"来……来到你的世界之中……去除掉她！","voice":["vo_trial_60203_1_52"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203113,"trial_step":113},{"step":114,"speaker":"“虚妄之人”","content":"除掉那些……让你软弱的人……","voice":["vo_trial_60203_1_53"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203114,"trial_step":114},{"step":115,"content":"融化的雕像已经淹没到恩菲尔的脖颈，枷锁在你的精神里跳动警告着，让你留意眼前正在发生的危险。","style":3,"background":1049,"log_type":1,"src_id":160203115,"trial_step":115},{"step":116,"content":"恩菲尔的力量过于强大，BR-004爆炸时，她的力量通过创作无意识地进入到了这些作品之中。","style":3,"background":1049,"log_type":1,"src_id":160203116,"trial_step":116},{"step":117,"content":"尽管魔女之夜已经被恩菲尔全部吞噬，贝尔芬格艺术馆中的艺术品也被悉数毁灭。","style":3,"background":1049,"log_type":1,"src_id":160203117,"trial_step":117},{"step":118,"content":"但只要恩菲尔还存在，作品中的力量就还存在，这尊雕像连接着恩菲尔的迷茫与心结，如果与恩菲尔暴走的力量共鸣，很可能引发下一个魔女之夜！","style":3,"background":1049,"log_type":1,"src_id":160203118,"trial_step":118},{"step":119,"content":"恩菲尔！回应我！不要被它带走！","style":2,"background":1049,"log_type":1,"src_id":160203119,"trial_step":119},{"step":120,"speaker":"“虚妄之人”","content":"外人……那些人……又在说什么了！","voice":["vo_trial_60203_1_54"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203120,"trial_step":120},{"step":121,"speaker":"“虚妄之人”","content":"别理……去创作你的完美……去解决你的软弱！","voice":["vo_trial_60203_1_55"],"voice_bank":"vo_enfer_trial","style":1,"background":1049,"log_type":1,"src_id":160203121,"trial_step":121},{"step":122,"content":"你刚觉醒为狂厄级禁闭者，或许还无法完全控制这样的力量……","style":2,"background":1049,"log_type":1,"src_id":160203122,"trial_step":122},{"step":123,"content":"但我可以帮助你！快回应我！！","style":2,"background":1049,"log_type":1,"src_id":160203123,"trial_step":123},{"step":124,"content":"恩菲尔没有回答，她已快被吞噬完毕，成为一尊站立的白色雕塑。","style":3,"background":1049,"log_type":1,"src_id":160203124,"trial_step":124},{"step":125,"content":"来不及了！","style":2,"background":1049,"log_type":1,"src_id":160203125,"trial_step":125},{"step":126,"speaker":"刺耳的声音","content":"铮！","style":1,"background":1049,"log_type":1,"src_id":160203127,"trial_step":127},{"step":127,"content":"看到你想要唤醒恩菲尔，那些在地上蠕动的融化液体再次变成尖刺，朝你攻击过来。","style":3,"background":1049,"log_type":1,"src_id":160203128,"trial_step":128},{"step":128,"options":["恩菲尔！快听到我的声音！！"],"style":6,"background":1049,"log_type":1,"src_id":160203129,"trial_step":129,"course":3,"choices":[{"text":"恩菲尔！快听到我的声音！！","goto":130}]},{"step":129,"content":"尖刺的攻击越来越快，你只能艰难地躲避着，同时不停地呼唤，希望恩菲尔能听到。","style":3,"background":1049,"log_type":1,"src_id":160203130,"trial_step":130},{"step":130,"content":"你一定能听到，对吗？","style":2,"background":1049,"log_type":1,"src_id":160203131,"trial_step":131},{"step":131,"content":"这些也不过是一道茧！不要陷进去！","style":2,"background":1049,"log_type":1,"src_id":160203132,"trial_step":132},{"step":132,"content":"即使只能挣扎！你也要跳出来！否则……你只会又一次失败！","style":2,"background":1049,"log_type":1,"src_id":160203133,"trial_step":133},{"step":133,"content":"尖刺砸在工作台上，灰尘碎屑应声而起，迷住了眼睛。","style":3,"background":1049,"log_type":1,"src_id":160203134,"trial_step":134},{"step":134,"content":"咳咳……恩菲尔，你的力量，不应该只有恐惧！","style":2,"background":10000,"log_type":1,"src_id":160203135,"trial_step":135},{"step":135,"speaker":"恩菲尔","content":"局长……","voice":["vo_trial_60203_1_56"],"voice_bank":"vo_enfer_trial","style":1,"background":10000,"log_type":1,"src_id":160203136,"trial_step":136},{"step":136,"content":"在一片朦胧之中……你听见了恩菲尔的声音。","style":3,"background":10000,"log_type":1,"src_id":160203137,"trial_step":137},{"step":137,"content":"可下一刻，黑暗铺天盖地涌来，你感受到了手上的枷锁跳动着，逐渐和那一头的人融合，你知道，恩菲尔发动了自己的异能。","style":3,"background":10000,"log_type":1,"src_id":160203138,"trial_step":138}]}