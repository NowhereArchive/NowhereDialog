{"id":404320703,"chapter_id":50088,"scene_id":58875,"steps":[{"step":1,"content":"目前还不能确定马洛是敌是友。谨慎起见不能让他拿到枪。","style":3,"background":2506,"log_type":1},{"step":2,"speaker":"马洛","content":"你想干什么！？快把枪给我，否则就——","voice":["vo_event_404320703_01"],"voice_bank":"vo_event_43207","style":1,"background":2506,"log_type":1},{"step":3,"content":"（砰砰枪声音效）","style":18,"background":2506,"log_type":1},{"step":4,"speaker":"马洛","content":"你**……","voice":["vo_event_404320703_03"],"voice_bank":"vo_event_43207","style":1,"background":2506,"log_type":1},{"step":5,"content":"马洛倒下之后，一阵密集的脚步声往这个房间冲来。","style":3,"background":2506,"log_type":1},{"step":6,"speaker":"守卫甲","content":"磨磨蹭蹭的干什么，还没放倒？","voice":["vo_event_404320703_05"],"voice_bank":"vo_event_43207","style":1,"background":2506,"log_type":1},{"step":7,"speaker":"守卫乙","content":"不能让他们活着出去，动手！！","voice":["vo_event_404320703_06"],"voice_bank":"vo_event_43207","style":1,"background":2506,"log_type":1},{"step":8,"content":"（枪声音效+红屏）","style":18,"background":2506,"log_type":1}]}