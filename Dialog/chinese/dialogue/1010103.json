{"id":1010103,"chapter_id":1010103,"scene_id":1,"steps":[{"step":1,"content":"距离审判还有\n10分钟","style":9,"background":10000,"log_type":1,"src_id":110103001,"trial_step":1},{"step":2,"content":"你和迪蒙走入审判的会场。","style":3,"background":1010,"log_type":1,"src_id":110103002,"trial_step":2},{"step":3,"content":"事务官、FAC官员、市议会首席审判官皆已就席。作为各机构高官，他们都不是生面孔。","style":3,"background":1010,"log_type":1,"src_id":110103003,"trial_step":3},{"step":4,"content":"那个戴帽子的男人也赫然在列，但似乎不是很受欢迎。","style":3,"background":1010,"log_type":1,"src_id":110103004,"trial_step":4},{"step":5,"speaker":"事务官","content":"第九机关连这件事也要插手？这不是你们的风格吧。","voice":["vo_trial_10103_1_1"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103005,"trial_step":5},{"step":6,"content":"男人没有回应事务官的牢骚，反而向你脱帽致意。","style":3,"background":1010,"log_type":1,"src_id":110103006,"trial_step":6},{"step":7,"speaker":"9th人员","content":"好久不见，局长阁下，准备得顺利嘛？","voice":["vo_trial_10103_1_2"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103007,"trial_step":7},{"step":8,"content":"15天前，你们进行了第一次接触。这个人声称他背后的第九机关能够帮助你们。","style":3,"background":1010,"log_type":1,"src_id":110103008,"trial_step":8},{"step":9,"content":"当时，他只说了会提供场外的证据和情报协助，方便你们打赢这场官司。","style":3,"background":1010,"log_type":1,"src_id":110103009,"trial_step":9},{"step":10,"content":"没想到，狄斯城最神秘的特务机构居然亲自下场，让他们的人出现在了陪审席。","style":3,"background":1010,"log_type":1,"src_id":110103010,"trial_step":10},{"step":11,"options":["和他打个招呼"],"style":6,"background":1010,"log_type":1,"src_id":110103011,"trial_step":11,"course":3,"choices":[{"text":"和他打个招呼","goto":12}]},{"step":12,"content":"你们本打算在开庭前进行简单的交流，可审判官席上传来木槌敲击声。","style":3,"background":1010,"log_type":1,"src_id":110103012,"trial_step":12},{"step":13,"speaker":"9th人员","content":"看来有些人等不及了。","voice":["vo_trial_10103_1_3"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103013,"trial_step":13},{"step":14,"content":"审判官是市法院的大人物，看上去六七十岁。他没有给你们闲聊的机会。","style":3,"background":1010,"log_type":1,"src_id":110103014,"trial_step":14},{"step":15,"speaker":"审判官","content":"迪蒙·谢尔德，涉嫌杀害亚伯·谢尔德、多尔·杨在内的十三名议会高级官员等案，由本庭予以审理。","voice":["vo_trial_10103_1_4"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103015,"trial_step":15},{"step":16,"speaker":"审判官","content":"审判开始。","voice":["vo_trial_10103_1_5"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103016,"trial_step":16},{"step":17,"content":"木槌的敲击声回荡在整个会场。","style":3,"background":1010,"log_type":1,"src_id":110103017,"trial_step":17},{"step":18,"speaker":"审判官","content":"事务官发言。","voice":["vo_trial_10103_1_6"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103018,"trial_step":18},{"step":19,"content":"事务官扶了扶眼镜。你认识他——一个月前，正是这位新城政法界的新星将卷宗和薇拉的手链交给了你。","style":3,"background":1010,"log_type":1,"src_id":110103019,"trial_step":19},{"step":20,"speaker":"事务官","content":"各位，鉴于这里并不是常规审判庭，而且大家对这桩案子也都不陌生，我就以最简洁的方式来描述案情了。","voice":["vo_trial_10103_1_7"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103020,"trial_step":20},{"step":21,"content":"事务官扬了扬他手中的文件。","style":3,"background":1010,"log_type":1,"src_id":110103021,"trial_step":21},{"step":22,"speaker":"事务官","content":"以前特遣队分队长芬恩的案件为例，指纹、凶器都能完美对应上，被害者家中的摄像头更是记录下了整个过程。","voice":["vo_trial_10103_1_8"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103022,"trial_step":22},{"step":23,"speaker":"事务官","content":"其他的案件，情况都十分类似。与其说他是“不慎”遗漏，倒不如说，更像是在散播恐惧、主动炫耀自己的行为。","voice":["vo_trial_10103_1_9"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103023,"trial_step":23},{"step":24,"speaker":"事务官","content":"迪蒙·谢尔德所涉的一系列事件，影响极其恶劣。仅仅是将他收容在MBCC的话，市议会，乃至整个新城的市民都无法接受。","voice":["vo_trial_10103_1_10"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103024,"trial_step":24},{"step":25,"content":"事务官顿了顿，环顾四周，接着看向你和迪蒙这一边，昂起了头。","style":3,"background":1010,"log_type":1,"src_id":110103025,"trial_step":25},{"step":26,"speaker":"事务官","content":"我谨代表市议会，要求MBCC交出禁闭者迪蒙·谢尔德。","voice":["vo_trial_10103_1_11"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103026,"trial_step":26},{"step":27,"content":"事务官将这个冰冷的“结论”说完后，会场归于平静。所有人都在看着你们，空气中氤氲着恶意。","style":3,"background":1010,"log_type":1,"src_id":110103027,"trial_step":27},{"step":28,"speaker":"迪蒙","content":"……","voice":["vo_trial_10103_1_12"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103028,"trial_step":28},{"step":29,"content":"迪蒙紧锁着眉，几次想要说些什么，却又没能开口。","style":3,"background":1010,"log_type":1,"src_id":110103029,"trial_step":29},{"step":30,"content":"还没等他开口，审判官就看穿了他的意图。","style":3,"background":1010,"log_type":1,"src_id":110103030,"trial_step":30},{"step":31,"speaker":"审判官","content":"嫌疑人，还没有轮到你发言。","voice":["vo_trial_10103_1_13"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103031,"trial_step":31},{"step":32,"content":"即使事务官并没有在发言，即使陪审的诸位都在期待着迪蒙说些什么，可审判官还是没有给迪蒙申辩的机会。","style":3,"background":1010,"log_type":1,"src_id":110103032,"trial_step":32},{"step":33,"content":"八年前，迪蒙曾经面对的“审判”，或许就是这样的。","style":3,"background":1010,"log_type":1,"src_id":110103033,"trial_step":33},{"step":34,"options":["帮迪蒙争取发言机会"],"style":6,"background":1010,"log_type":1,"src_id":110103034,"trial_step":34,"course":3,"choices":[{"text":"帮迪蒙争取发言机会","goto":35}]},{"step":35,"content":"八年前也是这样吗？嫌疑人连发言的机会都没有？这样可算不上审判。","style":2,"background":1010,"log_type":1,"src_id":110103035,"trial_step":35},{"step":36,"content":"想让管理局交人，至少让我们听听他的说法。","style":2,"background":1010,"log_type":1,"src_id":110103036,"trial_step":36},{"step":37,"content":"审判官皱了皱眉，似乎是没有预料到你的“反水”。过了一会儿，他才开口——","style":3,"background":1010,"log_type":1,"src_id":110103037,"trial_step":37},{"step":38,"speaker":"审判官","content":"嫌疑人迪蒙，你是出于何种目的，杀害那十三名受害者的？","voice":["vo_trial_10103_1_14"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103038,"trial_step":38},{"step":39,"content":"在你的逼迫之下，市议会让步了。审判官主动向迪蒙“提问”。","style":3,"background":1010,"log_type":1,"src_id":110103039,"trial_step":39},{"step":40,"content":"迪蒙眼神有些焦躁。看得出来，过去的经历对他影响颇深。","style":3,"background":1010,"log_type":1,"src_id":110103040,"trial_step":40},{"step":41,"options":["鼓励他"],"style":6,"background":1010,"log_type":1,"src_id":110103041,"trial_step":41,"course":3,"choices":[{"text":"鼓励他","goto":42}]},{"step":42,"content":"你将手放到了他的肩膀上。","style":3,"background":1010,"log_type":1,"src_id":110103042,"trial_step":42},{"step":43,"content":"别担心，我会帮你。","style":2,"background":1010,"log_type":1,"src_id":110103043,"trial_step":43},{"step":44,"content":"迪蒙深吸一口气，目光移向事务官。","style":3,"background":1010,"log_type":1,"src_id":110103044,"trial_step":44},{"step":45,"speaker":"迪蒙","content":"十二个……","voice":["vo_trial_10103_1_15"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103045,"trial_step":45},{"step":46,"content":"迪蒙的声音非常低沉。","style":3,"background":1010,"log_type":1,"src_id":110103046,"trial_step":46},{"step":47,"speaker":"事务官","content":"你说什么？","voice":["vo_trial_10103_1_16"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103047,"trial_step":47},{"step":48,"speaker":"迪蒙","content":"八年前，是这十二个人谋害了亚伯……","voice":["vo_trial_10103_1_17"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103048,"trial_step":48},{"step":49,"speaker":"迪蒙","content":"我杀他们，是为了复仇。","voice":["vo_trial_10103_1_18"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103049,"trial_step":49},{"step":50,"speaker":"事务官","content":"哦？","voice":["vo_trial_10103_1_19"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103050,"trial_step":50},{"step":51,"content":"事务官略显浮夸地抹了抹眼角，接着说道——","style":3,"background":1010,"log_type":1,"src_id":110103051,"trial_step":51},{"step":52,"speaker":"事务官","content":"你是想说，八年前在蔷薇礼堂，开枪杀死亚伯·谢尔德的人不是你？而是日后你杀害的十二名死者？","voice":["vo_trial_10103_1_20"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103052,"trial_step":52},{"step":53,"speaker":"迪蒙","content":"不……朝亚伯开枪的人，是我。","voice":["vo_trial_10103_1_21"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103053,"trial_step":53},{"step":54,"speaker":"事务官","content":"那么，是这十二个人授意你杀死亚伯的吗？","voice":["vo_trial_10103_1_22"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103054,"trial_step":54},{"step":55,"speaker":"迪蒙","content":"……","voice":["vo_trial_10103_1_23"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103055,"trial_step":55},{"step":56,"content":"事务官数次打断迪蒙，并偷换概念干扰迪蒙的发言。","style":3,"background":1010,"log_type":1,"src_id":110103056,"trial_step":56},{"step":57,"options":["提出抗议"],"style":6,"background":1010,"log_type":1,"src_id":110103057,"trial_step":57,"course":3,"choices":[{"text":"提出抗议","goto":58}]},{"step":58,"speaker":"审判官","content":"抗议无效，事务官只是在履行自己的职责。","voice":["vo_trial_10103_1_24"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103058,"trial_step":58},{"step":59,"content":"迪蒙死死盯着审判官，但却没能让审判官产生动摇。","style":3,"background":1010,"log_type":1,"src_id":110103059,"trial_step":59},{"step":60,"speaker":"审判官","content":"${PlayerName}，约束住你的禁闭者。","voice":["vo_trial_10103_1_25"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103060,"trial_step":60},{"step":61,"content":"不加掩饰的恶意令人作呕。这场审判自始至终就没有公正可言。","style":3,"background":1010,"log_type":1,"src_id":110103061,"trial_step":61},{"step":62,"content":"好在你们做了充分的准备。只要能进入自己的节奏，未尝不能破局。","style":3,"background":1010,"log_type":1,"src_id":110103062,"trial_step":62},{"step":63,"content":"不要被他的问题干扰，只说必要的信息。","style":2,"background":1010,"log_type":1,"src_id":110103063,"trial_step":63},{"step":64,"content":"迪蒙看了看你，随即再度开口。","style":3,"background":1010,"log_type":1,"src_id":110103064,"trial_step":64},{"step":65,"speaker":"迪蒙","content":"我击毙亚伯……是因为他当时已经变异为死役，开始袭击在场的无辜民众，我别无选择。","voice":["vo_trial_10103_1_26"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103065,"trial_step":65},{"step":66,"speaker":"事务官","content":"也就是说，你承认自己于104年7月6日击毙了议员亚伯·谢尔德，你的养父，对吧？","voice":["vo_trial_10103_1_27"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103066,"trial_step":66},{"step":67,"speaker":"迪蒙","content":"演讲途中，携带狂厄武器的暴徒闯入礼堂，进行了无差别射击。","voice":["vo_trial_10103_1_28"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103067,"trial_step":67},{"step":68,"speaker":"迪蒙","content":"亚伯被击中……虽然没有当场死亡，但很快变异，失去神志……","voice":["vo_trial_10103_1_29"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103068,"trial_step":68},{"step":69,"speaker":"事务官","content":"抱歉，各位。","voice":["vo_trial_10103_1_30"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103069,"trial_step":69},{"step":70,"content":"事务官再一次打断了迪蒙的发言。","style":3,"background":1010,"log_type":1,"src_id":110103070,"trial_step":70},{"step":71,"speaker":"事务官","content":"我想，既然提到了亚伯·谢尔德的案子，那么我有必要带各位回顾一下案情。","voice":["vo_trial_10103_1_32"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103071,"trial_step":71},{"step":72,"speaker":"事务官","content":"如此重要的事情，迪蒙的发言，难免会有缺漏，以致误导各位的判断……还是我来吧。","voice":["vo_trial_10103_1_33"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103072,"trial_step":72},{"step":73,"content":"事务官环顾四周，无人反对。他清了清嗓子，开始了讲述。","style":3,"background":1010,"log_type":1,"src_id":110103073,"trial_step":73},{"step":74,"speaker":"事务官","content":"入夜104年7月6日，受害人亚伯在新城的蔷薇礼堂发表竞选演讲，四名歹徒闯入礼堂，造成大量人员伤亡，后被安保人员击毙。","voice":["vo_trial_10103_1_34"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103074,"trial_step":74},{"step":75,"speaker":"事务官","content":"迪蒙趁着护送受害人离场的机会，使用一把9毫米口径的手枪，朝受害人的头部连开六枪，受害人当场死亡。","voice":["vo_trial_10103_1_35"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103075,"trial_step":75},{"step":76,"speaker":"事务官","content":"凶器被遗落在现场。幸存目击者的口供、指纹、DNA和弹道试验得出的结果一致——凶手就是你，迪蒙·谢尔德。","voice":["vo_trial_10103_1_36"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103076,"trial_step":76},{"step":77,"content":"事务官带着恼人的笑容，结束了这番冗长的演说。","style":3,"background":1010,"log_type":1,"src_id":110103077,"trial_step":77},{"step":78,"speaker":"迪蒙","content":"我说过，亚伯变异成了死役，试图袭击民众……","voice":["vo_trial_10103_1_37"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103078,"trial_step":78},{"step":79,"speaker":"事务官","content":"的确，根据现场报告，亚伯·谢尔德的尸体呈现出高度变异。四名袭击者所持的也确实是狂厄武器……","voice":["vo_trial_10103_1_38"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103079,"trial_step":79},{"step":80,"speaker":"事务官","content":"不过，八年前，狂厄武器可以说极为罕见。整个新城，除了负责处理异常状况的特遣队，其他机构是不可能保有这种危险的武器的。","voice":["vo_trial_10103_1_39"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103080,"trial_step":80},{"step":81,"speaker":"事务官","content":"凑巧的是，嫌疑人迪蒙，正是特遣队的时任队长……当时除了特遣队的高级人员，其他人是没有机会接触到狂厄武器的吧？","voice":["vo_trial_10103_1_40"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103081,"trial_step":81},{"step":82,"content":"事务官看向一边的FAC官员。","style":3,"background":1010,"log_type":1,"src_id":110103082,"trial_step":82},{"step":83,"content":"FAC官员皱着眉沉默了一会儿。","style":3,"background":1010,"log_type":1,"src_id":110103083,"trial_step":83},{"step":84,"speaker":"FAC官员","content":"早期狂厄武器的确都是由特遣队缴获的。","voice":["vo_trial_10103_1_41"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103084,"trial_step":84},{"step":85,"speaker":"FAC官员","content":"当年的事件发生后，FAC内部进行过自查。最后核对的结果是：库中封存的狂厄武器少了四件。","voice":["vo_trial_10103_1_42"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103085,"trial_step":85},{"step":86,"speaker":"事务官","content":"我想，真相已经很清楚了。嫌疑人迪蒙·谢尔德监守自盗，将狂厄武器交给暴徒。","voice":["vo_trial_10103_1_43"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103086,"trial_step":86},{"step":87,"speaker":"事务官","content":"并且他抽调走了负责守卫的特遣队队员，让暴徒毫无阻碍地进入了会场……","voice":["vo_trial_10103_1_44"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103087,"trial_step":87},{"step":88,"speaker":"迪蒙","content":"证据呢？","voice":["vo_trial_10103_1_45"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103088,"trial_step":88},{"step":89,"content":"迪蒙打断了喋喋不休的事务官。","style":3,"background":1010,"log_type":1,"src_id":110103089,"trial_step":89},{"step":90,"speaker":"事务官","content":"所有案件细节都来自特遣队内部的口供。","voice":["vo_trial_10103_1_46"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103090,"trial_step":90},{"step":91,"speaker":"迪蒙","content":"口供？","voice":["vo_trial_10103_1_47"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103091,"trial_step":91},{"step":92,"speaker":"事务官","content":"在没有其他决定性物证时，口供足以定罪。","voice":["vo_trial_10103_1_48"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103092,"trial_step":92},{"step":93,"speaker":"迪蒙","content":"我有“决定性物证”。","voice":["vo_trial_10103_1_49"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103093,"trial_step":93},{"step":94,"speaker":"事务官","content":"？","voice":["vo_trial_10103_1_50"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103094,"trial_step":94},{"step":95,"speaker":"迪蒙","content":"芬恩模仿我签名伪造的调用文件，就在西区岬岸公寓1102房间。","voice":["vo_trial_10103_1_51"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103095,"trial_step":95},{"step":96,"speaker":"事务官","content":"……","voice":["vo_trial_10103_1_52"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103096,"trial_step":96},{"step":97,"speaker":"事务官","content":"你这样随口胡诌一个人名和地址是没有意义的。","voice":["vo_trial_10103_1_53"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103097,"trial_step":97},{"step":98,"speaker":"迪蒙","content":"呵……新城的事务官都跟你是一路货色么？","voice":["vo_trial_10103_1_54"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103098,"trial_step":98},{"step":99,"speaker":"迪蒙","content":"这是你刚刚提到的人，前任特遣队副队长。","voice":["vo_trial_10103_1_55"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103099,"trial_step":99},{"step":100,"speaker":"事务官","content":"……难道我们还得在这儿待上几个小时，等人把它取回来吗？","voice":["vo_trial_10103_1_56"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103100,"trial_step":100},{"step":101,"speaker":"迪蒙","content":"用不了那么久。","voice":["vo_trial_10103_1_57"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103101,"trial_step":101},{"step":102,"speaker":"迪蒙","content":"……你在害怕？","voice":["vo_trial_10103_1_58"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103102,"trial_step":102},{"step":103,"content":"事务官额头上沁出了汗珠。","style":3,"background":1010,"log_type":1,"src_id":110103103,"trial_step":103},{"step":104,"content":"然而，审判席的木槌声打断了这次交锋。","style":3,"background":1010,"log_type":1,"src_id":110103104,"trial_step":104},{"step":105,"speaker":"审判官","content":"嫌疑人所描述物证，未向本庭报备。","voice":["vo_trial_10103_1_59"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103105,"trial_step":105},{"step":106,"speaker":"审判官","content":"按例不予采用。","voice":["vo_trial_10103_1_60"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103106,"trial_step":106},{"step":107,"content":"审判庭内的温度瞬间降至冰点。","style":3,"background":1010,"log_type":1,"src_id":110103107,"trial_step":107},{"step":108,"speaker":"迪蒙","content":"……你们又何曾给过我“提交证物”的机会呢？","voice":["vo_trial_10103_1_61"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103108,"trial_step":108},{"step":109,"speaker":"审判官","content":"审判庭的条例规则二十年从来没改变过，你该在开庭前读一读的，迪蒙。","voice":["vo_trial_10103_1_62"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103109,"trial_step":109},{"step":110,"speaker":"迪蒙","content":"我记得你……八年前，是你宣判了我的死刑……","voice":["vo_trial_10103_1_63"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103110,"trial_step":110},{"step":111,"speaker":"审判官","content":"没错。","voice":["vo_trial_10103_1_64"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103111,"trial_step":111},{"step":112,"speaker":"迪蒙","content":"我该早点去“拜访”你的。","voice":["vo_trial_10103_1_65"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103112,"trial_step":112},{"step":113,"speaker":"审判官","content":"你没有机会了。","voice":["vo_trial_10103_1_66"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103113,"trial_step":113},{"step":114,"content":"审判长干脆地否决了你们提交证物的请求，充满火药味的对峙到此结束了。","style":3,"background":1010,"log_type":1,"src_id":110103114,"trial_step":114},{"step":115,"content":"迪蒙不再辩驳，只是冷冷地盯着审判长——他不再寄希望于这场庭审能给予他公正的审判了。","style":3,"background":1010,"log_type":1,"src_id":110103115,"trial_step":115},{"step":116,"content":"迪蒙的尝试似乎是失败了，但你还没有。","style":3,"background":1010,"log_type":1,"src_id":110103116,"trial_step":116},{"step":117,"options":["帮迪蒙辩护"],"style":6,"background":1010,"log_type":1,"src_id":110103117,"trial_step":117,"course":3,"choices":[{"text":"帮迪蒙辩护","goto":118}]},{"step":118,"content":"亚伯是迪蒙的养父，外界传闻两人感情一直不错。迪蒙没有杀害他的动机……","style":2,"background":1010,"log_type":1,"src_id":110103118,"trial_step":118},{"step":119,"speaker":"事务官","content":"关于这一点，我们同样有相应的证据。","voice":["vo_trial_10103_1_67"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103119,"trial_step":119},{"step":120,"content":"事务官再度开口。","style":3,"background":1010,"log_type":1,"src_id":110103120,"trial_step":120},{"step":121,"speaker":"事务官","content":"我们向新城银行调取了迪蒙·谢尔德的动账记录。","voice":["vo_trial_10103_1_68"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103121,"trial_step":121},{"step":122,"speaker":"事务官","content":"104年6月29日，迪蒙的私人账户收到了一笔来自匿名账户的巨额打款。","voice":["vo_trial_10103_1_69"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103122,"trial_step":122},{"step":123,"content":"事务官看了看审判官。","style":3,"background":1010,"log_type":1,"src_id":110103123,"trial_step":123},{"step":124,"speaker":"审判官","content":"嫌疑人迪蒙，解释这笔打款的来历。","voice":["vo_trial_10103_1_70"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103124,"trial_step":124},{"step":125,"content":"迪蒙没有回答的意向，只是沉默着。","style":3,"background":1010,"log_type":1,"src_id":110103125,"trial_step":125},{"step":126,"content":"但这个问题你无法替迪蒙回答，你对此一无所知。","style":3,"background":1010,"log_type":1,"src_id":110103126,"trial_step":126},{"step":127,"options":["让迪蒙不要放弃"],"style":6,"background":1010,"log_type":1,"src_id":110103127,"trial_step":127,"course":3,"choices":[{"text":"让迪蒙不要放弃","goto":128}]},{"step":128,"content":"不要放弃。","style":2,"background":1010,"log_type":1,"src_id":110103128,"trial_step":128},{"step":129,"content":"即便他们不接受新的证据，他们既有的证据链也一定存在破绽……我们还有机会。","style":2,"background":1010,"log_type":1,"src_id":110103129,"trial_step":129},{"step":130,"content":"在你的劝说下，迪蒙的态度似乎有所松动。","style":3,"background":1010,"log_type":1,"src_id":110103130,"trial_step":130},{"step":131,"speaker":"审判官","content":"嫌疑人，回答问题。","voice":["vo_trial_10103_1_71"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103131,"trial_step":131},{"step":132,"content":"审判官再次催促。迪蒙脸上露出烦躁又嫌恶的神色。","style":3,"background":1010,"log_type":1,"src_id":110103132,"trial_step":132},{"step":133,"speaker":"迪蒙","content":"……我不知道。","voice":["vo_trial_10103_1_72"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103133,"trial_step":133},{"step":134,"speaker":"事务官","content":"不知道？这么说，你无法解释这笔巨款的来历？","voice":["vo_trial_10103_1_73"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103134,"trial_step":134},{"step":135,"speaker":"迪蒙","content":"我的私人账户只有一个，一直由我的义妹……薇拉在管理。","voice":["vo_trial_10103_1_74"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103135,"trial_step":135},{"step":136,"speaker":"事务官","content":"你在指控薇拉，指使你杀害了她的亲生父亲？","voice":["vo_trial_10103_1_75"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103136,"trial_step":136},{"step":137,"speaker":"迪蒙","content":"闭嘴！","voice":["vo_trial_10103_1_76"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103137,"trial_step":137},{"step":138,"content":"迪蒙的情绪立刻被愤怒裹挟——薇拉是他最后的家人，他不可能容许有人如此构陷自己的妹妹。","style":3,"background":1010,"log_type":1,"src_id":110103138,"trial_step":138},{"step":139,"speaker":"事务官","content":"幸好薇拉小姐在我们的秘密保护之下，不然，我真怀疑你连她都不会放过。","voice":["vo_trial_10103_1_77"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103139,"trial_step":139},{"step":140,"content":"事情发展这种地步，市议会终于图穷匕见。","style":3,"background":1010,"log_type":1,"src_id":110103140,"trial_step":140},{"step":141,"speaker":"迪蒙","content":"果然……薇拉在你们那儿……","voice":["vo_trial_10103_1_78"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103141,"trial_step":141},{"step":142,"speaker":"事务官","content":"薇拉小姐从105年1月开始就向我们申请了庇护——她一直在躲避你。","voice":["vo_trial_10103_1_79"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103142,"trial_step":142},{"step":143,"speaker":"迪蒙","content":"她在哪儿？！","voice":["vo_trial_10103_1_80"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103143,"trial_step":143},{"step":144,"speaker":"事务官","content":"很遗憾，为了保护薇拉小姐的人身安全，她不会出席作证。","voice":["vo_trial_10103_1_81"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103144,"trial_step":144},{"step":145,"content":"事务官取出一个薄薄的塑封袋。","style":3,"background":1010,"log_type":1,"src_id":110103145,"trial_step":145},{"step":146,"speaker":"事务官","content":"但我们在审判开始前获取了她的证词，足以证明你这八年间的一切罪行。","voice":["vo_trial_10103_1_82"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103146,"trial_step":146},{"step":147,"speaker":"迪蒙","content":"不可能！","voice":["vo_trial_10103_1_83"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103147,"trial_step":147},{"step":148,"content":"迪蒙嘶吼着。","style":3,"background":1010,"log_type":1,"src_id":110103148,"trial_step":148},{"step":149,"speaker":"迪蒙","content":"薇拉是我的家人，她不可能会……","voice":["vo_trial_10103_1_84"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103149,"trial_step":149},{"step":150,"speaker":"审判官","content":"注意你的发言，迪蒙·谢尔德。","voice":["vo_trial_10103_1_85"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103150,"trial_step":150},{"step":151,"content":"审判官的声音像一盆凉水，浇灭了迪蒙升腾的怒火。","style":3,"background":1010,"log_type":1,"src_id":110103151,"trial_step":151},{"step":152,"content":"薇拉在他们手上，迪蒙根本无法反抗。","style":3,"background":1010,"log_type":1,"src_id":110103152,"trial_step":152},{"step":153,"content":"你意识到，以薇拉为要挟，逼迫迪蒙认罪——这才是市议会谋划的真正杀招。","style":3,"background":1010,"log_type":1,"src_id":110103153,"trial_step":153},{"step":154,"speaker":"审判官","content":"证词上指证，你策划并谋杀了议员亚伯·谢尔德。迪蒙，你是否认罪？","voice":["vo_trial_10103_1_86"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103154,"trial_step":154},{"step":155,"speaker":"迪蒙","content":"我……","voice":["vo_trial_10103_1_87"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103155,"trial_step":155},{"step":156,"content":"迪蒙双目血红，紧紧咬合的牙齿发出瘆人的声响。","style":3,"background":1010,"log_type":1,"src_id":110103156,"trial_step":156},{"step":157,"speaker":"迪蒙","content":"……认罪。","voice":["vo_trial_10103_1_88"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103157,"trial_step":157},{"step":158,"content":"仅仅三个字，其中的愤恨与不甘几乎要将人吞没。","style":3,"background":1010,"log_type":1,"src_id":110103158,"trial_step":158},{"step":159,"speaker":"审判官","content":"你虐待并杀死了十二名议会官员，是否认罪？","voice":["vo_trial_10103_1_89"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103159,"trial_step":159},{"step":160,"speaker":"迪蒙","content":"我……认罪。","voice":["vo_trial_10103_1_90"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103160,"trial_step":160},{"step":161,"speaker":"审判官","content":"你胁迫被害人薇拉·谢尔德承认杀害亚伯的罪名，并在八年间不断追杀她，是否认罪？","voice":["vo_trial_10103_1_91"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103161,"trial_step":161},{"step":162,"speaker":"迪蒙","content":"……","voice":["vo_trial_10103_1_92"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103162,"trial_step":162},{"step":163,"content":"这场审判正在倒向最坏的结果。这样下去，迪蒙必死无疑。","style":3,"background":1010,"log_type":1,"src_id":110103163,"trial_step":163},{"step":164,"content":"你说过要帮他，你承诺过……可眼下这种情况……","style":3,"background":1010,"log_type":1,"src_id":110103164,"trial_step":164},{"step":165,"speaker":"迪蒙","content":"我……","voice":["vo_trial_10103_1_93"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103165,"trial_step":165},{"step":166,"speaker":"9th人员","content":"抱歉，我打断一下。","voice":["vo_trial_10103_1_94"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103166,"trial_step":166},{"step":167,"content":"第九机关的那个男人突然发话了。","style":3,"background":1010,"log_type":1,"src_id":110103167,"trial_step":167},{"step":168,"content":"审判官的脸色有些难看，他没有料到有人会在最关键的时候打断对话。","style":3,"background":1010,"log_type":1,"src_id":110103168,"trial_step":168},{"step":169,"speaker":"9th人员","content":"我想请问一下……事务官先生，那份证词……记录的时间是？","voice":["vo_trial_10103_1_95"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103169,"trial_step":169},{"step":170,"content":"事务官有些错愕地看向审判官。","style":3,"background":1010,"log_type":1,"src_id":110103170,"trial_step":170},{"step":171,"speaker":"审判官","content":"两天前。","voice":["vo_trial_10103_1_97"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103171,"trial_step":171},{"step":172,"content":"面对恶名远扬的第九机关特务人员，审判官并没有隐瞒。","style":3,"background":1010,"log_type":1,"src_id":110103172,"trial_step":172},{"step":173,"speaker":"9th人员","content":"证词的问询和誊抄是由谁完成的？","voice":["vo_trial_10103_1_98"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103173,"trial_step":173},{"step":174,"speaker":"审判官","content":"兹事体大，所有流程由我亲自参与完成。","voice":["vo_trial_10103_1_99"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103174,"trial_step":174},{"step":175,"content":"面对现在的情况，老练的审判官也有些沉不住气了。他只想赶紧回答完特务的问题，完成这场审判。","style":3,"background":1010,"log_type":1,"src_id":110103175,"trial_step":175},{"step":176,"speaker":"9th人员","content":"哦？那就奇怪了……","voice":["vo_trial_10103_1_100"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103176,"trial_step":176},{"step":177,"content":"男人的声音听起来有些揶揄。","style":3,"background":1010,"log_type":1,"src_id":110103177,"trial_step":177},{"step":178,"speaker":"9th人员","content":"五个小时前，我的人突袭了一处秘密帕尔马据点。您应该知道我说的“帕尔马”是什么意思。","voice":["vo_trial_10103_1_101"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103178,"trial_step":178},{"step":179,"speaker":"9th人员","content":"我们在那里发现了不少遗体。就在刚刚，我们完成了生物遗传物质比对，确认了其中一具遗体的身份——","voice":["vo_trial_10103_1_102"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103179,"trial_step":179},{"step":180,"speaker":"9th人员","content":"议员亚伯·谢尔德的女儿，薇拉·谢尔德。","voice":["vo_trial_10103_1_103"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103180,"trial_step":180},{"step":181,"content":"听到这里，迪蒙身体僵直，双眼失神。","style":3,"background":1010,"log_type":1,"src_id":110103181,"trial_step":181},{"step":182,"content":"他的牙齿在打颤，却说不出一句话。","style":3,"background":1010,"log_type":1,"src_id":110103182,"trial_step":182},{"step":183,"speaker":"审判官","content":"这……这不可能……","voice":["vo_trial_10103_1_104"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103183,"trial_step":183},{"step":184,"speaker":"9th人员","content":"我建议您别试图在死亡日期上狡辩，薇拉小姐至少已经死去六年了。","voice":["vo_trial_10103_1_105"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103184,"trial_step":184},{"step":185,"speaker":"审判官","content":"不是，不……那不……","voice":["vo_trial_10103_1_106"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103185,"trial_step":185},{"step":186,"speaker":"9th人员","content":"您是想说您对薇拉小姐的死并不知情？帕尔马瞒报了她的信息？您和帕尔马的联系人是谁？需要待会儿去指认一下么？","voice":["vo_trial_10103_1_107"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103186,"trial_step":186},{"step":187,"content":"审判官的脸色铁青，终于不再说话——他知道，自己说什么都没用了。","style":3,"background":1010,"log_type":1,"src_id":110103187,"trial_step":187},{"step":188,"content":"短短几句话，这场审判的局面发生了翻天覆地的变化。造成这一切的，正是那个来自第九机关的男人。","style":3,"background":1010,"log_type":1,"src_id":110103188,"trial_step":188},{"step":189,"content":"他的脸上还带着淡淡的微笑。","style":3,"background":1010,"log_type":1,"src_id":110103189,"trial_step":189},{"step":190,"speaker":"9th人员","content":"上峰命令，暂停审理新城议员遇害案。迪蒙·谢尔德交还MBCC收容控制。","voice":["vo_trial_10103_1_108"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103190,"trial_step":190},{"step":191,"speaker":"9th人员","content":"现在首要的目标是，调查市议会舞弊问题，清除城邦威胁……布莱克阁下，麻烦跟我走一趟吧。","voice":["vo_trial_10103_1_109"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103191,"trial_step":191},{"step":192,"content":"作为赢家，他慢慢走到审判官面前，做了一个“请”的姿势。","style":3,"background":1010,"log_type":1,"src_id":110103192,"trial_step":192},{"step":193,"content":"直到现在你才意识到，之前的谈话和协助脱罪的提议不过是障眼法，第九机关利用了你和迪蒙。","style":3,"background":1010,"log_type":1,"src_id":110103193,"trial_step":193},{"step":194,"content":"整场审判，不过是第九机关向市议会发难的幌子。","style":3,"background":1010,"log_type":1,"src_id":110103194,"trial_step":194},{"step":195,"speaker":"迪蒙","content":"为什么……","voice":["vo_trial_10103_1_110"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103195,"trial_step":195},{"step":196,"content":"迪蒙的声音异常嘶哑。他本是审判的主角，此刻，审判庭内有些嘈杂。除了你，没有人听他说话。","style":3,"background":1010,"log_type":1,"src_id":110103196,"trial_step":196},{"step":197,"content":"他跪坐在地上，一动不动，声音却在不住颤抖。","style":3,"background":1010,"log_type":1,"src_id":110103197,"trial_step":197},{"step":198,"speaker":"9th人员","content":"我为您的遭遇感到抱歉，迪蒙先生。","voice":["vo_trial_10103_1_111"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103198,"trial_step":198},{"step":199,"speaker":"9th人员","content":"但针对您的审判到此结束了，我们现在有更重要的事……","voice":["vo_trial_10103_1_112"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103199,"trial_step":199},{"step":200,"speaker":"迪蒙","content":"薇拉做了什么……你们连她都不放过……","voice":["vo_trial_10103_1_113"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103200,"trial_step":200},{"step":201,"content":"审判官看了过来，他的脸色很差，却还是梗着脖子开口。","style":3,"background":1010,"log_type":1,"src_id":110103201,"trial_step":201},{"step":202,"speaker":"审判官","content":"这与我无关……","voice":["vo_trial_10103_1_114"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103202,"trial_step":202},{"step":203,"speaker":"迪蒙","content":"你说……是你誊抄的证词……","voice":["vo_trial_10103_1_115"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103203,"trial_step":203},{"step":204,"speaker":"审判官","content":"你还真信了？","voice":["vo_trial_10103_1_116"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103204,"trial_step":204},{"step":205,"speaker":"审判官","content":"把她交给帕尔马不是我一个人的判断，自那之后我们就再没有她的消息。","voice":["vo_trial_10103_1_117"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103205,"trial_step":205},{"step":206,"content":"但是你还敢用她的名义伪造证词？","style":2,"background":1010,"log_type":1,"src_id":110103206,"trial_step":206},{"step":207,"content":"审判官脸色铁青。","style":3,"background":1010,"log_type":1,"src_id":110103207,"trial_step":207},{"step":208,"speaker":"审判官","content":"没人想过会这样……但我们都没料到帕尔马有这个胆子。","voice":["vo_trial_10103_1_118"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103208,"trial_step":208},{"step":209,"speaker":"迪蒙","content":"……不重要了。","voice":["vo_trial_10103_1_119"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103209,"trial_step":209},{"step":210,"content":"一切都发生得太快，你看到了，却来不及阻止。","style":3,"background":10000,"log_type":1,"src_id":110103210,"trial_step":210},{"step":211,"content":"迪蒙挣碎了沉重的枷锁，冲到了那个人面前。下一刻，暴行发生在所有人眼前。","style":3,"background":10000,"log_type":1,"src_id":110103211,"trial_step":211},{"step":212,"content":"过去整整五秒，所有人才反应过来。此时，迪蒙仿佛断了线的木偶，跪坐在地上。他的瞳孔失去了焦距，仿佛灵魂已经离开了这具躯壳。","style":3,"background":1010,"log_type":1,"src_id":110103212,"trial_step":212},{"step":213,"content":"时隔八年，迪蒙再一次背上了无法洗刷的罪名。","style":3,"background":1010,"log_type":1,"src_id":110103213,"trial_step":213},{"step":214,"speaker":"9th人员","content":"呃……","voice":["vo_trial_10103_1_120"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103214,"trial_step":214},{"step":215,"content":"抱歉，我没能阻止他。","style":2,"background":1010,"log_type":1,"src_id":110103215,"trial_step":215},{"step":216,"content":"你们的调查……？","style":2,"background":1010,"log_type":1,"src_id":110103216,"trial_step":216},{"step":217,"speaker":"9th人员","content":"倒是没什么关系，我们已经获得了充足的理由。总之，还是感谢您的配合。","voice":["vo_trial_10103_1_121"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103217,"trial_step":217},{"step":218,"content":"他瞥了一眼吓得瘫倒在地的事务官，又看了一眼迪蒙。","style":3,"background":1010,"log_type":1,"src_id":110103218,"trial_step":218},{"step":219,"speaker":"9th人员","content":"迪蒙是一个相当不稳定的棋子，请您小心应对。","voice":["vo_trial_10103_1_122"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103219,"trial_step":219},{"step":220,"speaker":"9th人员","content":"这种罪行，不好搪塞，您必须给出合适的处理，不然没法堵住其他人的嘴。","voice":["vo_trial_10103_1_123"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103220,"trial_step":220},{"step":221,"content":"我会处理的。","style":2,"background":1010,"log_type":1,"src_id":110103221,"trial_step":221},{"step":222,"speaker":"9th人员","content":"我相信您的判断。哦对了，还有……","voice":["vo_trial_10103_1_124"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103222,"trial_step":222},{"step":223,"speaker":"9th人员","content":"兰利小姐让我代替她向您问好。","voice":["vo_trial_10103_1_125"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103223,"trial_step":223},{"step":224,"content":"那个男人最后一次脱下帽子向你致意，快步离开了这里。接着，FAC的官员深深看了迪蒙一眼，一言不发地走了出去。","style":3,"background":1010,"log_type":1,"src_id":110103224,"trial_step":224},{"step":225,"content":"大厅里，只剩下迪蒙，你，和一地污秽与狼藉。","style":3,"background":1010,"log_type":1,"src_id":110103225,"trial_step":225}]}