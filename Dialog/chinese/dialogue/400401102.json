{"id":400401102,"chapter_id":50016,"scene_id":51619,"steps":[{"step":1,"speaker":"嗷呜","content":"什么嘛，故事才不是这样的！而且你居然偷偷改本导演的剧本！","voice":["vo_event_400401102_1"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":2,"speaker":"琳","content":"唔，可是……可是你真的很吓人……","voice":["vo_event_400401102_2"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":3,"speaker":"嗷呜","content":"唉——算啦算啦，本导演就特许你和我一起创作吧！","voice":["vo_event_400401102_3"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":4,"speaker":"嗷呜","content":"害怕嗷呜大魔王也没关系，但这是关于“勇气”的故事。","voice":["vo_event_400401102_4"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":5,"speaker":"嗷呜","content":"接下来你要怎么办呢？","voice":["vo_event_400401102_5"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":6,"speaker":"琳","content":"那……这样的走向呢？","voice":["vo_event_400401102_6"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":7,"speaker":"琳","content":"那……这世界上……可能，可能有一颗勇气糖果！","voice":["vo_event_400401102_9"],"voice_bank":"vo_event_04011","style":1,"background":4038,"log_type":1},{"step":8,"speaker":"琳","content":"如果我吃下它的话，就一定能打赢大魔王！","voice":["vo_event_400401102_10"],"voice_bank":"vo_event_04011","style":1,"background":4038,"log_type":1}]}