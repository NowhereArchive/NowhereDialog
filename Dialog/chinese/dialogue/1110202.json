{"id":1110202,"chapter_id":1110202,"scene_id":1,"steps":[{"step":1,"speaker":"陌生女性","content":"你好！请问可以留个联系方式吗？","style":1,"background":1003,"log_type":1,"src_id":210202001,"trial_step":1},{"step":2,"speaker":"辰砂","content":"我……呃……","style":1,"background":1003,"log_type":1,"src_id":210202002,"trial_step":2},{"step":3,"content":"你走到后台时，刚好发现一位女性工作人员凑到了辰砂跟前。","style":3,"background":1003,"log_type":1,"src_id":210202003,"trial_step":3},{"step":4,"content":"辰砂一副手足无措的样子，向你投来求助的目光。","style":3,"background":1003,"log_type":1,"src_id":210202004,"trial_step":4},{"step":5,"options":["帮辰砂解围"],"style":6,"background":1003,"log_type":1,"src_id":210202005,"trial_step":5,"course":3,"choices":[{"text":"帮辰砂解围","goto":6}]},{"step":6,"content":"小姐，我和这位女士有重要的工作需要沟通，可以劳烦你回避一下吗？","style":2,"background":1003,"log_type":1,"src_id":210202006,"trial_step":6},{"step":7,"speaker":"陌生女性","content":"女士？！","style":1,"background":1003,"log_type":1,"src_id":210202007,"trial_step":7},{"step":8,"content":"工作人员在错愕中离去。辰砂终于松了一口气。","style":3,"background":1003,"log_type":1,"src_id":210202008,"trial_step":8},{"step":9,"speaker":"辰砂","content":"谢谢。","style":1,"background":1003,"log_type":1,"src_id":210202009,"trial_step":9},{"step":10,"content":"举手之劳罢了。演讲还有20分钟开场，你准备好了吗？","style":2,"background":1003,"log_type":1,"src_id":210202010,"trial_step":10},{"step":11,"speaker":"辰砂","content":"蛇眼还在进行最后一轮安全检查。他们待会儿会来这里和我交接，然后由我负责接下来的现场人员调度……","style":1,"background":1003,"log_type":1,"src_id":210202011,"trial_step":11},{"step":12,"content":"话音未落，走廊里传来脚步声。一个五十多岁的男子大步朝你们走来。","style":3,"background":1003,"log_type":1,"src_id":210202012,"trial_step":12},{"step":13,"content":"男子比你高了一个头有许，体型健硕，脸上那几道骇人的伤疤散发着生人勿进的气场。他一出现，辰砂就站了起来。","style":3,"background":1003,"log_type":1,"src_id":210202013,"trial_step":13},{"step":14,"speaker":"辰砂","content":"队长，会场的情况怎么样？","style":1,"background":1003,"log_type":1,"src_id":210202014,"trial_step":14},{"step":15,"content":"透过辰砂有些紧张的语气，你得知了他的身份——面前这个男人就是阿廖沙。","style":3,"background":1003,"log_type":1,"src_id":210202015,"trial_step":15},{"step":16,"speaker":"阿廖沙","content":"172名观众安检完毕，会场的干扰器也已经布置好。","style":1,"background":1003,"log_type":1,"src_id":210202016,"trial_step":16},{"step":17,"speaker":"阿廖沙","content":"另外，有五个人是雷根的特邀贵宾，他们的安检不归蛇眼负责。","style":1,"background":1003,"log_type":1,"src_id":210202017,"trial_step":17},{"step":18,"speaker":"辰砂","content":"那他们能……算了。","style":1,"background":1003,"log_type":1,"src_id":210202018,"trial_step":18},{"step":19,"speaker":"辰砂","content":"我会盯紧他们的。","style":1,"background":1003,"log_type":1,"src_id":210202019,"trial_step":19},{"step":20,"content":"辰砂没有明说，只是叹了口气。政治上的事情轮不到他们质疑。","style":3,"background":1003,"log_type":1,"src_id":210202020,"trial_step":20},{"step":21,"speaker":"辰砂","content":"队长你……","style":1,"background":1003,"log_type":1,"src_id":210202021,"trial_step":21},{"step":22,"speaker":"阿廖沙","content":"嗯？","style":1,"background":1003,"log_type":1,"src_id":210202022,"trial_step":22},{"step":23,"content":"阿廖沙皱眉打断了辰砂的提问，仿佛除了任务以外的事情一句也不愿意多说。辰砂低下了头，像个做错了事的孩子。","style":3,"background":1003,"log_type":1,"src_id":210202023,"trial_step":23},{"step":24,"options":["缓和下气氛"],"style":6,"background":1003,"log_type":1,"src_id":210202024,"trial_step":24,"course":3,"choices":[{"text":"缓和下气氛","goto":25}]},{"step":25,"content":"我相信辰砂的能力，你可以不用这么紧张。","style":2,"background":1003,"log_type":1,"src_id":210202025,"trial_step":25},{"step":26,"content":"阿廖沙转头望向你，目光极其尖锐，像头盯上猎物的大型猫科动物。","style":3,"background":1003,"log_type":1,"src_id":210202026,"trial_step":26},{"step":27,"content":"辰砂也感受到了他对你的敌意，向前一步挡在你身前。","style":3,"background":1003,"log_type":1,"src_id":210202027,"trial_step":27},{"step":28,"speaker":"辰砂","content":"队长，他是来协助我们的。","style":1,"background":1003,"log_type":1,"src_id":210202029,"trial_step":29,"next":[31]},{"step":29,"speaker":"辰砂","content":"队长，不要这样……她是我的朋友。","style":1,"background":1003,"log_type":1,"src_id":210202030,"trial_step":30},{"step":30,"content":"阿廖沙眯起眼睛看了看辰砂，又看了看你，几秒后，一言不发转身离开。","style":3,"background":1003,"log_type":1,"src_id":210202031,"trial_step":31},{"step":31,"speaker":"辰砂","content":"抱歉，阿廖沙他……不太擅长和人打交道。","style":1,"background":1003,"log_type":1,"src_id":210202032,"trial_step":32},{"step":32,"content":"没关系，看得出来他很负责。况且，小心一些总是对的。","style":2,"background":1003,"log_type":1,"src_id":210202033,"trial_step":33},{"step":33,"content":"得到你的谅解，辰砂笑了笑。她抬头看了眼钟，然后转身敲响了雷根休息室的门。","style":3,"background":1003,"log_type":1,"src_id":210202034,"trial_step":34},{"step":34,"speaker":"辰砂","content":"雷根阁下，时间……","style":1,"background":1003,"log_type":1,"src_id":210202035,"trial_step":35},{"step":35,"content":"还没等辰砂说完，休息室的门就已经被打开了。","style":3,"background":1003,"log_type":1,"src_id":210202036,"trial_step":36},{"step":36,"content":"在黑衣保镖的簇拥下，一个衣着考究的男人径直走向讲台，连看都没有看你们一眼。","style":3,"background":1003,"log_type":1,"src_id":210202037,"trial_step":37},{"step":37,"content":"在辰砂的示意下，你们二人跟着雷根走向会场。","style":3,"background":10000,"log_type":1,"src_id":210202039,"trial_step":39,"next":[41]},{"step":38,"content":"辰砂带着你，跟上雷根走向会场。","style":3,"background":10000,"log_type":1,"src_id":210202040,"trial_step":40},{"step":39,"content":"你坐到前排最左侧位置，辰砂作为安保负责人站在了你身边。","style":3,"background":1032,"log_type":1,"src_id":210202041,"trial_step":41},{"step":40,"content":"台上，雷根开始了演讲。","style":3,"background":1032,"log_type":1,"src_id":210202042,"trial_step":42},{"step":41,"options":["坐下听听演讲的内容"],"style":6,"background":1032,"log_type":1,"src_id":210202043,"trial_step":43,"course":3,"choices":[{"text":"坐下听听演讲的内容","goto":44}]},{"step":42,"content":"看得出来，雷根很擅长演讲。他条理清晰，情感也很饱满，说话颇有信服力。","style":3,"background":1032,"log_type":1,"src_id":210202044,"trial_step":44},{"step":43,"content":"几十分钟里，他主要讲了辛迪加部分街区面临的困境，以及自己为解决这一问题所做的努力。","style":3,"background":1032,"log_type":1,"src_id":210202045,"trial_step":45},{"step":44,"content":"演讲接近尾声时，雷根开始感谢那些支持他计划的人。","style":3,"background":1032,"log_type":1,"src_id":210202046,"trial_step":46},{"step":45,"speaker":"雷根","content":"……这几位仁慈的绅士响应了我的“家园重建计划”，为辛迪加流离失所的居民建立了新社区。","style":1,"background":1032,"log_type":1,"src_id":210202047,"trial_step":47},{"step":46,"speaker":"雷根","content":"他们获得了辛迪加人的尊重，也获得了我的敬意。","style":1,"background":1032,"log_type":1,"src_id":210202048,"trial_step":48},{"step":47,"speaker":"雷根","content":"现在，有请他们上台，我将亲手授予他们由市议会颁发的“博爱勋章”！","style":1,"background":1032,"log_type":1,"src_id":210202049,"trial_step":49},{"step":48,"content":"伴随着激昂的音乐与台下热烈的掌声，阿廖沙之前提到过的“贵宾”——几位新城有名的地产大亨从贵宾休息室走入讲台。","style":3,"background":1032,"log_type":1,"src_id":210202050,"trial_step":50},{"step":49,"content":"你认识这几个人吗？","style":2,"background":1032,"log_type":1,"src_id":210202051,"trial_step":51},{"step":50,"content":"在被MBCC收容之前，辰砂就待在辛迪加。如果事实真像雷根所说的那样，辰砂或许会认识这几个人。","style":3,"background":1032,"log_type":1,"src_id":210202052,"trial_step":52},{"step":51,"speaker":"辰砂","content":"我不认识他们。","style":1,"background":1032,"log_type":1,"src_id":210202053,"trial_step":53},{"step":52,"speaker":"辰砂","content":"而且……我也没有听说过什么“家园重建计划”。倒是听说有新建成的住宅区因为地基不稳倒塌，死了很多人……等等，那个人看上去不对劲！","style":1,"background":1032,"log_type":1,"src_id":210202054,"trial_step":54},{"step":53,"content":"顺着辰砂的指示，你看向讲台——其中一名开发商面色铁青、嘴唇发抖，快步走向雷根。","style":3,"background":1032,"log_type":1,"src_id":210202055,"trial_step":55},{"step":54,"content":"咔哒——","style":3,"background":1032,"log_type":1,"src_id":210202056,"trial_step":56},{"step":55,"content":"还没等得及辰砂冲上前，开发商就从衣服里掏出一副手铐，将雷根与自己拷在了一起。","style":3,"background":1032,"log_type":1,"src_id":210202057,"trial_step":57},{"step":56,"speaker":"开发商","content":"对不起雷根先生，你别动，我求求你，千万不要动，不然我们都会死的！那个人在我身上装了炸弹……","style":1,"background":1032,"log_type":1,"src_id":210202058,"trial_step":58},{"step":57,"content":"短暂的失神之后，整个会场爆发出惊叫，仅仅几秒就陷入巨大的恐慌当中。","style":3,"background":1033,"log_type":1,"src_id":210202059,"trial_step":59},{"step":58,"content":"人群尖叫着，互相推搡着。你听到身后有孩子的哭喊，可刚一回头，就被涌向逃生通道的人流推倒在地。","style":3,"background":1033,"log_type":1,"src_id":210202060,"trial_step":60},{"step":59,"content":"你竭力尝试起身，却不知被谁重重踏在后背上。就在这时，一只手紧紧握住了你的前臂。","style":3,"background":1033,"log_type":1,"src_id":210202062,"trial_step":62},{"step":60,"speaker":"辰砂","content":"抓紧我，不要松手！","style":1,"background":1033,"log_type":1,"src_id":210202063,"trial_step":63},{"step":61,"content":"听到辰砂的声音，你立刻反应过来，抓住了她的手臂，顺势起身。","style":3,"background":1033,"log_type":1,"src_id":210202064,"trial_step":64},{"step":62,"content":"你们迎着湍急的人流艰难前进，很快抵达了讲台下。你听到台上传来嘈杂的声响。","style":3,"background":1033,"log_type":1,"src_id":210202065,"trial_step":65,"next":[77]},{"step":63,"content":"你竭力尝试起身，但不知是谁重重踏在你的后背上，之后的人流更是丝毫没有停下的意向——","style":3,"background":1033,"log_type":1,"src_id":210202066,"trial_step":66},{"step":64,"speaker":"辰砂","content":"！！","style":1,"background":1033,"log_type":1,"src_id":210202067,"trial_step":67},{"step":65,"content":"冰冷的蓝色光幕之下，辰砂背对你挡住人群，向你伸出手。","style":3,"background":1033,"log_type":1,"src_id":210202068,"trial_step":68},{"step":66,"options":["抓住她"],"style":6,"background":1033,"log_type":1,"src_id":210202069,"trial_step":69,"course":3,"choices":[{"text":"抓住她","goto":70}]},{"step":67,"content":"你反应过来，握住她的手顺势起身。","style":3,"background":1033,"log_type":1,"src_id":210202070,"trial_step":70},{"step":68,"speaker":"辰砂","content":"……没受伤吧？","style":1,"background":1033,"log_type":1,"src_id":210202071,"trial_step":71},{"step":69,"content":"我没事，快去控制住台上！","style":2,"background":1033,"log_type":1,"src_id":210202072,"trial_step":72},{"step":70,"speaker":"辰砂","content":"不用担心，我会解决。先离开这里。","style":1,"background":1033,"log_type":1,"src_id":210202073,"trial_step":73},{"step":71,"content":"辰砂左臂护住你，右臂上的盾牌前顶，分隔开人群。","style":3,"background":1033,"log_type":1,"src_id":210202074,"trial_step":74},{"step":72,"speaker":"辰砂","content":"……小心。","style":1,"background":1033,"log_type":1,"src_id":210202075,"trial_step":75},{"step":73,"content":"你们迎着湍急的人流艰难前进。不知过了多久，你终于听到了台上嘈杂的声响。","style":3,"background":1033,"log_type":1,"src_id":210202076,"trial_step":76},{"step":74,"speaker":"合成音","content":"……雷根，你只有一个选择——现在拨款，赔偿所有绿茵街区房屋倒塌案死者的家属。","style":11,"background":1033,"log_type":1,"src_id":210202077,"trial_step":77},{"step":75,"speaker":"合成音","content":"这是你最后的赎罪机会，否则我就炸死你和这个蛀虫。","style":11,"background":1033,"log_type":1,"src_id":210202078,"trial_step":78},{"step":76,"content":"开发商领口的扩音器发出电子合成的声音。他解开西服外套，露出通讯器和腰间的炸弹。","style":3,"background":1033,"log_type":1,"src_id":210202079,"trial_step":79},{"step":77,"speaker":"开发商","content":"我……吞了的钱我都可以还回去，求求你，不要杀我，我还有孩子……","style":1,"background":1033,"log_type":1,"src_id":210202080,"trial_step":80},{"step":78,"content":"雷根冷冷地盯着开发商，没有说话。","style":3,"background":1033,"log_type":1,"src_id":210202081,"trial_step":81},{"step":79,"speaker":"合成音","content":"我给你两分钟时间考虑。","style":11,"background":1033,"log_type":1,"src_id":210202082,"trial_step":82},{"step":80,"content":"雷根依旧沉默。","style":3,"background":1033,"log_type":1,"src_id":210202083,"trial_step":83},{"step":81,"speaker":"辰砂","content":"电视转播有15分钟延迟，监控室都是蛇眼的人……袭击者只可能在现场。","style":1,"background":1033,"log_type":1,"src_id":210202084,"trial_step":84},{"step":82,"speaker":"辰砂","content":"袭击者需要时刻观察台上的动作，后排靠近出口的位置人很多，没办法看清台上……","style":1,"background":1033,"log_type":1,"src_id":210202085,"trial_step":85},{"step":83,"content":"辰砂分析完状况，你们对视了一眼，开始默契地分两边扫视现场。","style":3,"background":1033,"log_type":1,"src_id":210202086,"trial_step":86},{"step":84,"content":"很快，一个蹲坐在桌下发抖的人引起了你的注意。他瘦小的身躯剧烈哆嗦着，像是因为恐惧而无法移动身体，但实际上，他一直在悄悄抬眼看向讲台。","style":3,"background":1033,"log_type":1,"src_id":210202087,"trial_step":87},{"step":85,"content":"你们目光相接，他迅速看向其他地方，眼神中闪过一丝寒光。","style":3,"background":1033,"log_type":1,"src_id":210202088,"trial_step":88},{"step":86,"options":["告知辰砂"],"style":6,"background":1033,"log_type":1,"src_id":210202089,"trial_step":89,"course":3,"choices":[{"text":"告知辰砂","goto":90}]},{"step":87,"content":"六排四座，椅子下面！","style":2,"background":1033,"log_type":1,"src_id":210202090,"trial_step":90},{"step":88,"speaker":"合成音","content":"时间到了！","style":11,"background":1033,"log_type":1,"src_id":210202091,"trial_step":91},{"step":89,"speaker":"辰砂","content":"启动EMP！","style":1,"background":1033,"log_type":1,"src_id":210202092,"trial_step":92},{"step":90,"content":"透过短波通讯，蛇眼的人接收到了命令。他们立刻启动了电磁干扰装置。强大的EMP冲击使得所有电子设备瞬间瘫痪。现场陷入一片黑暗。","style":3,"background":1033,"log_type":1,"src_id":210202093,"trial_step":93},{"step":91,"content":"下一刻，辰砂飞身跃过人群，反剪住正准备逃跑的袭击者的双臂，按倒在地。袭击者手中的引爆器被甩落一旁，被人群踏碎，变为一堆废铁。","style":3,"background":1033,"log_type":1,"src_id":210202094,"trial_step":94},{"step":92,"speaker":"辰砂","content":"目标擒获！","style":1,"background":1033,"log_type":1,"src_id":210202095,"trial_step":95},{"step":93,"content":"半分钟后，你听到备用电源启动的声响，光亮重新笼罩了会场。","style":3,"background":1032,"log_type":1,"src_id":210202096,"trial_step":96},{"step":94,"options":["查看袭击者"],"style":6,"background":1032,"log_type":1,"src_id":210202097,"trial_step":97,"course":3,"choices":[{"text":"查看袭击者","goto":98}]},{"step":95,"content":"你快步走到辰砂身边，发现被摁在地上的是一副略显稚嫩的面孔——那正是袭击者。","style":3,"background":1032,"log_type":1,"src_id":210202098,"trial_step":98},{"step":96,"content":"干得漂亮，辰砂！","style":2,"background":1032,"log_type":1,"src_id":210202099,"trial_step":99},{"step":97,"content":"几名蛇眼成员走了过来，给辰砂递来尼龙扎带，辰砂麻利地将袭击者捆了起来。","style":3,"background":1032,"log_type":1,"src_id":210202100,"trial_step":100},{"step":98,"content":"腾出手来后，辰砂第一反应是回头在周遭拥挤的人群里寻找些什么。直到看到你没事之后，她才松了口气。","style":3,"background":1032,"log_type":1,"src_id":210202101,"trial_step":101},{"step":99,"content":"台上，阿廖沙用液压钳剪断了手铐。雷根似笑非笑地揉了揉发红的手腕，接着突然拔出了阿廖沙腰间的配枪。","style":3,"background":1032,"log_type":1,"src_id":210202102,"trial_step":102},{"step":100,"content":"砰砰！","style":3,"background":1032,"log_type":1,"src_id":210202103,"trial_step":103},{"step":101,"content":"枪声过后，开发商倒在地上抽搐了几下，很快便没有了动静。","style":3,"background":1032,"log_type":1,"src_id":210202104,"trial_step":104},{"step":102,"content":"杀完人的雷根深吸一口气，缓缓吐出，然后露出标准的“上流笑容”，看向阿廖沙。","style":3,"background":1032,"log_type":1,"src_id":210202105,"trial_step":105},{"step":103,"speaker":"雷根","content":"你有什么想解释的？","style":1,"background":1032,"log_type":1,"src_id":210202106,"trial_step":106},{"step":104,"speaker":"阿廖沙","content":"我很抱歉。","style":1,"background":1032,"log_type":1,"src_id":210202107,"trial_step":107},{"step":105,"content":"阿廖沙面色阴沉，雷根却只是很轻松地拍了拍他的肩膀。","style":3,"background":1032,"log_type":1,"src_id":210202108,"trial_step":108},{"step":106,"speaker":"雷根","content":"我不需要总是道歉的人。","style":1,"background":1032,"log_type":1,"src_id":210202109,"trial_step":109},{"step":107,"speaker":"雷根","content":"我喜欢实干家。","style":1,"background":1032,"log_type":1,"src_id":210202110,"trial_step":110},{"step":108,"content":"他将手枪塞回到阿廖沙的手上，看了眼地上的袭击者，接着在两名保镖的护送下走向紧急逃离通道。","style":3,"background":1032,"log_type":1,"src_id":210202111,"trial_step":111},{"step":109,"speaker":"袭击者","content":"王八蛋，有种给老子回来，老子要宰了你！我们辛迪加人做鬼也不会放过你！","style":1,"background":1032,"log_type":1,"src_id":210202112,"trial_step":112},{"step":110,"content":"地上的袭击者奋力抬起头叫骂着。雷根停下脚步，转过头来，却并没有回应他。","style":3,"background":1032,"log_type":1,"src_id":210202113,"trial_step":113},{"step":111,"speaker":"雷根","content":"啊对了——辰砂。","style":1,"background":1032,"log_type":1,"src_id":210202114,"trial_step":114},{"step":112,"content":"雷根微笑着，不知为何，那笑容令人颇为不快。","style":3,"background":1032,"log_type":1,"src_id":210202115,"trial_step":115},{"step":113,"speaker":"雷根","content":"没想到在辛迪加鬼混两年、成为禁闭者之后，你的身手一点也没落下……","style":1,"background":1032,"log_type":1,"src_id":210202116,"trial_step":116},{"step":114,"speaker":"雷根","content":"新城需要人才……即使是你这样的阴沟老鼠，大概也有能用上的地方吧。","style":1,"background":1032,"log_type":1,"src_id":210202117,"trial_step":117},{"step":115,"content":"说完这些，雷根便头也不回地离开了。","style":3,"background":1032,"log_type":1,"src_id":210202118,"trial_step":118},{"step":116,"content":"这几分钟里，民众已经在蛇眼的疏导下全部逃离现场，剩下的人被诡异沉默笼罩，只有袭击者还在歇斯底里的叫骂。","style":3,"background":1032,"log_type":1,"src_id":210202119,"trial_step":119},{"step":117,"content":"阿廖沙一言不发，缓缓走向你们这边。他没有将枪放回枪套。沉重的脚步声听得人有些胸闷。","style":3,"background":1032,"log_type":1,"src_id":210202120,"trial_step":120},{"step":118,"speaker":"袭击者","content":"走狗，你们不得好死！","style":1,"background":1032,"log_type":1,"src_id":210202121,"trial_step":121},{"step":119,"content":"袭击者在地上疯狂扭动。阿廖沙停在他面前。","style":3,"background":1032,"log_type":1,"src_id":210202122,"trial_step":122},{"step":120,"speaker":"阿廖沙","content":"辰砂，按住他。","style":1,"background":1032,"log_type":1,"src_id":210202123,"trial_step":123},{"step":121,"content":"在场的所有人都知道阿廖沙的意图，但没有人出声反对，除了辰砂。","style":3,"background":1032,"log_type":1,"src_id":210202124,"trial_step":124},{"step":122,"speaker":"辰砂","content":"队长……","style":1,"background":1032,"log_type":1,"src_id":210202125,"trial_step":125},{"step":123,"content":"砰！","style":3,"background":1032,"log_type":1,"src_id":210202126,"trial_step":126},{"step":124,"content":"阿廖沙没有听辰砂说话，自顾自扣动了扳机。可枪声过后，袭击者并没有死。他被吓得闭紧双眼，子弹滚落到他面前。","style":3,"background":1032,"log_type":1,"src_id":210202127,"trial_step":127},{"step":125,"content":"幽蓝色的光芒在袭击者身旁浮动——辰砂张开了护盾，保护了他。","style":3,"background":1032,"log_type":1,"src_id":210202128,"trial_step":128},{"step":126,"speaker":"阿廖沙","content":"辰——砂——","style":1,"background":1032,"log_type":1,"src_id":210202129,"trial_step":129},{"step":127,"content":"阿廖沙脸上的肌肉抽动着。","style":3,"background":1032,"log_type":1,"src_id":210202130,"trial_step":130},{"step":128,"speaker":"阿廖沙","content":"这是雇主的命令……把他交给我。","style":1,"background":1032,"log_type":1,"src_id":210202131,"trial_step":131},{"step":129,"content":"辰砂看了看地上年少的袭击者，咬咬牙，抬头望向阿廖沙。","style":3,"background":1032,"log_type":1,"src_id":210202132,"trial_step":132},{"step":130,"speaker":"辰砂","content":"我办不到。","style":1,"background":1032,"log_type":1,"src_id":210202133,"trial_step":133},{"step":131,"content":"护盾仍然阻挡在两人之间。","style":3,"background":1032,"log_type":1,"src_id":210202134,"trial_step":134},{"step":132,"speaker":"阿廖沙","content":"你知道蛇眼为了促成这次的事，付出了多大的代价吗？！","style":1,"background":1032,"log_type":1,"src_id":210202135,"trial_step":135},{"step":133,"content":"阿廖沙深吸一口气，压住了随时可能爆发的火气。","style":3,"background":1032,"log_type":1,"src_id":210202136,"trial_step":136},{"step":134,"speaker":"阿廖沙","content":"过去的事，我都可以不追究。现在，让开，别再让我说第三遍。","style":1,"background":1032,"log_type":1,"src_id":210202137,"trial_step":137},{"step":135,"options":["帮助辰砂"],"style":6,"background":1032,"log_type":1,"src_id":210202138,"trial_step":138,"course":3,"choices":[{"text":"帮助辰砂","goto":139}]},{"step":136,"content":"周围的蛇眼队员们注视着辰砂，却什么都没说。","style":3,"background":1032,"log_type":1,"src_id":210202139,"trial_step":139},{"step":137,"content":"你不帮助辰砂，就没人会帮她了。","style":3,"background":1032,"log_type":1,"src_id":210202140,"trial_step":140},{"step":138,"content":"你没有权力杀他，阿廖沙。","style":2,"background":1032,"log_type":1,"src_id":210202141,"trial_step":141},{"step":139,"content":"阿廖沙没有半点反应，连看都没有看你一眼。他的眼神始终盯着辰砂。","style":3,"background":1032,"log_type":1,"src_id":210202142,"trial_step":142},{"step":140,"content":"袭击者已经没有威胁，按律他必须被交给法庭审判。动用私刑是……","style":2,"background":1032,"log_type":1,"src_id":210202143,"trial_step":143},{"step":141,"speaker":"阿廖沙","content":"闭嘴！！","style":1,"background":1032,"log_type":1,"src_id":210202144,"trial_step":144},{"step":142,"content":"阿廖沙朝你咆哮着，他须发皆张，像头发怒的狮子。","style":3,"background":1032,"log_type":1,"src_id":210202145,"trial_step":145},{"step":143,"speaker":"阿廖沙","content":"蛇眼的事情还轮不到外人插嘴！","style":1,"background":1032,"log_type":1,"src_id":210202146,"trial_step":146},{"step":144,"speaker":"辰砂","content":"他不是什么外人。","style":1,"background":1032,"log_type":1,"src_id":210202148,"trial_step":148,"next":[150]},{"step":145,"speaker":"辰砂","content":"她……不是什么外人！","style":1,"background":1032,"log_type":1,"src_id":210202149,"trial_step":149},{"step":146,"content":"阿廖沙瞪大眼睛，错愕一瞬间盖过了愤怒。","style":3,"background":1032,"log_type":1,"src_id":210202150,"trial_step":150},{"step":147,"speaker":"辰砂","content":"他一直帮助照顾着我……他是我的朋友。","style":1,"background":1032,"log_type":1,"src_id":210202152,"trial_step":152,"next":[154]},{"step":148,"speaker":"辰砂","content":"她一直帮助照顾着我……她是我重要的……朋友！","style":1,"background":1032,"log_type":1,"src_id":210202153,"trial_step":153},{"step":149,"speaker":"阿廖沙","content":"所以……你就可以为了这个人，再背叛蛇眼一次？！","style":1,"background":1032,"log_type":1,"src_id":210202154,"trial_step":154},{"step":150,"speaker":"辰砂","content":"我并不想背叛蛇眼，阿廖沙，我没有这么想过……","style":1,"background":1032,"log_type":1,"src_id":210202155,"trial_step":155},{"step":151,"speaker":"辰砂","content":"忠诚、勇敢、坚毅……这些是爸爸、何塞……还有你教给我的。我从来都不敢忘记。","style":1,"background":1032,"log_type":1,"src_id":210202156,"trial_step":156},{"step":152,"content":"辰砂的胸口剧烈地起伏着。","style":3,"background":1032,"log_type":1,"src_id":210202157,"trial_step":157},{"step":153,"speaker":"辰砂","content":"可是您有没有想过，除此之外，世界上还有更重要和正确的东西。","style":1,"background":1032,"log_type":1,"src_id":210202158,"trial_step":158},{"step":154,"speaker":"辰砂","content":"比雇主的命令更重要的，公理、正义、无辜者的性命……","style":1,"background":1032,"log_type":1,"src_id":210202159,"trial_step":159},{"step":155,"speaker":"阿廖沙","content":"你要为了这些虚无缥缈的东西，放弃前程，放弃蛇眼，待在那种鬼地方，做着看不到明天的工作，直到……死吗？","style":1,"background":1032,"log_type":1,"src_id":210202160,"trial_step":160},{"step":156,"speaker":"辰砂","content":"两年前的事情，我很抱歉……但我并不后悔。","style":1,"background":1032,"log_type":1,"src_id":210202161,"trial_step":161},{"step":157,"speaker":"辰砂","content":"我愿意为我坚持的那些虚无缥缈的东西……","style":1,"background":1032,"log_type":1,"src_id":210202162,"trial_step":162},{"step":158,"speaker":"阿廖沙","content":"够了。","style":1,"background":1032,"log_type":1,"src_id":210202163,"trial_step":163},{"step":159,"content":"阿廖沙打断了辰砂。他伫立在辰砂面前，眼中的愤怒消失殆尽，看上去疲惫极了。","style":3,"background":1032,"log_type":1,"src_id":210202164,"trial_step":164},{"step":160,"content":"握住枪的手慢慢放了下来。","style":3,"background":1032,"log_type":1,"src_id":210202165,"trial_step":165},{"step":161,"speaker":"阿廖沙","content":"随你去吧。","style":1,"background":1032,"log_type":1,"src_id":210202166,"trial_step":166},{"step":162,"content":"阿廖沙全然不顾辰砂眼中的悲戚，背过身，朝出口走去。沉重的脚步声在空旷的大厅中回响。","style":3,"background":1032,"log_type":1,"src_id":210202167,"trial_step":167},{"step":163,"content":"就这么放他离开的话，辰砂和他或许这辈子都不会再见面了。","style":3,"background":1032,"log_type":1,"src_id":210202168,"trial_step":168},{"step":164,"options":["尝试挽留阿廖沙"],"style":6,"background":1032,"log_type":1,"src_id":210202169,"trial_step":169,"course":3,"choices":[{"text":"尝试挽留阿廖沙","goto":170}]},{"step":165,"content":"阿廖沙，等等……辰砂一直是在乎你们，在乎你的。","style":2,"background":1032,"log_type":1,"src_id":210202170,"trial_step":170},{"step":166,"content":"阿廖沙停下了脚步。","style":3,"background":1032,"log_type":1,"src_id":210202171,"trial_step":171},{"step":167,"content":"在得知你曾经给我打电话的时候，她第一反应是问我“阿廖沙最近过得怎么样”……","style":2,"background":1032,"log_type":1,"src_id":210202172,"trial_step":172},{"step":168,"content":"等冷静下来，和她聊聊吧。给她个机会，也给你自己一个机会。","style":2,"background":1032,"log_type":1,"src_id":210202173,"trial_step":173},{"step":169,"content":"阿廖沙身体微微一颤。在离开之前，他回过头，神情复杂地看了你一眼，却什么也没说。","style":3,"background":1032,"log_type":1,"src_id":210202174,"trial_step":174},{"step":170,"content":"等到蛇眼的人都离开后，辰砂收起了护盾。","style":3,"background":1032,"log_type":1,"src_id":210202175,"trial_step":175},{"step":171,"content":"长时间展开护盾让辰砂有些脱力，收起护盾后她靠着背后的墙，慢慢跌坐在地上。","style":3,"background":1032,"log_type":1,"src_id":210202176,"trial_step":176},{"step":172,"options":["你还好吧？"],"style":6,"background":1032,"log_type":1,"src_id":210202177,"trial_step":177,"course":3,"choices":[{"text":"你还好吧？","goto":178}]},{"step":173,"speaker":"辰砂","content":"我没事。","style":1,"background":1032,"log_type":1,"src_id":210202178,"trial_step":178},{"step":174,"content":"她的声音听起来一点也不像“没事”。","style":3,"background":1032,"log_type":1,"src_id":210202179,"trial_step":179},{"step":175,"content":"阿廖沙或许只是需要点时间冷静一下。","style":2,"background":1032,"log_type":1,"src_id":210202180,"trial_step":180},{"step":176,"speaker":"辰砂","content":"……","style":1,"background":1032,"log_type":1,"src_id":210202181,"trial_step":181},{"step":177,"content":"你上前扶住了她摇摇欲坠的身体。","style":3,"background":1032,"log_type":1,"src_id":210202182,"trial_step":182},{"step":178,"content":"辰砂抬起头，眼眶盈满泪水，身体不住颤抖。","style":3,"background":1032,"log_type":1,"src_id":210202184,"trial_step":184},{"step":179,"content":"你叹了口气，拍了拍她的肩膀。","style":3,"background":1032,"log_type":1,"src_id":210202185,"trial_step":185,"next":[188]},{"step":180,"content":"辰砂抬起头，眼眶盈满泪水，一把抱住了你。你清晰地感觉到，她的身体在颤抖。","style":3,"background":1032,"log_type":1,"src_id":210202186,"trial_step":186},{"step":181,"content":"你叹了口气，拍了拍她的背。","style":3,"background":1032,"log_type":1,"src_id":210202187,"trial_step":187},{"step":182,"content":"无论如何，我都在你这一边。","style":2,"background":1032,"log_type":1,"src_id":210202188,"trial_step":188},{"step":183,"speaker":"辰砂","content":"……谢谢。","style":1,"background":1032,"log_type":1,"src_id":210202189,"trial_step":189}]}