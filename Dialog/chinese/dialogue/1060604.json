{"id":1060604,"chapter_id":1060604,"scene_id":1,"steps":[{"step":1,"speaker":"局长","content":"明天？","style":2,"background":1040,"log_type":1,"src_id":160604001,"trial_step":1},{"step":2,"content":"听筒那端，议员的语调喜气洋洋。","style":3,"background":1040,"log_type":1,"src_id":160604002,"trial_step":2},{"step":3,"speaker":"议员","content":"是的，明天离境。稍后，杜若使者的离境文书会送达MBCC。在她离开管理局后，希望MBCC能够切实检查她的住所，不要留下任何异邦隐患。","voice":["vo_trial_60604_1_3"],"voice_bank":"vo_duruo_trial","style":11,"background":1040,"log_type":1,"src_id":160604003,"trial_step":3},{"step":4,"speaker":"局长","content":"她昨天才从砂海回来，这么安排会不会太仓促了？","style":2,"background":1040,"log_type":1,"src_id":160604004,"trial_step":4},{"step":5,"speaker":"议员","content":"她重返狄斯本就属于临时停留。更何况，我们愿意让她回到东洲，没有追究数据库入侵一事，已经足以表示狄斯城的风度。","voice":["vo_trial_60604_1_5"],"voice_bank":"vo_duruo_trial","style":11,"background":1040,"log_type":1,"src_id":160604005,"trial_step":5},{"step":6,"speaker":"议员","content":"好了局长，此事没有讨论的必要。做出决定前，我们询问过杜若使者的想法，她本人没有任何意见。","voice":["vo_trial_60604_1_6"],"voice_bank":"vo_duruo_trial","style":11,"background":1040,"log_type":1,"src_id":160604006,"trial_step":6},{"step":7,"content":"当你找到杜若证实时，她正俯身点燃香篆，房内散落着行李，地面上有摊开的行囊，收拾到一半。","style":3,"background":2189,"log_type":1,"src_id":160604007,"trial_step":7},{"step":8,"options":["你已经决定明天启程了？"],"style":6,"background":2189,"log_type":1,"src_id":160604008,"trial_step":8,"course":3,"choices":[{"text":"你已经决定明天启程了？","goto":9}]},{"step":9,"speaker":"杜若","content":"是啊。局长舍不得我吗？","voice":["vo_trial_60604_1_9"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604009,"trial_step":9},{"step":10,"speaker":"杜若","content":"这次一别，或许真的很久无法见面了。","voice":["vo_trial_60604_1_10"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604010,"trial_step":10},{"step":11,"content":"这间休息室在管理局算采光很好的一间。因为她刚来的时候说东洲人每天都要晒晒太阳，采集灵气。","style":3,"background":2189,"log_type":1,"src_id":160604011,"trial_step":11},{"step":12,"content":"杜若站在光里，偶尔有烟在她周遭凝实，但很快又消散。","style":3,"background":2189,"log_type":1,"src_id":160604012,"trial_step":12},{"step":13,"speaker":"局长","content":"我会沟通协调，让你随时能来狄斯。","style":2,"background":2189,"log_type":1,"src_id":160604013,"trial_step":13},{"step":14,"speaker":"杜若","content":"多谢局长。","voice":["vo_trial_60604_1_14"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604014,"trial_step":14},{"step":15,"content":"烟消云散中，房间里沉默了半刻。","style":3,"background":2189,"log_type":1,"src_id":160604015,"trial_step":15},{"step":16,"speaker":"杜若","content":"我可以从这里带走一些东西作为纪念吗？新城那个被你嫌弃的挂件没有买成。","voice":["vo_trial_60604_1_16"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604016,"trial_step":16},{"step":17,"content":"你四下看了看，一时间居然有些不知道送什么。","style":3,"background":2189,"log_type":1,"src_id":160604017,"trial_step":17},{"step":18,"options":["这本书？","这支笔？"],"style":6,"background":2189,"log_type":1,"src_id":160604018,"trial_step":18,"course":3,"choices":[{"text":"这本书？","goto":19},{"text":"这支笔？","goto":null}]},{"step":19,"content":"她摇了摇头。","style":3,"background":2189,"log_type":1,"src_id":160604019,"trial_step":19},{"step":20,"speaker":"杜若","content":"我想要这个。","voice":["vo_trial_60604_1_20"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604020,"trial_step":20},{"step":21,"content":"杜若推开窗户，指着窗外的一根树枝。","style":3,"background":2189,"log_type":1,"src_id":160604021,"trial_step":21},{"step":22,"speaker":"杜若","content":"东洲古语有“折柳”一说，以表惜别。如果可以的话，你为我亲手折一枝吧。","voice":["vo_trial_60604_1_22"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604022,"trial_step":22},{"step":23,"speaker":"杜若","content":"一小段就好。","voice":["vo_trial_60604_1_23"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604023,"trial_step":23},{"step":24,"content":"你依言做了。杜若珍惜地接过。","style":3,"background":2189,"log_type":1,"src_id":160604024,"trial_step":24},{"step":25,"speaker":"杜若","content":"多谢……看到这截树枝，我就会想起在狄斯与你共同的经历，回乡的长途也不至于枯燥了。","voice":["vo_trial_60604_1_25"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604025,"trial_step":25},{"step":26,"speaker":"局长","content":"真的不打算再多留几天吗？","style":2,"background":2189,"log_type":1,"src_id":160604026,"trial_step":26},{"step":27,"speaker":"杜若","content":"局长为什么要留我呢？","voice":["vo_trial_60604_1_27"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604027,"trial_step":27},{"step":28,"content":"树枝在杜若手中转动一会儿，然后停下。","style":3,"background":2189,"log_type":1,"src_id":160604028,"trial_step":28},{"step":29,"content":"太阳越升越高，杜若安安静静站在房间里。","style":3,"background":2189,"log_type":1,"src_id":160604029,"trial_step":29},{"step":30,"content":"明天太阳还会像这样照进屋子里，但住在这个房间的人将在万米之外。","style":3,"background":2189,"log_type":1,"src_id":160604030,"trial_step":30},{"step":31,"speaker":"杜若","content":"局长？","voice":["vo_trial_60604_1_31"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604031,"trial_step":31},{"step":32,"content":"她故意催促你回应。","style":3,"background":2189,"log_type":1,"src_id":160604032,"trial_step":32},{"step":33,"content":"你还没开口，有人敲响了房门。","style":3,"background":2189,"log_type":1,"src_id":160604033,"trial_step":33},{"step":34,"speaker":"MBCC人员","content":"这里是杜若的房间吗？","voice":["vo_trial_60604_1_34"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604034,"trial_step":34},{"step":35,"speaker":"MBCC人员","content":"这是你的离境书，请收好。","voice":["vo_trial_60604_1_35"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604035,"trial_step":35},{"step":36,"content":"MBCC人员干脆利索地将包裹递给杜若，向你们道别离开。","style":3,"background":2189,"log_type":1,"src_id":160604036,"trial_step":36},{"step":37,"content":"杜若看你局促尴尬的样子，笑着叹气，继续俯身收拾屋子。","style":3,"background":2189,"log_type":1,"src_id":160604037,"trial_step":37},{"step":38,"options":["我帮你一起吧"],"style":6,"background":2189,"log_type":1,"src_id":160604038,"trial_step":38,"course":3,"choices":[{"text":"我帮你一起吧","goto":39}]},{"step":39,"content":"扬尘在半空中浮动。你与杜若一个递，一个接，静默地收拾起行李。","style":3,"background":2189,"log_type":1,"src_id":160604039,"trial_step":39},{"step":40,"content":"书本、衣物、证件。","style":3,"background":2189,"log_type":1,"src_id":160604040,"trial_step":40},{"step":41,"speaker":"杜若","content":"你以后还会这样帮我吗？","voice":["vo_trial_60604_1_41"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604041,"trial_step":41},{"step":42,"speaker":"局长","content":"那得看你是不是又想触碰狄斯底线了。","style":2,"background":2189,"log_type":1,"src_id":160604042,"trial_step":42},{"step":43,"speaker":"杜若","content":"怎样是底线？","voice":["vo_trial_60604_1_43"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604043,"trial_step":43},{"step":44,"content":"杜若突然凑近，声音放得很轻，近乎耳语。","style":3,"background":2189,"log_type":1,"src_id":160604044,"trial_step":44},{"step":45,"speaker":"杜若","content":"如果我想了解狂厄知识，怎么办？","voice":["vo_trial_60604_1_45"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604045,"trial_step":45},{"step":46,"speaker":"局长","content":"在允许的范围内，我会解答你的问题。","style":2,"background":2189,"log_type":1,"src_id":160604046,"trial_step":46},{"step":47,"speaker":"杜若","content":"那要是我突然想和局长聊天呢？","voice":["vo_trial_60604_1_47"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604047,"trial_step":47},{"step":48,"speaker":"局长","content":"我会接你的电话。","style":2,"background":2189,"log_type":1,"src_id":160604048,"trial_step":48},{"step":49,"speaker":"杜若","content":"那……如果我一直来不了狄斯呢？","voice":["vo_trial_60604_1_49"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604049,"trial_step":49},{"step":50,"speaker":"局长","content":"……","style":2,"background":2189,"log_type":1,"src_id":160604050,"trial_step":50},{"step":51,"options":["我会去东洲见你","那些议员应该会很开心"],"style":6,"background":2189,"log_type":1,"src_id":160604051,"trial_step":51,"course":3,"choices":[{"text":"我会去东洲见你","goto":52},{"text":"那些议员应该会很开心","goto":53}]},{"step":52,"speaker":"杜若","content":"局长真奇怪，我们难道一定要见面吗？","voice":["vo_trial_60604_1_52"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604052,"trial_step":52,"next":[54]},{"step":53,"speaker":"杜若","content":"言外之意难道是——局长会一直不开心？","voice":["vo_trial_60604_1_53"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604053,"trial_step":53,"next":[54]},{"step":54,"content":"这一次，她没有等待你的回复，心满意足地退回安全距离。","style":3,"background":2189,"log_type":1,"src_id":160604054,"trial_step":54},{"step":55,"speaker":"杜若","content":"好了，不逗你了。","voice":["vo_trial_60604_1_55"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604055,"trial_step":55},{"step":56,"speaker":"杜若","content":"在下一次相逢前，我会记住今天的，记住局长舍不得我的样子。","voice":["vo_trial_60604_1_56"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604056,"trial_step":56},{"step":57,"speaker":"杜若","content":"作为神话学者，等风头过了，我当然还是会经常来狄斯的。如果你需要，我也会来见你。","voice":["vo_trial_60604_1_57"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604057,"trial_step":57},{"step":58,"speaker":"杜若","content":"局长，你可要好好帮我沟通入境关系啊。作为交换，这个就留给你了。","voice":["vo_trial_60604_1_58"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604058,"trial_step":58},{"step":59,"content":"她拿出一本东洲制式的线装册，封面上没有名字。","style":3,"background":2189,"log_type":1,"src_id":160604059,"trial_step":59},{"step":60,"speaker":"局长","content":"这是什么？","style":2,"background":2189,"log_type":1,"src_id":160604060,"trial_step":60},{"step":61,"speaker":"杜若","content":"我记录神话的小册子。","voice":["vo_trial_60604_1_61"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604061,"trial_step":61},{"step":62,"content":"她替你翻开第一页，递到你的面前。","style":3,"background":2189,"log_type":1,"src_id":160604062,"trial_step":62},{"step":63,"content":"<i>昔年有一国，名狄斯。神暴虐，灾厄频发。有一人负胆气，挺身而出。</i>","style":14,"background":2193,"log_type":1,"src_id":160604063,"trial_step":63},{"step":64,"speaker":"杜若","content":"曾经有一个名叫狄斯的城邦，遇见天神发怒，降临诸多灾祸。这时，有一个勇敢的人站了出来。","voice":["vo_trial_60604_1_64"],"voice_bank":"vo_duruo_trial","style":1,"background":2193,"log_type":1,"src_id":160604064,"trial_step":64},{"step":65,"content":"<i>曾经荼苦、屡逢暗刺，谤之欺之。后一异国者至，欲携其夜奔。神勇者拒，誓屠神。</i>","style":14,"background":4243,"log_type":1,"src_id":160604065,"trial_step":65},{"step":66,"speaker":"杜若","content":"这个人遭遇过误解、中伤，经历磨难却依然遭受不公，有一个异邦人想要带这个人离开，但这个人仍然留在了自己的国家，并且继续与灾厄对抗着。","voice":["vo_trial_60604_1_66"],"voice_bank":"vo_duruo_trial","style":1,"background":4243,"log_type":1,"src_id":160604066,"trial_step":66},{"step":67,"content":"最下面有一行小字，墨迹最浓，像是新增的批注。","style":3,"background":4243,"log_type":1,"src_id":160604067,"trial_step":67},{"step":68,"speaker":"局长","content":"那这句话呢，是什么意思？","style":2,"background":2189,"log_type":1,"src_id":160604068,"trial_step":68},{"step":69,"content":"她再次露出了狡黠的微笑。","style":3,"background":2189,"log_type":1,"src_id":160604069,"trial_step":69},{"step":70,"speaker":"杜若","content":"局长慢慢想吧。我们东洲人可是很含蓄的。","voice":["vo_trial_60604_1_70"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604070,"trial_step":70},{"step":71,"content":"<color=#fb9259><i>“今日方知山海不可平。”</color></i>","style":14,"background":10006,"is_centered":true,"log_type":1,"src_id":160604071,"trial_step":71}]}