{"id":1010101,"chapter_id":1010101,"scene_id":1,"steps":[{"step":1,"content":"距离审判还有\n30天","style":9,"background":10000,"log_type":1,"src_id":110101001,"trial_step":1,"drawing":1010101},{"step":2,"content":"身后的门重重关上，你坐在了这个凶名赫赫的男人面前。","style":3,"log_type":1,"src_id":110101003,"trial_step":3,"drawing":1010101},{"step":3,"speaker":"迪蒙","content":"……","style":1,"log_type":1,"src_id":110101004,"trial_step":4,"drawing":1010102},{"step":4,"content":"迪蒙抬头看了你一眼。","style":3,"log_type":1,"src_id":110101005,"trial_step":5,"drawing":1010102},{"step":5,"content":"或许是因为他刚做完手术，伤口还没有愈合，空气中弥漫着一股淡淡的腥甜气。","style":3,"log_type":1,"src_id":110101006,"trial_step":6,"drawing":1010101},{"step":6,"content":"迪蒙·谢尔德，我有事情要问你。","style":2,"log_type":1,"src_id":110101007,"trial_step":7,"drawing":1010101},{"step":7,"speaker":"迪蒙","content":"……","style":1,"log_type":1,"src_id":110101008,"trial_step":8,"drawing":1010102},{"step":8,"content":"迪蒙再度抬头，露出分明是审视猎物的目光。","style":3,"log_type":1,"src_id":110101009,"trial_step":9,"drawing":1010102},{"step":9,"content":"不久之前，这个男人经历了一场六十小时的追捕。事后管理局从他体内取出了三百多克弹片。四小时前，他还被注射了剂量足以致死的镇静剂。","style":3,"log_type":1,"src_id":110101010,"trial_step":10,"drawing":1010102},{"step":10,"content":"可即便如此，他还是散发着令人畏缩的气势。你能感觉到，迪蒙依旧可以伤害到你。","style":3,"log_type":1,"src_id":110101011,"trial_step":11,"drawing":1010102},{"step":11,"options":["安抚他","威胁他"],"style":6,"log_type":1,"src_id":110101012,"trial_step":12,"course":3,"drawing":1010102,"choices":[{"text":"安抚他","goto":13},{"text":"威胁他","goto":17}]},{"step":12,"content":"我并不是你的敌人。","style":2,"log_type":1,"src_id":110101013,"trial_step":13,"drawing":1010101},{"step":13,"content":"我需要了解一些情况。保护管理局的禁闭者是我的责任，你也包含在内。","style":2,"log_type":1,"src_id":110101014,"trial_step":14,"drawing":1010101},{"step":14,"speaker":"迪蒙","content":"……要我感谢你么？","voice":["vo_trial_10101_1_15"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101015,"trial_step":15,"drawing":1010101},{"step":15,"content":"他的声音里没有半点感谢的意味。","style":3,"log_type":1,"src_id":110101016,"trial_step":16,"drawing":1010101,"next":[21]},{"step":16,"content":"想想你的处境，迪蒙。","style":2,"log_type":1,"src_id":110101017,"trial_step":17,"drawing":1010101},{"step":17,"content":"很多人想要你，只有管理局可以保护你。你最好配合我们的工作。","style":2,"log_type":1,"src_id":110101018,"trial_step":18,"drawing":1010101},{"step":18,"speaker":"迪蒙","content":"他们大可以试试。","voice":["vo_trial_10101_1_19"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101019,"trial_step":19,"drawing":1010101},{"step":19,"content":"面对威胁，迪蒙在回答时甚至没有抬头。","style":3,"log_type":1,"src_id":110101020,"trial_step":20,"drawing":1010101},{"step":20,"content":"迪蒙不合作的态度你早有预料。几个小时前，就有人提醒过你了。","style":3,"log_type":1,"src_id":110101021,"trial_step":21,"drawing":1010101},{"step":21,"speaker":"事务官","content":"这就是迪蒙·谢尔德的全部资料了。","voice":["vo_trial_10101_1_5"],"voice_bank":"vo_dimeng_trial","style":1,"background":1017,"log_type":1,"src_id":110101022,"trial_step":22,"drawing":1010101},{"step":22,"content":"……","style":2,"background":1017,"log_type":1,"src_id":110101023,"trial_step":23,"drawing":1010101},{"step":23,"content":"桌子上摆放的资料文件堆积如山。桌子对面，一位事务官正笑盈盈地看着你。","style":3,"background":1017,"log_type":1,"src_id":110101024,"trial_step":24,"drawing":1010101},{"step":24,"speaker":"事务官","content":"局长阁下，迪蒙·谢尔德必须被移交给市议会。这场审判被拖延得太久了，早在8年前就该执行了。","voice":["vo_trial_10101_1_6"],"voice_bank":"vo_dimeng_trial","style":1,"background":1017,"log_type":1,"src_id":110101025,"trial_step":25,"drawing":1010101},{"step":25,"speaker":"事务官","content":"8年前他逃脱了审判，之后毫无收敛，又袭击了十二位市议会官员。","voice":["vo_trial_10101_1_7"],"voice_bank":"vo_dimeng_trial","style":1,"background":1017,"log_type":1,"src_id":110101026,"trial_step":26,"drawing":1010101},{"step":26,"speaker":"事务官","content":"他是个彻头彻尾的疯子，没有任何理由可以赦免。","voice":["vo_trial_10101_1_8"],"voice_bank":"vo_dimeng_trial","style":1,"background":1017,"log_type":1,"src_id":110101027,"trial_step":27,"drawing":1010101},{"step":27,"content":"事务官顿了顿，观察着你的反应。过了一会儿，他继续开口说道：","style":3,"background":1017,"log_type":1,"src_id":110101028,"trial_step":28,"drawing":1010101},{"step":28,"speaker":"事务官","content":"我们在30天后准备了一场审判，并给您带来了这些案件卷宗和证物。","voice":["vo_trial_10101_1_9"],"voice_bank":"vo_dimeng_trial","style":1,"background":1017,"log_type":1,"src_id":110101029,"trial_step":29,"drawing":1010101},{"step":29,"speaker":"事务官","content":"您可以自由调查，也可以对迪蒙进行审问。相信您能够了解到事情的真相……","voice":["vo_trial_10101_1_10"],"voice_bank":"vo_dimeng_trial","style":1,"background":1017,"log_type":1,"src_id":110101030,"trial_step":30,"drawing":1010101},{"step":30,"content":"谈话又进行了一段时间。临近结束，事务官起身告别。突然，他似乎是想起了什么，从公文包里取出一个小盒子递给了你。","style":3,"background":1017,"log_type":1,"src_id":110101031,"trial_step":31,"drawing":1010101},{"step":31,"speaker":"事务官","content":"啊对了，差点忘了这个。","voice":["vo_trial_10101_1_11"],"voice_bank":"vo_dimeng_trial","style":1,"background":1017,"log_type":1,"src_id":110101032,"trial_step":32,"drawing":1010101},{"step":32,"speaker":"事务官","content":"要是迪蒙无论如何都不肯开口，您可以给他看看这个。","voice":["vo_trial_10101_1_12"],"voice_bank":"vo_dimeng_trial","style":1,"background":1017,"log_type":1,"src_id":110101033,"trial_step":33,"drawing":1010101},{"step":33,"content":"盒子里面，放着一个小小的、女式手链。","style":3,"background":1017,"log_type":1,"src_id":110101034,"trial_step":34,"drawing":1010101},{"step":34,"content":"市议会提供了这次审查所需的资料。虽然长臂管辖的方式以及强硬要求带走管理局所属禁闭者的态度令人不满。但他们的确掌握着有力的证据。","style":3,"log_type":1,"src_id":110101035,"trial_step":35,"drawing":1010101},{"step":35,"content":"除非案件有什么别的隐情，否则恐怕你的上级部门不会直接介入。等待迪蒙的只有一条路。","style":3,"log_type":1,"src_id":110101036,"trial_step":36,"drawing":1010101},{"step":36,"content":"我们必须聊聊你的案子","options":["我们必须聊聊你的案子"],"style":6,"log_type":1,"src_id":110101037,"trial_step":37,"drawing":1010101,"next":[38]},{"step":37,"content":"迪蒙眯起眼睛，看了看你手中的文件。","style":3,"log_type":1,"src_id":110101038,"trial_step":38,"drawing":1010103},{"step":38,"speaker":"迪蒙","content":"市议会给的？","voice":["vo_trial_10101_1_39"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101039,"trial_step":39,"drawing":1010103},{"step":39,"content":"提起“市议会”这三个字，他的声音中满是戾气。","style":3,"log_type":1,"src_id":110101040,"trial_step":40,"drawing":1010103},{"step":40,"content":"是的。","style":2,"log_type":1,"src_id":110101041,"trial_step":41,"drawing":1010103},{"step":41,"content":"听到你的回答，迪蒙发出一声意味不明的冷笑，不再说话。","style":3,"log_type":1,"src_id":110101042,"trial_step":42,"drawing":1010101},{"step":42,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":43,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":44,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":45,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":46,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":47,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":48,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":49,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":50,"content":"你拿起第一份卷宗。","style":3,"log_type":1,"src_id":110101044,"trial_step":44,"drawing":1010101},{"step":51,"content":"前特遣队副队长<color=#e45515>芬恩</color>，105年12月24日从自家公寓阳台上坠落。除摔伤外，尸体上还发现了其他伤痕。","style":2,"log_type":1,"src_id":110101045,"trial_step":45,"drawing":1010101},{"step":52,"content":"这是你做的么？","style":2,"log_type":1,"src_id":110101046,"trial_step":46,"drawing":1010101},{"step":53,"content":"这桩案件的证据非常充分，目击者证词、物证甚至被害人家中的摄像记录无不指向一个事实——迪蒙就是凶手。","style":3,"log_type":1,"src_id":110101047,"trial_step":47,"drawing":1010101},{"step":54,"speaker":"迪蒙","content":"没错。","voice":["vo_trial_10101_1_48"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101048,"trial_step":48,"drawing":1010102},{"step":55,"content":"迪蒙就这么轻易地承认了。","style":3,"log_type":1,"src_id":110101049,"trial_step":49,"drawing":1010102},{"step":56,"options":["为什么杀他？"],"style":6,"log_type":1,"src_id":110101050,"trial_step":50,"course":3,"drawing":1010102,"choices":[{"text":"为什么杀他？","goto":51}]},{"step":57,"speaker":"迪蒙","content":"这是他欠我的。","voice":["vo_trial_10101_1_51"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101051,"trial_step":51,"drawing":1010102},{"step":58,"content":"为什么折磨他？","style":2,"log_type":1,"src_id":110101052,"trial_step":52,"drawing":1010102},{"step":59,"speaker":"迪蒙","content":"问出下一个猎物的情报。顺便……","voice":["vo_trial_10101_1_53"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101053,"trial_step":53,"drawing":1010102},{"step":60,"speaker":"迪蒙","content":"收点利息。","voice":["vo_trial_10101_1_54"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101054,"trial_step":54,"drawing":1010101},{"step":61,"content":"听起来，迪蒙和这位芬恩副队长有很深的个人恩怨。","style":3,"log_type":1,"src_id":110101055,"trial_step":55,"drawing":1010101},{"step":62,"content":"迪蒙的回答过于爽利，以至于一时间你想不出还能问些什么问题。于是你拿起了下一份文件。","style":3,"log_type":1,"src_id":110101056,"trial_step":56,"drawing":1010101},{"step":63,"content":"市议会议员多尔·杨，105年10月17日尸体于新城的下水道中被发现。","style":2,"log_type":1,"src_id":110101057,"trial_step":57,"drawing":1010101},{"step":64,"content":"致命伤在头部，推测为钝器所致——这是你做的吗？","style":2,"log_type":1,"src_id":110101058,"trial_step":58,"drawing":1010101},{"step":65,"speaker":"迪蒙","content":"是。","voice":["vo_trial_10101_1_59"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101059,"trial_step":59,"drawing":1010101},{"step":66,"content":"迪蒙再次给出了肯定的答案。","style":3,"log_type":1,"src_id":110101060,"trial_step":60,"drawing":1010101},{"step":67,"content":"你那样伤害他，也是为了获取“下一个猎物的情报”吗？","style":2,"log_type":1,"src_id":110101061,"trial_step":61,"drawing":1010101},{"step":68,"speaker":"迪蒙","content":"不。","voice":["vo_trial_10101_1_62"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101062,"trial_step":62,"drawing":1010101},{"step":69,"speaker":"迪蒙","content":"我只是想让他死得尽可能痛苦一点。","voice":["vo_trial_10101_1_63"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101063,"trial_step":63,"drawing":1010102},{"step":70,"content":"阴影覆盖着迪蒙的脸。","style":3,"log_type":1,"src_id":110101064,"trial_step":64,"drawing":1010101},{"step":71,"content":"议会警卫部门负责人<color=#e45515>斯尔提·汉卓德</color>，106年4月7日于新城圣桑大街与人发生冲突时受伤，救护车到达现场时已伤重不治身亡……","style":2,"log_type":1,"src_id":110101065,"trial_step":65,"drawing":1010101},{"step":72,"content":"你没有继续说下去，那双没有温度的眼睛已经给了你答案。","style":3,"log_type":1,"src_id":110101066,"trial_step":66,"drawing":1010101},{"step":73,"content":"接下来的几分钟，你迅速过完了十二桩案件，迪蒙的回答如出一辙。","style":3,"log_type":1,"src_id":110101067,"trial_step":67,"drawing":1010101},{"step":74,"content":"你理解为何市议会如此强硬地要求你交出迪蒙了——十二名死者都是市议会的官员。","style":3,"log_type":1,"src_id":110101068,"trial_step":68,"drawing":1010101},{"step":75,"content":"你做这些的时候没有负罪感吗？","style":2,"log_type":1,"src_id":110101069,"trial_step":69,"drawing":1010101},{"step":76,"speaker":"迪蒙","content":"负罪感？","voice":["vo_trial_10101_1_70"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101070,"trial_step":70,"drawing":1010102},{"step":77,"speaker":"迪蒙","content":"杀些蛆虫罢了。","voice":["vo_trial_10101_1_71"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101071,"trial_step":71,"drawing":1010101},{"step":78,"content":"迪蒙的声音平静而冷漠。","style":3,"log_type":1,"src_id":110101072,"trial_step":72,"drawing":1010101},{"step":79,"content":"直到现在你还没有搞明白他杀人的动机。更无法想象究竟怎样的经历促成了他如今的状态。","style":3,"log_type":1,"src_id":110101073,"trial_step":73,"drawing":1010101},{"step":80,"options":["质问迪蒙的动机"],"style":6,"log_type":1,"src_id":110101074,"trial_step":74,"course":3,"drawing":1010101,"choices":[{"text":"质问迪蒙的动机","goto":75}]},{"step":81,"speaker":"迪蒙","content":"……","voice":["vo_trial_10101_1_75"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101075,"trial_step":75,"drawing":1010101},{"step":82,"speaker":"迪蒙","content":"复仇。","voice":["vo_trial_10101_1_76"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101076,"trial_step":76,"drawing":1010102},{"step":83,"content":"回答的嗓音干涩、沉重、压抑，像是水面下汹涌的暗流。","style":3,"log_type":1,"src_id":110101077,"trial_step":77,"drawing":1010101},{"step":84,"content":"这两个字，他绝对没有说谎。","style":3,"log_type":1,"src_id":110101078,"trial_step":78,"drawing":1010101},{"step":85,"content":"他们做了什么？","style":2,"log_type":1,"src_id":110101079,"trial_step":79,"drawing":1010101},{"step":86,"speaker":"迪蒙","content":"……","style":1,"log_type":1,"src_id":110101080,"trial_step":80,"drawing":1010101},{"step":87,"content":"这一次，迪蒙没有回答你的问题。","style":3,"log_type":1,"src_id":110101081,"trial_step":81,"drawing":1010101},{"step":88,"content":"沉默许久，迪蒙始终没有反应。你只得拿起桌上最后一份文件。","style":3,"log_type":1,"src_id":110101082,"trial_step":82,"drawing":1010101},{"step":89,"content":"市议员<color=#e45515>亚伯·谢尔德</color>，迪蒙犯下诸多案件中的第一起。104年7月6日，迪蒙在众目睽睽之下杀死了他。","style":3,"log_type":1,"src_id":110101083,"trial_step":83,"drawing":1010101},{"step":90,"options":["这个人是你杀的吗？"],"style":6,"log_type":1,"src_id":110101084,"trial_step":84,"course":3,"drawing":1010101,"choices":[{"text":"这个人是你杀的吗？","goto":85}]},{"step":91,"content":"你已经不太期待迪蒙的回答，大概又只是轻描淡写地承认吧。","style":3,"log_type":1,"src_id":110101085,"trial_step":85,"drawing":1010101},{"step":92,"content":"但事实有些不同。当听到你说出“亚伯”这个名字时，他的脸色变得和之前有些不一样了。","style":3,"log_type":1,"src_id":110101086,"trial_step":86,"drawing":1010101},{"step":93,"content":"你突然意识到了什么——亚伯·谢尔德，迪蒙·谢尔德，结合两人的姓氏，额外的情报出现了。","style":3,"log_type":1,"src_id":110101087,"trial_step":87,"drawing":1010101},{"step":94,"content":"测试音效的打断逻辑","style":3,"log_type":1,"src_id":2,"trial_step":88,"course":6,"drawing":1010101},{"step":95,"content":"播放一个长音效，会有个前奏，稍等一会儿。","style":3,"log_type":1,"src_id":2,"trial_step":88,"course":6,"drawing":1010101},{"step":96,"content":"播放相同音效，会继续延续。","style"