{"id":1082,"chapter_id":1,"scene_id":111,"steps":[{"step":1,"speaker":"彼岸医师","content":"呜…………要不是这些禁闭者……","voice":["vo_cgplot_1082001"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":2,"speaker":"彼岸医师","content":"泰德，你居然放任手下沾染狂厄……你……你知道后果吗？！","voice":["vo_cgplot_1082002"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":3,"speaker":"泰德","content":"投靠禁闭者的你有什么资格跟我说大话？","voice":["vo_cgplot_1082003"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":4,"speaker":"泰德","content":"我受够你们为所欲为的日子了……只要能把那些怪物赶出去，只要辛迪加能够回到过去，我什么都可以做。","voice":["vo_cgplot_1082004"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":5,"speaker":"泰德","content":"走吧，局长。走，进去把那个R找出来。","voice":["vo_cgplot_1082005"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":6,"speaker":"彼岸医师","content":"你还敢大言不惭……","voice":["vo_cgplot_1082006"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":7,"content":"他突然挣扎着抓住你的脚腕，冰冷坚硬的义肢让你无法挣脱。","style":3,"background":122,"log_type":1},{"step":8,"speaker":"彼岸医师","content":"布兰德，还有罗拉……我们的外勤队出去救援后就再没回来，发生了什么？","voice":["vo_cgplot_1082008"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":9,"speaker":"彼岸成员","content":"求求你，罗拉她，她很痛苦，求你……","voice":["vo_cgplot_1082009"],"voice_bank":"vo_cgplot_01","style":1,"background":100,"log_type":1},{"step":10,"speaker":"彼岸医师","content":"布兰德医师是去救人的，救你们这些围攻彼岸的人。那个做手术精确到分秒的人，却没有按时回来……","voice":["vo_cgplot_1082010"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":11,"speaker":"彼岸医师","content":"你们把他怎么样了？！！","voice":["vo_cgplot_1082011"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":12,"options":["他是去救人的？","……"],"jump":[13,13],"style":6,"background":122,"log_type":1},{"step":13,"content":"泰德一脚踢开了他，把你拉到一边。","style":3,"background":122,"log_type":1},{"step":14,"speaker":"泰德","content":"发什么愣呢？他们是敌人，局长，别忘了自己的立场。","voice":["vo_cgplot_1082014"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":15,"speaker":"赫卡蒂","content":"局长！后面！","voice":["vo_cgplot_1082015"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":16,"content":"你急转身，从你们来的方向，硝烟中浮现一个摇摇晃晃的身影。","style":3,"background":122,"log_type":1},{"step":17,"content":"——你认得那张脸，和那染血的白衣。","style":3,"background":122,"log_type":1}]}