{"id":1040504,"chapter_id":1040504,"scene_id":1,"steps":[{"step":1,"content":"N.F.113年3月，西区锈火动乱。BR-002复苏时间比预计提前3天，强度高于计算结果。\n\nSHP-13失踪，感应被干扰。","style":14,"background":10000,"log_type":1,"src_id":140504001,"trial_step":1},{"step":2,"content":"异常数据经上庭分析确认，很快明确有地底牧羊人介入，且地底正在寻找进入BR-002的方法。第九机关主力情报人员立刻转为追击地底势力。\n\nSHP-13回收失败并搁置。","style":14,"background":10000,"log_type":1,"src_id":140504002,"trial_step":2},{"step":3,"content":"4月，FAC总司令紧急启动议程，强硬推进西区作战，将主力从新城转移到西区，并启动全城蓝雨计划，城邦财政压力增大。\n\nSHP-13下落不明。","style":14,"background":10000,"log_type":1,"src_id":140504003,"trial_step":3},{"step":4,"content":"N.F.113年6月，BR-002争夺战陷入僵局。与此同时，一项秘密任务在悄然进行。","style":14,"background":10000,"log_type":1,"src_id":140504004,"trial_step":4},{"step":5,"content":"N.F.113年6月21日 下午7：20\n辛迪加 BR-002外围","style":12,"background":50840,"log_type":1,"src_id":140504005,"trial_step":5},{"step":6,"content":"重获新生的黑环笼罩在城市之上，下方的街道中充斥着嘶吼与叫骂，时而又能看到哪位“禁闭者”异能的残光。","style":3,"background":50840,"log_type":1,"src_id":140504006,"trial_step":6},{"step":7,"speaker":"作战队员","content":"情报不会错的，任务目标就在这里，米诺斯的局长就被藏在这里！","voice":["vo_trial_040504_1_1"],"voice_bank":"vo_shalom_trial","style":1,"background":50840,"log_type":1,"src_id":140504007,"trial_step":7},{"step":8,"speaker":"作战队员","content":"这是什么势力的地盘？锈火？黑帮？难道是地底那些——？","voice":["vo_trial_040504_1_2"],"voice_bank":"vo_shalom_trial","style":1,"background":50840,"log_type":1,"src_id":140504008,"trial_step":8},{"step":9,"speaker":"作战队员","content":"不清楚，也不重要。唯一重要的是，今天必须将他回收。","female_content":"不清楚，也不重要。唯一重要的是，今天必须将她回收。","voice":["vo_trial_040504_1_3","vo_trial_040504_1_3f"],"voice_bank":"vo_shalom_trial","style":1,"background":50840,"log_type":1,"src_id":140504009,"trial_step":9},{"step":10,"speaker":"作战队员","content":"有清理人亲临现场，我们不会输的！","voice":["vo_trial_040504_1_4"],"voice_bank":"vo_shalom_trial","style":1,"background":50840,"log_type":1,"src_id":140504010,"trial_step":10},{"step":11,"content":"一道耀眼的白光从黑石英中心闪出，向前，猛然击碎障碍。","style":3,"background":936,"log_type":1,"src_id":140504011,"trial_step":11},{"step":12,"content":"飞石四溅，烟尘弥漫，让人看不清矿道更深处的状况。","style":3,"background":936,"log_type":1,"src_id":140504012,"trial_step":12},{"step":13,"content":"但清理人毫无顾忌，快步向前，向隐秘的深处走去。她的脸色冰冷异常。","style":3,"background":936,"log_type":1,"src_id":140504013,"trial_step":13},{"step":14,"speaker":"黑石英","content":"X，保证你的安全，你并不适合前线，我们明确过风险了。","style":1,"background":936,"log_type":1,"src_id":140504014,"trial_step":14},{"step":15,"speaker":"黑石英","content":"这只是特殊情况的调动，你只需要确定情报下指令即可，不需要承担战斗职责。","style":1,"background":936,"log_type":1,"src_id":140504015,"trial_step":15},{"step":16,"content":"瑟琳没有回答，她当然知道。那激进隐秘的计划数次行走刀尖，能安然落地，自然也会遇到像现在这么凶险的时刻。要不是第九机关起了疑心，迫使上庭秘密转派HUSH接手此次行动，大概很难瞒下去。","style":3,"background":936,"log_type":1,"src_id":140504016,"trial_step":16},{"step":17,"content":"没时间了，不能通过利贝尔，必须靠她自己找到目标。她回忆路上瞥过的破碎情报，在一片狼藉中搜寻掉落的医疗物资，特别是——异方晶。","style":3,"background":936,"log_type":1,"src_id":140504017,"trial_step":17},{"step":18,"content":"——嗖！","style":3,"background":936,"log_type":1,"src_id":140504018,"trial_step":18},{"step":19,"content":"子弹刺破烟幕，射向瑟琳，被黑石英截住。","style":3,"background":936,"log_type":1,"src_id":140504019,"trial_step":19},{"step":20,"speaker":"黑石英","content":"这装备——是<color=#fb9259>锈火</color>？果然还是落在他们手里。","style":1,"background":936,"log_type":1,"src_id":140504020,"trial_step":20},{"step":21,"content":"的确是锈火的弹药，但一路走来，细心点就能察觉并不只如此。这里由更复杂的势力组成，物资、战术、习惯、性情……","style":3,"background":936,"log_type":1,"src_id":140504021,"trial_step":21},{"step":22,"content":"瑟琳心中有人选。","style":3,"background":936,"log_type":1,"src_id":140504022,"trial_step":22},{"step":23,"content":"随着第一声枪响，更多的枪管从暗处显现，战斗部队被拖住了。","style":3,"background":936,"log_type":1,"src_id":140504023,"trial_step":23},{"step":24,"content":"瑟琳却转身消失在枪林弹雨中，她找到了搜寻已久的暗门，进入密道，最终来到一扇封闭的铁门前。","style":3,"background":936,"log_type":1,"src_id":140504024,"trial_step":24},{"step":25,"content":"推开。","style":3,"background":937,"log_type":1,"src_id":140504025,"trial_step":25},{"step":26,"speaker":"黑石英","content":"找到了，你做得很好。","style":1,"background":50841,"log_type":1,"src_id":140504027,"trial_step":27},{"step":27,"speaker":"黑石英","content":"他现在还是可控的状态。HUSH精英很快就来回收，只要他活着就行，在此等候吧。","female_content":"她现在还是可控的状态。HUSH精英很快就来回收，只要她活着就行，在此等候吧。","style":1,"background":50841,"log_type":1,"src_id":140504028,"trial_step":28},{"step":28,"content":"天顶洒落的光将整个空间一分为二。","style":3,"background":50841,"log_type":1,"src_id":140504029,"trial_step":29},{"step":29,"content":"瑟琳没有站进光里，她停在床边，借着黑暗静静端详着笼在光里的人。","style":3,"background":50841,"log_type":1,"src_id":140504030,"trial_step":30},{"step":30,"speaker":"瑟琳","content":"是呢，他很虚弱……","female_content":"是呢，她很虚弱……","voice":["vo_trial_040504_1_31","vo_trial_040504_1_31f"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504031,"trial_step":31},{"step":31,"speaker":"瑟琳","content":"难得的机会，让我做个测试吧。","voice":["vo_trial_040504_1_32"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504032,"trial_step":32},{"step":32,"content":"瑟琳缓步走过去。","style":3,"background":50841,"log_type":1,"src_id":140504033,"trial_step":33},{"step":33,"speaker":"瑟琳","content":"……我来见你了，${PlayerName}。","voice":["vo_trial_040504_1_37"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504034,"trial_step":34},{"step":34,"content":"倾听者的五官罩在顶灯的光晕里，很平静，像只是睡着了，但呼吸微弱得几乎看不见。","style":3,"background":50841,"log_type":1,"src_id":140504035,"trial_step":35},{"step":35,"speaker":"瑟琳","content":"你瘦了，气色好差，白费了管理局半年来的努力，你的副官会心疼的吧。","voice":["vo_trial_040504_1_40"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504036,"trial_step":36},{"step":36,"speaker":"瑟琳","content":"头发变长了，让我想起第一次见你时的模样。","voice":["vo_trial_040504_1_41"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504037,"trial_step":37},{"step":37,"content":"她轻轻抚过${PlayerName}的额头，脸侧。床上人似乎在做梦，眼皮下的眼睛转动，似乎要努力醒来。瑟琳等了一会儿，但对方终究还是被困在梦中。","style":3,"background":50841,"log_type":1,"src_id":140504038,"trial_step":38},{"step":38,"content":"瑟琳轻轻触摸对方的指尖。这次没有布料相隔，两只手同样冰冷。","style":3,"background":50841,"log_type":1,"src_id":140504039,"trial_step":39},{"step":39,"speaker":"瑟琳","content":"都是我做的。","voice":["vo_trial_040504_1_47"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504040,"trial_step":40},{"step":40,"speaker":"瑟琳","content":"黑环也好，暴动也好……你也好，都是被我算计着走到这一步。","voice":["vo_trial_040504_1_48"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504041,"trial_step":41},{"step":41,"speaker":"瑟琳","content":"你听得到吗？一定很恨我吧。","voice":["vo_trial_040504_1_49"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504042,"trial_step":42},{"step":42,"speaker":"瑟琳","content":"……那就回来吧。试试看，我想把你带回来。","voice":["vo_trial_040504_1_50"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504043,"trial_step":43},{"step":43,"content":"瑟琳的声音越来越低，几乎变成一种耳语。","style":3,"background":50841,"log_type":1,"src_id":140504044,"trial_step":44},{"step":44,"speaker":"黑石英","content":"你要标记他吗？","female_content":"你要标记她吗？","style":1,"background":50841,"log_type":1,"src_id":140504045,"trial_step":45},{"step":45,"content":"她的表情晦暗不清。黑暗蠕动着，隐约浮现的光触慢慢攀上床骨，它们围绕在瑟琳身边，似乎也想触摸床上的人。","style":3,"background":50841,"log_type":1,"src_id":140504046,"trial_step":46},{"step":46,"content":"光与暗的界限不再分明，奇异的触须成为整个空间中最明亮的光源，穿透窗户、穿透大开的门，然后越发聚拢，将两人围成一只光茧。","style":3,"background":50841,"log_type":1,"src_id":140504047,"trial_step":47},{"step":47,"speaker":"黑石英","content":"……这次没有枷锁反噬……","style":1,"background":50841,"log_type":1,"src_id":140504048,"trial_step":48},{"step":48,"speaker":"瑟琳","content":"……","style":1,"background":50841,"log_type":1,"src_id":140504049,"trial_step":49},{"step":49,"content":"瑟琳没有回答，也没有放开，紧握着病床上的人的手，专注地注视着他，像被什么蛊惑了一般。","female_content":"瑟琳没有回答，也没有放开，紧握着病床上的人的手，专注地注视着她，像被什么蛊惑了一般。","style":3,"background":50841,"log_type":1,"src_id":140504050,"trial_step":50},{"step":50,"content":"与此同时，浓厚的污染从${PlayerName}身上冒出，瞬间捕住那只光触，将其吞噬殆尽。","style":3,"background":50841,"log_type":1,"src_id":140504051,"trial_step":51},{"step":51,"speaker":"黑石英","content":"清理人！避开，是02骸的狂厄！","style":1,"background":50841,"log_type":1,"src_id":140504052,"trial_step":52},{"step":52,"content":"蓝光瞬间穿透瑟琳的身体，与此同时，一道电流声从敞开的门外响起。","style":3,"background":50841,"log_type":1,"src_id":140504053,"trial_step":53},{"step":53,"speaker":"黑石英","content":"警戒！","style":1,"background":50841,"log_type":1,"src_id":140504055,"trial_step":55},{"step":54,"content":"铛——！在石英展开之前，密集的电流就将它彻底封死，随即被冲撞着击飞出窗户。","style":3,"background":50841,"log_type":1,"src_id":140504056,"trial_step":56},{"step":55,"content":"<i>——终于来了。</i>","style":3,"background":50841,"log_type":1,"src_id":140504057,"trial_step":57},{"step":56,"content":"瑟琳这才松开${PlayerName}的手，直起身。蓝光从她身上消失，只留下些许灼烫的印痕，她并不在意，平淡得就像刚刚全是演技一般。","style":3,"background":50841,"log_type":1,"src_id":140504058,"trial_step":58},{"step":57,"content":"她转头看向中断自己演出的观众，他显然是看到光芒才赶来的，反应不错，瑟琳露出满意的笑容。","style":3,"background":50841,"log_type":1,"src_id":140504059,"trial_step":59},{"step":58,"content":"穿着斗篷的男人单枪匹马闯进地下室，他极度紧张，全身肌肉紧绷，电流附着在他的武器上，直至瑟琳。","style":3,"background":50841,"log_type":1,"src_id":140504060,"trial_step":60},{"step":59,"speaker":"？？","content":"……滚远点，别用你那一套碰他。","female_content":"……滚远点，别用你那一套碰她。","voice":["vo_trial_040504_1_63"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504061,"trial_step":61},{"step":60,"speaker":"唐","content":"——唔！","voice":["vo_trial_040504_1_67"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504062,"trial_step":62},{"step":61,"content":"电光被无形的威压击散，最后一点异能倔强地刺向瑟琳，却不得不消散在空气中。唐被看不见的桎梏压制，手中的武器哐当落地。","style":3,"background":50841,"log_type":1,"src_id":140504063,"trial_step":63},{"step":62,"speaker":"瑟琳","content":"这么害怕，你该趁先手杀了我的。","voice":["vo_trial_040504_1_68"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504064,"trial_step":64},{"step":63,"speaker":"瑟琳","content":"<color=#fb9259>9年</color>没用能力了吧，瞧你忍得多辛苦。其实，只要收起敌意，对我友善点，就不怕被我控制了。","voice":["vo_trial_040504_1_69"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504065,"trial_step":65},{"step":64,"speaker":"瑟琳","content":"你能活蹦乱跳到今天，也有我一份功劳，不是吗？","voice":["vo_trial_040504_1_70"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504066,"trial_step":66},{"step":65,"content":"她看向被压制在地的男人。","style":3,"background":50841,"log_type":1,"src_id":140504067,"trial_step":67},{"step":66,"speaker":"瑟琳","content":"好久不见，<color=#fb9259>里湾代表</color>。或者说……<color=#fb9259>锈火领袖</color>。","voice":["vo_trial_040504_1_71"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504068,"trial_step":68},{"step":67,"content":"她眯眼笑笑。这笑脸瞬间唤醒唐多年前毛骨悚然的记忆，他夸张地刮了刮炸起的鸡皮疙瘩。","style":3,"background":50841,"log_type":1,"src_id":140504069,"trial_step":69},{"step":68,"speaker":"唐","content":"不不不还是永远不见的好。姐姐能回去不？俺这小破庙装不下您这——","voice":["vo_trial_040504_1_73"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504070,"trial_step":70},{"step":69,"speaker":"唐","content":"妖魔鬼怪！","voice":["vo_trial_040504_1_74"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504071,"trial_step":71},{"step":70,"content":"现在可不是叙旧的时候，他一握拳，电弧再次跃动，一旁的铁盆飞向瑟琳。她一歪头，眼中三角闪烁，唐闷哼一声像被重物猛砸般扣死在地面。","style":3,"background":50841,"log_type":1,"src_id":140504072,"trial_step":72},{"step":71,"content":"与此同时，一声枪响，窗户另半边玻璃碎裂，一颗子弹直接射穿瑟琳的咽喉。瑟琳没有任何抵抗能力，她向前跌落在地。","style":3,"background":50841,"log_type":1,"src_id":140504073,"trial_step":73},{"step":72,"content":"狙击手的位置几乎瞬间被蓝色光雨爆破，唐挣脱着奔向病床，横抱起床上虚弱的人转身要跑。这时他心底突然响起一个声音。","style":3,"background":50841,"log_type":1,"src_id":140504074,"trial_step":74},{"step":73,"speaker":"？？","content":"逃吧……带着他尽力逃亡，再被找到，就是结束了。","female_content":"逃吧……带着她尽力逃亡，再被找到，就是结束了。","voice":["vo_trial_040504_1_78","vo_trial_040504_1_78f"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504075,"trial_step":75},{"step":74,"speaker":"唐","content":"……你……","voice":["vo_trial_040504_1_79"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504076,"trial_step":76},{"step":75,"content":"他还想说什么，但也立刻提醒自己，现在并不是可以迟疑的时刻。","style":3,"background":50841,"log_type":1,"src_id":140504077,"trial_step":77},{"step":76,"speaker":"唐","content":"咦～～～～鸡皮疙瘩，有鬼啊——！！","voice":["vo_trial_040504_1_80"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504078,"trial_step":78},{"step":77,"content":"他带着人一溜烟逃跑了。很快，黑石英再次闯入崩坏的病房，它冷静地审视着瑟琳的伤势。","style":3,"background":50841,"log_type":1,"src_id":140504079,"trial_step":79},{"step":78,"speaker":"黑石英","content":"外面看形势很清楚了，这里存在某种空间术式，恐怕与地底有关。","style":1,"background":50841,"log_type":1,"src_id":140504080,"trial_step":80},{"step":79,"speaker":"黑石英","content":"袭击我的、以及狙击你的人都是禁闭者，他们造成的伤势要修复很久。果然不该勉强你上前线。","style":1,"background":50841,"log_type":1,"src_id":140504081,"trial_step":81},{"step":80,"speaker":"黑石英","content":"刚刚的行为很过激，回去后会安排你做检查的。","style":1,"background":50841,"log_type":1,"src_id":140504082,"trial_step":82},{"step":81,"speaker":"黑石英","content":"请更爱惜自己，X，你是优秀的清理人，也容易成为别人的目标。","style":1,"background":50841,"log_type":1,"src_id":140504083,"trial_step":83},{"step":82,"speaker":"黑石英","content":"万一你有被夺走的风险，我将不得不启动紧急程序就地销毁你。我更希望能在使用期限的尽头跟你完满道别。","style":1,"background":50841,"log_type":1,"src_id":140504084,"trial_step":84},{"step":83,"content":"瑟琳笑了，咽喉的伤让她免于开口。伤口在出血，带动体力快速流失。","style":3,"background":50841,"log_type":1,"src_id":140504085,"trial_step":85},{"step":84,"content":"但她赶上了，这次危险安然度过。这以后，那个男人一定会更加慎重，他有这个本领。","style":3,"background":50841,"log_type":1,"src_id":140504086,"trial_step":86},{"step":85,"content":"只是还不够，还需要给他加上更多保险，不能惊动任何人的保险……","female_content":"只是还不够，还需要给她加上更多保险，不能惊动任何人的保险……","style":3,"background":50841,"log_type":1,"src_id":140504087,"trial_step":87},{"step":86,"content":"清理人闭上眼，缓慢地修复自己的身体。短期内大概上不了战场，她难得有时间思考，也休息一下。","style":3,"background":10000,"log_type":1,"src_id":140504088,"trial_step":88},{"step":87,"content":"离期限越近，那些往昔的多余的回忆就越是活跃，她偶尔也想停下来回味一番，姑且称之为——“梦”吧。","style":3,"background":10000,"log_type":1,"src_id":140504089,"trial_step":89},{"step":88,"content":"<i>我为人类的福祉，被变成工具。被剥离欲望，消解冲动，以期成为理性的锚点。</i>","voice":["vo_trial_040504_1_85"],"voice_bank":"vo_shalom_trial","style":3,"background":4196,"log_type":1,"src_id":140504091,"trial_step":91},{"step":89,"content":"<i>我的心被分离，被拘束成异物，背负重重枷锁，送到人类不敢踏足的领域，流放至虚无。它要在最远离现实的深渊里观测狂厄，为人类寻找“正确的解法”。</i>","voice":["vo_trial_040504_1_86"],"voice_bank":"vo_shalom_trial","style":3,"background":4197,"log_type":1,"src_id":140504092,"trial_step":92},{"step":90,"content":"<i>隔着缝隙，我每日看着它痛苦、愤怒、挣扎、哀嚎，看它被扭曲着压迫自己的<color=#fb9259>同类</color>——我内心毫无波动。我没有心可以感受痛苦。</i>","voice":["vo_trial_040504_1_87"],"voice_bank":"vo_shalom_trial","style":3,"background":4197,"log_type":1,"src_id":140504093,"trial_step":93},{"step":91,"content":"<i>……这样的我，还算人类吗？</i>","voice":["vo_trial_040504_1_88"],"voice_bank":"vo_shalom_trial","style":3,"background":10000,"log_type":1,"src_id":140504094,"trial_step":94},{"step":92,"content":"<i>不能吧。</i>","voice":["vo_trial_040504_1_89"],"voice_bank":"vo_shalom_trial","style":3,"background":10000,"log_type":1,"src_id":140504095,"trial_step":95},{"step":93,"content":"<i>我接受理性洗礼，成为人类的工具。直到磨损腐败、不再可靠的那天，新的工具便会诞生，将我替换。我知道这正确而合理。</i>","voice":["vo_trial_040504_1_90"],"voice_bank":"vo_shalom_trial","style":3,"background":4198,"log_type":1,"src_id":140504096,"trial_step":96},{"step":94,"content":"<i>那些朦胧的波动，可能存在的迷茫，都会得到最合理的解释，都会被理性抹杀。</i>","voice":["vo_trial_040504_1_91"],"voice_bank":"vo_shalom_trial","style":3,"background":4198,"log_type":1,"src_id":140504097,"trial_step":97},{"step":95,"content":"<i>理性是他们赠我的铠甲。</i>","voice":["vo_trial_040504_1_93"],"voice_bank":"vo_shalom_trial","style":3,"background":10000,"log_type":1,"src_id":140504101,"trial_step":101},{"step":96,"content":"<i>直到另一个<color=#fb9259>怪物</color>破坏它。</i>","voice":["vo_trial_040504_1_94"],"voice_bank":"vo_shalom_trial","style":3,"background":10000,"log_type":1,"src_id":140504102,"trial_step":102},{"step":97,"content":"副官从拘禁室夺门而出，几乎撞到清理人身上，她浑身颤抖，情绪激动，看到“上级”竟连话都说不出来。","style":3,"background":1025,"log_type":1,"src_id":140504103,"trial_step":103},{"step":98,"content":"清理人默然让开一条路，放夜莺离开，然后换上公事公办的温柔微笑，走进室内，开始执行。","style":3,"background":1025,"log_type":1,"src_id":140504104,"trial_step":104},{"step":99,"voice":["vo_trial_040504_1_96"],"voice_bank":"vo_shalom_trial","style":18,"background":4199,"log_type":1,"src_id":140504105,"trial_step":105},{"step":100,"speaker":"瑟琳","content":"晚上好，我来自清理人部队Hush，你可以叫我瑟琳。","voice":["vo_trial_040504_1_95"],"voice_bank":"vo_shalom_trial","style":1,"background":4199,"log_type":1,"src_id":140504106,"trial_step":106},{"step":101,"speaker":"瑟琳","content":"我将负责消除前置行动给你带来的不良影响，让你更加稳定。放心，这也会减轻你的痛苦。","voice":["vo_trial_040504_1_96"],"voice_bank":"vo_shalom_trial","style":1,"background":4199,"log_type":1,"src_id":140504107,"trial_step":107},{"step":102,"speaker":"瑟琳","content":"你似乎遭遇了很多不幸。让我来吧，我会让你解脱的。","voice":["vo_trial_040504_1_97"],"voice_bank":"vo_shalom_trial","style":1,"background":4200,"log_type":1,"src_id":140504108,"trial_step":108},{"step":103,"speaker":"？？","content":"别碰我！！","voice":["vo_trial_040504_1_99","vo_trial_040504_1_99f"],"voice_bank":"vo_shalom_trial","style":1,"background":16,"log_type":1,"src_id":140504110,"trial_step":110},{"step":104,"speaker":"？？","content":"……我不会放过你们，我会要你们付出代价，不杀了我的话，就等着吧！","voice":["vo_trial_040504_1_101","vo_trial_040504_1_101f"],"voice_bank":"vo_shalom_trial","style":1,"background":16,"log_type":1,"src_id":140504112,"trial_step":112},{"step":105,"speaker":"？？","content":"我绝不原谅，绝不！！","voice":["vo_trial_040504_1_102","vo_trial_040504_1_102f"],"voice_bank":"vo_shalom_trial","style":1,"background":16,"log_type":1,"src_id":140504113,"trial_step":113},{"step":106,"speaker":"黑石英","content":"好久不见，你好像心情不错。","style":1,"background":1031,"log_type":1,"src_id":140504114,"trial_step":114},{"step":107,"content":"瑟琳睁开眼，黑石英漂浮在她面前。","style":3,"background":1031,"log_type":1,"src_id":140504115,"trial_step":115},{"step":108,"speaker":"黑石英","content":"一个月过去了，你的使用期限还剩不到50天。接下来的任务，花园，地底空间术式，入口。风险很高。确定要去吗？","style":1,"background":1031,"log_type":1,"src_id":140504116,"trial_step":116},{"step":109,"speaker":"瑟琳","content":"没关系。工具就该派上用场。","voice":["vo_trial_040504_1_134"],"voice_bank":"vo_shalom_trial","style":1,"background":1031,"log_type":1,"src_id":140504117,"trial_step":117},{"step":110,"speaker":"瑟琳","content":"枷锁失踪，黑环爆发，地底也在行动。上庭需要我。在替补到位之前，我会完成第7任最后的工作。","voice":["vo_trial_040504_1_103"],"voice_bank":"vo_shalom_trial","style":1,"background":1031,"log_type":1,"src_id":140504118,"trial_step":118},{"step":111,"content":"<color=#7683a2><i>一次重伤需要一周时间修复，剩下的时间，恐怕自己又被带去做各种测试了吧。</color></i>","style":3,"background":1031,"log_type":1,"src_id":140504119,"trial_step":119},{"step":112,"content":"<color=#7683a2><i>毕竟有那么一段时间短暂脱离黑石英监控，自己的使用期限也快到了，风险升高，对他们来说是非常正确的判断。</color></i>","style":3,"background":1031,"log_type":1,"src_id":140504120,"trial_step":120},{"step":113,"content":"<color=#7683a2><i>只是，他们查不出来的，病因早就埋下了。当初17轮检查都没能察觉的裂隙，如今她更知道该如何隐藏。</color></i>","style":3,"background":1031,"log_type":1,"src_id":140504121,"trial_step":121},{"step":114,"content":"<color=#7683a2><i>直至藏到被销毁的那天。</color></i>","style":3,"background":1031,"log_type":1,"src_id":140504122,"trial_step":122},{"step":115,"content":"<i>我不会忘的，${PlayerName}，是你在这具空壳上凿出了裂痕。</i>","voice":["vo_trial_040504_1_104"],"voice_bank":"vo_shalom_trial","style":3,"background":2123,"log_type":1,"src_id":140504123,"trial_step":123},{"step":116,"content":"<i>我第一次感到疼痛、震惊和恐惧。此后，裂痕越来越大，我的思考不再纯粹，看着被钉死的“心”，我没有仇恨。</i>","voice":["vo_trial_040504_1_105"],"voice_bank":"vo_shalom_trial","style":3,"background":2123,"log_type":1,"src_id":140504124,"trial_step":124},{"step":117,"content":"<i>只有质疑。</i>","voice":["vo_trial_040504_1_106"],"voice_bank":"vo_shalom_trial","style":3,"background":2123,"log_type":1,"src_id":140504125,"trial_step":125},{"step":118,"content":"　　　　　　　　 <size=38>X </size>　　　　<size=50>控制风险</size>　　　<size=52>指令</size> <size=50>必要牺牲</size>\n　　　　　　　　 别无选择 <size=38>一切为了对抗<color=#fb9259><size=52>狂厄</color></size>\n　　　　　　　　<size=52>理性<size=52>即是正确</size>　<size=52>地底<size=52>皆为敌人\n　　　 <size=42>动手 　　<size=48>动手</size> 　　<size=54>动手</size>　　<size=60>动手</size>\n\n　　　　　　　　　　　 你做得很好","style":14,"background":942,"log_type":1,"src_id":140504126,"trial_step":126},{"step":119,"content":"<i>怯懦被粉饰成慎重，冷漠被修辞成理智，残忍成了决绝，顽固变作执着。那些自称正确的人不敢直面命运，就只会把他人押做代价……</i>","voice":["vo_trial_040504_1_107"],"voice_bank":"vo_shalom_trial","style":3,"background":2123,"log_type":1,"src_id":140504127,"trial_step":127},{"step":120,"content":"<i>——我的感情，竟然是被这样的懦夫扼杀？</i>","voice":["vo_trial_040504_1_108"],"voice_bank":"vo_shalom_trial","style":3,"background":2123,"log_type":1,"src_id":140504128,"trial_step":128},{"step":121,"content":"<i>看，工具，就是在这一刻，坏掉了。</i>","voice":["vo_trial_040504_1_110"],"voice_bank":"vo_shalom_trial","style":3,"background":2123,"log_type":1,"src_id":140504129,"trial_step":129},{"step":122,"content":"<i>长此以往，观测将不再准确，狂厄会渗透裂隙，我将污染HUSH系统，违背初衷，成为人类福祉的威胁。</i>","voice":["vo_trial_040504_1_111"],"voice_bank":"vo_shalom_trial","style":3,"background":2123,"log_type":1,"src_id":140504130,"trial_step":130},{"step":123,"content":"<i>可我已经被改造成工具了。</i>","voice":["vo_trial_040504_1_112"],"voice_bank":"vo_shalom_trial","style":3,"background":2123,"log_type":1,"src_id":140504131,"trial_step":131},{"step":124,"content":"<i>我早不被视为人了。</i>","voice":["vo_trial_040504_1_113"],"voice_bank":"vo_shalom_trial","style":3,"background":2123,"log_type":1,"src_id":140504132,"trial_step":132},{"step":125,"content":"<i>还需要把人类的福祉放在第一位吗？</i>","voice":["vo_trial_040504_1_114"],"voice_bank":"vo_shalom_trial","style":3,"background":2123,"log_type":1,"src_id":140504133,"trial_step":133},{"step":126,"content":"<i>是不是……也不用了。</i>","voice":["vo_trial_040504_1_115"],"voice_bank":"vo_shalom_trial","style":3,"background":10000,"log_type":1,"src_id":140504134,"trial_step":134},{"step":127,"content":"<i>呵呵，开玩笑的，我喜欢人类。透过他们，我才能看见……早已死去的自己。</i>","voice":["vo_trial_040504_1_116"],"voice_bank":"vo_shalom_trial","style":3,"background":10000,"log_type":1,"src_id":140504136,"trial_step":136},{"step":128,"speaker":"赫卡蒂","content":"你……","voice":["vo_trial_040502_1_62"],"voice_bank":"vo_shalom_trial","style":1,"background":1029,"log_type":1,"src_id":140504137,"trial_step":137},{"step":129,"speaker":"塔兰","content":"去死吧——！！","voice":["vo_trial_040504_1_64"],"voice_bank":"vo_shalom_trial","style":1,"background":932,"log_type":1,"src_id":140504138,"trial_step":138},{"step":130,"speaker":"？？","content":"……滚远点，别用你那一套碰他。","female_content":"……滚远点。别用你那一套碰她。","voice":["vo_trial_040504_1_63"],"voice_bank":"vo_shalom_trial","style":1,"background":50841,"log_type":1,"src_id":140504139,"trial_step":139},{"step":131,"speaker":"克里斯蒂娜","content":"瑟琳姐姐～！你回来了！","voice":["vo_trial_040504_1_117"],"voice_bank":"vo_shalom_trial","style":1,"background":10006,"log_type":1,"src_id":140504142,"trial_step":142},{"step":132,"content":"完美的铠甲被破坏，过去所有朦胧的感情不再被一次次磨平，不再被“理性”杀死。","style":3,"background":10002,"log_type":1,"src_id":140504143,"trial_step":143},{"step":133,"content":"它们终于得到承认，有了名字，被 HUSH-X 小心拥入怀中，成为瑟琳的新生。","style":3,"background":10002,"log_type":1,"src_id":140504144,"trial_step":144},{"step":134,"content":"<i>谢谢你弄坏我，${PlayerName}。从被你破坏的裂隙中扭曲诞生的一切，我都无比珍惜。</i>","voice":["vo_trial_040504_1_120_01"],"voice_bank":"vo_shalom_trial","style":3,"background":10002,"log_type":1,"src_id":140504145,"trial_step":145},{"step":135,"content":"<i>快感也好，欲望也好，喜怒哀乐，牵绊深情——这一年间，我在裂痕中感受到的，比过去8年在意识深海中目睹的还要丰厚。</i>","voice":["vo_trial_040504_1_121"],"voice_bank":"vo_shalom_trial","style":3,"background":10002,"log_type":1,"src_id":140504146,"trial_step":146},{"step":136,"content":"<i>这就是复苏的心吧？</i>","voice":["vo_trial_040504_1_122"],"voice_bank":"vo_shalom_trial","style":3,"background":10002,"log_type":1,"src_id":140504147,"trial_step":147},{"step":137,"content":"她闭上眼，抬手敲了敲黑石英，这次带着笑接受对方毫无意义的一级审查。","style":3,"background":1031,"log_type":1,"src_id":140504148,"trial_step":148},{"step":138,"content":"<i>那只撕裂我的野兽，我已经斩断他的镣铐，把他送离上庭掌控。</i>","female_content":"<i>那只撕裂我的野兽，我已经斩断她的镣铐，把她送离上庭掌控。</i>","voice":["vo_trial_040504_1_123","vo_trial_040504_1_123f"],"voice_bank":"vo_shalom_trial","style":3,"background":1031,"log_type":1,"src_id":140504149,"trial_step":149},{"step":139,"content":"<i>等他醒来的那天……是否会变回曾经的<color=#fb9259>那个人</color>，再向你们露出獠牙？</i>","female_content":"<i>等她醒来的那天……是否会变回曾经的那个人，再向你们露出獠牙？</i>","voice":["vo_trial_040504_1_124","vo_trial_040504_1_124f"],"voice_bank":"vo_shalom_trial","style":3,"background":1031,"log_type":1,"src_id":140504150,"trial_step":150},{"step":140,"speaker":"${PlayerName}","content":"我的立场不会变。我想守住自己的现在，发自本心。我也不认为现在的我有什么要被过去的自己讨厌。","style":1,"background":2123,"log_type":1,"src_id":140504151,"trial_step":151},{"step":141,"content":"<i>呵呵，也对……我们失去的都已无可挽回，但也一定重获新生。</i>","voice":["vo_trial_040504_1_126"],"voice_bank":"vo_shalom_trial","style":3,"background":1031,"log_type":1,"src_id":140504152,"trial_step":152},{"step":142,"content":"一个足以突破HUSH技术封锁悄然破坏清理人还不被察觉的“残次品”，体内必然有跟她经手的所有SHP不一样的东西。","style":3,"background":10002,"log_type":1,"src_id":140504153,"trial_step":153},{"step":143,"content":"一个被清洗了记忆、不断吸收狂厄，却还能安然拥抱人性的“造物”，当然值得认真研究他身上应对灾难的新可能。","female_content":"一个被清洗了记忆、不断吸收狂厄，却还能安然拥抱人性的“造物”，当然值得认真研究她身上应对灾难的新可能。","style":3,"background":10002,"log_type":1,"src_id":140504154,"trial_step":154},{"step":144,"content":"一个比所有“正确规则”更敢于直面命运战斗到底的<color=#fb9259>人</color>，或许能期待他在夹缝中走出一条不一样的路。","female_content":"一个比所有“正确规则”更敢于直面命运战斗到底的<color=#fb9259>人</color>，或许能期待她在夹缝中走出一条不一样的路。","style":3,"background":10002,"log_type":1,"src_id":140504155,"trial_step":155},{"step":145,"content":"上庭没有勇气面对，那就让清理人来清除障碍吧，她已经做到了。","style":3,"background":10002,"log_type":1,"src_id":140504156,"trial_step":156},{"step":146,"content":"<i>就像他给了我自由，如今我把自由还给你，你一度失去的力量，我也送到你手中。</i>","female_content":"<i>就像她给了我自由，如今我把自由还给你，你一度失去的力量，我也送到你手中。</i>","voice":["vo_trial_040504_1_127","vo_trial_040504_1_127f"],"voice_bank":"vo_shalom_trial","style":3,"background":10002,"log_type":1,"src_id":140504157,"trial_step":157},{"step":147,"content":"<i>曾经破坏过我的怪物，以后，也一定能破坏这愚蠢的一切吧。</i>","voice":["vo_trial_040504_1_128"],"voice_bank":"vo_shalom_trial","style":3,"background":10002,"log_type":1,"src_id":140504158,"trial_step":158},{"step":148,"speaker":"瑟琳","content":"<i>你不会辜负我期待的，对吧？</i>","voice":["vo_trial_040504_1_129"],"voice_bank":"vo_shalom_trial","style":3,"background":10002,"log_type":1,"src_id":140504159,"trial_step":159},{"step":149,"speaker":"瑟琳","content":"<i>只可惜，我大概要错过这么精彩的战斗了。</i>","voice":["vo_trial_040504_1_130"],"voice_bank":"vo_shalom_trial","style":3,"background":10002,"log_type":1,"src_id":140504160,"trial_step":160},{"step":150,"content":"N.F. 113年7月19日 新城01区 \n\n埃丽卡山庄","style":12,"background":2095,"log_type":1,"src_id":140504161,"trial_step":161},{"step":151,"content":"瑟琳走出车门，蓝雨两天后才降下，今夜还能看到月光。","style":3,"background":2095,"log_type":1,"src_id":140504162,"trial_step":162},{"step":152,"content":"时间刚刚好，这颗心多一分也许困于自怜，少一分也许安于现状。现在的她刚好够下决定，付诸行动。","style":3,"background":2095,"log_type":1,"src_id":140504163,"trial_step":163},{"step":153,"content":"<i>接下来，是我的死局。祝福我找到正解吧。</i>","voice":["vo_trial_040504_1_131"],"voice_bank":"vo_shalom_trial","style":3,"background":2095,"log_type":1,"src_id":140504164,"trial_step":164},{"step":154,"content":"她笑着，缓步走向那个伪装成洋房的陷阱，维持着她一贯的思考。","style":3,"background":2095,"log_type":1,"src_id":140504165,"trial_step":165},{"step":155,"content":"　　　　　　<size=40>FAC意志坚定</size>　　　<size=50>封锁行动</size>一定会落地\n　　　　　　　　　大概会在<size=40>8月</size>　侧面协助他们获得信任\n　　　　<size=40>这也是<size=40>掩护<size=40>　真正的计划需要<size=40>掩护</size>\n　　　<size=40>但不能让他们触及<size=40>${PlayerName}<size=40>　　第九机关　　MBCC同样不行\n　<size=40>避开上庭<size=40>　　用点手段　　交给<size=40>HUSH　　<size=40>我可以控制他们\n　　　　要适应那个人的能力<size=40>他有能力<size=40>想必有我触及不到的力量\n　　　　　　　　　最后的时间　　还能给他输送多少东西　　　　","style":14,"background":2095,"log_type":1,"src_id":140504166,"trial_step":166},{"step":156,"content":"　　　　　　　　　　<size=56><color=#fb9259>花园</color><size=40>是首选　　<size=40>地底的利刃<size=40>\n　　　　　　　　到目前为止只有这点小动作　　存在<size=40>被胁迫<size=40>的可能<size=40>\n　　<size=50>验证<size=36>然后<size=50>利用<size=36>\n　　情报有限|需要实际确认，最好<size=40>当面<size=36>……怎么做？\n手段？能否引诱她来？当面确认——<size=40>我会死吗？<size=36>\n　　　　　　　狂厄级存在上限，只靠她突破不了<size=40>黑石英","style":14,"background":2095,"log_type":1,"src_id":140504167,"trial_step":167},{"step":157,"content":"思考可以找到正解，但我还能思考多久？\n花园可以杀死我，黑石英可以杀死我，地底可以杀死我\n就算活下来，再被重伤一次，按修复的效率，恐怕一切也都赶不上了\n我没有保护自己的能力，行事要更谨慎些，争取时间，就是争取效率和成果\n还需要给死后做一些安排，不能没有交代地离开……","style":14,"background":2095,"log_type":1,"src_id":140504168,"trial_step":168},{"step":158,"content":"能有几个方案，还有谁可以信任，现在的我还能走几步\n还有什么空隙可以利用，我该关注什么，他们还会关注什么，该怎么绕开监视","style":14,"background":2095,"log_type":1,"src_id":140504169,"trial_step":169},{"step":159,"content":"一个人还真是如履薄冰，计划成功率不到1%。","style":14,"background":2095,"log_type":1,"src_id":140504170,"trial_step":170},{"step":160,"content":"但，没关系。命运不是敌人，人心始终流动，<color=#fb9259>X</color>的理性会直视一切抓住每一个变数寻找解法。","style":14,"background":2095,"log_type":1,"src_id":140504171,"trial_step":171},{"step":161,"content":"何况在她开始这般计算时，无论结果如何……<color=#fb9259>瑟琳</color>已经成功了。","style":14,"background":2095,"log_type":1,"src_id":140504172,"trial_step":172},{"step":162,"content":"被他们夺走的心已经复苏，每一分每一秒都在蓬勃生长，而那些人毫无察觉。","style":14,"background":2095,"log_type":1,"src_id":140504173,"trial_step":173},{"step":163,"content":"月光洒落在瑟琳身上，也平等地照亮在每一个即将交汇彼此改变的命运。","style":3,"background":2095,"log_type":1,"src_id":140504174,"trial_step":174},{"step":164,"content":"3个月没听到那熟悉的专属铃声了，少女侦探原地打转地纠结要不要给最喜欢的瑟琳姐姐打个电话，还是等暑假实习申请一敲定就跑去找她。","style":3,"background":1041,"log_type":1,"src_id":140504175,"trial_step":175},{"step":165,"content":"同一时刻，虞美人摆脱了纠缠她的HUSH部队，终于回到花园，却发现少了紫色的康乃馨已经被人偷走。她暴怒地斩碎屏风，拿起花剑，下定早该定下的决心。","style":3,"background":2116,"log_type":1,"src_id":140504176,"trial_step":176},{"step":166,"content":"黑衣护卫一步步走进暗夜，哪怕噩梦缠身，哪怕前路无归，她也已下定决心走到尽头。","style":3,"background":2102,"log_type":1,"src_id":140504177,"trial_step":177},{"step":167,"content":"清理人还看不到这些汇聚至此的细流，但她看到刀光划开冷冽月光向她袭来，她知道这就是开端。","style":3,"background":2095,"log_type":1,"src_id":140504178,"trial_step":178},{"step":168,"speaker":"加洛法诺","content":"要恨，就恨你生在上庭吧！","voice":["vo_trial_040504_1_118"],"voice_bank":"vo_shalom_trial","style":1,"background":2095,"log_type":1,"src_id":140504179,"trial_step":179},{"step":169,"content":"这并非致命攻击，黑石英按计划没有出手。瑟琳只被刺透了右肩胛，顺势倒下。","style":3,"background":2095,"log_type":1,"src_id":140504180,"trial_step":180},{"step":170,"content":"乱战拉开序幕，急流暗涌，此时她眼里却只看到纷落的花瓣缓缓飘落在自己的血泊中，想着——","style":3,"background":2095,"log_type":1,"src_id":140504181,"trial_step":181},{"step":171,"content":"<i>……真好，这里也有花开。<i>","style":3,"background":2095,"log_type":1,"src_id":140504182,"trial_step":182},{"step":172,"content":"<i>命途严酷，祝福你我……</i>","voice":["vo_trial_040504_1_132"],"voice_bank":"vo_shalom_trial","style":3,"background":10000,"log_type":1,"src_id":140504183,"trial_step":183},{"step":173,"content":"<i>终得自由。</i>","voice":["vo_trial_040504_1_133"],"voice_bank":"vo_shalom_trial","style":3,"background":10000,"log_type":1,"src_id":140504184,"trial_step":184}]}