{"id":1020504,"chapter_id":1020504,"scene_id":1,"steps":[{"step":1,"content":"你又做梦了。","style":3,"background":10000,"log_type":1,"src_id":120504001,"trial_step":1},{"step":2,"content":"梦里还是一片烟雾朦胧，那一方熟悉的热源就在你的身边，静静地停留。","style":3,"background":10000,"log_type":1,"src_id":120504002,"trial_step":2},{"step":3,"content":"你伸出手，触碰边缘，顿时光芒万丈，驱散了周围的雾。","style":3,"background":10006,"log_type":1,"src_id":120504003,"trial_step":3},{"step":4,"speaker":"选项","options":["好温暖"],"style":6,"background":10006,"log_type":1,"src_id":120504004,"trial_step":4,"course":3,"choices":[{"text":"好温暖","goto":5}]},{"step":5,"speaker":"？？？","content":"呵呵……那就记住，这就是太阳的温度。","voice":["vo_trial_20504_1_5"],"voice_bank":"vo_yao_trial","style":1,"background":10006,"log_type":1,"src_id":120504005,"trial_step":5},{"step":6,"speaker":"？？？","content":"每当这个温度的阳光照耀的时候，就该苏醒了。","voice":["vo_trial_20504_1_6"],"voice_bank":"vo_yao_trial","style":1,"background":10006,"log_type":1,"src_id":120504006,"trial_step":6},{"step":7,"speaker":"？？？","content":"所有的生物，都会在这个时候……醒过来。","voice":["vo_trial_20504_1_7"],"voice_bank":"vo_yao_trial","style":1,"background":10006,"log_type":1,"src_id":120504007,"trial_step":7},{"step":8,"content":"你艰难地睁开眼，想要寻找在说话的声音。","style":3,"background":1014,"log_type":1,"src_id":120504008,"trial_step":8},{"step":9,"content":"朦胧之间，那股热源朝你靠近，你感受到额头上像是被羽毛拂过一般。","style":3,"background":1014,"log_type":1,"src_id":120504009,"trial_step":9},{"step":10,"speaker":"选项","options":["曜……？"],"style":6,"background":1014,"log_type":1,"src_id":120504010,"trial_step":10,"course":3,"choices":[{"text":"曜……？","goto":11}]},{"step":11,"speaker":"曜","content":"你还记得我呀？","voice":["vo_trial_20504_1_11"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504011,"trial_step":11},{"step":12,"content":"映入眼帘的是熟悉的笑脸，曜像以前一样，趴在床头，由上往下地看着你。","style":3,"background":1014,"log_type":1,"src_id":120504012,"trial_step":12},{"step":13,"content":"她身旁的羽毛垂落在你脸上，散发着温暖。","style":3,"background":1014,"log_type":1,"src_id":120504013,"trial_step":13},{"step":14,"speaker":"${PlayerName}","content":"好久不见……","style":2,"background":1014,"log_type":1,"src_id":120504014,"trial_step":14},{"step":15,"speaker":"曜","content":"是挺久了，你受伤太严重，躺了三年了。","voice":["vo_trial_20504_1_15"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504015,"trial_step":15},{"step":16,"speaker":"曜","content":"你看，我头发都变长了。","voice":["vo_trial_20504_1_16"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504016,"trial_step":16},{"step":17,"speaker":"${PlayerName}","content":"……","style":2,"background":1014,"log_type":1,"src_id":120504017,"trial_step":17},{"step":18,"speaker":"${PlayerName}","content":"其实你知不知道，我书桌上的电子屏，是会显示时间的。","style":2,"background":1014,"log_type":1,"src_id":120504018,"trial_step":18},{"step":19,"speaker":"${PlayerName}","content":"我应该只昏迷了三天。","style":2,"background":1014,"log_type":1,"src_id":120504019,"trial_step":19},{"step":20,"content":"曜转过头去看了一眼，你听到她小小地“啧”了一声。","style":3,"background":1014,"log_type":1,"src_id":120504020,"trial_step":20},{"step":21,"speaker":"曜","content":"东方有句古话，不知道你听过没有。","voice":["vo_trial_20504_1_21"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504021,"trial_step":21},{"step":22,"speaker":"曜","content":"叫做“一日不见如隔三秋”，所以，就当我三年没见过你了也未尝不可吧？","voice":["vo_trial_20504_1_22"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504022,"trial_step":22},{"step":23,"content":"你撑起身来，靠着床头坐着。","style":3,"background":1014,"log_type":1,"src_id":120504023,"trial_step":23},{"step":24,"content":"曜从旁边倒来一杯水递给你，咂摸出来一点味道。","style":3,"background":1014,"log_type":1,"src_id":120504024,"trial_step":24},{"step":25,"speaker":"${PlayerName}","content":"你一直在这里等着我醒来？","style":2,"background":1014,"log_type":1,"src_id":120504025,"trial_step":25},{"step":26,"speaker":"？？？","content":"是呀，曜姐姐这几天可是几乎寸步不离呢~","voice":["vo_trial_20504_1_26"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504026,"trial_step":26},{"step":27,"content":"门口，小文抱着一叠文件走了进来，砰地一声放在了你的床边。","style":3,"background":1014,"log_type":1,"src_id":120504027,"trial_step":27},{"step":28,"speaker":"小文","content":"嘿嘿，抱歉啊~领导说了，只要您醒了，就得让您立刻把这些文件都给签了。","voice":["vo_trial_20504_1_28"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504028,"trial_step":28},{"step":29,"speaker":"小文","content":"虽然我和夜莺前辈已经抗议了好几次了——但他们说这些文件事关天灾，必须能多快就多快。","voice":["vo_trial_20504_1_29"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504029,"trial_step":29},{"step":30,"content":"小文朝你和曜抱歉地笑了笑。","style":3,"background":1014,"log_type":1,"src_id":120504030,"trial_step":30},{"step":31,"speaker":"小文","content":"曜姐姐都已经控制住了金乌使徒，变回了巫祭姐姐，为什么还要这么急啊？","voice":["vo_trial_20504_1_31"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504031,"trial_step":31},{"step":32,"speaker":"小文","content":"不懂……","voice":["vo_trial_20504_1_32"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504032,"trial_step":32},{"step":33,"speaker":"曜","content":"毕竟和天灾有关，大家都只是想要快些解决问题。","voice":["vo_trial_20504_1_33"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504033,"trial_step":33},{"step":34,"speaker":"曜","content":"而且……我想起来的事情还不多，还不是大家心里的那个巫祭呢。","voice":["vo_trial_20504_1_34"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504034,"trial_step":34},{"step":35,"speaker":"小文","content":"真的吗？那……在你想起来的事情里，你能请神上身是真的吗？","voice":["vo_trial_20504_1_35"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504035,"trial_step":35},{"step":36,"speaker":"曜","content":"哦~这个呀，是的哦，是真的。","voice":["vo_trial_20504_1_36"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504036,"trial_step":36},{"step":37,"speaker":"曜","content":"我曾经为了让人离家逃难，找到了他祖宗的祖宗，让这位大人亲口劝了他离家逃难呢。","voice":["vo_trial_20504_1_37"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504037,"trial_step":37},{"step":38,"speaker":"小文","content":"哇！！好厉害啊！！","voice":["vo_trial_20504_1_38"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504038,"trial_step":38},{"step":39,"speaker":"小文","content":"对了对了！他们还说，巫祭姐姐读过很多书，见过很多人，对世间万物都有自己不一样的领悟和感受，还能和这世界万物通灵对话！","voice":["vo_trial_20504_1_39"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504039,"trial_step":39},{"step":40,"speaker":"小文","content":"这也是真的吗？","voice":["vo_trial_20504_1_40"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504040,"trial_step":40},{"step":41,"content":"小文蹦跶着凑到了曜的眼前，曜轻轻点了一下她的鼻子，微笑着说道。","style":3,"background":1014,"log_type":1,"src_id":120504041,"trial_step":41},{"step":42,"speaker":"曜","content":"这是身为巫祭应当做的事，就像你身为管理局的一员，也知道很多我不知道的事情一样呀。","voice":["vo_trial_20504_1_42"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504042,"trial_step":42},{"step":43,"speaker":"曜","content":"我以后，可能还需要请你来指教我呢。","voice":["vo_trial_20504_1_43"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504043,"trial_step":43},{"step":44,"speaker":"小文","content":"啊啊~~巫祭姐姐你太谦虚啦！！但是如果有什么小文能帮上的，请一定要开口哦！","voice":["vo_trial_20504_1_44"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504044,"trial_step":44},{"step":45,"content":"目送满眼崇拜的小文离开，你一边拿起文件，一边幽幽开口。","style":3,"background":1014,"log_type":1,"src_id":120504045,"trial_step":45},{"step":46,"speaker":"${PlayerName}","content":"巫祭姐姐啊——","style":2,"background":1014,"log_type":1,"src_id":120504046,"trial_step":46},{"step":47,"speaker":"曜","content":"要真论年纪，你说不定真得喊我一声姐姐呢。","voice":["vo_trial_20504_1_47"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504047,"trial_step":47},{"step":48,"speaker":"${PlayerName}","content":"不管你信不信，我有你以前喊我哥哥的视频在终端里。","female_content":"不管你信不信，我有你以前喊我姐姐的视频在终端里。","style":2,"background":1014,"log_type":1,"src_id":120504048,"trial_step":48},{"step":49,"speaker":"曜","content":"不好意思哦，你的终端在砂海被摔碎了呢~","voice":["vo_trial_20504_1_49"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504049,"trial_step":49},{"step":50,"content":"微笑的狄斯狼犬和微笑的东方金乌互相僵持了一会儿，双双破功。","style":3,"background":1014,"log_type":1,"src_id":120504050,"trial_step":50},{"step":51,"speaker":"${PlayerName}","content":"我发现了，传说中的人都很能忽悠人。","style":2,"background":1014,"log_type":1,"src_id":120504051,"trial_step":51},{"step":52,"speaker":"${PlayerName}","content":"人已经走远了，就别端着坐了。","style":2,"background":1014,"log_type":1,"src_id":120504052,"trial_step":52},{"step":53,"speaker":"曜","content":"原来你早就发现了啊。","voice":["vo_trial_20504_1_53"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504053,"trial_step":53},{"step":54,"speaker":"${PlayerName}","content":"你小腿一直在抖，我都感受到了。","style":2,"background":1014,"log_type":1,"src_id":120504054,"trial_step":54},{"step":55,"speaker":"曜","content":"我可是骗过了很多人。让他们相信我是“巫祭”，也能给你少惹些麻烦吧。","voice":["vo_trial_20504_1_55"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504055,"trial_step":55},{"step":56,"content":"曜耸耸肩膀，把椅子挪开，坐到了你身边。","style":3,"background":1014,"log_type":1,"src_id":120504056,"trial_step":56},{"step":57,"content":"金色的羽毛铺在素色的房间中，就像阳光照射进来一样。","style":3,"background":1014,"log_type":1,"src_id":120504057,"trial_step":57},{"step":58,"speaker":"曜","content":"还好，你还是醒来了。","voice":["vo_trial_20504_1_58"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504058,"trial_step":58},{"step":59,"speaker":"曜","content":"我没有酿成大祸。","voice":["vo_trial_20504_1_59"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504059,"trial_step":59},{"step":60,"speaker":"${PlayerName}","content":"你一直选择的都是我们，是我应该早点察觉到才对。","style":2,"background":1014,"log_type":1,"src_id":120504060,"trial_step":60},{"step":61,"speaker":"${PlayerName}","content":"天灾升级，我们不是没有想到，只是不愿意面对罢了。","style":2,"background":1014,"log_type":1,"src_id":120504061,"trial_step":61},{"step":62,"speaker":"${PlayerName}","content":"大家表面上对那些追逐神话的人不屑一顾，但实际上谁又不是那个渴望着神迹的人呢？","style":2,"background":1014,"log_type":1,"src_id":120504062,"trial_step":62},{"step":63,"content":"你翻开最新的一份报告，上面写着砂海中发生的一切。","style":3,"background":1014,"log_type":1,"src_id":120504063,"trial_step":63},{"step":64,"speaker":"曜","content":"灰烬使徒已经再次成长，证明诞生灰烬之潮的狂厄也在愈发强大。","voice":["vo_trial_20504_1_64"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504064,"trial_step":64},{"step":65,"speaker":"曜","content":"我从不愿将自己神化……但我现在庆幸，我再次让神话成真，好好地保护了你。","voice":["vo_trial_20504_1_65"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504065,"trial_step":65},{"step":66,"speaker":"选项","options":["……"],"style":6,"background":1014,"log_type":1,"src_id":120504066,"trial_step":66,"course":3,"choices":[{"text":"……","goto":67}]},{"step":67,"speaker":"${PlayerName}","content":"你再一次让神话成为真的，是在虞渊的时候。","style":2,"background":1014,"log_type":1,"src_id":120504067,"trial_step":67},{"step":68,"speaker":"${PlayerName}","content":"这次的神话，不是你造就的，阿煦。","style":2,"background":1014,"log_type":1,"src_id":120504068,"trial_step":68},{"step":69,"content":"熟悉的名字出现，曜愣了一下，眼神开始游移。","style":3,"background":1014,"log_type":1,"src_id":120504069,"trial_step":69},{"step":70,"speaker":"${PlayerName}","content":"枷锁是无法说谎的，曜。","style":2,"background":1014,"log_type":1,"src_id":120504070,"trial_step":70},{"step":71,"speaker":"${PlayerName}","content":"你可以骗过其他人，让他们以为你的记忆回来了，你成为了巫祭。","style":2,"background":1014,"log_type":1,"src_id":120504071,"trial_step":71},{"step":72,"speaker":"${PlayerName}","content":"但你骗不过我……你也没有必要对我隐瞒。","style":2,"background":1014,"log_type":1,"src_id":120504072,"trial_step":72},{"step":73,"speaker":"${PlayerName}","content":"我从始至终，到现在，依然认为你是<color=#fb9259>曜</color>，你也只要是<color=#fb9259>曜</color>就足够了。","style":2,"background":1014,"log_type":1,"src_id":120504073,"trial_step":73},{"step":74,"content":"曜的头埋得更低了，她缓缓地往前倾去，抵在了你的肩上。","style":3,"background":1014,"log_type":1,"src_id":120504074,"trial_step":74},{"step":75,"speaker":"曜","content":"我装了好几天的……","voice":["vo_trial_20504_1_75"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504075,"trial_step":75},{"step":76,"speaker":"曜","content":"他们都说我很乖，一定是变成人了，变成原来的巫祭了。","voice":["vo_trial_20504_1_76"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504076,"trial_step":76},{"step":77,"speaker":"曜","content":"只有你，一眼就看出来了。","voice":["vo_trial_20504_1_77"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504077,"trial_step":77},{"step":78,"speaker":"${PlayerName}","content":"你是我“养”大的，我当然最清楚。","style":2,"background":1014,"log_type":1,"src_id":120504078,"trial_step":78},{"step":79,"speaker":"曜","content":"那我得努力骗到你一次才行。","voice":["vo_trial_20504_1_79"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504079,"trial_step":79},{"step":80,"content":"曜没有抬起头，你感受到肩头的温度越来越高。","style":3,"background":1014,"log_type":1,"src_id":120504080,"trial_step":80},{"step":81,"speaker":"${PlayerName}","content":"所以，你还是能听到它们的呼唤，是吗？","style":2,"background":1014,"log_type":1,"src_id":120504081,"trial_step":81},{"step":82,"speaker":"曜","content":"……对。","voice":["vo_trial_20504_1_82"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504082,"trial_step":82},{"step":83,"speaker":"曜","content":"我时时刻刻，都能感受到来自天灾的感召。","voice":["vo_trial_20504_1_83"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504083,"trial_step":83},{"step":84,"speaker":"曜","content":"我想飞出这里，我想要进入灰烬之潮。","voice":["vo_trial_20504_1_84"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504084,"trial_step":84},{"step":85,"speaker":"曜","content":"我想要消灭更多的灾厄使徒，这是我的本能，也是我的责任。","voice":["vo_trial_20504_1_85"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504085,"trial_step":85},{"step":86,"speaker":"选项","options":["那就去吧。"],"style":6,"background":1014,"log_type":1,"src_id":120504086,"trial_step":86,"course":3,"choices":[{"text":"那就去吧。","goto":87}]},{"step":87,"speaker":"${PlayerName}","content":"你本就应该属于更广阔的地方。","style":2,"background":1014,"log_type":1,"src_id":120504087,"trial_step":87},{"step":88,"speaker":"${PlayerName}","content":"出现更高级的灰烬使徒，说明狂厄正在强化灰烬之潮。从前的巫祭哪怕自己破碎重生为兽也要回到这个世界来保护人类。","style":2,"background":1014,"log_type":1,"src_id":120504088,"trial_step":88},{"step":89,"speaker":"${PlayerName}","content":"现在她的生命已经迈入下一个阶段，只留这道执念。而诞生自这执念的你，怎么可能会没有这样的渴望呢？","style":2,"background":1014,"log_type":1,"src_id":120504089,"trial_step":89},{"step":90,"speaker":"曜","content":"可是我舍不得。","voice":["vo_trial_20504_1_90"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504090,"trial_step":90},{"step":91,"content":"曜抬起了头，像小孩一样，盯着你不放。","style":3,"background":1014,"log_type":1,"src_id":120504091,"trial_step":91},{"step":92,"speaker":"曜","content":"我不仅舍不得，我还在害怕……","voice":["vo_trial_20504_1_92"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504092,"trial_step":92},{"step":93,"speaker":"曜","content":"你在砂海不管不顾地奔向我，还有昏睡的这几天，让我太害怕了——我怕你就这样不回来了。","voice":["vo_trial_20504_1_93"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504093,"trial_step":93},{"step":94,"speaker":"曜","content":"所以哪怕要留在这个鸟笼里，哪怕要说我不擅长的谎言，装扮成那个样子骗所有人类。","voice":["vo_trial_20504_1_94"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504094,"trial_step":94},{"step":95,"speaker":"曜","content":"我也可以忍受……","voice":["vo_trial_20504_1_95"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504095,"trial_step":95},{"step":96,"content":"你笑笑，伸手摸了摸她的额发，想起了她还是幼年形态时，会钻来你的手心下，蹭着你的手掌，开心地点头。","style":3,"background":1014,"log_type":1,"src_id":120504096,"trial_step":96},{"step":97,"speaker":"${PlayerName}","content":"我又何尝不是舍不得你呢？","style":2,"background":1014,"log_type":1,"src_id":120504097,"trial_step":97},{"step":98,"speaker":"${PlayerName}","content":"可是啊……","style":2,"background":1014,"log_type":1,"src_id":120504098,"trial_step":98},{"step":99,"content":"你将手里的报告递给曜，指着当前的页面给她看。","style":3,"background":1014,"log_type":1,"src_id":120504099,"trial_step":99},{"step":100,"speaker":"${PlayerName}","content":"可这样毕竟还是很憋屈的吧？我看得出来你羽毛都蔫儿了。虽然演巫祭挺好，但这样肯定不开心。","style":2,"background":1014,"log_type":1,"src_id":120504100,"trial_step":100},{"step":101,"speaker":"${PlayerName}","content":"在这里，你要对抗自己的本能，要忍受低语对你的诱惑。而且，在人堆里会很难受吧？","style":2,"background":1014,"log_type":1,"src_id":120504101,"trial_step":101},{"step":102,"speaker":"${PlayerName}","content":"我不愿意看见这样的你，我更希望见到的，是那个在砂海的风暴之中，英勇猎杀使徒，周身被狂野绚烂的火焰包裹着的，如神明一般的人。","style":2,"background":1014,"log_type":1,"src_id":120504102,"trial_step":102},{"step":103,"speaker":"${PlayerName}","content":"别担心。","style":2,"background":1014,"log_type":1,"src_id":120504103,"trial_step":103},{"step":104,"content":"你朝她笑笑。","style":3,"background":1014,"log_type":1,"src_id":120504104,"trial_step":104},{"step":105,"speaker":"${PlayerName}","content":"你不需要有后顾之忧，我不忍心你难过，又怎么会放任自己，让你因为我而难过呢？","style":2,"background":1014,"log_type":1,"src_id":120504105,"trial_step":105},{"step":106,"speaker":"${PlayerName}","content":"所以，你不应该也不需要为了我，缩在这个小小的鸟笼里，成为一只蔫了吧唧的鸟儿。","style":2,"background":1014,"log_type":1,"src_id":120504106,"trial_step":106},{"step":107,"speaker":"曜","content":"你才蔫了吧唧，你才掉毛。","voice":["vo_trial_20504_1_107"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504107,"trial_step":107},{"step":108,"speaker":"${PlayerName}","content":"我好像没说你掉毛吧？","style":2,"background":1014,"log_type":1,"src_id":120504108,"trial_step":108},{"step":109,"speaker":"曜","content":"你的眼神说了。","voice":["vo_trial_20504_1_109"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504109,"trial_step":109},{"step":110,"speaker":"${PlayerName}","content":"……","style":2,"background":1014,"log_type":1,"src_id":120504110,"trial_step":110},{"step":111,"speaker":"${PlayerName}","content":"你的本能就和野兽一样敏锐，这都能察觉到。","style":2,"background":1014,"log_type":1,"src_id":120504111,"trial_step":111},{"step":112,"speaker":"${PlayerName}","content":"所以啊，遵循自己的本能吧，那是自你诞生起就存在的。","style":2,"background":1014,"log_type":1,"src_id":120504112,"trial_step":112},{"step":113,"speaker":"${PlayerName}","content":"然后，飞去更大的，更适合你的世界吧。","style":2,"background":1014,"log_type":1,"src_id":120504113,"trial_step":113},{"step":114,"content":"你像以前那样，给了曜一个拥抱。","style":3,"background":1014,"log_type":1,"src_id":120504114,"trial_step":114},{"step":115,"speaker":"${PlayerName}","content":"但是，你一定要保护好你自己，不要太莽撞，不要太勉强，不然，我不会放心你回到灰烬之潮的。","style":2,"background":1014,"log_type":1,"src_id":120504115,"trial_step":115},{"step":116,"speaker":"曜","content":"你才是，明明你也总是莽撞、勉强自己……","voice":["vo_trial_20504_1_116"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504116,"trial_step":116},{"step":117,"speaker":"曜","content":"我的能力成长了，我能感受到，内海、灾厄的源头和你有关——不然，之前在砂海，它们不会那么精准就感应到你。","voice":["vo_trial_20504_1_117"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504117,"trial_step":117},{"step":118,"speaker":"曜","content":"我们都被赐予了需要自己拼尽全力对抗的命运……我向你保证我不会乱来，我也希望你能在我每次想你的时候，回来就能见到你。","voice":["vo_trial_20504_1_118"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504118,"trial_step":118},{"step":119,"speaker":"${PlayerName}","content":"我答应你。","style":2,"background":1014,"log_type":1,"src_id":120504119,"trial_step":119},{"step":120,"speaker":"选项","options":["要经常回来。"],"style":6,"background":1014,"log_type":1,"src_id":120504120,"trial_step":120,"course":3,"choices":[{"text":"要经常回来。","goto":121}]},{"step":121,"speaker":"${PlayerName}","content":"一定要。","style":2,"background":1014,"log_type":1,"src_id":120504121,"trial_step":121},{"step":122,"speaker":"${PlayerName}","content":"你走了的话，我会很想你的。","style":2,"background":1014,"log_type":1,"src_id":120504122,"trial_step":122},{"step":123,"speaker":"曜","content":"别怕，我一定会的。","voice":["vo_trial_20504_1_123"],"voice_bank":"vo_yao_trial","style":1,"background":1014,"log_type":1,"src_id":120504123,"trial_step":123},{"step":124,"speaker":"工作人员A","content":"嘶，最近咱们的恒温系统是不是坏了？","voice":["vo_trial_20504_1_124"],"voice_bank":"vo_yao_trial","style":1,"background":107,"log_type":1,"src_id":120504124,"trial_step":124},{"step":125,"speaker":"工作人员A","content":"怎么总是隔段时间就变得这么热呢？","voice":["vo_trial_20504_1_125"],"voice_bank":"vo_yao_trial","style":1,"background":107,"log_type":1,"src_id":120504125,"trial_step":125},{"step":126,"speaker":"工作人员B","content":"原来不是我一个人这么觉得啊？我还以为是我最近吃太多炸鸡上火热气喔……","voice":["vo_trial_20504_1_126"],"voice_bank":"vo_yao_trial","style":1,"background":107,"log_type":1,"src_id":120504126,"trial_step":126},{"step":127,"content":"管理局的温度一直都是恒温，为了尽量满足不同的禁闭者与工作人员的需求，才会在不同的地方人工调制不同的温度。","style":3,"background":107,"log_type":1,"src_id":120504127,"trial_step":127},{"step":128,"content":"只不过不知道为什么，最近一段时间，时常会有那么一两天，整个管理局都提升了好几度，让人搞不清该不该穿外套来上班。","style":3,"background":107,"log_type":1,"src_id":120504128,"trial_step":128},{"step":129,"speaker":"工作人员B","content":"哎！局长，有空能帮我们报修一下这个系统吗？","voice":["vo_trial_20504_1_129"],"voice_bank":"vo_yao_trial","style":1,"background":107,"log_type":1,"src_id":120504129,"trial_step":129},{"step":130,"speaker":"${PlayerName}","content":"嘎！\n（是！）","style":2,"background":107,"log_type":1,"src_id":120504130,"trial_step":130},{"step":131,"content":"你满口答应着，转身却无奈地笑了笑。","style":3,"background":107,"log_type":1,"src_id":120504131,"trial_step":131},{"step":132,"content":"房间门口，一簇火花刚刚熄灭，推开门，热浪夹杂着砂海特有的干燥的味道传了过来。","style":3,"background":107,"log_type":1,"src_id":120504132,"trial_step":132},{"step":133,"content":"一个通体包裹着火焰的女性坐在地上，金红色的羽毛闪耀着特别的光芒，让她看上去宛若神明。","style":3,"background":1040,"log_type":1,"src_id":120504133,"trial_step":133},{"step":134,"speaker":"${PlayerName}","content":"打个商量，下次来，能别让管理局的温度提高那么多吗？","style":2,"background":1040,"log_type":1,"src_id":120504134,"trial_step":134},{"step":135,"speaker":"曜","content":"那好像没办法。","voice":["vo_trial_20504_1_135"],"voice_bank":"vo_yao_trial","style":1,"background":1040,"log_type":1,"src_id":120504135,"trial_step":135},{"step":136,"speaker":"曜","content":"只能等哪一天，我没有那么想你的时候吧。","voice":["vo_trial_20504_1_136"],"voice_bank":"vo_yao_trial","style":1,"background":1040,"log_type":1,"src_id":120504136,"trial_step":136}]}