{"id":1040802,"chapter_id":1040802,"scene_id":1,"steps":[{"step":1,"content":"柯琳落网四小时后\n砂海集市 治安署前","style":9,"background":2297,"log_type":1,"src_id":140802001,"trial_step":1},{"step":2,"content":"一群被五花大绑的砂盗躺倒在集会所外的空地上。场面之壮观，每一位路人都忍不住侧目。","style":3,"background":2297,"log_type":1,"src_id":140802002,"trial_step":2},{"step":3,"content":"而你就站在“战利品”的不远处，听着身边的事务员惊叹出声。","style":3,"background":2297,"log_type":1,"src_id":140802003,"trial_step":3},{"step":4,"speaker":"治安署事务员","content":"辛苦久等了，您带来的这伙人我们已经全清点过了——","voice":["vo_trial_40802_1_4"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802004,"trial_step":4},{"step":5,"content":"治安署的事务员左翻右看，终于把画上对勾的通缉令全部整理了出来。","style":3,"background":2297,"log_type":1,"src_id":140802005,"trial_step":5},{"step":6,"speaker":"治安署事务员","content":"这伙砂盗行踪不定、诡计多端，好多接了讨伐委托的人都抱怨过他们比泥鳅还难抓，像您这样一路找到他们老窝，一把全端了的还是第一次！","voice":["vo_trial_40802_1_6"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802006,"trial_step":6},{"step":7,"speaker":"治安署事务员","content":"不愧是MBCC的局长，果然是个厉害人物呀！","voice":["vo_trial_40802_1_7"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802007,"trial_step":7},{"step":8,"options":["……"],"style":6,"background":2297,"log_type":1,"src_id":140802008,"trial_step":8,"course":3,"choices":[{"text":"……","goto":9}]},{"step":9,"content":"只是凑巧路过，举手之劳罢了。","style":2,"background":2297,"log_type":1,"src_id":140802009,"trial_step":9},{"step":10,"content":"凑巧？路过？举手之劳？","style":3,"background":2297,"log_type":1,"src_id":140802010,"trial_step":10},{"step":11,"content":"你看向不远处。柯琳被特遣队员监控着，就站在成捆的砂盗旁边，注意到你的视线，便笑着冲你挥挥手。","style":3,"background":2297,"log_type":1,"src_id":140802011,"trial_step":11},{"step":12,"content":"——而一个半小时之前，她脸上也挂着同样的笑容。","style":3,"background":2297,"log_type":1,"src_id":140802012,"trial_step":12},{"step":13,"speaker":"柯琳","content":"就是这个地址——往西边走，一定没错——","voice":["vo_trial_40802_1_13"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802013,"trial_step":13},{"step":14,"content":"柯琳单手被铐在座椅扶手上，而另一只手高举着比划，为砂船指出前进方向。","style":3,"background":2002,"log_type":1,"src_id":140802014,"trial_step":14},{"step":15,"speaker":"柯琳","content":"再信我一次嘛大局长！我只是有点记不清了，多给几个机会，我一定能试出哪个才是对的！","voice":["vo_trial_40802_1_15"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802015,"trial_step":15},{"step":16,"content":"我给过你机会了，两次。","style":2,"background":2002,"log_type":1,"src_id":140802016,"trial_step":16},{"step":17,"content":"你的视线掠过已经出现裂痕的砂船侧窗，原先崭新的外部涂装已经被刮得满是划痕。","style":3,"background":2002,"log_type":1,"src_id":140802017,"trial_step":17},{"step":18,"content":"第一次你把我们带到了全是机关陷阱的沙漠神庙，第二次，你把我们引向了大型流沙。","style":2,"background":2002,"log_type":1,"src_id":140802018,"trial_step":18},{"step":19,"content":"不如直接说明白，这次你又准备了什么新东西？","style":2,"background":2002,"log_type":1,"src_id":140802019,"trial_step":19},{"step":20,"content":"女人向后一靠，托着笑眯眯的脸，明显不怀好意。","style":3,"background":2002,"log_type":1,"src_id":140802020,"trial_step":20},{"step":21,"speaker":"柯琳","content":"哎呀，提前拆礼物多没意思啊？","voice":["vo_trial_40802_1_21"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802021,"trial_step":21},{"step":22,"speaker":"柯琳","content":"地方反正快到了，是骡子是马，局长你马上就要知道喽~","voice":["vo_trial_40802_1_22"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802022,"trial_step":22},{"step":23,"content":"话音未落，砂船舱内的大门猛地被打开。","style":3,"background":2002,"log_type":1,"src_id":140802023,"trial_step":23},{"step":24,"speaker":"特遣队员","content":"报告局长！我们似乎误入了一处砂盗的秘密据点，目前砂盗正从三个方向围攻我方！","voice":["vo_trial_40802_1_24"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802024,"trial_step":24},{"step":25,"speaker":"特遣队员","content":"如果现在原路撤退，很有可能会被围困，请您下达指令！","voice":["vo_trial_40802_1_25"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802025,"trial_step":25},{"step":26,"content":"你看向柯琳，她抽出撑着脸颊的手，向你比了一个耶。","style":3,"background":2002,"log_type":1,"src_id":140802026,"trial_step":26},{"step":27,"content":"“你能把我怎么样呢？”你似乎听到她的声音就在耳边。你转向特遣队员，不再搭理她的挑衅。","style":3,"background":2002,"log_type":1,"src_id":140802027,"trial_step":27},{"step":28,"content":"来都来了。尽快把他们处理掉吧。","style":2,"background":2002,"log_type":1,"src_id":140802028,"trial_step":28},{"step":29,"content":"以及——分一支小队出来看好柯琳，别给她机会溜走。其余人，向外迎战！","style":2,"background":2002,"log_type":1,"src_id":140802029,"trial_step":29},{"step":30,"speaker":"特遣队员","content":"……局长，柯琳刚刚说，她又想起来一个新的地址。","voice":["vo_trial_40802_1_30"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802030,"trial_step":30},{"step":31,"speaker":"特遣队员","content":"这……这已经是她给出的<color=#fb9259>第四个图科地址</color>了，我们……","voice":["vo_trial_40802_1_31"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802031,"trial_step":31},{"step":32,"content":"你看着面前的特遣队员，你记得他，他是个上进又踏实的年轻人，做事利落，喜好整洁。平日里总是把武器与装备擦得能照出反光。","style":3,"background":2297,"log_type":1,"src_id":140802032,"trial_step":32},{"step":33,"content":"如今的他裤子被撕裂几个大洞，面颊与头发上堆着不少砂土。一张脸藏在护甲后，似乎有苦难言。","style":3,"background":2297,"log_type":1,"src_id":140802033,"trial_step":33},{"step":34,"options":["你辛苦了","拍拍他的肩膀"],"style":6,"background":2297,"log_type":1,"src_id":140802034,"trial_step":34,"course":3,"choices":[{"text":"你辛苦了","goto":35},{"text":"拍拍他的肩膀","goto":null}]},{"step":35,"content":"走吧。带上柯琳，我们先回船上再说。","style":2,"background":2297,"log_type":1,"src_id":140802035,"trial_step":35},{"step":36,"content":"你带着特遣队向着砂船停靠的方向走去，身后传来治安署人热情的嘱咐。","style":3,"background":2297,"log_type":1,"src_id":140802036,"trial_step":36},{"step":37,"speaker":"治安署事务员","content":"感谢您对于剿匪业务的配合！最近砂海气候异常，多有沙暴，您一路注意安全——","voice":["vo_trial_40802_1_37"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802037,"trial_step":37},{"step":38,"content":"后方的声音逐渐模糊，被集市喧闹的人声所取代。","style":3,"background":2297,"log_type":1,"src_id":140802038,"trial_step":38},{"step":39,"content":"今日集市中的人并不算多，你们的队伍走在道路一侧，完全不必担心被游人冲散。但走到一处巷口时，一道矮小的黑影从巷中窜出，结结实实地撞在了你身上。","style":3,"background":2297,"log_type":1,"src_id":140802039,"trial_step":39},{"step":40,"content":"……！","style":2,"background":2297,"log_type":1,"src_id":140802040,"trial_step":40},{"step":41,"speaker":"？？？","content":"啊呀！好疼！","voice":["vo_trial_40802_1_41"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802041,"trial_step":41},{"step":42,"content":"两声痛呼，瘦巴巴的孩子扑通一声摔倒在地上，捂着脑袋龇牙咧嘴。","style":3,"background":2297,"log_type":1,"src_id":140802042,"trial_step":42},{"step":43,"speaker":"特遣队员","content":"这是……小孩？","voice":["vo_trial_40802_1_43"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802043,"trial_step":43},{"step":44,"content":"下意识掏出武器戒备的特遣队员收起枪械，伸手扶起跌倒在地的孩子。","style":3,"background":2297,"log_type":1,"src_id":140802044,"trial_step":44},{"step":45,"content":"但孩子一声不吭，推开搀扶自己的手，转身就向着人群跑去。在众人反应过来之前，你率先动作，一把拉住了他的手臂。","style":3,"background":2297,"log_type":1,"src_id":140802045,"trial_step":45},{"step":46,"speaker":"瘦削的孩子","content":"放开！你……放开我！","voice":["vo_trial_40802_1_46"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802046,"trial_step":46},{"step":47,"content":"在特遣队员诧异的目光中，你的钱包从孩子手上掉落，掉在地上。","style":3,"background":2297,"log_type":1,"src_id":140802047,"trial_step":47},{"step":48,"options":["把东西还给我"],"style":6,"background":2297,"log_type":1,"src_id":140802048,"trial_step":48,"course":3},{"step":49,"content":"我不会送你去警署，但你得把你拿走的东西还给我，它们还有用。","style":2,"background":2297,"log_type":1,"src_id":140802049,"trial_step":49},{"step":50,"speaker":"瘦削的孩子","content":"对不起！我、我这是第一次偷东西，我还有弟弟妹妹，他们没东西吃就要饿死了……对不起、对不起！求您放过我，我再也不会这么干了，我——","voice":["vo_trial_40802_1_50"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802050,"trial_step":50},{"step":51,"content":"一道声音幽幽响起，打断了孩子的哭泣。","style":3,"background":2297,"log_type":1,"src_id":140802051,"trial_step":51},{"step":52,"speaker":"柯琳","content":"哎……砂海小毛贼最经典的伎俩，生病的妈、酗酒的爹、没饭吃的弟妹和破碎的他……","voice":["vo_trial_40802_1_52"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802052,"trial_step":52},{"step":53,"speaker":"柯琳","content":"我小时候被抓了就用这套，这么多年，你们连话术都不换换的吗？","voice":["vo_trial_40802_1_53"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802053,"trial_step":53},{"step":54,"content":"男孩儿被戳破谎言，浑身一僵，然后更猛烈地挣扎起来。","style":3,"background":2297,"log_type":1,"src_id":140802054,"trial_step":54},{"step":55,"content":"柯琳弯腰帮你捡起地上的钱包，没第一时间还给你，而是在男孩儿眼前晃晃，然后慢悠悠开口。","style":3,"background":2297,"log_type":1,"src_id":140802055,"trial_step":55},{"step":56,"speaker":"柯琳","content":"局长大人打算怎么处理？这种小毛孩估计连通缉榜也上不了，既然换不了酬金，那不如干脆找个没人的地方，狠狠揍顿屁股，然后再扔去砂海里长个教训——","voice":["vo_trial_40802_1_56"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802056,"trial_step":56},{"step":57,"content":"柯琳越说越离谱，吓得男孩儿真的以为自己要被扔去喂砂虫，一个没憋住真哭了起来。","style":3,"background":2297,"log_type":1,"src_id":140802057,"trial_step":57},{"step":58,"content":"你叹了口气，打断柯琳的“威胁”，然后从她手中抽回自己的钱包。","style":3,"background":2297,"log_type":1,"src_id":140802058,"trial_step":58},{"step":59,"options":["我记得这是我的钱包"],"style":6,"background":2297,"log_type":1,"src_id":140802059,"trial_step":59,"course":3,"choices":[{"text":"我记得这是我的钱包","goto":60}]},{"step":60,"content":"拿出放在侧边的证件与几张磁卡，你合起皮夹，连带着其中所有现金一起放回了孩子手里。","style":3,"background":2297,"log_type":1,"src_id":140802060,"trial_step":60},{"step":61,"speaker":"瘦削的孩子","content":"呜呜呜……嗯？这、这是……？","voice":["vo_trial_40802_1_61"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802061,"trial_step":61},{"step":62,"content":"孩子眼中的泪珠要落不落，这一切太出乎意料，他只是愣愣的看着你。","style":3,"background":2297,"log_type":1,"src_id":140802062,"trial_step":62},{"step":63,"content":"不管你是不是在说谎，偷窃都是不好的行为。但我希望你在有能力养活自己后，能用更正当也更安全的方式生活。不然……","style":2,"background":2297,"log_type":1,"src_id":140802063,"trial_step":63},{"step":64,"content":"你指了指身侧吊儿郎当的女人。","style":3,"background":2297,"log_type":1,"src_id":140802064,"trial_step":64},{"step":65,"content":"再被抓住的话，就得跟她一样被拉着游街示众了。","style":2,"background":2297,"log_type":1,"src_id":140802065,"trial_step":65},{"step":66,"content":"回去吧，这些钱足够你们生活一段时间了。","style":2,"background":2297,"log_type":1,"src_id":140802066,"trial_step":66},{"step":67,"content":"脸上挂着泪滴的孩子连声道谢。临走时，柯琳伸手拍了拍他的肩膀，压低声音，不着痕迹地将一枚弹壳塞进了孩子口袋中。","style":3,"background":2297,"log_type":1,"src_id":140802067,"trial_step":67},{"step":68,"speaker":"柯琳","content":"你带着这个，去集市最东头找一个名字叫安德烈的大胡子。","voice":["vo_trial_40802_1_68"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802068,"trial_step":68},{"step":69,"speaker":"柯琳","content":"报“柯琳”的名字，他会收下你的，虽然比较苦，但多少管饭吃……哦还有，你假哭的技术真得再练练，简直辣眼睛啊亲爱的……","voice":["vo_trial_40802_1_69"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802069,"trial_step":69},{"step":70,"content":"特遣队员看向你，你摇了摇头。柯琳和那孩子又嘀咕了两句才重新站起来，和他告别。","style":3,"background":2297,"log_type":1,"src_id":140802070,"trial_step":70},{"step":71,"speaker":"柯琳","content":"久等啦局长大人——走，咱们回船吧？","voice":["vo_trial_40802_1_71"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802071,"trial_step":71},{"step":72,"options":["大胡子安德烈？"],"style":6,"background":2297,"log_type":1,"src_id":140802072,"trial_step":72,"course":3,"choices":[{"text":"大胡子安德烈？","goto":73}]},{"step":73,"speaker":"柯琳","content":"嗯？哦，是当年一起“干活”的搭档之一，后来金盆洗手不干了，自己开了个烤肉小摊，偶尔倒卖一些二手情报……这小孩儿胆子够大，会有出息的。","voice":["vo_trial_40802_1_73"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802073,"trial_step":73},{"step":74,"content":"……听起来也不是什么正经工作。","style":2,"background":2297,"log_type":1,"src_id":140802074,"trial_step":74},{"step":75,"content":"柯琳低笑两声，没有再接话，转身跟你一起走向即将抵达的砂船。","style":3,"background":2297,"log_type":1,"src_id":140802075,"trial_step":75},{"step":76,"content":"开船，回到砂海主航道。","style":2,"background":2002,"log_type":1,"src_id":140802076,"trial_step":76},{"step":77,"content":"不等柯琳开口，你走入舱内，率先下达命令。","style":3,"background":2002,"log_type":1,"src_id":140802077,"trial_step":77},{"step":78,"content":"柯琳被押送回椅子上，双腿交叠，如同回到游戏桌上的玩家一般兴致勃勃。","style":3,"background":2002,"log_type":1,"src_id":140802078,"trial_step":78},{"step":79,"speaker":"柯琳","content":"好啊，三局之后又三局，探险游戏我最喜欢了~","voice":["vo_trial_40802_1_79"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802079,"trial_step":79},{"step":80,"speaker":"柯琳","content":"怎么样啊局长，还记不记得我给你们报的新地址？需要的话我随时可以重复给你听！","voice":["vo_trial_40802_1_80"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802080,"trial_step":80},{"step":81,"content":"没有回答，你在她对面坐下，直视她的双眼。","style":3,"background":2002,"log_type":1,"src_id":140802081,"trial_step":81},{"step":82,"content":"在我们继续这个无聊的冒险游戏之前，我还有一个要求证的问题。","style":2,"background":2002,"log_type":1,"src_id":140802082,"trial_step":82},{"step":83,"options":["柯琳，你的目的到底是什么？"],"style":6,"background":2002,"log_type":1,"src_id":140802083,"trial_step":83,"course":3,"choices":[{"text":"柯琳，你的目的到底是什么？","goto":84}]},{"step":84,"content":"女人愣了愣，嗤笑出声。","style":3,"background":2002,"log_type":1,"src_id":140802084,"trial_step":84},{"step":85,"speaker":"柯琳","content":"绑架的目的还能是什么？要赎金啊，局长你不是审得很明白了吗？","voice":["vo_trial_40802_1_85"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802085,"trial_step":85},{"step":86,"content":"是，这是你的目的，但这不是你唯一的目的。","style":2,"background":2002,"log_type":1,"src_id":140802086,"trial_step":86},{"step":87,"content":"作为一个绑架犯，她大可以在供出海拉的位置后找机会逃跑……但她身上没有半点绑架犯该有的急迫，而是以“海拉的下落”为诱饵慢悠悠地钓着你们在砂海里溜了一大圈。","style":3,"background":2002,"log_type":1,"src_id":140802087,"trial_step":87},{"step":88,"content":"那她是为了那份没拿到手的“赎金”？不，你的调查结果告诉你——她想要的绝不止是这些。","style":3,"background":2002,"log_type":1,"src_id":140802088,"trial_step":88},{"step":89,"content":"我查看了警署的收押记录，在过去半年之内，你连续送了7个砂盗进去，恰好就是刚刚那批砂盗的同伙。他们放言视你和你的同伙为仇家，见一个揍一个。","style":2,"background":2002,"log_type":1,"src_id":140802089,"trial_step":89},{"step":90,"content":"还有那座神庙以及流沙……这些都是你想下手的目标。","style":2,"background":2002,"log_type":1,"src_id":140802090,"trial_step":90},{"step":91,"content":"MBCC的火力被她利用，为她和图科扫清了一大片障碍。","style":3,"background":2002,"log_type":1,"src_id":140802091,"trial_step":91},{"step":92,"content":"我看不清你的目的，也不知道你到底在计划什么……甚至可能你只是拿海拉当幌子忽悠我，这些都没关系……","style":2,"background":2002,"log_type":1,"src_id":140802092,"trial_step":92},{"step":93,"content":"如果你的目的只是利用我，那就别把海拉牵扯进来！","style":2,"background":2002,"log_type":1,"src_id":140802093,"trial_step":93},{"step":94,"content":"柯琳，你们图科到底想要什么？！","style":2,"background":2002,"log_type":1,"src_id":140802094,"trial_step":94},{"step":95,"content":"戴帽子的女人愣了愣，她上下重新打量了你一番，眼神里多了一些别的东西。","style":3,"background":2002,"log_type":1,"src_id":140802095,"trial_step":95},{"step":96,"speaker":"柯琳","content":"<size=25>嚯……小老鼠，你的亲亲局长可比你精明多了……</size>","voice":["vo_trial_40802_1_96"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802096,"trial_step":96},{"step":97,"content":"她的声音不高，你一下没听清楚她的呢喃。","style":3,"background":2002,"log_type":1,"src_id":140802097,"trial_step":97},{"step":98,"options":["你在说什么？"],"style":6,"background":2002,"log_type":1,"src_id":140802098,"trial_step":98,"course":3,"choices":[{"text":"你在说什么？","goto":99}]},{"step":99,"speaker":"柯琳","content":"在感慨啊，戏还没演到第二场呢，主角大人就要罢演了。","voice":["vo_trial_40802_1_99"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802099,"trial_step":99},{"step":100,"speaker":"柯琳","content":"让我澄清两点吧。第一，我的目的确实是为了靠近你，但和图科其他人无关。他们不知道我出来，也不知道我对你的小老鼠动手了，他们和这次事件完全无关。","voice":["vo_trial_40802_1_100"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802100,"trial_step":100},{"step":101,"speaker":"柯琳","content":"第二，你的推测也基本没错，只是有一点不太准确……","voice":["vo_trial_40802_1_101"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802101,"trial_step":101},{"step":102,"content":"女人抬起帽檐，挑衅地笑笑。","style":3,"background":2002,"log_type":1,"src_id":140802102,"trial_step":102},{"step":103,"speaker":"柯琳","content":"谁说，我没在找机会跑走的？","voice":["vo_trial_40802_1_103"],"voice_bank":"vo_korryn_trial","style":1,"background":2002,"log_type":1,"src_id":140802103,"trial_step":103},{"step":104,"content":"（空场、震动、闪白）","style":18,"background":2002,"log_type":1,"src_id":140802104,"trial_step":104},{"step":105,"content":"突然，脚下的船舱剧烈震动，空间开始倾斜——似乎是砂船触礁了，天旋地转之间，柯琳拎起座椅砸向早已出现裂痕的玻璃，然后在碎片中一跃而下。","style":3,"background":2002,"log_type":1,"src_id":140802105,"trial_step":105},{"step":106,"options":["别想跑！"],"style":6,"background":2002,"log_type":1,"src_id":140802106,"trial_step":106,"course":3,"choices":[{"text":"别想跑！","goto":107}]},{"step":107,"content":"没有多余决策的时间，你几乎没有思考，紧随其后一跃而出——","style":3,"background":2002,"log_type":1,"src_id":140802107,"trial_step":107},{"step":108,"content":"在坠落的力道之下，你几乎立刻撞在了柯琳的身体上。","style":3,"background":1006,"log_type":1,"src_id":140802108,"trial_step":108},{"step":109,"content":"你们相互纠缠着，一同跌跌撞撞滚下沙丘，直到一处凹地，才算勉强停下。","style":3,"background":1006,"log_type":1,"src_id":140802109,"trial_step":109},{"step":110,"speaker":"柯琳","content":"嘶——疼疼疼……","voice":["vo_trial_40802_1_110"],"voice_bank":"vo_korryn_trial","style":1,"background":1006,"log_type":1,"src_id":140802110,"trial_step":110},{"step":111,"content":"从砂土中翻身坐起来，柯琳摸着自己被你撞到的腰侧一阵倒抽冷气。","style":3,"background":1006,"log_type":1,"src_id":140802111,"trial_step":111},{"step":112,"content":"身后触礁的砂船带着一条漫长的伤口，一路失控疾驰，已经远远地与你们拉开了距离。","style":3,"background":1006,"log_type":1,"src_id":140802112,"trial_step":112},{"step":113,"speaker":"柯琳","content":"哎呦，我的大局长啊，砸了玻璃跳船这种事你也要跟上来啊？！","voice":["vo_trial_40802_1_113"],"voice_bank":"vo_korryn_trial","style":1,"background":1006,"log_type":1,"src_id":140802113,"trial_step":113},{"step":114,"speaker":"柯琳","content":"非要跟着人就算了，能不能有点常识！要跳有石头的沙堆就用手好好抱住脑袋，要是不小心把脑子撞开花儿你那只小老鼠肯定饶不了我——","voice":["vo_trial_40802_1_114"],"voice_bank":"vo_korryn_trial","style":1,"background":1006,"log_type":1,"src_id":140802114,"trial_step":114},{"step":115,"content":"赏金猎人的骂声戛然而止。狂风吹起，你们不约而同的回过头去。","style":3,"background":1006,"log_type":1,"src_id":140802115,"trial_step":115},{"step":116,"content":"不到百米开外，几乎遮天蔽日的沙暴将地平线那一头吞噬成一片昏黄的砂色。晦暗模糊的沙暴之中，高大诡谲的身影若隐若现，发出骇人的嘶鸣。","style":3,"background":1006,"log_type":1,"src_id":140802116,"trial_step":116},{"step":117,"options":["这是……灰烬之潮？"],"style":6,"background":1006,"log_type":1,"src_id":140802117,"trial_step":117,"course":3,"choices":[{"text":"这是……灰烬之潮？","goto":118}]},{"step":118,"speaker":"治安署事务员","content":"感谢您对于剿匪业务的配合！最近砂海气候异常，多有沙暴，您一路注意安全——","voice":["vo_trial_40802_1_37"],"voice_bank":"vo_korryn_trial","style":1,"background":2297,"log_type":1,"src_id":140802118,"trial_step":118},{"step":119,"content":"和你记忆中的灰烬之潮不同，面前的沙暴无论从行进速度、规模或大小都不同往日，更加猛烈，也更加迅速。","style":3,"background":1006,"log_type":1,"src_id":140802119,"trial_step":119},{"step":120,"content":"最关键的是……太快了。悄无声息地出现，接着迅速逼近至极近的地方。","style":3,"background":1006,"log_type":1,"src_id":140802120,"trial_step":120},{"step":121,"speaker":"柯琳","content":"——别发呆了，跑！赶紧跑！","voice":["vo_trial_40802_1_121"],"voice_bank":"vo_korryn_trial","style":1,"background":1006,"log_type":1,"src_id":140802121,"trial_step":121},{"step":122,"content":"刚踩下的脚印便被风卷走，昏黄的沙暴中，獠牙尖利的异兽嘶吼着，试图扯住你的衣摆。","style":3,"background":1006,"log_type":1,"src_id":140802122,"trial_step":122},{"step":123,"content":"柯琳一手拉着你，另一手架起长枪，接连射击将其击退。","style":3,"background":1006,"log_type":1,"src_id":140802123,"trial_step":123},{"step":124,"content":"透过漫天风沙，你隐约看到前方出现一处建筑物的影子。","style":3,"background":1006,"log_type":1,"src_id":140802124,"trial_step":124},{"step":125,"content":"去左、咳……左边！那里有可以避难的地方！","style":2,"background":1006,"log_type":1,"src_id":140802125,"trial_step":125},{"step":126,"content":"狂风呼啸，几乎张嘴的瞬间风沙就会灌进口中。你被逼得无法说话，只能与柯琳配合着摸索向避难所。","style":3,"background":1006,"log_type":1,"src_id":140802126,"trial_step":126},{"step":127,"content":"风力越来越大，你听到柯琳的枪声越发频繁，砂兽的嘶吼声似乎就在耳边——终于，你摸到了避难所的大门。","style":3,"background":1006,"log_type":1,"src_id":140802127,"trial_step":127},{"step":128,"content":"用力一推，你拉着柯琳扑进室内。","style":3,"background":10000,"log_type":1,"src_id":140802128,"trial_step":128}]}