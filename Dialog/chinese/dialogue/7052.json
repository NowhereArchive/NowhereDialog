{"id":7052,"chapter_id":7,"scene_id":706,"steps":[{"step":1,"speaker":"海拉","content":"我们……赢了？","voice":["vo_cgplot_7062001"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":2,"speaker":"赫卡蒂","content":"它很强，但也一样没有攻击欲望，这个傀儡为什么要来？","voice":["vo_cgplot_7062002"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":3,"speaker":"恐惧傀儡","content":"人战胜不了自己的恐惧，只有哈梅尔，能让我忘记……","voice":["vo_cgplot_7062003"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":4,"speaker":"恐惧傀儡","content":"我不会让你们打扰哈梅尔……","voice":["vo_cgplot_7062004"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":5,"content":"恐惧傀儡离开了战场，消失在一阵彩色的烟雾中。","style":3,"background":704,"log_type":1},{"step":6,"content":"烟雾并没有立刻消散，而是弥散在了你们周围。","style":3,"background":10006,"log_type":1},{"step":7,"speaker":"海拉","content":"咳咳咳——这是什么……？咳咳——","voice":["vo_cgplot_7062007"],"voice_bank":"vo_cgplot_07","style":1,"background":10006,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"屏住呼吸！","voice":["vo_cgplot_7062008"],"voice_bank":"vo_cgplot_07","style":1,"background":10006,"log_type":1},{"step":9,"content":"梦魇拂开了烟雾，这骚动并没有惊动更多人，烟雾消散了。","style":3,"background":704,"log_type":1},{"step":10,"speaker":"赫卡蒂","content":"……结束了。局长，海拉，你们没事吧？","voice":["vo_cgplot_7062010"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":11,"speaker":"赫卡蒂","content":"……海拉？","voice":["vo_cgplot_7062011"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":12,"content":"一种不祥的预感自枷锁传来。海拉低着头，身体开始摇晃，像是陷入了梦境中，神志不清地呓语着。","style":3,"background":704,"log_type":1},{"step":13,"speaker":"海拉","content":"不……不是这样的……我没有……我才不怕……","voice":["vo_cgplot_7062013"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":14,"speaker":"选项","options":["海拉？！"],"jump":[15],"style":6,"background":704,"log_type":1}]}