{"id":400403101,"chapter_id":50016,"scene_id":51637,"steps":[{"step":1,"speaker":"旁白","content":"从前有一天，在一个万家灯火的夜晚，有一只代表祥瑞的小小神兽和家人失散了。","voice":["vo_event_400403101_2"],"voice_bank":"vo_event_04031","style":1,"background":4056,"log_type":1},{"step":2,"speaker":"旁白","content":"为了寻找家人，这只小兽四处流浪。走啊，走啊，走了好远好远，终于来到一个陌生的城市。","voice":["vo_event_400403101_3"],"voice_bank":"vo_event_04031","style":1,"background":4056,"log_type":1},{"step":3,"speaker":"旁白","content":"可是，城市是那么大，到哪儿才能找到家人的消息呢？","voice":["vo_event_400403101_4"],"voice_bank":"vo_event_04031","style":1,"background":4056,"log_type":1},{"step":4,"speaker":"旁白","content":"因为心中太过难过，小兽忍不住叫了起来。而它的叫声，也引来了一些奇怪的鸭子。","voice":["vo_event_400403101_7"],"voice_bank":"vo_event_04031","style":1,"background":4057,"log_type":1},{"step":5,"speaker":"奇怪的鸭子","content":"嘎嘎嘎嘎！嘎嘎嘎嘎嘎！\n（不要管这个女孩！继续“猎星行动”！）","voice":["vo_event_400403101_8"],"voice_bank":"vo_event_04031","style":1,"background":4058,"log_type":1},{"step":6,"speaker":"众鸭子","content":"嘎嘎！\n（是！）","voice":["vo_event_400403101_9"],"voice_bank":"vo_event_04031","style":1,"background":4059,"log_type":1},{"step":7,"speaker":"嗷呜","content":"喂喂，你们在干什么！不许动星仔！走开，走开！","voice":["vo_event_400403101_10"],"voice_bank":"vo_event_04031","style":1,"background":4059,"log_type":1},{"step":8,"speaker":"嗷呜","content":"你们再欺负它，我可要生气啦！","voice":["vo_event_400403101_11"],"voice_bank":"vo_event_04031","style":1,"background":4059,"log_type":1},{"step":9,"speaker":"旁白","content":"哈……哈，鸭子们说，你的声音真奇怪，一听就不是本地居民。","voice":["vo_event_400403101_12"],"voice_bank":"vo_event_04031","style":1,"background":4059,"log_type":1},{"step":10,"speaker":"奇怪的鸭子","content":"你一定是外邦来的奸细！","voice":["vo_event_400403101_13"],"voice_bank":"vo_event_04031","style":1,"background":4059,"log_type":1},{"step":11,"speaker":"奇怪的鸭子","content":"来人，把它给我抓起来！","voice":["vo_event_400403201_2"],"voice_bank":"vo_event_04032","style":1,"background":4059,"log_type":1}]}