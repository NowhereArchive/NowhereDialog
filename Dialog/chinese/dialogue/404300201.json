{"id":404300201,"chapter_id":50088,"scene_id":58849,"steps":[{"step":1,"content":"选项A-据实以告","style":30,"background":10000,"log_type":1},{"step":2,"speaker":"希露妲","content":"MBCC……听来也是狄斯的一条鬣犬。","voice":["vo_event_404300201_02"],"voice_bank":"vo_event_43002","style":1,"background":10000,"log_type":1},{"step":3,"speaker":"希露妲","content":"但无论你们想从我身上得到什么，恐怕都要失望了。","voice":["vo_event_404300201_03"],"voice_bank":"vo_event_43002","style":1,"background":10000,"log_type":1},{"step":4,"content":"忽然间，似乎有什么力量突然重重砸在了你身上，让你一下子直不起身。","style":3,"background":10000,"log_type":1},{"step":5,"content":"希露妲的身体轻晃了一下，周围已经化作污泥的狂厄纷纷躁动起来，飞快攀上你的身体，扼住了你的四肢与咽喉。","style":3,"background":10000,"log_type":1},{"step":6,"content":"（继续压暗）","style":18,"background":10000,"log_type":1},{"step":7,"speaker":"希露妲","content":"从被捕的那一刻起，我唯一的价值，就是干净地死在这里。","voice":["vo_event_404300201_08"],"voice_bank":"vo_event_43002","style":1,"background":10000,"log_type":1},{"step":8,"speaker":"希露妲","content":"于你们而言，只是捕获了一具没有意义的“空壳”。","voice":["vo_event_404300201_12"],"voice_bank":"vo_event_43002","style":1,"background":10000,"log_type":1},{"step":9,"content":"（红闪）","style":18,"background":10000,"log_type":1},{"step":10,"speaker":"希露妲","content":"……这样就好……死干净就很好。","voice":["vo_event_404300201_14"],"voice_bank":"vo_event_43002","style":1,"background":10000,"log_type":1},{"step":11,"speaker":"希露妲","content":"再见吧，别费心了，我死都不会当狄斯的狗。","voice":["vo_event_404300201_15"],"voice_bank":"vo_event_43002","style":1,"background":10000,"log_type":1},{"step":12,"content":"汹涌的黑泥瞬间将你吞没，在极端的窒息感中，你拼命挣扎起来。","style":3,"background":10000,"log_type":1},{"step":13,"options":["黑石英！","释放枷锁"],"jump":[14,14],"style":6,"background":10000,"log_type":1},{"step":14,"content":"没有任何作用，四肢开始无力，眼前闪过一阵阵斑斓的色彩，喉间有血腥味泛上来，挣扎变得无力，一切死亡预兆都出现在你的身上——你就这样渐渐在黑暗中停止了呼吸。","style":3,"background":10000,"log_type":1}]}