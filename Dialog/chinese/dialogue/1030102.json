al_step":235},{"step":235,"speaker":"澈","content":"对了，等会儿你回来救我们的时候先救蔻蔻。","voice":["vo_trial_30102_1_236"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102236,"trial_step":236},{"step":236,"content":"？","style":2,"background":120,"log_type":1,"src_id":130102237,"trial_step":237},{"step":237,"speaker":"守卫","content":"别*文明狄斯*反抗了！","voice":["vo_trial_30102_1_238"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102238,"trial_step":238},{"step":238,"speaker":"守卫","content":"楼上那个已经被我们抓住了，识相的话乖乖投降。","voice":["vo_trial_30102_1_239"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102239,"trial_step":239},{"step":239,"content":"澈没有回答，只是掷出了他的短刀。","style":3,"background":120,"log_type":1,"src_id":130102240,"trial_step":240},{"step":240,"speaker":"守卫小弟A","content":"我*文明*我的手！！","voice":["vo_trial_30102_1_241"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102241,"trial_step":241},{"step":241,"speaker":"守卫","content":"*文明*的这群差佬是神经病吧。给我上！","voice":["vo_trial_30102_1_242"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102242,"trial_step":242},{"step":242,"content":"杂乱的脚步声压了过来。澈依托楼梯间的门打翻了领头的两人。","style":3,"background":120,"log_type":1,"src_id":130102243,"trial_step":243},{"step":243,"content":"然而，后面的五六个人接踵而至，只靠体重就压制住了澈。","style":3,"background":120,"log_type":1,"src_id":130102244,"trial_step":244},{"step":244,"speaker":"澈","content":"窗……户！","voice":["vo_trial_30102_1_245"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102245,"trial_step":245},{"step":245,"content":"身上压着五个大汉的的澈仍不忘提醒你。","style":3,"background":120,"log_type":1,"src_id":130102246,"trial_step":246},{"step":246,"options":["撞开玻璃翻出去"],"style":6,"background":120,"log_type":1,"src_id":130102247,"trial_step":247,"course":3,"choices":[{"text":"撞开玻璃翻出去","goto":248}]},{"step":247,"content":"随着一声清脆的玻璃碎裂声响，你翻了出去。","style":3,"background":100,"log_type":1,"src_id":130102248,"trial_step":248},{"step":248,"content":"这里的一楼离地面依旧有三四米距离，落地的冲击让你眼前一黑。碎裂的玻璃渣割破了你的脸。","style":3,"background":100,"log_type":1,"src_id":130102249,"trial_step":249},{"step":249,"content":"但你没有半点犹豫，拔腿就跑。","style":3,"background":100,"log_type":1,"src_id":130102250,"trial_step":250},{"step":250,"speaker":"守卫","content":"追！","voice":["vo_trial_30102_1_251"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102251,"trial_step":251},{"step":251,"content":"逃离大楼后你一刻不停地奔跑着，却始终没能甩脱后面的追兵。","style":3,"background":100,"log_type":1,"src_id":130102252,"trial_step":252},{"step":252,"speaker":"守卫","content":"别跑！","voice":["vo_trial_30102_1_253"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102253,"trial_step":253},{"step":253,"speaker":"守卫","content":"真*文明*能跑啊，明明长那副病恹恹的样……","voice":["vo_trial_30102_1_254"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102254,"trial_step":254},{"step":254,"speaker":"守卫","content":"开枪！别让他跑了，他是差佬！","female_content":"开枪！别让她跑了，她是差佬！","voice":["vo_trial_30102_1_255","vo_trial_30102_1_255f"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102255,"trial_step":255},{"step":255,"content":"子弹呼啸着从你身边飞过，但你一刻也没有停下。","voice":["vo_trial_30102_1_256"],"voice_bank":"vo_linglan_trial","style":3,"background":100,"log_type":1,"src_id":130102256,"trial_step":256},{"step":256,"speaker":"守卫","content":"*文明狄斯*的什么准头。","voice":["vo_trial_30102_1_257"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102257,"trial_step":257},{"step":257,"speaker":"守卫","content":"你行你上。","voice":["vo_trial_30102_1_258"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102258,"trial_step":258},{"step":258,"speaker":"守卫","content":"别吵了，赶紧解决他。","female_content":"别吵了，赶紧解决她。","voice":["vo_trial_30102_1_259","vo_trial_30102_1_259f"