{"id":1130303,"chapter_id":1130303,"scene_id":1,"steps":[{"step":1,"content":"庭院的门并没有人把守，但整座建筑都笼罩在一股说不清道不明的光晕之中。","style":3,"background":1021,"log_type":1,"src_id":230303001,"trial_step":1},{"step":2,"content":"或许是月光吧，你这么想着，翻过墙，进入院中。月光之下，你跌落进一片花丛。","style":3,"background":1021,"log_type":1,"src_id":230303002,"trial_step":2},{"step":3,"content":"难以想象，一个小小的庭院之中，居然种了这么多的花。","style":3,"background":1021,"log_type":1,"src_id":230303003,"trial_step":3},{"step":4,"content":"相比这些花，更重要的是，堇跪坐在不远处的花丛中。腹部的衣物已然一片鲜红。","style":3,"background":1021,"log_type":1,"src_id":230303004,"trial_step":4},{"step":5,"content":"走廊上，站着两个穿着相似、神色冰冷的女人。她们身后，摇曳的烛光，在纸门上勾出一个端坐的身影。","style":3,"background":1021,"log_type":1,"src_id":230303005,"trial_step":5},{"step":6,"content":"几乎破门而出的压迫感实在是太过强烈了。下一个瞬间，你就能清晰地感觉到，那个门后的身影已经发现了你。","style":3,"background":1021,"log_type":1,"src_id":230303006,"trial_step":6},{"step":7,"content":"隔着十几米的距离，你依稀可以听到那边的对话。","style":3,"background":1021,"log_type":1,"src_id":230303007,"trial_step":7},{"step":8,"speaker":"堇","content":"我……甘愿接受惩罚。","style":1,"background":1021,"log_type":1,"src_id":230303008,"trial_step":8},{"step":9,"speaker":"堇","content":"只希望您能……","style":1,"background":1021,"log_type":1,"src_id":230303009,"trial_step":9},{"step":10,"speaker":"穿和服的女性","content":"业师给过你一次机会了，但你还是这样执迷不悟。","style":1,"background":1021,"log_type":1,"src_id":230303010,"trial_step":10},{"step":11,"content":"一道尖锐的破空声呼啸而过，似乎有什么武器打在了堇身上。","style":3,"background":1021,"log_type":1,"src_id":230303011,"trial_step":11},{"step":12,"content":"堇的身体微微一颤，你听到了水滴落在石头上的声音。","style":3,"background":1021,"log_type":1,"src_id":230303012,"trial_step":12},{"step":13,"speaker":"堇","content":"他……愿意为所有人考虑，即便是禁闭者，即便是花园的我们……他会冒着风险拯救目所能及的每一个人。","female_content":"她……愿意为所有人考虑，即便是禁闭者，即便是花园的我们……她会冒着风险拯救目所能及的每一个人。","style":1,"background":1021,"log_type":1,"src_id":230303013,"trial_step":13},{"step":14,"speaker":"堇","content":"他和那些人不一样。","female_content":"她和那些人不一样。","style":1,"background":1021,"log_type":1,"src_id":230303014,"trial_step":14},{"step":15,"content":"走廊前的女性冷哼了一声。","style":3,"background":1021,"log_type":1,"src_id":230303015,"trial_step":15},{"step":16,"speaker":"穿和服的女性","content":"这个世界上，只有业师和花园的大家，才是你唯一的同伴。","style":1,"background":1021,"log_type":1,"src_id":230303016,"trial_step":16},{"step":17,"speaker":"穿和服的女性","content":"而你却为了一个外人，袭击了她们……","style":1,"background":1021,"log_type":1,"src_id":230303017,"trial_step":17},{"step":18,"speaker":"堇","content":"我很抱歉。","style":1,"background":1021,"log_type":1,"src_id":230303018,"trial_step":18},{"step":19,"speaker":"穿和服的女性","content":"你很抱歉？你犯下的过错是道歉能够弥补的吗？！","style":1,"background":1021,"log_type":1,"src_id":230303019,"trial_step":19},{"step":20,"speaker":"？？？","content":"好了。","style":1,"background":1021,"log_type":1,"src_id":230303020,"trial_step":20},{"step":21,"content":"屏风后的女人，或者说业师说话了。","style":3,"background":1021,"log_type":1,"src_id":230303021,"trial_step":21},{"step":22,"speaker":"业师","content":"你应该知道，堇。","style":1,"background":1021,"log_type":1,"src_id":230303022,"trial_step":22},{"step":23,"speaker":"业师","content":"你们每一个人，都是我的学生，是我所珍视的作品。","style":1,"background":1021,"log_type":1,"src_id":230303023,"trial_step":23},{"step":24,"speaker":"业师","content":"无论你们犯了什么错，我都不会过分责怪你们。","style":1,"background":1021,"log_type":1,"src_id":230303024,"trial_step":24},{"step":25,"speaker":"业师","content":"唯独背叛……","style":1,"background":1021,"log_type":1,"src_id":230303025,"trial_step":25},{"step":26,"speaker":"堇","content":"是弟子不好……让您伤心了。","style":1,"background":1021,"log_type":1,"src_id":230303026,"trial_step":26},{"step":27,"content":"堇咬紧牙关。她的伤口还在流血。","style":3,"background":1021,"log_type":1,"src_id":230303027,"trial_step":27},{"step":28,"speaker":"业师","content":"乖孩子……","style":1,"background":1021,"log_type":1,"src_id":230303028,"trial_step":28},{"step":29,"speaker":"业师","content":"我再给你一次机会。","style":1,"background":1021,"log_type":1,"src_id":230303029,"trial_step":29},{"step":30,"content":"业师的声调显得格外温柔。堇猛然抬头，仿佛抓住了一丝生机。","style":3,"background":1021,"log_type":1,"src_id":230303030,"trial_step":30},{"step":31,"content":"纸门上的影子指向了你，几束目光随即聚集到你的身上，你再也无所遁形。","style":3,"background":1021,"log_type":1,"src_id":230303031,"trial_step":31},{"step":32,"speaker":"业师","content":"杀了他。","female_content":"杀了她。","style":1,"background":1021,"log_type":1,"src_id":230303032,"trial_step":32},{"step":33,"content":"堇看到了你。惊愕、焦急、恐惧凝聚为最深沉的绝望。","style":3,"background":1021,"log_type":1,"src_id":230303033,"trial_step":33},{"step":34,"content":"可最后，又只化作一句温柔的话语。","style":3,"background":1021,"log_type":1,"src_id":230303034,"trial_step":34},{"step":35,"speaker":"堇","content":"你……还是来了。","style":1,"background":1021,"log_type":1,"src_id":230303035,"trial_step":35},{"step":36,"options":["我不可能这样丢下你"],"style":6,"background":1021,"log_type":1,"src_id":230303036,"trial_step":36,"course":3,"choices":[{"text":"我不可能这样丢下你","goto":37}]},{"step":37,"content":"堇转过身，重新面向业师。","style":3,"background":1021,"log_type":1,"src_id":230303037,"trial_step":37},{"step":38,"speaker":"堇","content":"这件事，由我承担就好。","style":1,"background":1021,"log_type":1,"src_id":230303038,"trial_step":38},{"step":39,"speaker":"穿和服的女性","content":"由你承担？哼，堇，你和这个人一样愚蠢。","style":1,"background":1021,"log_type":1,"src_id":230303039,"trial_step":39},{"step":40,"speaker":"穿和服的女性","content":"就算你阻止了我活捉他，他还是会自己追过来送死。","female_content":"就算你阻止了我活捉她，她还是会自己追过来送死。","style":1,"background":1021,"log_type":1,"src_id":230303040,"trial_step":40},{"step":41,"content":"堇没有回应女人的话，而是死死盯着纸门后面的身影。","style":3,"background":1021,"log_type":1,"src_id":230303041,"trial_step":41},{"step":42,"speaker":"堇","content":"请您放过……咳咳……","style":1,"background":1021,"log_type":1,"src_id":230303042,"trial_step":42},{"step":43,"content":"堇的身体摇摇欲坠。纸门后的业师叹了口气。","style":3,"background":1021,"log_type":1,"src_id":230303043,"trial_step":43},{"step":44,"speaker":"业师","content":"我见过很多背叛，你这样的，倒是第一个。","style":1,"background":1021,"log_type":1,"src_id":230303044,"trial_step":44},{"step":45,"speaker":"业师","content":"或许你只是被蛊惑了。","style":1,"background":1021,"log_type":1,"src_id":230303045,"trial_step":45},{"step":46,"content":"明明依旧是轻柔的话语，只一瞬间，强烈到近乎窒息的危机感淹没了你。","style":3,"background":1021,"log_type":1,"src_id":230303046,"trial_step":46},{"step":47,"content":"下一刻，堇站在了你的身前。","style":3,"background":1021,"log_type":1,"src_id":230303047,"trial_step":47},{"step":48,"content":"什么都没有听到，什么都没有看到，只是一个愣神，堇便倒在了地上。","style":3,"background":1021,"log_type":1,"src_id":230303048,"trial_step":48},{"step":49,"content":"堇回头望着你，然后缓缓倒在了地上。","style":3,"background":1021,"log_type":1,"src_id":230303049,"trial_step":49},{"step":50,"content":"你赶紧上前扶住了她。","style":3,"background":1021,"log_type":1,"src_id":230303050,"trial_step":50},{"step":51,"content":"堇！","style":2,"background":1021,"log_type":1,"src_id":230303051,"trial_step":51},{"step":52,"content":"她脸色苍白，咬住了嘴唇，没有说话。","style":3,"background":1021,"log_type":1,"src_id":230303052,"trial_step":52},{"step":53,"content":"坚持住，我会带你离开这里。","style":2,"background":1021,"log_type":1,"src_id":230303053,"trial_step":53},{"step":54,"content":"堇摇了摇头。","style":3,"background":1021,"log_type":1,"src_id":230303054,"trial_step":54},{"step":55,"speaker":"堇","content":"请不用……管我，这是花园的事情，与您无关。","style":1,"background":1021,"log_type":1,"src_id":230303055,"trial_step":55},{"step":56,"speaker":"堇","content":"我只希望您能离开这里。","style":1,"background":1021,"log_type":1,"src_id":230303056,"trial_step":56},{"step":57,"content":"堇挣开你的手，又一次站起来，面向业师。","style":3,"background":1021,"log_type":1,"src_id":230303057,"trial_step":57},{"step":58,"speaker":"堇","content":"一切的错，都只在我……","style":1,"background":1021,"log_type":1,"src_id":230303058,"trial_step":58},{"step":59,"speaker":"堇","content":"我从未向您祈求过什么……但请，放过他……","female_content":"我从未向您祈求过什么……但请，放过她……","style":1,"background":1021,"log_type":1,"src_id":230303059,"trial_step":59},{"step":60,"content":"良久，纸门后的人都没有做出任何反应。","style":3,"background":1021,"log_type":1,"src_id":230303060,"trial_step":60},{"step":61,"content":"你不能就这么扶起堇逃跑——此时此刻，将后背就这样暴露给那位恐怖的业师，与送死无异。","style":3,"background":1021,"log_type":1,"src_id":230303061,"trial_step":61},{"step":62,"content":"你还有最后一张底牌。可在这么远的距离下，走廊前还有两人，发动枷锁的能力或许只会让你死得更有尊严一些。","style":3,"background":1021,"log_type":1,"src_id":230303062,"trial_step":62},{"step":63,"content":"就在你思考破局的方法时，业师发话了。","style":3,"background":1021,"log_type":1,"src_id":230303063,"trial_step":63},{"step":64,"speaker":"业师","content":"……罢了，这个人的死活，我本就不关心。","style":1,"background":1021,"log_type":1,"src_id":230303064,"trial_step":64},{"step":65,"speaker":"业师","content":"但堇，你留下。","style":1,"background":1021,"log_type":1,"src_id":230303065,"trial_step":65},{"step":66,"speaker":"堇","content":"谢谢……","style":1,"background":1021,"log_type":1,"src_id":230303066,"trial_step":66},{"step":67,"content":"没有半点犹豫，堇的脸上露出释然的笑，向业师伸出了手。","style":3,"background":1021,"log_type":1,"src_id":230303067,"trial_step":67},{"step":68,"content":"或许是因为失血过多，堇的手在月光之下显得异常苍白。","style":3,"background":1021,"log_type":1,"src_id":230303068,"trial_step":68},{"step":69,"content":"在你不知情的前提下，堇替你挡下了一波又一波刺杀。现在，她又试图为你舍弃自己。","style":3,"background":1021,"log_type":1,"src_id":230303069,"trial_step":69},{"step":70,"content":"这一次，不能再让她这样牺牲了。","style":3,"background":1021,"log_type":1,"src_id":230303070,"trial_step":70},{"step":71,"content":"堇必须跟我回去，她是我的禁闭者。","style":2,"background":1021,"log_type":1,"src_id":230303071,"trial_step":71},{"step":72,"options":["使用枷锁"],"style":6,"background":1021,"log_type":1,"src_id":230303072,"trial_step":72,"course":3,"choices":[{"text":"使用枷锁","goto":73}]},{"step":73,"content":"你伸出手，竭尽全力施放枷锁，试图跨过面前的距离触及到门后的女人。然而，仅在一瞬之间，你的左手便传来剧痛，无力地垂在身边，怎么也不听使唤。","style":3,"background":1021,"log_type":1,"src_id":230303073,"trial_step":73},{"step":74,"content":"幸好，今天早些时候，你就已经习惯毒剂带给你的疼痛了。","style":3,"background":1021,"log_type":1,"src_id":230303074,"trial_step":74},{"step":75,"content":"自始至终，业师的影子就像印在纸门上一样，从未移动过。你连她是如何伤害到你和堇的，都无法察觉。","style":3,"background":1021,"log_type":1,"src_id":230303075,"trial_step":75},{"step":76,"speaker":"业师","content":"我给你最后一次机会。","style":1,"background":1021,"log_type":1,"src_id":230303076,"trial_step":76},{"step":77,"speaker":"业师","content":"离开。","style":1,"background":1021,"log_type":1,"src_id":230303077,"trial_step":77},{"step":78,"content":"无比恐怖的气势向你袭来，四周仿佛都暗了下去。杀气盛满了这座小小的庭院。无法想象，这位自称业师的女人，究竟有多么强大。","style":3,"background":1021,"log_type":1,"src_id":230303078,"trial_step":78},{"step":79,"content":"你全身的每一个细胞都在不安地嚣叫着，催促你逃跑。可在这种骇人的压力之下，你的神志也变得前所未有的清醒。","style":3,"background":1021,"log_type":1,"src_id":230303079,"trial_step":79},{"step":80,"options":["不要抛下堇"],"style":6,"background":1021,"log_type":1,"src_id":230303080,"trial_step":80,"course":3,"choices":[{"text":"不要抛下堇","goto":81}]},{"step":81,"content":"可怖的气势近乎凝结滴落。","style":3,"background":10000,"log_type":1,"src_id":230303081,"trial_step":81},{"step":82,"content":"可你始终没有后退一步。","style":3,"background":10000,"log_type":1,"src_id":230303082,"trial_step":82},{"step":83,"content":"你紧紧握住了堇的手。","style":3,"background":10000,"log_type":1,"src_id":230303083,"trial_step":83},{"step":84,"speaker":"业师","content":"这就是你的选择吗，堇？","style":1,"background":10000,"log_type":1,"src_id":230303084,"trial_step":84},{"step":85,"speaker":"业师","content":"你终究会遭受背叛。","style":1,"background":10000,"log_type":1,"src_id":230303085,"trial_step":85},{"step":86,"speaker":"堇","content":"我……不在乎。","style":1,"background":10000,"log_type":1,"src_id":230303086,"trial_step":86},{"step":87,"content":"……","style":2,"background":10000,"log_type":1,"src_id":230303087,"trial_step":87},{"step":88,"content":"当你反应过来的时候，对面走廊上的两个人已经不见，和室里的烛火也熄灭了。","style":3,"background":1021,"log_type":1,"src_id":230303088,"trial_step":88},{"step":89,"content":"庭院里，只剩下你和堇，以及漫天飘散的花瓣。","style":3,"background":1021,"log_type":1,"src_id":230303089,"trial_step":89},{"step":90,"speaker":"堇","content":"……","style":1,"background":1021,"log_type":1,"src_id":230303090,"trial_step":90},{"step":91,"content":"不知为何，业师似乎放过了你们。","style":3,"background":1021,"log_type":1,"src_id":230303091,"trial_step":91},{"step":92,"content":"堇跪坐在地上，你们的手，还紧紧握在一起。","style":3,"background":1021,"log_type":1,"src_id":230303092,"trial_step":92},{"step":93,"content":"你艰难起身，搀着堇试图离开。可身体已经不足以支撑你再做出任何行动。","style":3,"background":1021,"log_type":1,"src_id":230303093,"trial_step":93},{"step":94,"content":"你跌坐在庭院中心的巨大白色花树之下。","style":3,"background":1021,"log_type":1,"src_id":230303094,"trial_step":94},{"step":95,"content":"或许是毒剂影响了你的心智。你今天做出了太多无谋的行为。","style":3,"background":1021,"log_type":1,"src_id":230303095,"trial_step":95},{"step":96,"content":"你感到无比疲惫，周围的一切，都开始变得模糊起来。","style":3,"background":1021,"log_type":1,"src_id":230303096,"trial_step":96},{"step":97,"content":"抱歉，我有些累。","style":2,"background":1021,"log_type":1,"src_id":230303097,"trial_step":97},{"step":98,"content":"稍微……等我一会儿。","style":2,"background":1021,"log_type":1,"src_id":230303098,"trial_step":98},{"step":99,"content":"堇拭去嘴角的鲜血，没有说话，只是坐在树下，微笑着让你靠到她的腿上。","style":3,"background":1021,"log_type":1,"src_id":230303099,"trial_step":99},{"step":100,"content":"花瓣纷飞，堇撑开了伞。月色充斥着整个庭院，让人感到极其不真实。","style":3,"background":1021,"log_type":1,"src_id":230303100,"trial_step":100},{"step":101,"content":"感觉，就像一场梦一样……","style":2,"background":1021,"log_type":1,"src_id":230303101,"trial_step":101},{"step":102,"speaker":"堇","content":"说不定就是一场梦呢。","style":1,"background":1021,"log_type":1,"src_id":230303102,"trial_step":102},{"step":103,"speaker":"堇","content":"您就睡在这里吧，醒了就都过去了。别担心，我会保护好您的。","style":1,"background":1021,"log_type":1,"src_id":230303103,"trial_step":103},{"step":104,"options":["是我会保护你"],"style":6,"background":1021,"log_type":1,"src_id":230303104,"trial_step":104,"course":3,"choices":[{"text":"是我会保护你","goto":105}]},{"step":105,"speaker":"堇","content":"好的，您会保护我的。","style":1,"background":1021,"log_type":1,"src_id":230303105,"trial_step":105},{"step":106,"content":"你好像一点也不相信。","style":2,"background":1021,"log_type":1,"src_id":230303106,"trial_step":106},{"step":107,"speaker":"堇","content":"我从来没有怀疑过您。","style":1,"background":1021,"log_type":1,"src_id":230303107,"trial_step":107},{"step":108,"content":"好吧……可是为什么呢？","style":2,"background":1021,"log_type":1,"src_id":230303108,"trial_step":108},{"step":109,"content":"算了……","style":2,"background":1021,"log_type":1,"src_id":230303109,"trial_step":109},{"step":110,"content":"你看着堇微笑的脸庞，觉得现在问问题未免有些无趣。","style":3,"background":1021,"log_type":1,"src_id":230303110,"trial_step":110},{"step":111,"content":"你忽然想起业师的话……那个关于背叛的“预言”。","style":3,"background":1021,"log_type":1,"src_id":230303111,"trial_step":111},{"step":112,"content":"我不会背叛你的。","style":2,"background":1021,"log_type":1,"src_id":230303112,"trial_step":112},{"step":113,"speaker":"堇","content":"我知道。","style":1,"background":1021,"log_type":1,"src_id":230303113,"trial_step":113},{"step":114,"content":"堇笑了笑。停顿了半刻，她抬头看向天空。","style":3,"background":1021,"log_type":1,"src_id":230303114,"trial_step":114},{"step":115,"speaker":"堇","content":"今晚的月色，很美。","style":1,"background":1021,"log_type":1,"src_id":230303115,"trial_step":115}]}