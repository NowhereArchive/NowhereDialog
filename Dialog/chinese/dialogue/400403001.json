{"id":400403001,"chapter_id":50016,"scene_id":51636,"steps":[{"step":1,"speaker":"嗷呜","content":"嗯哼~让我看看，剧组成员到齐没有~","voice":["vo_event_400403001_1"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":2,"speaker":"嗷呜","content":"全——体——点——名！","voice":["vo_event_400403001_2"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":3,"speaker":"嗷呜","content":"摄影师——琳！","voice":["vo_event_400403001_3"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":4,"speaker":"琳","content":"我在……","voice":["vo_event_400403001_4"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":5,"speaker":"嗷呜","content":"音频组——洛芙和黛丝！","voice":["vo_event_400403001_5"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":6,"speaker":"洛芙","content":"嘿嘿，到！","voice":["vo_event_400403001_6"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":7,"speaker":"黛丝","content":"这种点名真的有必要吗……","voice":["vo_event_400403001_7"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":8,"speaker":"嗷呜","content":"咳咳，导演讲话的时候，其他人不要插话。","voice":["vo_event_400403001_8"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":9,"speaker":"嗷呜","content":"最后，我们的笨蛋场记——${PlayerName}！","voice":["vo_event_400403001_9"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":10,"options":["到！","你叫我？"],"jump":[11,13],"style":6,"background":2051,"log_type":1},{"step":11,"speaker":"嗷呜","content":"哎嘿嘿，很有精神！保持这个劲头，以后说不定可以把你提拔为正式场记！","voice":["vo_event_400403001_12"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":13,"speaker":"嗷呜","content":"嗯？怎么这么有气无力的？你到底还想不想出人头地，早日转正了？","voice":["vo_event_400403001_13"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":14,"speaker":"星仔","content":"唔唔——","voice":["vo_event_400403001_14"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":15,"speaker":"嗷呜","content":"嘿嘿~差点把你给忘啦。我们的大明星——星仔！","voice":["vo_event_400403001_15"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":16,"speaker":"洛芙","content":"额——谁？","voice":["vo_event_400403001_16"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":17,"content":"少女把捡来的小动物抱在怀里，轻轻摇晃着。","style":3,"background":2051,"log_type":1},{"step":18,"speaker":"嗷呜","content":"星仔是一只最最神奇的动物，来自很远很远的地方！","voice":["vo_event_400403001_18"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":19,"speaker":"嗷呜","content":"不过，它和自己的家人走散啦，我们要把它送回家人身边！","voice":["vo_event_400403001_19"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":20,"speaker":"嗷呜","content":"这个感人的故事，正是我们的电影主题！现在我宣布——星仔大电影——正式开拍！","voice":["vo_event_400403001_20"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":21,"speaker":"洛芙","content":"好哎！","voice":["vo_event_400403001_21"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":22,"speaker":"星仔","content":"唔！唔！","voice":["vo_event_400403001_22"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":23,"content":"现场传来稀稀拉拉的掌声。","style":3,"background":2051,"log_type":1},{"step":24,"speaker":"嗷呜","content":"嗯？为什么掌声不够热烈？一定有人在鼓掌的时候偷懒了！","voice":["vo_event_400403001_25"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":25,"content":"我觉得剧本还需要加入一些反转和高潮。","style":2,"background":2051,"log_type":1},{"step":26,"content":"否则没头没尾，太过平淡，观众不会喜欢的。","style":2,"background":2051,"log_type":1},{"step":27,"speaker":"嗷呜","content":"咦？什么反转？笨蛋场记你快告诉我！","voice":["vo_event_400403001_28"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":28,"content":"比如，星仔看起来人畜无害，实际上是一个非常危险的太空间谍。","style":2,"background":2051,"log_type":1},{"step":29,"content":"而且会有一些——比如，嗯，时空警察，会过来抓它！","style":2,"background":2051,"log_type":1},{"step":30,"speaker":"嗷呜","content":"时空警察？什么样的时空警察？","voice":["vo_event_400403001_31"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":31,"content":"就是一些穿着科幻装备的鸭子，负责维护多元宇宙的平衡，之类之类的。","style":2,"background":2051,"log_type":1},{"step":32,"speaker":"黛丝","content":"这是你想出来的人设？看来你真的不适合当编剧……","voice":["vo_event_400403001_33"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":33,"speaker":"嗷呜","content":"嗯……我想想……嗨呀，笨蛋场记你还是有些想法的嘛！","voice":["vo_event_400403001_34"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":34,"content":"少女一下子跳到了你的面前。","style":3,"background":2051,"log_type":1},{"step":35,"speaker":"嗷呜","content":"有人来抓星仔的话就更好了！这样我们的电影不仅有了反派，还有了故事冲突，肯定精彩！剧本可以这样写——","voice":["vo_event_400403001_36"],"voice_bank":"vo_event_04030","style":1,"background":2051,"log_type":1},{"step":36,"content":"就在嗷呜滔滔不绝地讲着时空警察鸭抓捕小兽的剧本时，你注意到星仔一直在盯着你，不服气似地抖了抖耳朵。","style":3,"background":2051,"log_type":1},{"step":37,"content":"与此同时，狄莱坞的另一边。","style":3,"background":10000,"log_type":1},{"step":38,"content":"一阵炫目的光照亮了狄莱坞的后巷，仿佛时空撕裂般，几个传送门凭空出现。","style":3,"background":2016,"log_type":1},{"step":41,"content":"奇怪的鸭子从传送门中陆续走出，身上挂满了各式各样的装备，嘴里嘎嘎嘎嘎地说着些什么。","style":3,"background":2016,"log_type":1},{"step":42,"speaker":"鸭子长官","content":"嘎嘎嘎嘎，嘎嘎！嘎嘎嘎！\n（时空警队，全体集合！现在开始点名！）","voice":["vo_event_400403001_42"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":43,"content":"为首的鸭子站在众多鸭子前面，看起来像是长官的样子。","style":3,"background":2016,"log_type":1},{"step":44,"speaker":"鸭子长官","content":"嘎嘎！\n（偶宝！）","voice":["vo_event_400403001_44"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":45,"speaker":"偶宝","content":"嘎！\n（到！）","voice":["vo_event_400403001_45"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":46,"speaker":"鸭子长官","content":"嘎嘎！\n（笑宝！）","voice":["vo_event_400403001_46"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":47,"speaker":"笑宝","content":"嘎！\n（到！）","voice":["vo_event_400403001_47"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":48,"speaker":"鸭子长官","content":"嘎嘎！\n（啦宝！）","voice":["vo_event_400403001_48"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":49,"speaker":"鸭子长官","content":"嘎嘎？\n（啦宝？）","voice":["vo_event_400403001_49"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":50,"speaker":"鸭子长官","content":"嘎嘎！！！\n（啦宝！！！）","voice":["vo_event_400403001_50"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":51,"speaker":"啦宝","content":"嘎嘎嘎！\n（来啦！）","voice":["vo_event_400403001_51"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":52,"content":"被长官叫了好几次名字后，戴红色围巾，梳着拉风发型的鸭子才姗姗来迟。","style":3,"background":2016,"log_type":1},{"step":53,"speaker":"啦宝","content":"嘎嘎，嘎嘎嘎嘎，嘎嘎。\n（嘎嘎，主角总是会晚一点登场的，对吧长官。）","voice":["vo_event_400403001_53"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":54,"speaker":"鸭子长官","content":"嘎嘎嘎嘎！嘎嘎！\n（主角你个鸭头鬼！快给我归队！）","voice":["vo_event_400403001_54"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":55,"content":"迟到的鸭子被长官狠狠踢了一下屁股。","style":3,"background":2016,"log_type":1},{"step":56,"speaker":"鸭子长官","content":"嘎嘎，嘎嘎嘎嘎嘎，嘎嘎嘎！\n（好了，战术小组全员到位，“猎星行动”正式开始。）","voice":["vo_event_400403001_56"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":57,"speaker":"鸭子长官","content":"嘎嘎嘎嘎嘎，嘎嘎嘎嘎嘎，嘎嘎嘎嘎！\n（为了无限时空的稳定，为了多元宇宙的平衡，献出羽翼吧！）","voice":["vo_event_400403001_57"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":58,"speaker":"鸭子们","content":"嘎嘎！\n（献出羽翼吧！）","voice":["vo_event_400403001_58"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":59,"content":"【转场】","style":18,"background":2041,"log_type":1},{"step":60,"speaker":"星仔","content":"咕……","voice":["vo_event_400403001_60"],"voice_bank":"vo_event_04030","style":1,"background":2041,"log_type":1},{"step":61,"speaker":"嗷呜","content":"咦？你在害怕吗？","voice":["vo_event_400403001_61"],"voice_bank":"vo_event_04030","style":1,"background":2041,"log_type":1},{"step":62,"speaker":"星仔","content":"咕呜……","voice":["vo_event_400403001_62"],"voice_bank":"vo_event_04030","style":1,"background":2041,"log_type":1},{"step":63,"speaker":"嗷呜","content":"没关系的，不管是谁来了，嗷呜都会保护你！","voice":["vo_event_400403001_63"],"voice_bank":"vo_event_04030","style":1,"background":2041,"log_type":1},{"step":64,"speaker":"嗷呜","content":"敢欺负你的人，嗷呜就用这个狮子头……嘿呀，嗨呀，统统打走！","voice":["vo_event_400403001_64"],"voice_bank":"vo_event_04030","style":1,"background":2041,"log_type":1},{"step":65,"content":"不知为什么，嗷呜朝你的方向瞪了一眼。","style":3,"background":2041,"log_type":1},{"step":66,"speaker":"星仔","content":"咕呜，呜呜……","voice":["vo_event_400403001_66"],"voice_bank":"vo_event_04030","style":1,"background":2041,"log_type":1},{"step":67,"speaker":"嗷呜","content":"喂喂，别走！你去哪里呀！","voice":["vo_event_400403001_67"],"voice_bank":"vo_event_04030","style":1,"background":2041,"log_type":1},{"step":68,"speaker":"琳","content":"我们……要跟上她吗？","voice":["vo_event_400403001_68"],"voice_bank":"vo_event_04030","style":1,"background":2041,"log_type":1},{"step":69,"speaker":"洛芙","content":"没关系，好久没有见过这么精力充沛的小鬼了，让她闹吧。","voice":["vo_event_400403001_69"],"voice_bank":"vo_event_04030","style":1,"background":2041,"log_type":1},{"step":70,"content":"狄莱坞的小巷子里，小兽与一群奇怪的鸭子对峙着。","style":3,"background":2016,"log_type":1},{"step":72,"speaker":"嗷呜","content":"呼哧，呼哧，原来你在这里呀——哎，这些鸭子……好奇怪！","voice":["vo_event_400403001_72"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":73,"speaker":"星仔","content":"咕呜呜，呜呜！","voice":["vo_event_400403001_73"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":74,"speaker":"鸭子长官","content":"嘎嘎，嘎嘎……\n（人类，小心这只……）","voice":["vo_event_400403001_74"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":75,"speaker":"啦宝","content":"嘎嘎嘎嘎，嘎嘎嘎嘎嘎。\n（没关系啦长官，她只是一个小孩子而已。）","voice":["vo_event_400403001_75"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":76,"speaker":"啦宝","content":"嘎嘎，嘎嘎嘎嘎，嘎嘎嘎嘎嘎！\n（喂喂，我们要把这只星兽带走，小孩子不可以添乱！）","voice":["vo_event_400403001_76"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":77,"speaker":"嗷呜","content":"你们在嘎嘎嘎嘎地叫什么？我听不懂！","voice":["vo_event_400403001_77"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":78,"speaker":"嗷呜","content":"不过，你们挺像笨蛋场记说的时空警察！原来你们真的存在吗？","voice":["vo_event_400403001_78"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":79,"speaker":"鸭子长官","content":"嘎？嘎嘎嘎嘎！\n（奇怪！这个孩子听不懂我们说话！）","voice":["vo_event_400403001_79"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":80,"speaker":"鸭子长官","content":"嘎嘎嘎嘎嘎？\n（时空翻译机在谁身上？）","voice":["vo_event_400403001_80"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":81,"content":"鸭子们纷纷指向那只戴红围巾的家伙。","style":3,"background":2016,"log_type":1},{"step":82,"speaker":"啦宝","content":"嘎嘎嘎嘎，嘎嘎嘎，嘎嘎……\n（我今天出门有点急，好像忘记带了，嘎嘎……）","voice":["vo_event_400403001_82"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1},{"step":83,"speaker":"众鸭子","content":"……\n（……）","style":1,"background":2016,"log_type":1},{"step":84,"content":"少女一把抱起小兽，好奇地看着眼前的鸭子。","style":3,"background":2016,"log_type":1},{"step":85,"speaker":"嗷呜","content":"喂，星仔，这些鸭子好奇怪呀。不过，我已经想好电影要怎么拍啦！","voice":["vo_event_400403001_85"],"voice_bank":"vo_event_04030","style":1,"background":2016,"log_type":1}]}