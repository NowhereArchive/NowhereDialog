{"id":404009102,"chapter_id":30001,"scene_id":30038,"steps":[{"step":1,"speaker":"德雷雅","content":"侵蚀情况比想象中的严重……","voice":["vo_event_404009102_01"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":2,"content":"到达指定海岸的德雷雅正认真记录着天体的动向，然而……","style":3,"background":1015,"log_type":1},{"step":3,"speaker":"白逸","content":"呕——","voice":["vo_event_404009102_03"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":4,"content":"一旁的白逸早已吐得天昏地暗。","style":3,"background":1015,"log_type":1},{"step":5,"speaker":"白逸","content":"下次……能不能……找艘船……呕——你这一会儿快……一会儿慢的……","voice":["vo_event_404009102_04"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":6,"speaker":"简","content":"给，晕车药。","voice":["vo_event_404009102_05"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":7,"speaker":"白逸","content":"……谢谢。","voice":["vo_event_404009102_06"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":8,"speaker":"德雷雅","content":"已经观测到31种未知星团，尽管这里并非狄斯，但发生这种事情还是……","voice":["vo_event_404009102_07"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":9,"speaker":"德雷雅","content":"令人振奋。","voice":["vo_event_404009102_08"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":10,"speaker":"选项","options":["……我们是来解决狂厄的"],"jump":[11],"style":6,"background":1015,"log_type":1},{"step":11,"speaker":"德雷雅","content":"抱歉，看到如此多的未知星体，就算是我也会分心。","voice":["vo_event_404009102_10"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":12,"content":"德雷雅将观测望远镜移回狂厄区域，重新观察着这片空间。","style":3,"background":1015,"log_type":1},{"step":13,"content":"你看着面前的德雷雅，心里却升起了一丝莫名的不安。她的神情依旧专注，言语也没有什么异常，可在那平静的外表下，仿佛有什么细微的东西与以往不同。","style":3,"background":1015,"log_type":1},{"step":14,"content":"是行为吗？好像不是。来到新环境一定会做出以往不曾做出过的事情的，你一时难以说清那不同是什么。","style":3,"background":1015,"log_type":1},{"step":15,"content":"或许是她语气中隐约的激动，或许是她动作间偶尔的停顿，又或许只是你自己的错觉。","style":3,"background":1015,"log_type":1},{"step":16,"content":"在漫长的沉默后，德雷雅终于说出了一句话。","style":3,"background":1015,"log_type":1},{"step":17,"speaker":"德雷雅","content":"西侧海域。","voice":["vo_event_404009102_12"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":18,"speaker":"白逸","content":"呕……我就说吧……交给她保准没问题的……呕……","voice":["vo_event_404009102_14"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":19,"content":"一旁的白逸在简的搀扶下一边呕吐一边不吝夸赞。","style":3,"background":1015,"log_type":1},{"step":20,"speaker":"德雷雅","content":"观测到狂厄的聚集地，其影响范围正缓慢向东蔓延。","voice":["vo_event_404009102_16"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":21,"speaker":"德雷雅","content":"狂厄侵蚀的速度在递增，我们要尽快行动。","voice":["vo_event_404009102_17"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1},{"step":22,"speaker":"德雷雅","content":"局长，请下命令。","voice":["vo_event_404009102_18"],"voice_bank":"vo_event_40091","style":1,"background":1015,"log_type":1}]}