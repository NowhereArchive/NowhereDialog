{"id":1010203,"chapter_id":1010203,"scene_id":1,"steps":[{"step":1,"speaker":"夜莺","content":"您所要前往的方向距离MBCC有相当遥远的车程。我们已经在沿途驿站安排了人手，如果有任何需求都请及时保持联络。","voice":["vo_trial_10203_1_1"],"voice_bank":"vo_owo_trial","style":11,"background":1018,"log_type":1,"src_id":110203001,"trial_step":1},{"step":2,"content":"整整叮嘱了五分钟，夜莺才终于暂时切断了通讯。","style":3,"background":1018,"log_type":1,"src_id":110203002,"trial_step":2},{"step":3,"content":"一个总是能孤身闯入陷阱的成年人，带着两个半大的小鬼，前往主城区外未知的村落。这确实是一趟值得夜莺如此担忧的出行。","style":3,"background":1018,"log_type":1,"src_id":110203003,"trial_step":3},{"step":4,"content":"尽管狮头已经找到，但你身为场记兼司机兼监护人的工作还没有结束，你不可能真的放任他俩自己踏上这趟未卜的寻乡之旅。","style":3,"background":1018,"log_type":1,"src_id":110203004,"trial_step":4},{"step":5,"speaker":"男孩","content":"我叫贝格利。","voice":["vo_trial_10203_1_2"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203005,"trial_step":5},{"step":6,"speaker":"嗷呜","content":"被格叽？北蛤蜊？唔，都不如嗷呜的名字，又好记又好听！","voice":["vo_trial_10203_1_3"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203006,"trial_step":6},{"step":7,"speaker":"贝格利","content":"哼，嗷呜算什么好名字，顶多算个语气词！我的名字可是有含义的！","voice":["vo_trial_10203_1_4"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203007,"trial_step":7},{"step":8,"content":"这趟旅途的两位始作俑者显然没有察觉到你的无奈与担忧，一路拌嘴。","style":3,"background":1018,"log_type":1,"src_id":110203008,"trial_step":8},{"step":9,"speaker":"嗷呜","content":"嗷呜的含义就是嗷呜！那你说说你的名字是什么意思！","voice":["vo_trial_10203_1_5"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203009,"trial_step":9},{"step":10,"speaker":"贝格利","content":"我……我不记得了。","voice":["vo_trial_10203_1_6"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203010,"trial_step":10},{"step":11,"speaker":"贝格利","content":"我在那么一丁点大的时候，就被爸妈塞进了商队偷渡的车，一个人去了狄斯。还没来得及学我们那里的文字。","voice":["vo_trial_10203_1_7"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203011,"trial_step":11},{"step":12,"content":"贝格利趴在车窗边，望着窗外茫茫无垠的白沙。","style":3,"background":1018,"log_type":1,"src_id":110203012,"trial_step":12},{"step":13,"speaker":"贝格利","content":"我只知道那是个沿着狄斯东南方向行进的商队，我家肯定就在这个方向。","voice":["vo_trial_10203_1_8"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203013,"trial_step":13},{"step":14,"speaker":"贝格利","content":"那是一个能在沙漠里长出草地的地方，路上还会开着好看的紫色的花。","voice":["vo_trial_10203_1_9"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203014,"trial_step":14},{"step":15,"content":"贝格利没有再继续说下去。这可能已经是他能回忆起来的全部了……","style":3,"background":1018,"log_type":1,"src_id":110203015,"trial_step":15},{"step":16,"speaker":"嗷呜","content":"沙漠里能长出草地有什么了不起的，我嗷呜可是能在沙路上打坏蛋呢！","voice":["vo_trial_10203_1_10"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203016,"trial_step":16},{"step":17,"speaker":"贝格利","content":"又是什么骗人的电影情节？","voice":["vo_trial_10203_1_11"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203017,"trial_step":17},{"step":18,"speaker":"嗷呜","content":"不是电影，是真实发生的！就在我回家乡的路上，突然！","voice":["vo_trial_10203_1_12"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203018,"trial_step":18},{"step":19,"speaker":"嗷呜","content":"杀出了一队长着大胡子的大叔！","voice":["vo_trial_10203_1_13"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203019,"trial_step":19},{"step":20,"content":"嗷呜清清嗓子压低声音，努力扮演起坏蛋大叔的腔调。","style":3,"background":1018,"log_type":1,"src_id":110203020,"trial_step":20},{"step":21,"speaker":"嗷呜","content":"咳，那边那个小鬼，说的就是你！拿着狮头看起来威风凛凛的那个！","voice":["vo_trial_10203_1_14"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203021,"trial_step":21},{"step":22,"speaker":"嗷呜","content":"快，把星兽交出来，我们饶你不死！","voice":["vo_trial_10203_1_15"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203022,"trial_step":22},{"step":23,"speaker":"贝格利","content":"威风凛凛这句肯定是你自己加的吧……","voice":["vo_trial_10203_1_16"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203023,"trial_step":23},{"step":24,"speaker":"嗷呜","content":"切，不信拉倒！反正他们就是被我和我的狮头赶跑了！","voice":["vo_trial_10203_1_17"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203024,"trial_step":24},{"step":25,"speaker":"嗷呜","content":"我就这样，拿着狮头，挡在星兽前面，然后在心里默念——","voice":["vo_trial_10203_1_18"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203025,"trial_step":25},{"step":26,"speaker":"嗷呜","content":"我要成为什么什么一面的大英雄！","voice":["vo_trial_10203_1_19"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203026,"trial_step":26},{"step":27,"content":"独当一面……","style":2,"background":1018,"log_type":1,"src_id":110203027,"trial_step":27},{"step":28,"speaker":"嗷呜","content":"没错！我要成为独当的大英雄！","voice":["vo_trial_10203_1_20"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203028,"trial_step":28},{"step":29,"speaker":"嗷呜","content":"然后，“咻”的一下，就有一股金色的、暖洋洋的光，从狮头的方向照下来。","voice":["vo_trial_10203_1_21"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203029,"trial_step":29},{"step":30,"speaker":"嗷呜","content":"就那一瞬间，这个狮头轻得就像没有重量一样！也是那一瞬间，好像有个声音在我脑子里跟我说话！","voice":["vo_trial_10203_1_22"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203030,"trial_step":30},{"step":31,"speaker":"贝格利","content":"说了什么？","voice":["vo_trial_10203_1_23"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203031,"trial_step":31},{"step":32,"content":"此前一直看着窗外的贝格利已经回过头，完全被车内嗷呜的故事吸引。","style":3,"background":1018,"log_type":1,"src_id":110203032,"trial_step":32},{"step":33,"speaker":"嗷呜","content":"它说——","voice":["vo_trial_10203_1_24"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203033,"trial_step":33},{"step":34,"content":"嗷呜就像在传递什么不得了的秘密一样小心地凑到贝格利耳边。","style":3,"background":1018,"log_type":1,"src_id":110203034,"trial_step":34},{"step":35,"speaker":"嗷呜","content":"它说：“嗷呜，大声吓退他们！”","voice":["vo_trial_10203_1_25"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203035,"trial_step":35},{"step":36,"speaker":"贝格利","content":"成功了？","voice":["vo_trial_10203_1_26"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203036,"trial_step":36},{"step":37,"speaker":"嗷呜","content":"当然，那可是狮头的力量！那群大叔“咻”地一下就被我的力量撞得七零八落啦！","voice":["vo_trial_10203_1_27"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203037,"trial_step":37},{"step":38,"content":"贝格利看着狮头，眼里重新又闪起期许的光亮。","style":3,"background":1018,"log_type":1,"src_id":110203038,"trial_step":38},{"step":39,"content":"看到唯一的听众来了兴致，嗷呜更是一口气添油加醋地将自己如何一路奔波抵达金猊乡的过程演绎了一遍。","style":3,"background":1018,"log_type":1,"src_id":110203039,"trial_step":39},{"step":40,"speaker":"贝格利","content":"所以……你没有骗人，你真的靠舞狮的力量找回了家乡？","voice":["vo_trial_10203_1_28"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203040,"trial_step":40},{"step":41,"speaker":"嗷呜","content":"当然啦，狮子真的可以带我回家，骗你做咩呀！","voice":["vo_trial_10203_1_29"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203041,"trial_step":41},{"step":42,"speaker":"嗷呜","content":"我还在家乡看到了各种各样的狮头呢！有不同的颜色，不同的花纹，也有更适合你这种干瘦小身板的小狮子！","voice":["vo_trial_10203_1_30"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203042,"trial_step":42},{"step":43,"speaker":"贝格利","content":"我不是干瘦！我就是……胃口比较小！","voice":["vo_trial_10203_1_31"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203043,"trial_step":43},{"step":44,"speaker":"嗷呜","content":"那可不行！舞狮是很耗体力的！一定要吃得多，睡得香，好好训练！","voice":["vo_trial_10203_1_32"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203044,"trial_step":44},{"step":45,"speaker":"贝格利","content":"要是我家也有这样有意思的文化，我当然也会好好吃饭睡觉的！","voice":["vo_trial_10203_1_33"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203045,"trial_step":45},{"step":46,"speaker":"嗷呜","content":"你对舞狮感兴趣？很有眼光啊！想要当天才神童嗷呜的狮尾吗？只要叫我一声师傅我就可以考虑哦！","voice":["vo_trial_10203_1_34"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203046,"trial_step":46},{"step":47,"speaker":"贝格利","content":"谁要当你徒弟了！说不定我家乡的文化更有意思呢！","voice":["vo_trial_10203_1_35"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203047,"trial_step":47},{"step":48,"speaker":"嗷呜","content":"世界上不存在比舞狮更有意思的事！如果有，一定是因为你没有亲眼见过点睛仪式！","voice":["vo_trial_10203_1_36"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203048,"trial_step":48},{"step":49,"speaker":"贝格利","content":"“点睛”？","voice":["vo_trial_10203_1_37"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203049,"trial_step":49},{"step":50,"speaker":"嗷呜","content":"就是给狮头画上最后几笔，让狮子活过来的仪式！点在不同位置都有不一样的寓意！","voice":["vo_trial_10203_1_38"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203050,"trial_step":50},{"step":51,"speaker":"嗷呜","content":"很小很小的时候，听到过我爸爸和他朋友们喝醉酒念叨一段点睛顺口溜。我记得好像是这样唱的……","voice":["vo_trial_10203_1_39"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203051,"trial_step":51},{"step":52,"content":"平时明明连个四字词语都记不住，说起舞狮相关的话题，嗷呜好像觉醒了血脉中流淌着的记忆般，不自觉就将彩词背了出来。","style":3,"background":1018,"log_type":1,"src_id":110203052,"trial_step":52},{"step":53,"speaker":"嗷呜","content":"一点左眼金，金光闪闪；二点右眼银，银光灿灿；三点天庭，吉星高照，鸿运当头；四点狮嘴，天下安定，兴盛繁荣……","voice":["vo_trial_10203_1_40"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203053,"trial_step":53},{"step":54,"content":"载着一大二小的越野车就在这阵阵吉祥话的颂阅声中，于无边的白沙地里继续向东南穿行。","style":3,"background":1018,"log_type":1,"src_id":110203054,"trial_step":54},{"step":55,"content":"嗷呜也与新伙伴完全打开了话匣子，从儿时对故乡的记忆一路聊到重返金猊乡后的见闻。","style":3,"background":1018,"log_type":1,"src_id":110203055,"trial_step":55},{"step":56,"speaker":"嗷呜","content":"你知道吗，舞狮有很多不同的颜色，金的、黑的、蓝色的，它们都有不同的寓意。","voice":["vo_trial_10203_1_41"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203056,"trial_step":56},{"step":57,"speaker":"嗷呜","content":"每年的这个时候，都是金猊乡最热闹的时间，你能同时看到各种颜色的狮子在各个地方同时演出！","voice":["vo_trial_10203_1_42"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203057,"trial_step":57},{"step":58,"speaker":"嗷呜","content":"在金猊乡，这是时节就叫做新年！要用狮子的力量赶走所有坏东西，迎接吉祥、热闹的新一年！","voice":["vo_trial_10203_1_43"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203058,"trial_step":58},{"step":59,"content":"嗷呜说起金猊乡的新年，兴奋地在车里上蹿下跳，好像面前真有她所说的望不掉尽头的红灯笼与鞭炮。","style":3,"background":1018,"log_type":1,"src_id":110203059,"trial_step":59},{"step":60,"content":"贝格利艳羡地看着嗷呜分享着回忆，却还是有些不解。","style":3,"background":1018,"log_type":1,"src_id":110203060,"trial_step":60},{"step":61,"speaker":"贝格利","content":"过年那么好玩，那么热闹……那你为什么要回来呢？","voice":["vo_trial_10203_1_44"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203061,"trial_step":61},{"step":62,"speaker":"贝格利","content":"好不容易找到的，那么好的家乡，如果是我的话，一定舍不得离开。","voice":["vo_trial_10203_1_45"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203062,"trial_step":62},{"step":63,"content":"男孩无心的好奇却也问出了你一直没机会开口的疑惑，你静静期待着嗷呜的回答，但她好像确实被问住了。摸着下巴认真思考起来。","style":3,"background":1018,"log_type":1,"src_id":110203063,"trial_step":63},{"step":64,"speaker":"嗷呜","content":"我为什么要回来……为了告诉大家我已经是什么什么一面的大人了？","voice":["vo_trial_10203_1_46"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203064,"trial_step":64},{"step":65,"speaker":"贝格利","content":"这些靠写信和寄明信片也能做到吧？","voice":["vo_trial_10203_1_47"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203065,"trial_step":65},{"step":66,"speaker":"嗷呜","content":"对哦，一定还有什么必须回来的理由……","voice":["vo_trial_10203_1_48"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203066,"trial_step":66},{"step":67,"speaker":"贝格利","content":"啊，你快看！","voice":["vo_trial_10203_1_49"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203067,"trial_step":67},{"step":68,"content":"嗷呜没来得及细细思考就被贝格利的惊呼打断。","style":3,"background":1018,"log_type":1,"src_id":110203068,"trial_step":68},{"step":69,"speaker":"贝格利","content":"路边有紫色的花！是开在我家乡的花！","voice":["vo_trial_10203_1_50"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203069,"trial_step":69},{"step":70,"speaker":"嗷呜","content":"啊！好小一朵！真的有诶！场记场记快停车！","voice":["vo_trial_10203_1_51"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203070,"trial_step":70},{"step":71,"speaker":"贝格利","content":"我们到了！我们真的找到了！","voice":["vo_trial_10203_1_52"],"voice_bank":"vo_owo_trial","style":1,"background":1018,"log_type":1,"src_id":110203071,"trial_step":71},{"step":72,"content":"你车还未停稳，贝格利就迫不及待地跳了下去，扑向了路边的小花。","style":3,"background":1018,"log_type":1,"src_id":110203072,"trial_step":72},{"step":73,"content":"几簇有些干瘪的紫色花朵艰难地从戈壁中探出头，天灾带来的风沙几乎要榨干它最后一点生气。","style":3,"background":1055,"log_type":1,"src_id":110203073,"trial_step":73},{"step":74,"content":"贝格利能够一眼看见这些花或许真的得到了冥冥之中幸运的指引。毕竟它们在这片沙漠中实在太不起眼了。","style":3,"background":1055,"log_type":1,"src_id":110203074,"trial_step":74},{"step":75,"speaker":"贝格利","content":"没错，就是这种花！我跟着商队离开时就被藏在车底，我清楚记得村庄外的地上就长着这种花！","voice":["vo_trial_10203_1_53"],"voice_bank":"vo_owo_trial","style":1,"background":1055,"log_type":1,"src_id":110203075,"trial_step":75},{"step":76,"content":"这是贝格利这么多年来离故乡最近的一次，他激动得有些语无伦次，手忙脚乱地想要扶起这些奄奄一息的花茎。","style":3,"background":1055,"log_type":1,"src_id":110203076,"trial_step":76},{"step":77,"speaker":"贝格利","content":"村庄一定就在附近，不会有错的！","voice":["vo_trial_10203_1_54"],"voice_bank":"vo_owo_trial","style":1,"background":1055,"log_type":1,"src_id":110203077,"trial_step":77},{"step":78,"content":"你和嗷呜跟着贝格利下车，却一直保持着沉默。你们在已经看到了所谓的“村庄”。","style":3,"background":1055,"log_type":1,"src_id":110203078,"trial_step":78},{"step":79,"content":"那是沙幕之下，一座无比寂静的废墟。","style":3,"background":1055,"log_type":1,"src_id":110203079,"trial_step":79},{"step":80,"content":"没有贝格利回忆中的绿洲，更没有在绿洲里劳作的村民。","style":3,"background":1055,"log_type":1,"src_id":110203080,"trial_step":80},{"step":81,"content":"龟裂的大地和干枯的杂草，包裹着人去楼空的现实。","style":3,"background":1055,"log_type":1,"src_id":110203081,"trial_step":81},{"step":82,"content":"你们能看见的，贝格利当然也都看见了。但他只是低头专注地护住眼前的小花，口中一遍遍重复。","style":3,"background":1055,"log_type":1,"src_id":110203082,"trial_step":82},{"step":83,"speaker":"贝格利","content":"我终于找到了！它就在这里！我回家了！","voice":["vo_trial_10203_1_55"],"voice_bank":"vo_owo_trial","style":1,"background":1055,"log_type":1,"src_id":110203083,"trial_step":83}]}