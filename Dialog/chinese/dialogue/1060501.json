":160501114,"trial_step":114,"drawing":1060500},{"step":119,"content":"找到之后，你也能忍着痛“站起来”，从工厂里“走出去”。","style":2,"log_type":1,"src_id":160501115,"trial_step":115,"drawing":1060500},{"step":120,"content":"到底是再次回到美梦里沉睡，还是去看新的明天。等我回来，就告诉我你的答案吧。","style":2,"log_type":1,"src_id":160501116,"trial_step":116,"drawing":1060502},{"step":121,"content":"无论你的回答是什么，这一次，我都会支持你的。","style":2,"log_type":1,"src_id":160501117,"trial_step":117,"drawing":1060502},{"step":122,"content":"审查室的大门从外面打开了，夜莺带着一队警卫等待你的指示。","style":3,"log_type":1,"src_id":160501118,"trial_step":118,"drawing":1060502},{"step":123,"speaker":"夜莺","content":"送伊芙回诊所继续观测治疗的车也已经备好了。","voice":["vo_trial_60501_1_111"],"voice_bank":"vo_eve_trial","style":1,"log_type":1,"src_id":160501119,"trial_step":119,"drawing":1060502},{"step":124,"content":"好，我们也该出发了。","style":2,"log_type":1,"src_id":160501120,"trial_step":120,"drawing":1060502},{"step":125,"content":"医护人员进入审查室，帮助伊芙转移到轮椅上，但她的视线却全程跟随着你。","style":3,"log_type":1,"src_id":160501121,"trial_step":121,"drawing":1060502},{"step":126,"content":"那种不理解、震撼、好奇的眼神，一直追随着，直到大门关闭。","style":3,"log_type":1,"src_id":160501122,"trial_step":122,"drawing":1060502},{"step":127,"speaker":"伊芙","content":"支撑我走下去的理由……是什么呢？","voice":["vo_trial_60501_1_115"],"voice_bank":"vo_eve_trial","style":1,"log_type":1,"src_id":160501123,"trial_step":123,"drawing":1060502}]}