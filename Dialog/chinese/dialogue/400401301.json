{"id":400401301,"chapter_id":50016,"scene_id":51621,"steps":[{"step":1,"speaker":"嗷呜","content":"逃走的你找到了一个神秘的洞窟——洞窟中有村民的哭声，还有嗷呜大魔王的叫声。","voice":["vo_event_400401301_2"],"voice_bank":"vo_event_04013","style":1,"background":4041,"log_type":1},{"step":2,"speaker":"琳","content":"大家都怎么样了？难道大魔王在对他们——","voice":["vo_event_400401301_3"],"voice_bank":"vo_event_04013","style":1,"background":4041,"log_type":1},{"step":3,"speaker":"嗷呜","content":"你要不要去救他们呢~勇敢的女主角？","voice":["vo_event_400401301_4"],"voice_bank":"vo_event_04013","style":1,"background":4041,"log_type":1},{"step":4,"speaker":"琳","content":"我……","voice":["vo_event_400401301_5"],"voice_bank":"vo_event_04013","style":1,"background":4041,"log_type":1}]}