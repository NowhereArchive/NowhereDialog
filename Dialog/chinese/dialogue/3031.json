{"id":3031,"chapter_id":3,"scene_id":303,"steps":[{"step":1,"content":"皮卡的车头已经被撞碎变形，可怜的司机恐怕已经殒命了。","style":3,"background":303,"log_type":1},{"step":2,"speaker":"赫卡蒂","content":"……只剩我们两个人了……","voice":["vo_cgplot_3031002"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":3,"speaker":"赫卡蒂","content":"敌人数量太多，局长，待在我身后。","voice":["vo_cgplot_3031003"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":4,"speaker":"军团莽汉","content":"还能战斗啊？不愧是禁闭者，真有骨气！","voice":["vo_cgplot_3031004"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":5,"speaker":"军团莽汉","content":"想加入军团不？我们老大会喜欢你的，那可比当管理局的*文明*自在多了！","voice":["vo_cgplot_3031005"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":6,"speaker":"赫卡蒂","content":"我只服从局长的命令。","voice":["vo_cgplot_3031006"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":7,"speaker":"军团莽汉","content":"咻——那你一个人好好加油吧。","voice":["vo_cgplot_3031007"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":8,"speaker":"海拉","content":"一个人你*文明用语*个鬼呀！我还活着呢！","voice":["vo_cgplot_3031008"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":9,"content":"海拉从燃烧的皮卡下钻了出来，但不巧，你们被隔在车的两边。","style":3,"background":303,"log_type":1},{"step":10,"options":["你没受伤吧？过得来吗？"],"jump":[11],"style":6,"background":303,"log_type":1},{"step":11,"speaker":"海拉","content":"担心你自己吧！\n……我一会儿就爬过来跟你们会合。","voice":["vo_cgplot_3031011"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":12,"content":"她看了眼熊熊燃烧的驾驶座，大概想到司机的悲惨下场，来了气。","style":3,"background":303,"log_type":1},{"step":13,"speaker":"海拉","content":"*文明*，咱跟他们有什么仇什么怨，要这么赶尽杀绝！","voice":["vo_cgplot_3031013"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":14,"speaker":"海拉","content":"我生气了！来一个算一个！我要在他们脑袋上敲100个包！","voice":["vo_cgplot_3031014"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":15,"speaker":"赫卡蒂","content":"小心点，那个女人也来了。","voice":["vo_cgplot_3031015"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1}]}