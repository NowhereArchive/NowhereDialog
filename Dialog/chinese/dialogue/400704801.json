{"id":400704801,"chapter_id":50019,"scene_id":51915,"steps":[{"step":1,"content":"你的准备已经完成，现在就等待它出现在“陷阱”的附近了。","style":3,"background":2079,"log_type":1},{"step":2,"content":"你看了看表，已经过去了半个小时，想必它应该早就觉得无聊了吧。","style":3,"background":2079,"log_type":1},{"step":3,"content":"你靠着长椅，装出一副疲惫不堪的模样。","style":3,"background":2079,"log_type":1},{"step":4,"speaker":"黑影","content":"呜……你这是要放弃了么……","voice":["vo_event_400704801_4"],"voice_bank":"vo_event_07048","style":1,"background":2079,"log_type":1},{"step":5,"content":"你的右肩传来了熟悉的触感，是它。","style":3,"background":2079,"log_type":1},{"step":6,"content":"但它的声音却早已没了先前的兴奋，反而更像是一个因为没有朋友陪它一起玩而丧气的孩子。","style":3,"background":2079,"log_type":1},{"step":7,"speaker":"黑影","content":"好不容易……我才找到一个能陪我玩的人……","voice":["vo_event_400704801_7"],"voice_bank":"vo_event_07048","style":1,"background":2079,"log_type":1},{"step":8,"speaker":"黑影","content":"你好久都没来找我了……是不是因为我跑得太快啦？那……那我慢点跑还不行么……","voice":["vo_event_400704801_8"],"voice_bank":"vo_event_07048","style":1,"background":2079,"log_type":1},{"step":9,"content":"黑色的影子向你缓缓靠近，似乎是想要劝说你不要放弃。","style":3,"background":2079,"log_type":1},{"step":10,"speaker":"选项","options":["再次尝试抓住它"],"jump":[11],"style":6,"background":2079,"log_type":1},{"step":11,"speaker":"黑影","content":"哇！你这家伙好卑鄙啊！居然装作自己累了，又偷袭我！","voice":["vo_event_400704801_12"],"voice_bank":"vo_event_07048","style":1,"background":2079,"log_type":1},{"step":12,"speaker":"黑影","content":"——你是不是想听我说这种话？嘿嘿，我才不会呢！","voice":["vo_event_400704801_13"],"voice_bank":"vo_event_07048","style":1,"background":2079,"log_type":1},{"step":13,"content":"你看准机会，再次发动突袭，却还是落了空。","style":3,"background":2079,"log_type":1},{"step":14,"speaker":"黑影","content":"家里的所有人都抓不住我！所以你也别想啦！","voice":["vo_event_400704801_15"],"voice_bank":"vo_event_07048","style":1,"background":2079,"log_type":1},{"step":15,"content":"它靠着墙，开心地自夸着。","style":3,"background":2079,"log_type":1},{"step":16,"content":"现在，就是最好的时机。","style":3,"background":2079,"log_type":1},{"step":17,"speaker":"选项","options":["游戏现在才开始"],"jump":[18],"style":6,"background":2079,"log_type":1},{"step":18,"content":"你用尽全身的力气，再一次向它发起冲刺。","style":3,"background":2079,"log_type":1},{"step":19,"speaker":"黑影","content":"嘿嘿，没用的~","voice":["vo_event_400704801_20"],"voice_bank":"vo_event_07048","style":1,"background":2079,"log_type":1},{"step":20,"content":"它一边说着，一边后退，穿过了墙壁，成功进入你的“陷阱”区域之中。","style":3,"background":2079,"log_type":1},{"step":21,"content":"你已经完成了你的全部计划，现在就看“陷阱”有多有效了。","style":3,"background":2079,"log_type":1},{"step":22,"speaker":"黑影","content":"啊啊啊啊啊————！！！","voice":["vo_event_400704801_23"],"voice_bank":"vo_event_07048","style":1,"background":2079,"log_type":1},{"step":23,"content":"墙的另一侧传来了它的悲鸣。","style":3,"background":2079,"log_type":1},{"step":24,"content":"看来很有效，你快跑到墙的另一侧，准备查看它的情况。","style":3,"background":2079,"log_type":1}]}