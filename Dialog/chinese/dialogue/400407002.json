{"id":400407002,"chapter_id":50016,"scene_id":51611,"steps":[{"step":1,"speaker":"嗷呜","content":"看我这招！七星驱邪！","voice":["vo_event_400407002_1"],"voice_bank":"vo_event_04070","style":1,"background":2042,"log_type":1},{"step":2,"speaker":"嗷呜","content":"哎呦——！","voice":["vo_event_400407002_2"],"voice_bank":"vo_event_04070","style":1,"background":2042,"log_type":1},{"step":3,"content":"小短腿还没扫到敌人身上，就被啪唧揍飞，所幸稳稳落在另一人怀中。","style":3,"background":2042,"log_type":1},{"step":4,"speaker":"嗷呜","content":"……${PlayerName}？","voice":["vo_event_400407002_4"],"voice_bank":"vo_event_04070","style":1,"background":2042,"log_type":1},{"step":5,"content":"使徒及分身的能力已稳定呈现为<color=#fb9259>妄想干涉</color>，吞噬人类的想象，一边吸收其中的精神力，一边把妄想具象成现实排出体外。实际伤害有限，但在造梦工厂狄莱坞，动静可就太大了点。","style":3,"background":2042,"log_type":1},{"step":6,"content":"还好嗷呜本身异想天开不会被吓出狂厄来。你将她轻轻置于身后，拎着星兽的后颈放进她怀中。","style":3,"background":2042,"log_type":1},{"step":7,"speaker":"选项","options":["大将坐镇后方，为高潮戏做准备"],"jump":[8],"style":6,"background":2042,"log_type":1},{"step":8,"speaker":"${PlayerName}","content":"这种小喽啰，交给实习场记解决就行。","style":2,"background":2042,"log_type":1}]}