{"id":4041,"chapter_id":4,"scene_id":404,"steps":[{"step":1,"speaker":"海拉","content":"哈、哈……这强得过分了啊。","voice":["vo_cgplot_4041001"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":2,"content":"那一个个破碎空洞中，原本嵌入武器的<color=#fb9259>狂厄结晶</color>此时以一种畸形的模样融入污染，发出诡异的光。","style":3,"background":403,"log_type":1},{"step":3,"options":["控制它们的是狂厄结晶？"],"jump":[4],"style":6,"background":403,"log_type":1},{"step":4,"speaker":"海拉","content":"那些小石头还能成精吗？不对，泰德的手下们也用了结晶，他们可没有变成这个样子啊。","voice":["vo_cgplot_4041004"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":5,"options":["武器上的结晶有问题","这个地方有问题"],"jump":[6,10],"style":6,"background":403,"log_type":1},{"step":6,"speaker":"玩家","content":"这个地窟的狂厄结晶显然呈现出某种“独立意志”，Type 99结晶化成的怪物便是如此。","style":2,"background":403,"log_type":1},{"step":7,"speaker":"海拉","content":"她不是这样的人！","voice":["vo_cgplot_4041007"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1},{"step":8,"content":"没错，这个意志很可能跟“99”本人没有关系，它的真正主人是……","style":3,"background":403,"log_type":1},{"step":10,"content":"砰砰——又一阵搏动，遗产的气息越来越强大了。像在呼应它一般，眼前的怪物们咆哮起来。","style":3,"background":403,"log_type":1},{"step":11,"options":["是“遗产”！"],"jump":[12],"style":6,"background":403,"log_type":1},{"step":12,"speaker":"赫卡蒂","content":"不能再拖下去了。要尽快突破甬道，找到遗产。","voice":["vo_cgplot_4041012"],"voice_bank":"vo_cgplot_04","style":1,"background":403,"log_type":1}]}