{"id":1050603,"chapter_id":1050603,"scene_id":1,"steps":[{"step":1,"content":"你被夹在人群之中，像沙丁鱼一样，往那个罐头大楼挤去。","style":3,"background":2142,"log_type":1,"src_id":150603001,"trial_step":1},{"step":2,"content":"一路上，你都在梳理着目前的情况。","style":3,"background":2142,"log_type":1,"src_id":150603002,"trial_step":2},{"step":3,"content":"雷温失去的那部分力量，附着在一个老式终端上……结合雷温本体的力量和我的枷锁，又一次将凌晨三点的来电的故事散播……","style":2,"background":2142,"log_type":1,"src_id":150603003,"trial_step":3},{"step":4,"content":"然后，利用这些流言激发的情绪，又创造出了一个这样的世界？","style":2,"background":2142,"log_type":1,"src_id":150603004,"trial_step":4},{"step":5,"content":"可是它为什么要重蹈覆辙？那个老式终端又是谁的？它这么做……真的只是想要让所有人不要忘记“凌晨三点的来电”吗？","style":2,"background":2142,"log_type":1,"src_id":150603005,"trial_step":5},{"step":6,"content":"你抬头看看近在咫尺的大楼……","style":3,"background":2142,"log_type":1,"src_id":150603006,"trial_step":6},{"step":7,"content":"又是电视台……这里到底有什么秘密……","style":2,"background":2142,"log_type":1,"src_id":150603007,"trial_step":7},{"step":8,"content":"进入大楼，你正想着没有证件自己要怎么过那个张牙舞爪的闸机，却没想，在被人流推到面前的时候，人脸识别上，倒影出了另一个人的脸。","style":3,"background":2148,"log_type":1,"src_id":150603008,"trial_step":8},{"step":9,"speaker":"机器声","content":"认证成功，欢迎你，雷温。","voice":["vo_trial_50603_1_1"],"voice_bank":"vo_eleven_trial","style":11,"background":2148,"log_type":1,"src_id":150603009,"trial_step":9},{"step":10,"content":"？？？","style":2,"background":2148,"log_type":1,"src_id":150603010,"trial_step":10},{"step":11,"speaker":"雷温","content":"？？？","voice":["vo_trial_50603_1_3"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603011,"trial_step":11},{"step":12,"content":"至此，你终于意识到了什么，发动了自己的枷锁后发现雷温的位置和你自己重叠……你似乎和雷温，成为了同一个人。","style":3,"background":2148,"log_type":1,"src_id":150603012,"trial_step":12},{"step":13,"options":["这可不好笑","这也是鬼故事吗……"],"style":6,"background":2148,"log_type":1,"src_id":150603013,"trial_step":13,"course":3,"choices":[{"text":"这可不好笑","goto":14},{"text":"这也是鬼故事吗……","goto":18}]},{"step":14,"content":"我只能说……我很抱歉……委屈你了……实在是对不起……","female_content":"我是真的第一次遇到这种情况……","style":2,"background":2148,"log_type":1,"src_id":150603014,"trial_step":14},{"step":15,"speaker":"雷温","content":"不……我感觉我应该是，我的一部分意识和你连通在一起了……","female_content":"我也是……我只试过分开，还从没遇到过和别人合为一体……","voice":["vo_trial_50603_1_7","vo_trial_50603_1_11"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603015,"trial_step":15},{"step":16,"speaker":"雷温","content":"有些奇妙……","female_content":"不过，我实际上感觉更像是一部分意识和你连通了……","voice":["vo_trial_50603_1_8","vo_trial_50603_1_12"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603016,"trial_step":16},{"step":17,"content":"就像打电话一样？","style":2,"background":2148,"log_type":1,"src_id":150603017,"trial_step":17,"next":[21]},{"step":18,"speaker":"雷温","content":"这……可就说不准了……","voice":["vo_trial_50603_1_14"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603018,"trial_step":18},{"step":19,"speaker":"雷温","content":"毕竟这是我的力量，说不定，是新型的故事怪谈呢？","voice":["vo_trial_50603_1_15"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603019,"trial_step":19},{"step":20,"content":"不过我感觉，应该只是部分意识连通了，就像打电话一样。","style":2,"background":2148,"log_type":1,"src_id":150603020,"trial_step":20},{"step":21,"speaker":"雷温","content":"嗯，因为……我其实完全感受不到你的存在，我以为只有我一个人和人群一起走到大楼的，直到刚才才发现……","voice":["vo_trial_50603_1_17"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603021,"trial_step":21},{"step":22,"content":"应该是当双方都意识到的时候，才会听到对方的声音。","style":2,"background":2148,"log_type":1,"src_id":150603022,"trial_step":22},{"step":23,"content":"可是，你在哪呢？","style":2,"background":2148,"log_type":1,"src_id":150603023,"trial_step":23},{"step":24,"content":"枷锁显示你应该就在我附近，甚至就在我的位置上。","style":2,"background":2148,"log_type":1,"src_id":150603024,"trial_step":24},{"step":25,"content":"正说着，你走到熟悉的二楼，在拐角处，你看到了一面正衣冠的穿衣镜。","style":3,"background":2148,"log_type":1,"src_id":150603025,"trial_step":25},{"step":26,"speaker":"雷温","content":"咦？我好像……看见你了？","voice":["vo_trial_50603_1_22"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603026,"trial_step":26},{"step":27,"content":"我也是……","style":2,"background":2148,"log_type":1,"src_id":150603027,"trial_step":27},{"step":28,"content":"你走向镜子，镜子中却出现了两个身影——你和雷温。","style":3,"background":2148,"log_type":1,"src_id":150603028,"trial_step":28},{"step":29,"content":"雷温站在你的前方，身影刚好将你笼罩住。","style":3,"background":2148,"log_type":1,"src_id":150603029,"trial_step":29},{"step":30,"speaker":"雷温","content":"感觉……你好像成为了我的背后灵？","voice":["vo_trial_50603_1_26"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603030,"trial_step":30},{"step":31,"content":"镜中，你看到雷温抬了抬手，你也跟着抬了抬手，但当你想越过雷温，走到她面前时，却发现自己无法做到。","style":3,"background":2148,"log_type":1,"src_id":150603031,"trial_step":31},{"step":32,"speaker":"雷温","content":"毕竟还是由我的能力、我的执念所创造的世界……所以是由我来主导吧……","voice":["vo_trial_50603_1_28"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603032,"trial_step":32},{"step":33,"content":"估计是，也好，你比我更熟悉这电视台，你主导当然方便一些。","style":2,"background":2148,"log_type":1,"src_id":150603033,"trial_step":33},{"step":34,"content":"正当你们二人观察时，三楼传来一阵喧闹的声音。","style":3,"background":2148,"log_type":1,"src_id":150603034,"trial_step":34},{"step":35,"speaker":"员工A","content":"工作！工作！工作创造价值，工作带来快乐，工作成就梦想！！","voice":["vo_trial_50603_1_31"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603035,"trial_step":35},{"step":36,"speaker":"员工B","content":"工作……呃呃呃……活着，然后工作……","voice":["vo_trial_50603_1_32"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603036,"trial_step":36},{"step":37,"speaker":"雷温","content":"楼上就是我之前工作的地方！","voice":["vo_trial_50603_1_33"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603037,"trial_step":37},{"step":38,"content":"上去看看！","style":2,"background":2148,"log_type":1,"src_id":150603038,"trial_step":38},{"step":39,"content":"雷温带着你走上了三楼，眼前的景象让你大吃一惊——","style":3,"background":2148,"log_type":1,"src_id":150603039,"trial_step":39},{"step":40,"content":"办公区域里，人流涌动，明明已至深夜，却几乎无人离开工位。在灯火通明的办公间里，脚步声与交谈声此起彼伏。","style":3,"background":2148,"log_type":1,"src_id":150603040,"trial_step":40},{"step":41,"content":"怪异头的员工们麻木且充满激情地工作着，让你几乎产生了一种“这个企业真是积极向上”的错觉。","style":3,"background":2148,"log_type":1,"src_id":150603041,"trial_step":41},{"step":42,"options":["这就是电视台的工作现场吗…","这难道是死役爆发？"],"style":6,"background":2148,"log_type":1,"src_id":150603042,"trial_step":42,"course":3,"choices":[{"text":"这就是电视台的工作现场吗…","goto":43},{"text":"这难道是死役爆发？","goto":null}]},{"step":43,"speaker":"雷温","content":"第一次来电视台吗？因为节目有各自不同的播出时间，即使半夜也会有人留在岗位上。","voice":["vo_trial_50603_1_39"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603043,"trial_step":43},{"step":44,"speaker":"雷温","content":"尤其是时事类的工作者，在一些重大节点，他们甚至要24小时待机。","voice":["vo_trial_50603_1_40"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603044,"trial_step":44},{"step":45,"content":"黑心企业……MBCC至少会给加班费。","style":2,"background":2148,"log_type":1,"src_id":150603045,"trial_step":45},{"step":46,"content":"……或者是调休。","style":2,"background":2148,"log_type":1,"src_id":150603046,"trial_step":46},{"step":47,"speaker":"雷温","content":"这些构造出来的世界会以现实为基础搭建虚拟空间，或许因为这里也是由我的记忆构成的。","voice":["vo_trial_50603_1_43"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603047,"trial_step":47},{"step":48,"speaker":"雷温","content":"但奇怪了……我的节目是深夜播出，一般不会留下这么多人……","voice":["vo_trial_50603_1_44"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603048,"trial_step":48},{"step":49,"speaker":"？？？","content":"雷温！","voice":["vo_trial_50603_1_45"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603049,"trial_step":49},{"step":50,"content":"一道尖锐的女声穿过整个空间，直冲向你。几个员工簇拥着一只“麦克风”飞速奔来——等他们散开，你才看清那并不是被托举起来的道具，而是一个人的头颅。","style":3,"background":2148,"log_type":1,"src_id":150603050,"trial_step":50},{"step":51,"content":"此时，这只“麦克”中正传出刺耳的催促声。","style":3,"background":2148,"log_type":1,"src_id":150603051,"trial_step":51},{"step":52,"speaker":"雷温上司","content":"这都几点了，你怎么还在偷懒！","voice":["vo_trial_50603_1_48"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603052,"trial_step":52},{"step":53,"speaker":"雷温上司","content":"节目马上开始，你该去录音棚了！真不知道你们年轻人是怎么睡得着的！！","voice":["vo_trial_50603_1_49"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603053,"trial_step":53},{"step":54,"speaker":"雷温","content":"节目……？等一下，我的节目不是被停……","voice":["vo_trial_50603_1_50"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603054,"trial_step":54},{"step":55,"speaker":"员工B","content":"快点的吧！雷温小姐！马上到凌晨三点了！","voice":["vo_trial_50603_1_51"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603055,"trial_step":55},{"step":56,"speaker":"员工A","content":"雷温小姐是我们电台这段时间最受欢迎的主播，很多人都期待你的直播的！","voice":["vo_trial_50603_1_52"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603056,"trial_step":56},{"step":57,"content":"员工们将你们团团围住，一路拥向建筑深处。路过走廊时，你再次从玻璃中看见两人的倒影。","style":3,"background":2148,"log_type":1,"src_id":150603057,"trial_step":57},{"step":58,"content":"雷温脸上没有笑容，表情被阴影遮挡，晦暗不清。","style":3,"background":2148,"log_type":1,"src_id":150603058,"trial_step":58},{"step":59,"content":"你跟随雷温进入了演播室，除了面前的麦克风外，面前只有一份薄薄的文本稿件，以及不远处玻璃外的围观员工。那位麦克风头的制作人似乎在说着什么，但隔着静音玻璃，你听不见。","style":3,"background":2147,"log_type":1,"src_id":150603059,"trial_step":59},{"step":60,"content":"绝对安静的室内，你只能听见自己的声音。","style":3,"background":2147,"log_type":1,"src_id":150603060,"trial_step":60},{"step":61,"speaker":"雷温","content":"你在紧张吗？","voice":["vo_trial_50603_1_57"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603061,"trial_step":61},{"step":62,"content":"雷温坐在话筒前，熟练地翻看着文本稿件，调试着话筒音量。当她坐下来的一瞬间，仿佛就已经进入了状态，动作行云流水，却也看得人有些心跳加速。","style":3,"background":2147,"log_type":1,"src_id":150603062,"trial_step":62},{"step":63,"options":["紧张","不紧张"],"style":6,"background":2147,"log_type":1,"src_id":150603063,"trial_step":63,"course":3,"choices":[{"text":"紧张","goto":64},{"text":"不紧张","goto":65}]},{"step":64,"content":"是有点，看你的准备工作，很紧凑，很专业，让人不由得有一种“好像有什么即将要发生”的感觉。","style":2,"background":2147,"log_type":1,"src_id":150603064,"trial_step":64,"next":[66]},{"step":65,"content":"我经历过很多更难应付的场景，只是看到了你的准备工作，很紧凑，很专业，让人不由得有一种“好像有什么即将要发生”的感觉罢了。","style":2,"background":2147,"log_type":1,"src_id":150603065,"trial_step":65},{"step":66,"speaker":"雷温","content":"只是装装样子罢了，就像新闻主持人等待片尾曲的时间。","voice":["vo_trial_50603_1_62"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603066,"trial_step":66},{"step":67,"speaker":"雷温","content":"电台主播的工作甚至不需要露脸，这些不过是……给他们看的。","voice":["vo_trial_50603_1_63"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603067,"trial_step":67},{"step":68,"content":"雷温朝静音玻璃外抬抬头，那边，工作人员依旧簇拥着那位麦克风头的制作人。","style":3,"background":2147,"log_type":1,"src_id":150603068,"trial_step":68},{"step":69,"content":"但你的确是一个很专业的主播，你很喜欢这份工作的。","style":2,"background":2147,"log_type":1,"src_id":150603069,"trial_step":69},{"step":70,"content":"雷温的手顿了顿，神色有些黯然。","style":3,"background":2147,"log_type":1,"src_id":150603070,"trial_step":70},{"step":71,"speaker":"雷温","content":"是啊……但当它成为一种不安的因素，危险的源头时……","voice":["vo_trial_50603_1_67"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603071,"trial_step":71},{"step":72,"speaker":"雷温","content":"喜欢就没有了存在的意义。","voice":["vo_trial_50603_1_68"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603072,"trial_step":72},{"step":73,"content":"你想说些什么，你想反驳她，可是指示灯在这个时候亮了起来。","style":3,"background":2147,"log_type":1,"src_id":150603073,"trial_step":73},{"step":74,"content":"雷温迅速地调整好了自己的状态，对着麦克风，温柔地开口。","style":3,"background":2147,"log_type":1,"src_id":150603074,"trial_step":74},{"step":75,"speaker":"雷温","content":"“或许你已经结束一天的忙碌，又或许还在回味今日的疲惫……”","voice":["vo_trial_50603_1_71"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603075,"trial_step":75},{"step":76,"speaker":"雷温","content":"“欢迎来到凌晨三点的来电，你可以在这里询问苦恼，倾诉心事，或者分享某一段快乐瞬间。”","voice":["vo_trial_50603_1_72"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603076,"trial_step":76},{"step":77,"speaker":"雷温","content":"“夜色已深，无论白日如何，我会永远留在这儿……倾听你们的声音。”","voice":["vo_trial_50603_1_73"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603077,"trial_step":77},{"step":78,"content":"雷温慢慢念出这期开场白，她的声音在处理器下同步、交叠，化为信号，沿着电波输送向城市各处。","style":3,"background":2147,"log_type":1,"src_id":150603078,"trial_step":78},{"step":79,"speaker":"雷温","content":"那么，让我们接入第一位听众的来电——","voice":["vo_trial_50603_1_75"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603079,"trial_step":79},{"step":80,"content":"几声忙音后，信号接入房间。","style":3,"background":2147,"log_type":1,"src_id":150603080,"trial_step":80},{"step":81,"speaker":"听众B","content":"您好……请问是……凌晨三点的来电吗？","voice":["vo_trial_50603_1_77"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603081,"trial_step":81},{"step":82,"content":"一个温和的声音出现在你们耳畔，几乎像是冬日暖阳一般，照耀了你们。","style":3,"background":2147,"log_type":1,"src_id":150603082,"trial_step":82},{"step":83,"speaker":"雷温","content":"对……对！是我，我是雷温，请问，你有什么想要倾诉的吗？","voice":["vo_trial_50603_1_79"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603083,"trial_step":83},{"step":84,"speaker":"听众B","content":"嗯……我有一件事情，纠结犹豫了很久，但是身边没有人可以商量，我想……应该可以问问你。","voice":["vo_trial_50603_1_80"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603084,"trial_step":84},{"step":85,"speaker":"雷温","content":"当然，我很荣幸，能为你分忧。","voice":["vo_trial_50603_1_81"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603085,"trial_step":85},{"step":86,"speaker":"听众B","content":"是这样的……我……我的同学，邀请我参加不久后的校庆舞会，这是第一次有人邀请我！","voice":["vo_trial_50603_1_82"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603086,"trial_step":86},{"step":87,"speaker":"听众B","content":"我一直被人说不好看，连家里人都这么说，所以我平时，只敢穿一些T恤和牛仔裤什么的……","voice":["vo_trial_50603_1_83"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603087,"trial_step":87},{"step":88,"speaker":"听众B","content":"可是，舞会肯定要穿裙子吧！所以我就在购物平台上，选了两条我应该能穿的裙子……","voice":["vo_trial_50603_1_84"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603088,"trial_step":88},{"step":89,"speaker":"听众B","content":"我的家人和朋友，肯定会说我根本不适合……但这是我第一次被邀请参加舞会，肯定是要穿裙子的吧！所以……我想听听你的意见……","voice":["vo_trial_50603_1_85"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603089,"trial_step":89},{"step":90,"speaker":"雷温","content":"嗯……我们后台收到了你发来的照片和裙子的图片，我看看哦~","voice":["vo_trial_50603_1_86"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603090,"trial_step":90},{"step":91,"content":"雷温旁边的屏幕上，出现了一张照片，上面的女孩其实很好看，笑起来有些腼腆，她选择的裙子也是很适合她的，温柔典雅的款式。","style":3,"background":2147,"log_type":1,"src_id":150603091,"trial_step":91},{"step":92,"content":"雷温轻声细语地，夸奖着女孩，鼓励着女孩，告诉她，那件粉色的泡泡袖公主裙，一定会让她成为舞会上的焦点。","style":3,"background":2147,"log_type":1,"src_id":150603092,"trial_step":92},{"step":93,"content":"女孩很高兴，不住地对雷温说着谢谢。","style":3,"background":2147,"log_type":1,"src_id":150603093,"trial_step":93},{"step":94,"speaker":"雷温","content":"对了，再告诉你一个能在舞会上无敌的秘诀吧~","voice":["vo_trial_50603_1_90"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603094,"trial_step":94},{"step":95,"speaker":"听众B","content":"诶~？是什么？","voice":["vo_trial_50603_1_91"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603095,"trial_step":95},{"step":96,"speaker":"雷温","content":"那就是自信和微笑~相信自己很美，相信自己独一无二，相信自己的爱能打败一切~","voice":["vo_trial_50603_1_92"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603096,"trial_step":96},{"step":97,"speaker":"听众B","content":"嗯！我……一定会这样微笑的！","voice":["vo_trial_50603_1_93"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603097,"trial_step":97},{"step":98,"content":"电话挂断，雷温的笑意维持在脸上，连最后的结束语，都是带着笑的。","style":3,"background":2147,"log_type":1,"src_id":150603098,"trial_step":98},{"step":99,"content":"结束的那一刻，雷温对你说道。","style":3,"background":2147,"log_type":1,"src_id":150603099,"trial_step":99},{"step":100,"speaker":"雷温","content":"你知道吗~这就是为什么我想要一直坚持。","voice":["vo_trial_50603_1_96"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603100,"trial_step":100},{"step":101,"content":"嗯，我知道了。","style":2,"background":2147,"log_type":1,"src_id":150603101,"trial_step":101},{"step":102,"content":"这很有意义。","style":2,"background":2147,"log_type":1,"src_id":150603102,"trial_step":102},{"step":103,"content":"雷温脸上挂着温暖的笑容，这是你从之前的事件与她分别后，再一次看到的笑容。","style":3,"background":2147,"log_type":1,"src_id":150603103,"trial_step":103},{"step":104,"speaker":"听众A","content":"喂？哈喽哈喽？能听见吗？","voice":["vo_trial_50603_1_100"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603104,"trial_step":104},{"step":105,"content":"没等你们继续回味那位可爱的听众，下一个电话已经接进来了。","style":3,"background":2147,"log_type":1,"src_id":150603105,"trial_step":105},{"step":106,"speaker":"听众A","content":"没想到真的能打进来诶，太好了！","voice":["vo_trial_50603_1_102"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603106,"trial_step":106},{"step":107,"content":"一个活泼的声音接了进来，控制调音台上的波形一跳一跳，你似乎都能脑补出对面应该又是一个可爱的小姑娘。","style":3,"background":2147,"log_type":1,"src_id":150603107,"trial_step":107},{"step":108,"speaker":"雷温","content":"你好，很高兴能在这里和你相遇……请问你是想要分享，亦或是想要倾诉呢？","voice":["vo_trial_50603_1_104"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603108,"trial_step":108},{"step":109,"speaker":"听众A","content":"啊？倒是都没有，我就是睡不着，随手打了宣传单上的电话。","voice":["vo_trial_50603_1_105"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603109,"trial_step":109},{"step":110,"speaker":"听众A","content":"我以为不会有人这个点还要上班诶！好辛苦啊！你是做什么的啊？","voice":["vo_trial_50603_1_106"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603110,"trial_step":110},{"step":111,"speaker":"听众A","content":"这个点还要卖弄风骚和听众说话，你是不是很缺钱呀？然后来这里卖自己的声音？","voice":["vo_trial_50603_1_107"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603111,"trial_step":111},{"step":112,"speaker":"听众A","content":"应该很多人打你的电话吧？","voice":["vo_trial_50603_1_108"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603112,"trial_step":112},{"step":113,"content":"想象逐渐散去，你无法理解为什么对面可以毫无修饰地说出这些话来。你看着雷温的指甲死死地在桌面上摩擦着，你想要去盖掉这通来电，可是你做不到。","style":3,"background":2147,"log_type":1,"src_id":150603113,"trial_step":113},{"step":114,"content":"得要雷温来做才行。","style":3,"background":2147,"log_type":1,"src_id":150603114,"trial_step":114},{"step":115,"speaker":"雷温","content":"不好意思啊，凌晨三点的来电只是一档深夜的聊天栏目，我会接听各位的电话，亦或是读一首小诗，唱一首歌……","voice":["vo_trial_50603_1_111"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603115,"trial_step":115},{"step":116,"speaker":"雷温","content":"我只是想要陪伴着大家，化解疲惫，或是分享心情……","voice":["vo_trial_50603_1_112"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603116,"trial_step":116},{"step":117,"speaker":"雷温","content":"是真诚的交流……","voice":["vo_trial_50603_1_113"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603117,"trial_step":117},{"step":118,"speaker":"听众A","content":"就这？","voice":["vo_trial_50603_1_114"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603118,"trial_step":118},{"step":119,"speaker":"听众A","content":"那没什么意思，也不知道你说的是真的还是假的，算了，我先挂了~","voice":["vo_trial_50603_1_115"],"voice_bank":"vo_eleven_trial","style":11,"background":2147,"log_type":1,"src_id":150603119,"trial_step":119},{"step":120,"content":"那边的声音很快消失，演播室里，雷温的叹气声格外清晰。","style":3,"background":2147,"log_type":1,"src_id":150603120,"trial_step":120},{"step":121,"content":"你应该打断她的，然后拒绝她……","style":2,"background":2147,"log_type":1,"src_id":150603121,"trial_step":121},{"step":122,"speaker":"雷温","content":"她是听众朋友，等她说完是应该的，况且……导播也没有说要切断来电。","voice":["vo_trial_50603_1_118"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603122,"trial_step":122},{"step":123,"content":"雷温向外看去，麦克风头的导播朝她比了个OK的手势，她身旁的人，也举起平板，似乎想要展示什么。","style":3,"background":2147,"log_type":1,"src_id":150603123,"trial_step":123},{"step":124,"content":"眯着眼睛看了好一会儿，你才看清，是当前的热搜榜。","style":3,"background":2147,"log_type":1,"src_id":150603124,"trial_step":124},{"step":125,"content":"一个名为<color=#fb9259>#请问你是做什么的#</color>热搜标签，明晃晃地出现在了榜单下方。","style":3,"background":2147,"log_type":1,"src_id":150603125,"trial_step":125},{"step":126,"speaker":"雷温","content":"……","style":1,"background":2147,"log_type":1,"src_id":150603126,"trial_step":126},{"step":127,"speaker":"雷温","content":"感谢这位的来电，我们……继续接听吧。","voice":["vo_trial_50603_1_123"],"voice_bank":"vo_eleven_trial","style":1,"background":2147,"log_type":1,"src_id":150603127,"trial_step":127},{"step":128,"content":"导播没有掐断任何一个来电，之后的短短的一个小时里，你虽然也听到了分享，听到了倾诉，但更多的是骚扰，辱骂，玩弄或是不屑。","style":3,"background":2147,"log_type":1,"src_id":150603128,"trial_step":128},{"step":129,"content":"你的意识和雷温共感，你能感受到雷温几乎要崩溃，可是导播没有喊停，节目还没结束。","style":3,"background":2147,"log_type":1,"src_id":150603129,"trial_step":129},{"step":130,"content":"她不准自己崩溃，工作也不准。","style":3,"background":2147,"log_type":1,"src_id":150603130,"trial_step":130},{"step":131,"speaker":"雷温上司","content":"很不错！雷温！很不错！","voice":["vo_trial_50603_1_127"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603131,"trial_step":131},{"step":132,"speaker":"雷温上司","content":"这次的节目又上了一个热搜，第一个电话你处理得非常好，估计能带来第二个热搜！","voice":["vo_trial_50603_1_128"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603132,"trial_step":132},{"step":133,"content":"走出演播室，那个麦克风导播拍了拍雷温的肩膀，声音里满是得意。","style":3,"background":2148,"log_type":1,"src_id":150603133,"trial_step":133},{"step":134,"speaker":"雷温上司","content":"下次再接再厉啊！","voice":["vo_trial_50603_1_130"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603134,"trial_step":134},{"step":135,"content":"雷温点点头，正欲向前走去，另一个演播室里，走出了一位女孩。","style":3,"background":2148,"log_type":1,"src_id":150603135,"trial_step":135},{"step":136,"content":"只见导播像是想到了什么似的，走上去拍拍女孩的肩膀，带她到雷温面前。","style":3,"background":2148,"log_type":1,"src_id":150603136,"trial_step":136},{"step":137,"speaker":"女孩","content":"有什么事吗？导播、雷温小姐。","voice":["vo_trial_50603_1_133"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603137,"trial_step":137},{"step":138,"speaker":"雷温上司","content":"哎，雷温小姐的电台最近很火爆，但总是一种类型的电话还是有些枯燥了。","voice":["vo_trial_50603_1_134"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603138,"trial_step":138},{"step":139,"speaker":"女孩","content":"您……是想让我加入雷温小姐的电台吗？！真的吗？！","voice":["vo_trial_50603_1_135"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603139,"trial_step":139},{"step":140,"speaker":"雷温上司","content":"你的表现也是不错的，之后你可以写几个剧本，当自己是受欺负的小女孩，然后装作观众给雷温打电话。","voice":["vo_trial_50603_1_136"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603140,"trial_step":140},{"step":141,"speaker":"女孩","content":"这、这样啊！行！我一定好好做！","voice":["vo_trial_50603_1_137"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603141,"trial_step":141},{"step":142,"content":"雷温的眼里满是惊讶，她看着导播和女孩商量着，商量着要把她为数不多真诚的声音，也变成虚假。","style":3,"background":2148,"log_type":1,"src_id":150603142,"trial_step":142},{"step":143,"content":"可她一句话也说不出来。","style":3,"background":2148,"log_type":1,"src_id":150603143,"trial_step":143},{"step":144,"speaker":"雷温上司","content":"你也早点回去吧，好好准备下一次的节目。","voice":["vo_trial_50603_1_140"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603144,"trial_step":144},{"step":145,"speaker":"雷温上司","content":"哦对了，这个给你，现在你的节目名气上来了，有的时候可能会需要你的临时客串或者帮忙。","voice":["vo_trial_50603_1_141"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603145,"trial_step":145},{"step":146,"speaker":"雷温上司","content":"公司给你配备了一台终端，以便能随时找到你。","voice":["vo_trial_50603_1_142"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603146,"trial_step":146},{"step":147,"content":"麦克风导播招了招手，不远处的工作人员从抽屉里拿出了一个黑乎乎的玩意儿，递给你们。","style":3,"background":2148,"log_type":1,"src_id":150603147,"trial_step":147},{"step":148,"speaker":"雷温","content":"这…………","voice":["vo_trial_50603_1_144"],"voice_bank":"vo_eleven_trial","style":1,"background":2148,"log_type":1,"src_id":150603148,"trial_step":148},{"step":149,"content":"你们看得清楚，这就是那台老式终端！！！","style":3,"background":2148,"log_type":1,"src_id":150603149,"trial_step":149},{"step":150,"speaker":"玩家","content":"这台终端怎么会出现在这里？？看款式，这至少是五年前的东西了！","style":2,"background":2148,"log_type":1,"src_id":150603150,"trial_step":150},{"step":151,"content":"五年前？！你突然想起之前在调查的时候，了解到的，关于“鬼来电”的都市传说最早兴起的时间。","style":3,"background":2148,"log_type":1,"src_id":150603151,"trial_step":151},{"step":152,"content":"你感受到了头脑眩晕，脊背一片冰凉——那股力量在让雷温重演当时鬼来电都市传说主角的故事！","style":3,"background":2148,"log_type":1,"src_id":150603152,"trial_step":152},{"step":153,"content":"雷温颤抖着手，接下了那台老式终端。","style":3,"background":2148,"log_type":1,"src_id":150603153,"trial_step":153},{"step":154,"content":"握住终端的一瞬间，天旋地转。空间开始像你们初入时那样扭曲，崩塌！","style":3,"background":2148003,"log_type":1,"src_id":150603154,"trial_step":154},{"step":155,"speaker":"雷温","content":"怎么会这样……一切都是安排好的……我的喜欢和坚持……根本没意义……以前是这样，现在也是这样……在这个环境之下……根本不可能改变什么！","voice":["vo_trial_50603_1_151"],"voice_bank":"vo_eleven_trial","style":1,"background":2148003,"log_type":1,"src_id":150603155,"trial_step":155}]}