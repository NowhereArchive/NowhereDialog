{"id":400703101,"chapter_id":50019,"scene_id":51920,"steps":[{"step":1,"content":"街巷中的雾气正逐渐散去，但沉郁的天色仍压得人喘不过气。","style":3,"background":2081,"log_type":1},{"step":2,"speaker":"居民","content":"谁？！谁在那里？！剪子，别——别过来啊啊啊！","voice":["vo_event_400703101_02"],"voice_bank":"vo_event_07031","style":1,"background":2081,"log_type":1},{"step":3,"speaker":"居民","content":"不要，求求你了，不——","voice":["vo_event_400703101_03"],"voice_bank":"vo_event_07031","style":1,"background":2081,"log_type":1},{"step":4,"content":"夜色中，你听到小巷的各处传来惨叫——人们哀求着真正的疯剪子住手。","style":3,"background":2081,"log_type":1},{"step":5,"options":["阿黛拉——！"],"jump":[6],"style":6,"background":2081,"log_type":1},{"step":7,"content":"晚了。刀光闪过，那些代表烦恼的怪物被消除，而你根本看不见阿黛拉的身影，却迎面撞上一个女人。","style":3,"background":2081,"log_type":1},{"step":8,"content":"她浑浑噩噩地站在街道中间，你见过她，正是那个一度被剪刀控制的“疯剪子”，纠缠她的魔发已经消失无影。","style":3,"background":2081,"log_type":1},{"step":9,"options":["你受伤了吗？！"],"jump":[10],"style":6,"background":2081,"log_type":1},{"step":10,"speaker":"“疯剪子”","content":"……是你？你来干什么。","voice":["vo_event_400703101_10"],"voice_bank":"vo_event_07031","style":1,"background":2081,"log_type":1},{"step":11,"content":"现在她脸上带着一种奇异而淡然的微笑。","style":3,"background":2081,"log_type":1},{"step":12,"speaker":"“疯剪子”","content":"知道了知道了，你比我厉害，比我勇敢，比我上进……你们都很好，所有人都比我强。","voice":["vo_event_400703101_12"],"voice_bank":"vo_event_07031","style":1,"background":2081,"log_type":1},{"step":13,"speaker":"“疯剪子”","content":"嘿嘿……没关系，就这样，我不羡慕，我一点也不羡慕。","voice":["vo_event_400703101_13"],"voice_bank":"vo_event_07031","style":1,"background":2081,"log_type":1},{"step":14,"speaker":"“疯剪子”","content":"疯剪子实现了我的愿望，疯剪子剪断了我的烦恼，我不会再烦恼了，我不用再努力了，我是废物，好耶——","voice":["vo_event_400703101_14"],"voice_bank":"vo_event_07031","style":1,"background":2081,"log_type":1},{"step":15,"content":"你抬头看到不远处闪烁的提灯。它好像有点害怕，畏缩不前，却始终没有远离。","style":3,"background":2081,"log_type":1},{"step":16,"options":["……我还有急事"],"jump":[17],"style":6,"background":2081,"log_type":1},{"step":17,"speaker":"%u","content":"一切结束后，会回来看你的。保重。","style":2,"background":2081,"log_type":1},{"step":18,"speaker":"“疯剪子”","content":"嘿嘿，有什么好努力的……以前的我真傻，嘿嘿……真傻……","voice":["vo_event_400703101_18"],"voice_bank":"vo_event_07031","style":1,"background":2081,"log_type":1},{"step":19,"content":"远处又传来尖叫声。","style":3,"background":2081,"log_type":1},{"step":20,"options":["必须阻止她……"],"jump":[21],"style":6,"background":2081,"log_type":1},{"step":21,"content":"你快步追了出去。","style":3,"background":2081,"log_type":1}]}