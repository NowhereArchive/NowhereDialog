{"id":7042,"chapter_id":7,"scene_id":705,"steps":[{"step":1,"content":"你们终于赶在玩偶大部队出动前，成功逃出了游行，躲到路边糖果摊后面。","style":3,"background":704,"log_type":1},{"step":2,"speaker":"海拉","content":"呼……*的，这回总算没被挤出去。我可不想重来一遍。","voice":["vo_cgplot_7052002"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":3,"speaker":"选项","options":["等我休息一下，继续"],"jump":[4],"style":6,"background":704,"log_type":1},{"step":4,"content":"你紊乱的气息尚未平复，海拉看着你大口喘气，脸色越来越不好。","style":3,"background":704,"log_type":1},{"step":5,"speaker":"海拉","content":"这法子不行，烂透了！不准用！","voice":["vo_cgplot_7052005"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":6,"speaker":"选项","options":["要前进只能这么做"],"jump":[7],"style":6,"background":704,"log_type":1},{"step":7,"speaker":"海拉","content":"我说不行就不行！你还想变成之前那个鬼样子吗？！","voice":["vo_cgplot_7052007"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":8,"content":"话一出口，她就有些后悔，僵硬地别过脸去。","style":3,"background":704,"log_type":1},{"step":9,"speaker":"选项","options":["……不会再有上次那样了"],"jump":[10],"style":6,"background":704,"log_type":1},{"step":10,"speaker":"${PlayerName}","content":"如果我再伤害你们，就把我处理掉。不过现在看来，没有联系黑环原爆点的枷锁还很安全。","style":2,"background":704,"log_type":1},{"step":11,"content":"可也正因为没有枷锁的指引，你像盲头苍蝇一般，在黑环的幻境中迷失方向。","style":3,"background":704,"log_type":1},{"step":12,"speaker":"海拉","content":"**……我不是这个意思。","voice":["vo_cgplot_7052012"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":13,"speaker":"海拉","content":"黑环这样的鬼地方，谁知道会发生什么……","voice":["vo_cgplot_7052013"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":14,"speaker":"选项","options":["有危险的话，你就逃吧"],"jump":[15],"style":6,"background":704,"log_type":1},{"step":15,"content":"你没有撒谎。她咬了咬牙，始终没看你的眼睛，走到另一边坐下了。","style":3,"background":704,"log_type":1},{"step":16,"speaker":"赫卡蒂","content":"……","style":1,"background":704,"log_type":1},{"step":17,"content":"不知道是不是你的错觉，进入这个黑环后，赫卡蒂的话更少了，显得格外紧绷，时刻注意着周围的情况。","style":3,"background":704,"log_type":1},{"step":18,"content":"BR-004带来的冲击不仅影响了你，还深深地影响了与你共同作战的禁闭者。","style":3,"background":704,"log_type":1},{"step":19,"content":"枷锁读不了她们的心。你无法疏解她们的困惑，尤其在自己的问题也还没得到解决的时候。","style":3,"background":704,"log_type":1},{"step":20,"content":"休息够了。你起身，禁闭者们跟在你身后，沉默地走进喧嚣欢快的游行。","style":3,"background":704,"log_type":1}]}