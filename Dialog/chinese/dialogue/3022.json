{"id":3022,"chapter_id":3,"scene_id":302,"steps":[{"step":1,"speaker":"海拉","content":"唔啊————！","voice":["vo_cgplot_3022001"],"voice_bank":"vo_cgplot_03","style":1,"background":205,"log_type":1},{"step":2,"content":"炮弹炸开的瞬间，皮卡几乎被震飞。在你被撞飞之前，海拉一把把你推到梦魇怀里，自己却被撞了出去。","style":3,"background":205,"log_type":1},{"step":3,"content":"你还没来得及抓住她，浓烟中冲出两辆车，一前一后猛烈地撞向你们。","style":3,"background":205,"log_type":1},{"step":4,"content":"车终于停了下来。头晕目眩之间，你看到军团大部队簇拥而至。","style":3,"background":303,"log_type":1},{"step":5,"speaker":"赫卡蒂","content":"局长，振作一点。","voice":["vo_cgplot_3022005"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":6,"speaker":"赫卡蒂","content":"……我们被包围了。","voice":["vo_cgplot_3022006"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1}]}