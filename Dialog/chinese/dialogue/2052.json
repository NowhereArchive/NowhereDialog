{"id":2052,"chapter_id":2,"scene_id":205,"steps":[{"step":1,"speaker":"海拉","content":"这帮家伙，强倒不咋强，但真是没完没了。","voice":["vo_cgplot_2052001"],"voice_bank":"vo_cgplot_02","style":1,"background":122,"log_type":1},{"step":2,"speaker":"艾恩","content":"他们在拖延时间。","voice":["vo_cgplot_2052002"],"voice_bank":"vo_cgplot_02","style":1,"background":122,"log_type":1},{"step":3,"content":"你敏锐地看到，一小撮黑帮在偷偷转移——是佯攻，他们想绕后偷袭，而其中一个身影你非常熟悉。","style":3,"background":122,"log_type":1},{"step":4,"speaker":"选项","options":["我去拦截他们"],"jump":[5],"style":6,"background":122,"log_type":1},{"step":5,"content":"你没等艾恩回答，就带着禁闭者们快速离开，终于在医院侧面小巷处拦住了偷袭者。","style":3,"background":1029,"log_type":1},{"step":6,"speaker":"泰德","content":"哈哈，我就知道，如果是局长，一定能察觉我的意图。","voice":["vo_cgplot_2052006"],"voice_bank":"vo_cgplot_02","style":1,"background":1029,"log_type":1},{"step":7,"speaker":"泰德","content":"我来救你了，局长先生。","female_content":"我来救你了，局长小姐。","voice":["vo_cgplot_2052007","vo_cgplot_2052007f"],"voice_bank":"vo_cgplot_02","style":1,"background":1029,"log_type":1}]}