{"id":103,"chapter_id":0,"scene_id":1,"steps":[{"step":2,"speaker":"神秘的女人","content":"终于醒了……我等了你好久。","voice":["vo_cgplot_102003"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":3,"speaker":"神秘的女人","content":"你的脸色不太好，是做噩梦了吗？梦见什么了，说给我听听。","voice":["vo_cgplot_102004"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":4,"speaker":"？？","content":"别听她的！这是针对你的袭击！","voice":["vo_cgplot_102005"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":5,"content":"在修复仓一侧，几个研究员被怪物拍进墙里，唯一留有意识的人正竭力向你的方向大喊。","style":3,"background":10000,"log_type":1},{"step":6,"speaker":"被困的研究员","content":"局长，别离开修复仓！不完成修复程序的话，你的精神会被——\n唔——呜呜呜——！！！","voice":["vo_cgplot_102007"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":7,"content":"男人的脸和声音在剧烈的震动中被某种无形黑暗吞没，彻底沉寂。","style":3,"background":10000,"log_type":1},{"step":8,"speaker":"神秘的女人","content":"我不喜欢被人打扰。","voice":["vo_cgplot_102009"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":9,"speaker":"神秘的女人","content":"好了，站起来，我们还有很多事情要做。","voice":["vo_cgplot_102010"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":10,"speaker":"？？","content":"离他远点！","female_content":"离她远点！","voice":["vo_cgplot_102020","vo_cgplot_102020f"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":11,"content":"子弹连绵不绝，伴随着几声闷响，眼前的女人来不及抽搐，就瘫倒在你身上。","style":3,"background":10000,"log_type":1},{"step":12,"content":"紧随其后的是一阵阵急促的脚步声，闯进了这个房间。","style":3,"background":10000,"log_type":1}]}