{"id":1150103,"chapter_id":1150103,"scene_id":1,"steps":[{"step":1,"content":"夜莺和一干警卫都退到了门外，禁闭室内仅留下你、患者和心理医生。","style":3,"background":1025,"log_type":1,"src_id":250103001,"trial_step":1},{"step":2,"content":"在催眠开始之前，卡米利安再三叮嘱你。","style":3,"background":1025,"log_type":1,"src_id":250103002,"trial_step":2},{"step":3,"speaker":"卡米利安","content":"现在拒绝还来得及。维多利亚有多固执你比我更清楚，恐怕你说什么她都听不见。救与不救的结果是一样的。","style":1,"background":1025,"log_type":1,"src_id":250103003,"trial_step":3},{"step":4,"options":["不试试怎么知道？","我不想就这样放弃"],"style":6,"background":1025,"log_type":1,"src_id":250103004,"trial_step":4,"course":3,"choices":[{"text":"不试试怎么知道？","goto":5},{"text":"我不想就这样放弃","goto":5}]},{"step":5,"content":"永远沉睡是FAC想要的结果，不是我想要的。","style":2,"background":1025,"log_type":1,"src_id":250103005,"trial_step":5},{"step":6,"speaker":"卡米利安","content":"好吧，如果她执意不肯醒来，你就当去梦里，跟维多利亚道个别吧。","style":1,"background":1025,"log_type":1,"src_id":250103006,"trial_step":6},{"step":7,"content":"她叹了口气，掏出怀表。","style":3,"background":1025,"log_type":1,"src_id":250103007,"trial_step":7},{"step":8,"speaker":"卡米利安","content":"放轻松，闭上眼睛……","style":1,"background":1025,"log_type":1,"src_id":250103008,"trial_step":8},{"step":9,"content":"你按照指示，在长久的无声黑暗中等待，终于，眼前闪过一抹红光——","style":3,"background":10000,"log_type":1,"src_id":250103009,"trial_step":9},{"step":10,"content":"歘！！！","style":3,"background":115,"log_type":1,"src_id":250103010,"trial_step":10},{"step":11,"content":"突然，一根锐器向你刺来，于此同时，枷锁蔓延。","style":3,"background":115,"log_type":1,"src_id":250103011,"trial_step":11},{"step":12,"content":"空气中弥漫铁锈的甜腥。枷锁的暗芒照在全身苍白的少女身上，将她也染为殷色。","style":3,"background":115,"log_type":1,"src_id":250103012,"trial_step":12},{"step":13,"content":"但你并没有感到疼痛，维多利亚刺穿的，只是她梦境中的“局长”。","style":3,"background":115,"log_type":1,"src_id":250103013,"trial_step":13},{"step":14,"content":"现在你身处的地方，是维多利亚所认为的“现实”，是她潜意识的投射。","style":3,"background":115,"log_type":1,"src_id":250103014,"trial_step":14},{"step":15,"content":"所以在她的认知里，她成功杀了我……","style":2,"background":115,"log_type":1,"src_id":250103015,"trial_step":15},{"step":16,"content":"维多利亚根本没有听见你的自言自语，正如催眠前预料的那般，完全沉浸于自己捏造的“现实”中。","style":3,"background":115,"log_type":1,"src_id":250103016,"trial_step":16},{"step":17,"speaker":"维多利亚","content":"是的，就是这样……是枷锁……是当初在研究室里的感觉……","style":1,"background":115,"log_type":1,"src_id":250103017,"trial_step":17},{"step":18,"content":"她幸福地将脸埋在“局长”的颈窝，透明的呼吸面罩上沾满了你最后一丝体温。","style":3,"background":115,"log_type":1,"src_id":250103018,"trial_step":18},{"step":19,"speaker":"夜莺","content":"局长！！！","style":1,"background":115,"log_type":1,"src_id":250103019,"trial_step":19},{"step":20,"content":"“夜莺”破门而入，来到“你”的身边。","style":3,"background":115,"log_type":1,"src_id":250103020,"trial_step":20},{"step":21,"speaker":"维多利亚","content":"哈哈哈~局长已经去另一个世界了，但是他对维多利亚的爱护永远留下了痕迹。","female_content":"哈哈哈~局长已经去另一个世界了，但是她对维多利亚的爱护永远留下了痕迹。","style":1,"background":115,"log_type":1,"src_id":250103021,"trial_step":21},{"step":22,"speaker":"夜莺","content":"你疯了……回去通知MBCC各部门！加强戒备，封锁消息！","style":1,"background":115,"log_type":1,"src_id":250103022,"trial_step":22},{"step":23,"content":"救援部队按照指令四散行动，夜莺仍在为已经停止呼吸的“局长”做最后的抢救。","style":3,"background":115,"log_type":1,"src_id":250103023,"trial_step":23},{"step":24,"content":"维多利亚无视了眼前的混乱，拥抱着身上的枷锁，逆着人流向外走去。","style":3,"background":115,"log_type":1,"src_id":250103024,"trial_step":24},{"step":25,"content":"她手心的伤口没有愈合的迹象，滴滴答答地，在她所经过的路上留下一串长长的轨迹。","style":3,"background":115,"log_type":1,"src_id":250103025,"trial_step":25},{"step":26,"options":["跟上去","叫醒维多利亚"],"style":6,"background":115,"log_type":1,"src_id":250103026,"trial_step":26,"course":3,"choices":[{"text":"跟上去","goto":27},{"text":"叫醒维多利亚","goto":28}]},{"step":27,"content":"你一路看着她拖着血迹，回到了MBCC。","style":3,"background":115,"log_type":1,"src_id":250103027,"trial_step":27,"next":[31]},{"step":28,"content":"维多利亚，你在流血。","style":2,"background":115,"log_type":1,"src_id":250103028,"trial_step":28},{"step":29,"content":"维多利亚没有听见你的声音，自顾自朝前走。","style":3,"background":115,"log_type":1,"src_id":250103029,"trial_step":29},{"step":30,"content":"你又试着叫了她两声，还是没有作用，只好跟随她回到了MBCC。","style":3,"background":115,"log_type":1,"src_id":250103030,"trial_step":30,"next":[31]},{"step":31,"speaker":"艾瑞尔","content":"维多利亚！你的手怎么了？怎么受伤了？","style":1,"background":107,"log_type":1,"src_id":250103031,"trial_step":31},{"step":32,"content":"维多利亚在管理局的走廊上遇到了幻想出的“艾瑞尔”。","style":3,"background":107,"log_type":1,"src_id":250103032,"trial_step":32},{"step":33,"speaker":"维多利亚","content":"奇怪，局长在离开前给了我祝福和关爱，我应该会越来越健康才对啊……","style":1,"background":107,"log_type":1,"src_id":250103033,"trial_step":33},{"step":34,"speaker":"艾瑞尔","content":"离开……你是指？","style":1,"background":107,"log_type":1,"src_id":250103034,"trial_step":34},{"step":35,"content":"艾瑞尔的声音有些颤抖。","style":3,"background":107,"log_type":1,"src_id":250103035,"trial_step":35},{"step":36,"speaker":"维多利亚","content":"我将象征结晶送给局长，我会像哥哥姐姐那样等他从另一个世界回来……诶，你怎么哭了？","female_content":"我将象征结晶送给局长，我会像哥哥姐姐那样等她从另一个世界回来……诶，你怎么哭了？","style":1,"background":107,"log_type":1,"src_id":250103036,"trial_step":36},{"step":37,"speaker":"艾瑞尔","content":"笨蛋！局长不会回来了！","style":1,"background":107,"log_type":1,"src_id":250103037,"trial_step":37},{"step":38,"speaker":"维多利亚","content":"一定会的，你看，局长的祝福还缠绕在我身上。","style":1,"background":107,"log_type":1,"src_id":250103038,"trial_step":38},{"step":39,"speaker":"艾瑞尔","content":"可是，你还是在流血。这样的祝福，没有让你变得健康啊……","style":1,"background":107,"log_type":1,"src_id":250103039,"trial_step":39},{"step":40,"speaker":"维多利亚","content":"咦……","style":1,"background":107,"log_type":1,"src_id":250103040,"trial_step":40},{"step":41,"speaker":"海拉","content":"都怪你！","style":1,"background":107,"log_type":1,"src_id":250103041,"trial_step":41},{"step":42,"content":"艾瑞尔不知为何变成了海拉的模样。","style":3,"background":107,"log_type":1,"src_id":250103042,"trial_step":42},{"step":43,"options":["梦境世界果然不存在逻辑","这是维多利亚在动摇？"],"style":6,"background":107,"log_type":1,"src_id":250103043,"trial_step":43,"course":3,"choices":[{"text":"梦境世界果然不存在逻辑","goto":44},{"text":"这是维多利亚在动摇？","goto":45}]},{"step":44,"content":"这里没有艾瑞尔也没有海拉。发生变化的不是交谈的对象，而是她的心境。","style":3,"background":107,"log_type":1,"src_id":250103044,"trial_step":44,"next":[45]},{"step":45,"content":"就像是为了证实你的猜想般，眼前的景象逐渐走向魔幻，海拉一脸暴躁地抓住维多利亚的领子。","style":3,"background":107,"log_type":1,"src_id":250103045,"trial_step":45},{"step":46,"speaker":"海拉","content":"什么祝福什么痊愈都是放*！这之间根本没有什么关系！他们都在耍你！他们不会回来了！","style":1,"background":107,"log_type":1,"src_id":250103046,"trial_step":46},{"step":47,"speaker":"维多利亚","content":"不是的，你相信我……","style":1,"background":107,"log_type":1,"src_id":250103047,"trial_step":47},{"step":48,"content":"海拉转身就要离开，却顷刻间变成了雷比尼斯的样子。","style":3,"background":107,"log_type":1,"src_id":250103048,"trial_step":48},{"step":49,"speaker":"雷比尼斯","content":"根据狄斯百科词条记载：死亡，指生命系统所有的存活属性的丧失，是一种不可逆转的永久性终止状态。","style":1,"background":107,"log_type":1,"src_id":250103049,"trial_step":49},{"step":50,"speaker":"维多利亚","content":"怎么会是不可逆转的呢……局长肯定……","style":1,"background":107,"log_type":1,"src_id":250103050,"trial_step":50},{"step":51,"speaker":"赫卡蒂","content":"不会回来了。","style":1,"background":107,"log_type":1,"src_id":250103051,"trial_step":51},{"step":52,"speaker":"赫卡蒂","content":"大家讨厌你的“祝福”，局长也讨厌你。","style":1,"background":107,"log_type":1,"src_id":250103052,"trial_step":52},{"step":53,"speaker":"维多利亚","content":"你胡说！！！咳咳咳……","style":1,"background":107,"log_type":1,"src_id":250103053,"trial_step":53},{"step":54,"content":"她气愤地大口呼吸着，面前却一个人都没有。","style":3,"background":107,"log_type":1,"src_id":250103054,"trial_step":54},{"step":55,"speaker":"维多利亚","content":"骗子，都是骗子！一定会回来的……一定会！\n我要去找安姐姐，安姐姐不会骗我的……","style":1,"background":107,"log_type":1,"src_id":250103055,"trial_step":55},{"step":56,"options":["跟上去","叫醒维多利亚"],"style":6,"background":107,"log_type":1,"src_id":250103056,"trial_step":56,"course":3,"choices":[{"text":"跟上去","goto":57},{"text":"叫醒维多利亚","goto":58}]},{"step":57,"content":"周围的景象顺从梦境主人的意愿变为了彼岸医院，护士安在病房前等待她到来。","style":3,"background":104,"log_type":1,"src_id":250103057,"trial_step":57,"next":[61]},{"step":58,"content":"维多利亚，快醒醒！这些人都是你想象出来的而已。","style":2,"background":107,"log_type":1,"src_id":250103058,"trial_step":58},{"step":59,"content":"你的声音依然没能穿透她固执的心理屏障。","style":3,"background":107,"log_type":1,"src_id":250103059,"trial_step":59},{"step":60,"content":"周围的景色顺着她的意愿发生了变化，转眼间她已来到彼岸诊所。","style":3,"background":104,"log_type":1,"src_id":250103060,"trial_step":60,"next":[61]},{"step":61,"speaker":"维多利亚","content":"安姐姐！“死亡”只是去了遥远的另一个世界，对不对？","style":1,"background":104,"log_type":1,"src_id":250103061,"trial_step":61},{"step":62,"content":"安只是看着她微笑，并未回答。","style":3,"background":104,"log_type":1,"src_id":250103062,"trial_step":62},{"step":63,"speaker":"维多利亚","content":"死亡不代表永远的离开，局长，研究室的大家……他们一定会回来的，是吗？","style":1,"background":104,"log_type":1,"src_id":250103063,"trial_step":63},{"step":64,"content":"安依然沉默微笑，眨眼间消失在维多利亚面前。","style":3,"background":104,"log_type":1,"src_id":250103064,"trial_step":64},{"step":65,"speaker":"维多利亚","content":"不见了？","style":1,"background":104,"log_type":1,"src_id":250103065,"trial_step":65},{"step":66,"content":"维多利亚转身要去找安，却被身穿白大褂的女人拦下。","style":3,"background":104,"log_type":1,"src_id":250103066,"trial_step":66},{"step":67,"speaker":"艾恩","content":"我们给不了你想要的“祝福”，也承受不了你的结晶……","style":1,"background":104,"log_type":1,"src_id":250103067,"trial_step":67},{"step":68,"speaker":"艾恩","content":"大家都离开了，这就是你要的结果吗？","style":1,"background":104,"log_type":1,"src_id":250103068,"trial_step":68},{"step":69,"content":"话音落下，艾恩随之消失。紧接着，诊所的景象也开始分崩离析。","style":3,"background":108,"log_type":1,"src_id":250103069,"trial_step":69},{"step":70,"speaker":"维多利亚","content":"医师！艾恩医师！","style":1,"background":108,"log_type":1,"src_id":250103070,"trial_step":70},{"step":71,"speaker":"维多利亚","content":"安！你们去哪了！咳咳咳……","style":1,"background":108,"log_type":1,"src_id":250103071,"trial_step":71},{"step":72,"content":"远高于平时分贝的呼喊使维多利亚出现了咳嗽的症状。","style":3,"background":108,"log_type":1,"src_id":250103072,"trial_step":72},{"step":73,"speaker":"维多利亚","content":"局长，我受伤了，你怎么不来关心我了……","style":1,"background":108,"log_type":1,"src_id":250103073,"trial_step":73},{"step":74,"content":"她狼狈地在梦境世界里四处呼喊，却没有任何回声。","style":3,"background":108,"log_type":1,"src_id":250103074,"trial_step":74},{"step":75,"speaker":"维多利亚","content":"你们不会离开的！研究室的大家不会离开维多利亚的！大家还要看到维多利亚越来越健康的样子！","style":1,"background":108,"log_type":1,"src_id":250103075,"trial_step":75},{"step":76,"options":["唤醒维多利亚"],"style":6,"background":108,"log_type":1,"src_id":250103076,"trial_step":76,"course":3,"choices":[{"text":"唤醒维多利亚","goto":77}]},{"step":77,"content":"维多利亚，你能听见吗？","style":2,"background":108,"log_type":1,"src_id":250103077,"trial_step":77},{"step":78,"content":"她木讷地站在原地，眼睁睁看着熟悉的建筑在自己身边如积木般开始垮塌。","style":3,"background":108,"log_type":1,"src_id":250103078,"trial_step":78},{"step":79,"speaker":"维多利亚","content":"大家都走了，都离开我了……局长，哥哥姐姐们……都一样……","style":1,"background":108,"log_type":1,"src_id":250103079,"trial_step":79},{"step":80,"speaker":"维多利亚","content":"为什么……为什么会变成这样呢……","style":1,"background":108,"log_type":1,"src_id":250103080,"trial_step":80},{"step":81,"content":"说话间，从彼岸到MBCC，所有景色都在她面前化为白雾。","style":3,"background":10006,"log_type":1,"src_id":250103081,"trial_step":81},{"step":82,"options":["唤醒维多利亚"],"style":6,"background":10006,"log_type":1,"src_id":250103082,"trial_step":82,"course":3,"choices":[{"text":"唤醒维多利亚","goto":83}]},{"step":83,"speaker":"维多利亚","content":"只是去远方旅行了而已，只是留下我一个人而已，为什么我还在流血，为什么胸口这么难受呢……","style":1,"background":10006,"log_type":1,"src_id":250103083,"trial_step":83},{"step":84,"content":"她痛苦地蜷缩起来，偌大的潜意识世界里，显得格外无助。","style":3,"background":10006,"log_type":1,"src_id":250103084,"trial_step":84},{"step":85,"content":"但现在不是同情她的时候，如果整个空间完全崩塌，也许真的会像卡米利安说的那样，将她永远困在睡梦中。","style":3,"background":10006,"log_type":1,"src_id":250103085,"trial_step":85},{"step":86,"options":["唤醒维多利亚！"],"style":6,"background":10006,"log_type":1,"src_id":250103086,"trial_step":86,"course":3,"choices":[{"text":"唤醒维多利亚！","goto":87}]},{"step":87,"options":["唤醒维多利亚！！"],"style":6,"background":10006,"log_type":1,"src_id":250103087,"trial_step":87,"course":3,"choices":[{"text":"唤醒维多利亚！！","goto":88}]},{"step":88,"options":["唤醒维多利亚！！！"],"style":6,"background":10006,"log_type":1,"src_id":250103088,"trial_step":88,"course":3,"choices":[{"text":"唤醒维多利亚！！！","goto":89}]},{"step":89,"content":"维多利亚！醒醒！","style":2,"background":10006,"log_type":1,"src_id":250103089,"trial_step":89},{"step":90,"speaker":"维多利亚","content":"是……局长的声音？","style":1,"background":10006,"log_type":1,"src_id":250103090,"trial_step":90},{"step":91,"content":"她第一次对你的呼唤有了反应！","style":3,"background":10006,"log_type":1,"src_id":250103091,"trial_step":91},{"step":92,"content":"你快醒来，这样真的会永远被困在睡梦中的！","style":2,"background":10006,"log_type":1,"src_id":250103092,"trial_step":92},{"step":93,"speaker":"维多利亚","content":"真的是……局长？我就知道，你一定会回来找我的！","style":1,"background":10006,"log_type":1,"src_id":250103093,"trial_step":93},{"step":94,"content":"维多利亚艰难地爬起来，四处搜寻着你的身影。","style":3,"background":10006,"log_type":1,"src_id":250103094,"trial_step":94},{"step":95,"content":"我不是回来找你的，大家也都不会回来。","style":2,"background":10006,"log_type":1,"src_id":250103095,"trial_step":95},{"step":96,"speaker":"维多利亚","content":"为什么？","style":1,"background":10006,"log_type":1,"src_id":250103096,"trial_step":96},{"step":97,"content":"因为你对生命错误的理解。","style":2,"background":10006,"log_type":1,"src_id":250103097,"trial_step":97},{"step":98,"speaker":"维多利亚","content":"错误的……","style":1,"background":10006,"log_type":1,"src_id":250103098,"trial_step":98},{"step":99,"speaker":"维多利亚","content":"祝福，治愈，健康，希望，死亡……维多利亚所知道的这些，都是错误的吗？","style":1,"background":10006,"log_type":1,"src_id":250103099,"trial_step":99},{"step":100,"content":"维多利亚神情矛盾地不断重复这个结论。","style":3,"background":10006,"log_type":1,"src_id":250103100,"trial_step":100},{"step":101,"speaker":"维多利亚","content":"可是……","style":1,"background":10006,"log_type":1,"src_id":250103101,"trial_step":101},{"step":102,"content":"她努力想要控制情绪，但肩膀仍不住地颤抖，眼泪不受控制地滑落。","style":3,"background":10006,"log_type":1,"src_id":250103102,"trial_step":102},{"step":103,"speaker":"维多利亚","content":"可是，究竟什么是正确的……","style":1,"background":10006,"log_type":1,"src_id":250103103,"trial_step":103},{"step":104,"speaker":"维多利亚","content":"我不知道啊。","style":1,"background":10006,"log_type":1,"src_id":250103104,"trial_step":104},{"step":105,"content":"她像个失控的孩子，哭了许久。\n你沉默着，等待她从积攒了多年的情绪中平复。","style":3,"background":10006,"log_type":1,"src_id":250103105,"trial_step":105},{"step":106,"options":["你还希望我回来吗？","你还想再被抛下吗？"],"style":6,"background":10006,"log_type":1,"src_id":250103106,"trial_step":106,"course":3,"choices":[{"text":"你还希望我回来吗？","goto":107},{"text":"你还想再被抛下吗？","goto":108}]},{"step":107,"content":"她含着眼泪，重重地点了点头。","style":3,"background":10006,"log_type":1,"src_id":250103107,"trial_step":107,"next":[109]},{"step":108,"content":"她含着眼泪，摇了摇头。","style":3,"background":10006,"log_type":1,"src_id":250103108,"trial_step":108},{"step":109,"content":"那你答应我，在你表达善意之前，征询对方的同意，考虑对方的感受，好吗？","style":2,"background":10006,"log_type":1,"src_id":250103109,"trial_step":109},{"step":110,"speaker":"维多利亚","content":"这样你就会回来了？","style":1,"background":10006,"log_type":1,"src_id":250103110,"trial_step":110},{"step":111,"content":"大家都会回来。","style":2,"background":10006,"log_type":1,"src_id":250103111,"trial_step":111},{"step":112,"speaker":"维多利亚","content":"研究室的大家也会回来吗？","style":1,"background":10006,"log_type":1,"src_id":250103112,"trial_step":112},{"step":113,"content":"唯独这个问题你无法回答。","style":3,"background":10006,"log_type":1,"src_id":250103113,"trial_step":113},{"step":114,"content":"你愿意相信我吗？\n相信我能带你学会什么是真正的“生命”，帮你的身心都成长得更加健全。","style":2,"background":10006,"log_type":1,"src_id":250103114,"trial_step":114},{"step":115,"speaker":"维多利亚","content":"嗯。","style":1,"background":10006,"log_type":1,"src_id":250103115,"trial_step":115},{"step":116,"content":"那我倒数三个数，你就会醒来，记住我们的约定，忘记不愉快的一切。","style":2,"background":10006,"log_type":1,"src_id":250103116,"trial_step":116},{"step":117,"content":"三——","style":2,"background":10006,"log_type":1,"src_id":250103117,"trial_step":117},{"st