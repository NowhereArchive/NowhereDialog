{"id":1050503,"chapter_id":1050503,"scene_id":1,"steps":[{"step":1,"content":"吱呀——","style":3,"background":1041,"log_type":1,"src_id":150503001,"trial_step":1},{"step":2,"content":"伴随着一阵让人牙齿发酸的响声，书房的门被渡鸦推开。","style":3,"background":1041,"log_type":1,"src_id":150503002,"trial_step":2},{"step":3,"content":"迎面而来的是数之不尽的照片，剪报，杂志。足足放满了大大小小十来个架子。","style":3,"background":1041,"log_type":1,"src_id":150503003,"trial_step":3},{"step":4,"content":"它的规格已经要和MBCC的四分之一个档案室差不多大小了。","style":3,"background":1041,"log_type":1,"src_id":150503004,"trial_step":4},{"step":5,"speaker":"玩家","content":"这上面都是……","style":2,"background":1041,"log_type":1,"src_id":150503005,"trial_step":5},{"step":6,"content":"你取下一本记事本，抖落掉上面的灰尘，并将它翻开。","style":3,"background":1041,"log_type":1,"src_id":150503006,"trial_step":6},{"step":7,"speaker":"渡鸦","content":"都是辛迪加的历史，从N.F.81年到N.F.114年，有我记的，也有别人记的。","voice":["vo_trial_50503_1_7"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503007,"trial_step":7},{"step":8,"speaker":"渡鸦","content":"我竭尽所能地收集辛迪加的英雄史诗，避免任何一个片段被人掩埋。","voice":["vo_trial_50503_1_8"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503008,"trial_step":8},{"step":9,"options":["你是什么时候开始收集它们的？"],"style":6,"background":1041,"log_type":1,"src_id":150503009,"trial_step":9,"course":3,"choices":[{"text":"你是什么时候开始收集它们的？","goto":10}]},{"step":10,"speaker":"渡鸦","content":"在我到新城之后的一段时间吧。小的时候，我们全家就已经搬到了新城。","voice":["vo_trial_50503_1_10"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503010,"trial_step":10},{"step":11,"speaker":"玩家","content":"怪不得，看你小时候的照片，有一阵可不怎么开心。","style":2,"background":1041,"log_type":1,"src_id":150503011,"trial_step":11},{"step":12,"content":"你看向档案室的墙面，几张闷闷不乐的小渡鸦的照片特别显眼。","style":3,"background":1041,"log_type":1,"src_id":150503012,"trial_step":12},{"step":13,"speaker":"渡鸦","content":"对啊！新城也就是看着热闹，其实无聊得很！","voice":["vo_trial_50503_1_13"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503013,"trial_step":13},{"step":14,"speaker":"渡鸦","content":"直到我在电视上看到那些危难时刻挺身而出的英雄们，目睹了在黑暗中燃烧的生命。","voice":["vo_trial_50503_1_14"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503014,"trial_step":14},{"step":15,"speaker":"渡鸦","content":"我终于发现，那才是我渡鸦想要追寻的东西。","voice":["vo_trial_50503_1_15"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503015,"trial_step":15},{"step":16,"speaker":"渡鸦","content":"在那之后，我就喜欢写写记记，时间就这么过去了十几年。","voice":["vo_trial_50503_1_16"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503016,"trial_step":16},{"step":17,"speaker":"渡鸦","content":"或许是在新城过得太无聊，也或许是想看一眼阔别已久的家乡。","voice":["vo_trial_50503_1_17"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503017,"trial_step":17},{"step":18,"speaker":"渡鸦","content":"我鬼使神差地加入了一家柳生的报社，给他们当公众号的写手。","voice":["vo_trial_50503_1_18"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503018,"trial_step":18},{"step":19,"speaker":"渡鸦","content":"哈哈……最有趣的是，在那地方。无论是炒作，还是写博人眼球的新闻，没一个人写得过我。","voice":["vo_trial_50503_1_19"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503019,"trial_step":19},{"step":20,"content":"渡鸦伸出一根手指，咧开了嘴眉飞色舞地讲述自己的光荣经历。","style":3,"background":1041,"log_type":1,"src_id":150503020,"trial_step":20},{"step":21,"speaker":"渡鸦","content":"于是过了一年，在103年时，我就被报社派到了辛迪加。但，那里早已不是我儿时的辛迪加了。","voice":["vo_trial_50503_1_21"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503021,"trial_step":21},{"step":22,"speaker":"渡鸦","content":"那里残渣满地，战火蔓延，只剩下满目疮痍。","voice":["vo_trial_50503_1_22"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503022,"trial_step":22},{"step":23,"speaker":"渡鸦","content":"也就是在那时，我亲眼目睹了那团在黑暗中燃烧着的火。","voice":["vo_trial_50503_1_23"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503023,"trial_step":23},{"step":24,"options":["你遇到了锈火？"],"style":6,"background":1041,"log_type":1,"src_id":150503024,"trial_step":24,"course":3,"choices":[{"text":"你遇到了锈火？","goto":25}]},{"step":25,"speaker":"渡鸦","content":"没错，你还挺懂的嘛！然后我就作为随行记者，直接跟着他们白吃白喝……啊不对，是密切报道。","voice":["vo_trial_50503_1_25"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503025,"trial_step":25},{"step":26,"speaker":"渡鸦","content":"不过那时候可真不太平，矿工们和涅槃的关系紧张得不行，涅槃打算废弃采矿的机器，工人们当然不乐意。","voice":["vo_trial_50503_1_26"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503026,"trial_step":26},{"step":27,"speaker":"渡鸦","content":"然后他们奋起反抗，竭尽所能，暂时逼停了涅槃的计划，把那个不可一世的涅槃都逼上了谈判桌。","voice":["vo_trial_50503_1_27"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503027,"trial_step":27},{"step":28,"speaker":"渡鸦","content":"当然，我也没闲着，我给他们拉横幅，写标语，还和他们一起拉回来好几台机器呢。","voice":["vo_trial_50503_1_28"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503028,"trial_step":28},{"step":29,"speaker":"渡鸦","content":"是个完美的故事，对吧？","voice":["vo_trial_50503_1_29"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503029,"trial_step":29},{"step":30,"content":"你点点头。","style":3,"background":1041,"log_type":1,"src_id":150503030,"trial_step":30},{"step":31,"speaker":"玩家","content":"但故事并没有结束。","style":2,"background":1041,"log_type":1,"src_id":150503031,"trial_step":31},{"step":32,"speaker":"渡鸦","content":"是啊……英雄打退了恶人，微光变成了烈火，照亮了如墨般的黑夜。","voice":["vo_trial_50503_1_32"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503032,"trial_step":32},{"step":33,"speaker":"渡鸦","content":"可最猛烈的火也会被暴雨浇灭，在W-31事件后，黑环爆发，带头的领袖也神秘失踪了。","voice":["vo_trial_50503_1_33"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503033,"trial_step":33},{"step":34,"speaker":"渡鸦","content":"我返回新城，用尽全力宣扬英雄们的伟大壮举，希望所有人都能铭记他们。","voice":["vo_trial_50503_1_34"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503034,"trial_step":34},{"step":35,"speaker":"渡鸦","content":"但你知道的，在当时的新城，关于涅槃的报道全都会被第一时间撤掉。","voice":["vo_trial_50503_1_35"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503035,"trial_step":35},{"step":36,"speaker":"渡鸦","content":"他们会请你喝茶，然后给你一些“友好建议”。","voice":["vo_trial_50503_1_36"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503036,"trial_step":36},{"step":37,"options":["你被他们“请”了多少次？"],"style":6,"background":1041,"log_type":1,"src_id":150503037,"trial_step":37,"course":3,"choices":[{"text":"你被他们“请”了多少次？","goto":38}]},{"step":38,"speaker":"渡鸦","content":"哈，这么说吧，比我回家的次数还多，新城治安局的办公室我闭着眼睛都能走上两圈。","voice":["vo_trial_50503_1_38"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503038,"trial_step":38},{"step":39,"content":"渡鸦耸耸肩，一脸的无所谓。","style":3,"background":1041,"log_type":1,"src_id":150503039,"trial_step":39},{"step":40,"speaker":"渡鸦","content":"当然，对他们而言，我记下的英雄事迹对他们是种威胁。很快，他们就对我动手了。","voice":["vo_trial_50503_1_40"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503040,"trial_step":40},{"step":41,"speaker":"渡鸦","content":"由于我知道太多W-31的事情，涅槃的特殊部门“DRD”盯上了我，他们直接把“危害新城治安”“屡次破坏公共秩序”“传播不实消息”这样的罪名安在了我的头上。","voice":["vo_trial_50503_1_41"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503041,"trial_step":41},{"step":42,"options":["那之后，你还好么？"],"style":6,"background":1041,"log_type":1,"src_id":150503042,"trial_step":42,"course":3,"choices":[{"text":"那之后，你还好么？","goto":43}]},{"step":43,"speaker":"渡鸦","content":"当然好了，他们算哪根葱，充其量也就能把我的眼皮弄破个口。","voice":["vo_trial_50503_1_43"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503043,"trial_step":43},{"step":44,"content":"渡鸦像个没事人一样，一脸轻松地向你摆了摆手。","style":3,"background":1041,"log_type":1,"src_id":150503044,"trial_step":44},{"step":45,"content":"但，真的会是这样么。涅槃的秘密部门，怎么能轻易放过自己的敌人。","style":3,"background":1041,"log_type":1,"src_id":150503045,"trial_step":45},{"step":46,"speaker":"？？","content":"你认罪么？","voice":["vo_trial_50503_1_47"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503047,"trial_step":47},{"step":47,"speaker":"瑞文","content":"哈哈，记下英雄们的英姿，在你们的眼里就是“罪”。是么？","voice":["vo_trial_50503_1_48"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503048,"trial_step":48},{"step":48,"speaker":"？？","content":"看来你脑子不太好，你们教教她吧，教教她什么叫认罪。","voice":["vo_trial_50503_1_49"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503049,"trial_step":49},{"step":49,"speaker":"瑞文","content":"呵，你们越对我做这种事，就证明那群人是英雄！","voice":["vo_trial_50503_1_50"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503050,"trial_step":50},{"step":50,"speaker":"？？","content":"拖下去，让她安静一会儿。","voice":["vo_trial_50503_1_51"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503051,"trial_step":51},{"step":51,"speaker":"？？","content":"你认罪么？","voice":["vo_trial_50503_1_53"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503053,"trial_step":53},{"step":52,"speaker":"瑞文","content":"我记下了……它们的壮举……","voice":["vo_trial_50503_1_54"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503054,"trial_step":54},{"step":53,"speaker":"？？","content":"受不了，怎么会有这么蠢的人。","voice":["vo_trial_50503_1_55"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503055,"trial_step":55},{"step":54,"speaker":"瑞文","content":"哈哈，哈哈哈哈……","voice":["vo_trial_50503_1_56"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503056,"trial_step":56},{"step":55,"speaker":"？？","content":"你笑什么，精神不正常了？","voice":["vo_trial_50503_1_57"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503057,"trial_step":57},{"step":56,"speaker":"瑞文","content":"对啊……我记录的是英雄们的故事……","voice":["vo_trial_50503_1_58"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503058,"trial_step":58},{"step":57,"speaker":"瑞文","content":"英雄们的故事里怎么少得了你们这种……肮脏的沟鼠呢……有了你们，才显得他们更加崇高啊……","voice":["vo_trial_50503_1_59"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503059,"trial_step":59},{"step":58,"speaker":"？？","content":"疯子。","voice":["vo_trial_50503_1_60"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503060,"trial_step":60},{"step":59,"speaker":"？？","content":"留一口气，别打死了。","voice":["vo_trial_50503_1_61"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503061,"trial_step":61},{"step":60,"speaker":"？？","content":"你认罪么？","voice":["vo_trial_50503_1_63"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503063,"trial_step":63},{"step":61,"speaker":"瑞文","content":"……","voice":["vo_trial_50503_1_64"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503064,"trial_step":64},{"step":62,"speaker":"瑞文","content":"……呵，哈哈哈，你们害怕辛迪加的英雄……害怕锈火烧到你们身上……","voice":["vo_trial_50503_1_65"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503065,"trial_step":65},{"step":63,"speaker":"？？","content":"肋骨都被打断了，还有力气叫唤。","voice":["vo_trial_50503_1_66"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503066,"trial_step":66},{"step":64,"speaker":"？？","content":"把她关起来，我不想再听疯子说话了。","voice":["vo_trial_50503_1_67"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503067,"trial_step":67},{"step":65,"content":"经历了这种事还能这样站在你的面前，她不愧是位战斗的诗人。","style":3,"background":1041,"log_type":1,"src_id":150503069,"trial_step":69},{"step":66,"speaker":"渡鸦","content":"怎么，找到什么感兴趣的东西了，看得这么认真？","voice":["vo_trial_50503_1_70"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503070,"trial_step":70},{"step":67,"content":"一旁的渡鸦将脸凑了过来，你连忙将笔记再翻一页。","style":3,"background":1041,"log_type":1,"src_id":150503071,"trial_step":71},{"step":68,"speaker":"玩家","content":"记录而已。比起这个，你是怎么冒出想当老师的念头的？你看起来应该对这类职业没什么兴趣。","style":2,"background":1041,"log_type":1,"src_id":150503072,"trial_step":72},{"step":69,"speaker":"渡鸦","content":"谁说不是呢，要是DRD能少纠缠我一阵，可能我也没这念头了吧。","voice":["vo_trial_50503_1_73"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503073,"trial_step":73},{"step":70,"speaker":"渡鸦","content":"他们拿我没什么办法，就把我送到了新城与辛迪加附近的一个看守所。","voice":["vo_trial_50503_1_74"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503074,"trial_step":74},{"step":71,"options":["那边环境应该很差吧？"],"style":6,"background":1041,"log_type":1,"src_id":150503075,"trial_step":75,"course":3,"choices":[{"text":"那边环境应该很差吧？","goto":76}]},{"step":72,"speaker":"渡鸦","content":"对啊！环境差就算了，最让人难受的是，在那边根本没人和我说话，就连送饭的人都是隔得老远把饭从门口塞进来。","voice":["vo_trial_50503_1_76"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503076,"trial_step":76},{"step":73,"content":"真是辛苦她了，受了那么重的伤还要被那么折腾。","style":3,"background":1041,"log_type":1,"src_id":150503077,"trial_step":77},{"step":74,"speaker":"渡鸦","content":"那些都不是重点，重点是没人能和我说话，不让人和我接触，我优秀的诗歌不就没办法传给别人了吗？","voice":["vo_trial_50503_1_78"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503078,"trial_step":78},{"step":75,"speaker":"渡鸦","content":"没办法传给别人，我狄斯诗人渡鸦的名字，还怎么传遍天下呀？！","voice":["vo_trial_50503_1_79"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503079,"trial_step":79},{"step":76,"speaker":"玩家","content":"……","style":2,"background":1041,"log_type":1,"src_id":150503080,"trial_step":80},{"step":77,"content":"渡鸦咚咚地敲着桌子，你感觉书房柜子上的灰都被她震下来两层。","style":3,"background":1041,"log_type":1,"src_id":150503081,"trial_step":81},{"step":78,"content":"不愧是她。","style":3,"background":1041,"log_type":1,"src_id":150503082,"trial_step":82},{"step":79,"speaker":"渡鸦","content":"不过还是有点好事的，起码那边的窗户不怎么高，我随便垫点东西就能爬上去。","voice":["vo_trial_50503_1_83"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503083,"trial_step":83},{"step":80,"speaker":"渡鸦","content":"透过窗户，我总是能看到窗外有一群辛迪加孩子在给那帮看守添堵。","voice":["vo_trial_50503_1_84"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503084,"trial_step":84},{"step":81,"speaker":"渡鸦","content":"他们每天都会不厌其烦地嘲讽这些守卫，或者给这些警卫们扔石块、做鬼脸。","voice":["vo_trial_50503_1_85"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503085,"trial_step":85},{"step":82,"speaker":"渡鸦","content":"哈哈……还挺解气的，因为有西区条约，那些守卫只能憋着气赶那些孩子，就算最生气的时候，他们也只能朝天上开开枪。","voice":["vo_trial_50503_1_86"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503086,"trial_step":86},{"step":83,"speaker":"渡鸦","content":"我就每天坐在窗边，给那些孩子们加加油，挥挥手。","voice":["vo_trial_50503_1_87"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503087,"trial_step":87},{"step":84,"speaker":"渡鸦","content":"……也不知道是哪一天，铁栅栏底下就凑过来一个好奇的小脑袋。","voice":["vo_trial_50503_1_88"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503088,"trial_step":88},{"step":85,"speaker":"瑞文","content":"你叫什么名字？","voice":["vo_trial_50503_1_90"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503090,"trial_step":90},{"step":86,"speaker":"迈尔斯","content":"迈尔斯，你呢，大姐姐？","voice":["vo_trial_50503_1_91"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503091,"trial_step":91},{"step":87,"speaker":"瑞文","content":"瑞文。","voice":["vo_trial_50503_1_92"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503092,"trial_step":92},{"step":88,"speaker":"迈尔斯","content":"瑞文大姐姐，你来这里多久了？","voice":["vo_trial_50503_1_93"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503093,"trial_step":93},{"step":89,"speaker":"瑞文","content":"一个多月了，说了点别人的英雄事迹就进来了。","voice":["vo_trial_50503_1_94"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503094,"trial_step":94},{"step":90,"content":"我看向墙壁，上面已经被我刻满了横与竖。现在，机会终于来了。","style":3,"background":932,"log_type":1,"src_id":150503095,"trial_step":95},{"step":91,"speaker":"瑞文","content":"嘿嘿……你有兴趣帮姐姐一个小忙吗？就一个小忙！","voice":["vo_trial_50503_1_96"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503096,"trial_step":96},{"step":92,"speaker":"迈尔斯","content":"不要。","voice":["vo_trial_50503_1_97"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503097,"trial_step":97},{"step":93,"content":"啧，直觉敏锐的小鬼。","style":3,"background":932,"log_type":1,"src_id":150503098,"trial_step":98},{"step":94,"speaker":"瑞文","content":"哈哈哈……哎呀，就是让你传传纸条什么的，很简单的！","voice":["vo_trial_50503_1_99"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503099,"trial_step":99},{"step":95,"speaker":"迈尔斯","content":"不要。","voice":["vo_trial_50503_1_100"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503100,"trial_step":100},{"step":96,"speaker":"瑞文","content":"传辛迪加著名诗人瑞文的诗你也不答应？这可是能流芳百世的机会！","voice":["vo_trial_50503_1_101"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503101,"trial_step":101},{"step":97,"speaker":"迈尔斯","content":"不要。","voice":["vo_trial_50503_1_102"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503102,"trial_step":102},{"step":98,"speaker":"瑞文","content":"啊呀？你怎么回事，在辛迪加住了这么久，难道没听说过我渡鸦的大名？","voice":["vo_trial_50503_1_103"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503103,"trial_step":103},{"step":99,"speaker":"迈尔斯","content":"没有。","voice":["vo_trial_50503_1_104"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503104,"trial_step":104},{"step":100,"content":"栅栏对面的孩子摇了摇头。","style":3,"background":932,"log_type":1,"src_id":150503105,"trial_step":105},{"step":101,"speaker":"迈尔斯","content":"而且……我也不想我是辛迪加人，我想去东边的新城。","voice":["vo_trial_50503_1_106"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503106,"trial_step":106},{"step":102,"speaker":"瑞文","content":"唉，新城那破地方有什么好的，大半夜的灯都能把眼睛晃瞎！","voice":["vo_trial_50503_1_107"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503107,"trial_step":107},{"step":103,"speaker":"迈尔斯","content":"至少，在那边的话，每天就能吃饱饭了。","voice":["vo_trial_50503_1_108"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503108,"trial_step":108},{"step":104,"speaker":"迈尔斯","content":"……但是我的同伴们说，想要去那边得要会写字。","voice":["vo_trial_50503_1_109"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503109,"trial_step":109},{"step":105,"speaker":"瑞文","content":"哎呀！这你可就找对人了！不好意思啊，小迈尔斯，姐姐我向你隐瞒了一件大事！","voice":["vo_trial_50503_1_110"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503110,"trial_step":110},{"step":106,"speaker":"瑞文","content":"其实……","voice":["vo_trial_50503_1_111"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503111,"trial_step":111},{"step":107,"speaker":"迈尔斯","content":"其实？","voice":["vo_trial_50503_1_112"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503112,"trial_step":112},{"step":108,"speaker":"瑞文","content":"其实我是一个老师。","voice":["vo_trial_50503_1_113"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503113,"trial_step":113},{"step":109,"speaker":"迈尔斯","content":"老师，是什么？","voice":["vo_trial_50503_1_114"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503114,"trial_step":114},{"step":110,"speaker":"瑞文","content":"就是可以教你知识，教你·写·字的那种人，当然，还能顺便教你几首诗哦。","voice":["vo_trial_50503_1_115"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503115,"trial_step":115},{"step":111,"content":"我特意强调了写字两个字之后，他看向我的眼神瞬间就不一样了。","style":3,"background":932,"log_type":1,"src_id":150503116,"trial_step":116},{"step":112,"speaker":"瑞文","content":"今天的诗传出去了么？","voice":["vo_trial_50503_1_118"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503118,"trial_step":118},{"step":113,"speaker":"迈尔斯","content":"嗯，我趁那些看守不注意的时候贴在他们大门上了。","voice":["vo_trial_50503_1_119"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503119,"trial_step":119},{"step":114,"speaker":"瑞文","content":"真厉害，我瑞文果然没看错人！来吧，我们来上课吧！","voice":["vo_trial_50503_1_120"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503120,"trial_step":120},{"step":115,"content":"我和这个叫迈尔斯的孩子达成了一个“交易”。我用假扮的教师身份教他写字，他帮我将诗歌带出这封闭的看守所。","style":3,"background":932,"log_type":1,"src_id":150503121,"trial_step":121},{"step":116,"content":"一如往常，在教会他字词读音之后，我刷刷地写好了几个字，连带纸笔递出了窗口。","style":3,"background":932,"log_type":1,"src_id":150503122,"trial_step":122},{"step":117,"content":"但迈尔斯却迟迟不动笔。","style":3,"background":932,"log_type":1,"src_id":150503123,"trial_step":123},{"step":118,"speaker":"瑞文","content":"怎么了，是瑞文老师今天教的字太难了么？","voice":["vo_trial_50503_1_124"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503124,"trial_step":124},{"step":119,"speaker":"迈尔斯","content":"……我今天能先听完那个《辛迪加英雄传》再学习么？","voice":["vo_trial_50503_1_125"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503125,"trial_step":125},{"step":120,"speaker":"瑞文","content":"咳……咳咳……","voice":["vo_trial_50503_1_126"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503126,"trial_step":126},{"step":121,"content":"——那是我昨天为了哄他帮我传诗歌，一时兴起编出来的东西。但作为一个合格的老师，怎么能拒绝学生的要求呢？","style":3,"background":932,"log_type":1,"src_id":150503127,"trial_step":127},{"step":122,"speaker":"瑞文","content":"当然没问题，不过老师昨天讲到哪里了？能不能提醒老师一下呀？","voice":["vo_trial_50503_1_128"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503128,"trial_step":128},{"step":123,"speaker":"迈尔斯","content":"胜天半子于连！","voice":["vo_trial_50503_1_129"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503129,"trial_step":129},{"step":124,"speaker":"瑞文","content":"啊，好好好，那我们今天就来讲讲锈火的另一位英雄——丈二奔雷枪！","voice":["vo_trial_50503_1_130"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503130,"trial_step":130},{"step":125,"speaker":"迈尔斯","content":"哇，听着就觉得好厉害……","voice":["vo_trial_50503_1_131"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503131,"trial_step":131},{"step":126,"speaker":"迈尔斯","content":"瑞文姐姐。","voice":["vo_trial_50503_1_133"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503133,"trial_step":133},{"step":127,"speaker":"瑞文","content":"怎么了？","voice":["vo_trial_50503_1_134"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503134,"trial_step":134},{"step":128,"content":"迈尔斯在窗外努力地练习着写字，虽然那还不能被称为“字”，但已经比最开始的时候好上太多了。","style":3,"background":932,"log_type":1,"src_id":150503135,"trial_step":135},{"step":129,"speaker":"迈尔斯","content":"我好像没那么讨厌辛迪加了，我想留在这里。","voice":["vo_trial_50503_1_136"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503136,"trial_step":136},{"step":130,"speaker":"瑞文","content":"你不想去新城了？","voice":["vo_trial_50503_1_137"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503137,"trial_step":137},{"step":131,"speaker":"迈尔斯","content":"嗯，我以前嫌弃辛迪加，嫌弃它又破又烂。","voice":["vo_trial_50503_1_138"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503138,"trial_step":138},{"step":132,"speaker":"迈尔斯","content":"现在你告诉我它经历过什么，告诉我它原本的模样，又有无数的人在为它努力。","voice":["vo_trial_50503_1_139"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503139,"trial_step":139},{"step":133,"speaker":"迈尔斯","content":"而且……","voice":["vo_trial_50503_1_140"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503140,"trial_step":140},{"step":134,"speaker":"迈尔斯","content":"光我自己一个人吃饱饭的话也太自私了，我想让伙伴们都吃饱饭。","voice":["vo_trial_50503_1_141"],"voice_bank":"vo_raven_trial","style":1,"background":932,"log_type":1,"src_id":150503141,"trial_step":141},{"step":135,"content":"我看向窗外的迈尔斯，他正在全神贯注地描摹我的诗歌。","voice":["vo_trial_50503_1_142"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503142,"trial_step":142},{"step":136,"content":"虽然那可能只是童言无忌，但他的眼神坚定，灵魂熊熊燃烧。","voice":["vo_trial_50503_1_143"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503143,"trial_step":143},{"step":137,"content":"我总是在想，我要是个真正的老师就好了，肯定能教给他更好的东西。","voice":["vo_trial_50503_1_144"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503144,"trial_step":144},{"step":138,"content":"如果不出意外的话，他也会为我带来新的诗篇吧。","voice":["vo_trial_50503_1_145"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503145,"trial_step":145},{"step":139,"content":"但意外总是来得很突然，我的诗不知怎么被看守所的守卫们发现。","voice":["vo_trial_50503_1_146"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503146,"trial_step":146},{"step":140,"content":"我就这样被剥夺了书写和记录的权力，他们没收了我的钢笔，我的墨水，我的纸张……甚至还驱逐了迈尔斯，不让他和我继续接触。","voice":["vo_trial_50503_1_147"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503147,"trial_step":147},{"step":141,"content":"他们以为这样就能让我闭上嘴。哈哈，怎么可能。","voice":["vo_trial_50503_1_148"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503148,"trial_step":148},{"step":142,"content":"我偏要写。既然再也没有机会将它们传递出去，我便要将一切留在这里。","voice":["vo_trial_50503_1_149"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503149,"trial_step":149},{"step":143,"content":"我开始找砖头，墙灰……总之，一切有颜色的东西都被我翻了出来，让它们成为我的笔。","voice":["vo_trial_50503_1_150"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503150,"trial_step":150},{"step":144,"content":"这些东西很快就被我用光了，牢房的墙面连一抹灰都刮不下来。","voice":["vo_trial_50503_1_151"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503151,"trial_step":151},{"step":145,"content":"我咬破了自己的手指，用自己的鲜血继续书写着属于辛迪加的英雄史诗。","voice":["vo_trial_50503_1_152"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503152,"trial_step":152},{"step":146,"content":"为了有人能铭记他们，为了鼓舞后人们，为了迈尔斯，也为了我自己。","voice":["vo_trial_50503_1_153"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503153,"trial_step":153},{"step":147,"content":"缺氧与失血腐蚀着我的身体，我很快就要什么都看不见了。","voice":["vo_trial_50503_1_154"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503154,"trial_step":154},{"step":148,"content":"就连写下的字都歪歪扭扭，像一只又一只的乌鸦一样，真是滑稽。","voice":["vo_trial_50503_1_155"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503155,"trial_step":155},{"step":149,"content":"就在我闭上眼睛，失去意识的前夕，我看到墙上的字真的像长出了翅膀一样，一个又一个地飞出了钢铁的栅栏。","voice":["vo_trial_50503_1_156"],"voice_bank":"vo_raven_trial","style":3,"background":10000,"log_type":1,"src_id":150503156,"trial_step":156},{"step":150,"content":"当我再度恢复清醒时，墙壁上的字早已消失得无影无踪，牢房中的一群乌鸦正围着一张纸条嘎嘎地叫着。","voice":["vo_trial_50503_1_157"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503157,"trial_step":157},{"step":151,"content":"它们看到我恢复意识，便叼着那纸条飞到我的手上。","voice":["vo_trial_50503_1_158"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503158,"trial_step":158},{"step":152,"content":"我打开纸条，上面正是我熟悉的，歪歪扭扭的字——","voice":["vo_trial_50503_1_159"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503159,"trial_step":159},{"step":153,"content":"“谢谢你，瑞文姐姐。”","voice":["vo_trial_50503_1_160"],"voice_bank":"vo_raven_trial","style":3,"background":932,"log_type":1,"src_id":150503160,"trial_step":160},{"step":154,"content":"他们以为这样就能撕烂我的诗歌，真是可笑。","voice":["vo_trial_50503_1_161"],"voice_bank":"vo_raven_trial","style":3,"background":10000,"log_type":1,"src_id":150503161,"trial_step":161},{"step":155,"content":"我的意志早就以“渡鸦”之名长出了翅膀，飞离了牢笼。","voice":["vo_trial_50503_1_162"],"voice_bank":"vo_raven_trial","style":3,"background":10000,"log_type":1,"src_id":150503162,"trial_step":162},{"step":156,"speaker":"玩家","content":"你就这样成为了一名禁闭者，也有了当老师的念头。","style":2,"background":1041,"log_type":1,"src_id":150503164,"trial_step":164},{"step":157,"speaker":"渡鸦","content":"没错，在那之后看守所的人也拿我没办法，“瑞文”闭上了嘴，但说话的人变成了“渡鸦”。","voice":["vo_trial_50503_1_165"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503165,"trial_step":165},{"step":158,"speaker":"渡鸦","content":"在里外都没有证据的情况下，他们也只能把我给放了。","voice":["vo_trial_50503_1_166"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503166,"trial_step":166},{"step":159,"speaker":"渡鸦","content":"好不容易得到的能力我也没浪费，为了报复那帮混蛋，我在辛迪加和新城好一顿折腾。当然了，我的能力也随着我的出生入死变得越来越强。","voice":["vo_trial_50503_1_167"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503167,"trial_step":167},{"step":160,"speaker":"渡鸦","content":"我还在精神病院见到了被当成了叛徒的唐，虽然他求我别把自己活着的消息告诉于连——但我可不管。","voice":["vo_trial_50503_1_168"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503168,"trial_step":168},{"step":161,"speaker":"渡鸦","content":"在那之后，我加入了锈火，成为了他们的得力干将，再一次目睹了辛迪加的变迁。","voice":["vo_trial_50503_1_169"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503169,"trial_step":169},{"step":162,"speaker":"渡鸦","content":"哦对了，后来我还找到了当年那个DRD，给他们打得满地找牙。","voice":["vo_trial_50503_1_170"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503170,"trial_step":170},{"step":163,"speaker":"玩家","content":"再之后你就作为卧底加入了执委会了吧？","style":2,"background":1041,"log_type":1,"src_id":150503171,"trial_step":171},{"step":164,"speaker":"渡鸦","content":"嗯哼，接下来就是遇到你和你们MBCC的故事了。","voice":["vo_trial_50503_1_172"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503172,"trial_step":172},{"step":165,"content":"恢弘的英雄故事，足以改变辛迪加时代的伟人，反抗不公的压迫……","voice":["vo_trial_50503_1_173"],"voice_bank":"vo_raven_trial","style":3,"background":1041,"log_type":1,"src_id":150503173,"trial_step":173},{"step":166,"content":"这一定是渡鸦想要记载的历史吧。","voice":["vo_trial_50503_1_174"],"voice_bank":"vo_raven_trial","style":3,"background":1041,"log_type":1,"src_id":150503174,"trial_step":174},{"step":167,"content":"你走到渡鸦桌子前，拿起了她桌上封面写着“历史”的课本，那是渡鸦改编的教材。","voice":["vo_trial_50503_1_175"],"voice_bank":"vo_raven_trial","style":3,"background":1041,"log_type":1,"src_id":150503175,"trial_step":175},{"step":168,"content":"你将它打开，准备欣赏这位诗人的心血之作。","voice":["vo_trial_50503_1_176"],"voice_bank":"vo_raven_trial","style":3,"background":1041,"log_type":1,"src_id":150503176,"trial_step":176},{"step":169,"content":"但你将它翻开后，却发现教材的内容与你所想大相径庭。","voice":["vo_trial_50503_1_177"],"voice_bank":"vo_raven_trial","style":3,"background":1041,"log_type":1,"src_id":150503177,"trial_step":177},{"step":170,"content":"除了在第一页上记录了N.F.81年辛迪加的历史之外，其余书页上无一例外都是空白。","voice":["vo_trial_50503_1_178"],"voice_bank":"vo_raven_trial","style":3,"background":1041,"log_type":1,"src_id":150503178,"trial_step":178},{"step":171,"options":["这是怎么回事？"],"voice":["vo_trial_50503_1_179"],"voice_bank":"vo_raven_trial","style":6,"background":1041,"log_type":1,"src_id":150503179,"trial_step":179,"course":3,"choices":[{"text":"这是怎么回事？","goto":180}]},{"step":172,"speaker":"玩家","content":"为什么是空白？难道你不想把那些故事都告诉孩子们吗？","voice":["vo_trial_50503_1_180"],"voice_bank":"vo_raven_trial","style":2,"background":1041,"log_type":1,"src_id":150503180,"trial_step":180},{"step":173,"speaker":"渡鸦","content":"……","voice":["vo_trial_50503_1_181"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503181,"trial_step":181},{"step":174,"content":"渡鸦张了张嘴，没能发出声音。","style":3,"background":1041,"log_type":1,"src_id":150503182,"trial_step":182},{"step":175,"speaker":"渡鸦","content":"我也想。","voice":["vo_trial_50503_1_183"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503183,"trial_step":183},{"step":176,"speaker":"渡鸦","content":"我也这么做过。","voice":["vo_trial_50503_1_184"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503184,"trial_step":184},{"step":177,"speaker":"渡鸦","content":"我告诉了他新城的虚伪，涅槃的狡诈，W-31的冤屈，还用英雄故事给了他希望。","voice":["vo_trial_50503_1_185"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503185,"trial_step":185},{"step":178,"speaker":"渡鸦","content":"但他死了。","voice":["vo_trial_50503_1_186"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503186,"trial_step":186},{"step":179,"speaker":"渡鸦","content":"迈尔斯死了。","voice":["vo_trial_50503_1_187"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503187,"trial_step":187},{"step":180,"speaker":"渡鸦","content":"他憎恨新城，憎恨涅槃，憎恨一切辛迪加的敌人。","voice":["vo_trial_50503_1_188"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503188,"trial_step":188},{"step":181,"speaker":"渡鸦","content":"在一次激进的行动里，他偷了一个锈火战士的武器，跨过了栅栏，被一颗子弹打中了脑袋。","voice":["vo_trial_50503_1_189"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503189,"trial_step":189},{"step":182,"speaker":"渡鸦","content":"是我的错，我要是没教给他那么多东西就好了，他就乖乖待在锈火，做我的第一个学生。","voice":["vo_trial_50503_1_190"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503190,"trial_step":190},{"step":183,"speaker":"渡鸦","content":"哈哈……直到现在我都记得很清楚，那是我唯一一次和于连发火，怪他连一个孩子都看不住。","voice":["vo_trial_50503_1_191"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503191,"trial_step":191},{"step":184,"speaker":"渡鸦","content":"但我不光是对他发火，也是对自己发火。","voice":["vo_trial_50503_1_192"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503192,"trial_step":192},{"step":185,"speaker":"渡鸦","content":"孩子们有权力接受真相，但真相太过沉重，却又太容易把他们压垮。","voice":["vo_trial_50503_1_193"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503193,"trial_step":193},{"step":186,"content":"渡鸦将自己昔日皱皱巴巴的记者证递到了你的手上。","style":3,"background":1041,"log_type":1,"src_id":150503194,"trial_step":194},{"step":187,"speaker":"渡鸦","content":"在辛迪加，已经有太多这样的孩子了，他们会依照本能做出决定。","voice":["vo_trial_50503_1_195"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503195,"trial_step":195},{"step":188,"speaker":"渡鸦","content":"伊卡要为他的父母报仇，因为他们被执行官抓进拘禁所，死在那里。","voice":["vo_trial_50503_1_196"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503196,"trial_step":196},{"step":189,"speaker":"渡鸦","content":"科希被卖给柳生，她无条件地憎恨所有大人。","voice":["vo_trial_50503_1_197"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503197,"trial_step":197},{"step":190,"speaker":"渡鸦","content":"我仍然爱黑暗中的英雄故事，但，我该传递什么样的故事给这些孩子？","voice":["vo_trial_50503_1_198"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503198,"trial_step":198},{"step":191,"options":["我也不知道"],"style":6,"background":1041,"log_type":1,"src_id":150503199,"trial_step":199,"course":3,"choices":[{"text":"我也不知道","goto":200}]},{"step":192,"content":"你上前一步，握住了渡鸦微微颤抖的双手。","style":3,"background":1041,"log_type":1,"src_id":150503200,"trial_step":200},{"step":193,"speaker":"玩家","content":"但我希望你在明天的课上，能再给孩子们一次选择的机会。","style":2,"background":1041,"log_type":1,"src_id":150503201,"trial_step":201}]}