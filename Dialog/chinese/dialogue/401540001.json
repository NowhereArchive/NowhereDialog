{"id":401540001,"chapter_id":50045,"scene_id":45002,"steps":[{"step":1,"speaker":"吟游诗人","content":"~~~~","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":2,"speaker":"吟游诗人","content":"“岁末良夜，来者盛装 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":3,"speaker":"吟游诗人","content":"“一期一会的神秘剧场 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":4,"speaker":"吟游诗人","content":"“是雪落还是清冷的月光？”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":5,"speaker":"吟游诗人","content":"“我见来客内心惶惶 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":6,"speaker":"吟游诗人","content":"“门缝漏出了传说乐章 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":7,"speaker":"吟游诗人","content":"“你是否也在寻求释放？ ”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":8,"speaker":"吟游诗人","content":"“莫彷徨，莫彷徨 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":9,"speaker":"吟游诗人","content":"“金色流苏在地面徜徉 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":10,"speaker":"吟游诗人","content":"“莫彷徨，莫彷徨。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":11,"speaker":"吟游诗人","content":"“帷幕揭开等首秀开场 。”","style":1,"background":1069,"is_centered":true,"log_type":1}]}