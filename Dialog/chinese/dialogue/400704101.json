{"id":400704101,"chapter_id":50019,"scene_id":51905,"steps":[{"step":1,"content":"咔嚓，咔嚓。","style":3,"background":10000,"log_type":1},{"step":2,"content":"咔嚓，咔嚓。","style":3,"background":10000,"log_type":1},{"step":3,"content":"“它”如附骨之疽般跟随着你，无论你怎么尝试，都无法在这团漆黑的迷雾中找到出口。","style":3,"background":2080,"log_type":1},{"step":4,"content":"它的声音越来越近，你似乎已经能看到那迷雾下的面容。","style":3,"background":2080,"log_type":1},{"step":5,"content":"咔嚓，咔嚓。","style":3,"background":2080,"log_type":1},{"step":6,"content":"狭窄逼仄的暗巷内，已经没有任何空间供你躲藏。","style":3,"background":2080,"log_type":1},{"step":7,"content":"就在万事休矣时——","style":3,"background":2080,"log_type":1},{"step":8,"content":"拍拍。","style":3,"background":2080,"log_type":1},{"step":9,"content":"触感从肩膀处传来。","style":3,"background":2080,"log_type":1},{"step":10,"speaker":"？？","content":"快……过来……","voice":["vo_event_400704101_10"],"voice_bank":"vo_event_07041","style":1,"background":2080,"log_type":1},{"step":11,"options":["！！"],"jump":[12],"style":6,"background":2080,"log_type":1},{"step":12,"content":"你慌忙扭头查看，却只看到一团灯火在你的面前一闪而过。","style":3,"background":2080,"log_type":1},{"step":13,"content":"灯火穿过迷雾，停驻在你的前方，似乎是想让你跟上它。","style":3,"background":2080,"log_type":1},{"step":14,"options":["跟上灯火"],"jump":[15],"style":6,"background":2080,"log_type":1},{"step":15,"content":"虽然不知道这东西是敌是友，但它至少能在那层雾墙内自由行动。","style":3,"background":2080,"log_type":1},{"step":16,"content":"你决定赌上一次，跟上它，没准就能离开这里。","style":3,"background":2080,"log_type":1}]}