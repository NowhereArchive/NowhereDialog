{"id":1050903,"chapter_id":1050903,"scene_id":1,"steps":[{"step":1,"content":"N.F.115年 某日凌晨\n\n2:50\n\n使馆大酒店，A502号套房","style":9,"background":2087,"log_type":1,"src_id":150903001,"trial_step":1},{"step":2,"content":"敞开的套房门没有任何入侵痕迹，窗户也都关紧了，但本该躺在床上的魏先生不见踪影，而屋内留下了淡淡的紫藤花香气。","style":3,"background":2087,"log_type":1,"src_id":150903002,"trial_step":2},{"step":3,"speaker":"夜莺","content":"局长，酒店监控录像受狂厄干扰，只拍到很少的画面。凌晨1点，魏先生的轮椅被怪异的藤蔓牵引，离开酒店。","voice":["vo_trial_50903_1_7"],"voice_bank":"vo_yingying_trial","style":1,"background":2085,"log_type":1,"src_id":150903004,"trial_step":4},{"step":4,"speaker":"夜莺","content":"那时酒店工作人员都陷入短暂睡眠，很可能也是萦萦做的。","voice":["vo_trial_50903_1_8"],"voice_bank":"vo_yingying_trial","style":1,"background":2085,"log_type":1,"src_id":150903005,"trial_step":5},{"step":5,"content":"你专注地看着监控画面。","style":3,"background":2085,"log_type":1,"src_id":150903006,"trial_step":6},{"step":6,"speaker":"${PlayerName}","content":"他脸上并没有惊恐或是害怕的神色，反倒像在跟谁说笑，比上次见面要精神多了。","options":["101"],"style":2,"background":2085,"log_type":1,"src_id":150903007,"trial_step":7},{"step":7,"options":["尝试利用枷锁找人","询问魏紫衣"],"style":6,"background":2087,"log_type":1,"src_id":150903009,"trial_step":9,"course":3,"choices":[{"text":"尝试利用枷锁找人","goto":10},{"text":"询问魏紫衣","goto":11}]},{"step":8,"content":"你试着释放了枷锁的感应。却只能感知到原本就伫立在城中的巨大紫藤残骸，花枝实在是太小了，根本感知不到。","style":3,"background":2087,"log_type":1,"src_id":150903010,"trial_step":10},{"step":9,"speaker":"${PlayerName}","content":"魏小姐，现在时间紧急，急需线索，我希望你不要隐瞒。","options":["101"],"style":2,"background":2087,"log_type":1,"src_id":150903011,"trial_step":11},{"step":10,"speaker":"${PlayerName}","content":"魏先生他并不只是为了重建庙会而来吧？他的目的就是你们传说中的化身？","options":["101"],"style":2,"background":2087,"log_type":1,"src_id":150903012,"trial_step":12},{"step":11,"content":"魏紫衣双眼通红，手抵额头坐在一旁的沙发上，显得十分疲惫。","style":3,"background":2087,"log_type":1,"src_id":150903013,"trial_step":13},{"step":12,"speaker":"紫衣","content":"族曾祖父已经很久没清醒地跟我们说过话了。可在听说“藤萝花神在狄斯复苏”的消息时，他突然激动起来，抓着我的手要我一定参与。","voice":["vo_trial_50903_1_18"],"voice_bank":"vo_yingying_trial","style":1,"background":2087,"log_type":1,"src_id":150903014,"trial_step":14},{"step":13,"speaker":"紫衣","content":"我知道族曾祖父恋旧，知道他执着想要守护过去的传说。可我并不知道他勉强自己辛苦跟来的理由。想必这是他深埋心底的执念吧。","voice":["vo_trial_50903_1_19"],"voice_bank":"vo_yingying_trial","style":1,"background":2087,"log_type":1,"src_id":150903015,"trial_step":15},{"step":14,"speaker":"紫衣","content":"可有一点是确定的：","voice":["vo_trial_50903_1_20"],"voice_bank":"vo_yingying_trial","style":1,"background":2087,"log_type":1,"src_id":150903016,"trial_step":16},{"step":15,"speaker":"紫衣","content":"如今的藤萝本体，哪怕是带着异方晶进去也会受到一定的侵蚀伤害，他一个病入膏肓的老人只会承担更大的危险。","voice":["vo_trial_50903_1_22"],"voice_bank":"vo_yingying_trial","style":1,"background":2087,"log_type":1,"src_id":150903017,"trial_step":17},{"step":16,"content":"她站了起来，手放胸口，对你深深地弯下腰去。","style":3,"background":2087,"log_type":1,"src_id":150903018,"trial_step":18},{"step":17,"speaker":"紫衣","content":"还请您……","voice":["vo_trial_50903_1_24"],"voice_bank":"vo_yingying_trial","style":1,"background":2087,"log_type":1,"src_id":150903019,"trial_step":19},{"step":18,"content":"她的言语无比真诚，你深吸了一口气，也逐渐松开了紧握的拳头。","style":3,"background":2087,"log_type":1,"src_id":150903020,"trial_step":20},{"step":19,"speaker":"${PlayerName}","content":"我知道萦萦会带他去哪里了。我们去紫藤残骸那里。","options":["101"],"style":2,"background":2087,"log_type":1,"src_id":150903021,"trial_step":21},{"step":20,"speaker":"老人","content":"这里……这里是……","voice":["vo_trial_50903_1_29"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903023,"trial_step":23},{"step":21,"speaker":"萦萦","content":"你认不出来了吗？这就是你一直想来的花源庙会。","voice":["vo_trial_50903_1_30"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903024,"trial_step":24},{"step":22,"speaker":"萦萦","content":"也是一百年前……你错过的那场庙会。","voice":["vo_trial_50903_1_31"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903025,"trial_step":25},{"step":23,"content":"只见眼前喧嚣繁华，游人如织，叫卖声此起彼伏。","style":3,"background":2366,"log_type":1,"src_id":150903026,"trial_step":26},{"step":24,"content":"行人的脸上洋溢着幸福的微笑，眼里有着对明日的希望与光芒。","style":3,"background":2366,"log_type":1,"src_id":150903027,"trial_step":27},{"step":25,"content":"老人情不自禁地往前迈了一步，却发觉自己的身体无比轻盈，再不似之前那油尽灯枯的模样。","style":3,"background":2366,"log_type":1,"src_id":150903028,"trial_step":28},{"step":26,"speaker":"少年","content":"诶。我的身体怎么变成这样了。","voice":["vo_trial_50903_1_35"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903029,"trial_step":29},{"step":27,"speaker":"萦萦","content":"都来到这儿了，你当然也要变回以前的模样，玩个痛快呀～","voice":["vo_trial_50903_1_36"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903030,"trial_step":30},{"step":28,"speaker":"萦萦","content":"好了，今时不比往日，我的力量不能维持很久，抓紧时间做你想做的事吧？","voice":["vo_trial_50903_1_37"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903031,"trial_step":31},{"step":29,"speaker":"萦萦","content":"不是要找人吗？","voice":["vo_trial_50903_1_38"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903032,"trial_step":32},{"step":30,"speaker":"少年","content":"我……我知道了。","voice":["vo_trial_50903_1_39"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903033,"trial_step":33},{"step":31,"speaker":"少年","content":"花神再见！","voice":["vo_trial_50903_1_40"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903034,"trial_step":34},{"step":32,"content":"他往远处跑了两步，突然想起自己忘了什么，回头大声喊道：","style":3,"background":2366,"log_type":1,"src_id":150903035,"trial_step":35},{"step":33,"speaker":"少年","content":"谢谢您！","voice":["vo_trial_50903_1_42"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903036,"trial_step":36},{"step":34,"content":"萦萦目送少年跑走，轻快地伸了个懒腰。","style":3,"background":2366,"log_type":1,"src_id":150903037,"trial_step":37},{"step":35,"speaker":"萦萦","content":"那么~接下来去做点什么呢。","voice":["vo_trial_50903_1_44"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903038,"trial_step":38},{"step":36,"speaker":"${PlayerName}","content":"你先跟我解释一下你都做了什么。","options":["101"],"style":2,"background":2366,"log_type":1,"src_id":150903039,"trial_step":39},{"step":37,"speaker":"萦萦","content":"呀——！小郎君，你吓到我了。","female_content":"呀——！小女娘，你吓到我了。","voice":["vo_trial_50903_1_46","vo_trial_50903_1_46f"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903040,"trial_step":40},{"step":38,"options":["你也快把我吓死了"],"style":6,"background":2366,"log_type":1,"src_id":150903041,"trial_step":41,"course":3,"choices":[{"text":"你也快把我吓死了","goto":42}]},{"step":39,"speaker":"${PlayerName}","content":"一个纸条一句话都没有留，一声不吭就跑出来了，对心脏过于不友好了。","options":["101"],"style":2,"background":2366,"log_type":1,"src_id":150903042,"trial_step":42},{"step":40,"speaker":"萦萦","content":"嗯？你在~担心我？","voice":["vo_trial_50903_1_49"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903043,"trial_step":43},{"step":41,"speaker":"${PlayerName}","content":"我……","options":["101"],"style":2,"background":2366,"log_type":1,"src_id":150903044,"trial_step":44},{"step":42,"options":["坦白担忧","糊弄过去"],"style":6,"background":2366,"log_type":1,"src_id":150903045,"trial_step":45,"course":3,"choices":[{"text":"坦白担忧","goto":46},{"text":"糊弄过去","goto":49}]},{"step":43,"speaker":"${PlayerName}","content":"是，我是很担心，担心你会不会元气耗尽再也醒不过来，担心会不会被抓起来遣送回东洲，担心你会不会答应他们离开狄斯再也不回来。","options":["101"],"style":2,"background":2366,"log_type":1,"src_id":150903046,"trial_step":46},{"step":44,"speaker":"萦萦","content":"——","voice":["vo_trial_50903_1_53"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903047,"trial_step":47},{"step":45,"speaker":"萦萦","content":"我好高兴。","voice":["vo_trial_50903_1_54"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903048,"trial_step":48,"next":[51]},{"step":46,"speaker":"${PlayerName}","content":"这是很严肃的事情，你私自离开管理局，又私自把魏先生从酒店带走，还将他带到这么危险的地方来，我有责任将你和他一起带回去。","options":["101"],"style":2,"background":2366,"log_type":1,"src_id":150903049,"trial_step":49},{"step":47,"speaker":"萦萦","content":"什么嘛，原来不是担心我。","voice":["vo_trial_50903_1_57"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903050,"trial_step":50},{"step":48,"speaker":"${PlayerName}","content":"因为……今天魏老先生他们从东洲带来一个技术，提出可以将你的千年紫藤移栽到东洲去。","options":["101"],"style":2,"background":2366,"log_type":1,"src_id":150903051,"trial_step":51},{"step":49,"speaker":"${PlayerName}","content":"这几天你实在太虚弱了，但当他拿出了东洲的土壤，将你移栽到那盆土里的时候，你确实苏醒了过来。","options":["101"],"style":2,"background":2366,"log_type":1,"src_id":150903052,"trial_step":52},{"step":50,"speaker":"${PlayerName}","content":"我去找了无患子，就连她也承认，要让你更快更好地恢复，东洲的水土将非常有效。","options":["101"],"style":2,"background":2366,"log_type":1,"src_id":150903053,"trial_step":53},{"step":51,"speaker":"萦萦","content":"所以，你就以为我要跟他们走，离开狄斯了？","voice":["vo_trial_50903_1_62"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903054,"trial_step":54},{"step":52,"speaker":"${PlayerName}","content":"我当然不希望你离开，但如果让你继续留下来会危及生命的话，我倒宁可——","style":2,"background":2366,"log_type":1,"src_id":150903055,"trial_step":55},{"step":53,"speaker":"萦萦","content":"嘘——","voice":["vo_trial_50903_1_64"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903056,"trial_step":56},{"step":54,"content":"她用食指堵住了你的唇。","style":3,"background":2366,"log_type":1,"src_id":150903057,"trial_step":57},{"step":55,"speaker":"萦萦","content":"不愿意，就不要说。","voice":["vo_trial_50903_1_66"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903058,"trial_step":58},{"step":56,"speaker":"萦萦","content":"我不会走，正如魏老先生他也不会走。","voice":["vo_trial_50903_1_67"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903059,"trial_step":59},{"step":57,"content":"她笑着收回食指，牵起你的手，往紫藤馆走去。","style":3,"background":2366,"log_type":1,"src_id":150903060,"trial_step":60},{"step":58,"speaker":"萦萦","content":"在很久很久以前，他就在这里许下“与幽兰约好了一起来逛庙会”的愿望。","voice":["vo_trial_50903_1_69"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903061,"trial_step":61},{"step":59,"speaker":"萦萦","content":"这个愿望就这样跨越百年，从一百年前的花源庙会，一直延续到现在……","voice":["vo_trial_50903_1_70"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903062,"trial_step":62},{"step":60,"speaker":"萦萦","content":"生命行将就木，而执着越发深刻，不远万里来到这里，哪怕要耗尽全部生命也在所不惜。就这样，把我唤醒了。","voice":["vo_trial_50903_1_71"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903063,"trial_step":63},{"step":61,"speaker":"萦萦","content":"你说，我怎么能辜负他的这份执着呢？","voice":["vo_trial_50903_1_72"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903064,"trial_step":64},{"step":62,"speaker":"萦萦","content":"现在魏老先生就如一滴新的水进入了这个水池，而他要做的，便是在这个足有万人的庙会中，找到他爱的那个姑娘。","voice":["vo_trial_50903_1_73"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903065,"trial_step":65},{"step":63,"speaker":"萦萦","content":"这是一场专属于他的漫长的寻觅。走吧，我们也去帮帮他。","voice":["vo_trial_50903_1_74"],"voice_bank":"vo_yingying_trial","style":1,"background":2366,"log_type":1,"src_id":150903066,"trial_step":66},{"step":64,"content":"【场景切换，紫藤馆】","style":18,"background":2369,"log_type":1,"src_id":150903067,"trial_step":67},{"step":65,"content":"你与萦萦一同来到紫藤馆中，只见几名匠人摊贩正在对紫藤树下的祈愿台进行最后的装饰。","style":3,"background":2369,"log_type":1,"src_id":150903068,"trial_step":68},{"step":66,"content":"在他们的头顶，淡紫色的花骨朵微开，零星落在摆好贡品的案台上。","style":3,"background":2369,"log_type":1,"src_id":150903069,"trial_step":69},{"step":67,"speaker":"小摊贩A","content":"这不是花神姑娘嘛，祈愿仪式可是明天，你不在紫藤馆里收拾，怎么到别处溜达去了。","voice":["vo_trial_50903_1_78"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903070,"trial_step":70},{"step":68,"speaker":"进货店家","content":"傻啊你，说这干嘛，旁边这后生长得真不错，来来来，这些是我自己炒的合欢果，祝你们和和美美！","voice":["vo_trial_50903_1_79"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903071,"trial_step":71},{"step":69,"speaker":"萦萦","content":"谢谢各位街坊来辛苦帮忙了，今年的摊位比去年大了不少，来祈愿的大家也一定会满意的。","voice":["vo_trial_50903_1_80"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903072,"trial_step":72},{"step":70,"speaker":"萦萦","content":"只是，你们瞧，今年的紫藤树开放日子提前了，我希望你们去跟大家说，祈愿仪式可以提前到今天开始。","voice":["vo_trial_50903_1_81"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903073,"trial_step":73},{"step":71,"speaker":"小摊贩A","content":"哟，那敢情好啊。前几年都挤在最后一天，人可太多了，好些人都进不来，只能远远地拜拜，我这就出去跟大家伙儿宣传宣传。","voice":["vo_trial_50903_1_82"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903074,"trial_step":74},{"step":72,"speaker":"进货店家","content":"那你看，我可不可以当这个第一名啊？我老婆过两个月就生了，求求花神保佑，可一定要平平安安的啊。","voice":["vo_trial_50903_1_83"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903075,"trial_step":75},{"step":73,"speaker":"萦萦","content":"当然没问题了，紫藤花神已经听到了你的祈愿，只要你做好准备陪在她身旁，夫人一定能安安全全顺利生产的。","voice":["vo_trial_50903_1_84"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903076,"trial_step":76},{"step":74,"speaker":"萦萦","content":"天命顺遂，可人事也记得一定要尽。","voice":["vo_trial_50903_1_85"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903077,"trial_step":77},{"step":75,"speaker":"进货店家","content":"得嘞。谢谢花神姑娘，这份零嘴就当我的彩头，给你这小相公了。等我老婆生了娃，请你们吃红蛋！","female_content":"得嘞。谢谢花神姑娘，这份零嘴就当我的彩头，给你这小女娘了。等我老婆生了娃，请你们吃红蛋！","voice":["vo_trial_50903_1_86","vo_trial_50903_1_86f"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903078,"trial_step":78},{"step":76,"speaker":"小摊贩B","content":"那我！下一个我先来。","voice":["vo_trial_50903_1_87"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903079,"trial_step":79},{"step":77,"content":"你这是第一次看到萦萦以真正的“紫藤花神”样貌去面对一个个云淮居民的祈愿。","style":3,"background":2369,"log_type":1,"src_id":150903080,"trial_step":80},{"step":78,"content":"她端坐在花神座上，仔细地聆听每一个人说出的话语，帮他们记下一个个许愿笺，再由你挂到紫藤树上。居民们也很快接受了你这个突然冒出来的花神助手。","style":3,"background":2369,"log_type":1,"src_id":150903081,"trial_step":81},{"step":79,"content":"但，这也并不是一个只说吉利话的时刻。","style":3,"background":2369,"log_type":1,"src_id":150903082,"trial_step":82},{"step":80,"speaker":"萦萦","content":"什么？！那个大骗子，居然骗了你十六两银子！真是太过分了！","voice":["vo_trial_50903_1_91"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903083,"trial_step":83},{"step":81,"speaker":"小摊贩B","content":"对！真是天杀的骗子，我希望他一辈子都倒霉！","voice":["vo_trial_50903_1_92"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903084,"trial_step":84},{"step":82,"speaker":"萦萦","content":"一辈子太长了，就让他接下来这一年都倒霉吧，我记下你的愿望啦！","voice":["vo_trial_50903_1_93"],"voice_bank":"vo_yingying_trial","style":1,"background":2369,"log_type":1,"src_id":150903085,"trial_step":85},{"step":83,"content":"……诸如此类。","style":3,"background":2369,"log_type":1,"src_id":150903086,"trial_step":86},{"step":84,"content":"夕阳西下，时间渐渐流逝。","style":3,"background":2371,"log_type":1,"src_id":150903087,"trial_step":87},{"step":85,"content":"你和萦萦也终于遇到了目标。","style":3,"background":2371,"log_type":1,"src_id":150903088,"trial_step":88},{"step":86,"content":"一个圆脸的小姑娘来到祈愿台前，恭恭敬敬地跪下，从口袋里掏出零食贡品放在了案台上，小声许愿。","style":3,"background":2371,"log_type":1,"src_id":150903089,"trial_step":89},{"step":87,"speaker":"幽兰","content":"花神花神，我叫幽兰，河下谷村人。","voice":["vo_trial_50903_1_98"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903090,"trial_step":90},{"step":88,"speaker":"幽兰","content":"我想问问，我的心上人是个榆木脑袋，他到底什么时候能开窍。","voice":["vo_trial_50903_1_99"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903091,"trial_step":91},{"step":89,"speaker":"萦萦","content":"……噗。","voice":["vo_trial_50903_1_100"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903092,"trial_step":92},{"step":90,"speaker":"幽兰","content":"我们自小就是邻居，我娘说，我们小时候还穿过同一条开裆裤。","voice":["vo_trial_50903_1_101"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903093,"trial_step":93},{"step":91,"speaker":"幽兰","content":"我给他送花，他就回我一把狗尾巴草。我给他吃糖，他又偷偷塞柿饼给我。我不会女红，就送了他打好的叶花，他，他回了我三枚珠花，听说花了他一个月的抄书钱。","voice":["vo_trial_50903_1_102"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903094,"trial_step":94},{"step":92,"speaker":"幽兰","content":"我已经很喜欢他啦。就是不知道他到底喜不喜欢我。","voice":["vo_trial_50903_1_103"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903095,"trial_step":95},{"step":93,"speaker":"幽兰","content":"我娘亲说，他要是喜欢我就会来跟我讲，可他什么时候才会来呢。我已经从去年等到了今年，眼看着今年又快过了。","voice":["vo_trial_50903_1_104"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903096,"trial_step":96},{"step":94,"speaker":"幽兰","content":"花神花神，你要是听得到的话，就帮我催催他吧。","voice":["vo_trial_50903_1_105"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903097,"trial_step":97},{"step":95,"content":"轻轻的，晚风拂过，少女头顶的紫藤花静悄悄地绽开了一束,另一个女孩藏在树上，捏着鼻子说道：","style":3,"background":2371,"log_type":1,"src_id":150903098,"trial_step":98},{"step":96,"speaker":"萦萦","content":"要我托梦？还是改心？人家不来求，我可干涉不了啊。不过，为何不由你亲自问问他呢？","voice":["vo_trial_50903_1_107"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903099,"trial_step":99},{"step":97,"speaker":"萦萦","content":"不管他怎么想，至少你知道，自己非常非常喜欢他不是吗？","voice":["vo_trial_50903_1_108"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903100,"trial_step":100},{"step":98,"speaker":"幽兰","content":"他……他生病了……","voice":["vo_trial_50903_1_109"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903101,"trial_step":101},{"step":99,"speaker":"萦萦","content":"我把他病给治好了？或者找个由头让他见见你，创造机会？","voice":["vo_trial_50903_1_110"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903102,"trial_step":102},{"step":100,"speaker":"幽兰","content":"不不不不不不不！我……我怕他不喜欢我呀。那样多丢脸。","voice":["vo_trial_50903_1_111"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903103,"trial_step":103},{"step":101,"speaker":"萦萦","content":"哈哈，喜欢一个人有什么好丢脸的～他不答应是他的事，你喜欢他是你的事，又没给人家添烦恼。","voice":["vo_trial_50903_1_112"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903104,"trial_step":104},{"step":102,"speaker":"萦萦","content":"我不能答应把他掰过来让他也喜欢你，但……","voice":["vo_trial_50903_1_113"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903105,"trial_step":105},{"step":103,"speaker":"萦萦","content":"你既然许了愿，我也该做点什么——","voice":["vo_trial_50903_1_114"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903106,"trial_step":106},{"step":104,"content":"就在这时，院里的门环适时地叩响了。","style":3,"background":2371,"log_type":1,"src_id":150903107,"trial_step":107},{"step":105,"content":"时间仿佛在停滞了许久之后，伴随着他迈开的脚步，再度开始了流动。","style":3,"background":10006,"log_type":1,"src_id":150903108,"trial_step":108},{"step":106,"content":"他迈步向前奔去。","style":3,"background":10006,"log_type":1,"src_id":150903109,"trial_step":109},{"step":107,"content":"每一步，都像是时间正在倒转。","style":3,"background":10006,"log_type":1,"src_id":150903110,"trial_step":110},{"step":108,"content":"跨越百年的执念，在如今得到重聚。","style":3,"background":10006,"log_type":1,"src_id":150903111,"trial_step":111},{"step":109,"speaker":"幽兰","content":"你还发着烧呢，就跑来这里想干嘛！","voice":["vo_trial_50903_1_121"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903112,"trial_step":112},{"step":110,"speaker":"少年","content":"诶。","voice":["vo_trial_50903_1_122"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903113,"trial_step":113},{"step":111,"speaker":"幽兰","content":"快让我看看，花神是不是真的把你治好了。","voice":["vo_trial_50903_1_123"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903114,"trial_step":114},{"step":112,"speaker":"少年","content":"等、等一下，我有一句话，有句话我必须得告诉你，你先听我说。","voice":["vo_trial_50903_1_124"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903115,"trial_step":115},{"step":113,"speaker":"少年","content":"为了说这句话，我从家里走到庙会，这条路，我走了很久很久。","voice":["vo_trial_50903_1_125"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903116,"trial_step":116},{"step":114,"speaker":"幽兰","content":"你……你说呗。我又不是听不见。","voice":["vo_trial_50903_1_126"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903117,"trial_step":117},{"step":115,"speaker":"少年","content":"我们以后，再也不要分开了，好不好？","voice":["vo_trial_50903_1_127"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903118,"trial_step":118},{"step":116,"content":"（盖个缓一点的特效白光）","style":18,"background":10006,"log_type":1,"src_id":150903119,"trial_step":119},{"step":117,"speaker":"老人","content":"谢谢你，花神姑娘。","voice":["vo_trial_50903_1_130"],"voice_bank":"vo_yingying_trial","style":1,"background":10006,"log_type":1,"src_id":150903120,"trial_step":120},{"step":118,"speaker":"老人","content":"请把这个带给我的紫衣，告诉她，我不回去了。","voice":["vo_trial_50903_1_131"],"voice_bank":"vo_yingying_trial","style":1,"background":10006,"log_type":1,"src_id":150903121,"trial_step":121},{"step":119,"speaker":"老人","content":"也希望您……得偿所愿。","voice":["vo_trial_50903_1_132"],"voice_bank":"vo_yingying_trial","style":1,"background":10006,"log_type":1,"src_id":150903122,"trial_step":122},{"step":120,"content":"（白光消失、紫藤树下）","style":18,"background":2371,"log_type":1,"src_id":150903123,"trial_step":123},{"step":121,"content":"一羽纸鹤落入了萦萦的手中，她小心翼翼地将它收了起来。","style":3,"background":2371,"log_type":1,"src_id":150903124,"trial_step":124},{"step":122,"content":"目送着两人的离去，萦萦捏住了你的手。","style":3,"background":2371,"log_type":1,"src_id":150903125,"trial_step":125},{"step":123,"speaker":"萦萦","content":"再借我一些元气好吗，${PlayerName}。","voice":["vo_trial_50903_1_136","vo_trial_50903_1_136f"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903126,"trial_step":126},{"step":124,"speaker":"萦萦","content":"我想把这个幻境延续得更久一些。","voice":["vo_trial_50903_1_137"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903127,"trial_step":127},{"step":125,"speaker":"萦萦","content":"因为梦醒之后，我们就都要往前看了。","voice":["vo_trial_50903_1_138"],"voice_bank":"vo_yingying_trial","style":1,"background":2371,"log_type":1,"src_id":150903128,"trial_step":128},{"step":126,"content":"【切场景，紫藤残骸】","style":18,"background":10006,"log_type":1,"src_id":150903129,"trial_step":129},{"step":127,"content":"天渐渐亮了。","style":3,"background":2376,"log_type":1,"src_id":150903130,"trial_step":130},{"step":128,"content":"当你离开幻境的时候，看到围绕着紫藤残骸的区域，FAC的警戒车辆已经将这里团团围住。","style":3,"background":2376,"log_type":1,"src_id":150903131,"trial_step":131},{"step":129,"content":"萦萦已经消失，只剩下你手中的一枝紫藤花枝。","style":3,"background":2376,"log_type":1,"src_id":150903132,"trial_step":132},{"step":130,"content":"老人在你身边已经停止了呼吸，但他的面容无比宁静，像是重新回到了少年时代。","style":3,"background":2376,"log_type":1,"src_id":150903133,"trial_step":133}]}