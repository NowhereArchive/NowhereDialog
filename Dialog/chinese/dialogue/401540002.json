{"id":401540002,"chapter_id":50045,"scene_id":45007,"steps":[{"step":1,"speaker":"吟游诗人","content":"~~~~","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":2,"speaker":"吟游诗人","content":"“褴褛衣衫，滑稽王冠 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":3,"speaker":"吟游诗人","content":"“鲜亮绶带几代传 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":4,"speaker":"吟游诗人","content":"“帐篷破烂但拦不住观众喜欢 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":5,"speaker":"吟游诗人","content":"“台上国王妆发乱，台下观众作笑谈 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":6,"speaker":"吟游诗人","content":"“这里的票房没有房 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":7,"speaker":"吟游诗人","content":"“五个铜板叮当响 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":8,"speaker":"吟游诗人","content":"“不少啦，不少啦 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":9,"speaker":"吟游诗人","content":"“五人能有热饭尝 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":10,"speaker":"吟游诗人","content":"“不少啦，不少啦 。”","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":11,"speaker":"吟游诗人","content":"“一边起舞一边唱 。”","style":1,"background":1069,"is_centered":true,"log_type":1}]}