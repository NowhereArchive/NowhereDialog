{"id":401560303,"chapter_id":50045,"scene_id":45036,"steps":[{"step":1,"content":"你进入了一个有些奇怪的房间。","style":3,"background":3001,"log_type":1},{"step":2,"content":"蓝天、白云、太阳。幼稚的线条，高饱和的颜色，像孩童的简笔画。","style":3,"background":3001,"log_type":1},{"step":3,"content":"涂成草原的地面上立着一棵树，仅有一棵树。","style":3,"background":3001,"log_type":1},{"step":4,"content":"你走上前，想要近距离观察一下。","style":3,"background":3001,"log_type":1},{"step":5,"options":["触碰树干"],"jump":[6],"style":6,"background":3001,"log_type":1},{"step":6,"speaker":"玛奇朵","content":"啊！","style":1,"background":3001,"log_type":1},{"step":7,"speaker":"${PlayerName}","content":"嗯？！你……是玛奇朵？","style":1,"background":3001,"log_type":1},{"step":8,"speaker":"玛奇朵","content":"我不是玛奇朵，我是树。","style":1,"background":3001,"log_type":1},{"step":9,"content":"你又喊了一遍她的名字，这次玛奇朵没有回话。","style":3,"background":3001,"log_type":1},{"step":10,"options":["继续戳戳她"],"jump":[11],"style":6,"background":3001,"log_type":1},{"step":11,"speaker":"玛奇朵","content":"……今天的阳光很舒服哦。","style":1,"background":3001,"log_type":1},{"step":12,"content":"玛奇朵抖了抖树枝。","style":3,"background":3001,"log_type":1},{"step":13,"options":["与她一起站一会儿"],"jump":[14],"style":6,"background":3001,"log_type":1},{"step":14,"content":"你安静地与玛奇朵并肩站立，人造阳光笼在身上，安抚着精神。","style":3,"background":3001,"log_type":1},{"step":15,"speaker":"${PlayerName}","content":"成为一颗树，一直晒着太阳，似乎也不错呢。","style":2,"background":3001,"log_type":1},{"step":16,"content":"树枝晃了晃，似乎有些高兴听到你这么说。","style":3,"background":3001,"log_type":1},{"step":17,"speaker":"玛奇朵","content":"是的，逃离工作、逃离社会、逃离“人”的身份，彻底自由的感觉……很不错。","style":1,"background":3001,"log_type":1},{"step":18,"content":"有风吹过，树叶顺着风，自在地摆动。","style":3,"background":3001,"log_type":1},{"step":19,"speaker":"玛奇朵","content":"……不过，我还是会回家的。我到底还是舍不得我的朋友和家人。","style":1,"background":3001,"log_type":1},{"step":20,"speaker":"玛奇朵","content":"但是，在那之前……还请让我再享受一会儿吧。","style":1,"background":3001,"log_type":1},{"step":21,"content":"你离开了房间，玛奇朵仍然悠闲地伫立在旷野上，偶尔摇一摇树枝。","style":3,"background":3001,"log_type":1}]}