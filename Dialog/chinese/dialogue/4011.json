{"id":4011,"chapter_id":4,"scene_id":401,"steps":[{"step":2,"speaker":"海拉","content":"……我们往下走多远了？","voice":["vo_cgplot_4011002"],"voice_bank":"vo_cgplot_04","style":1,"background":10000,"log_type":1},{"step":3,"speaker":"赫卡蒂","content":"不超过30米。向下还看不到地面，这个地窟比想象的更深。","voice":["vo_cgplot_4011003"],"voice_bank":"vo_cgplot_04","style":1,"background":10000,"log_type":1},{"step":4,"content":"在脚下深不见底的黑暗里，那邪恶无形的存在还在搏动着，夹杂着粘稠的低语和恶意。","style":3,"background":401,"log_type":1},{"step":5,"options":["底部有敌人，死役或是怪物"],"jump":[6],"style":6,"background":401,"log_type":1},{"step":6,"speaker":"海拉","content":"知道了知道了。瞧，我鸡皮疙瘩已经掉下来两三层了，只要不是小聋瞎，都知道下面不会有好事。","voice":["vo_cgplot_4011006"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":7,"speaker":"海拉","content":"既然这里跟帕……跟狂厄结晶有关，那下面藏着什么妖魔鬼怪都不稀奇。","voice":["vo_cgplot_4011007"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":8,"speaker":"海拉","content":"你们得做好心理准备，等一落地肯定就是一场恶战。","voice":["vo_cgplot_4011008"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":9,"speaker":"赫卡蒂","content":"不……不用等到落地，它们已经来了。","voice":["vo_cgplot_4011009"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":10,"content":"哐————！！","style":3,"background":401,"log_type":1},{"step":11,"content":"升降梯突然撞上了什么阻碍，一声巨响后，整个升降梯底部被撞击着，像是不断击碎某种杂乱坚硬的晶体。","style":3,"background":401,"log_type":1},{"step":12,"content":"你们看不到底部的情况，只感到升降梯咔咔咔逐级刹停，最终倾斜着卡在某个高度。","style":3,"background":401,"log_type":1},{"step":13,"speaker":"海拉","content":"*礼貌*，电梯坏了吗？","voice":["vo_cgplot_4011013"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":14,"speaker":"赫卡蒂","content":"还没有，但小心，我们被困在污染中心了。","voice":["vo_cgplot_4011014"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":15,"content":"微弱的灯光隐隐照亮深井，垂直的通道竟自下而上长满巨大污染尖刺，升降梯被截停了。","style":3,"background":401,"log_type":1},{"step":16,"speaker":"？？","content":"窸窸窣窣——窸窸窣窣——","style":1,"background":401,"log_type":1},{"step":17,"speaker":"海拉","content":"……什么声音？那些刺里头有东西在爬……","voice":["vo_cgplot_4011017"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":18,"speaker":"死役","content":"吼————！！","voice":["vo_cgplot_4011018"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":19,"speaker":"海拉","content":"是死役？","voice":["vo_cgplot_4011019"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1},{"step":20,"speaker":"赫卡蒂","content":"不，他们早就被摧毁了，这是别的东西！","voice":["vo_cgplot_4011020"],"voice_bank":"vo_cgplot_04","style":1,"background":401,"log_type":1}]}