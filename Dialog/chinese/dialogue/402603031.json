{"id":402603031,"chapter_id":50070,"scene_id":57018,"steps":[{"step":1,"content":"【空场】白场，晕眩音效，心跳喘息等身体虚弱的音效","style":18,"background":10006,"log_type":1},{"step":2,"content":"你勉强回复意识。","style":3,"background":10006,"log_type":1},{"step":3,"content":"回溯成功了。","style":3,"background":10006,"log_type":1},{"step":4,"content":"但你不记得发生过什么。","style":3,"background":10006,"log_type":1},{"step":5,"content":"【空场】2秒，耳鸣，混沌，恍惚的视野","style":18,"background":10006,"log_type":1},{"step":6,"content":"意识像被谁打碎过一般时断时续，你每次想拾起拼接、重新理解，都以失败告终。看不清眼前的景象，听不见任何可辨别的声音。","style":3,"background":10006,"log_type":1},{"step":7,"content":"有谁来到你身边，可你的脑海中却只残存着模糊的印象。","style":3,"background":10006,"log_type":1},{"step":8,"content":"【立绘】战损000黑渐变","style":18,"background":10006,"log_type":1},{"step":9,"speaker":"？？？","content":"□□说了□□□停下□□□□□□□□你顶不住的□□□□……","style":1,"background":10006,"log_type":1},{"step":10,"speaker":"？？？","content":"还□□□我□好及时□□□□□□□","style":1,"background":10006,"log_type":1},{"step":11,"speaker":"？？？","content":"□□□□……","style":1,"background":10006,"log_type":1},{"step":12,"content":"你听不清她说了什么，但……","style":3,"background":10006,"log_type":1},{"step":13,"content":"回溯成功了，行动继续。你要争取时间，再挑战这个禁闭者，直到一点一点探明她背后的真相。","style":3,"background":10006,"log_type":1}]}