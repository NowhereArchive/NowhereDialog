{"id":1030802,"chapter_id":1030802,"scene_id":1,"steps":[{"step":1,"content":"几日后","style":12,"background":107,"log_type":1,"src_id":130802001,"trial_step":1},{"step":2,"speaker":"机械音","content":"嘀——识别到高速移动物体。管理局内非紧急情况请勿跑动，注意通行安全——","voice":["vo_trial_30802_1_2"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802002,"trial_step":2},{"step":3,"content":"一团飞速移动的影子快速划过走廊，冲至局长办公室，开始疯狂拍门。","style":3,"background":107,"log_type":1,"src_id":130802003,"trial_step":3},{"step":4,"speaker":"艾米潘","content":"局长——局长，快出来主持公道啊呜呜呜呜呜呜——","voice":["vo_trial_30802_1_4"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802004,"trial_step":4},{"step":5,"options":["开门","无视"],"style":6,"background":107,"log_type":1,"src_id":130802005,"trial_step":5,"course":3,"choices":[{"text":"开门","goto":10},{"text":"无视","goto":6}]},{"step":6,"content":"你假装无视了门口的求助声，可是来人的哭声越来凄惨，誓要掀翻整个管理局。","style":3,"background":107,"log_type":1,"src_id":130802006,"trial_step":6},{"step":7,"speaker":"艾米潘","content":"局长局长开门啊——我知道你在家——","voice":["vo_trial_30802_1_9"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802007,"trial_step":7},{"step":8,"content":"魔音贯耳，实在是折磨鼓膜。","style":3,"background":107,"log_type":1,"src_id":130802008,"trial_step":8},{"step":9,"speaker":"%u","content":"……来了。","style":2,"background":107,"log_type":1,"src_id":130802009,"trial_step":9},{"step":10,"content":"打开门，你这才发现门口聚着不少人，每个都和艾米潘一样义愤填膺。","style":1,"background":107,"log_type":1,"src_id":130802010,"trial_step":10},{"step":11,"speaker":"艾米潘","content":"局长呜呜呜……你这回得帮帮我啊……","voice":["vo_trial_30802_1_12"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802011,"trial_step":11},{"step":12,"speaker":"艾米潘","content":"我昨天刚到的漫画书，今天打开就发现已经有人背着我偷偷翻了一遍……","voice":["vo_trial_30802_1_13"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802012,"trial_step":12},{"step":13,"speaker":"艾米潘","content":"露米娜","voice":["vo_trial_30802_1_14"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802013,"trial_step":13},{"step":14,"content":"翻开书页，果然看到某个NPC头上被画了一个明晃晃的大圈，边上标注：“坏蛋一号”，还有一个贱贱的小猫笑脸。","style":3,"background":107,"log_type":1,"src_id":130802014,"trial_step":14},{"step":15,"content":"……总觉得这张笑脸有点眼熟。","style":3,"background":107,"log_type":1,"src_id":130802015,"trial_step":15},{"step":16,"speaker":"悲伤的员工","content":"我昨天刚写完的述职报告！今早一醒就发现被这人用红笔批注了一遍，还写了个大大的“已阅”！","style":1,"background":107,"log_type":1,"src_id":130802016,"trial_step":16},{"step":17,"speaker":"愤怒的员工","content":"还有我！昨天提交给夜莺副官的资料被替换成了——总之，是不能让副官看到的东西，这下全完了！","style":1,"background":107,"log_type":1,"src_id":130802017,"trial_step":17},{"step":18,"content":"艾米潘的控诉引起身边不少人附和。一通告状之下，你才明白：原来这些人都是“猫猫头”恶作剧的受害者。","style":3,"background":107,"log_type":1,"src_id":130802018,"trial_step":18},{"step":19,"options":["受损严重吗？"],"style":6,"background":107,"log_type":1,"src_id":130802019,"trial_step":19,"course":3,"choices":[{"text":"受损严重吗？","goto":20}]},{"step":20,"speaker":"艾米潘","content":"这可是我新买的一整套典藏版《名探长古北》！","voice":["vo_trial_30802_1_19"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802020,"trial_step":20},{"step":21,"speaker":"%u","content":"那，只有这一册有问题？","style":2,"background":107,"log_type":1,"src_id":130802021,"trial_step":21},{"step":22,"speaker":"艾米潘","content":"……等等，难道说……","voice":["vo_trial_30802_1_21"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802022,"trial_step":22},{"step":23,"content":"艾米潘颤颤巍巍地从包里掏出另一册漫画，慢慢打开。果然，又是一个红色大圈。","style":3,"background":107,"log_type":1,"src_id":130802023,"trial_step":23},{"step":24,"speaker":"艾米潘","content":"……","voice":["vo_trial_30802_1_23"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802024,"trial_step":24},{"step":25,"speaker":"艾米潘","content":"……我，我要与你同归于尽……！！！","voice":["vo_trial_30802_1_24"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802025,"trial_step":25},{"step":26,"speaker":"艾米潘","content":"可恶——那个混蛋猫猫头！我绝饶不了她！！！","voice":["vo_trial_30802_1_25"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802026,"trial_step":26},{"step":27,"options":["你们先冷静冷静……"],"style":6,"background":107,"log_type":1,"src_id":130802027,"trial_step":27,"course":3,"choices":[{"text":"你们先冷静冷静……","goto":28}]},{"step":28,"speaker":"艾米潘","content":"局长，你该不会是看人家小姑娘柔弱就包庇她吧？局长你糊涂啊！野猫是不能乱捡回家的啊！！！！","voice":["vo_trial_30802_1_27"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802028,"trial_step":28},{"step":29,"speaker":"%u","content":"……说什么鬼话呢。","style":2,"background":107,"log_type":1,"src_id":130802029,"trial_step":29},{"step":30,"speaker":"%u","content":"总之，我会帮你们去找犯人的，交给我吧。","style":2,"background":107,"log_type":1,"src_id":130802030,"trial_step":30},{"step":31,"content":"好不容易哄走受害者团队，你转身，正好看到门口蹲了只小猫。","style":3,"background":107,"log_type":1,"src_id":130802031,"trial_step":31},{"step":32,"speaker":"%u","content":"……哎。","voice":["vo_trial_30802_1_110"],"voice_bank":"vo_zero_trial","style":2,"background":107,"log_type":1,"src_id":130802032,"trial_step":32},{"step":33,"content":"你也蹲下，无奈握住小猫的前爪。","style":3,"background":107,"log_type":1,"src_id":130802033,"trial_step":33},{"step":34,"speaker":"%u","content":"前段时间的系统报错、艾米潘的书，还有述职报告和任务资料。你可真是给他们添了不少麻烦啊。","style":2,"background":107,"log_type":1,"src_id":130802034,"trial_step":34},{"step":35,"speaker":"%u","content":"坦白从宽，赶紧去自首吧。","style":2,"background":107,"log_type":1,"src_id":130802035,"trial_step":35},{"step":36,"speaker":"000","content":"嘻嘻，你的禁闭者逗起来可比你好玩多了。","voice":["vo_trial_30802_1_34"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802036,"trial_step":36},{"step":37,"content":"真正的犯人从门口探出头来，脸上带着幸灾乐祸的笑容。","style":3,"background":107,"log_type":1,"src_id":130802037,"trial_step":37},{"step":38,"content":"三分钟前，000匆匆钻入你办公室，强行要求你“收留”她一会儿。","style":3,"background":107,"log_type":1,"src_id":130802038,"trial_step":38},{"step":39,"content":"原本还在疑惑她的目的，现在你彻底明白了，她是挑了个好位置来看热闹的。","style":3,"background":107,"log_type":1,"src_id":130802039,"trial_step":39},{"step":40,"options":["不出去见见他们？"],"style":6,"background":107,"log_type":1,"src_id":130802040,"trial_step":40,"course":3,"choices":[{"text":"不出去见见他们？","goto":41}]},{"step":41,"speaker":"000","content":"别管，哪有捣乱的人直接跳脸开大的，那不是等着找揍吗。","voice":["vo_trial_30802_1_39"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802041,"trial_step":41},{"step":42,"speaker":"000","content":"你可不要出卖我哦？","voice":["vo_trial_30802_1_35"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802042,"trial_step":42},{"step":43,"options":["那来找我就没关系？"],"style":6,"background":107,"log_type":1,"src_id":130802043,"trial_step":43,"course":3,"choices":[{"text":"那来找我就没关系？","goto":44}]},{"step":44,"speaker":"%u","content":"这么说来，我也算是受害者之一。不怕我和他们结盟吗？","style":2,"background":107,"log_type":1,"src_id":130802044,"trial_step":44},{"step":45,"speaker":"000","content":"这个嘛……也是有原因的……","voice":["vo_trial_30802_1_42"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802045,"trial_step":45},{"step":46,"content":"少女动作一僵，心虚移开视线。","style":3,"background":107,"log_type":1,"src_id":130802046,"trial_step":46},{"step":47,"speaker":"%u","content":"不光到处恶作剧，还在暗处偷偷盯着他们的反应……想和他们一起玩的话，不如直接开口？","style":2,"background":107,"log_type":1,"src_id":130802047,"trial_step":47},{"step":48,"speaker":"%u","content":"嘴上说着“不合群”，其实也玩得挺开心的嘛。","style":2,"background":107,"log_type":1,"src_id":130802048,"trial_step":48},{"step":49,"speaker":"000","content":"……………………哼。","voice":["vo_trial_30802_1_45"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802049,"trial_step":49},{"step":50,"content":"000紧紧闭上嘴，放弃狡辩，转头就走。","style":3,"background":107,"log_type":1,"src_id":130802050,"trial_step":50},{"step":51,"content":"临到走廊，她又迅速转身，冲你做了个鬼脸，然后迅速跑开。","style":3,"background":107,"log_type":1,"src_id":130802051,"trial_step":51},{"step":52,"options":["挥手道别","也回敬一个鬼脸"],"style":6,"background":107,"log_type":1,"src_id":130802052,"trial_step":52,"course":3,"choices":[{"text":"挥手道别","goto":55},{"text":"也回敬一个鬼脸","goto":55}]},{"step":53,"speaker":"%u","content":"接下来，该怎么处理你呢……","style":2,"background":107,"log_type":1,"src_id":130802053,"trial_step":53},{"step":54,"speaker":"小猫","content":"喵?","voice":["vo_trial_30802_1_110"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802054,"trial_step":54},{"step":55,"content":"被收容的“野猫”并不乖顺，她在管理局各处惹了不少乱子，但事情不大不小，更像是吸引目光的恶作剧。","style":3,"background":107,"log_type":1,"src_id":130802055,"trial_step":55},{"step":56,"content":"既然如此，就让她再倔一阵吧。你想了想，准备干件好事，掏出手机给艾米潘发了一条消息。","style":3,"background":107,"log_type":1,"src_id":130802056,"trial_step":56},{"step":57,"speaker":"艾米潘","content":"啊啊啊啊啊——混账猫猫头，我看到你了！赔我剧透钱！赔我漫画书！！！","voice":["vo_trial_30802_1_50"],"voice_bank":"vo_zero_trial","style":1,"background":107,"log_type":1,"src_id":130802057,"trial_step":57},{"step":58,"content":"你强压下嘴角的笑意，心满意足地关上门。","style":3,"background":107,"log_type":1,"src_id":130802058,"trial_step":58},{"step":59,"content":"收拾完公务，你闭上双眼准备小憩一会儿，眼前却浮现出000心虚的眼神和狡黠的笑。","style":3,"background":1014,"log_type":1,"src_id":130802060,"trial_step":60},{"step":60,"content":"你能感觉到你们之间微妙的默契和亲近，但她肯定在藏着什么。每次当你深入探究时，她都会用一种古怪的态度刻意避开。","style":3,"background":1014,"log_type":1,"src_id":130802061,"trial_step":61},{"step":61,"content":"她在隐瞒什么？在阻止你继续调查什么？","style":3,"background":1014,"log_type":1,"src_id":130802062,"trial_step":62},{"step":62,"content":"你思考着对策，直到睡意袭来，就这样进入梦乡。","style":3,"background":1014,"log_type":1,"src_id":130802063,"trial_step":63},{"step":63,"content":"【切换场景，局长纯白梦境】","style":18,"background":10006,"log_type":1,"src_id":130802064,"trial_step":64},{"step":64,"speaker":"朦胧的声音","content":"……过来…………","voice":["vo_trial_30802_1_57"],"voice_bank":"vo_zero_trial","style":1,"background":10006,"log_type":1,"src_id":130802065,"trial_step":65},{"step":65,"content":"少女的笑声在你耳侧响起，你睁大双眼，试图寻找她的踪迹。","style":3,"background":10006,"log_type":1,"src_id":130802066,"trial_step":66},{"step":66,"content":"奇怪的是，无论你怎么努力，眼前都好像覆着一层重重的帷帐。除了一片朦胧的光晕外，什么也看不见。","style":3,"background":10006,"log_type":1,"src_id":130802067,"trial_step":67},{"step":67,"options":["你在哪里？"],"style":6,"background":10006,"log_type":1,"src_id":130802068,"trial_step":68,"course":3,"choices":[{"text":"你在哪里？","goto":69}]},{"step":68,"content":"你试探性地伸手，前方却只有一片虚无。","style":3,"background":10006,"log_type":1,"src_id":130802069,"trial_step":69},{"step":69,"speaker":"%u","content":"我听得见你的声音……你就在附近。","style":2,"background":10006,"log_type":1,"src_id":130802070,"trial_step":70},{"step":70,"content":"你慢慢反应过来，向着脸部摸索过去。果然，是有人用手蒙住了你的双眼。","style":3,"background":10006,"log_type":1,"src_id":130802071,"trial_step":71},{"step":71,"options":["你想告诉我什么？"],"style":6,"background":10006,"log_type":1,"src_id":130802072,"trial_step":72,"course":3,"choices":[{"text":"你想告诉我什么？","goto":73}]},{"step":72,"speaker":"梦中的少女","content":"……","voice":["vo_trial_30802_1_66"],"voice_bank":"vo_zero_trial","style":1,"background":10006,"log_type":1,"src_id":130802073,"trial_step":73},{"step":73,"speaker":"%u","content":"每天潜入我的梦中，却从不让我看清你的样子……你想告诉我什么？你到底是谁？","style":2,"background":10006,"log_type":1,"src_id":130802074,"trial_step":74},{"step":74,"speaker":"梦中的少女","content":"……我…………","voice":["vo_trial_30802_1_69"],"voice_bank":"vo_zero_trial","style":1,"background":10006,"log_type":1,"src_id":130802075,"trial_step":75},{"step":75,"options":["什么？"],"style":6,"background":10006,"log_type":1,"src_id":130802076,"trial_step":76,"course":3,"choices":[{"text":"什么？","goto":77}]},{"step":76,"content":"梦境开始破碎，你奋力想抓住对方，却只感觉到那双手化作碎片逐渐崩解。","style":3,"background":10006,"log_type":1,"src_id":130802077,"trial_step":77},{"step":77,"speaker":"梦中的少女","content":"……来找我…………","voice":["vo_trial_30802_1_72"],"voice_bank":"vo_zero_trial","style":1,"background":10006,"log_type":1,"src_id