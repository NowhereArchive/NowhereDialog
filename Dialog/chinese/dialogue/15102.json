{"id":15102,"chapter_id":15,"scene_id":1510,"steps":[{"step":1,"content":"蓝雨压制住癫狂的傀儡，FAC机械部队不断输出火力，尽可能击碎它们的身体，阻止它们继续行动。","style":3,"background":2328,"log_type":1},{"step":2,"content":"而你在后方，看着混乱的战场慢慢平息，嘶吼声渐隐，血雾间，一个人影缓缓走来。","style":3,"background":2328,"log_type":1},{"step":3,"content":"——正如你预料的。","style":3,"background":2328,"log_type":1},{"step":4,"speaker":"选项","options":["你来了"],"jump":[5],"style":6,"background":2328,"log_type":1},{"step":5,"speaker":"耶莱娜","content":"是的。我找不到自己的孩子，就只能来找你了。","voice":["vo_cgplot_15092003"],"voice_bank":"vo_cgplot_1509","style":1,"background":2328,"log_type":1},{"step":6,"speaker":"耶莱娜","content":"告诉我吧，你们把艾尔藏到哪里了？","voice":["vo_cgplot_15092004"],"voice_bank":"vo_cgplot_1509","style":1,"background":2328,"log_type":1},{"step":7,"content":"【转场】mbcc","style":18,"background":1024,"log_type":1},{"step":8,"speaker":"赫卡蒂","content":"局长去了现场？能联系到他吗？","female_content":"局长去了现场？能联系到她吗？","voice":["vo_cgplot_15092007","vo_cgplot_15092007f"],"voice_bank":"vo_cgplot_1509","style":1,"background":1024,"log_type":1},{"step":9,"speaker":"赫卡蒂","content":"……我要求行动，立刻。不需要车辆，我自己可以。","voice":["vo_cgplot_15092008"],"voice_bank":"vo_cgplot_1509","style":1,"background":1024,"log_type":1},{"step":10,"speaker":"赫卡蒂","content":"梦魇！","voice":["vo_cgplot_15092009"],"voice_bank":"vo_cgplot_1509","style":1,"background":1024,"log_type":1},{"step":11,"content":"使魔落在中庭，少女攀上其中一只手臂，正要出发，另一个人影冲了出来，抓住了她。","style":3,"background":1024,"log_type":1},{"step":12,"speaker":"？？？","content":"我也去，带我一起。","voice":["vo_cgplot_15092011"],"voice_bank":"vo_cgplot_1509","style":1,"background":1024,"log_type":1},{"step":13,"speaker":"赫卡蒂","content":"艾尔维拉？","voice":["vo_cgplot_15092012"],"voice_bank":"vo_cgplot_1509","style":1,"background":1024,"log_type":1},{"step":14,"speaker":"赫卡蒂","content":"不行，局长说过，要我保护你的安全。你……？！","voice":["vo_cgplot_15092013"],"voice_bank":"vo_cgplot_1509","style":1,"background":1024,"log_type":1},{"step":15,"speaker":"艾尔维拉","content":"我必须去，拜托你。","voice":["vo_cgplot_15092015"],"voice_bank":"vo_cgplot_1509","style":1,"background":1024,"log_type":1},{"step":16,"speaker":"赫卡蒂","content":"……我明白了。","voice":["vo_cgplot_15092016"],"voice_bank":"vo_cgplot_1509","style":1,"background":1024,"log_type":1}]}