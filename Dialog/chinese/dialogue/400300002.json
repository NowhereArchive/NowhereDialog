{"id":400300002,"chapter_id":50014,"scene_id":51428,"steps":[{"step":1,"speaker":"海拉","content":"哇塞，听声音就觉得是漂亮姐姐！","voice":["vo_event_03000_78"],"voice_bank":"vo_event_03_p0","style":1,"log_type":1},{"step":2,"speaker":"丽莎","content":"只是模仿了她声线语气的人工智能罢了。","voice":["vo_event_03000_79"],"voice_bank":"vo_event_03_p0","style":1,"log_type":1},{"step":3,"speaker":"丽莎","content":"好俗气的“艺术展”，连做个导览都要蹭“美女艺术家”的标签。明明容貌在恩菲尔的艺术成就面前是不值一提的东西。","voice":["vo_event_03000_80"],"voice_bank":"vo_event_03_p0","style":1,"log_type":1},{"step":4,"speaker":"海拉","content":"哇哦……她其实超爱恩菲尔的吧，嘴巴还挺毒，攻击性超强诶。","voice":["vo_event_03000_81"],"voice_bank":"vo_event_03_p0","style":1,"log_type":1},{"step":5,"speaker":"夜莺","content":"那么，重复一次。赫卡蒂、雷比尼斯从<color=#fb9259>西部油画区</color>进入，海拉、艾米潘从<color=#fb9259>东部雕塑区</color>进入，丽莎经<color=#fb9259>地下员工区</color>进入展览。","voice":["vo_event_03000_82"],"voice_bank":"vo_event_03_p0","style":1,"log_type":1},{"step":6,"speaker":"夜莺","content":"你们的首要任务，是深入异变区域，找回局长。拜托了。","voice":["vo_event_03000_83"],"voice_bank":"vo_event_03_p0","style":1,"log_type":1},{"step":7,"speaker":"赫卡蒂","content":"我会找回他的。","female_content":"我会找回她的。","voice":["vo_event_03000_84","vo_event_03000_84f"],"voice_bank":"vo_event_03_p0","style":1,"log_type":1},{"step":8,"speaker":"雷比尼斯","content":"指令收到。","voice":["vo_event_03000_85"],"voice_bank":"vo_event_03_p0","style":1,"log_type":1},{"step":9,"speaker":"海拉","content":"嗨呀快快快！","voice":["vo_event_03000_86"],"voice_bank":"vo_event_03_p0","style":1,"log_type":1},{"step":10,"speaker":"艾米潘","content":"有、有我出马呢！","voice":["vo_event_03000_87"],"voice_bank":"vo_event_03_p0","style":1,"log_type":1},{"step":11,"speaker":"丽莎","content":"哼。","voice":["vo_event_03000_88"],"voice_bank":"vo_event_03_p0","style":1,"log_type":1}]}