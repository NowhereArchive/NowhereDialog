{"id":1021004,"chapter_id":1021004,"scene_id":1,"steps":[{"step":1,"content":"【背景-东洲山林】","style":18,"background":2580,"log_type":1,"src_id":121004001,"trial_step":1},{"step":2,"content":"那日过后，少女每日都会在上山采药时来探望这个腿上受伤的孩子。","style":3,"background":2580,"log_type":1,"src_id":121004002,"trial_step":2},{"step":3,"content":"少女跟这个孩子说过很多话，有时候对方会回几个字，但更多时候只是瞪着眼睛听，眼神明亮纯净，就像少女曾在山间见过的那些野兽。","style":3,"background":2580,"log_type":1,"src_id":121004003,"trial_step":3},{"step":4,"content":"随着相处的时间久了，孩子似乎也开始放下警惕，换药时不再乱动，偶尔也会凑到少女身边，好奇盯着她从包里拿出来的各种东西。","style":3,"background":2580,"log_type":1,"src_id":121004004,"trial_step":4},{"step":5,"speaker":"？？","content":"？","voice":["vo_trial_21004_1_1"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121004005,"trial_step":5},{"step":6,"content":"小孩疑惑地看少女从包中掏出一条红绳。紧接着，这条红绳被以一种巧妙的方式仔细系在了她手腕上。小孩有点不适应手上有东西，甩了几下甩不掉，这才放弃。","style":3,"background":2580,"log_type":1,"src_id":121004006,"trial_step":6},{"step":7,"speaker":"采药少女","content":"这个是护身符，我特意在山君庙里求的。","voice":["vo_trial_21004_1_2"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121004007,"trial_step":7},{"step":8,"content":"少女抬手，果然在她手腕上也有一条一样的绳串。赤红的颜色在周边积雪的映衬下格外鲜艳。","style":3,"background":2580,"log_type":1,"src_id":121004008,"trial_step":8},{"step":9,"speaker":"采药少女","content":"原本这里也是个庙子呢，只是没有山下供奉的人多。在白寅山上行走的人们都会求一个护身符。只要诚心祈愿，白虎山君就会保佑你在山里平平安安，不受危害。","voice":["vo_trial_21004_1_3"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121004009,"trial_step":9},{"step":10,"speaker":"？？","content":"白、虎……？","voice":["vo_trial_21004_1_4"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121004010,"trial_step":10},{"step":11,"speaker":"采药少女","content":"对啊。瞧，这下山君也会保护你啦。","voice":["vo_trial_21004_1_5"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121004011,"trial_step":11},{"step":12,"content":"戴着红绳的手轻柔地拂过小孩的发顶，又帮她将乱发整好，编上辫子。小孩儿迟疑着抖抖耳朵，终究还是没甩掉对方的手。","style":3,"background":2580,"log_type":1,"src_id":121004012,"trial_step":12},{"step":13,"content":"又是一日，今日少女迟迟没有上山。","style":3,"background":2580,"log_type":1,"src_id":121004013,"trial_step":13},{"step":14,"content":"半个多月过去，孩子腿上的伤口已经恢复得差不多了。她早有了翻山回自己洞穴的能力，但她却没动身。","style":3,"background":2580,"log_type":1,"src_id":121004014,"trial_step":14},{"step":15,"speaker":"？？","content":"……","voice":["vo_trial_21004_1_6"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121004015,"trial_step":15},{"step":16,"content":"小孩伏在破庙外的草丛里，又爬到树荫下的屋顶躺着，睡了一觉，又翻了几个身坐起来。","style":3,"background":2580,"log_type":1,"src_id":121004016,"trial_step":16},{"step":17,"content":"少女今天来得好晚。直到太阳落山，她摸摸自己好得差不多的腿，终于决定迈步——","style":3,"background":2580,"log_type":1,"src_id":121004017,"trial_step":17},{"step":18,"content":"【背景-在活动背景里随便找个东洲山道】","style":18,"background":2575,"log_type":1,"src_id":121004018,"trial_step":18},{"step":19,"content":"她路过几只病弱的老狼。它们被族群抛弃，正围猎不小心摔断腿的小鹿。母鹿挡在其间，蹄子不住地刨土。","style":3,"background":2575,"log_type":1,"src_id":121004019,"trial_step":19},{"step":20,"content":"她路过一位瞎眼的猎户。那人扛着自制土弩，蹲在树丛里埋伏。对面啃食果子的野猪并未察觉自己将要落入陷阱。","style":3,"background":2575,"log_type":1,"src_id":121004020,"trial_step":20},{"step":21,"content":"她路过一处打劫的现场。在持刀的流匪对面，某人正竭力护着身后的一对母女。","style":3,"background":2575,"log_type":1,"src_id":121004021,"trial_step":21},{"step":22,"speaker":"？？","content":"……嗯？","voice":["vo_trial_21004_1_7"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121004022,"trial_step":22},{"step":23,"content":"她终于停了下来。","style":3,"background":2575,"log_type":1,"src_id":121004023,"trial_step":23},{"step":24,"speaker":"采药少女","content":"别怕！他们只是要钱，不敢伤人，晚点镇里的人会来帮我们……帮我们打跑这伙混账！","voice":["vo_trial_21004_1_8"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121004024,"trial_step":24},{"step":25,"content":"流匪们齐齐发出哄笑，少女额角的汗滑过脸颊，还是没退缩。直到流匪试图从母亲怀里拽出那个孩子，她才变了脸色。","style":3,"background":2575,"log_type":1,"src_id":121004025,"trial_step":25},{"step":26,"speaker":"采药少女","content":"不要动她——啊！","voice":["vo_trial_21004_1_9"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121004026,"trial_step":26},{"step":27,"content":"刀斧劈头盖脸砸下来，眼看要落在少女身上。少女压制住尖叫，硬是咬牙闭上眼。","style":3,"background":2575,"log_type":1,"src_id":121004027,"trial_step":27},{"step":28,"content":"【演出2s，给点乒乒乓乓，有人阻止了攻击】","style":18,"background":2575,"log_type":1,"src_id":121004028,"trial_step":28},{"step":29,"speaker":"流匪","content":"啊啊啊啊啊——！","voice":["vo_trial_21004_1_10"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121004030,"trial_step":30},{"step":30,"content":"一道矮小的身影徒手接住那柄飞快的利斧，顺手折断对方的关节。利爪封喉，攻击者捂着喉咙后退几步，颓然倒地。","style":3,"background":2575,"log_type":1,"src_id":121004031,"trial_step":31},{"step":31,"content":"更多武器带着怒意朝小孩招呼过来。","style":3,"background":2575,"log_type":1,"src_id":121004032,"trial_step":32},{"step":32,"content":"砰——利爪与铁器碰撞发出尖锐的摩擦音。她灵活游步在山匪之间，每一次动作都扬起一片红雾。白雪被染红，有人在逃跑，也有人跪下来求饶，但这都不能阻止这场屠杀。","style":3,"background":2575,"log_type":1,"src_id":121004033,"trial_step":33},{"step":33,"content":"战斗很快结束。流匪们统统倒在血泊之中，而她甩甩手，血黏着皮肤的感觉让她很不爽快。","style":3,"background":2575,"log_type":1,"src_id":121004034,"trial_step":34},{"step":34,"content":"想起自己最初停下的理由，她转头，想去看被自己保护的那几人——","style":3,"background":2575,"log_type":1,"src_id":121004035,"trial_step":35},{"step":35,"content":"迎来的却是充满恐惧的眼神。","style":3,"background":2575,"log_type":1,"src_id":121004036,"trial_step":36},{"step":36,"speaker":"？？","content":"……？","voice":["vo_trial_21004_1_11"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121004037,"trial_step":37},{"step":37,"content":"少女瘫软在那对母女前，手仍在抖着，但眼中的惊恐却不再对着流匪，而是这个站在血泊中的“东西”。","style":3,"background":2575,"log_type":1,"src_id":121004038,"trial_step":38},{"step":38,"content":"小孩想上前一步，却发现对方身体猛地一抖，下意识靠后退去。","style":3,"background":2575,"log_type":1,"src_id":121004039,"trial_step":39},{"step":39,"speaker":"惊恐的孩子","content":"……怪物！走开！！","voice":["vo_trial_21004_1_12"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121004040,"trial_step":40},{"step":40,"content":"石头朝她扔来，砸在脚下。扔石头的孩子被面色青紫的母亲和少女同时护在身后。","style":3,"background":2575,"log_type":1,"src_id":121004041,"trial_step":41},{"step":41,"content":"【回忆部分】","style":18,"background":2580,"log_type":1,"src_id":121004042,"trial_step":42},{"step":42,"speaker":"采药少女","content":"在白寅山上行走的人们都会求一个护身符。只要诚心祈愿，白虎山君就会保佑你在山里平平安安，不受危害。","voice":["vo_trial_21004_1_71"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121004043,"trial_step":43},{"step":43,"speaker":"采药少女","content":"对啊。瞧，这下山君也会保护你啦。","voice":["vo_trial_21004_1_5"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2580,"log_type":1,"src_id":121004044,"trial_step":44},{"step":44,"content":"【再回来】","style":18,"background":2575,"log_type":1,"src_id":121004045,"trial_step":45},{"step":45,"content":"“白虎山君保佑，平平安安不受危害”——是保佑谁？又从谁的危害下保佑？","style":3,"background":2575,"log_type":1,"src_id":121004046,"trial_step":46},{"step":46,"speaker":"？？","content":"怪物……是我……？","voice":["vo_trial_21004_1_13"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121004047,"trial_step":47},{"step":47,"speaker":"？？","content":"………………","voice":["vo_trial_21004_1_14"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2575,"log_type":1,"src_id":121004048,"trial_step":48},{"step":48,"content":"喉咙发干哽咽，胸口像是被巨石压住一样闷痛。她不熟悉这种感觉，只觉得天格外冷，但手上那串红绳却似乎烫得皮肤生疼。","style":3,"background":2575,"log_type":1,"src_id":121004049,"trial_step":49},{"step":49,"content":"于是她将红绳一把扯下扔在地上。绳子几乎没被磨损过，颜色仍旧鲜红，却沾上了泥土的脏污。","style":3,"background":2575,"log_type":1,"src_id":121004050,"trial_step":50},{"step":50,"content":"霁川","style":3,"background":2575,"log_type":1,"src_id":121004051,"trial_step":51},{"step":51,"content":"【管理局】","style":18,"background":1020,"log_type":1,"src_id":121004052,"trial_step":52},{"step":52,"content":"啸风瘫在洒满阳光的高台上，百无聊赖地翻了个身。","style":3,"background":1020,"log_type":1,"src_id":121004053,"trial_step":53},{"step":53,"content":"久违地梦到了过去的事情，她心里不太痛快，却又懒得起来发泄。在这么个全是钢铁砖头的地方待久了，她开始思念自己在深山里的窝。","style":3,"background":1020,"log_type":1,"src_id":121004054,"trial_step":54},{"step":54,"content":"MBCC的放风场地不算小，禁闭者们三三两两凑在一起，高墙铁网在阳光的照耀下，泛着不真实的柔光。远远能听到其他禁闭者的声音，但她只觉得吵闹。","style":3,"background":1020,"log_type":1,"src_id":121004055,"trial_step":55},{"step":55,"content":"一只硕大的虎头从旁侧挤过来。白虎打着呼噜蹭进她手心，也学着她的姿势趴下，尾巴盘在啸风脚边。","style":3,"background":1020,"log_type":1,"src_id":121004056,"trial_step":56},{"step":56,"speaker":"啸风","content":"大咪啊……等咱们回老窝，是先眯一觉呢，还是搁山底下寻摸点吃的呢？","voice":["vo_trial_21004_1_15"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004057,"trial_step":57},{"step":57,"content":"老虎不语，只是呼噜声更大了些。","style":3,"background":1020,"log_type":1,"src_id":121004058,"trial_step":58},{"step":58,"speaker":"啸风","content":"哼，只知道睡觉的懒猫……","voice":["vo_trial_21004_1_16"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004059,"trial_step":59},{"step":59,"content":"高空限制出入的铁丝网碍眼得很，但啸风懒得去管，只觉得做什么都没劲。","style":3,"background":1020,"log_type":1,"src_id":121004060,"trial_step":60},{"step":60,"content":"她重新躺回先前的位置，在阳光的烘烤下闭上眼，等待把自己引渡回东洲的队伍到来。然而……","style":3,"background":1020,"log_type":1,"src_id":121004061,"trial_step":61},{"step":61,"speaker":"？？","content":"诗云：百宝峰回处，猛虎隐真形。世人多疑惧，难识圣灵心。","voice":["vo_trial_21004_1_17"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004062,"trial_step":62},{"step":62,"speaker":"啸风","content":"……？","style":1,"background":1020,"log_type":1,"src_id":121004063,"trial_step":63},{"step":63,"content":"高台下突然冒出一道清脆的童声。啸风斜眼去看，正好看见一个高举着狮头的身影。","style":3,"background":1020,"log_type":1,"src_id":121004064,"trial_step":64},{"step":64,"speaker":"嗷呜","content":"列位看官，今儿咱不说那锈河一百零八禁，不说那坎贝尔三兄妹演义，单表一座东洲奇山——它就是——","voice":["vo_trial_21004_1_18"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004065,"trial_step":65},{"step":65,"speaker":"嗷呜","content":"白……白那个什么山！","voice":["vo_trial_21004_1_19"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004066,"trial_step":66},{"step":66,"speaker":"啸风","content":"这破局子屁大点的地方咋能塞得下这么多人……让不让人睡觉了……","voice":["vo_trial_21004_1_21"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004067,"trial_step":67},{"step":67,"content":"啸风嘟嘟囔囔翻过身，捂着耳朵把头埋进虎毛里，试图隔绝掉下方的叫好声。","style":3,"background":1020,"log_type":1,"src_id":121004068,"trial_step":68},{"step":68,"speaker":"嗷呜","content":"大家好呀！这里是霹雳螺旋爆炸起飞宇宙无敌天下第一的舞狮大王第忘记多少代传人，嗷呜！","voice":["vo_trial_21004_1_20"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004069,"trial_step":69},{"step":69,"speaker":"嗷呜","content":"这次给大家带来了一部全新作品——《下山记》，也叫《虎仙释厄传》，想出镜的朋友们随时可以加入，让嗷呜看到你们的热情~","voice":["vo_trial_21004_1_22"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004070,"trial_step":70},{"step":70,"speaker":"艾米潘","content":"导演大人，我有问题！","voice":["vo_trial_21004_1_23"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004071,"trial_step":71},{"step":71,"content":"艾米潘第一个跳上台子加入。她手里拿着页勉强能算上是“剧本” 的稿纸，一边辨认字迹，一边蹩脚地演起来。","style":3,"background":1020,"log_type":1,"src_id":121004072,"trial_step":72},{"step":72,"speaker":"艾米潘","content":"都说是虎了，哪儿来的仙呢？虎吃人，仙救人，剧本是不是自相矛盾了？","voice":["vo_trial_21004_1_24"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004073,"trial_step":73},{"step":73,"speaker":"嗷呜","content":"哎呀，这位看官莫急，待我慢慢讲来。","voice":["vo_trial_21004_1_25"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004074,"trial_step":74},{"step":74,"content":"<i><size=36><u><color=#c9af79>.传说东洲某处有一座神山，因其山上有老虎出没，又有白雪覆盖，故名为白寅。\n这白寅山常年仙气缭绕。村民对着山顶焚香叩拜，献上供品，只求一位神通广大的山神保佑。.</i></size></u></color>","style":14,"background":2580,"is_centered":true,"log_type":1,"src_id":121004075,"trial_step":75},{"step":75,"content":"<i><size=36><u><color=#c9af79>.众人心诚则灵，于是村里时常发生奇迹。\n夜里狼群袭击村庄，嗷的一声虎啸，吓退狼群。\n白天小孩子失足落崖，被旋风托举，平稳落地。.</i></size></u></color>","style":14,"background":2580,"is_centered":true,"log_type":1,"src_id":121004076,"trial_step":76},{"step":76,"content":"<i><size=36><u><color=#c9af79>.这山神仁义，虽看不清模样，但净做好事。\n只要好酒好招待，就一定有求必应。.</i></size></u></color>","style":14,"background":2580,"is_centered":true,"log_type":1,"src_id":121004077,"trial_step":77},{"step":77,"content":"窝在高台上的女人抖了抖耳朵，身体不自觉地向外转了转。","style":3,"background":1020,"log_type":1,"src_id":121004078,"trial_step":78},{"step":78,"speaker":"嗷呜","content":"这日，村里出事了，小艾米潘出门买年货，却不幸碰到了碰到山匪——","voice":["vo_trial_21004_1_26"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004079,"trial_step":79},{"step":79,"speaker":"艾米潘","content":"呃……山匪，山匪！","voice":["vo_trial_21004_1_27"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004080,"trial_step":80},{"step":80,"content":"艾米潘眼疾手快从旁边把挥剑的九十九拉进镜头。九十九眨了眨眼，伸手指向自己。","style":3,"background":1020,"log_type":1,"src_id":121004081,"trial_step":81},{"step":81,"speaker":"九十九","content":"我上？","voice":["vo_trial_21004_1_28"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004082,"trial_step":82},{"step":82,"speaker":"艾米潘","content":"对，玩真的，记得演投入点！","voice":["vo_trial_21004_1_29"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004083,"trial_step":83},{"step":83,"content":"在艾米潘一通挤眉弄眼下，九十九犹豫着接过剧本，对着开口。","style":3,"background":1020,"log_type":1,"src_id":121004084,"trial_step":84},{"step":84,"speaker":"九十九","content":"路过留财，把兜里的现钱银子、还有糖果都掏出来，不然的话……","voice":["vo_trial_21004_1_30"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004085,"trial_step":85},{"step":85,"content":"沉重的大剑在空中划出一道干脆的弧线，随即“铿”地一声贯入地面。","style":3,"background":1020,"log_type":1,"src_id":121004086,"trial_step":86},{"step":86,"speaker":"九十九","content":"就留命下来吧！","voice":["vo_trial_21004_1_31"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004087,"trial_step":87},{"step":87,"content":"短暂的停顿后，四周立刻炸开了反应。有人夸张地后退两步，有人抱头蹲下，惊叫声此起彼伏。虽然演技参差不齐，但“害怕”这件事，倒是配合得十分卖力。","style":3,"background":1020,"log_type":1,"src_id":121004088,"trial_step":88},{"step":88,"content":"啸风转过脑袋，目不转睛地偷看这边的动静。","style":3,"background":1020,"log_type":1,"src_id":121004089,"trial_step":89},{"step":89,"speaker":"艾米潘","content":"那个……糖没有，我都吃了。狄斯币，你不是一直帮我收着嘛？没有没有。","voice":["vo_trial_21004_1_32"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004090,"trial_step":90},{"step":90,"speaker":"艾米潘","content":"山君山君显灵吧，我愿意把多年攒下来的零食献给您，就藏在豆袋沙包下面，那可是局……呃村长辛辛苦苦帮我偷偷带进来的，攒了好久呢。","voice":["vo_trial_21004_1_33"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004091,"trial_step":91},{"step":91,"content":"她双手合十，语气变得异常虔诚，像是把所有求生欲都一股脑儿寄托在这段胡言乱语里。","style":3,"background":1020,"log_type":1,"src_id":121004092,"trial_step":92},{"step":92,"speaker":"艾米潘","content":"九十九……哦不是，山匪这么温柔，一定会放我们走吧？","voice":["vo_trial_21004_1_34"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004093,"trial_step":93},{"step":93,"speaker":"嗷呜","content":"NONONO，山匪可是超级无敌生气！这点东西都不给，定要她们好看！","voice":["vo_trial_21004_1_35"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004094,"trial_step":94},{"step":94,"speaker":"嗷呜","content":"山匪，上！","voice":["vo_trial_21004_1_36"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004095,"trial_step":95},{"step":95,"speaker":"艾米潘","content":"？？？？等等真打啊！！！","voice":["vo_trial_21004_1_37"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004096,"trial_step":96},{"step":96,"content":"九十九的大剑照着指示落下。艾米潘则一边狼狈逃窜，一边乱喊乱叫，台词彻底跑偏。她甚至冲进了原本在围观的人群，一时间人仰马翻，场面瞬间失去控制。","style":1,"background":1020,"log_type":1,"src_id":121004097,"trial_step":97},{"step":97,"speaker":"艾米潘","content":"呜呜，山君山君求你赶快显灵吧！我快被九十九打死了——啊！","voice":["vo_trial_21004_1_38"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004098,"trial_step":98},{"step":98,"content":"剑锋破风而下的瞬间，一道身影横插进来。金属相撞，火星乍现。","style":3,"background":1020,"log_type":1,"src_id":121004099,"trial_step":99},{"step":99,"content":"啸风单手稳稳挡下九十九的大剑，脚步纹丝不动，反倒借力逼近半步。她咧嘴一笑，发力将大剑击飞，然后又接下九十九的下一击。","style":3,"background":1020,"log_type":1,"src_id":121004100,"trial_step":100},{"step":100,"speaker":"九十九","content":"呵！","voice":["vo_trial_21004_1_39"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004101,"trial_step":101},{"step":101,"speaker":"啸风","content":"哎我去，有两把刷子啊，够劲儿——再来！","voice":["vo_trial_21004_1_40"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004102,"trial_step":102},{"step":102,"speaker":"艾米潘","content":"哎呦山君大人您可算是来了，我也来，我帮您打！咬她咬她！","voice":["vo_trial_21004_1_41"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004103,"trial_step":103},{"step":103,"content":"话虽如此，但艾米潘却不敢真进入两人互殴的中心，只是在边上放箭。只是她放箭没放准，不小心扎向了其他禁闭者。","style":3,"background":1020,"log_type":1,"src_id":121004104,"trial_step":104},{"step":104,"speaker":"赫卡蒂","content":"……！你们——局长说了，不许打架！","voice":["vo_trial_21004_1_42"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004105,"trial_step":105},{"step":105,"content":"啸风抽不出手，这次是换白虎和梦魇作势扭在一起，一个上下翻飞，一个跳来跳去。","style":3,"background":1020,"log_type":1,"src_id":121004106,"trial_step":106},{"step":106,"content":"禁闭者们要么被卷入、要么主动加入，笑闹声、碰撞声混作一团，攻击的余波在空地上接连炸开，又被刻意压制在安全边缘。","style":3,"background":1020,"log_type":1,"src_id":121004107,"trial_step":107},{"step":107,"content":"啸风置身其中，出手越来越快，笑声也越来越畅快，仿佛此刻这里是东洲的那片山林，而她只需顺着本能驱动四肢，如山间野虎般自由。","style":3,"background":1020,"log_type":1,"src_id":121004108,"trial_step":108},{"step":108,"content":"——直到最后一记对撞落下，力竭的众人接二连三倒在地上。","style":3,"background":1020,"log_type":1,"src_id":121004109,"trial_step":109},{"step":109,"content":"喘息声此起彼伏，笑骂混杂，这场闹剧般的争斗在疲惫中画下句点，而虎仙的故事也即将接近尾声。","style":3,"background":1020,"log_type":1,"src_id":121004110,"trial_step":110},{"step":110,"speaker":"嗷呜","content":"终于，在山君的帮助下，村民带着年货回到村子，而一直等待孩子们回家的村长，也为山君大人准备了谢礼。","voice":["vo_trial_21004_1_44"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004111,"trial_step":111},{"step":111,"speaker":"嗷呜","content":"自此之后，百宝山下，有人看到孩子们围着白虎玩耍，有人看到村民用叶子给山君遮阳，坏人纷纷绕路，村子从此一片祥和。","voice":["vo_trial_21004_1_45"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004112,"trial_step":112},{"step":112,"speaker":"嗷呜","content":"真个是——众生寻常披皮相，心怀慈悲即显灵，猛虎不作庄严相，此心深处惟侠肠。","voice":["vo_trial_21004_1_46"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004113,"trial_step":113},{"step":113,"content":"啸风躺在地上，一抬头，就看见一人带着托盘，在自己身侧蹲下。","style":3,"background":1020,"log_type":1,"src_id":121004114,"trial_step":114},{"step":114,"content":"初次见面，很高兴认识你，虎仙大人。","style":2,"background":1020,"log_type":1,"src_id":121004115,"trial_step":115},{"step":115,"speaker":"啸风","content":"你……","voice":["vo_trial_21004_1_47"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004116,"trial_step":116},{"step":116,"speaker":"嗷呜","content":"杀青杀青！大家配合得非常棒！特别是这位——演白虎山君的大姐姐！","voice":["vo_trial_21004_1_48"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004117,"trial_step":117},{"step":117,"content":"嗷呜从人群里钻出来，她几步凑到啸风面前，绕着啸风转了一圈，从耳朵到尾巴看得一丝不苟，目光亮得惊人。","style":3,"background":1020,"log_type":1,"src_id":121004118,"trial_step":118},{"step":118,"speaker":"啸风","content":"很灵光嘛，小家伙，我在山下看了这么多年的评书样板戏，你们还是头一个让我有兴趣自己也想上去比划两下的。","voice":["vo_trial_21004_1_49"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004119,"trial_step":119},{"step":119,"speaker":"嗷呜","content":"嘿嘿……其实我在金猊乡听老乡说过白寅山的故事，没想到居然都是真的！还没想到，居然能跟白虎姐姐一起拍电影！嗷呜还是第一次见真老虎呢！","voice":["vo_trial_21004_1_50"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004120,"trial_step":120},{"step":120,"content":"在你们不远处，白虎大咪已经被众禁闭者团团围了起来。嗷呜在征得同意后也举着摄像机跑过去，开始“给老虎补点特写镜头”。","style":3,"background":1020,"log_type":1,"src_id":121004121,"trial_step":121},{"step":121,"content":"至于这只白虎的主人……啸风背着手溜达到你身旁，意味深长地眯眼。","style":3,"background":1020,"log_type":1,"src_id":121004122,"trial_step":122},{"step":122,"speaker":"啸风","content":"不是说我“穷凶极恶”“必须严加看管”吗？大骗子，唬小孩儿也不怕半夜被黄皮子叼走。","voice":["vo_trial_21004_1_51"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004123,"trial_step":123},{"step":123,"content":"也不算是虚传吧，毕竟……","style":2,"background":1020,"log_type":1,"src_id":121004124,"trial_step":124},{"step":124,"content":"那天之后，我又托几个东洲朋友查了查，找到了白寅山村子里的人。","style":2,"background":1020,"log_type":1,"src_id":121004125,"trial_step":125},{"step":125,"content":"如你所说，这山君的传说流传了许久，白寅山与白虎仙的传说起源早已不可考，但它没有随着时代变迁而消失，反而在近十几年变得广为传唱。","style":2,"background":1020,"log_type":1,"src_id":121004126,"trial_step":126},{"step":126,"content":"那些常进山打猎的人们告诉我，他们常会在山上的山君庙里奉上美食佳肴，而这些供品总会在供上后不久就凭空消失……","style":2,"background":1020,"log_type":1,"src_id":121004127,"trial_step":127},{"step":127,"content":"你将托盘上的肉干递给啸风，看她挑眉的吃惊表情。","style":3,"background":1020,"log_type":1,"src_id":121004128,"trial_step":128},{"step":128,"content":"想必，是山君收了他们的供奉，在保他们上山之旅一路平安吧。","style":2,"background":1020,"log_type":1,"src_id":121004129,"trial_step":129},{"step":129,"speaker":"啸风","content":"……什么意思，想套话啊？","voice":["vo_trial_21004_1_52"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004130,"trial_step":130},{"step":130,"content":"没什么，只是觉得咱们山君大人，大概也是个刀子嘴豆腐心的神仙。","style":2,"background":1020,"log_type":1,"src_id":121004131,"trial_step":131},{"step":131,"speaker":"啸风","content":"……","style":1,"background":1020,"log_type":1,"src_id":121004132,"trial_step":132},{"step":132,"content":"啸风没回答你的问题，只是接过肉干啃起来，边啃边嘀咕着一些东洲粗话。你看着她咬着肉嘟囔的样子，没忍住笑出来。","style":3,"background":1020,"log_type":1,"src_id":121004133,"trial_step":133},{"step":133,"speaker":"啸风","content":"？干嘛，真想挨揍啊？","voice":["vo_trial_21004_1_53"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004134,"trial_step":134},{"step":134,"content":"没有，只是想起来你那天问我的问题……","style":2,"background":1020,"log_type":1,"src_id":121004135,"trial_step":135},{"step":135,"content":"何苦不自由自在？","style":3,"background":1020,"log_type":1,"src_id":121004136,"trial_step":136},{"step":136,"content":"对我来说……就像白虎山君被众人敬仰信奉，我也被许多人爱着，也被期待着。","style":2,"background":1020,"log_type":1,"src_id":121004137,"trial_step":137},{"step":137,"content":"这份责任虽然沉重，但为了回报这些人，我愿意再努力一些。","style":2,"background":1020,"log_type":1,"src_id":121004138,"trial_step":138},{"step":138,"content":"你收回目光，望向啸风的双眼。","style":3,"background":1020,"log_type":1,"src_id":121004139,"trial_step":139},{"step":139,"content":"对山君来说也是如此吗？并不是非要混迹其中成为同类，或许只是路过时收了报酬，又随手帮了个小忙。","style":2,"background":1020,"log_type":1,"src_id":121004140,"trial_step":140},{"step":140,"content":"即便只是无心的帮助，对山下的百姓来说，也算能称得上是“神仙下凡”的奇迹了。","style":2,"background":1020,"log_type":1,"src_id":121004141,"trial_step":141},{"step":141,"speaker":"啸风","content":"……","style":1,"background":1020,"log_type":1,"src_id":121004142,"trial_step":142},{"step":142,"speaker":"啸风","content":"啧，肉麻的家伙。","voice":["vo_trial_21004_1_54"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004143,"trial_step":143},{"step":143,"speaker":"啸风","content":"唉，果然还是跟你尿不到一个壶里。你们人都一个样，打架不一定厉害，嘴上倒是一个顶一个的能耐……一不小心就着了你们的道……","voice":["vo_trial_21004_1_55"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004144,"trial_step":144},{"step":144,"content":"啸风吃掉最后一口肉干，拍拍手起身。你看不见她的正脸，但她头上毛茸茸的耳朵抖了又抖。你忍住调侃，好不容易给这位神仙哄好，可不能前功尽弃。","style":3,"background":1020,"log_type":1,"src_id":121004145,"trial_step":145},{"step":145,"content":"你陪着啸风走向场地边缘。在那里，夜莺已经等候多时。","style":3,"background":1020,"log_type":1,"src_id":121004146,"trial_step":146},{"step":146,"speaker":"夜莺","content":"局长，回东洲的船已经准备好了。","voice":["vo_trial_21004_1_56"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004147,"trial_step":147},{"step":147,"content":"啸风把白虎招回来。威风凛凛的老虎站在她身后，身上已经被几个禁闭者小孩挂上七八条红绳，形象着实有些滑稽。","style":3,"background":1020,"log_type":1,"src_id":121004148,"trial_step":148},{"step":148,"speaker":"啸风","content":"怎么了，眼馋？要不你也来拴一个。怕你天天想咱，正好留点念想。","voice":["vo_trial_21004_1_57"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004149,"trial_step":149},{"step":149,"options":["好啊","不了"],"style":6,"background":1020,"log_type":1,"src_id":121004150,"trial_step":150,"course":3,"choices":[{"text":"好啊","goto":151},{"text":"不了","goto":153}]},{"step":150,"content":"你上前一步，没用什么拴住她，只是抛出一捆东西。啸风伸手正好捞到。","style":3,"background":1020,"log_type":1,"src_id":121004151,"trial_step":151},{"step":151,"content":"那就求山君大人保佑了。","style":2,"background":1020,"log_type":1,"src_id":121004152,"trial_step":152,"next":[155]},{"step":152,"content":"还是不了。山君的保护效果惊人，我得供点更稀罕的才行。","style":2,"background":1020,"log_type":1,"src_id":121004153,"trial_step":153},{"step":153,"content":"你上前一步，没用什么拴住她，只是抛出一捆东西。啸风伸手正好捞到。","style":3,"background":1020,"log_type":1,"src_id":121004154,"trial_step":154},{"step":154,"speaker":"啸风","content":"这是……？","voice":["vo_trial_21004_1_58"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":1020,"log_type":1,"src_id":121004155,"trial_step":155},{"step":155,"content":"——是木天蓼枝。你特意托人找来的，枝干完整，被你用红绳整整齐齐地捆成一束。","style":3,"background":1020,"log_type":1,"src_id":121004156,"trial_step":156},{"step":156,"content":"是信物。下次走大路吧，这次时间太赶没来得及带你好好玩，但狄斯还有很多有意思的地方值得一去。","style":2,"background":1020,"log_type":1,"src_id":121004157,"trial_step":157},{"step":157,"content":"而且你不是爱听戏听故事吗？我在狄斯这些年攒了不少，与其听那些别人加工过的，不如直接来听当事人讲。","style":2,"background":1020,"log_type":1,"src_id":121004158,"trial_step":158},{"step":158,"content":"所以……如果你还愿意来狄斯，直接来找我吧。去哪都行，我陪你逛。","style":2,"background":1020,"log_type":1,"src_id":121004159,"trial_step":159},{"step":159,"content":"啸风在原地顿了一瞬，她没说什么，只是走出几步后抬手，随意地朝身后摆了摆，算作道别。","style":3,"background":1020,"log_type":1,"src_id":121004160,"trial_step":160},{"step":160,"content":"她摇晃着那束木天蓼，小指上的金色虎爪轻轻晃动，在阳光下折射出细碎的光。","style":3,"background":1020,"log_type":1,"src_id":121004161,"trial_step":161},{"step":161,"content":"伴随一声虎啸，那抹金色随着她的背影一同远去。你明白她的意思，那大概就是一句——","style":3,"background":1020,"log_type":1,"src_id":121004162,"trial_step":162},{"step":162,"content":"有缘再会。","style":3,"background":1020,"log_type":1,"src_id":121004163,"trial_step":163},{"step":163,"content":"【回忆段落，山下集市】","style":18,"background":2577,"log_type":1,"src_id":121004164,"trial_step":164},{"step":164,"content":"杯里的太阳晃晃悠悠，她盯着好半天了。","style":3,"background":2577,"log_type":1,"src_id":121004165,"trial_step":165},{"step":165,"content":"这是她头回来山下。她曾许多次听少女说过这里，但自从那次不欢而散后过了许多年，她再也没去过白虎庙，也没见过那个采药的少女。","style":3,"background":2577,"log_type":1,"src_id":121004166,"trial_step":166},{"step":166,"content":"山上的吃食寡淡，无论怎么也找不到烤得那样香的肉。终于，她决定披上大氅下山，混进人的市集解解嘴馋。","style":3,"background":2577,"log_type":1,"src_id":121004167,"trial_step":167},{"step":167,"content":"人间热闹，到处都是对话声。隔壁桌回头的功夫，她一口酒下肚，支着脑袋继续听对方吹牛。","style":3,"background":2577,"log_type":1,"src_id":121004168,"trial_step":168},{"step":168,"speaker":"村民1","content":"据说当时老虎下山，打杀了流匪，还把他们一个个都生吞下肚——啧啧啧，血糊拉碴的，可吓人了！","voice":["vo_trial_21004_1_59"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004169,"trial_step":169},{"step":169,"speaker":"村民2","content":"小点声！你小点声！举头三尺有神灵，对面就是白虎庙，小心对山君不敬遭报应……","voice":["vo_trial_21004_1_60"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004170,"trial_step":170},{"step":170,"speaker":"村民1","content":"嘿，那可是老虎！老虎吃人，天经地义！不过最近上山前确实安全了不少，难道……","voice":["vo_trial_21004_1_61"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004171,"trial_step":171},{"step":171,"content":"她嗤笑一声，就着酒吞掉最后一口肉。正准备走，却不想一个熟悉的声音冒出来。","style":3,"background":2577,"log_type":1,"src_id":121004172,"trial_step":172},{"step":172,"speaker":"采药少女","content":"胡说！神仙才不吃人！","voice":["vo_trial_21004_1_62"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004173,"trial_step":173},{"step":173,"speaker":"村民1","content":"你你你，小姑娘别瞎说，你难道还亲眼瞧见不成？","voice":["vo_trial_21004_1_63"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004174,"trial_step":174},{"step":174,"speaker":"采药少女","content":"没错！就是我亲眼见到的！","voice":["vo_trial_21004_1_64"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004175,"trial_step":175},{"step":175,"content":"原本一直温吞的少女骤然拔高声音。她头一回这么大声讲话，嗓音颤抖着，却强撑坚定。","style":3,"background":2577,"log_type":1,"src_id":121004176,"trial_step":176},{"step":176,"speaker":"采药少女","content":"是她……是虎仙救了我，打跑了那些打劫的混蛋。白虎山君不是传说，那就是神仙！","voice":["vo_trial_21004_1_65"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004177,"trial_step":177},{"step":177,"speaker":"村民2","content":"但……那可是老虎……","voice":["vo_trial_21004_1_66"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004178,"trial_step":178},{"step":178,"speaker":"采药少女","content":"管她是虎是人！只要做好事帮好人，那就是好神仙！","voice":["vo_trial_21004_1_67"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004179,"trial_step":179},{"step":179,"content":"少女继续梗着脖子跟人争辩。而藏在大氅下的那人略微抿嘴，趁着众人不注意时起身，却被掌柜拦下结账。","style":3,"background":2577,"log_type":1,"src_id":121004180,"trial_step":180},{"step":180,"speaker":"掌柜","content":"一盘酱牛肉，二两烧酒……一钱银子！欸，先前没怎么见过您啊，怎么称呼？","voice":["vo_trial_21004_1_68"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004181,"trial_step":181},{"step":181,"content":"斗篷下的人顿了顿。","style":3,"background":2577,"log_type":1,"src_id":121004182,"trial_step":182},{"step":182,"content":"她看了眼门口最近香火正盛的白虎庙，几个村民正张罗着挂上一副新对联。","style":3,"background":2577,"log_type":1,"src_id":121004183,"trial_step":183},{"step":183,"content":"女人轻笑。她认不得红纸上那几个弯弯绕绕的黑墨笔迹，只是偶尔下山混口酒喝时，听人念过上方的文字。","style":3,"background":2577,"log_type":1,"src_id":121004184,"trial_step":184},{"step":184,"content":"<color=#fb9259><i><b>啸应千峰承祭酒 风开百里护苍生</color></i></b>","style":14,"background":2577,"is_centered":true,"log_type":1,"src_id":121004185,"trial_step":185},{"step":185,"content":"那写的是虎仙、是山君。","style":3,"background":2577,"log_type":1,"src_id":121004186,"trial_step":186},{"step":186,"content":"可惜，神仙并不存在。深山里有的只有白虎，和一个被白虎养大，又被误认为山君的女人。","style":3,"background":2577,"log_type":1,"src_id":121004187,"trial_step":187},{"step":187,"content":"人啊，多有趣。弱小又多变，几乎不能只凭靠自己而活，于是求神拜佛，想要神仙相助。但他们又不奢求太多，只是以其寄托一份心愿、一份祝福。","style":3,"background":2577,"log_type":1,"src_id":121004188,"trial_step":188},{"step":188,"content":"——“不求建功立业、青史留名；但求平安顺遂，一生无忧。”","style":3,"background":2577,"log_type":1,"src_id":121004189,"trial_step":189},{"step":189,"content":"一份份心意相连，变成了街口的烧鸡、碗中的烧酒，变成了挂在发辫上的金饰、串在手腕上的红绳。","style":3,"background":2577,"log_type":1,"src_id":121004190,"trial_step":190},{"step":190,"content":"也成了这山下的万千灯火、繁杂人间。","style":3,"background":2577,"log_type":1,"src_id":121004191,"trial_step":191},{"step":191,"speaker":"？？","content":"呵……","voice":["vo_trial_21004_1_69"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004192,"trial_step":192},{"step":192,"content":"她仍算不上喜欢人，也不想当个什么“好神仙”。只是山下热闹，她不介意常来看看……偶尔，或许也可以顺带手，帮几个一起下山的小家伙。","style":3,"background":2577,"log_type":1,"src_id":121004193,"trial_step":193},{"step":193,"content":"于是女人抬手掀起大氅。她本是白虎生养、无姓无名，但既入人间，也不妨入乡随俗——","style":3,"background":2577,"log_type":1,"src_id":121004194,"trial_step":194},{"step":194,"speaker":"啸风","content":"以后，就叫我<color=#fb9259>啸风</color>吧。","voice":["vo_trial_21004_1_70"],"voice_bank":"vo_xiaofeng_trial","style":1,"background":2577,"log_type":1,"src_id":121004195,"trial_step":195}]}