{"id":1220101,"chapter_id":1220101,"scene_id":1,"steps":[{"step":1,"speaker":"海拉","content":"嘿嘿嘿，你终于来了……我等了好久了，好无聊的。","voice":["vo_trial_220101_1_1"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101002,"trial_step":2,"drawing":1220106},{"step":2,"speaker":"海拉","content":"靠近点呀，不是说要“审查”我吗？","voice":["vo_trial_220101_1_2"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101003,"trial_step":3,"drawing":1220106},{"step":3,"speaker":"海拉","content":"——局 长 大 人？","voice":["vo_trial_220101_1_3"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101004,"trial_step":4,"drawing":1220106},{"step":4,"speaker":"海拉","content":"唔！好亮——","voice":["vo_trial_220101_1_5"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101006,"trial_step":6,"drawing":1220104},{"step":5,"content":"惨白的灯光骤然打亮黑暗中的少女，她有些难受地眯起眼睛。","style":3,"log_type":1,"src_id":320101007,"trial_step":7,"drawing":1220104},{"step":6,"content":"抱歉，要关掉吗？","options":["抱歉，要关掉吗？"],"style":6,"log_type":1,"src_id":320101008,"trial_step":8,"course":3,"drawing":1220104,"choices":[{"text":"抱歉，要关掉吗？","goto":9}]},{"step":7,"speaker":"海拉","content":"不用不用，这可都是专门设计过的，为的就是威慑我们这些坏人。","voice":["vo_trial_220101_1_8"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101009,"trial_step":9,"drawing":1220106},{"step":8,"speaker":"海拉","content":"倒是你，局长，看起来很没经验的样子……","voice":["vo_trial_220101_1_9"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101010,"trial_step":10,"drawing":1220102},{"step":9,"speaker":"海拉","content":"第一次审查别人吧？你知道要做什么吗？","voice":["vo_trial_220101_1_10"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101011,"trial_step":11,"drawing":1220102},{"step":10,"options":["我想更了解你","揭露你的一些行为"],"style":6,"log_type":1,"src_id":320101012,"trial_step":12,"course":3,"drawing":1220102,"choices":[{"text":"我想更了解你","goto":13},{"text":"揭露你的一些行为","goto":15}]},{"step":11,"speaker":"海拉","content":"哈哈，好温柔呢，局长。这可是经典的怀柔话术，看来你掌握得不错。","voice":["vo_trial_220101_1_12"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101013,"trial_step":13,"drawing":1220102},{"step":12,"content":"她的眼里可没有一丝笑意。尽管她从不是温柔乖巧的女孩，此刻的怒意也让你感到非比寻常。","style":3,"log_type":1,"src_id":320101014,"trial_step":14,"drawing":1220102,"next":[17]},{"step":13,"speaker":"海拉","content":"哦哦哦这个气势很好！审问官就要这么威风凛凛，气势上不能输啊。","voice":["vo_trial_220101_1_14"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101015,"trial_step":15,"drawing":1220102},{"step":14,"content":"她的眼里可没有一丝笑意。尽管她从不是温柔乖巧的女孩，此刻的怒意也让你感到非比寻常。","style":3,"log_type":1,"src_id":320101016,"trial_step":16,"drawing":1220102},{"step":15,"content":"仿佛面前不再是那个跟你并肩作战多时的禁闭者，而是一个满怀敌意、令人畏惧的危险分子。","style":3,"log_type":1,"src_id":320101017,"trial_step":17,"drawing":1220102},{"step":16,"speaker":"海拉","content":"来进入正题吧局长，你要问些什么呢？想知道我在辛迪加的光辉事迹吗？","voice":["vo_trial_220101_1_17"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101018,"trial_step":18,"drawing":1220101},{"step":17,"speaker":"海拉","content":"治安局那儿有超——级厚的资料，都是关于我的，拿出来看看呀？","voice":["vo_trial_220101_1_18"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101019,"trial_step":19,"drawing":1220101},{"step":18,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":20,"course":6,"drawing":1220100},{"step":19,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":20,"course":6,"drawing":1220100},{"step":20,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":20,"course":6,"drawing":1220100},{"step":21,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":20,"course":6,"drawing":1220100},{"step":22,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":20,"course":6,"drawing":1220100},{"step":23,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":20,"course":6,"drawing":1220100},{"step":24,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":20,"course":6,"drawing":1220100},{"step":25,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":20,"course":6,"drawing":1220100},{"step":26,"content":"N.F.100至109年间，海拉共实施了二十六起财务侵占，三十五次引导他人错误投资，五次威胁人身安全——甚至还有15次从治安局出逃的记录。","style":3,"log_type":1,"src_id":320101021,"trial_step":21,"drawing":1220100},{"step":27,"speaker":"治安官A笔记","content":"利用自己的伤口博同情，扮无辜撒着谎帮同伙冒名顶替……记住吧，辛迪加没有“无辜可怜”，她们最后都会变成最凶恶狡猾的家伙。","style":1,"log_type":1,"src_id":320101022,"trial_step":22,"drawing":1220100},{"step":28,"speaker":"治安官B笔记","content":"臭耗子！！她把治安局当随意出入的后院吗？！怎么打都不知悔改的话，就等着死在辛迪加街头吧！","style":1,"log_type":1,"src_id":320101023,"trial_step":23,"drawing":1220100},{"step":29,"content":"真是让人眼花缭乱的战绩，如果这样的行为是辛迪加弱势者的常态，那你可以想象这片城区到底堕落到什么地步。","style":3,"log_type":1,"src_id":320101024,"trial_step":24,"drawing":1220100},{"step":30,"content":"只是，在这段记录中，并没有海拉使用禁闭者能力的说明。","style":3,"log_type":1,"src_id":320101025,"trial_step":25,"drawing":1220100},{"step":31,"content":"相反，只不断记录着海拉被带走、受伤之类的事，看上去……竟是个十分柔弱的女孩。","style":3,"log_type":1,"src_id":320101026,"trial_step":26,"drawing":1220100},{"step":32,"content":"你以前没有异能？","options":["你以前没有异能？"],"style":6,"log_type":1,"src_id":320101027,"trial_step":27,"course":3,"drawing":1220100,"choices":[{"text":"你以前没有异能？","goto":28}]},{"step":33,"speaker":"海拉","content":"被你发现了！我确实不是天生的禁闭者，这个转变是个漫长的过程。","voice":["vo_trial_220101_1_27"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101028,"trial_step":28,"drawing":1220101},{"step":34,"speaker":"海拉","content":"接下来，你就要问我：什么时候转变、都发生了什么、有谁参与……对吧？","voice":["vo_trial_220101_1_28"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101029,"trial_step":29,"drawing":1220107},{"step":35,"speaker":"海拉","content":"这样的问话，你的前任们已经重复无数次了。","voice":["vo_trial_220101_1_29"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101030,"trial_step":30,"drawing":1220107},{"step":36,"content":"那你愿意告诉我吗？","options":["那你愿意告诉我吗？","摆正你的态度"],"style":6,"log_type":1,"src_id":320101031,"trial_step":31,"course":3,"drawing":1220107,"choices":[{"text":"那你愿意告诉我吗？","goto":32},{"text":"摆正你的态度","goto":34}]},{"step":37,"speaker":"海拉","content":"局长……你搜集了那么多资料，为什么不自己猜猜看呢？","voice":["vo_trial_220101_1_31"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101032,"trial_step":32,"drawing":1220103},{"step":38,"content":"她的手指轻轻点了点自己的太阳穴。","style":3,"log_type":1,"src_id":320101033,"trial_step":33,"drawing":1220103,"next":[36]},{"step":39,"speaker":"海拉","content":"“摆正你的态度！你所说的所有话都会用来评估你的危险等级和收容措施。不想吃苦的话，就老实回答——”","voice":["vo_trial_220101_1_33"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101034,"trial_step":34,"drawing":1220103},{"step":40,"speaker":"海拉","content":"好的局长，坏家伙海拉静候您的审判。","voice":["vo_trial_220101_1_34"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101035,"trial_step":35,"drawing":1220106},{"step":41,"content":"测试全屏类文本对演出效果的支持","style":14,"background":50409,"log_type":1,"src_id":3,"trial_step":36,"course":6,"drawing":1220106},{"step":42,"content":"转场…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":36,"course":6,"drawing":1220106},{"step":43,"content":"音效及语音…………………………………………………………………………","voice":["vo_cgplot_100002"],"voice_bank":"vo_cgplot_00","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":36,"course":6,"drawing":1220106},{"step":44,"content":"一次性特效…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":36,"course":6,"drawing":1220106},{"step":45,"content":"循环特效…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":36,"course":6,"drawing":1220106},{"step":46,"content":"循环特效…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":36,"course":6,"drawing":1220106},{"step":47,"content":"缉捕体检报告显示，你身上残存着3年前一项研究的遗留痕迹。而在N.F.109-111年间，你罕见地没有留下任何犯罪记录。","style":2,"log_type":1,"src_id":320101037,"trial_step":37,"drawing":1220106},{"step":48,"content":"FAC怀疑你是无视规则与道德，通过研究而诞生出来的禁闭者。","style":2,"log_type":1,"src_id":320101038,"trial_step":38,"drawing":1220106},{"step":49,"speaker":"海拉","content":"哦？嗯……该怎么说呢，我没读过书，不太清楚这个研究是什么意思诶。","voice":["vo_trial_220101_1_38"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101039,"trial_step":39,"drawing":1220101},{"step":50,"content":"恰好，你手上有些材料，或许跟这个“研究”有关。","style":3,"log_type":1,"src_id":320101040,"trial_step":40,"drawing":1220101},{"step":51,"content":"测试音效的打断逻辑","style":3,"log_type":1,"src_id":2,"trial_step":41,"course":6,"drawing":1220101},{"step":52,"content":"播放一个长音效，会有个前奏，稍等一会儿。","style":3,"log_type":1,"src_id":2,"trial_step":41,"course":6,"drawing":1220101},{"step":53,"content":"播放相同音效，会继续延续。","style":3,"log_type":1,"src_id":2,"trial_step":41,"course":6,"drawing":1220101},{"step":54,"content":"暂停配置音效，这里测试一下打断。","style":3,"log_type":1,"src_id":2,"trial_step":41,"course":6,"drawing":1220101},{"step":55,"content":"播放一个稍短的音效，在这里等待它结束。","style":3,"log_type":1,"src_id":2,"trial_step":41,"course":6,"drawing":1220101},{"step":56,"content":"配置同名音效，看能否再次播放。","style":3,"log_type":1,"src_id":2,"trial_step":41,"course":6,"drawing":1220101},{"step":57,"content":"结束测试。","style":18,"log_type":1,"src_id":2,"trial_step":41,"course":6,"drawing":1220101},{"step":58,"content":"这是从狂厄武器芯片中还原的数据。里面提及的核心研究……对象No.327，就是你吧。","style":2,"log_type":1,"src_id":320101042,"trial_step":42,"drawing":1220104},{"step":59,"content":"研究没有成功，却有意外收获……再生能力……辛迪加少女……\n除了她，很难有第二个人了。","style":3,"log_type":1,"src_id":320101043,"trial_step":43,"drawing":1220104},{"step":60,"speaker":"海拉","content":"咻————你从哪儿拿到这个东西的，太厉害了，鼓掌鼓掌。","voice":["vo_trial_220101_1_43"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101044,"trial_step":44,"drawing":1220104},{"step":61,"content":"告诉我详情","options":["告诉我详情"],"style":6,"log_type":1,"src_id":320101045,"trial_step":45,"course":3,"drawing":1220100,"choices":[{"text":"告诉我详情","goto":46}]},{"step":62,"content":"这份报告是在狂厄武器附近被发现的，我很在意它们之间的联系。","style":2,"log_type":1,"src_id":320101046,"trial_step":46,"drawing":1220100},{"step":63,"content":"你接受了什么研究？目的是什么？是和禁闭者有关的技术吗？你为什么参与其中？","style":2,"log_type":1,"src_id":320101047,"trial_step":47,"drawing":1220100},{"step":64,"content":"你……是自愿的吗？\n——这句话，你没有问出口。","style":3,"log_type":1,"src_id":320101048,"trial_step":48,"drawing":1220100},{"step":65,"speaker":"海拉","content":"啊呀，推理结束，要开始问话了吗？","voice":["vo_trial_220101_1_48"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101049,"trial_step":49,"drawing":1220102},{"step":66,"speaker":"海拉","content":"那就别浪费时间了，接下来，我什么都不会告诉你。","voice":["vo_trial_220101_1_49"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101050,"trial_step":50,"drawing":1220108},{"step":67,"content":"一时间，审查室内只回荡着监视仪器僵硬的声响，气氛比你们不愉快的初见还要糟糕。","style":3,"log_type":1,"src_id":320101051,"trial_step":51,"drawing":1220108},{"step":68,"speaker":"海拉","content":"有什么好吃惊的，你以为把我扔进这种地方，关了禁闭、给点甜头，我就会乖乖交代一切吗？","voice":["vo_trial_220101_1_51"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101052,"trial_step":52,"drawing":1220108},{"step":69,"speaker":"海拉","content":"瞧不起谁呀！被扔进来那么多次，我早看腻你们那些把戏了，你们都一样！","voice":["vo_trial_220101_1_52"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101053,"trial_step":53,"drawing":1220108},{"step":70,"speaker":"海拉","content":"怕我？讨厌我？因为我犯过事儿，又是个禁闭者？接下来要打我了吗？！","voice":["vo_trial_220101_1_53"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101054,"trial_step":54,"drawing":1220108},{"step":71,"content":"她的愤怒突然爆发，坦率得不带任何掩饰。","style":3,"log_type":1,"src_id":320101055,"trial_step":55,"drawing":1220108},{"step":72,"speaker":"海拉","content":"混蛋东西……亏我还傻乎乎地救你，帮你挡伤……","voice":["vo_trial_220101_1_55"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101056,"trial_step":56,"drawing":1220108},{"step":73,"speaker":"海拉","content":"早知道你也是这个德行，当时就该一榔头敲死你个笨*。","voice":["vo_trial_220101_1_56"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101057,"trial_step":57,"drawing":1220108},{"step":74,"content":"她的情绪异常凶猛，所有仪器都亮起警报，警告你处理不当会十分麻烦。不过，在这爆发的情感中，似乎还夹杂着别的微妙情绪。","style":3,"log_type":1,"src_id":320101058,"trial_step":58,"drawing":1220108},{"step":75,"content":"你已经不是第一次窥见她内心的裂缝，该怎么应对，你已经心里有数——","style":3,"log_type":1,"src_id":320101059,"trial_step":59,"drawing":1220108},{"step":76,"speaker":"海拉","content":"……诶？","voice":["vo_trial_220101_1_60"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101061,"trial_step":61,"drawing":1220105},{"step":77,"content":"我们一起揍过欺负你的黑帮，并肩作战了那么久。可我却还是把你关进了审查室。","style":2,"log_type":1,"src_id":320101062,"trial_step":62,"drawing":1220105},{"step":78,"content":"你觉得我们之间不该仅仅是审查者和禁闭者，可我辜负了你的期待，所以你才这么生气？","style":2,"log_type":1,"src_id":320101063,"trial_step":63,"drawing":1220105},{"step":79,"speaker":"海拉","content":"你说什么……诶？不、不是……","voice":["vo_trial_220101_1_63"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101064,"trial_step":64,"drawing":1220105},{"step":80,"content":"她的所有伶牙俐齿突然掉了个干净，好像完全没察觉自己的心情，呆滞了好一会儿，渐渐手足无措了起来。","style":3,"log_type":1,"src_id":320101065,"trial_step":65,"drawing":1220105},{"step":81,"content":"对不起，我太迟钝了。","style":2,"log_type":1,"src_id":320101066,"trial_step":66,"drawing":1220105},{"step":82,"speaker":"海拉","content":"胡说什么啊混蛋！别自作多情了，我才没——","voice":["vo_trial_220101_1_66"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101067,"trial_step":67,"drawing":1220105},{"step":83,"speaker":"海拉","content":"……等等，你要干嘛，喂别过来呀！","voice":["vo_trial_220101_1_67"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101068,"trial_step":68,"drawing":1220105},{"step":84,"content":"她见你起身，像是受到惊吓一般往后仰着，若不是挣脱不开，她恐怕立刻会蹦起来逃走。","style":3,"log_type":1,"src_id":320101069,"trial_step":69,"drawing":1220105},{"step":85,"content":"要我解开你的双手吗？","options":["要我解开你的双手吗？"],"style":6,"log_type":1,"src_id":320101070,"trial_step":70,"course":3,"drawing":1220105,"choices":[{"text":"要我解开你的双手吗？","goto":71}]},{"step":86,"content":"我们一起经历了许多，根本不需要走这种流程。我们之间……应该更像是朋友。","style":2,"log_type":1,"src_id":320101071,"trial_step":71,"drawing":1220105},{"step":87,"content":"你帮了我很多，我不希望出这种事让你不开心。","style":2,"log_type":1,"src_id":320101072,"trial_step":72,"drawing":1220105},{"step":88,"speaker":"海拉","content":"够了够了！不然我要喊了！**，你今天是专门过来恶心我的吗？","female_content":"够了够了！以大欺小你要不要脸啊！**，你今天是专门过来恶心我的吗？","voice":["vo_trial_220101_1_72","vo_trial_220101_1_72f"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101073,"trial_step":73,"drawing":1220105},{"step":89,"speaker":"海拉","content":"听着，这只是礼貌问题，跟朋、你说的那些完全没关系！我只是气你不懂感恩！","voice":["vo_trial_220101_1_73"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101074,"trial_step":74,"drawing":1220105},{"step":90,"content":"我很感谢你","options":["我很感谢你"],"style":6,"log_type":1,"src_id":320101075,"trial_step":75,"course":3,"drawing":1220105,"choices":[{"text":"我很感谢你","goto":76}]},{"step":91,"speaker":"海拉","content":"再说恶心话，我就回去了！救命啊————","voice":["vo_trial_220101_1_75"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101076,"trial_step":76,"drawing":1220105},{"step":92,"content":"闹腾了一阵，她总算平静下来，表情尽管还有些不忿和窘迫，但先前的敌意已经不复存在了。","style":3,"log_type":1,"src_id":320101077,"trial_step":77,"drawing":1220105,"next":[86]},{"step":93,"speaker":"海拉","content":"哈哈……哈哈哈哈哈……你说的对。","voice":["vo_trial_220101_1_77"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101078,"trial_step":78,"drawing":1220103},{"step":94,"speaker":"海拉","content":"你已经很有审查者的架势了，新任局长。","voice":["vo_trial_220101_1_78"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101079,"trial_step":79,"drawing":1220103},{"step":95,"speaker":"海拉","content":"那来吧，拿出你所有本事，看看能不能从我这里撬出点什么？","voice":["vo_trial_220101_1_79"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101080,"trial_step":80,"drawing":1220103},{"step":96,"speaker":"海拉","content":"反正我也不会死，我们有的是时间……","voice":["vo_trial_220101_1_80"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101081,"trial_step":81,"drawing":1220103},{"step":97,"content":"她如此挑衅着，但此刻你鲜明地理解到，自己已经不可能再从她口中得到一分一毫的情报了……","style":3,"log_type":1,"src_id":320101082,"trial_step":82,"drawing":1220103},{"step":98,"content":"你努力扮演一个称职的局长，但却始终没能从海拉那里得到任何信息。\n该严厉一点吗？在共同经历了那么多后，你不可能下得了手，你们之间早已不是那种冰冷无情的关系。\n她这么抗拒你的审问，又是出于什么样的心情呢？\n\n下次，你或许该尝试从这里入手……","style":14,"background":10000,"log_type":1,"src_id":320101083,"trial_step":83,"drawing":1220103},{"step":99,"speaker":"海拉","content":"算了……我早就知道，你是个怪胎。","voice":["vo_trial_220101_1_85"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101086,"trial_step":86,"drawing":1220106},{"step":100,"speaker":"海拉","content":"脑子正常的家伙，从一开始就不会跟禁闭者说话。","voice":["vo_trial_220101_1_86"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101087,"trial_step":87,"drawing":1220106},{"step":101,"content":"她大概是在夸奖你。","style":3,"log_type":1,"src_id":320101088,"trial_step":88,"drawing":1220106},{"step":102,"speaker":"海拉","content":"……我不需要朋友。","voice":["vo_trial_220101_1_88"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101089,"trial_step":89,"drawing":1220105},{"step":103,"content":"只有这一点，她还要嘴硬。","style":3,"log_type":1,"src_id":320101090,"trial_step":90,"drawing":1220105},{"step":104,"options":["你那些“同伴”呢？"],"style":6,"log_type":1,"src_id":320101091,"trial_step":91,"course":3,"drawing":1220105,"choices":[{"text":"你那些“同伴”呢？","goto":92}]},{"step":105,"speaker":"海拉","content":"哈？","voice":["vo_trial_220101_1_91"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101092,"trial_step":92,"drawing":1220104},{"step":106,"content":"一起干那些事儿的……同伴？你还总替他们受罚。","style":2,"log_type":1,"src_id":320101093,"trial_step":93,"drawing":1220100},{"step":107,"content":"至少现在，她肯定不会为你这么做。","style":3,"log_type":1,"src_id":320101094,"trial_step":94,"drawing":1220100},{"step":108,"content":"短暂的沉默后，海拉的眼神变得十分冷漠，或者说——厌恶。","style":3,"log_type":1,"src_id":320101095,"trial_step":95,"drawing":1220100},{"step":109,"speaker":"海拉","content":"那些家伙才不是朋友，不过是各取所需罢了。","voice":["vo_trial_220101_1_95"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101096,"trial_step":96,"drawing":1220102},{"step":110,"speaker":"海拉","content":"他们需要一个小机灵鬼来逃脱惩罚，而我要活下去。","voice":["vo_trial_220101_1_96"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101097,"trial_step":97,"drawing":1220102},{"step":111,"speaker":"海拉","content":"在辛迪加，如果没有“朋友”，像我这样的家伙只会随随便便死在夜晚的哪个角落。","voice":["vo_trial_220101_1_97"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101098,"trial_step":98,"drawing":1220102},{"step":112,"content":"可他们每次都抛下你，将你留在治安局代替他们。","style":2,"log_type":1,"src_id":320101099,"trial_step":99,"drawing":1220102},{"step":113,"content":"只是合作关系的话……我认识的海拉绝不会咽下这口气，你为什么要勉强自己跟在他们身边？","style":2,"log_type":1,"src_id":320101100,"trial_step":100,"drawing":1220102},{"step":114,"speaker":"海拉","content":"我心胸宽广。","voice":["vo_trial_220101_1_100"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101101,"trial_step":101,"drawing":1220105},{"step":115,"content":"又在逞强。过了好一会儿，她终究别过脸，避开你的注视。","style":3,"log_type":1,"src_id":320101102,"trial_step":102,"drawing":1220105},{"step":116,"speaker":"海拉","content":"……我那时候小，还以为，只要他们还需要我，只要我还有用，我就能被当“朋友”。","voice":["vo_trial_220101_1_102"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101103,"trial_step":103,"drawing":1220100},{"step":117,"speaker":"海拉","content":"从来没有人告诉我什么是朋友。","voice":["vo_trial_220101_1_103"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101104,"trial_step":104,"drawing":1220100},{"step":118,"speaker":"海拉","content":"别这么看着我，那都是过去的事了。再怎么蠢，被人卖了数钱后，我也不得不清醒。","voice":["vo_trial_220101_1_104"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101105,"trial_step":105,"drawing":1220100},{"step":119,"content":"发生了什么？","options":["发生了什么？"],"style":6,"log_type":1,"src_id":320101106,"trial_step":106,"course":3,"drawing":1220100,"choices":[{"text":"发生了什么？","goto":107}]},{"step":120,"speaker":"海拉","content":"……也没什么不好说的，就是你们一直想知道的，那种研究。","voice":["vo_trial_220101_1_106"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101107,"trial_step":107,"drawing":1220102},{"step":121,"speaker":"海拉","content":"那一年，辛迪加来了几个奇怪的研究员，专找无依无靠的人，给一笔钱，带去参加什么什么研究。","voice":["vo_trial_220101_1_107"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101108,"trial_step":108,"drawing":1220102},{"step":122,"speaker":"海拉","content":"那些“朋友”把我骗过去，强行让我参加了这帮人的研究。","voice":["vo_trial_220101_1_108"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101109,"trial_step":109,"drawing":1220102},{"step":123,"speaker":"海拉","content":"呵，就为了几个酒钱。","voice":["vo_trial_220101_1_109"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101110,"trial_step":110,"drawing":1220103},{"step":124,"content":"这是一阵让人难以忍受的死寂，你脑海中飞速回放着帕尔马报告上惨烈的描述。","style":3,"log_type":1,"src_id":320101111,"trial_step":111,"drawing":1220103},{"step":125,"content":"那是什么样的研究？","options":["那是什么样的研究？"],"style":6,"log_type":1,"src_id":320101112,"trial_step":112,"course":3,"drawing":1220103,"choices":[{"text":"那是什么样的研究？","goto":113}]},{"step":126,"speaker":"海拉","content":"我都快忘了。大概就是，打打点滴摸摸电门，啊，好像还每天都得喝些黑乎乎的东西——对，就是死役身上流出来的东西，然后记录反应。","voice":["vo_trial_220101_1_112"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101113,"trial_step":113,"drawing":1220108},{"step":127,"speaker":"海拉","content":"我一哭，有几个人就看着我笑。那时候我就决定了，要跟他们刚到底——一滴眼泪也不流。","voice":["vo_trial_220101_1_113"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101114,"trial_step":114,"drawing":1220108},{"step":128,"speaker":"海拉","content":"这么咬牙过了好久，有一天，我受伤的地方突然快速复原了。他们说，我变成了超人。","voice":["vo_trial_220101_1_114"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101115,"trial_step":115,"drawing":1220107},{"step":129,"speaker":"海拉","content":"嘿，其实就是禁闭者。","voice":["vo_trial_220101_1_115"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101116,"trial_step":116,"drawing":1220107},{"step":130,"speaker":"海拉","content":"不过，也不能说明这研究就是决定因素。毕竟，跟我一起参加研究的人，很多都没走出来。","voice":["vo_trial_220101_1_116"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101117,"trial_step":117,"drawing":1220107},{"step":131,"speaker":"海拉","content":"肯定还是因为我有超人的意志吧。","voice":["vo_trial_220101_1_117"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101118,"trial_step":118,"drawing":1220107},{"step":132,"content":"她笑了笑，你心里却很不是滋味。","style":3,"log_type":1,"src_id":320101119,"trial_step":119,"drawing":1220107},{"step":133,"content":"……然后呢？结束了吗？","style":2,"log_type":1,"src_id":320101120,"trial_step":120,"drawing":1220107},{"step":134,"speaker":"海拉","content":"怎么可能结束。就算这不是他们最想要的能力，那帮混蛋也能找到别的用途。","voice":["vo_trial_220101_1_120"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101121,"trial_step":121,"drawing":1220100},{"step":135,"content":"报告上说，你被要求和一个“怪物”一起进行研究，它会拿刀攻击你。","style":2,"log_type":1,"src_id":320101122,"trial_step":122,"drawing":1220100},{"step":136,"speaker":"海拉","content":"别这么叫她，不然，我这种死不了的，也是怪物咯？","voice":["vo_trial_220101_1_122"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101123,"trial_step":123,"drawing":1220108},{"step":137,"speaker":"海拉","content":"哈哈，也对。那些研究员觉得，怪物之间的碰撞能进一步强化异能效果，我的无限再生能力刚好就成了绝佳的沙包。","voice":["vo_trial_220101_1_123"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101124,"trial_step":124,"drawing":1220103},{"step":138,"speaker":"海拉","content":"每天对着我用这个，用那个，敲一敲，碰一碰，看我还能扛多久，恢复有多快。为了延长研究，那帮畜生可是想尽了办法。","voice":["vo_trial_220101_1_124"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101125,"trial_step":125,"drawing":1220103},{"step":139,"speaker":"海拉","content":"具体就别问了，你也不适合听那么重口味的东西。","voice":["vo_trial_220101_1_125"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101126,"trial_step":126,"drawing":1220103},{"step":140,"content":"一想到那个名为帕尔马的神秘势力，它们跟狂厄武器的关系，还有它们对海拉做的事，想到她那时才——","style":3,"log_type":1,"src_id":320101127,"trial_step":127,"drawing":1220103},{"step":141,"content":"你感到气血逐渐上涌。","style":3,"log_type":1,"src_id":320101128,"trial_step":128,"drawing":1220103},{"step":142,"content":"我绝不会放过他们","options":["我绝不会放过他们"],"style":6,"log_type":1,"src_id":320101129,"trial_step":129,"course":3,"drawing":1220103,"choices":[{"text":"我绝不会放过他们","goto":130}]},{"step":143,"speaker":"海拉","content":"……你生什么气啊，莫名其妙，这事明明跟你没关系。","voice":["vo_trial_220101_1_129"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101130,"trial_step":130,"drawing":1220105},{"step":144,"content":"但跟你有关","options":["但跟你有关"],"style":6,"log_type":1,"src_id":320101131,"trial_step":131,"course":3,"drawing":1220105,"choices":[{"text":"但跟你有关","goto":132}]},{"step":145,"speaker":"海拉","content":"呸，跟你很熟吗？我还轮不着被你可怜！","voice":["vo_trial_220101_1_131"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101132,"trial_step":132,"drawing":1220105},{"step":146,"content":"她嗖地缩回去一脸警惕，抬头想要瞪你，却只露出了些手足无措的表情。","style":3,"log_type":1,"src_id":320101133,"trial_step":133,"drawing":1220105},{"step":147,"content":"是为了自己身为“坏人”的面子呢？还是单纯不想让你担心？总之，她做好了表情管理，轻咳两声，开始演说。","style":3,"log_type":1,"src_id":320101134,"trial_step":134,"drawing":1220105},{"step":148,"speaker":"海拉","content":"行啦，别跟个老妈子一样担心来担心去的。我可是聪明可爱坚强机智的美少女，才不会就那么认输呢！","voice":["vo_trial_220101_1_134"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101135,"trial_step":135,"drawing":1220105},{"step":149,"speaker":"灯光的闪烁频率、广播插入的时机、音乐节奏的推进、房间切换的顺序都并非随机，而是在彼此配合，逐步诱导注意、强化刺激、放大情绪反应。","content":"这不，用不着1年，我就凭自己超人的智慧逃离魔爪！","voice":["vo_trial_220101_1_135"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101136,"trial_step":136,"drawing":1220107},{"step":150,"content":"……","style":2,"log_type":1,"src_id":320101137,"trial_step":137,"drawing":1220107},{"step":151,"speaker":"海拉","content":"而且，这也不全是坏事。变成禁闭者后，我就可以自己保护自己了，再也不用看人眼色做事，在辛迪加活得潇潇洒洒。","voice":["vo_trial_220101_1_137"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101138,"trial_step":138,"drawing":1220107},{"step":152,"speaker":"海拉","content":"我出去还揍了他们一顿呢！可解气了！","voice":["vo_trial_220101_1_138"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101139,"trial_step":139,"drawing":1220107},{"step":153,"content":"……","style":2,"log_type":1,"src_id":320101140,"trial_step":140,"drawing":1220107},{"step":154,"speaker":"海拉","content":"怎么还是一副愁眉苦脸的样子啊？真是的，我再教你一句古话，我的座右铭。","voice":["vo_trial_220101_1_140"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101141,"trial_step":141,"drawing":1220107},{"step":155,"speaker":"海拉","content":"打不死我的，只会让我更强大。","voice":["vo_trial_220101_1_141"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101142,"trial_step":142,"drawing":1220107},{"step":156,"content":"噗……咳咳。谢谢，学到了。","style":2,"log_type":1,"src_id":320101143,"trial_step":143,"drawing":1220107},{"step":157,"content":"你看着她一本正经的模样，有些忍俊不禁。","style":3,"log_type":1,"src_id":320101144,"trial_step":144,"drawing":1220107},{"step":158,"content":"这个玩笑让你从那地狱般的想象中解脱出来，她脸上的表情也放松了些。","style":3,"log_type":1,"src_id":320101145,"trial_step":145,"drawing":1220107},{"step":159,"speaker":"海拉","content":"所以嘛，没什么好担心的。","voice":["vo_trial_220101_1_145"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101146,"trial_step":146,"drawing":1220107},{"step":160,"speaker":"海拉","content":"我是辛迪加的耗子，打不死，也关不住。我是自由的，总有一天，连这儿都关不住我！","voice":["vo_trial_220101_1_146"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101147,"trial_step":147,"drawing":1220107},{"step":161,"speaker":"海拉","content":"到时候你可别哭鼻子，毕竟——实力摆着呢。","voice":["vo_trial_220101_1_147"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101148,"trial_step":148,"drawing":1220107},{"step":162,"content":"瞧这副得意的表情，不知道的话，还以为她的评级上调到S了。","style":3,"log_type":1,"src_id":320101149,"trial_step":149,"drawing":1220107},{"step":163,"content":"不过，不管是逃离研究室，还是后来的威震辛迪加，海拉此后的战勋确实惊为天人——跟她的实力完全不成正比。","style":3,"log_type":1,"src_id":320101150,"trial_step":150,"drawing":1220107},{"step":164,"content":"对那段可憎的过去，她的心态也出乎意料的平和积极。让你不禁觉得，海拉也许收获了更重要的东西。","style":3,"log_type":1,"src_id":320101151,"trial_step":151,"drawing":1220107},{"step":165,"content":"比如——一个真正的朋友。","style":3,"log_type":1,"src_id":320101152,"trial_step":152,"drawing":1220107},{"step":166,"content":"测试全屏类文本对演出效果的支持","style":14,"background":50409,"log_type":1,"src_id":3,"trial_step":153,"course":6,"drawing":1220107},{"step":167,"content":"转场…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":153,"course":6,"drawing":1220107},{"step":168,"content":"音效及语音…………………………………………………………………………","voice":["vo_cgplot_100002"],"voice_bank":"vo_cgplot_00","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":153,"course":6,"drawing":1220107},{"step":169,"content":"一次性特效…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":153,"course":6,"drawing":1220107},{"step":170,"content":"循环特效…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":153,"course":6,"drawing":1220107},{"step":171,"content":"循环特效…………………………………………………………………………","style":14,"background":50410,"log_type":1,"src_id":3,"trial_step":153,"course":6,"drawing":1220107},{"step":172,"content":"报告记录着，禁闭者海拉自入夜110年起重新活跃于辛迪加，她有一个强力的同伴，手持砍刀，即使遭遇帮战也所向披靡。","style":3,"log_type":1,"src_id":320101154,"trial_step":154,"drawing":1220100},{"step":173,"options":["看来你不只得到了力量"],"style":6,"log_type":1,"src_id":320101155,"trial_step":155,"course":3,"drawing":1220100,"choices":[{"text":"看来你不只得到了力量","goto":156}]},{"step":174,"speaker":"海拉","content":"？","voice":["vo_trial_220101_1_155"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101156,"trial_step":156,"drawing":1220104},{"step":175,"content":"你有了新伙伴吧，一个强大又忠诚的伙伴。毕竟在那以后，你再也没被出卖送进治安局了。","style":2,"log_type":1,"src_id":320101157,"trial_step":157,"drawing":1220104},{"step":176,"content":"太好了，海拉，你有了真正的朋友。","style":2,"log_type":1,"src_id":320101158,"trial_step":158,"drawing":1220104},{"step":177,"content":"海拉瘪了瘪嘴，装作不在乎似地朝你嚷嚷。","style":3,"log_type":1,"src_id":320101159,"trial_step":159,"drawing":1220105},{"step":178,"speaker":"海拉","content":"才不是朋友！只是捡回来的野狗，没有我罩着连饭都不会吃。我才是老大！","voice":["vo_trial_220101_1_159"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101160,"trial_step":160,"drawing":1220105},{"step":179,"content":"你想象了一下，海拉当老大的情景，不禁莞尔。被抓进来以后，她一定很舍不得吧。","style":3,"log_type":1,"src_id":320101161,"trial_step":161,"drawing":1220105},{"step":180,"content":"要回去看看她吗？","options":["要回去看看她吗？"],"style":6,"log_type":1,"src_id":320101162,"trial_step":162,"course":3,"drawing":1220105,"choices":[{"text":"要回去看看她吗？","goto":163}]},{"step":181,"content":"只要你表现良好，我可以帮你申请外出。","style":2,"log_type":1,"src_id":320101163,"trial_step":163,"drawing":1220105},{"step":182,"speaker":"海拉","content":"不稀罕，我又不是逃不出去。总有一天。","voice":["vo_trial_220101_1_163"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101164,"trial_step":164,"drawing":1220105},{"step":183,"speaker":"海拉","content":"倒是你，哼哼……还是别见她了，我怕你一刀都挨不住。","voice":["vo_trial_220101_1_164"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101165,"trial_step":165,"drawing":1220107},{"step":184,"content":"她的语气颇为得意，看来这个新搭档真的是一个强大的大腿。","style":3,"log_type":1,"src_id":320101166,"trial_step":166,"drawing":1220107},{"step":185,"content":"按追踪报告的记录，那是个强大的战士，手持砍刀，生性狂暴，一旦进入战斗状态就难以自制，确实挺吓人。","style":3,"log_type":1,"src_id":320101167,"trial_step":167,"drawing":1220107},{"step":186,"content":"等等……你突然意识到有什么不对劲。","style":3,"log_type":1,"src_id":320101168,"trial_step":168,"drawing":1220107},{"step":187,"content":"测试音效的打断逻辑","style":3,"log_type":1,"src_id":2,"trial_step":169,"course":6,"drawing":1220107},{"step":188,"content":"播放一个长音效，会有个前奏，稍等一会儿。","style":3,"log_type":1,"src_id":2,"trial_step":169,"course":6,"drawing":1220107},{"step":189,"content":"播放相同音效，会继续延续。","style":3,"log_type":1,"src_id":2,"trial_step":169,"course":6,"drawing":1220107},{"step":190,"content":"暂停配置音效，这里测试一下打断。","style":3,"log_type":1,"src_id":2,"trial_step":169,"course":6,"drawing":1220107},{"step":191,"content":"播放一个稍短的音效，在这里等待它结束。","style":3,"log_type":1,"src_id":2,"trial_step":169,"course":6,"drawing":1220107},{"step":192,"content":"配置同名音效，看能否再次播放。","style":3,"log_type":1,"src_id":2,"trial_step":169,"course":6,"drawing":1220107},{"step":193,"content":"结束测试。","style":18,"log_type":1,"src_id":2,"trial_step":169,"course":6,"drawing":1220107},{"step":194,"content":"在海拉参与的研究中，那只名为<color=#e45515>No.99</color>的怪物，扛刀与她千百次战斗的怪物，那个禁闭者研究室——","style":3,"log_type":1,"src_id":320101170,"trial_step":170,"drawing":1220100},{"step":195,"content":"你们在哪儿认识的？","options":["你们在哪儿认识的？"],"style":6,"log_type":1,"src_id":320101171,"trial_step":171,"course":3,"drawing":1220100,"choices":[{"text":"你们在哪儿认识的？","goto":172}]},{"step":196,"speaker":"海拉","content":"……问这个干什么？","voice":["vo_trial_220101_1_171"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101172,"trial_step":172,"drawing":1220104},{"step":197,"content":"在那个研究室里吗？","options":["在那个研究室里吗？"],"style":6,"log_type":1,"src_id":320101173,"trial_step":173,"course":3,"drawing":1220104,"choices":[{"text":"在那个研究室里吗？","goto":174}]},{"step":198,"content":"海拉的表情从疑惑转为警觉，她显然已经明白你的猜想——","style":3,"log_type":1,"src_id":320101174,"trial_step":174,"drawing":1220104},{"step":199,"content":"如果她的新搭档，正是帕尔马报告中的怪物——那个无法遏制狂化，无数次伤害海拉的可怕存在……","style":3,"log_type":1,"src_id":320101175,"trial_step":175,"drawing":1220104},{"step":200,"speaker":"选项","content":"No.99?","options":["No.99?"],"style":6,"log_type":1,"src_id":320101176,"trial_step":176,"course":3,"drawing":1220104,"choices":[{"text":"No.99?","goto":177}]},{"step":201,"content":"为什么要和她在一起。那可是用刀伤害你的怪物，很可能还会继续伤害你。","style":2,"log_type":1,"src_id":320101177,"trial_step":177,"drawing":1220104},{"step":202,"speaker":"海拉","content":"别叫她怪物，这件事跟你没有关系。","voice":["vo_trial_220101_1_177"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101178,"trial_step":178,"drawing":1220108},{"step":203,"speaker":"海拉","content":"还是说，你要把她也抓起来？像对我这样关禁闭？","voice":["vo_trial_220101_1_178"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101179,"trial_step":179,"drawing":1220108},{"step":204,"speaker":"海拉","content":"想都别想，关于她的事，我什么都不会告诉你。","voice":["vo_trial_220101_1_179"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101180,"trial_step":180,"drawing":1220108},{"step":205,"content":"她的眼神骤然降温，突然拉远的距离让你感到难过。","style":3,"log_type":1,"src_id":320101181,"trial_step":181,"drawing":1220108},{"step":206,"speaker":"选项","content":"我只是担心你","options":["我只是担心你"],"style":6,"log_type":1,"src_id":320101182,"trial_step":182,"course":3,"drawing":1220108,"choices":[{"text":"我只是担心你","goto":183}]},{"step":207,"content":"我跟那些研究员不一样，我不想让你再受伤。","style":2,"log_type":1,"src_id":320101183,"trial_step":183,"drawing":1220108},{"step":208,"content":"她怔了怔，警惕的表情中闪过一丝愧疚，却很快咬了咬牙，埋下头避开你的目光。","style":3,"log_type":1,"src_id":320101184,"trial_step":184,"drawing":1220108},{"step":209,"speaker":"海拉","content":"……还不如把我当犯人呢。","voice":["vo_trial_220101_1_184"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101185,"trial_step":185,"drawing":1220108},{"step":210,"speaker":"海拉","content":"别这么关心我，整得好像……我给你造成了什么误会。","voice":["vo_trial_220101_1_185"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101186,"trial_step":186,"drawing":1220108},{"step":211,"speaker":"海拉","content":"我们不是朋友，也不可能成为朋友，这从一开始就注定了。","voice":["vo_trial_220101_1_186"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101187,"trial_step":187,"drawing":1220108},{"step":212,"speaker":"选项","content":"可是——｜为什么？","options":["可是——","为什么？"],"style":6,"log_type":1,"src_id":320101188,"trial_step":188,"course":3,"drawing":1220108,"choices":[{"text":"可是——","goto":189},{"text":"为什么？","goto":189}]},{"step":213,"speaker":"海拉","content":"看看你的手吧，朋友从不束缚对方的自由，可你的存在就是我们最大的枷锁。","voice":["vo_trial_220101_1_188"],"voice_bank":"vo_hella_trial","style":1,"log_type":1,"src_id":320101189,"trial_step":189,"drawing":1220108},{"step":214,"content":"这是一次成功的审查，你得到了很多宝贵的信息，关于海拉的出身、她的能力、她所参与的研究，还有她对朋友的忠诚与重视。\n你甚至一度觉得，自己跟她的关系拉近了些——虽然这只是错觉。\n\n关于她所珍视的、十分可疑的朋友，你仍旧一无所知。","style":14,"background":10000,"log_type":1,"src_id":320101190,"trial_step":190,"drawing":1220108}]}