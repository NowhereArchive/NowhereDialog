{"id":400400501,"chapter_id":50016,"scene_id":51635,"steps":[{"step":1,"speaker":"嗷呜","content":"……","voice":["vo_event_400400501_1"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":2,"speaker":"嗷呜","content":"喂，笨蛋场记？","voice":["vo_event_400400501_2"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":3,"speaker":"${PlayerName}","content":"嗯？","style":2,"background":2048,"log_type":1},{"step":4,"speaker":"嗷呜","content":"我知道你说的诡兽就是星仔——是不是因为它总是调皮捣蛋，所以你才讨厌它呀？","voice":["vo_event_400400501_4"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":5,"speaker":"${PlayerName}","content":"我……","style":2,"background":2048,"log_type":1},{"step":6,"speaker":"嗷呜","content":"我知道星仔不听话，也总是淘气。是我……是我没有管好它。","voice":["vo_event_400400501_6"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":7,"content":"少女想了一下。","style":3,"background":2048,"log_type":1},{"step":8,"speaker":"嗷呜","content":"不过，不过！星仔还很小，又和家人走散了。没有人教它，它才会调皮的。","voice":["vo_event_400400501_8"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":9,"speaker":"嗷呜","content":"以后嗷呜就是它的家人啦。嗷呜会一直和它在一起，好好教育它，保护它的。","voice":["vo_event_400400501_9"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":10,"speaker":"星仔","content":"咕呜——","voice":["vo_event_400400501_10"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":11,"speaker":"嗷呜","content":"嗷呜保证，星仔绝对不会成为怪兽的。你别再生它的气了，好嘛？好嘛？","voice":["vo_event_400400501_11"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":12,"speaker":"选项","options":["我答应你","看情况而定"],"jump":[13,13],"style":6,"background":2048,"log_type":1},{"step":13,"speaker":"嗷呜","content":"那，那谢谢你！我会跟它说，不让它再跟你捣蛋了。","voice":["vo_event_400400501_14"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":14,"speaker":"嗷呜","content":"星仔，你以后不许再淘气，给笨蛋场记${PlayerName}添麻烦啦。你们都是摄制组的一员，要好好相处。","voice":["vo_event_400400501_15"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":15,"speaker":"星仔","content":"咕呜……","voice":["vo_event_400400501_16"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":16,"speaker":"嗷呜","content":"好啦，星仔已经向你道歉啦。那嗷呜就去睡觉啦，唔，好困！","voice":["vo_event_400400501_17"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":17,"content":"少女困呼呼地抱着她的小兽走远，你看着她们，开始思索自己是否真能履行这样的承诺。","style":3,"background":2048,"log_type":1}]}