{"id":1150102,"chapter_id":1150102,"scene_id":1,"steps":[{"step":1,"speaker":"？？？","content":"局长……局长？","style":1,"background":10000,"log_type":1,"src_id":250102001,"trial_step":1},{"step":2,"content":"你被一个熟悉的声音唤醒，发现自己周围一片漆黑，手脚被绳索束缚。","style":3,"background":10000,"log_type":1,"src_id":250102002,"trial_step":2},{"step":3,"options":["是维多利亚？","这里是哪里？"],"style":6,"background":10000,"log_type":1,"src_id":250102003,"trial_step":3,"course":3,"choices":[{"text":"是维多利亚？","goto":4},{"text":"这里是哪里？","goto":7}]},{"step":4,"speaker":"维多利亚","content":"局长一下就能认出我的声音呢~","style":1,"background":10000,"log_type":1,"src_id":250102004,"trial_step":4},{"step":5,"content":"维多利亚小心翼翼地压低声音，凑在你耳边轻笑一声。","style":3,"background":10000,"log_type":1,"src_id":250102005,"trial_step":5},{"step":6,"speaker":"维多利亚","content":"哼哼~放心，我把大家都支走了，不会有人找到这里的。","style":1,"background":10000,"log_type":1,"src_id":250102006,"trial_step":6,"next":[10]},{"step":7,"speaker":"维多利亚","content":"这是一个只有维多利亚知道的地方。","style":1,"background":10000,"log_type":1,"src_id":250102007,"trial_step":7},{"step":8,"content":"她小心翼翼地压低声音，凑在你耳边。","style":3,"background":10000,"log_type":1,"src_id":250102008,"trial_step":8},{"step":9,"speaker":"维多利亚","content":"放心，我把大家都支走了，不会有人找到这里的。","style":1,"background":10000,"log_type":1,"src_id":250102009,"trial_step":9,"next":[10]},{"step":10,"content":"耳边的低语带着诡异的愉悦，使你完全清醒过来。","style":3,"background":10000,"log_type":1,"src_id":250102010,"trial_step":10},{"step":11,"content":"“呲——”\n少女点亮了一盏老旧的矿灯，你借着这点微弱的灯光，终于看清了自己所处的环境——","style":3,"background":115,"log_type":1,"src_id":250102011,"trial_step":11},{"step":12,"content":"这是个地下仓库，周围摆放的纸箱上印着MBCC的标志，还有一辆菲平时用来运送货物的小推车。","style":3,"background":115,"log_type":1,"src_id":250102012,"trial_step":12},{"step":13,"options":["我们还在MBCC？"],"style":6,"background":115,"log_type":1,"src_id":250102013,"trial_step":13,"course":3,"choices":[{"text":"我们还在MBCC？","goto":14}]},{"step":14,"speaker":"维多利亚","content":"嘘——夜莺姐姐以为我逃出管理局，偷偷把你带走啦，别让她听见。","style":1,"background":115,"log_type":1,"src_id":250102014,"trial_step":14},{"step":15,"content":"你到底要做什么？","style":2,"background":115,"log_type":1,"src_id":250102015,"trial_step":15},{"step":16,"speaker":"维多利亚","content":"局长不记得了吗？你答应维多利亚的事，还没有完成呢。","style":1,"background":115,"log_type":1,"src_id":250102016,"trial_step":16},{"step":17,"options":["什么没完成的事？","我不明白你在说什么"],"style":6,"background":115,"log_type":1,"src_id":250102017,"trial_step":17,"course":3,"choices":[{"text":"什么没完成的事？","goto":18},{"text":"我不明白你在说什么","goto":18}]},{"step":18,"speaker":"维多利亚","content":"你忘了吗？祝福、枷锁、禁锢……在审查室里，你对维多利亚的爱护被人打断了，我失去了您给我的枷锁。","style":1,"background":115,"log_type":1,"src_id":250102018,"trial_step":18},{"step":19,"speaker":"维多利亚","content":"我好不容易等到夜莺姐姐放松了对我的警惕，才终于找到机会和你独处。","style":1,"background":115,"log_type":1,"src_id":250102019,"trial_step":19},{"step":20,"speaker":"维多利亚","content":"来吧，请像上次那样，拴住我吧。","style":1,"background":115,"log_type":1,"src_id":250102020,"trial_step":20},{"step":21,"content":"她向你步步逼近，你被绑在椅子上没有逃离的余地。","style":3,"background":115,"log_type":1,"src_id":250102021,"trial_step":21},{"step":22,"options":["向她解释"],"style":6,"background":115,"log_type":1,"src_id":250102022,"trial_step":22,"course":3},{"step":23,"content":"上次我用枷锁束缚你，是为了自保，跟你所谓的祝福和爱护没有丝毫关系，你别再误会了！","style":2,"background":115,"log_type":1,"src_id":250102023,"trial_step":23},{"step":24,"speaker":"维多利亚","content":"怎么会是误会呢，那分明是跟研究室里一样的感觉，控制着我，希望我能按你的想法越来越健康……我再熟悉不过了。","style":1,"background":115,"log_type":1,"src_id":250102024,"trial_step":24},{"step":25,"content":"我没有把你当随意操纵的研究对象，也给不了你想要的控制。","style":2,"background":115,"log_type":1,"src_id":250102025,"trial_step":25},{"step":26,"speaker":"维多利亚","content":"局长还是不肯吗……","style":1,"background":115,"log_type":1,"src_id":250102026,"trial_step":26},{"step":27,"content":"她似有遗憾地环视双臂，仿佛在回味枷锁留下的温度。","style":3,"background":115,"log_type":1,"src_id":250102027,"trial_step":27},{"step":28,"speaker":"维多利亚","content":"是因为局长还没有理解健康的祝福吧？","style":1,"background":115,"log_type":1,"src_id":250102028,"trial_step":28},{"step":29,"content":"我不是这个意思……维多利亚，冷静一点。你需要心理医生的帮助。","style":2,"background":115,"log_type":1,"src_id":250102029,"trial_step":29},{"step":30,"speaker":"维多利亚","content":"你怎么也说些和夜莺姐姐一样的话……呼——我会帮你理解的，等我一下。","style":1,"background":115,"log_type":1,"src_id":250102030,"trial_step":30},{"step":31,"content":"她根本不顾你的劝阻，取来了两盒药片和一小箱针筒。","style":3,"background":115,"log_type":1,"src_id":250102031,"trial_step":31},{"step":32,"speaker":"维多利亚","content":"来，张嘴——啊——","style":1,"background":115,"log_type":1,"src_id":250102032,"trial_step":32},{"step":33,"content":"你当然不愿配合，她便用力掰开你的嘴，把一整罐药片塞了进去。","style":3,"background":115,"log_type":1,"src_id":250102033,"trial_step":33},{"step":34,"content":"唔！","style":2,"background":115,"log_type":1,"src_id":250102034,"trial_step":34},{"step":35,"speaker":"维多利亚","content":"就是这样，吞咽，接受它们进入你的身体……就像维多利亚过去在研究室那样。","style":1,"background":115,"log_type":1,"src_id":250102035,"trial_step":35},{"step":36,"content":"她虔诚地捧着你的脸，如同供奉着象征希望的神像。","style":3,"background":115,"log_type":1,"src_id":250102036,"trial_step":36},{"step":37,"content":"粗糙的颗粒硬物被强制填满你的口腔，压迫着你的舌根。","style":3,"background":115,"log_type":1,"src_id":250102037,"trial_step":37},{"step":38,"speaker":"维多利亚","content":"你现在能够理解了吗？这是我全部的关心、思念和依赖，请给我枷锁吧，回应我吧——","style":1,"background":115,"log_type":1,"src_id":250102038,"trial_step":38},{"step":39,"content":"给她枷锁，你就可以逃脱这场折磨，但也无异于继续加深她错误的认知。","style":3,"background":115,"log_type":1,"src_id":250102039,"trial_step":39},{"step":40,"content":"你刚想要摇头拒绝她的请求，却因化学药品的奇怪苦味混合唾液流进咽喉，下意识将药片全都吐了出来。","style":3,"background":115,"log_type":1,"src_id":250102041,"trial_step":41},{"step":41,"content":"她轻轻拍打你的背，看似是在帮你缓解生理上的恶心。","style":3,"background":115,"log_type":1,"src_id":250102042,"trial_step":42},{"step":42,"speaker":"维多利亚","content":"吐出来吧，没关系的，我一开始也会有这种反应，慢慢习惯就好了。","style":1,"background":115,"log_type":1,"src_id":250102043,"trial_step":43},{"step":43,"content":"说着她又拆开了一盒口服液，试图倒进你口中。","style":3,"background":115,"log_type":1,"src_id":250102044,"trial_step":44},{"step":44,"content":"你尽全力躲开，挣扎时绳索在关节处磨出了血痕。","style":3,"background":115,"log_type":1,"src_id":250102045,"trial_step":45},{"step":45,"speaker":"维多利亚","content":"别闹出太大的动静，不然他们要找夜莺姐姐来阻止我了。","style":1,"background":115,"log_type":1,"src_id":250102046,"trial_step":46},{"step":46,"content":"她神色委屈，仿佛此时被绑在椅子上身处弱势的是她而不是你。","style":3,"background":115,"log_type":1,"src_id":250102048,"trial_step":48},{"step":47,"speaker":"维多利亚","content":"可是不吃药会生病的，生病了……就该打针！","style":1,"background":115,"log_type":1,"src_id":250102049,"trial_step":49},{"step":48,"content":"维多利亚比在审查室时更加喜怒无常，立刻为这个没来由的新念头行动起来，熟练地为你准备注射。","style":3,"background":115,"log_type":1,"src_id":250102050,"trial_step":50},{"step":49,"content":"吃药打针都该按照医师的建议，你这样盲目硬灌，会出人命的！","style":2,"background":115,"log_type":1,"src_id":250102052,"trial_step":52},{"step":50,"content":"你究竟什么时候能明白，你的行为直接导致了研究室众人的死亡。","style":2,"background":115,"log_type":1,"src_id":250102053,"trial_step":53},{"step":51,"speaker":"维多利亚","content":"死亡……可是哥哥姐姐亲口告诉我，他们只是去了很远的地方而已，局长在害怕什么？","style":1,"background":115,"log_type":1,"src_id":250102054,"trial_step":54},{"step":52,"content":"那只是为了能让你理解而编造的谎言！","style":2,"background":115,"log_type":1,"src_id":250102055,"trial_step":55},{"step":53,"speaker":"维多利亚","content":"局长也并没有体会过死亡，怎么就能确定死后不是去了遥远的另一个世界呢？","style":1,"background":115,"log_type":1,"src_id":250102056,"trial_step":56},{"step":54,"content":"你一时竟想不出该如何反驳。","style":3,"background":115,"log_type":1,"src_id":250102057,"trial_step":57},{"step":55,"speaker":"维多利亚","content":"死亡的话题我们可以以后再聊，今天，维多利亚只是想要得到局长的枷锁而已，别怕……","style":1,"background":115,"log_type":1,"src_id":250102058,"trial_step":58},{"step":56,"content":"她不但对“治愈的祝福”有误解，对生命的理解也有偏差。再僵持下去，恐怕就没有“以后”了。","style":3,"background":115,"log_type":1,"src_id":250102059,"trial_step":59},{"step":57,"content":"正当你思考如何说服维多利亚时，屋外的走廊里传来夜莺的声音。","style":3,"background":115,"log_type":1,"src_id":250102060,"trial_step":60},{"step":58,"speaker":"夜莺","content":"这里都搜查过了吗？","style":11,"background":115,"log_type":1,"src_id":250102061,"trial_step":61},{"step":59,"content":"维多利亚的脸色愈发苍白，她握住你被捆住的双手，卑微地发出央求。","style":3,"background":115,"log_type":1,"src_id":250102062,"trial_step":62},{"step":60,"speaker":"维多利亚","content":"他们要来了，来不及了局长，给我枷锁吧，好不好？","style":1,"background":115,"log_type":1,"src_id":250102063,"trial_step":63},{"step":61,"speaker":"维多利亚","content":"最纯粹、最炙热、对维多利亚的祝福……","style":1,"background":115,"log_type":1,"src_id":250102064,"trial_step":64},{"step":62,"content":"夜莺！我和维多利亚在医疗仓库！你快……唔！","style":2,"background":115,"log_type":1,"src_id":250102066,"trial_step":66},{"step":63,"content":"维多利亚用医用绷带缠住你的嘴，遏制你的求救。","style":3,"background":115,"log_type":1,"src_id":250102067,"trial_step":67},{"step":64,"speaker":"维多利亚","content":"为什么要让他们阻止我？是维多利亚哪里做得还不好吗？为什么不愿意像研究室的大家那样对待我？","style":1,"background":115,"log_type":1,"src_id":250102068,"trial_step":68},{"step":65,"speaker":"维多利亚","content":"……咳咳咳……药，针筒，这里还有很多……你想要什么我都可以给你！我只有一个要求……","style":1,"background":115,"log_type":1,"src_id":250102069,"trial_step":69},{"step":66,"content":"为了按住你，维多利亚几乎耗尽了所有体力，本就虚弱的呼吸逐渐急促。","style":3,"background":115,"log_type":1,"src_id":250102071,"trial_step":71},{"step":67,"speaker":"维多利亚","content":"枷锁……只要捆住我，一切就结束了！","style":1,"background":115,"log_type":1,"src_id":250102072,"trial_step":72},{"step":68,"speaker":"维多利亚","content":"我只是想要再次感受过去的祝福和爱护而已！咳咳咳咳……","style":1,"background":115,"log_type":1,"src_id":250102073,"trial_step":73},{"step":69,"speaker":"夜莺","content":"快！在这边！","style":11,"background":115,"log_type":1,"src_id":250102074,"trial_step":74},{"step":70,"content":"维多利亚扶住面罩艰难地换气，转身用结晶破坏并封死了仓库的门锁。","style":3,"background":115,"log_type":1,"src_id":250102075,"trial_step":75},{"step":71,"speaker":"维多利亚","content":"没有人……没有人可以再打扰我们！","style":1,"background":115,"log_type":1,"src_id":250102076,"trial_step":76},{"step":72,"content":"你用力往侧面倾倒，整个人连带着椅子重重地摔在地上。","style":3,"background":115,"log_type":1,"src_id":250102078,"trial_step":78},{"step":73,"speaker":"夜莺","content":"就是这儿，准备爆破！","style":11,"background":115,"log_type":1,"src_id":250102079,"trial_step":79},{"step":74,"speaker":"维多利亚","content":"我明白了，局长还是没有从维多利亚身上看到痊愈的希望。","style":1,"background":115,"log_type":1,"src_id":250102080,"trial_step":80},{"step":75,"speaker":"夜莺","content":"三——","style":11,"background":115,"log_type":1,"src_id":250102081,"trial_step":81},{"step":76,"speaker":"维多利亚","content":"我得证明自己凝血的力量，才能继续得到你的祝福……","style":1,"background":115,"log_type":1,"src_id":250102082,"trial_step":82},{"step":77,"speaker":"夜莺","content":"二——","style":11,"background":115,"log_type":1,"src_id":250102083,"trial_step":83},{"step":78,"content":"维多利亚深情望向你，手中生长出结晶，对准了你的胸膛——","style":3,"background":115,"log_type":1,"src_id":250102084,"trial_step":84},{"step":79,"speaker":"夜莺","content":"一！","style":11,"background":10000,"log_type":1,"src_id":250102085,"trial_step":85,"next":[95]},{"step":80,"content":"暗红色光芒一时间充满整个房间。","style":3,"background":115,"log_type":1,"src_id":250102086,"trial_step":86},{"step":81,"speaker":"维多利亚","content":"是的，就是这样……是枷锁……是被束缚的感觉……","style":1,"background":115,"log_type":1,"src_id":250102087,"trial_step":87},{"step":82,"content":"锁链的纹路将她层层包裹，她无法再对你造成伤害，你也终于从折磨中脱身，仓库里突然安静下来。","style":3,"background":115,"log_type":1,"src_id":250102088,"trial_step":88},{"step":83,"content":"如愿以偿的维多利亚温和微笑着，跪坐在地上拥抱身上的红光，与施虐时的少女判若两人。","style":3,"background":115,"log_type":1,"src_id":250102089,"trial_step":89},{"step":84,"content":"警卫的脚步声靠近、夜莺下令、仓库大门被强行撞开，警卫将她拖走……这一切似乎都与她无关。","style":3,"background":115,"log_type":1,"src_id":250102090,"trial_step":90},{"step":85,"content":"她也丝毫没有松开拥抱枷锁的双臂，直到被关入禁闭室，都还保持着对外界信息的屏蔽，独自轻声低喃。","style":3,"background":115,"log_type":1,"src_id":250102091,"trial_step":91},{"step":86,"speaker":"维多利亚","content":"不会……再孤单了……","style":1,"background":115,"log_type":1,"src_id":250102092,"trial_step":92},{"step":87,"speaker":"？？？","content":"不成熟的心理年龄，却有过丰富的扭曲经历，多有意思的病人……我早跟艾恩说过，该把她送到我这儿来。","style":1,"background":10000,"log_type":1,"src_id":250102095,"trial_step":95},{"step":88,"content":"禁闭室外，戴金丝眼镜的女人把玩着手里的怀表，夜莺与她交谈时的态度并不友善。","style":3,"background":107,"log_type":1,"src_id":250102096,"trial_step":96},{"step":89,"speaker":"夜莺","content":"卡米利安，我不是请你来说废话的。","style":1,"background":107,"log_type":1,"src_id":250102097,"trial_step":97},{"step":90,"speaker":"卡米利安","content":"玩笑话而已，夜莺小姐还真是冷淡啊。","style":1,"background":107,"log_type":1,"src_id":250102098,"trial_step":98},{"step":91,"options":["你们在聊什么？"],"style":6,"background":107,"log_type":1,"src_id":250102099,"trial_step":99,"course":3,"choices":[{"text":"你们在聊什么？","goto":100},{"text":null,"goto":100}]},{"step":92,"speaker":"夜莺","content":"局长？您应该留在房间里休息才对。","style":1,"background":107,"log_type":1,"src_id":250102100,"trial_step":100},{"step":93,"content":"我没事。","style":2,"background":107,"log_type":1,"src_id":250102101,"trial_step":101},{"step":94,"content":"你虽嘴上这么说，但距离被绑架才过去了几个小时，咽喉处恶心的异物感还没完全褪去。","style":3,"background":107,"log_type":1,"src_id":250102102,"trial_step":102},{"step":95,"speaker":"卡米利安","content":"连狄斯最杰出的心理医生都来了，怎么会让局长阁下有事呢~","style":1,"background":107,"log_type":1,"src_id":250102103,"trial_step":103},{"step":96,"speaker":"夜莺","content":"你只是根据命令在维多利亚刺伤局长前将她催眠了而已，没有你，我们当时也能救下局长。","style":1,"background":107,"log_type":1,"src_id":250102104,"trial_step":104},{"step":97,"speaker":"卡米利安","content":"听夜莺小姐的意思，是不需要我帮你们治疗维多利亚了吗？","style":1,"background":107,"log_type":1,"src_id":250102105,"trial_step":105},{"step":98,"options":["你能治好维多利亚？"],"style":6,"background":107,"log_type":1,"src_id":250102106,"trial_step":106,"course":3,"choices":[{"text":"你能治好维多利亚？","goto":107},{"text":null,"goto":107}]},{"step":99,"speaker":"卡米利安","content":"准确来说不是我，是你。","style":1,"background":107,"log_type":1,"src_id":250102107,"trial_step":107},{"step":100,"content":"什么意思？","style":2,"background":107,"log_type":1,"src_id":250102108,"trial_step":108},{"step":101,"speaker":"卡米利安","content":"局长现在有两个选择，协助我影响她的潜意识观念，或者让她永远保持沉睡。","style":1,"background":107,"log_type":1,"src_id":250102109,"trial_step":109},{"step":102,"options":["难道没有第三种选择吗？"],"style":6,"background":107,"log_type":1,"src_id":