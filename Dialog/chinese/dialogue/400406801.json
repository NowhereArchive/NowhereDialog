{"id":400406801,"chapter_id":50016,"scene_id":51609,"steps":[{"step":1,"speaker":"【vlog（新闻）更新时间】","content":"N.F.113年\n1月25日 晚上7点","style":9,"background":2041,"log_type":1},{"step":2,"speaker":"新闻","content":"狄斯城各地出现异常现象，东西区皆确认受到影响，市议会提醒公民外出注意安全。","voice":["vo_event_400406801_2"],"voice_bank":"vo_event_04068","style":11,"background":2041,"log_type":1},{"step":3,"speaker":"新闻","content":"如遇到从未出现的可疑物件、反重力现象、或蓝色异常生物，请立刻远离，并拨打FAC城市专线，xxxx-xx-xxxx……","voice":["vo_event_400406801_3"],"voice_bank":"vo_event_04068","style":11,"background":2041,"log_type":1},{"step":4,"speaker":"新闻","content":"下一则新闻，继续聚焦狄斯卡盛典。狄莱坞电影学院院长召开发布会，向社会各界公开典礼安全策略，此举广受赞誉。","voice":["vo_event_400406801_4"],"voice_bank":"vo_event_04068","style":11,"background":2041,"log_type":1},{"step":5,"speaker":"新闻","content":"狄斯卡筹备工作一切顺利，院长承诺典礼将在2天后如期召开，众多明星陆续入住狄莱坞各大酒店，媒体对黛伦导演的到来十分期待……","voice":["vo_event_400406801_5"],"voice_bank":"vo_event_04068","style":11,"background":2051,"log_type":1},{"step":6,"speaker":"嗷呜","content":"嗯咳！全员集合——！嗷呜有非常伟大的事情要宣布！","voice":["vo_event_400406801_6"],"voice_bank":"vo_event_04068","style":1,"background":2051,"log_type":1},{"step":7,"speaker":"嗷呜","content":"就在这里，就是现在，看到，听到——即是三生有幸！","voice":["vo_event_400406801_7"],"voice_bank":"vo_event_04068","style":1,"background":2051,"log_type":1},{"step":8,"speaker":"嗷呜","content":"狄斯城首次公开舞狮表演来喽——！","voice":["vo_event_400406801_8"],"voice_bank":"vo_event_04068","style":1,"background":4086,"log_type":1},{"step":9,"speaker":"琳","content":"呀——！！","voice":["vo_event_400406801_9"],"voice_bank":"vo_event_04068","style":1,"background":4086,"log_type":1},{"step":10,"speaker":"洛芙","content":"哈哈哈哈你吓到琳啦！","voice":["vo_event_400406801_10"],"voice_bank":"vo_event_04068","style":1,"background":4086,"log_type":1},{"step":11,"speaker":"琳","content":"不、不是的，很好看，我只是有点吃惊……","voice":["vo_event_400406801_11"],"voice_bank":"vo_event_04068","style":1,"background":4086,"log_type":1},{"step":12,"speaker":"黛丝","content":"要把导演叫起来吗？导演，导演——？","voice":["vo_event_400406801_12"],"voice_bank":"vo_event_04068","style":1,"background":4086,"log_type":1},{"step":13,"speaker":"嗷呜","content":"${PlayerName}也一起啦！快点快点！","voice":["vo_event_400406801_13"],"voice_bank":"vo_event_04068","style":1,"background":4086,"log_type":1}]}