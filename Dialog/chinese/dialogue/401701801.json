{"id":401701801,"chapter_id":21000103,"scene_id":307,"steps":[{"step":1,"content":"漫长的旅途终于抵达了终点。","style":3,"background":10000,"log_type":1},{"step":2,"content":"你们找到了空隙，凭借改造过的高速机甲突破重围，甩开了那些怪物。现在，时空风暴就在你们面前。","style":3,"background":2180,"log_type":1},{"step":3,"options":["进入时空风暴"],"jump":[4],"style":6,"background":2180,"log_type":1},{"step":4,"content":"穿越时空风暴的感觉，不知为何，是那样的漫长。","style":3,"background":10003,"log_type":1},{"step":5,"content":"你们在荒原之上驰骋，一直向前……漫长的旅程仿佛越过了无尽的跨度，从过去到未来，万物在你们身旁飞速后退。","style":3,"background":2066,"log_type":1},{"step":6,"content":"就连时间也追不上你们。未来就在眼前。","style":3,"background":2066,"log_type":1},{"step":8,"content":"不知何处而来的攻击，剧烈的颠簸几乎要将你掀翻。似乎有什么东西嵌入了机甲的深处。","style":3,"background":2180,"log_type":1},{"step":9,"speaker":"瓦尼菈","content":"怎么可能……什么东西能追上我的……","voice":["vo_event_401701801_9"],"voice_bank":"vo_event_17018","style":1,"background":2180,"log_type":1},{"step":10,"content":"你抬起头，巨大的阴影与机甲重叠了在一起。","style":3,"background":2180,"log_type":1},{"step":11,"content":"布满锈蚀和伤痕的金属，腐朽到难以辨别颜色的机身……还有在那之上矗立的，黑暗的、空洞的、不祥的人影。","style":3,"background":2180,"log_type":1},{"step":12,"content":"在同一个时空中多次现身的怪物，永远捡不完的物资……不祥的风暴扭曲了时空，将过去和未来交汇于一处。","style":3,"background":2180,"log_type":1},{"step":13,"content":"你终于知晓了眼前人影的身份。","style":3,"background":2180,"log_type":1},{"step":14,"options":["瓦尼菈？"],"jump":[15],"style":6,"background":2180,"log_type":1},{"step":15,"content":"眼前所见颠覆了你所知的一切，你感到脑中如有轰鸣，不敢置信地转头看向身边的人。","style":3,"background":2180,"log_type":1},{"step":16,"content":"同样的身形，驾驶着相同的机甲。不同的是，你身边的那个瓦尼菈，身形已然变得虚幻。","style":3,"background":2180,"log_type":1},{"step":17,"speaker":"瓦尼菈","content":"你……是……","voice":["vo_event_401701801_17"],"voice_bank":"vo_event_17018","style":1,"background":2180,"log_type":1},{"step":18,"content":"阴影彻底覆盖了机甲，绝望的未来吞噬了过去。","style":3,"background":2180,"log_type":1},{"step":19,"content":"两台机甲，两个瓦尼菈，逐渐重叠，合而为一。","style":3,"background":2180,"log_type":1}]}