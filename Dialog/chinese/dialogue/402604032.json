{"id":402604032,"chapter_id":50070,"scene_id":57025,"steps":[{"step":1,"content":"【转馒头第一视角】【躲在漆黑的厕所/储物间】【晚上2点】","style":18,"background":2263,"log_type":1},{"step":2,"speaker":"馒头","content":"……我是▌▌▌▌公司5732游戏开发组新人，馒头。如果以后有人能听到这段留言，麻烦转告……我也不知道能告诉谁。","voice":["vo_event_402604032_02"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":3,"speaker":"馒头","content":"最近项目震荡严重，我也担惊受怕，因为担心同事瑞思，想回来看看到底发生了什么事。","voice":["vo_event_402604032_03"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":4,"speaker":"馒头","content":"……结果我发现了更加不得了的东西……你们听……","voice":["vo_event_402604032_04"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":6,"speaker":"涂色嘎","content":"好的收到马上改……好的收到马上改……好的收到马上改……","voice":["vo_event_402604032_06"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":7,"speaker":"代码嘎","content":"97%98%99%……99.3……99.6……啊啊啊怎么打包又失败了啊啊啊啊！","voice":["vo_event_402604032_07"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":8,"speaker":"摇滚嘎","content":"—啊————嘎———啊——","voice":["vo_event_402604032_08"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":9,"speaker":"馒头","content":"听见了吗？会议室里，我的领导们正在发出奇怪的声音，刚刚看了一眼，满屋6个人都像中了邪一样，表情狰狞扭曲特别恐怖。唔啊！","voice":["vo_event_402604032_09"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":10,"speaker":"馒头","content":"他们已经睡了9小时了，我、我知道我该立刻报警，……可手机没有信号，我现在又真的没勇气出去——噫！！","voice":["vo_event_402604032_10"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":11,"content":"砰——！！！","style":3,"background":2263,"log_type":1},{"step":12,"content":"（门打开，白屏，老大的剪影出现）","style":18,"background":2263,"log_type":1},{"step":13,"speaker":"大佬嘎","content":"呼…………你……你……","voice":["vo_event_402604032_14"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":14,"speaker":"馒头","content":"……老大？我不是故意躲在这儿的，我是组里实习生，我叫……","voice":["vo_event_402604032_15"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":15,"speaker":"大佬嘎","content":"内鬼……是你吗……？是不是……啊？！！","voice":["vo_event_402604032_16"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":16,"speaker":"馒头","content":"啊啊啊啊啊啊救命啊！！！","voice":["vo_event_402604032_17"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":17,"content":"（击飞的声音）","style":18,"background":2263,"log_type":1},{"step":18,"speaker":"大佬嘎","content":"嘎——？！","voice":["vo_event_402604032_19"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":19,"content":"（老大消失，画外音传来乒铃乓啷的战斗声）","style":18,"background":2263,"log_type":1},{"step":20,"speaker":"馒头","content":"……我还活着……发生什么事了？老大呢？","voice":["vo_event_402604032_21"],"voice_bank":"vo_event_26403","style":1,"background":2263,"log_type":1},{"step":21,"content":"馒头偷偷钻了出去。","style":3,"background":2148,"log_type":1},{"step":22,"content":"她看到的是更惊异的场面。空无一人的办公室里，桌子板凳齐飞，变成一片火海，烟雾警报狂响。","style":3,"background":2148,"log_type":1},{"step":23,"content":"就在这时，原本没有信号的手机突然震动起来。","style":3,"background":2148,"log_type":1},{"step":24,"speaker":"馒头","content":"手机有消息……？为什么？？","voice":["vo_event_402604032_27"],"voice_bank":"vo_event_26403","style":1,"background":2148,"log_type":1},{"step":25,"content":"滴——新▌书消息提示。","style":3,"background":2148,"log_type":1},{"step":26,"speaker":"RiSe","content":"还不走？危险！","style":1,"background":2148,"log_type":1},{"step":27,"content":"陌生的账号发来消息，但点开来却显示出一连串闪烁着彩色字符的历史聊天记录，向上翻——","style":3,"background":2148,"log_type":1},{"step":28,"speaker":"馒头","content":"……瑞思？","voice":["vo_event_402604032_30"],"voice_bank":"vo_event_26403","style":1,"background":2148,"log_type":1}]}