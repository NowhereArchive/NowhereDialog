{"id":404320704,"chapter_id":50088,"scene_id":58822,"steps":[{"step":2,"speaker":"马洛","content":"哼，谢了。","voice":["vo_event_404320704_01"],"voice_bank":"vo_event_43207","style":1,"background":2506,"log_type":1},{"step":3,"content":"他一手一把冲锋枪，另外几把全都挂在了身上，满身煞气地走了出去。","style":3,"background":2506,"log_type":1},{"step":4,"content":"很快你就听到了狂放的枪声，伴随着惨叫从廊下传来。","style":3,"background":2506,"log_type":1},{"step":5,"speaker":"希露妲","content":"……不用担心，马洛会处理好的。","voice":["vo_event_404320704_04"],"voice_bank":"vo_event_43207","style":1,"background":2506,"log_type":1},{"step":6,"content":"希露妲动作利落地换好了弹夹。","style":3,"background":2506,"log_type":1},{"step":7,"speaker":"希露妲","content":"这些守卫，包括谢恩在内都是由情报部上层从城邦总部调派来的。","voice":["vo_event_404320704_06"],"voice_bank":"vo_event_43207","style":1,"background":2506,"log_type":1},{"step":8,"speaker":"希露妲","content":"至于他们背后是什么人，审一审就知道了。","voice":["vo_event_404320704_07"],"voice_bank":"vo_event_43207","style":1,"background":2506,"log_type":1},{"step":9,"speaker":"希露妲","content":"走吧，我们先把他带到拷问室去。","voice":["vo_event_404320704_08"],"voice_bank":"vo_event_43207","style":1,"background":2506,"log_type":1}]}