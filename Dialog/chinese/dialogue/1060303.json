{"id":1060303,"chapter_id":1060303,"scene_id":1,"steps":[{"step":1,"speaker":"格雷格","content":"……手脚都被绑住了……哦，对了，是那些穿盔甲的人把我控制住了……","voice":["vo_trial_60303_1_1"],"voice_bank":"vo_cab_trial","style":1,"background":10006,"log_type":1,"src_id":160303001,"trial_step":1},{"step":2,"speaker":"格雷格","content":"……FAC对吗……想起来了……我在医院，康兰也在……","voice":["vo_trial_60303_1_2"],"voice_bank":"vo_cab_trial","style":1,"background":10006,"log_type":1,"src_id":160303002,"trial_step":2},{"step":3,"speaker":"格雷格","content":"卡门奈特呢……怎么还不出现……","voice":["vo_trial_60303_1_3"],"voice_bank":"vo_cab_trial","style":1,"background":10006,"log_type":1,"src_id":160303003,"trial_step":3},{"step":4,"speaker":"格雷格","content":"动弹不得的感觉，太熟悉了，还以为……我们又被她……","voice":["vo_trial_60303_1_4"],"voice_bank":"vo_cab_trial","style":1,"background":10006,"log_type":1,"src_id":160303004,"trial_step":4},{"step":5,"speaker":"格雷格","content":"那么晚才下班吗，晚饭想吃点什么？今天在邻居那里交换到了一些食材，做你最喜欢的焗蘑菇怎么样？","voice":["vo_trial_60303_1_5"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303006,"trial_step":6},{"step":6,"speaker":"康兰","content":"焗蘑菇的事等会儿再说，一个好消息一个坏消息，你要先听哪个？","voice":["vo_trial_60303_1_6"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303007,"trial_step":7},{"step":7,"speaker":"格雷格","content":"嗯，坏消息？","voice":["vo_trial_60303_1_7"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303008,"trial_step":8},{"step":8,"speaker":"康兰","content":"坏消息是，雷佛酒店的经理说他们暂时不需要新的厨师了。","voice":["vo_trial_60303_1_8"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303009,"trial_step":9},{"step":9,"speaker":"格雷格","content":"不用想也知道，又是因为我的辛迪加出身吧？","voice":["vo_trial_60303_1_9"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303010,"trial_step":10},{"step":10,"speaker":"康兰","content":"哎，这已经是这个月的第几家餐厅了……","voice":["vo_trial_60303_1_10"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303011,"trial_step":11},{"step":11,"speaker":"格雷格","content":"……十三还是十四，记不清啦。","voice":["vo_trial_60303_1_11"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303012,"trial_step":12},{"step":12,"speaker":"康兰","content":"辛迪加有狂厄有黑帮，又不意味着我们也有暴力倾向。","voice":["vo_trial_60303_1_12"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303013,"trial_step":13},{"step":13,"speaker":"格雷格","content":"没关系，再慢慢找吧，辛迪加人在新城不容易谋生也是预料中的事。高级餐厅不需要我的话，我每天像现在这样找些路边馆子打打下手也好。","voice":["vo_trial_60303_1_13"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303014,"trial_step":14},{"step":14,"speaker":"格雷格","content":"新城那么大，那么繁华，总有能让我们安家的地方的。","voice":["vo_trial_60303_1_14"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303015,"trial_step":15},{"step":15,"speaker":"康兰","content":"那怎么行！你可是蓝缎学院的高材生，在小饭馆打杂也太浪费了，一定会有办法的！","voice":["vo_trial_60303_1_15"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303016,"trial_step":16},{"step":16,"speaker":"康兰","content":"对了，你试试这个！","voice":["vo_trial_60303_1_16"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303017,"trial_step":17},{"step":17,"content":"康兰从包里掏出一张纸质表格，小心地将有些卷边的四角压平。","style":3,"background":1034,"log_type":1,"src_id":160303018,"trial_step":18},{"step":18,"speaker":"格雷格","content":"“卡门奈特·芙兰克私人厨师选拔信息登记表”？这就是你准备的好消息吧。","voice":["vo_trial_60303_1_17"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303019,"trial_step":19},{"step":19,"speaker":"格雷格","content":"芙兰克，不就是你工作的那户人家吗？","voice":["vo_trial_60303_1_18"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303020,"trial_step":20},{"step":20,"speaker":"康兰","content":"我也是听管家说起才知道的，我们大小姐对食物特别挑剔，一直没有选到满意的厨师呢！","voice":["vo_trial_60303_1_19"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303021,"trial_step":21},{"step":21,"speaker":"康兰","content":"你那么有天赋，可是能让新城蓝缎破格录取的人，拿出点自信，去试试嘛！","voice":["vo_trial_60303_1_20"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303022,"trial_step":22},{"step":22,"speaker":"格雷格","content":"有钱人家的大小姐啊，恐怕会比一般酒店还要苛刻。","voice":["vo_trial_60303_1_21"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303023,"trial_step":23},{"step":23,"speaker":"康兰","content":"这个我倒是不清楚了，但她选拔厨师只注重味道，不问出身，应该……","voice":["vo_trial_60303_1_22"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303024,"trial_step":24},{"step":24,"speaker":"康兰","content":"是个好人吧。","voice":["vo_trial_60303_1_23"],"voice_bank":"vo_cab_trial","style":1,"background":1034,"log_type":1,"src_id":160303025,"trial_step":25},{"step":25,"speaker":"康兰","content":"您……刚刚说什么？","voice":["vo_trial_60303_1_24"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303027,"trial_step":27},{"step":26,"speaker":"卡门奈特","content":"787号路口的味道。","voice":["vo_trial_60303_1_25"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303028,"trial_step":28},{"step":27,"speaker":"卡门奈特","content":"这个叫格雷格的厨师做的……姑且称为菜的东西，非常奇妙，它的味道和我路过787号路口时闻到的味道一样，我还是第一次品尝这样的东西。","voice":["vo_trial_60303_1_26"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303029,"trial_step":29},{"step":28,"speaker":"康兰","content":"787号路口……您说的不会是那个，垃圾处理厂吧。","voice":["vo_trial_60303_1_27"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303030,"trial_step":30},{"step":29,"speaker":"康兰","content":"哈，这……怎么会呢，这是格雷格最拿手的菜了！一定是和别的东西串味了，您再试一试！","voice":["vo_trial_60303_1_28"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303031,"trial_step":31},{"step":30,"speaker":"康兰","content":"这可是倾注了情感和梦想做的料理……","voice":["vo_trial_60303_1_29"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303032,"trial_step":32},{"step":31,"speaker":"卡门奈特","content":"情感和梦想？抱歉，我并没有品尝出这些内容。","voice":["vo_trial_60303_1_30"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303033,"trial_step":33},{"step":32,"speaker":"卡门奈特","content":"又或者说……你指的情感和梦想，就是787号路口的味道？","voice":["vo_trial_60303_1_31"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303034,"trial_step":34},{"step":33,"speaker":"管家","content":"康兰！你居然敢砸主人的器具！！","voice":["vo_trial_60303_1_32"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303036,"trial_step":36},{"step":34,"speaker":"管家","content":"我好心帮你引荐，居然做出这么无礼的事情！","voice":["vo_trial_60303_1_33"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303037,"trial_step":37},{"step":35,"speaker":"康兰","content":"我……我不是故意的……可这是格雷格全部的心血！就算您不喜欢，也不能……","voice":["vo_trial_60303_1_34"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303038,"trial_step":38},{"step":36,"speaker":"康兰","content":"说它是垃圾！","voice":["vo_trial_60303_1_35"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303039,"trial_step":39},{"step":37,"speaker":"管家","content":"够了！你们辛迪加人果然都是一群控制不住自己的恶徒！当初就不该招你进来！","voice":["vo_trial_60303_1_36"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303040,"trial_step":40},{"step":38,"speaker":"管家","content":"赶紧出去，这里不需要你了！","voice":["vo_trial_60303_1_37"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303041,"trial_step":41},{"step":39,"speaker":"康兰","content":"我为自己刚刚的行为道歉……但卡门奈特小姐还没有真的尝过这道菜品！这太不尊重人了！","voice":["vo_trial_60303_1_38"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303042,"trial_step":42},{"step":40,"content":"康兰看着地上的碎片，和餐桌上仅被刮走一些酱汁的菜品，不顾管家的拖拽，仍坚定地站在桌前。","style":3,"background":1045,"log_type":1,"src_id":160303043,"trial_step":43},{"step":41,"content":"她知道现在的自己或许有些无理取闹，但她比任何一个人都相信，格雷格的料理不应该得到这样的评价。","style":3,"background":1045,"log_type":1,"src_id":160303044,"trial_step":44},{"step":42,"speaker":"卡门奈特","content":"你叫……康兰，是吗？","voice":["vo_trial_60303_1_39"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303045,"trial_step":45},{"step":43,"speaker":"卡门奈特","content":"很好听的名字，和你的气味一样，很香甜。","voice":["vo_trial_60303_1_40"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303046,"trial_step":46},{"step":44,"speaker":"康兰","content":"香、甜？","voice":["vo_trial_60303_1_41"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303047,"trial_step":47},{"step":45,"speaker":"卡门奈特","content":"管家，让她留下吧，我对她——很感兴趣。","voice":["vo_trial_60303_1_42"],"voice_bank":"vo_cab_trial","style":1,"background":1045,"log_type":1,"src_id":160303048,"trial_step":48},{"step":46,"speaker":"格雷格","content":"这是……康兰？她为什么会在这里……怎么会、变成这幅样子……","voice":["vo_trial_60303_1_43"],"voice_bank":"vo_cab_trial","style":1,"background":932,"log_type":1,"src_id":160303050,"trial_step":50},{"step":47,"speaker":"格雷格","content":"你究竟对她做了什么！！！","voice":["vo_trial_60303_1_44"],"voice_bank":"vo_cab_trial","style":1,"background":932,"log_type":1,"src_id":160303051,"trial_step":51},{"step":48,"speaker":"卡门奈特","content":"只是把她当作难得一遇的宝物，臻享她的灵魂。","voice":["vo_trial_60303_1_45"],"voice_bank":"vo_cab_trial","style":1,"background":932,"log_type":1,"src_id":160303052,"trial_step":52},{"step":49,"speaker":"格雷格","content":"疯子！","voice":["vo_trial_60303_1_46"],"voice_bank":"vo_cab_trial","style":1,"background":932,"log_type":1,"src_id":160303053,"trial_step":53},{"step":50,"content":"格雷格粗暴地推开卡门奈特，拼了命想要解救康兰。但卡门奈特却丝毫不为他的“冒犯”生气。","style":3,"background":932,"log_type":1,"src_id":160303054,"trial_step":54},{"step":51,"speaker":"卡门奈特","content":"我记得你，格雷格，是个厨师。","voice":["vo_trial_60303_1_47"],"voice_bank":"vo_cab_trial","style":1,"background":932,"log_type":1,"src_id":160303055,"trial_step":55},