{"id":401002101,"chapter_id":50025,"scene_id":52512,"steps":[{"step":1,"speaker":"女佣","content":"罗睺士官，瑟琳小姐请您到宅里做客。她说，申请已经被通过了。","voice":["vo_event_401002101_1"],"voice_bank":"vo_event_10021","style":1,"background":2101,"log_type":1},{"step":2,"speaker":"女佣","content":"蓝雨即将到来，瑟琳小姐担心那对您有不好的影响。","voice":["vo_event_401002101_2"],"voice_bank":"vo_event_10021","style":1,"background":2101,"log_type":1},{"step":3,"speaker":"罗睺","content":"知道了。替我谢谢你的雇主。","voice":["vo_event_401002101_3"],"voice_bank":"vo_event_10021","style":1,"background":2101,"log_type":1},{"step":4,"speaker":"女佣","content":"您可以亲自跟她说。瑟琳小姐并不像人们常说的那样有距离感，她也期待与您再次见面。","voice":["vo_event_401002101_4"],"voice_bank":"vo_event_10021","style":1,"background":2101,"log_type":1},{"step":5,"speaker":"女佣","content":"罗睺小姐，您会保护她的吧？","voice":["vo_event_401002101_5"],"voice_bank":"vo_event_10021","style":1,"background":2101,"log_type":1},{"step":6,"content":"罗睺看向不远处的洋房，那是最接近她目标的地方。","style":3,"background":2101,"log_type":1},{"step":7,"speaker":"罗睺","content":"……当然。","voice":["vo_event_401002101_7"],"voice_bank":"vo_event_10021","style":1,"background":2101,"log_type":1}]}