{"id":16142,"chapter_id":16,"scene_id":1608,"steps":[{"step":1,"speaker":"女子的声音","content":"捡到什么了吗？","voice":["vo_cgplot_16142001"],"voice_bank":"vo_cgplot_1614","style":1,"background":2420,"log_type":1},{"step":2,"speaker":"男人的声音","content":"半个活人，看模样不是狄斯的。您要看看吗？","voice":["vo_cgplot_16142002"],"voice_bank":"vo_cgplot_1614","style":1,"background":2420,"log_type":1},{"step":3,"content":"一阵弹药过后，沙虫咆哮着丢下几具尸体 ，既不靠近也不远离。而那艘商船上，几条舷梯甩下，有人下来把沙虫选定的猎物抬起，架了上去。","style":3,"background":2420,"log_type":1},{"step":4,"speaker":"西比拉","content":"我不是叛徒……不是……","voice":["vo_cgplot_16142004"],"voice_bank":"vo_cgplot_1614","style":1,"background":2420,"log_type":1},{"step":5,"speaker":"西比拉","content":"……我的朋友……我的朋友们……","voice":["vo_cgplot_16142005"],"voice_bank":"vo_cgplot_1614","style":1,"background":2420,"log_type":1},{"step":6,"speaker":"西比拉","content":"救救他们……","voice":["vo_cgplot_16142006"],"voice_bank":"vo_cgplot_1614","style":1,"background":2420,"log_type":1},{"step":7,"content":"有谁挑起了她的下巴。","style":3,"background":2420,"log_type":1},{"step":8,"speaker":"女子的声音","content":"这口音……你想去哪儿？救谁？能听清我说话吗？听得懂吗？","voice":["vo_cgplot_16142008"],"voice_bank":"vo_cgplot_1614","style":1,"background":2420,"log_type":1},{"step":9,"speaker":"西比拉","content":"坎贝尔……坎贝尔他们……","voice":["vo_cgplot_16142009"],"voice_bank":"vo_cgplot_1614","style":1,"background":2420,"log_type":1},{"step":10,"speaker":"女子的声音","content":"哦……原来也是要去万国会的。那刚好顺路，我捎你一程。","voice":["vo_cgplot_16142010"],"voice_bank":"vo_cgplot_1614","style":1,"background":2420,"log_type":1},{"step":11,"content":"她转身向船员。","style":3,"background":2420,"log_type":1},{"step":12,"speaker":"女子的声音","content":"抓紧，我们已经迟到了。","voice":["vo_cgplot_16142012"],"voice_bank":"vo_cgplot_1614","style":1,"background":2420,"log_type":1}]}