{"id":4051,"chapter_id":4,"scene_id":405,"steps":[{"step":1,"speaker":"海拉","content":"恶……那是什么东西，感觉好恶心…………","voice":["vo_cgplot_4051001"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":2,"speaker":"海拉","content":"坑底下好像也有什么在动…………","voice":["vo_cgplot_4051002"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":3,"options":["遗产就在那个石坛里"],"jump":[4],"style":6,"background":402,"log_type":1},{"step":4,"speaker":"海拉","content":"太可疑了吧？那个石坛就这么光明正大地放在正中间，生怕别人不知道里面装着遗产似的。","voice":["vo_cgplot_4051004"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":5,"speaker":"赫卡蒂","content":"有可能存在其他保险手段，像是机关，或者埋伏。","voice":["vo_cgplot_4051005"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":6,"options":["也可能这是必要的存放方式"],"jump":[7],"style":6,"background":402,"log_type":1},{"step":7,"content":"在这个距离下俯视，并不能看清石坛上的所有细节。但你隐约能看到石坛上刻着某种怪异的纹路。","style":3,"background":402,"log_type":1},{"step":8,"content":"你没有看到R的身影。","style":3,"background":402,"log_type":1},{"step":9,"content":"而卓娅还在洞窟的另一头。也许遇到了阻碍，她行进缓慢。但与你们的距离仍在不断缩短。","style":3,"background":402,"log_type":1},{"step":10,"options":["走吧，但要小心"],"jump":[11],"style":6,"background":402,"log_type":1},{"step":11,"speaker":"赫卡蒂","content":"明白。死役还有活化的可能，局长，跟在我身后……","voice":["vo_cgplot_4051011"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":12,"speaker":"赫卡蒂","content":"——！！小心！","voice":["vo_cgplot_4051012"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":13,"content":"身后空气突然被斩开，一把巨斧旋转着飞来，梦魇冲上去，却只勉强改变了一点轨道。","style":3,"background":402,"log_type":1},{"step":14,"content":"巨斧越过你们头顶，重重砸在地上，劈进土里，拦住你们的去路。","style":3,"background":402,"log_type":1},{"step":15,"speaker":"海拉","content":"是谁？！——唔！！","voice":["vo_cgplot_4051015"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":16,"content":"她还来不及回头。一个黑影直冲而来，一拳把海拉打飞好几米，再借着惯性刹停在巨斧前。","style":3,"background":402,"log_type":1},{"step":17,"speaker":"赫卡蒂","content":"！这力量——禁闭者！","voice":["vo_cgplot_4051017"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":18,"speaker":"海拉","content":"是斧王！","voice":["vo_cgplot_4051018"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":19,"content":"黑影缓缓起身，单手提起沉重的巨斧，架在肩头，回身面对你们，满是杀意。","style":3,"background":402,"log_type":1},{"step":20,"speaker":"？？","content":"一夫当关，说的就是这种情况吧……咳咳，不愧是我。","voice":["vo_cgplot_4051020"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":21,"speaker":"海拉","content":"斧王！？","voice":["vo_cgplot_4051021"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":22,"speaker":"海拉","content":"——怎么是个小矮子？她才几岁？！","voice":["vo_cgplot_4051022"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":23,"speaker":"？？","content":"正视你的对手！我是军团战士<color=#fb9259>赫罗</color>，是送你们上路的人。","voice":["vo_cgplot_4051023"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1},{"step":24,"speaker":"赫罗","content":"遗产是军团的东西，记住这一点，然后去死吧！","voice":["vo_cgplot_4051024"],"voice_bank":"vo_cgplot_04","style":1,"background":402,"log_type":1}]}