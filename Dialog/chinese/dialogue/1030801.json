{"id":1030801,"chapter_id":1030801,"scene_id":1,"steps":[{"step":1,"speaker":"模糊的声音","content":"……","voice":["vo_trial_30801_1_1"],"voice_bank":"vo_zero_trial","style":1,"background":10006,"log_type":1,"src_id":130801002,"trial_step":2},{"step":2,"speaker":"模糊的声音","content":"……你…………","voice":["vo_trial_30801_1_2"],"voice_bank":"vo_zero_trial","style":1,"background":10006,"log_type":1,"src_id":130801003,"trial_step":3},{"step":3,"content":"意识回笼，你察觉到自己正身处一片纯白色的空间。时间和空间的概念都被打乱，只有不远处那个同样纯白的身影逐渐清晰。","style":3,"background":10006,"log_type":1,"src_id":130801004,"trial_step":4},{"step":4,"options":["你……在说什么？","你……是谁？"],"style":6,"background":10006,"log_type":1,"src_id":130801005,"trial_step":5,"course":3,"choices":[{"text":"你……在说什么？","goto":6},{"text":"你……是谁？","goto":6}]},{"step":5,"content":"你努力睁大双眼，却仍看不清面前这个近乎破碎的身影，听不清她的声音。","style":3,"background":10006,"log_type":1,"src_id":130801006,"trial_step":6},{"step":6,"content":"她向你靠近，似乎在笑，笑容熟悉得令你有些心悸。","style":3,"background":4318,"log_type":1,"src_id":130801007,"trial_step":7},{"step":7,"speaker":"梦中的少女","content":"……过来……我的…………","voice":["vo_trial_30801_1_9"],"voice_bank":"vo_zero_trial","style":1,"background":4318,"log_type":1,"src_id":130801008,"trial_step":8},{"step":8,"content":"听到你的问题，她也做出了回应，嘴唇翕动，似乎在说些什么。可你无论如何也听不清。","style":3,"background":4318,"log_type":1,"src_id":130801009,"trial_step":9},{"step":9,"options":["向她伸手"],"style":6,"background":4318,"log_type":1,"src_id":130801010,"trial_step":10,"course":3,"choices":[{"text":"向她伸手","goto":11}]},{"step":10,"content":"白色的影子若有感应，也向你伸出手，就在你们指尖即将触碰的前一秒——","style":3,"background":4318,"log_type":1,"src_id":130801011,"trial_step":11},{"step":11,"content":"【直接切换场景，局长办公室。空场，屏幕震动，闹铃声】","style":18,"background":1017,"log_type":1,"src_id":130801012,"trial_step":12},{"step":12,"content":"再睁开眼，模糊的视线中只有一个发亮的物体。你的终端此刻正不断发出尖锐的铃声，聒噪得令人头痛。","style":3,"background":1017,"log_type":1,"src_id":130801013,"trial_step":13},{"step":13,"options":["关掉闹铃"],"style":6,"background":1017,"log_type":1,"src_id":130801014,"trial_step":14,"course":3,"choices":[{"text":"关掉闹铃","goto":15}]},{"step":14,"content":"你趴回桌面，眼前却又浮现出梦里那个看不清面容的熟悉身影。这不是她第一次出现。","style":3,"background":1017,"log_type":1,"src_id":130801015,"trial_step":15},{"step":15,"content":"不知为何，你最近开始被同一个梦缠绕。那个白色的影子反复出现在你梦中、靠近，又随着你的惊醒消散。","style":3,"background":1017,"log_type":1,"src_id":130801016,"trial_step":16},{"step":16,"content":"为什么？狂厄影响？哪次行动留下后遗症？还是……","style":3,"background":1017,"log_type":1,"src_id":130801017,"trial_step":17},{"step":17,"speaker":"%u","content":"……","style":2,"background":1017,"log_type":1,"src_id":130801018,"trial_step":18},{"step":18,"content":"你忘记的事情太多，闷头苦想没有意义，不如打起精神面对接下来的工作。","style":3,"background":1017,"log_type":1,"src_id":130801019,"trial_step":19},{"step":19,"content":"【空场，闹铃again】","style":18,"background":1017,"log_type":1,"src_id":130801020,"trial_step":20},{"step":20,"content":"声音再次响起。这次是敲门声。","style":3,"background":1017,"log_type":1,"src_id":130801021,"trial_step":21},{"step":21,"options":["起身开门"],"style":6,"background":1017,"log_type":1,"src_id":130801022,"trial_step":22,"course":3,"choices":[{"text":"起身开门","goto":23}]},{"step":22,"speaker":"夜莺","content":"局长，您现在方便吗？","voice":["vo_trial_30801_1_25"],"voice_bank":"vo_zero_trial","style":1,"background":1017,"log_type":1,"src_id":130801023,"trial_step":23},{"step":23,"speaker":"夜莺","content":"最近几日，一位名为<color=#fb9259>000</color>的黑客在网络中极度活跃。她制作的病毒会强行侵入系统，掠夺操控权，危险性极高。","voice":["vo_trial_30801_1_27"],"voice_bank":"vo_zero_trial","style":1,"background":1017,"log_type":1,"src_id":130801024,"trial_step":24},{"step":24,"speaker":"夜莺","content":"最关键的是……我们在病毒上检测到了狂厄。局长，对方是禁闭者，与暗网联系密切，需要紧密监视。","voice":["vo_trial_30801_1_28"],"voice_bank":"vo_zero_trial","style":1,"background":1017,"log_type":1,"src_id":130801025,"trial_step":25},{"step":25,"options":["又和暗网有关？"],"style":6,"background":1017,"log_type":1,"src_id":130801026,"trial_step":26,"course":3,"choices":[{"text":"又和暗网有关？","goto":27}]},{"step":26,"speaker":"夜莺","content":"是的。所以这次需要您亲自审问。","voice":["vo_trial_30801_1_30"],"voice_bank":"vo_zero_trial","style":1,"background":1017,"log_type":1,"src_id":130801027,"trial_step":27},{"step":27,"speaker":"夜莺","content":"目前该禁闭者已被抓获，当下已经送达管理局。局长，审讯时请注意安全。","voice":["vo_trial_30801_1_31"],"voice_bank":"vo_zero_trial","style":1,"background":1017,"log_type":1,"src_id":130801028,"trial_step":28},{"step":28,"speaker":"夜莺","content":"以及……","voice":["vo_trial_30801_1_32"],"voice_bank":"vo_zero_trial","style":1,"background":1017,"log_type":1,"src_id":130801029,"trial_step":29},{"step":29,"speaker":"夜莺","content":"局长，您的声音听起来有些疲惫。工作之余，也请记得好好休息。","voice":["vo_trial_30801_1_34"],"voice_bank":"vo_zero_trial","style":1,"background":1017,"log_type":1,"src_id":130801030,"trial_step":30},{"step":30,"options":["我会注意的","倒下前我会先把活干完的"],"style":6,"background":1017,"log_type":1,"src_id":130801031,"trial_step":31,"course":3,"choices":[{"text":"我会注意的","goto":32},{"text":"倒下前我会先把活干完的","goto":32}]},{"step":31,"speaker":"%u","content":"接下来……就去会会这位棘手的客人吧。","style":2,"background":1017,"log_type":1,"src_id":130801032,"trial_step":32},{"step":32,"content":"——面对眼前的少女，你怔住了。","style":3,"log_type":1,"src_id":130801037,"trial_step":37,"drawing":1030800},{"step":33,"content":"这并不是她长得有多特别，事实上，她看上去并没有那么突出，不过是个穿着花哨的新城少女罢了。","style":3,"log_type":1,"src_id":130801038,"trial_step":38,"drawing":1030800},{"step":34,"content":"与其说是怪异，不如说是一种强烈的既视感——你似乎在哪里见过她。","style":3,"log_type":1,"src_id":130801039,"trial_step":39,"drawing":1030800},{"step":35,"speaker":"000","content":"嗨~你到的好慢，我等你很久了。","voice":["vo_trial_30801_1_42"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801040,"trial_step":40,"drawing":1030800},{"step":36,"options":["我们之前见过吗？","你好"],"style":6,"log_type":1,"src_id":130801041,"trial_step":41,"course":3,"drawing":1030800,"choices":[{"text":"我们之前见过吗？","goto":42},{"text":"你好","goto":45}]},{"step":37,"speaker":"000","content":"当然啦！我已经隔着网线偷偷观察了你好几个月了——不过线下见面应该还是第一次。","voice":["vo_trial_30801_1_45"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801042,"trial_step":42,"drawing":1030801},{"step":38,"speaker":"000","content":"有印象吗？我可是救了你好几次呢。","voice":["vo_trial_30801_1_46"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801043,"trial_step":43,"drawing":1030801},{"step":39,"content":"带猫耳发饰的少女向你眨眨眼，意有所指。","style":3,"log_type":1,"src_id":130801044,"trial_step":44,"drawing":1030800},{"step":40,"speaker":"%u","content":"你是……","style":2,"log_type":1,"src_id":130801045,"trial_step":45,"drawing":1030800},{"step":41,"options":["给安吉尔发委托的人","极乐岛上的猫咪船长"],"style":6,"log_type":1,"src_id":130801046,"trial_step":46,"course":3,"drawing":1030800,"choices":[{"text":"给安吉尔发委托的人","goto":47},{"text":"极乐岛上的猫咪船长","goto":47}]},{"step":42,"speaker":"000","content":"bingo~","voice":["vo_trial_30801_1_49"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801047,"trial_step":47,"drawing":1030800},{"step":43,"speaker":"000","content":"初次见面，你可以叫我000，从今以后就是归MBCC管的禁闭者啦。","voice":["vo_trial_30801_1_50"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801048,"trial_step":48,"drawing":1030800},{"step":44,"speaker":"000","content":"哎呀，没想到你们情报科的人那么厉害，只是留了个小破绽，下一秒就找到我的藏身地了。","voice":["vo_trial_30801_1_53"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801049,"trial_step":49,"drawing":1030803},{"step":45,"speaker":"000","content":"这么说来，我之前挂在网上的那些“小彩蛋”也被你们破解了不少，真厉害。可惜，我没带奖品，只好口头表扬一下了~","voice":["vo_trial_30801_1_54"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801050,"trial_step":50,"drawing":1030800},{"step":46,"content":"你注视着面前的少女：从你进来后，她的视线仅在你身上停留了几秒，就又转开，兴致勃勃地观察室内其他布置。","style":3,"log_type":1,"src_id":130801051,"trial_step":51,"drawing":1030800},{"step":47,"content":"既视感越发强烈。这场对话似乎曾发生过一次，但你对此毫无记忆，脑中一片晕眩。","style":3,"log_type":1,"src_id":130801052,"trial_step":52,"drawing":1030800},{"step":48,"content":"突然的声响，是000在你面前打了个响指。","style":1,"log_type":1,"src_id":130801054,"trial_step":54,"drawing":1030800},{"step":49,"speaker":"000","content":"终于看够了？记得赶紧问问题呀，我还等着赶紧出去选个好床位呢。","voice":["vo_trial_30801_1_57"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801055,"trial_step":55,"drawing":1030800},{"step":50,"content":"你意识到自己已经盯了她太久，久到少女已经转头又看回你。","style":3,"log_type":1,"src_id":130801056,"trial_step":56,"drawing":1030800},{"step":51,"content":"她的催促让你的脑袋变得清醒了一些。强压下心头异样的既视感，你开始正式对话。","style":3,"log_type":1,"src_id":130801057,"trial_step":57,"drawing":1030800},{"step":52,"speaker":"%u","content":"……初次见面，禁闭者000。","style":2,"log_type":1,"src_id":130801058,"trial_step":58,"drawing":1030800},{"step":53,"speaker":"%u","content":"希望你能配合这场审查。关于你，我的确有不少问题要问。","style":2,"log_type":1,"src_id":130801059,"trial_step":59,"drawing":1030800},{"step":54,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":60,"course":6,"drawing":1030800},{"step":55,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":60,"course":6,"drawing":1030800},{"step":56,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":60,"course":6,"drawing":1030800},{"step":57,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":60,"course":6,"drawing":1030800},{"step":58,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":60,"course":6,"drawing":1030800},{"step":59,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":60,"course":6,"drawing":1030800},{"step":60,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":60,"course":6,"drawing":1030800},{"step":61,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":60,"course":6,"drawing":1030800},{"step":62,"speaker":"%u","content":"自114年7月起，狄斯网络中出现了一系列恶意破坏行为。经网络安全中心调查，这些破坏都是由同一种极为隐蔽的病毒数据造成的。","style":2,"log_type":1,"src_id":130801061,"trial_step":61,"drawing":1030800},{"step":63,"speaker":"%u","content":"7月4日，议员克洛格·鲁昂最先报案，声称自己的终端被攻击，信息泄露，遭到了勒索。是你做的吗？","style":2,"log_type":1,"src_id":130801062,"trial_step":62,"drawing":1030800},{"step":64,"speaker":"000","content":"对啊。","voice":["vo_trial_30801_1_65"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801063,"trial_step":63,"drawing":1030800},{"step":65,"speaker":"000","content":"说起来，本来都已经钱货两讫了，我连后台都没来得及退出去呢，他就先报警了——堂堂大议员，要不要脸啊？","voice":["vo_trial_30801_1_66"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801064,"trial_step":64,"drawing":1030801},{"step":66,"speaker":"%u","content":"……所以你就在第五大道的公共广告屏上播放了他和助理出轨的视频？","style":2,"log_type":1,"src_id":130801065,"trial_step":65,"drawing":1030801},{"step":67,"speaker":"000","content":"没错！只可惜，马上就要播到最精彩的地方，却让管理员把电源拔了，真扫兴。","voice":["vo_trial_30801_1_68"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801066,"trial_step":66,"drawing":1030800},{"step":68,"content":"少女的表情语气没有丝毫负罪感，似乎只是单纯地为视频没有播完感到可惜。","style":3,"log_type":1,"src_id":130801067,"trial_step":67,"drawing":1030800},{"step":69,"speaker":"%u","content":"还有，半月前幻影娱乐的官网被人骇入，首页被篡改为了一张……嗯，系统自带画图软件绘制的简笔画。","style":2,"log_type":1,"src_id":130801068,"trial_step":68,"drawing":1030800},{"step":70,"content":"实际上，用简笔画来形容甚至有些保守。这幅画完全就是没有经历过美术教育的学龄前儿童水平。","style":3,"log_type":1,"src_id":130801069,"trial_step":69,"drawing":1030800},{"step":71,"speaker":"%u","content":"画上的内容是两只黄色的鸭子在……姑且说它们是在互殴吧。这幅画在幻影娱乐官网首页待了近3个小时，在此期间，其订阅会员都无法访问官网的其他内容。","style":2,"log_type":1,"src_id":130801070,"trial_step":70,"drawing":1030800},{"step":72,"speaker":"000","content":"没错没错，也是我干的~","voice":["vo_trial_30801_1_74"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801071,"trial_step":71,"drawing":1030802},{"step":73,"speaker":"000","content":"毫无营养的偶像肥皂剧，总之就是两个人经历一大堆狗血的事情，最后幸福地生活在了一起，哪有我的画来得刺激？","voice":["vo_trial_30801_1_75"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801072,"trial_step":72,"drawing":1030800},{"step":74,"speaker":"000","content":"你应该感谢我为新城人节省了他们生命中宝贵的三个小时时间。","voice":["vo_trial_30801_1_76"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801073,"trial_step":73,"drawing":1030800},{"step":75,"content":"少女的胡言乱语搭配上她理直气壮的语气让你差点笑了出来。","style":3,"log_type":1,"src_id":130801074,"trial_step":74,"drawing":1030800},{"step":76,"content":"卷宗上记录的“罪行”乱七八糟。继续往下看：劫持狄斯广播电台信号，连续播放了7小时的《极乐梦屿》……事情不大不小，几乎都是玩闹性质的恶作剧，看不出明确的行动目的。","style":3,"log_type":1,"src_id":130801075,"trial_step":75,"drawing":1030800},{"step":77,"options":["那你的目的是？"],"style":6,"log_type":1,"src_id":130801076,"trial_step":76,"course":3,"drawing":1030800,"choices":[{"text":"那你的目的是？","goto":77}]},{"step":78,"speaker":"000","content":"唔……为了真理正义与世间公道？","voice":["vo_trial_30801_1_81"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801077,"trial_step":77,"drawing":1030803},{"step":79,"content":"少女眨眨眼睛，姿势浮夸，怎么看都是一副不正经的样子。","style":3,"log_type":1,"src_id":130801078,"trial_step":78,"drawing":1030800},{"step":80,"speaker":"000","content":"好吧，其实我白天虽然只是个随处可见的普通女孩，但到了夜晚就会化身新城的电子义警——神谕少女！","voice":["vo_trial_30801_1_83"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801079,"trial_step":79,"drawing":1030802},{"step":81,"speaker":"000","content":"既然你已经知道了我的身份，那就趁早放了我吧。毕竟我老跟你们新城治安局合作，也算是自己人~","voice":["vo_trial_30801_1_84"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801080,"trial_step":80,"drawing":1030802},{"step":82,"content":"你知道这个所谓“神谕少女”的名字，在一本狄斯城畅销的超级英雄漫画刊物上。000的姿势则是这个角色的招牌动作。","style":3,"log_type":1,"src_id":130801081,"trial_step":81,"drawing":1030802},{"step":83,"options":["MBCC可困不住神谕少女"],"style":6,"log_type":1,"src_id":130801082,"trial_step":82,"course":3,"drawing":1030800,"choices":[{"text":"MBCC可困不住神谕少女","goto":83}]},{"step":84,"speaker":"%u","content":"最多困住一些半夜不睡觉偷跑出来捣乱的野猫。而且……","style":2,"log_type":1,"src_id":130801083,"trial_step":83,"drawing":1030800},{"step":85,"speaker":"%u","content":"神谕少女可不会偷跑到人家屋顶上播限制级照片。","style":2,"log_type":1,"src_id":130801084,"trial_step":84,"drawing":1030800},{"step":86,"speaker":"000","content":"咦，这个梗不好玩吗？","voice":["vo_trial_30801_1_87"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":1