130801097,"trial_step":97,"drawing":1030800},{"step":99,"content":"管理局的档案中确实记录了她的信息，但你在意的并非这些。","style":3,"log_type":1,"src_id":130801098,"trial_step":98,"drawing":1030800},{"step":100,"options":["说说你的过去吧"],"style":6,"log_type":1,"src_id":130801099,"trial_step":99,"course":3,"drawing":1030800,"choices":[{"text":"说说你的过去吧","goto":100}]},{"step":101,"speaker":"%u","content":"MBCC从资料库中抽调了你的个人档案。000、暗网黑客，这些都只是你的代号和伪装。","style":2,"log_type":1,"src_id":130801100,"trial_step":100,"drawing":1030800},{"step":102,"speaker":"%u","content":"N.F.96年出生于新城，在父母任职的高校中长大，并早早在网络技术方面展现出了极高天赋，被该高校破格录取……","style":2,"log_type":1,"src_id":130801101,"trial_step":101,"drawing":1030800},{"step":103,"speaker":"%u","content":"但在108年，你的父母在一场事故中丧生。你作为孤儿被收养，就此下落不明。官方的记录到此为止，直到今年，你以黑客000的身份再次现身。","style":2,"log_type":1,"src_id":130801102,"trial_step":102,"drawing":1030800},{"step":104,"speaker":"%u","content":"你失踪的那几年，到底都发生了什么？","style":2,"log_type":1,"src_id":130801103,"trial_step":103,"drawing":1030800},{"step":105,"content":"空气突然沉默。在你面前，000脸上的笑容慢慢变小，直到消失。","style":3,"log_type":1,"src_id":130801104,"trial_step":104,"drawing":1030800},{"step":106,"speaker":"000","content":"哎，这儿的技术员果然很厉害，这都查到了。","voice":["vo_trial_30801_1_106"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801105,"trial_step":105,"drawing":1030800},{"step":107,"speaker":"000","content":"想先猜猜吗？失去父母的幼小少女，带着令人艳羡的天赋，掉入狄斯这个大染缸……她会被什么人盯上？为了活下去又会做出怎样的选择？","voice":["vo_trial_30801_1_107"],"voice_bank":"vo_zero_trial","style":1,"log_type":1,"src_id":130801106,"trial_step":106,"drawing":1030800},{"step":108,"content":"话语沉重，但000的表情仍旧戏谑轻佻。她不像是再诉说过往，反而更像是——","style":3,"log_type":1,"src_id":130801107,"trial_step":107,"drawing":1030800},{"step":109,"options":["在隐瞒什么东西"],"style":6,"log_type":1,"src_id":130801108,"trial_step":108,"course":3,"drawing":1030800,"choices":[{"text":"在隐瞒什么东西","goto":109}]},{"step":110,"content":"既视感再度翻涌。你模糊记忆中突然闪过一幅画面，是某人破碎的身躯，和她离开你冲出去战斗的背影。","style":3,"log_type":1,"src_id":130801109,"trial_step":109,"dr