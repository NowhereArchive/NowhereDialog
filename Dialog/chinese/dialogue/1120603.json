{"id":1120603,"chapter_id":1120603,"scene_id":1,"steps":[{"step":1,"speaker":"行动人员","content":"局长，这边行动顺利，杰克·那佩尔的四名帮凶已全部抓获。","style":1,"background":10000,"log_type":1,"src_id":220603001,"trial_step":1},{"step":2,"content":"嗯。我也找到他本人了。","style":2,"background":10000,"log_type":1,"src_id":220603002,"trial_step":2},{"step":3,"speaker":"行动人员","content":"您需要增援吗？","style":1,"background":10000,"log_type":1,"src_id":220603003,"trial_step":3},{"step":4,"content":"我能解决。","style":2,"background":10000,"log_type":1,"src_id":220603004,"trial_step":4},{"step":5,"speaker":"行动人员","content":"收到。","style":1,"background":10000,"log_type":1,"src_id":220603005,"trial_step":5},{"step":6,"content":"你掐断通讯。天台的风很猛烈。你理了理头发，向前走去。","style":3,"background":1048,"log_type":1,"src_id":220603006,"trial_step":6},{"step":7,"content":"杰克·那佩尔就在那里。","style":3,"background":1048,"log_type":1,"src_id":220603007,"trial_step":7},{"step":8,"speaker":"杰克·那佩尔","content":"新城的夜景很美，不是吗？","style":1,"background":1048,"log_type":1,"src_id":220603008,"trial_step":8},{"step":9,"content":"的确，你可以趁现在多看几眼。","style":2,"background":1048,"log_type":1,"src_id":220603009,"trial_step":9},{"step":10,"content":"很快你就会进入暗无天日的监狱，或许再也看不到它了。","style":2,"background":1048,"log_type":1,"src_id":220603010,"trial_step":10},{"step":11,"speaker":"杰克·那佩尔","content":"哦——是吗？","style":1,"background":1048,"log_type":1,"src_id":220603011,"trial_step":11},{"step":12,"speaker":"杰克·那佩尔","content":"我建议你不要再向前了。","style":1,"background":1048,"log_type":1,"src_id":220603012,"trial_step":12},{"step":13,"content":"杰克转过身，手上握着一个小小的棒状按钮。","style":3,"background":1048,"log_type":1,"src_id":220603013,"trial_step":13},{"step":14,"speaker":"杰克·那佩尔","content":"最新款的远程引爆器，电磁干扰也拿它没办法，厉害吧。","style":1,"background":1048,"log_type":1,"src_id":220603014,"trial_step":14},{"step":15,"options":["停下脚步"],"style":6,"background":1048,"log_type":1,"src_id":220603015,"trial_step":15,"course":3,"choices":[{"text":"停下脚步","goto":16}]},{"step":16,"speaker":"杰克·那佩尔","content":"乖，这样才对。","style":1,"background":1048,"log_type":1,"src_id":220603016,"trial_step":16},{"step":17,"speaker":"杰克·那佩尔","content":"哟，这不是莓丝小姐吗？感谢你的鼎力相助，我最近玩得很开心。","style":1,"background":1048,"log_type":1,"src_id":220603017,"trial_step":17},{"step":18,"speaker":"莓丝","content":"不客气。","style":1,"background":1048,"log_type":1,"src_id":220603018,"trial_step":18},{"step":19,"speaker":"杰克·那佩尔","content":"早就听说MBCC的局长是个狠角色，上任几个月就干了好几票大事儿。","style":1,"background":1048,"log_type":1,"src_id":220603019,"trial_step":19},{"step":20,"speaker":"杰克·那佩尔","content":"不过你是对付禁闭者和狂厄的吧，怎么有空来找我这种守法市民的？","style":1,"background":1048,"log_type":1,"src_id":220603020,"trial_step":20},{"step":21,"content":"你？守法市民？","style":2,"background":1048,"log_type":1,"src_id":220603021,"trial_step":21},{"step":22,"speaker":"杰克·那佩尔","content":"我老爷子在新城很有地位……","style":1,"background":1048,"log_type":1,"src_id":220603022,"trial_step":22},{"step":23,"speaker":"杰克·那佩尔","content":"我是他唯一的儿子，所以我当然是守法市民。","style":1,"background":1048,"log_type":1,"src_id":220603023,"trial_step":23},{"step":24,"content":"那你知道自己在做什么吗？","style":2,"background":1048,"log_type":1,"src_id":220603024,"trial_step":24},{"step":25,"speaker":"杰克·那佩尔","content":"找乐子啊。","style":1,"background":1048,"log_type":1,"src_id":220603025,"trial_step":25},{"step":26,"content":"找乐子？！","style":2,"background":1048,"log_type":1,"src_id":220603026,"trial_step":26},{"step":27,"speaker":"杰克·那佩尔","content":"你能理解那种头上有个成功老爹的痛苦吗？","style":1,"background":1048,"log_type":1,"src_id":220603027,"trial_step":27},{"step":28,"speaker":"杰克·那佩尔","content":"太无聊了啊。","style":1,"background":1048,"log_type":1,"src_id":220603028,"trial_step":28},{"step":29,"speaker":"杰克·那佩尔","content":"钱，奢侈品，能玩的早就都玩腻了。除此之外的反而都不能做。","style":1,"background":1048,"log_type":1,"src_id":220603029,"trial_step":29},{"step":30,"speaker":"杰克·那佩尔","content":"有时候我真羡慕辛迪加那些烂崽啊。可惜柳生没了，唯一的乐子人狩就这么断了。","style":1,"background":1048,"log_type":1,"src_id":220603030,"trial_step":30},{"step":31,"speaker":"莓丝","content":"你这是歧视！我可是辛迪加来的。","style":1,"background":1048,"log_type":1,"src_id":220603031,"trial_step":31},{"step":32,"speaker":"杰克·那佩尔","content":"随便吧，哪儿的人都一样。这座城市早就烂透了。","style":1,"background":1048,"log_type":1,"src_id":220603032,"trial_step":32},{"step":33,"speaker":"杰克·那佩尔","content":"活着太无聊太累了，所以我只好苦中作乐啊。","style":1,"background":1048,"log_type":1,"src_id":220603033,"trial_step":33},{"step":34,"speaker":"杰克·那佩尔","content":"然后我就找到了新玩具。","style":1,"background":1048,"log_type":1,"src_id":220603034,"trial_step":34},{"step":35,"content":"杰克看向地面上如蚂蚁般爬行的人。","style":3,"background":1048,"log_type":1,"src_id":220603035,"trial_step":35},{"step":36,"speaker":"杰克·那佩尔","content":"又弱小，又天真。以为自己在新城就能高枕无忧，整天浑浑噩噩就知道傻乐，让我恶心得想吐。","style":1,"background":1048,"log_type":1,"src_id":220603036,"trial_step":36},{"step":37,"speaker":"杰克·那佩尔","content":"所以看他们走投无路时的绝望表情，听他们挣扎哭嚎时的声音才会这么有趣……","style":1,"background":1048,"log_type":1,"src_id":220603037,"trial_step":37},{"step":38,"speaker":"杰克·那佩尔","content":"莓丝小姐一定也是这么觉得的，对吧？否则你不会替我做那个的。","style":1,"background":1048,"log_type":1,"src_id":220603038,"trial_step":38},{"step":39,"speaker":"莓丝","content":"当然不是啊。","style":1,"background":1048,"log_type":1,"src_id":220603039,"trial_step":39},{"step":40,"speaker":"莓丝","content":"啧，“找乐子……”，真没品。","style":1,"background":1048,"log_type":1,"src_id":220603040,"trial_step":40},{"step":41,"content":"好，既然你不认同他的做法，那么——","style":2,"background":1048,"log_type":1,"src_id":220603041,"trial_step":41},{"step":42,"options":["要求莓丝阻止嫌犯"],"style":6,"background":1048,"log_type":1,"src_id":220603042,"trial_step":42,"course":3,"choices":[{"text":"要求莓丝阻止嫌犯","goto":43}]},{"step":43,"content":"阻止他，立刻。","style":2,"background":1048,"log_type":1,"src_id":220603043,"trial_step":43},{"step":44,"content":"那是你的“作品”，你也知道他的计划。以你的风格，一定会留下后手。","style":2,"background":1048,"log_type":1,"src_id":220603044,"trial_step":44},{"step":45,"content":"无效化他的武器，或者干脆直接制服他。","style":2,"background":1048,"log_type":1,"src_id":220603045,"trial_step":45},{"step":46,"content":"我不管你用什么方法，总之，在他按下那个按钮之前，阻止他。","style":2,"background":1048,"log_type":1,"src_id":220603046,"trial_step":46},{"step":47,"content":"莓丝歪过头，饶有兴致地看着你的脸，一字一顿地说道——","style":3,"background":1048,"log_type":1,"src_id":220603047,"trial_step":47},{"step":48,"speaker":"莓丝","content":"我 不 要。","style":1,"background":1048,"log_type":1,"src_id":220603048,"trial_step":48},{"step":49,"speaker":"莓丝","content":"你凭什么觉得我就能阻止他呢？我只是个锻造师而已诶。","style":1,"background":1048,"log_type":1,"src_id":220603049,"trial_step":49},{"step":50,"content":"你是禁闭者。","style":2,"background":1048,"log_type":1,"src_id":220603050,"trial_step":50},{"step":51,"speaker":"莓丝","content":"禁闭者就有义务阻止人伤害别人吗？","style":1,"background":1048,"log_type":1,"src_id":220603051,"trial_step":51},{"step":52,"content":"不，那是我的义务。","style":2,"background":1048,"log_type":1,"src_id":220603052,"trial_step":52},{"step":53,"content":"但你是我的禁闭者。","style":2,"background":1048,"log_type":1,"src_id":220603053,"trial_step":53},{"step":54,"speaker":"莓丝","content":"呵呵。","style":1,"background":1048,"log_type":1,"src_id":220603054,"trial_step":54},{"step":55,"speaker":"杰克·那佩尔","content":"喂！","style":1,"background":1048,"log_type":1,"src_id":220603055,"trial_step":55},{"step":56,"content":"你们对杰克的无视似乎激起了他的愤怒。","style":3,"background":1048,"log_type":1,"src_id":220603056,"trial_step":56},{"step":57,"speaker":"杰克·那佩尔","content":"没有人教过你，说话的时候要看着别人的眼睛吗？","style":1,"background":1048,"log_type":1,"src_id":220603057,"trial_step":57},{"step":58,"speaker":"莓丝","content":"你的话太多了。","style":1,"background":1048,"log_type":1,"src_id":220603058,"trial_step":58},{"step":59,"content":"莓丝并没有看向他，而是依旧死死盯着你的眼睛。","style":3,"background":1048,"log_type":1,"src_id":220603059,"trial_step":59},{"step":60,"speaker":"杰克·那佩尔","content":"你……你说什么？","style":1,"background":1048,"log_type":1,"src_id":220603060,"trial_step":60},{"step":61,"speaker":"莓丝","content":"闭嘴，乖乖待在那里就好，不要打断我和局长。","style":1,"background":1048,"log_type":1,"src_id":220603061,"trial_step":61},{"step":62,"speaker":"杰克·那佩尔","content":"你……你就不怕我按下按钮吗？！这可是你的作品，你知道它的厉害！","style":1,"background":1048,"log_type":1,"src_id":220603062,"trial_step":62},{"step":63,"speaker":"莓丝","content":"对，是我的作品，所以它现在已经是废铁了。","style":1,"background":1048,"log_type":1,"src_id":220603063,"trial_step":63},{"step":64,"speaker":"莓丝","content":"不信的话，按一下试试？","style":1,"background":1048,"log_type":1,"src_id":220603064,"trial_step":64},{"step":65,"content":"杰克的脸色变得极其糟糕，他看了看手中的按钮，又看了看你们，却始终没有勇气按下去。","style":3,"background":1048,"log_type":1,"src_id":220603065,"trial_step":65},{"step":66,"speaker":"莓丝","content":"哈哈哈哈哈哈哈哈哈！骗你的懦夫，我才没办法无效化那玩意儿。","style":1,"background":1048,"log_type":1,"src_id":220603066,"trial_step":66},{"step":67,"speaker":"莓丝","content":"真是个废物，离了你爸就什么都做不了。","style":1,"background":1048,"log_type":1,"src_id":220603067,"trial_step":67},{"step":68,"speaker":"莓丝","content":"平时你还能求你爸帮你脱罪，但这次来的居然是MBCC的局长，事情大条咯，你爸兜不住啦。","style":1,"background":1048,"log_type":1,"src_id":220603068,"trial_step":68},{"step":69,"speaker":"莓丝","content":"你现在连这个按钮都不敢按了——毕竟不按这玩意儿还能当个威慑，按了立马就被抓了对不对啊？","style":1,"background":1048,"log_type":1,"src_id":220603069,"trial_step":69},{"step":70,"speaker":"莓丝","content":"呜呜呜真可怜，脱离了亲爱爸爸的掌控之后连瞎胡闹的勇气都没了……","style":1,"background":1048,"log_type":1,"src_id":220603070,"trial_step":70},{"step":71,"content":"够了！","style":2,"background":1048,"log_type":1,"src_id":220603071,"trial_step":71},{"step":72,"content":"杰克的表情越来越狰狞。不能再让莓丝这样刺激下去了。","style":3,"background":1048,"log_type":1,"src_id":220603072,"trial_step":72},{"step":73,"speaker":"莓丝","content":"哦？局长你也想嘲笑他两句吗？还是说你觉得我说得太过分了，想要帮帮他？","style":1,"background":1048,"log_type":1,"src_id":220603073,"trial_step":73},{"step":74,"content":"别再浪费时间了，阻止他。","style":2,"background":1048,"log_type":1,"src_id":220603074,"trial_step":74},{"step":75,"speaker":"莓丝","content":"我不要。","style":1,"background":1048,"log_type":1,"src_id":220603075,"trial_step":75},{"step":76,"content":"莓丝的脸上堆满了恼人的笑意。","style":3,"background":1048,"log_type":1,"src_id":220603076,"trial_step":76},{"step":77,"speaker":"莓丝","content":"他的恶意可就要破茧了，这时候收割太浪费啦。","style":1,"background":1048,"log_type":1,"src_id":220603077,"trial_step":77},{"step":78,"speaker":"莓丝","content":"或者……你也可以试试用枷锁来命令我……你不是最擅长这样摆布禁闭者吗？","style":1,"background":1048,"log_type":1,"src_id":220603078,"trial_step":78},{"step":79,"content":"虽然我平时会尽量避免使用，但恐怕现在没有别的选择了。","style":2,"background":1048,"log_type":1,"src_id":220603079,"trial_step":79},{"step":80,"speaker":"莓丝","content":"真的吗真的吗？","style":1,"background":1048,"log_type":1,"src_id":220603080,"trial_step":80},{"step":81,"content":"莓丝的眼中迸发出喜悦的光。","style":3,"background":1048,"log_type":1,"src_id":220603081,"trial_step":81},{"step":82,"speaker":"莓丝","content":"不许抵赖，快来吧！","style":1,"background":1048,"log_type":1,"src_id":220603082,"trial_step":82},{"step":83,"options":["使用枷锁"],"style":6,"background":1048,"log_type":1,"src_id":220603083,"trial_step":83,"course":3,"choices":[{"text":"使用枷锁","goto":84}]},{"step":84,"content":"红色的光芒缠绕住了莓丝的身体。她默默向前，朝杰克伸出了手。","style":3,"background":1048,"log_type":1,"src_id":220603084,"trial_step":84},{"step":85,"speaker":"杰克·那佩尔","content":"不……不要，你在做什么？！","style":1,"background":1048,"log_type":1,"src_id":220603085,"trial_step":85},{"step":86,"speaker":"杰克·那佩尔","content":"啊！！！！","style":1,"background":1048,"log_type":1,"src_id":220603086,"trial_step":86},{"step":87,"content":"莓丝的手伸向杰克。一股黑色的气流自他胸口喷涌而出，凝聚于莓丝的指尖。","style":3,"background":1048,"log_type":1,"src_id":220603087,"trial_step":87},{"step":88,"content":"下一刻，杰克倒在地上，失去了意识。","style":3,"background":1048,"log_type":1,"src_id":220603088,"trial_step":88},{"step":89,"content":"你打开了通讯器。","style":3,"background":1048,"log_type":1,"src_id":220603089,"trial_step":89},{"step":90,"content":"嫌犯已抓捕。尽快抵达，把他带回去……","style":2,"background":1048,"log_type":1,"src_id":220603090,"trial_step":90},{"step":91,"speaker":"莓丝","content":"为什么……","style":1,"background":1048,"log_type":1,"src_id":220603091,"trial_step":91},{"step":92,"content":"莓丝背对着你。突兀的声音打断了你与行动人员的通话。","style":3,"background":1048,"log_type":1,"src_id":220603092,"trial_step":92},{"step":93,"content":"？","style":2,"background":1048,"log_type":1,"src_id":220603093,"trial_step":93},{"step":94,"speaker":"莓丝","content":"为什么为什么为什么为什么为什么……","style":1,"background":1048,"log_type":1,"src_id":220603094,"trial_step":94},{"step":95,"speaker":"莓丝","content":"愤怒、失望、不甘……","style":1,"background":1048,"log_type":1,"src_id":220603095,"trial_step":95},{"step":96,"speaker":"莓丝","content":"你有那么多可以转化为恶意的情绪，为什么……","style":1,"background":1048,"log_type":1,"src_id":220603096,"trial_step":96},{"step":97,"speaker":"莓丝","content":"明明你面对的是一个无可救药的混蛋，一个禁闭者，为什么你连一点恶意也给不出来……为什么？！","style":1,"background":1048,"log_type":1,"src_id":220603097,"trial_step":97},{"step":98,"content":"听着，莓丝。","style":2,"background":1048,"log_type":1,"src_id":220603098,"trial_step":98},{"step":99,"content":"我不知道你为何执着于“恶意”，也不知道你过去经历过什么……","style":2,"background":1048,"log_type":1,"src_id":220603099,"trial_step":99},{"step":100,"content":"但你现在是我的禁闭者。我会给你时间去克服那些，去摆脱过去的阴影。","style":2,"background":1048,"log_type":1,"src_id":220603100,"trial_step":100},{"step":101,"content":"可此时此刻，我有更重要的事，我必须拯救新城的民众。无论他们是不是如你口中所说，被“它”所操纵。","style":2,"background":1048,"log_type":1,"src_id":220603101,"trial_step":101},{"step":102,"content":"这是我的义务。","style":2,"background":1048,"log_type":1,"src_id":220603102,"trial_step":102},{"step":103,"speaker":"莓丝","content":"呵呵……计划了这么久，铺垫这么多，就换来这种结果……","style":1,"background":1048,"log_type":1,"src_id":220603103,"trial_step":103},{"step":104,"speaker":"莓丝","content":"这不显得我像个小丑吗……","style":1,"background":1048,"log_type":1,"src_id":220603104,"trial_step":104},{"step":105,"speaker":"莓丝","content":"为什么偏偏就你不是坏人呢……","style":1,"background":1048,"log_type":1,"src_id":220603105,"trial_step":105},{"step":106,"content":"你在说什么？","style":2,"background":1048,"log_type":1,"src_id":220603106,"trial_step":106},{"step":107,"content":"莓丝的声音很轻，被风声盖住了。","style":3,"background":1048,"log_type":1,"src_id":220603107,"trial_step":107},{"step":108,"speaker":"莓丝","content":"我说……","style":1,"background":1048,"log_type":1,"src_id":220603108,"trial_step":108},{"step":109,"speaker":"莓丝","content":"给我消失啊啊啊啊啊啊啊啊啊啊啊！！！","style":1,"background":1048,"log_type":1,"src_id":220603109,"trial_step":109},{"step":110,"content":"莓丝的手中凭空出现了一把剑胚。黑色气流缠绕而上，显得极为妖异。","style":3,"background":10000,"log_type":1,"src_id":220603110,"trial_step":110},{"step":111,"content":"她举起剑，用尽全身的力气，朝着天空挥了下去。","style":3,"background":10000,"log_type":1,"src_id":220603111,"trial_step":111},{"step":112,"speaker":"莓丝","content":"啊啊啊啊啊啊啊啊！！！","style":1,"background":10000,"log_type":1,"src_id":220603112,"trial_step":112},{"step":113,"content":"一次、两次、十次、百次……看不见的气流直冲天际，劈散了云霾。","style":3,"background":10000,"log_type":1,"src_id":220603113,"trial_step":113},{"step":114,"content":"莓丝一刻不停地挥舞着她的剑，直到彻底力竭，瘫倒在地。","style":3,"background":10000,"log_type":1,"src_id":220603114,"trial_step":114},{"step":115,"content":"不知过去了多久，莓丝躺在地上。","style":3,"background":1048,"log_type":1,"src_id":220603115,"trial_step":115},{"step":116,"content":"你听到有气无力的抽噎声。","style":3,"background":1048,"log_type":1,"src_id":220603116,"trial_step":116},{"step":117,"content":"你究竟……在同什么样的东西战斗？","style":2,"background":1048,"log_type":1,"src_id":220603117,"trial_step":117},{"step":118,"speaker":"莓丝","content":"……","style":1,"background":1048,"log_type":1,"src_id":220603118,"trial_step":118},{"step":119,"speaker":"莓丝","content":"它……","style":1,"background":1048,"log_type":1,"src_id":220603119,"trial_step":119},{"step":120,"content":"它？","style":2,"background":1048,"log_type":1,"src_id":220603120,"trial_step":120},{"step":121,"content":"莓丝提到过“它”，但你不知道那究竟是什么。","style":3,"background":1048,"log_type":1,"src_id":220603121,"trial_step":121},{"step":122,"speaker":"莓丝","content":"还记得我的梦吗？我们第一次遇见的那个梦。","style":1,"background":1048,"log_type":1,"src_id":220603122,"trial_step":122},{"step":123,"speaker":"莓丝","content":"你一定不记得了吧……但我还记得哦。","style":1,"background":1048,"log_type":1,"src_id":220603123,"trial_step":123},{"step":124,"speaker":"莓丝","content":"我记得我做过的每一个梦……我不可能忘记它们。","style":1,"background":1048,"log_type":1,"src_id":220603124,"trial_step":124},{"step":125,"content":"你想起来了。","style":3,"background":1048,"log_type":1,"src_id":220603125,"trial_step":125},{"step":126,"speaker":"莓丝","content":"那是我记忆里唯一一个美梦，不骗你。","style":1,"background":1048,"log_type":1,"src_id":220603126,"trial_step":126},{"step":127,"speaker":"莓丝","content":"虽然那是假的，但我们一起打败了它。","style":1,"background":1048,"log_type":1,"src_id":220603127,"trial_step":127},{"step":128,"speaker":"莓丝","content":"可在现实里没人能打败它。","style":1,"background":1048,"log_type":1,"src_id":220603128,"trial_step":128},{"step":129,"speaker":"莓丝","content":"它操纵了爸爸，妈妈，我遇到过的每一个人……","style":1,"background":1048,"log_type":1,"src_id":220603129,"trial_step":129},{"step":130,"speaker":"莓丝","content":"为什么偏偏控制不了你呢？明明你的枷锁……是那么的黑暗的东西。","style":1,"background":1048,"log_type":1,"src_id":220603130,"trial_step":130},{"step":131,"speaker":"莓丝","content":"明明只要有你，我或许就能打败它了……","style":1,"background":1048,"log_type":1,"src_id":220603131,"trial_step":131},{"step":132,"content":"……","style":2,"background":1048,"log_type":1,"src_id":220603132,"trial_step":132},{"step":133,"speaker":"莓丝","content":"有时候我会想，会不会死了更好。","style":1,"background":1048,"log_type":1,"src_id":220603133,"trial_step":133},{"step":134,"speaker":"莓丝","content":"至少……不用再受这种折磨了。","style":1,"background":1048,"log_type":1,"src_id":220603134,"trial_step":134},{"step":135,"content":"它在哪里？","style":2,"background":1048,"log_type":1,"src_id":220603135,"trial_step":135},{"step":136,"speaker":"莓丝","content":"就在那儿啊，你看不见吗？","style":1,"background":1048,"log_type":1,"src_id":220603136,"trial_step":136},{"step":137,"content":"莓丝有气无力地举起手臂，指向天空。","style":3,"background":1048,"log_type":1,"src_id":220603137,"trial_step":137},{"step":138,"content":"可在那里，除了澄澈的夜空、散发着柔和光芒的月亮与星星，什么都没有。","style":3,"background":1048,"log_type":1,"src_id":220603138,"trial_step":138},{"step":139,"content":"我看不见它，莓丝。","style":2,"background":1048,"log_type":1,"src_id":220603139,"trial_step":139},{"step":140,"speaker":"莓丝","content":"你看不见……你当然看不见。除了我，又有谁能看见呢？","style":1,"background":1048,"log_type":1,"src_id":220603140,"trial_step":140},{"step":141,"content":"……你可以试试看相信别人，相信他们拥有克制恶意的力量，而不是引导他们堕入深渊。","style":2,"background":1048,"log_type":1,"src_id":220603141,"trial_step":141},{"step":142,"content":"我不知道你口中的它是否真实存在，但无论如何，你现在都是MBCC的禁闭者。","style":2,"background":1048,"log_type":1,"src_id":220603142,"trial_step":142},{"step":143,"content":"你可以依靠我，依靠我们。不要在这疯狂的旋涡里孤军奋战下去了。","style":2,"background":1048,"log_type":1,"src_id":220603143,"trial_step":143},{"step":144,"speaker":"莓丝","content":"依靠你？哈哈哈哈，你们连看都看不见……要我依靠你们？","style":1,"background":1048,"log_type":1,"src_id":220603144,"trial_step":144},{"step":145,"speaker":"莓丝","content":"……说不定他们说得对，有问题的是我……哈哈哈哈哈哈哈哈哈……","style":1,"background":1048,"log_type":1,"src_id":220603145,"trial_step":145},{"step":146,"speaker":"莓丝","content":"我只是个永远和你们看不见的敌人战斗的……疯子……","style":1,"background":1048,"log_type":1,"src_id":220603146,"trial_step":146},{"step":147,"speaker":"莓丝","content":"哈哈哈哈哈，哈哈哈哈哈哈哈哈……","style":1,"background":1048,"log_type":1,"src_id":220603147,"trial_step":147},{"step":148,"content":"你不知道该如何安慰面前的少女。","style":3,"background":1048,"log_type":1,"src_id":220603148,"trial_step":148},{"step":149,"content":"平日里的她狡黠又恶毒，总是令人捉摸不透。","style":3,"background":1048,"log_type":1,"src_id":220603149,"trial_step":149},{"step":150,"content":"但现在她又是那么脆弱，让人分不清，究竟哪一个才是真正的她。","style":3,"background":1048,"log_type":1,"src_id":220603150,"trial_step":150},{"step":151,"content":"就在这时，耳麦里传来了夜莺的声音。","style":3,"background":1048,"log_type":1,"src_id":220603151,"trial_step":151},{"step":152,"content":"嗯，事情解决了，嫌犯已被制服。","style":2,"background":1048,"log_type":1,"src_id":220603152,"trial_step":152},{"step":153,"content":"没有意外，她……她目前状况稳定，不会产生威胁。","style":2,"background":1048,"log_type":1,"src_id":220603153,"trial_step":153},{"step":154,"content":"你看了一眼地上双目失神的少女。","style":3,"background":1048,"log_type":1,"src_id":220603154,"trial_step":154},{"step":155,"content":"她以后会怎样我不清楚。但……我们得帮她。","style":2,"background":1048,"log_type":1,"src_id":220603155,"trial_step":155}]}