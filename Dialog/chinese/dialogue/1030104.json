lan_trial","style":1,"background":107,"log_type":1,"src_id":130104136,"trial_step":136},{"step":137,"speaker":"白逸","content":"还是说你有什么不可告人的小秘密，想要对我倾诉又不好意思说出口？","voice":["vo_trial_30104_1_137"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104137,"trial_step":137},{"step":138,"content":"……你们一直瞒着蔻蔻，对吧？","style":2,"background":107,"log_type":1,"src_id":130104138,"trial_step":138},{"step":139,"speaker":"白逸","content":"是啊……","voice":["vo_trial_30104_1_139"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104139,"trial_step":139},{"step":140,"content":"为什么？","style":2,"background":107,"log_type":1,"src_id":130104140,"trial_step":140},{"step":141,"speaker":"白逸","content":"因为她是个好孩子，而且……对我非常重要。我不能让她被卷进这个烂摊子里来。","voice":["vo_trial_30104_1_141"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104141,"trial_step":141},{"step":142,"content":"那澈呢？","style":2,"background":107,"log_type":1,"src_id":130104142,"trial_step":142},{"step":143,"content":"白逸笑了笑。","style":3,"background":107,"log_type":1,"src_id":130104143,"trial_step":143},{"step":144,"speaker":"白逸","content":"他和我一样是从那个烂摊子里逃出来的。","voice":["vo_trial_30104_1_144"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104144,"trial_step":144},{"step":145,"content":"……","style":2,"background":107,"log_type":1,"src_id":130104145,"trial_step":145},{"step":146,"content":"所以，那天在BR-004的就是你，对吧？","style":2,"background":107,"log_type":1,"src_id":130104146,"trial_step":146},{"step":147,"speaker":"白逸","content":"是不是我又怎样呢？","voice":["vo_trial_30104_1_147"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104147,"trial_step":147},{"step":148,"content":"我想知道卓娅在哪儿。","style":2,"background":107,"log_type":1,"src_id":130104148,"trial_step":148},{"step":149,"speaker":"白逸","content":"哎呀，真是爱操心……","voice":["vo_trial_30104_1_149"],"voice_bank":"vo_linglan_trial","style":1,"back