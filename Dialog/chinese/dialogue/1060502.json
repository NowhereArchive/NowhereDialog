{"id":1060502,"chapter_id":1060502,"scene_id":1,"steps":[{"step":1,"speaker":"小护理","content":"锵锵，这里就是我们重建的病房啦！","voice":["vo_trial_60502_1_1"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502001,"trial_step":1},{"step":2,"speaker":"小护理","content":"和原先一模一样对不对！伊芙见过诊所以前的样子吗？","voice":["vo_trial_60502_1_2"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502002,"trial_step":2},{"step":3,"speaker":"伊芙","content":"没有。我在失去双腿后，就几乎不出门。","voice":["vo_trial_60502_1_3"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502003,"trial_step":3},{"step":4,"speaker":"小护理","content":"这样啊……没关系，现在你见到了！","voice":["vo_trial_60502_1_4"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502004,"trial_step":4},{"step":5,"speaker":"弗朗西斯","content":"哟，这是我们的新朋友？","voice":["vo_trial_60502_1_5"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502005,"trial_step":5},{"step":6,"content":"和小护理热情打招呼是个笑盈盈的大汉。","style":3,"background":104,"log_type":1,"src_id":160502006,"trial_step":6},{"step":7,"speaker":"小护理","content":"哼哼，伊芙可是MBCC暂时留在我们这里的客人！","voice":["vo_trial_60502_1_7"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502007,"trial_step":7},{"step":8,"speaker":"小护理","content":"来，我带你认识一下，这个是弗朗西斯，大画家！","voice":["vo_trial_60502_1_8"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502008,"trial_step":8},{"step":9,"speaker":"小护理","content":"最近康复得怎么样？","voice":["vo_trial_60502_1_9"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502009,"trial_step":9},{"step":10,"speaker":"弗朗西斯","content":"多亏你，好得不得了！复刻那些新城大家的名作更不在话下！","voice":["vo_trial_60502_1_10"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502010,"trial_step":10},{"step":11,"speaker":"小护理","content":"好好好，那就等出院以后大展身手吧。","voice":["vo_trial_60502_1_11"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502011,"trial_step":11},{"step":12,"speaker":"小护理","content":"别在我的记事本里浪费你的才能了！","voice":["vo_trial_60502_1_12"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502012,"trial_step":12},{"step":13,"content":"小护理从本子上撕下一页还给了弗朗西斯。伊芙看到那上面画的，只是一些歪歪扭扭的火柴人而已。","style":3,"background":104,"log_type":1,"src_id":160502013,"trial_step":13},{"step":14,"speaker":"弗朗西斯","content":"伊芙小姐在看我的画？怎么样，要不要我也给伊芙小姐来一张肖像。","voice":["vo_trial_60502_1_14"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502014,"trial_step":14},{"step":15,"speaker":"伊芙","content":"我……谢谢？","voice":["vo_trial_60502_1_15"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502015,"trial_step":15},{"step":16,"content":"伊芙看着弗朗西斯的画给了模棱两可的回答。","style":3,"background":104,"log_type":1,"src_id":160502016,"trial_step":16},{"step":17,"speaker":"小护理","content":"我还要带伊芙认识这里的好多人呢，你别打岔。","voice":["vo_trial_60502_1_17"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502017,"trial_step":17},{"step":18,"content":"弗朗西斯并不在意地笑笑，看着小护理把伊芙推走。","style":3,"background":104,"log_type":1,"src_id":160502018,"trial_step":18},{"step":19,"speaker":"卢娜","content":"我新创作的脑筋急转弯，大家都来猜猜看！","voice":["vo_trial_60502_1_19"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502019,"trial_step":19},{"step":20,"speaker":"卢娜","content":"狄斯东、南、西、北都能生产的是什么——","voice":["vo_trial_60502_1_20"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502020,"trial_step":20},{"step":21,"content":"不远处的热闹又吸引了小护理和伊芙的注意力，一个小女孩站在病床上大声宣讲。","style":3,"background":104,"log_type":1,"src_id":160502021,"trial_step":21},{"step":22,"speaker":"病人们","content":"是什么是什么？","voice":["vo_trial_60502_1_22"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502022,"trial_step":22},{"step":23,"speaker":"卢娜","content":"是“瓜”啦！","voice":["vo_trial_60502_1_23"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502023,"trial_step":23},{"step":24,"content":"人群里爆发出伊芙不能理解的欢笑和起哄。","style":3,"background":104,"log_type":1,"src_id":160502024,"trial_step":24},{"step":25,"speaker":"病人们","content":"哈哈哈哈哈！卢娜，你以后要不去我的小饭馆讲笑话吧，大家一定捧场！","voice":["vo_trial_60502_1_25"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502025,"trial_step":25},{"step":26,"speaker":"小护理","content":"真的吗，那到时候我也要来！","voice":["vo_trial_60502_1_26"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502026,"trial_step":26},{"step":27,"content":"小护理也加入了这场起哄。","style":3,"background":104,"log_type":1,"src_id":160502027,"trial_step":27},{"step":28,"speaker":"小护理","content":"伊芙肯定觉得，这个笑话很没意思吧？","voice":["vo_trial_60502_1_28"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502028,"trial_step":28},{"step":29,"speaker":"伊芙","content":"……","voice":["vo_trial_60502_1_29"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502029,"trial_step":29},{"step":30,"speaker":"伊芙","content":"我在这里，是不是很扫兴？","voice":["vo_trial_60502_1_30"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502030,"trial_step":30},{"step":31,"content":"小护理笑着，继续饶有架势地介绍：","style":3,"background":104,"log_type":1,"src_id":160502031,"trial_step":31},{"step":32,"speaker":"小护理","content":"你往那边看，那个是安德鲁，被诊所收治之前一家小餐馆的老板！","voice":["vo_trial_60502_1_32"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502032,"trial_step":32},{"step":33,"speaker":"小护理","content":"还有那个，艾布特，听说他以前是辛迪加有名的大胃王，大家都觉得他要是去新城搞直播，一定能闯出名堂！","voice":["vo_trial_60502_1_33"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502033,"trial_step":33},{"step":34,"content":"伊芙看向小护理介绍的人，一个穿着满是补丁的破衣服，一个瘦的皮包骨头。但奇怪的是他们好像都还保有小护理介绍中的那种精气神，正大大咧咧地互相攀比着。","style":3,"background":104,"log_type":1,"src_id":160502034,"trial_step":34},{"step":35,"speaker":"艾布特","content":"哈哈哈，有卢娜讲笑话，那我肯定也要来捧场！一定帮大家把安德鲁的餐馆吃空！","voice":["vo_trial_60502_1_35"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502035,"trial_step":35},{"step":36,"speaker":"安德鲁","content":"就吹牛吧，我炒菜的速度你可不一定能跟上！","voice":["vo_trial_60502_1_36"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502036,"trial_step":36},{"step":37,"content":"他们热闹成一团，完全不像病人的样子。","style":3,"background":104,"log_type":1,"src_id":160502037,"trial_step":37},{"step":38,"content":"伊芙小声凑近护理——","style":3,"background":104,"log_type":1,"src_id":160502038,"trial_step":38},{"step":39,"speaker":"伊芙","content":"他们都是因为什么才来到诊所的？","voice":["vo_trial_60502_1_39"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502039,"trial_step":39},{"step":40,"speaker":"小护理","content":"辛迪加的大家过得都可粗糙了，小病小灾基本都靠自愈。","voice":["vo_trial_60502_1_40"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502040,"trial_step":40},{"step":41,"speaker":"小护理","content":"真正需要来诊所的……只有狂厄呀。","voice":["vo_trial_60502_1_41"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502041,"trial_step":41},{"step":42,"content":"小护理神色暗了暗，但很快又恢复了笑脸。","style":3,"background":104,"log_type":1,"src_id":160502042,"trial_step":42},{"step":43,"speaker":"小护理","content":"好了好了，吹牛时间结束！都排好队。","voice":["vo_trial_60502_1_43"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502043,"trial_step":43},{"step":44,"speaker":"小护理","content":"该做抽血检测了！","voice":["vo_trial_60502_1_44"],"voice_bank":"vo_eve_trial","style":1,"background":104,"log_type":1,"src_id":160502044,"trial_step":44},{"step":45,"content":"原本热闹的人群像同个班级的学生一样，立刻乖乖回到了各自的位置，安静了下来。","style":3,"background":104,"log_type":1,"src_id":160502045,"trial_step":45},{"step":46,"content":"见别的护理已经开始对他们挨个进行检测，小护理也将伊芙推到了一个相对安静的走廊。","style":3,"background":104,"log_type":1,"src_id":160502046,"trial_step":46},{"step":47,"speaker":"头盔人","content":"啊呀，他们这群人真是一点都安分不了。","voice":["vo_trial_60502_1_47"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502047,"trial_step":47},{"step":48,"speaker":"小护理","content":"本来还想说陪你一起熟悉一下这里呢，结果却乱糟糟的。","voice":["vo_trial_60502_1_48"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502048,"trial_step":48},{"step":49,"speaker":"小护理","content":"怎么样，没有吵到你吧？","voice":["vo_trial_60502_1_49"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502049,"trial_step":49},{"step":50,"content":"伊芙确实不太习惯被那么多人包围，但很奇怪，她也没有觉得抵触。","style":3,"background":120,"log_type":1,"src_id":160502050,"trial_step":50},{"step":51,"speaker":"伊芙","content":"没关系的，这样开开心心的就很好……","voice":["vo_trial_60502_1_51"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502051,"trial_step":51},{"step":52,"speaker":"伊芙","content":"有……很熟悉的感觉……","voice":["vo_trial_60502_1_52"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502052,"trial_step":52},{"step":53,"speaker":"小护理","content":"怎么，伊芙以前也有很多爱吹牛的朋友吗？","voice":["vo_trial_60502_1_53"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502053,"trial_step":53},{"step":54,"content":"几个身影在脑海里浮现，伊芙下意识笑了笑。","style":3,"background":120,"log_type":1,"src_id":160502054,"trial_step":54},{"step":55,"speaker":"伊芙","content":"不能说是爱吹牛吧，只是喜欢说些对美好世界的想象……","voice":["vo_trial_60502_1_55"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502055,"trial_step":55},{"step":56,"speaker":"小护理","content":"嗯，即便知道或许不能实现，对吗？","voice":["vo_trial_60502_1_56"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502056,"trial_step":56},{"step":57,"content":"心底的话被第一次见面的人戳穿，伊芙难得瞪大了眼睛。","style":3,"background":120,"log_type":1,"src_id":160502057,"trial_step":57},{"step":58,"speaker":"小护理","content":"别惊讶，能把你放在我们这里，局长大人肯定都已经详细交代过你的事啦。","voice":["vo_trial_60502_1_58"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502058,"trial_step":58},{"step":59,"speaker":"小护理","content":"你也听过很多类似的小小谎言，对不对？","voice":["vo_trial_60502_1_59"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502059,"trial_step":59},{"step":60,"speaker":"伊芙","content":"我其实并不明白……既然知道弗朗西斯先生无法成为大画家，为什么还要说那样的话？","voice":["vo_trial_60502_1_60"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502060,"trial_step":60},{"step":61,"speaker":"小护理","content":"这个嘛，我以前也不太明白！","voice":["vo_trial_60502_1_61"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502061,"trial_step":61},{"step":62,"speaker":"小护理","content":"但在我手臂被污染侵蚀的时候，照顾我的护理姐姐告诉我，我会被治好的，能和正常人过一样的生活。","voice":["vo_trial_60502_1_62"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502062,"trial_step":62},{"step":63,"speaker":"小护理","content":"那个时候，好神奇，伤口居然没有那么痛了……","voice":["vo_trial_60502_1_63"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502063,"trial_step":63},{"step":64,"content":"小护理有些不好意思的摸摸自己的手臂。","style":3,"background":120,"log_type":1,"src_id":160502064,"trial_step":64},{"step":65,"speaker":"小护理","content":"但怎么可能真的和正常人一样嘛，摘掉了整整一只手诶，我明明知道只是安慰的话。","voice":["vo_trial_60502_1_65"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502065,"trial_step":65},{"step":66,"speaker":"小护理","content":"但谎言，或许是很有效的镇痛剂呢。至少能让那个时候的我，感觉好受些。","voice":["vo_trial_60502_1_66"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502066,"trial_step":66},{"step":67,"speaker":"小护理","content":"所以，我也是这样对待大家的！久而久之，都成习惯了~","voice":["vo_trial_60502_1_67"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502067,"trial_step":67},{"step":68,"content":"楼道的广播突然传来鸣笛，紧急的红光传递着未知的风险。","style":3,"background":120,"log_type":1,"src_id":160502068,"trial_step":68},{"step":69,"speaker":"小护理","content":"呀，抱歉抱歉，光顾着说自己的事了。好像有很重要的工作需要我，下次再来听伊芙的故事吧！","voice":["vo_trial_60502_1_69"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502069,"trial_step":69},{"step":70,"content":"小护士将伊芙留停靠在安全处，小跑着离开了。","style":3,"background":120,"log_type":1,"src_id":160502070,"trial_step":70},{"step":71,"speaker":"伊芙","content":"急匆匆的，热情又有些大条，这里的人都是这样吗？","voice":["vo_trial_60502_1_71"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502071,"trial_step":71},{"step":72,"content":"伊芙一个人在原地，观察起四周。","style":3,"background":120,"log_type":1,"src_id":160502072,"trial_step":72},{"step":73,"content":"和工厂不同，走廊的医院有很多窗，可以看到外面的天空。","style":3,"background":120,"log_type":1,"src_id":160502073,"trial_step":73},{"step":74,"content":"一些惊鸟飞过，似乎是从辛迪加的贫民窟方向来的。","style":3,"background":120,"log_type":1,"src_id":160502074,"trial_step":74},{"step":75,"speaker":"伊芙","content":"那个灰衣服娃娃……现在在做什么呢？","voice":["vo_trial_60502_1_75"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502075,"trial_step":75},{"step":76,"speaker":"？？？","content":"娃娃？姐姐也有个娃娃吗？","voice":["vo_trial_60502_1_76"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502076,"trial_step":76},{"step":77,"content":"稚嫩的童声不知道什么时候出现在身后。","style":3,"background":120,"log_type":1,"src_id":160502077,"trial_step":77},{"step":78,"content":"伊芙慢慢转动了轮椅，看到是一个抱着破娃娃的小女孩。","style":3,"background":120,"log_type":1,"src_id":160502078,"trial_step":78},{"step":79,"content":"小女孩手上有输液后留下的痕迹。","style":3,"background":120,"log_type":1,"src_id":160502079,"trial_step":79},{"step":80,"speaker":"莉莉","content":"我叫莉莉，姐姐你也是这里的病人吗，我没有见过姐姐！","voice":["vo_trial_60502_1_80"],"voice_bank":"vo_eve_trial","style":1,"background":120,"log_type":1,"src_id":160502080,"trial_step":80},{"step":81,"speaker":"伊芙","content":"莉莉，我叫伊芙。我只是暂时被托付在这里照顾而已。","voice":["vo_trial_60502_1_81"],"voice_bank":"vo