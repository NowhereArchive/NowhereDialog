{"id":1220102,"chapter_id":1220102,"scene_id":1,"steps":[{"step":1,"content":"局里的警报又一次响起。你等了大概三秒钟，接起了内线电话。","style":3,"background":10000,"log_type":1,"src_id":320102001,"trial_step":1},{"step":2,"options":["发生什么事了？"],"style":6,"background":107,"log_type":1,"src_id":320102002,"trial_step":2,"course":3,"choices":[{"text":"发生什么事了？","goto":3}]},{"step":3,"speaker":"夜莺","content":"海拉，又出逃了……","style":1,"background":107,"log_type":1,"src_id":320102003,"trial_step":3},{"step":4,"content":"唉……她又在搞什么，九十九呢？","style":2,"background":107,"log_type":1,"src_id":320102004,"trial_step":4},{"step":5,"speaker":"夜莺","content":"九十九还在，但她什么都不愿意说。","style":1,"background":107,"log_type":1,"src_id":320102005,"trial_step":5},{"step":6,"content":"……好吧，我马上过去。","style":2,"background":107,"log_type":1,"src_id":320102006,"trial_step":6},{"step":7,"content":"当你来到禁闭区域时，夜莺已经守在了门口。后勤人员正围着禁闭室大门忙忙碌碌。","style":3,"background":17,"log_type":1,"src_id":320102007,"trial_step":7},{"step":8,"content":"177号禁闭室的门禁被人从里侧整个劈开，电子元件到现在都还滋滋啦啦冒着火星。一眼就能看出这种破坏明显出自九十九之手。","style":3,"background":17,"log_type":1,"src_id":320102008,"trial_step":8},{"step":9,"content":"但奇怪的是，九十九却沉默地坐在角落里，耸拉着眼皮一副昏昏欲睡的模样——尽管种种迹象标明她在这场出逃中担任了重要角色。","style":3,"background":17,"log_type":1,"src_id":320102009,"trial_step":9},{"step":10,"content":"有些不对劲，海拉出逃不可能放任九十九留在这里。","style":3,"background":17,"log_type":1,"src_id":320102010,"trial_step":10},{"step":11,"content":"除非，她们还有什么后招。","style":3,"background":17,"log_type":1,"src_id":320102011,"trial_step":11},{"step":12,"content":"夜莺，她一路上没惹出什么乱子吧？","style":2,"background":17,"log_type":1,"src_id":320102012,"trial_step":12},{"step":13,"content":"你转过身去，用只有你们两人能听到的声音对夜莺询问道。","style":3,"background":17,"log_type":1,"src_id":320102013,"trial_step":13},{"step":14,"speaker":"夜莺","content":"信息组已经着手在筛查市里的监控视频……不仅没出乱子，甚至没有找到海拉逃出管理局之后的踪迹。","style":1,"background":17,"log_type":1,"src_id":320102014,"trial_step":14},{"step":15,"content":"夜莺后面的话你都没太听进去。因为你发现坐在角落里的九十九，睁开了眼睛，盯着你不放，甚至还眨了两下。","style":3,"background":17,"log_type":1,"src_id":320102015,"trial_step":15},{"step":16,"content":"你们两人就这样对视了足足三秒钟，你才恍然大悟地意识到九十九是在暗示有悄悄话想跟你说。","style":3,"background":17,"log_type":1,"src_id":320102016,"trial_step":16},{"step":17,"content":"夜莺注意到了你的异样，她刚想转头却被你拉到了一旁，你小声告诉夜莺一个坐标。","style":3,"background":17,"log_type":1,"src_id":320102017,"trial_step":17},{"step":18,"speaker":"夜莺","content":"海拉的坐标？","style":1,"background":17,"log_type":1,"src_id":320102018,"trial_step":18},{"step":19,"content":"嗯，她停下来了，趁现在赶紧去。","style":2,"background":17,"log_type":1,"src_id":320102019,"trial_step":19},{"step":20,"speaker":"夜莺","content":"就我一个人吗？","style":1,"background":17,"log_type":1,"src_id":320102020,"trial_step":20},{"step":21,"content":"以你的身手把海拉带回来一点也不困难，这事儿一上午就能解决，我先解决一下“沉默的九十九”吧。","style":2,"background":17,"log_type":1,"src_id":320102021,"trial_step":21},{"step":22,"content":"夜莺点了点头，没有表现出丝毫的犹豫。","style":3,"background":17,"log_type":1,"src_id":320102022,"trial_step":22},{"step":23,"speaker":"夜莺","content":"明白了，我这就出发。","style":1,"background":17,"log_type":1,"src_id":320102023,"trial_step":23},{"step":24,"content":"待夜莺走远，你拍了拍手，示意后勤人员全部撤离这里。","style":3,"background":17,"log_type":1,"src_id":320102024,"trial_step":24},{"step":25,"content":"说说吧，她这次又想要干什么？","style":2,"background":17,"log_type":1,"src_id":320102025,"trial_step":25},{"step":26,"content":"九十九保持沉默，却向你递来了一张纸条。","style":3,"background":17,"log_type":1,"src_id":320102026,"trial_step":26},{"step":27,"content":"测试选项的跳过配置1","style":3,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":28,"content":"测试选项的跳过配置2","style":3,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":29,"content":"测试选项的跳过配置3","style":3,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":30,"options":["选择1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":31,"content":"测试选项的跳过配置4","style":18,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":32,"options":["选择1","选择2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":33,"content":"测试选项的跳过配置5，对应选择1","style":3,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":34,"content":"测试选项的跳过配置5，对应选择2","style":3,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":35,"content":"“哼！你们是关不住我，也找不到我的！”","style":3,"background":17,"log_type":1,"src_id":320102028,"trial_step":28},{"step":36,"content":"字迹歪歪扭扭的，但挑衅的气势却很足。","style":3,"background":17,"log_type":1,"src_id":320102029,"trial_step":29},{"step":37,"content":"你叹了口气。大致明白了这起“出逃”的性质。","style":3,"background":17,"log_type":1,"src_id":320102030,"trial_step":30},{"step":38,"content":"我还是第一次见这么“粗心”的出逃……放心吧，我这就去把她带回来。","style":2,"background":17,"log_type":1,"src_id":320102031,"trial_step":31},{"step":39,"content":"半小时后，你来到了位于辛迪加南区的一幢破败二层小楼前。","style":3,"background":100,"log_type":1,"src_id":320102032,"trial_step":32},{"step":40,"content":"海拉就在里面。这是枷锁明确告诉你的信息。\n至于之前告诉夜莺的那个坐标，则位于完全相反的方向上。","style":3,"background":100,"log_type":1,"src_id":320102033,"trial_step":33},{"step":41,"content":"确实是个还不错的藏身之处啊……","style":2,"background":100,"log_type":1,"src_id":320102034,"trial_step":34},{"step":42,"content":"小楼虽然破败，但内里都还挺结实坚固的。你上到二楼，其中一户的门半开着。","style":3,"background":100,"log_type":1,"src_id":320102035,"trial_step":35},{"step":43,"content":"海……","style":2,"background":105,"log_type":1,"src_id":320102036,"trial_step":36},{"step":44,"content":"你刚想喊出海拉的名字，就听见屋里传出一阵翻箱倒柜的声响。","style":3,"background":105,"log_type":1,"src_id":320102037,"trial_step":37},{"step":45,"speaker":"？？？","content":"啊——真是的，她到底收藏了多少罐头！","style":1,"background":105,"log_type":1,"src_id":320102038,"trial_step":38},{"step":46,"content":"是海拉的声音！\n你心里一动，悄悄走近，尽可能压低了自己的呼吸声，从门缝往里观察着。","style":3,"background":105,"log_type":1,"src_id":320102039,"trial_step":39},{"step":47,"content":"让你意外的是，房子内里保持得相当不错，家具和电器全都规整地陈列在屋内。","style":3,"background":105,"log_type":1,"src_id":320102040,"trial_step":40},{"step":48,"content":"你甚至在门口的电冰箱上看到了几张小字条。上面歪歪扭扭的字迹显然出自海拉之手。全都是写给九十九的生活常识。","style":3,"background":105,"log_type":1,"src_id":320102041,"trial_step":41},{"step":49,"options":["和她开个玩笑","直接进去找海拉"],"style":6,"background":105,"log_type":1,"src_id":320102042,"trial_step":42,"course":3,"choices":[{"text":"和她开个玩笑","goto":43},{"text":"直接进去找海拉","goto":57}]},{"step":50,"content":"你找到通讯器里留存的演习录音，点击了播放。","style":3,"background":105,"log_type":1,"src_id":320102043,"trial_step":43},{"step":51,"speaker":"录音","content":"里面的人听着，这里是MBCC特别行动组，你已经被包围了！","style":11,"background":105,"log_type":1,"src_id":320102044,"trial_step":44},{"step":52,"speaker":"录音","content":"所有禁闭者！立刻双手抱头走出屋子，不要反抗！","style":11,"background":105,"log_type":1,"src_id":320102045,"trial_step":45},{"step":53,"speaker":"海拉","content":"靠，怎么来得这么快？","style":1,"background":105,"log_type":1,"src_id":320102046,"trial_step":46},{"step":54,"content":"卧室里传出一阵凌乱的声响，你隐约还听到海拉小声嘟囔了一句。","style":3,"background":105,"log_type":1,"src_id":320102047,"trial_step":47},{"step":55,"content":"大约过了两分钟，卧室门从里侧被缓缓推开。女孩从门缝小心翼翼地望向屋外。","style":3,"background":105,"log_type":1,"src_id":320102048,"trial_step":48},{"step":56,"speaker":"海拉","content":"……","style":1,"background":105,"log_type":1,"src_id":320102049,"trial_step":49},{"step":57,"content":"……","style":2,"background":105,"log_type":1,"src_id":320102050,"trial_step":50},{"step":58,"speaker":"海拉","content":"……","style":1,"background":105,"log_type":1,"src_id":320102051,"trial_step":51},{"step":59,"content":"……","style":2,"background":105,"log_type":1,"src_id":320102052,"trial_step":52},{"step":60,"speaker":"海拉","content":"怎么就你一个人？大部队呢？","style":1,"background":105,"log_type":1,"src_id":320102053,"trial_step":53},{"step":61,"content":"你耸了耸肩。","style":3,"background":105,"log_type":1,"src_id":320102054,"trial_step":54},{"step":62,"speaker":"海拉","content":"**********你这人怎么这么恶劣！！！","style":1,"background":105,"log_type":1,"src_id":320102055,"trial_step":55},{"step":63,"content":"意识到自己被耍，海拉气得直跳脚。","style":3,"background":105,"log_type":1,"src_id":320102056,"trial_step":56,"next":[65]},{"step":64,"content":"你继续隐藏自己的气息，然后小心翼翼打开了卧室的门把手。","style":3,"background":105,"log_type":1,"src_id":320102057,"trial_step":57},{"step":65,"content":"屋内，海拉正在往一个行李箱里装东西，屋子里被她翻得乱七八糟，衣服和一堆杂七杂八的小东西洒落一地。","style":3,"background":105,"log_type":1,"src_id":320102058,"trial_step":58},{"step":66,"content":"你不小心踢到了一个塑料水壶，惊觉有人的海拉连忙转过身发出一声惊叫。","style":3,"background":105,"log_type":1,"src_id":320102059,"trial_step":59},{"step":67,"speaker":"海拉","content":"**！哪个**！！","style":1,"background":105,"log_type":1,"src_id":320102060,"trial_step":60},{"step":68,"speaker":"海拉","content":"……","style":1,"background":105,"log_type":1,"src_id":320102061,"trial_step":61},{"step":69,"content":"可等看清楚来者是你后，海拉腾地一下涨红了脸。","style":3,"background":105,"log_type":1,"src_id":320102062,"trial_step":62},{"step":70,"speaker":"海拉","content":"你！你是什么时候进来的！","style":1,"background":105,"log_type":1,"src_id":320102063,"trial_step":63},{"step":71,"content":"慌乱中，海拉不小心打翻了行李箱，辛辛苦苦收拾好的东西这下全都洒了出来。","style":3,"background":105,"log_type":1,"src_id":320102064,"trial_step":64},{"step":72,"speaker":"海拉","content":"不对！不对不对不对！你是怎么找过来的？","style":1,"background":105,"log_type":1,"src_id":320102065,"trial_step":65},{"step":73,"speaker":"海拉","content":"不可能有人知道我们住这里才对！等等……该不会是九十九那个家伙吧！！！！","style":1,"background":105,"log_type":1,"src_id":320102066,"trial_step":66},{"step":74,"speaker":"海拉","content":"她怎么好的不学学坏的！！都开始打小报告了！","style":1,"background":105,"log_type":1,"src_id":320102067,"trial_step":67},{"step":75,"speaker":"海拉","content":"看我回去怎么收拾她！啊……！","style":1,"background":105,"log_type":1,"src_id":320102068,"trial_step":68},{"step":76,"content":"意识到自己说漏了嘴，海拉连忙捂住自己的嘴巴。","style":3,"background":105,"log_type":1,"src_id":320102069,"trial_step":69},{"step":77,"content":"你叹了口气。","style":3,"background":105,"log_type":1,"src_id":320102070,"trial_step":70},{"step":78,"content":"所以你到底是来干什么的？","style":2,"background":105,"log_type":1,"src_id":320102071,"trial_step":71},{"step":79,"speaker":"海拉","content":"当然是收拾行李准备远走高飞！","style":1,"background":105,"log_type":1,"src_id":320102072,"trial_step":72},{"step":80,"content":"走？你一个人能走到哪里？","style":2,"background":105,"log_type":1,"src_id":320102073,"trial_step":73},{"step":81,"content":"你往前迈了一步。海拉则像个小兔子似地慌忙避开。","style":3,"background":105,"log_type":1,"src_id":320102074,"trial_step":74},{"step":82,"speaker":"海拉","content":"要你管！","style":1,"background":105,"log_type":1,"src_id":320102075,"trial_step":75},{"step":83,"content":"好，我不管你，但我得管管九十九……你就这么抛弃你最亲的家人，一个人逃走了？","style":2,"background":105,"log_type":1,"src_id":320102076,"trial_step":76},{"step":84,"speaker":"海拉","content":"我才不是逃走！！那是因为……是因为……","style":1,"background":105,"log_type":1,"src_id":320102077,"trial_step":77},{"step":85,"content":"看着海拉涨红着脸，绞尽脑汁给自己想说辞，你轻声笑了起来。","style":3,"background":105,"log_type":1,"src_id":320102078,"trial_step":78},{"step":86,"speaker":"海拉","content":"我这是……提前过来收拾行李！你也知道九十九那样子太扎眼了，带着她在市区里，没一会儿就会冲过来一群人找我们打架。","style":1,"background":105,"log_type":1,"src_id":320102079,"trial_step":79},{"step":87,"speaker":"海拉","content":"她那个没常识的脑子惹了多少祸，得罪过多少人，你比我清楚！","style":1,"background":105,"log_type":1,"src_id":320102080,"trial_step":80},{"step":88,"content":"嗯，你说得对。","style":2,"background":105,"log_type":1,"src_id":320102081,"trial_step":81},{"step":89,"content":"那现在呢？我抓到你了，你是想违抗我？还是乖乖跟我回局里？","style":2,"background":105,"log_type":1,"src_id":320102082,"trial_step":82},{"step":90,"content":"海拉嘟起了嘴。","style":3,"background":105,"log_type":1,"src_id":320102083,"trial_step":83},{"step":91,"speaker":"海拉","content":"哼！我海拉大人愿赌服输……我玩得起！","style":1,"background":105,"log_type":1,"src_id":320102084,"trial_step":84},{"step":92,"speaker":"海拉","content":"我……我跟你回局里……","style":1,"background":105,"log_type":1,"src_id":320102085,"trial_step":85},{"step":93,"content":"见海拉服了软，你侧身站到门边对她做了一个请的手势。","style":3,"background":105,"log_type":1,"src_id":320102086,"trial_step":86},{"step":94,"content":"海拉无视你的姿势，又跑回去将所有行李塞进旅行箱里，整个人压在行李箱盖上，才把箱子盖住。","style":3,"background":105,"log_type":1,"src_id":320102087,"trial_step":87},{"step":95,"speaker":"海拉","content":"啊对了！忘了跟你强调了。","style":1,"background":105,"log_type":1,"src_id":320102088,"trial_step":88},{"step":96,"speaker":"海拉","content":"我只是在你那暂住！暂住！明白吗？","style":1,"background":105,"log_type":1,"src_id":320102089,"trial_step":89},{"step":97,"speaker":"海拉","content":"你可得好好伺候我！听清楚没有？不然我随时都能像今天一样跑出来！","style":1,"background":105,"log_type":1,"src_id":320102090,"trial_step":90},{"step":98,"options":["是是是，都听你的。","我能问个问题吗？"],"style":6,"background":105,"log_type":1,"src_id":320102091,"trial_step":91,"course":3,"choices":[{"text":"是是是，都听你的。","goto":92},{"text":"我能问个问题吗？","goto":94}]},{"step":99,"speaker":"海拉","content":"哼，这还差不多！","style":1,"background":105,"log_type":1,"src_id":320102092,"trial_step":92},{"step":100,"speaker":"海拉","content":"干嘛，你这是还有什么问题吗？","style":1,"background":105,"log_type":1,"src_id":320102093,"trial_step":93,"next":[94]},{"step":101,"speaker":"海拉","content":"还有什么问题要说快说哦！趁我心情还不错！","style":1,"background":105,"log_type":1,"src_id":320102094,"trial_step":94},{"step":102,"content":"你整理了一下自己的制服，然后清了清嗓子，非常正式地向海拉问道。","style":3,"background":105,"log_type":1,"src_id":320102095,"trial_step":95},{"step":103,"content":"既然你同意来我这里“暂住”，那我是不是可以理解为……我们已经是朋友了？","style":2,"background":105,"log_type":1,"src_id":320102096,"trial_step":96},{"step":104,"content":"这一次，海拉的脸颊比煮熟的虾子还要红。","style":3,"background":105,"log_type":1,"src_id":320102097,"trial_step":97},{"step":105,"content":"她低下头，小声嘟囔了几句。","style":3,"background":105,"log_type":1,"src_id":320102098,"trial_step":98},{"step":106,"content":"你说什么？我听不清。","style":2,"background":105,"log_type":1,"src_id":320102099,"trial_step":99},{"step":107,"content":"女孩抬起头，嚅动着嘴唇但还是没有声音。","style":3,"background":105,"log_type":1,"src_id":320102100,"trial_step":100},{"step":108,"content":"嗯——？","style":2,"background":105,"log_type":1,"src_id":320102101,"trial_step":101},{"step":109,"content":"你故意拖了个长音。","style":3,"background":105,"log_type":1,"src_id":320102102,"trial_step":102},{"step":110,"speaker":"海拉","content":"我说……","style":1,"background":105,"log_type":1,"src_id":320102103,"trial_step":103},{"step":111,"content":"你说，我听着呐。","style":2,"background":105,"log_type":1,"src_id":320102104,"trial_step":104},{"step":112,"content":"最终，海拉还是忍受不了你的捉弄，没好气地大喊道。","style":3,"background":105,"log_type":1,"src_id":320102105,"trial_step":105},{"step":113,"speaker":"海拉","content":"我说！谢谢你！谢谢你救了我们！谢谢你制止了九十九的感染！","style":1,"background":105,"log_type":1,"src_id":320102106,"trial_step":106},{"step":114,"content":"说完，海拉拉着行李箱，头也不回地跑到了外面。","style":3,"background":105,"log_type":1,"src_id":320102107,"trial_step":107},{"step":115,"content":"真是……一点也不坦诚。","style":2,"background":105,"log_type":1,"src_id":320102108,"trial_step":108},{"step":116,"content":"这时，门口传来了敲门声。你回头望去，只见夜莺正抱着双臂冷冷地看着你。","style":3,"background":105,"log_type":1,"src_id":320102109,"trial_step":109},{"step":117,"speaker":"夜莺","content":"局长大人，您可否给我一个，您和目标出现在您所指引的方位的反方向建筑里的原因？","style":1,"background":105,"log_type":1,"src_id":320102110,"trial_step":110},{"step":118,"content":"你暗叫一声不好。心里盘算着给自己找一个借口。","style":3,"background":105,"log_type":1,"src_id":320102111,"trial_step":111},{"step":119,"content":"唔……可能是因为，之前和九十九一战，身体恢复得有些混乱，一下子弄错方向了吧。","style":2,"background":105,"log_type":1,"src_id":320102112,"trial_step":112},{"step":120,"speaker":"夜莺","content":"……","style":1,"background":105,"log_type":1,"src_id":320102113,"trial_step":113},{"step":121,"speaker":"夜莺","content":"“目标为了摆脱追踪，临时转移阵地，局长担心耽误进程，于是亲自出动”——正式的书面报告我会这么写的。","style":1,"background":105,"log_type":1,"src_id":320102114,"trial_step":114},{"step":122,"content":"谢谢你，夜莺。","style":2,"background":105,"log_type":1,"src_id":320102115,"trial_step":115},{"step":123,"content":"最终，这场近乎于闹剧的出逃不到半天时间就得到了解决。","style":3,"background":105,"log_type":1,"src_id":320102116,"trial_step":116},{"step":124,"content":"在最终呈交的书面报告上，你详细记录了追踪出逃禁闭者海拉的过程，并将其在辛迪加南区的据点也封闭起来。","style":3,"background":105,"log_type":1,"src_id":320102117,"trial_step":117},{"step":125,"content":"至于里面的“战利品”和证据，夜莺和一众警员全部打包带回了局里。","style":3,"background":105,"log_type":1,"src_id":320102118,"trial_step":118}]}