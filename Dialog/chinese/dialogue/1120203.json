{"id":1120203,"chapter_id":1120203,"scene_id":1,"steps":[{"step":1,"content":"“请你……相信我！”","style":3,"background":10000,"log_type":1,"src_id":220203001,"trial_step":1},{"step":2,"content":"温蒂看着受伤也依旧拥抱着自己的人，慢慢地放下了手中的武器。","style":3,"background":1019,"log_type":1,"src_id":220203002,"trial_step":2},{"step":3,"content":"见温蒂的情绪平静下来，你带着她走到僻静处，让她好好休息。","style":3,"background":1019,"log_type":1,"src_id":220203003,"trial_step":3},{"step":4,"content":"自己则开始尝试重连通讯。","style":3,"background":1019,"log_type":1,"src_id":220203004,"trial_step":4},{"step":5,"options":["打开通讯"],"style":6,"background":1019,"log_type":1,"src_id":220203005,"trial_step":5,"course":3,"choices":[{"text":"打开通讯","goto":6}]},{"step":6,"speaker":"夜莺","content":"局长，您没事吧？","style":11,"background":1019,"log_type":1,"src_id":220203006,"trial_step":6},{"step":7,"content":"嗯，一切正常。","style":11,"background":1019,"log_type":1,"src_id":220203007,"trial_step":7},{"step":8,"speaker":"夜莺","content":"监测数据显示你的肩膀处有血液流失，禁闭者的情绪状态也在临界点，这叫一切正常吗？","style":11,"background":1019,"log_type":1,"src_id":220203008,"trial_step":8},{"step":9,"content":"相信我，夜莺，这不是温蒂的错，我没事。","style":11,"background":1019,"log_type":1,"src_id":220203009,"trial_step":9},{"step":10,"content":"通讯中，你简短而精准地概括了一下方才发生的事情，夜莺沉默半晌，准许了你在室外与温蒂单独问话的要求。","style":3,"background":1019,"log_type":1,"src_id":220203010,"trial_step":10},{"step":11,"speaker":"夜莺","content":"情况我了解了，支援小队会马上出发，回收你们抓住的那两人。","style":11,"background":1019,"log_type":1,"src_id":220203011,"trial_step":11},{"step":12,"speaker":"夜莺","content":"她对锈河的判断很精准也很了解，战斗也非常利落……您要清楚，S-084虽暂时洗脱这个事件的嫌疑，但她仍处在精神极不安定的状态。局长，这样很危险。","style":11,"background":1019,"log_type":1,"src_id":220203012,"trial_step":12},{"step":13,"options":["拜托你了"],"style":6,"background":1019,"log_type":1,"src_id":220203013,"trial_step":13,"course":3,"choices":[{"text":"拜托你了","goto":14}]},{"step":14,"speaker":"夜莺","content":"……我明白了。我会关闭监听设备，但如果遇到任何危险，请务必与我联系。","style":11,"background":1019,"log_type":1,"src_id":220203014,"trial_step":14},{"step":15,"content":"回到温蒂身边时，她正安静地坐在地上，手和脸一片污糟，毫无表情的面容看上去，倒确实有几分“送葬人”的风格来。","style":3,"background":1019,"log_type":1,"src_id":220203015,"trial_step":15},{"step":16,"options":["先休息一下吧"],"style":6,"background":1019,"log_type":1,"src_id":220203016,"trial_step":16,"course":3,"choices":[{"text":"先休息一下吧","goto":17}]},{"step":17,"content":"温蒂没有回答，只是安静地点点头。","style":3,"background":1019,"log_type":1,"src_id":220203017,"trial_step":17},{"step":18,"options":["询问温蒂"],"style":6,"background":1019,"log_type":1,"src_id":220203018,"trial_step":18,"course":3,"choices":[{"text":"询问温蒂","goto":19}]},{"step":19,"content":"温蒂，你和你的同伴是在阻止死役扩散，对吗。","style":2,"background":1019,"log_type":1,"src_id":220203019,"trial_step":19},{"step":20,"content":"你看得出来，比起贩卖，温蒂是在解决买卖死役事件的人；而送葬人也并非是叛逃者的团队称呼，是当年秘密污染清理部队的别称。","style":3,"background":1019,"log_type":1,"src_id":220203020,"trial_step":20},{"step":21,"speaker":"温蒂","content":"哈……你现在才意识到？","style":1,"background":1019,"log_type":1,"src_id":220203021,"trial_step":21},{"step":22,"speaker":"温蒂","content":"我可是送葬人啊。","style":1,"background":1019,"log_type":1,"src_id":220203022,"trial_step":22},{"step":23,"speaker":"温蒂","content":"这是我的信条。","style":1,"background":1019,"log_type":1,"src_id":220203023,"trial_step":23},{"step":24,"options":["我知道的"],"style":6,"background":1019,"log_type":1,"src_id":220203024,"trial_step":24,"course":3,"choices":[{"text":"我知道的","goto":25}]},{"step":25,"content":"你是坚守信条的送葬人。","style":2,"background":1019,"log_type":1,"src_id":220203025,"trial_step":25},{"step":26,"content":"但我也只是想更加了解你……以及你拥有的真相。","style":2,"background":1019,"log_type":1,"src_id":220203026,"trial_step":26},{"step":27,"speaker":"温蒂","content":"真相……你现在所看到的，便是真相！","style":1,"background":1019,"log_type":1,"src_id":220203027,"trial_step":27},{"step":28,"content":"我现在只能看到你，温蒂。","style":2,"background":1019,"log_type":1,"src_id":220203028,"trial_step":28},{"step":29,"content":"你愿意，再向我说些以前的故事吗？","style":2,"background":1019,"log_type":1,"src_id":220203029,"trial_step":29},{"step":30,"speaker":"温蒂","content":"为什么……对我这么感兴趣。","style":1,"background":1019,"log_type":1,"src_id":220203030,"trial_step":30},{"step":31,"content":"我想，这大概是成为“值得托付的同伴”的其中一环吧。","style":2,"background":1019,"log_type":1,"src_id":220203031,"trial_step":31},{"step":32,"content":"或许是再次被同伴这一词所打动，温蒂在安抚之中沉默了半晌，幽幽开口。","style":3,"background":1019,"log_type":1,"src_id":220203032,"trial_step":32},{"step":33,"speaker":"温蒂","content":"我是被那个人收养的孤儿，注定是要成为送葬人的……","style":1,"background":1019,"log_type":1,"src_id":220203033,"trial_step":33},{"step":34,"speaker":"温蒂","content":"在那里，大家都一样，都是没有前路的人。","style":1,"background":1019,"log_type":1,"src_id":220203034,"trial_step":34},{"step":35,"speaker":"温蒂","content":"我们的衣服破破烂烂……受伤了也没有药品，伤口暴露在污染之中，一点点蚕食我们……","style":1,"background":1019,"log_type":1,"src_id":220203035,"trial_step":35},{"step":36,"speaker":"温蒂","content":"每一天都要面对怪物的威胁，还有……那些污染，那些疯狂的念头……","style":1,"background":1019,"log_type":1,"src_id":220203036,"trial_step":36},{"step":37,"options":["你是说……感染？"],"style":6,"background":1019,"log_type":1,"src_id":220203037,"trial_step":37,"course":3,"choices":[{"text":"你是说……感染？","goto":38}]},{"step":38,"speaker":"温蒂","content":"是啊，是啊……我们的工作就是处理污秽，那么多的污秽，每天每天，眼睛慢慢看不清东西，脑子里有人不停地说话……","style":1,"background":1019,"log_type":1,"src_id":220203038,"trial_step":38},{"step":39,"speaker":"温蒂","content":"我甚至觉得……自己是不是也是躺在刀下的怪物……哈哈……我们迟早会疯掉……","style":1,"background":1019,"log_type":1,"src_id":220203039,"trial_step":39},{"step":40,"speaker":"温蒂","content":"但是……大家说，没关系……","style":1,"background":1019,"log_type":1,"src_id":220203040,"trial_step":40},{"step":41,"speaker":"温蒂","content":"大家说，正因为污染夺走了我们的一切，才更不能让它夺走更多人的幸福。","style":1,"background":1019,"log_type":1,"src_id":220203041,"trial_step":41},{"step":42,"speaker":"温蒂","content":"因为我们已经没什么可再被夺走，所以最适合做这么伟大的工作。","style":1,"background":1019,"log_type":1,"src_id":220203042,"trial_step":42},{"step":43,"speaker":"温蒂","content":"大家说……正因为找到了这么伟大的工作，我们这些已死之人才会找到活着的意义……","style":1,"background":1019,"log_type":1,"src_id":220203043,"trial_step":43},{"step":44,"speaker":"温蒂","content":"瞧，他们是不是世界上最高尚、最伟大的人？","style":1,"background":1019,"log_type":1,"src_id":220203044,"trial_step":44},{"step":45,"content":"温蒂轻轻笑了一下，那是个温暖的笑容，却看上去无比悲伤。","style":3,"background":1019,"log_type":1,"src_id":220203045,"trial_step":45},{"step":46,"speaker":"温蒂","content":"曾经……队长也是这么对我说的……","style":1,"background":1019,"log_type":1,"src_id":220203046,"trial_step":46},{"step":47,"speaker":"温蒂","content":"他说，我们的牺牲都是有价值的，会有人感谢我们……我们会作为狄斯城的英雄被人记住……","style":1,"background":1019,"log_type":1,"src_id":220203047,"trial_step":47},{"step":48,"speaker":"温蒂","content":"哈哈……笨蛋……为什么要别人的感谢呢……我们有彼此难道还不够吗？","style":1,"background":1019,"log_type":1,"src_id":220203048,"trial_step":48},{"step":49,"speaker":"温蒂","content":"那些人懂什么是危险吗？懂什么是污染吗？！","style":1,"background":1019,"log_type":1,"src_id":220203049,"trial_step":49},{"step":50,"speaker":"温蒂","content":"那些小偷也是，肮脏，龌龊……我们是为了对抗污染，不是为了要他们的脏钱！还有那些虚伪的感谢！","style":1,"background":1019,"log_type":1,"src_id":220203050,"trial_step":50},{"step":51,"speaker":"温蒂","content":"可就为了那些无关紧要的家伙，那个队长背叛了我们所有人……","style":1,"background":1019,"log_type":1,"src_id":220203051,"trial_step":51},{"step":52,"content":"温蒂的声音又些许哽咽，却固执地要继续说下去。","style":3,"background":1019,"log_type":1,"src_id":220203052,"trial_step":52},{"step":53,"speaker":"温蒂","content":"这些对他来说太残忍了……","style":1,"background":1019,"log_type":1,"src_id":220203053,"trial_step":53},{"step":54,"speaker":"温蒂","content":"我的朋友，同伴……被带走前，红着眼，流着泪……却止不住地……疯狂地笑着。","style":1,"background":1019,"log_type":1,"src_id":220203054,"trial_step":54},{"step":55,"speaker":"温蒂","content":"我也问过他，问过那个人，队长……","style":1,"background":1019,"log_type":1,"src_id":220203055,"trial_step":55},{"step":56,"speaker":"温蒂","content":"他说没办法，不行，那些人不准。","style":1,"background":1019,"log_type":1,"src_id":220203056,"trial_step":56},{"step":57,"speaker":"温蒂","content":"我想知道，为什么“上面的人”不能保护他，保护我们！","style":1,"background":1019,"log_type":1,"src_id":220203057,"trial_step":57},{"step":58,"speaker":"温蒂","content":"所以我那天，才跟着他身后，想问个清楚。","style":1,"background":1019,"log_type":1,"src_id":220203058,"trial_step":58},{"step":59,"content":"温蒂看向晕倒在地的人，话语间满是愤恨。","style":3,"background":1019,"log_type":1,"src_id":220203059,"trial_step":59},{"step":60,"speaker":"温蒂","content":"从他们的谈话中，才知道，在那些人眼里，我们根本不值一提……早就被安排了死亡的结局。","style":1,"background":1019,"log_type":1,"src_id":220203060,"trial_step":60},{"step":61,"speaker":"温蒂","content":"我们不过是些没有出路的杂碎！像我们这样的蛆虫要多少有多少！","style":1,"background":1019,"log_type":1,"src_id":220203061,"trial_step":61},{"step":62,"speaker":"温蒂","content":"用完一批还有一批，没必要穿那么好的装备！","style":1,"background":1019,"log_type":1,"src_id":220203062,"trial_step":62},{"step":63,"speaker":"温蒂","content":"背负责任的是我们，面对危险的是我们……可这些混蛋呢？！","style":1,"background":1019,"log_type":1,"src_id":220203063,"trial_step":63},{"step":64,"speaker":"温蒂","content":"这些混蛋，同流合污的垃圾，毫无人性的狗！","style":1,"background":1019,"log_type":1,"src_id":220203064,"trial_step":64},{"step":65,"speaker":"温蒂","content":"我要亲手……亲手惩罚他们！让他们也，痛苦、绝望！哈哈哈！！","style":1,"background":1019,"log_type":1,"src_id":220203065,"trial_step":65},{"step":66,"content":"温蒂的眼中渐渐蓄起泪水，顺着脸庞滴落在地上。","style":3,"background":1019,"log_type":1,"src_id":220203066,"trial_step":66},{"step":67,"content":"她咬着牙，一字一句地控诉着悲惨的过去，让人极为心疼。","style":3,"background":1019,"log_type":1,"src_id":220203067,"trial_step":67},{"step":68,"content":"你捧着她的手，轻轻地放在自己的心脏上方，希望她能感受到自己心脏的跳动。","style":3,"background":1019,"log_type":1,"src_id":220203068,"trial_step":68},{"step":69,"options":["我相信你"],"style":6,"background":1019,"log_type":1,"src_id":220203069,"trial_step":69,"course":3,"choices":[{"text":"我相信你","goto":70}]},{"step":70,"content":"谢谢你愿意相信我，告诉我这些，所以，我也相信你，温蒂。","style":2,"background":1019,"log_type":1,"src_id":220203070,"trial_step":70},{"step":71,"content":"很抱歉，让你回想起不好的事情……我一定会帮你和你的同伴……挽回清白。","style":2,"background":1019,"log_type":1,"src_id":220203071,"trial_step":71},{"step":72,"content":"所以，让我见见你的同伴，可以吗？","style":2,"background":1019,"log_type":1,"src_id":220203072,"trial_step":72},{"step":73,"speaker":"温蒂","content":"我的同伴……你要对他们做什么？！","style":1,"background":1019,"log_type":1,"src_id":220203073,"trial_step":73},{"step":74,"speaker":"温蒂","content":"关起来，套上枷锁，让他们再次陷入危险？！","style":1,"background":1019,"log_type":1,"src_id":220203074,"trial_step":74},{"step":75,"content":"不会的，温蒂，一定不会的……","style":2,"background":1019,"log_type":1,"src_id":220203075,"trial_step":75},{"step":76,"options":["我想帮你"],"style":6,"background":1019,"log_type":1,"src_id":220203076,"trial_step":76,"course":3,"choices":[{"text":"我想帮你","goto":77}]},{"step":77,"content":"你们没有背叛组织，相反还为此付出了这么多。","style":2,"background":1019,"log_type":1,"src_id":220203077,"trial_step":77},{"step":78,"content":"我不会让你们就此埋没在这里。","style":2,"background":1019,"log_type":1,"src_id":220203078,"trial_step":78},{"step":79,"speaker":"温蒂","content":"……","style":1,"background":1019,"log_type":1,"src_id":220203079,"trial_step":79},{"step":80,"content":"我有必要为你们争取应有的清白。","style":2,"background":1019,"log_type":1,"src_id":220203080,"trial_step":80},{"step":81,"content":"就当是……对你和你的同伴，为这个世界争取光明的感谢。","style":2,"background":1019,"log_type":1,"src_id":220203081,"trial_step":81},{"step":82,"speaker":"温蒂","content":"……","style":1,"background":1019,"log_type":1,"src_id":220203082,"trial_step":82},{"step":83,"speaker":"温蒂","content":"可是，我还能信任你们吗？","style":1,"background":1019,"log_type":1,"src_id":220203083,"trial_step":83},{"step":84,"options":["我希望你能"],"style":6,"background":1019,"log_type":1,"src_id":220203084,"trial_step":84,"course":3,"choices":[{"text":"我希望你能","goto":85}]},{"step":85,"content":"听到你的话，温蒂又沉默了许久，终于，像是听见了什么笑话一般，放声大笑。","style":3,"background":1019,"log_type":1,"src_id":220203085,"trial_step":85},{"step":86,"content":"她牵着你的手，在晨曦中将你带到方才那片土地上。","style":3,"background":1019,"log_type":1,"src_id":220203086,"trial_step":86},{"step":87,"speaker":"温蒂","content":"哈哈哈哈……！","style":1,"background":1019,"log_type":1,"src_id":220203087,"trial_step":87},{"step":88,"speaker":"温蒂","content":"是我的错，局长先生。","female_content":"是我的错，局长小姐。","style":1,"background":1019,"log_type":1,"src_id":220203088,"trial_step":88},{"step":89,"speaker":"温蒂","content":"我这就……带你去见见我的队友，局长。","style":1,"background":1019,"log_type":1,"src_id":220203089,"trial_step":89},{"step":90,"content":"温蒂就这样牵着手，带着你一直往前走着，你意识到，这个方向，是那两位贩尸人所说的，“南边”。","style":3,"background":1019,"log_type":1,"src_id":220203090,"trial_step":90},{"step":91,"content":"穿过腐尸的臭味，你们最终来到一片宁静的空地。","style":3,"background":1019,"log_type":1,"src_id":220203091,"trial_step":91},{"step":92,"speaker":"温蒂","content":"到了……","style":1,"background":1019,"log_type":1,"src_id":220203092,"trial_step":92},{"step":93,"speaker":"温蒂","content":"诺娃？约翰？你们醒了吗？","style":1,"background":1019,"log_type":1,"src_id":220203093,"trial_step":93},{"step":94,"speaker":"温蒂","content":"啊……不好意思，局长。他们太困了，没做好准备。进来吧，跟我一起等他们起床。","style":1,"background":1019,"log_type":1,"src_id":220203094,"trial_step":94},{"step":95,"speaker":"温蒂","content":"欢迎，来到送葬人的家。","style":1,"background":1019,"log_type":1,"src_id":220203095,"trial_step":95},{"step":96,"content":"她的声音格外地温柔，然而，在她称之为家的地方，没有人出来迎接。","style":3,"background":1019,"log_type":1,"src_id":220203096,"trial_step":96},{"step":97,"content":"借着鲜红的朝阳，你清楚地看到这个地方像是被人挖了好几个坑，再草草填上……","style":3,"background":1019,"log_type":1,"src_id":220203097,"trial_step":97},{"step":98,"content":"坑前摆放着奇奇怪怪的东西，像是互相依偎着安睡一般。","style":3,"background":1019,"log_type":1,"src_id":220203098,"trial_step":98},{"step":99,"speaker":"温蒂","content":"来，你来，不过……要小声一点……","style":1,"background":1019,"log_type":1,"src_id":220203099,"trial_step":99},{"step":100,"content":"温蒂的声音降低，朝你比了个安静的手势。","style":3,"background":1019,"log_type":1,"src_id":220203100,"trial_step":100},{"step":101,"speaker":"温蒂","content":"他们都累了，让他们好好休息。","style":1,"background":1019,"log_type":1,"src_id":220203101,"trial_step":101},{"step":102,"speaker":"温蒂","content":"我小声一点，给你介绍一下他们。","style":1,"background":1019,"log_type":1,"src_id":220203102,"trial_step":102},{"step":103,"speaker":"温蒂","content":"这是诺娃，一个傻大个儿，让他睡进床上的时候我差点抬不动他。明明我们每天吃的都是一样的。","style":1,"background":1019,"log_type":1,"src_id":220203103,"trial_step":103},{"step":104,"speaker":"温蒂","content":"还有这个，我镶了石头的那个！","style":1,"background":1019,"log_type":1,"src_id":220203104,"trial_step":104},{"step":105,"content":"温蒂指着另一个坑，上面歪七扭八地撒着数颗锈河边随处可见的小石子。","style":3,"background":1019,"log_type":1,"src_id":220203105,"trial_step":105},{"step":106,"speaker":"温蒂","content":"他叫约翰，是个连数字都不会数的孤儿，但是自己送葬了几个死役，倒是记得特别清楚。","style":1,"background":1019,"log_type":1,"src_id":220203106,"trial_step":106},{"step":107,"speaker":"温蒂","content":"每送葬一个，就找颗石头记下，随身带着……那些石头，我放在他的枕边了！","style":1,"background":1019,"log_type":1,"src_id":220203107,"trial_step":107},{"step":108,"speaker":"温蒂","content":"不过他这次还要求我加多一个石头进去，说，等他完全变成死役的时候，会自己将自己送葬……","style":1,"background":1019,"log_type":1,"src_id":220203108,"trial_step":108},{"step":109,"speaker":"温蒂","content":"但我没加，我看他就是太累了，好好睡一觉就不会想这些有的没的了。","style":1,"background":1019,"log_type":1,"src_id":220203109,"trial_step":109},{"step":110,"speaker":"温蒂","content":"然后是她……我可怜的莉莉……","style":1,"background":1019,"log_type":1,"src_id":220203110,"trial_step":110},{"step":111,"speaker":"温蒂","content":"她是菲诺的好朋友，可是她却眼睁睁地看着菲诺一点点变异……无法拯救。最后和我一起亲手将菲诺送葬……","style":1,"background":1019,"log_type":1,"src_id":220203111,"trial_step":111},{"step":112,"speaker":"温蒂","content":"我好不容易才把她哄睡，你可千万不要吵醒她，不然，她醒来又要哭了。","style":1,"background":1019,"log_type":1,"src_id":220203112,"trial_step":112},{"step":113,"content":"温蒂轻轻地拍了拍那个坑，就像哄着孩子睡觉一般。","style":3,"background":1019,"log_type":1,"src_id":220203113,"trial_step":113},{"step":114,"speaker":"温蒂","content":"而我……我的床在这里~","style":1,"background":1019,"log_type":1,"src_id":220203114,"trial_step":114},{"step":115,"content":"她指向一排土坑的尽头，新挖的一个见方的浅坑，温蒂躺了进去，蜷着身子向你微笑。","style":3,"background":1019,"log_type":1,"src_id":220203115,"trial_step":115},{"step":116,"speaker":"温蒂","content":"我每天都睡在这里，和她们一起。可惜他们总是赖床，每次只有我一个人醒来。","style":1,"background":1019,"log_type":1,"src_id":220203116,"trial_step":116},{"step":117,"options":["告诉温蒂真相"],"style":6,"background":1019,"log_type":1,"src_id":220203117,"trial_step":117,"course":3,"choices":[{"text":"告诉温蒂真相","goto":118}]},{"step":118,"content":"温蒂……你不能和他们一起睡……","style":2,"background":1019,"log_type":1,"src_id":220203118,"trial_step":118},{"step":119,"content":"他们……已经死了。","style":2,"background":1019,"log_type":1,"src_id":220203119,"trial_step":119},{"step":120,"speaker":"温蒂","content":"……","style":1,"background":1019,"log_type":1,"src_id":220203120,"trial_step":120},{"step":121,"speaker":"温蒂","content":"你是说……他们死了？！","style":1,"background":1019,"log_type":1,"src_id":220203121,"trial_step":121},{"step":122,"content":"对不起，温蒂。","style":2,"background":1019,"log_type":1,"src_id":220203122,"trial_step":122},{"step":123,"content":"那些人已经盯上了，他们的……他们不能再继续待在这里。","style":2,"background":1019,"log_type":1,"src_id":220203123,"trial_step":123},{"step":124,"speaker":"温蒂","content":"……","style":1,"background":1019,"log_type":1,"src_id":220203124,"trial_step":124},{"step":125,"content":"最好的方法，是将他们带离这里……","style":2,"background":1019,"log_type":1,"src_id":220203125,"trial_step":125},{"step":126,"speaker":"温蒂","content":"…………","style":1,"background":1019,"log_type":1,"src_id":220203126,"trial_step":126},{"step":127,"speaker":"温蒂","content":"你为什么要说他们死了……为什么要带走他们……","style":1,"background":1019,"log_type":1,"src_id":220203127,"trial_step":127},{"step":128,"speaker":"温蒂","content":"那个叛徒也是这么说的……你是不是也想要他们的尸体！","style":1,"background":1019,"log_type":1,"src_id":220203128,"trial_step":128},{"step":129,"speaker":"温蒂","content":"他们没有死！他们不会不会离开我！！","style":1,"background":1019,"log_type":1,"src_id":220203129,"trial_step":129},{"step":130,"content":"温蒂的精神再次崩溃，她的眼睛红得仿佛要滴出血来。","style":3,"background":1019,"log_type":1,"src_id":220203130,"trial_step":130},{"step":131,"content":"她哭着笑着，朝你怒吼道。","style":3,"background":1019,"log_type":1,"src_id":220203131,"trial_step":131},{"step":132,"speaker":"温蒂","content":"哈哈哈哈！我就知道，FAC的走狗！","style":1,"background":1019,"log_type":1,"src_id":220203132,"trial_step":132},{"step":133,"speaker":"温蒂","content":"你和他们一样！践踏我们！","style":1,"background":1019,"log_type":1,"src_id":220203133,"trial_step":133},{"step":134,"speaker":"温蒂","content":"我懂你们这些人的堕落想法！","style":1,"background":1019,"log_type":1,"src_id":220203134,"trial_step":134},{"step":135,"speaker":"温蒂","content":"但是总有一天……你会像当年的送葬人一样！","style":1,"background":1019,"log_type":1,"src_id":220203135,"trial_step":135},{"step":136,"speaker":"温蒂","content":"被亲人背叛……被所有人背叛！！！","style":1,"background":1019,"log_type":1,"src_id":220203136,"trial_step":136},{"step":137,"speaker":"温蒂","content":"亲眼看着所有人死亡……","style":1,"background":1019,"log_type":1,"src_id":220203137,"trial_step":137},{"step":138,"options":["道歉安抚"],"style":6,"background":1019,"log_type":1,"src_id":220203138,"trial_step":138,"course":3,"choices":[{"text":"道歉安抚","goto":139}]},{"step":139,"content":"抱歉，温蒂，我并不是想把你们分开。","style":2,"background":1019,"log_type":1,"src_id":220203139,"trial_step":139},{"step":140,"content":"你无视那指着你的电锯，缓步上前，慢慢按住她的手。","style":3,"background":1019,"log_type":1,"src_id":220203140,"trial_step":140},{"step":141,"speaker":"温蒂","content":"你不是我的同伴，别碰我……","style":1,"background":1019,"log_type":1,"src_id":220203141,"trial_step":141},{"step":142,"content":"但我不能把你留在这儿，让你孤身一人。","style":2,"background":1019,"log_type":1,"src_id":220203142,"trial_step":142},{"step":143,"speaker":"温蒂","content":"你胡说，大家都在我身边，送葬人永远都会在一起。","style":1,"background":1019,"log_type":1,"src_id":220203143,"trial_step":143},{"step":144,"speaker":"温蒂","content":"我要等他们醒来……","style":1,"background":1019,"log_type":1,"src_id":220203144,"trial_step":144},{"step":145,"options":["他们不会醒了"],"style":6,"background":1019,"log_type":1,"src_id":220203145,"trial_step":145,"course":3,"choices":[{"text":"他们不会醒了","goto":146}]},{"step":146,"content":"你其实也清楚这一点……","style":2,"background":1019,"log_type":1,"src_id":220203146,"trial_step":146},{"step":147,"speaker":"温蒂","content":"你闭嘴！","style":1,"background":1019,"log_type":1,"src_id":220203147,"trial_step":147},{"step":148,"content":"她怒道，眼睛却在回避你的目光，渐渐泛红，像在努力抗拒什么。","style":3,"background":1019,"log_type":1,"src_id":220203148,"trial_step":148},{"step":149,"content":"你看向她“每晚安睡”的浅坑。","style":3,"background":1019,"log_type":1,"src_id":220203149,"trial_step":149},{"step":150,"options":["那是你给自己的坟墓吧"],"style":6,"background":1019,"log_type":1,"src_id":220203150,"trial_step":150,"course":3,"choices":[{"text":"那是你给自己的坟墓吧","goto":151}]},{"step":151,"speaker":"温蒂","content":"……","style":1,"background":1019,"log_type":1,"src_id":220203151,"trial_step":151},{"step":152,"content":"你记得每一个人离开的日子，给他们布置了这么温馨的归宿，你给了他们所有人温暖的葬礼。","style":2,"background":1019,"log_type":1,"src_id":220203152,"trial_step":152},{"step":153,"content":"可是温蒂，你已经送走了所有人，有谁能安葬你呢？","style":2,"background":1019,"log_type":1,"src_id":220203153,"trial_step":153},{"step":154,"speaker":"温蒂","content":"……………………","style":1,"background":1019,"log_type":1,"src_id":220203154,"trial_step":154},{"step":155,"speaker":"温蒂","content":"呜呜——啊啊啊啊！！！！","style":1,"background":1019,"log_type":1,"src_id":220203155,"trial_step":155},{"step":156,"content":"她压抑着的哽咽终于爆发成悲鸣，链锯跌落在泥泞中，最后的送葬人跪倒在地，浑身颤抖。","style":3,"background":1019,"log_type":1,"src_id":220203156,"trial_step":156},{"step":157,"content":"你俯下身来，轻轻捧起她的脸，抹去她不断流出来的眼泪。","style":3,"background":1019,"log_type":1,"src_id":220203157,"trial_step":157},{"step":158,"speaker":"温蒂","content":"我是最后一个了，这世上不会再有新的送葬人。一切都会在我这里结束，我发过誓！","style":1,"background":1019,"log_type":1,"src_id":220203158,"trial_step":158},{"step":159,"speaker":"温蒂","content":"只要他们还在，我就能继续背负着送葬人的命运走下去……可那些混蛋还盯上了他们的尸骨……！！","style":1,"background":1019,"log_type":1,"src_id":220203159,"trial_step":159},{"step":160,"speaker":"温蒂","content":"我只有他们了啊——！","style":1,"background":1019,"log_type":1,"src_id":220203160,"trial_step":160},{"step":161,"content":"你将她拥入怀中，湿润的土地气味已经驱散了她身上的血腥味，就像一间久久未被人打开的房间。","style":3,"background":1019,"log_type":1,"src_id":220203161,"trial_step":161},{"step":162,"speaker":"温蒂","content":"让他们陪着我吧，不要夺走他们……好不好。","style":1,"background":1019,"log_type":1,"src_id":220203162,"trial_step":162},{"step":163,"options":["我答应你"],"style":6,"background":1019,"log_type":1,"src_id":220203163,"trial_step":163,"course":3,"choices":[{"text":"我答应你","goto":164}]},{"step":164,"content":"如果有一天，你……也要睡了，我送你回到他们身边……我可以答应你这一点。","style":2,"background":1019,"log_type":1,"src_id":220203164,"trial_step":164},{"step":165,"content":"但现在你还活着……你还是人类，温蒂，在你活着的时候，待在我身边，好吗？","style":2,"background":1019,"log_type":1,"src_id":220203165,"trial_step":165},{"step":166,"speaker":"温蒂","content":"……为什么？","style":1,"background":1019,"log_type":1,"src_id":220203166,"trial_step":166},{"step":167,"content":"我的心情跟你一样，我也无法承受失去同伴的痛苦。","style":2,"background":1019,"log_type":1,"src_id":220203167,"trial_step":167},{"step":168,"content":"如果我死了，你又会是什么心情呢？","style":2,"background":1019,"log_type":1,"src_id":220203168,"trial_step":168},{"step":169,"speaker":"温蒂","content":"！","style":1,"background":1019,"log_type":1,"src_id":220203169,"trial_step":169},{"step":170,"speaker":"温蒂","content":"不，我不希望你死，真的，我不会允许你死。","style":1,"background":1019,"log_type":1,"src_id":220203170,"trial_step":170},{"step":171,"speaker":"温蒂","content":"我不会给你送葬的，如果你死了……我就真的一无所有了……所以不准死！","style":1,"background":1019,"log_type":1,"src_id":220203171,"trial_step":171},{"step":172,"options":["抚摸她的头发"],"style":6,"background":1019,"log_type":1,"src_id":220203172,"trial_step":172,"course":3,"choices":[{"text":"抚摸她的头发","goto":173}]},{"step":173,"content":"嗯……我努力。谢谢你把我当同伴。","style":2,"background":1019,"log_type":1,"src_id":220203173,"trial_step":173},{"step":174,"content":"既然你背负着送葬人的命运，那直到你回到他们身边前……","style":2,"background":1019,"log_type":1,"src_id":220203174,"trial_step":174},{"step":175,"options":["让我与你共同背负吧"],"style":6,"background":1019,"log_type":1,"src_id":220203175,"trial_step":175,"course":3,"choices":[{"text":"让我与你共同背负吧","goto":176}]},{"step":176,"speaker":"温蒂","content":"……………………","style":1,"background":1019,"log_type":1,"src_id":220203176,"trial_step":176},{"step":177,"speaker":"温蒂","content":"好……我也答应你。","style":1,"background":1019,"log_type":1,"src_id":220203177,"trial_step":177},{"step":178,"speaker":"温蒂","content":"在他们来接我之前，你……就是我的归宿。","style":1,"background":1019,"log_type":1,"src_id":220203178,"trial_step":178},{"step":179,"content":"她的声音越来越小，慢慢合上了眼睛。漫长疲惫的一夜过去后，她在你怀里睡着了。","style":3,"background":1019,"log_type":1,"src_id":220203179,"trial_step":179},{"step":180,"content":"你拯救她了吗？","style":3,"background":1019,"log_type":1,"src_id":220203180,"trial_step":180},{"step":181,"content":"你不知道答案。","style":3,"background":1019,"log_type":1,"src_id":220203181,"trial_step":181},{"step":182,"content":"但至少今晚，她不用再回到那个狭小冰冷的坑洞，枕着死亡入睡。","style":3,"background":1019,"log_type":1,"src_id":220203182,"trial_step":182}]}