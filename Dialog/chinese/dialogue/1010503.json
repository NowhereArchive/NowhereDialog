{"id":1010503,"chapter_id":1010503,"scene_id":1,"steps":[{"step":1,"speaker":"老人","content":"别、别生气了……他也是为了你好……","voice":["vo_trial_10503_1_1"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503001,"trial_step":1},{"step":2,"content":"老人攥紧被单，近乎失控地撕扯着，嘴里念念有词。","style":3,"background":111,"log_type":1,"src_id":110503002,"trial_step":2},{"step":3,"speaker":"老人","content":"对，你看到了吧，这是他特意带回来的花……他带的……","voice":["vo_trial_10503_1_3"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503003,"trial_step":3},{"step":4,"content":"老人猛地转头，看向旁边挂着外套的衣架继续说道，脸色一时有些狰狞：","style":3,"background":111,"log_type":1,"src_id":110503004,"trial_step":4},{"step":5,"speaker":"老人","content":"臭小子！","voice":["vo_trial_10503_1_5"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503005,"trial_step":5},{"step":6,"speaker":"老人","content":"你说句话呀！你……非得等到死了才肯低头是不是？！","voice":["vo_trial_10503_1_6"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503006,"trial_step":6},{"step":7,"speaker":"老人","content":"你们就不能……平平安安地……","voice":["vo_trial_10503_1_7"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503007,"trial_step":7},{"step":8,"speaker":"老人","content":"平平安安地………………","voice":["vo_trial_10503_1_8"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503008,"trial_step":8},{"step":9,"content":"老人忽然不再说话了，愣愣地瘫坐在病床上。","style":3,"background":111,"log_type":1,"src_id":110503009,"trial_step":9},{"step":10,"content":"失焦的双眼中涌出泪，在她满是皱纹的脸上流淌。","style":3,"background":111,"log_type":1,"src_id":110503010,"trial_step":10},{"step":11,"options":["她是……？"],"style":6,"background":111,"log_type":1,"src_id":110503011,"trial_step":11,"course":3,"choices":[{"text":"她是……？","goto":12}]},{"step":12,"content":"摩尔的手扶着玻璃观察窗，没有转身。","style":3,"background":111,"log_type":1,"src_id":110503012,"trial_step":12},{"step":13,"speaker":"摩尔","content":"她是很多年前，一场不起眼的暗网袭击案幸存者。","voice":["vo_trial_10503_1_13"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503013,"trial_step":13},{"step":14,"content":"金属推车吱呀作响，打断了摩尔的独白。","style":3,"background":111,"log_type":1,"src_id":110503014,"trial_step":14},{"step":15,"content":"护士推着药品车来到病房门前。见到摩尔，仿佛看见救星一般加快速度走过来。","style":3,"background":111,"log_type":1,"src_id":110503015,"trial_step":15},{"step":16,"speaker":"护士","content":"摩尔，你总算来了。赫尼女士这几天状态很不好，不肯吃药，反抗得很厉害。","voice":["vo_trial_10503_1_16"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503016,"trial_step":16},{"step":17,"speaker":"护士","content":"你快帮帮忙，我们是真拿她没办法……","voice":["vo_trial_10503_1_17"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503017,"trial_step":17},{"step":18,"speaker":"摩尔","content":"嗯，我知道了。","voice":["vo_trial_10503_1_18"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503018,"trial_step":18},{"step":19,"content":"摩尔接过药物，推开病房的门，走了进去。","style":3,"background":111,"log_type":1,"src_id":110503019,"trial_step":19},{"step":20,"speaker":"摩尔","content":"奶奶，我来看你了。","voice":["vo_trial_10503_1_20"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503020,"trial_step":20},{"step":21,"speaker":"赫尼","content":"……你是谁？！","voice":["vo_trial_10503_1_21"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503021,"trial_step":21},{"step":22,"content":"老人充满希望地抬起头，看到来的人，却又警觉地向后缩了缩。","style":3,"background":111,"log_type":1,"src_id":110503022,"trial_step":22},{"step":23,"speaker":"赫尼","content":"你不是……你不是我的孩子……你是谁？！","voice":["vo_trial_10503_1_23"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503023,"trial_step":23},{"step":24,"speaker":"摩尔","content":"……","voice":["vo_trial_10503_1_24"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503024,"trial_step":24},{"step":25,"speaker":"摩尔","content":"我是住在你楼下的摩尔呀，奶奶。","voice":["vo_trial_10503_1_25"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503025,"trial_step":25},{"step":26,"speaker":"赫尼","content":"摩尔……是谁……不认识，我的孩子去哪儿了？","voice":["vo_trial_10503_1_26"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503026,"trial_step":26},{"step":27,"speaker":"摩尔","content":"他们还要过一会儿才会回来呢。我们先吃药好吗？","voice":["vo_trial_10503_1_27"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503027,"trial_step":27},{"step":28,"speaker":"赫尼","content":"哦……哦！对，他们下班晚……我得吃药……","voice":["vo_trial_10503_1_28"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503028,"trial_step":28},{"step":29,"content":"眼见老人低下头，摩尔凑过去，将药递到了她嘴边。","style":3,"background":111,"log_type":1,"src_id":110503029,"trial_step":29},{"step":30,"content":"忽然，老人抬起头，用力拨开摩尔的手。","style":3,"background":111,"log_type":1,"src_id":110503030,"trial_step":30},{"step":31,"speaker":"赫尼","content":"不对！他们不会来这里！……你是谁？为什么要骗我？！","voice":["vo_trial_10503_1_31"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503031,"trial_step":31},{"step":32,"content":"老人挥舞着手臂，摩尔伸过去的手被打红了，药片也被打翻在地。","style":3,"background":111,"log_type":1,"src_id":110503032,"trial_step":32},{"step":33,"speaker":"赫尼","content":"这里是哪里？……我要回家……要回家！我的孩子呢？！","voice":["vo_trial_10503_1_33"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503033,"trial_step":33},{"step":34,"content":"老人哭喊着，摩尔却只是轻轻抱住了她，轻轻拍打着她的后背，在她耳边轻声安慰着：","style":3,"background":111,"log_type":1,"src_id":110503034,"trial_step":34},{"step":35,"speaker":"摩尔","content":"没事的，别害怕……我在这里。","voice":["vo_trial_10503_1_35"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503035,"trial_step":35},{"step":36,"content":"剧烈的情绪起伏耗尽了老人的体力。很快，她不再挣扎，在摩尔的怀中安静下来。","style":3,"background":111,"log_type":1,"src_id":110503036,"trial_step":36},{"step":37,"content":"摩尔则很熟练地将药捧到老人嘴边，引导她吃下，接着轻轻拭去了老人面部的泪痕。","style":3,"background":111,"log_type":1,"src_id":110503037,"trial_step":37},{"step":38,"options":["……这位是……你的亲人？"],"style":6,"background":111,"log_type":1,"src_id":110503038,"trial_step":38,"course":3,"choices":[{"text":"……这位是……你的亲人？","goto":39}]},{"step":39,"speaker":"摩尔","content":"呵呵，在局长眼里，我们像一家人吗？","voice":["vo_trial_10503_1_39"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503039,"trial_step":39},{"step":40,"content":"她笑着反问，眼神却不曾看向你。","style":3,"background":111,"log_type":1,"src_id":110503040,"trial_step":40},{"step":41,"content":"很长的一段时间，摩尔就只是这样坐在床边，静静看着熟睡的老人。","style":3,"background":111,"log_type":1,"src_id":110503041,"trial_step":41},{"step":42,"speaker":"摩尔","content":"……她叫赫尼，只是我的邻居。","voice":["vo_trial_10503_1_42"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503042,"trial_step":42},{"step":43,"speaker":"摩尔","content":"我呀，一个人在外那么多年，自学程序，精进技术，很小的时候就能在网上接各种委托养活自己，买下的小公寓漂亮又安全，不需要出门我也能过得很好。","voice":["vo_trial_10503_1_43"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503043,"trial_step":43},{"step":44,"speaker":"摩尔","content":"但时间久了，生活也会出现一些小问题，比如……因为沉迷网络和数据，我经常会忘记吃饭、昼夜颠倒，不仅视力出了问题，还常常因为低血糖突然跌倒。","voice":["vo_trial_10503_1_44"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503044,"trial_step":44},{"step":45,"speaker":"摩尔","content":"你看，好多坏习惯都是那段日子养成的，那时的我可没有半点可靠社会人的模样呢。","voice":["vo_trial_10503_1_45"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503045,"trial_step":45},{"step":46,"content":"她笑着挽起袖子让你看手臂上各式各样的创可贴，各种图案样式不一，大概都是她的同事们看不下去帮她处理。","style":3,"background":111,"log_type":1,"src_id":110503046,"trial_step":46},{"step":47,"content":"感觉现在也不完全可靠……你压住内心的吐槽，继续听她往下说。","style":3,"background":111,"log_type":1,"src_id":110503047,"trial_step":47},{"step":48,"speaker":"摩尔","content":"后来，有一天，我接了一个很大的委托。通宵几天后做完了，我很高兴，终于能放松一下好好吃顿饭了。","voice":["vo_trial_10503_1_48"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503048,"trial_step":48},{"step":49,"speaker":"摩尔","content":"可我却忘记桌上的外卖已经是两天前送来的，那时很累，也没能吃出异味，然后……就是一场盛大的食物中毒了。","voice":["vo_trial_10503_1_49"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503049,"trial_step":49},{"step":50,"speaker":"摩尔","content":"那大概是我最接近死亡的时刻，整个世界在旋转……我都分不清自己在往哪儿走。到了最后，脑子里只剩下一个念头：是挣扎着出门求救？还是想回屋把最后的意识上传数据海。","voice":["vo_trial_10503_1_50"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503050,"trial_step":50},{"step":51,"options":["……你还挺幽默","还是好好活着吧"],"style":6,"background":111,"log_type":1,"src_id":110503051,"trial_step":51,"course":3,"choices":[{"text":"……你还挺幽默","goto":52},{"text":"还是好好活着吧","goto":null}]},{"step":52,"speaker":"摩尔","content":"哎呀，别担心，我这不好好活着，见到你了吗？","voice":["vo_trial_10503_1_52"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503052,"trial_step":52},{"step":53,"speaker":"摩尔","content":"还好……隔壁布鲁斯一家来了，猛拍我的大门，大声问我需不需要帮助。","voice":["vo_trial_10503_1_53"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503053,"trial_step":53},{"step":54,"speaker":"摩尔","content":"他们好像一直担心邻居这个不怎么出门的小姑娘，刚好当天路过我家门口，听到屋里跌跌撞撞又呕吐呻吟的声音，也顾不上别的就撞门进来了，然后我就被送去了医院……","voice":["vo_trial_10503_1_54"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503054,"trial_step":54},{"step":55,"speaker":"摩尔","content":"就是那天晚上，我好像被他们当成“放着不管就会自己偷偷死掉的小孩”，从此就把我拴在了身边。","voice":["vo_trial_10503_1_55"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503055,"trial_step":55},{"step":56,"speaker":"摩尔","content":"布鲁斯夫人把我的程序示例送进她任职的大学，推荐我入学，继续深造。毕业后，布鲁斯先生又推荐我进他的单位工作，想帮我“融入社会”。","voice":["vo_trial_10503_1_56"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503056,"trial_step":56},{"step":57,"speaker":"摩尔","content":"先是布鲁斯夫人接送我去学校，毕业后换先生载我上下班。他们说，一不看着我，一定会迷路、摔跤或者被拐走。","voice":["vo_trial_10503_1_57"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503057,"trial_step":57},{"step":58,"speaker":"摩尔","content":"奶奶包了我一日三餐，早上喊我起床，中午给我准备便当，晚上回去和他们一家共进晚餐……奶奶的手艺很好，比我点过的最贵的外卖都要美味一万倍。","voice":["vo_trial_10503_1_58"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503058,"trial_step":58},{"step":59,"speaker":"摩尔","content":"呵呵，我现在白白胖胖不再营养不良，都多亏了赫尼奶奶。","voice":["vo_trial_10503_1_59"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503059,"trial_step":59},{"step":60,"content":"她很少这么自顾自地滔滔不绝，说话间微风拂过，窗帘荡开了些，阳光透进落在摩尔的长发上，映得她的神情更加温暖柔和。","style":3,"background":111,"log_type":1,"src_id":110503060,"trial_step":60},{"step":61,"speaker":"摩尔","content":"其实，食物中毒的那天是我18岁生日。是他们替我问诊时发现的，我本来都忘记好多年了。","voice":["vo_trial_10503_1_61"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503061,"trial_step":61},{"step":62,"speaker":"摩尔","content":"那天奶奶还临时给我烤了个小蛋糕，当然，只能看，不能吃。","voice":["vo_trial_10503_1_62"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503062,"trial_step":62},{"step":63,"speaker":"选项","options":["……那的确是段美好的回忆。"],"style":6,"background":111,"log_type":1,"src_id":110503063,"trial_step":63,"course":3,"choices":[{"text":"……那的确是段美好的回忆。","goto":64}]},{"step":64,"content":"……回忆？看着眼前瘦削孤苦的老人，看着摩尔落寞的表情，你有种不祥的预感。","style":3,"background":111,"log_type":1,"src_id":110503064,"trial_step":64},{"step":65,"speaker":"局长","content":"……布鲁斯夫妇现在在哪儿？","style":2,"background":111,"log_type":1,"src_id":110503065,"trial_step":65},{"step":66,"speaker":"摩尔","content":"是啊……在哪儿呢？","voice":["vo_trial_10503_1_66"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503066,"trial_step":66},{"step":67,"content":"摩尔转过头，看向窗外。","style":3,"background":111,"log_type":1,"src_id":110503067,"trial_step":67},{"step":68,"speaker":"摩尔","content":"我也希望他们能回来，这样的话，奶奶才能恢复精神吧。","voice":["vo_trial_10503_1_68"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503068,"trial_step":68},{"step":69,"speaker":"局长","content":"难道说……","style":2,"background":111,"log_type":1,"src_id":110503069,"trial_step":69},{"step":70,"speaker":"摩尔","content":"毕业后，布鲁斯先生又推荐我进他的单位工作，想帮我“融入社会”。","voice":["vo_trial_10503_1_70"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503070,"trial_step":70},{"step":71,"speaker":"选项","options":["布鲁斯先生在网安工作？"],"style":6,"background":111,"log_type":1,"src_id":110503072,"trial_step":72,"course":3,"choices":[{"text":"布鲁斯先生在网安工作？","goto":73}]},{"step":72,"speaker":"局长","content":"难道他那时在调查暗网，然后被人——","style":2,"background":111,"log_type":1,"src_id":110503073,"trial_step":73},{"step":73,"content":"笑容还停在她脸上，只是渐渐失去了温度。","style":3,"background":111,"log_type":1,"src_id":110503074,"trial_step":74},{"step":74,"speaker":"摩尔","content":"110年，布鲁斯先生死于一场“意外”车祸，第二天后，夫人从公寓阳台一跃而下。","voice":["vo_trial_10503_1_75"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503075,"trial_step":75},{"step":75,"speaker":"摩尔","content":"当晚，布鲁斯家的电脑出了故障，引发了一起大火。一切都被烧成灰烬。","voice":["vo_trial_10503_1_76"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503076,"trial_step":76},{"step":76,"speaker":"摩尔","content":"而我那时接到一个重要的任务，在……呵呵……在加班。","voice":["vo_trial_10503_1_77"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503077,"trial_step":77},{"step":77,"speaker":"摩尔","content":"赶回去时，奶奶抱着儿子的遗像，看着火烧的公寓和被运走的儿媳，那时的她……","voice":["vo_trial_10503_1_78"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503078,"trial_step":78},{"step":78,"speaker":"摩尔","content":"已经认不出我了。","voice":["vo_trial_10503_1_79"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503079,"trial_step":79},{"step":79,"content":"第一次，在摩尔温柔的眼神之后，你看到了些别的东西。","style":3,"background":111,"log_type":1,"src_id":110503080,"trial_step":80},{"step":80,"speaker":"局长","content":"这之后四年，都是你在照顾她吗？","style":2,"background":111,"log_type":1,"src_id":110503081,"trial_step":81},{"step":81,"speaker":"摩尔","content":"……","voice":["vo_trial_10503_1_82"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503082,"trial_step":82},{"step":82,"content":"摩尔没有回答，只是静静看着床上躺着的奶奶。","style":3,"background":111,"log_type":1,"src_id":110503083,"trial_step":83},{"step":83,"content":"许久之后，她开口了。","style":3,"background":111,"log_type":1,"src_id":110503084,"trial_step":84},{"step":84,"speaker":"摩尔","content":"我喜欢指令、信息、逻辑、反馈，喜欢需求和挑战，借此探究边界和规则，窥探各种必然和操纵必然的可能。我喜欢自己身为程序员时候的状态。","voice":["vo_trial_10503_1_85"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503085,"trial_step":85},{"step":85,"speaker":"摩尔","content":"一个小屋，一台电脑，对我来说就已经足够了。从很小的时候开始，过去那么多年，一直到现在，我都这么相信着。只是……","voice":["vo_trial_10503_1_86"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503086,"trial_step":86},{"step":86,"speaker":"摩尔","content":"我不关心门外的世界，但总有人会敲开那扇门，放阳光进来，带我走进光中。","voice":["vo_trial_10503_1_87"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503087,"trial_step":87},{"step":87,"speaker":"摩尔","content":"我也不关心自己，不记得什么生日，但有那么几年，有一家人，每次都会郑重地为我庆祝，陪我一起度过。","voice":["vo_trial_10503_1_88"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503088,"trial_step":88},{"step":88,"speaker":"摩尔","content":"是他们带我走出了那个黑漆漆的小屋，带我进入社会，受到更多人的信任和照顾。现在，我已经成为一个真正可靠的人。","voice":["vo_trial_10503_1_89"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503089,"trial_step":89},{"step":89,"speaker":"摩尔","content":"……可我，再也走不进那个近在咫尺的家了。","voice":["vo_trial_10503_1_90"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503090,"trial_step":90},{"step":90,"content":"她终于抬头，看向你。","style":3,"background":111,"log_type":1,"src_id":110503091,"trial_step":91},{"step":91,"speaker":"摩尔","content":"早在110年那个雨夜，我心底的某一部分已经永远死去了。","voice":["vo_trial_10503_1_92"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503092,"trial_step":92},{"step":92,"content":"摩尔的目光回到了你身上，微微笑着。","style":3,"background":111,"log_type":1,"src_id":110503093,"trial_step":93},{"step":93,"speaker":"摩尔","content":"这就是我一直调查暗网的原因。","voice":["vo_trial_10503_1_94"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503094,"trial_step":94},{"step":94,"speaker":"摩尔","content":"还有什么……需要我解释的么？","voice":["vo_trial_10503_1_95"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503095,"trial_step":95},{"step":95,"speaker":"选项","options":["……不用了"],"style":6,"background":111,"log_type":1,"src_id":110503096,"trial_step":96,"course":3,"choices":[{"text":"……不用了","goto":97}]},{"step":96,"speaker":"局长","content":"你难得来看看她，我在这儿会打扰你们。","style":2,"background":111,"log_type":1,"src_id":110503097,"trial_step":97},{"step":97,"speaker":"摩尔","content":"不会的。我很高兴你能来，请再多陪我一段时间吧。","voice":["vo_trial_10503_1_98"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503098,"trial_step":98},{"step":98,"content":"她微微一笑，仍旧是那温暖纯净的笑容。可夕阳落在她身上，却又显出血一般的凄然。","style":3,"background":111,"log_type":1,"src_id":110503099,"trial_step":99},{"step":99,"speaker":"赫尼","content":"……！","voice":["vo_trial_10503_1_100"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503100,"trial_step":100},{"step":100,"content":"一旁的老人不知是不是做了噩梦，突然呻吟着爬起身。看见身旁的两人，又一声凄厉的尖叫，枯槁的身体猛地从床上弹起，挣扎，撞倒输液瓶眼看要滚下床。","style":3,"background":111,"log_type":1,"src_id":110503101,"trial_step":101},{"step":101,"content":"在她真正伤到自己前，摩尔抢先一步紧紧抱住老人，护着了她的身体。","style":3,"background":111,"log_type":1,"src_id":110503102,"trial_step":102},{"step":102,"content":"老人就这么被抱着，挣扎，歇斯底里地喊着。","style":3,"background":111,"log_type":1,"src_id":110503103,"trial_step":103},{"step":103,"speaker":"赫尼","content":"你在哪儿？我的孩子在哪儿！！别去那里，回来，回来啊！！","voice":["vo_trial_10503_1_104"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503104,"trial_step":104},{"step":104,"speaker":"摩尔","content":"他们会回来的，奶奶，会的。在这儿等他们好吗？","voice":["vo_trial_10503_1_105"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503105,"trial_step":105},{"step":105,"speaker":"摩尔","content":"晚饭时间快到了，我跟你一起等他们回来。","voice":["vo_trial_10503_1_106"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503106,"trial_step":106},{"step":106,"content":"老人听不懂，只是自顾自地哭喊挣扎。","style":3,"background":111,"log_type":1,"src_id":110503107,"trial_step":107},{"step":107,"speaker":"赫尼","content":"把他们还给我——！！","voice":["vo_trial_10503_1_108"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503108,"trial_step":108},{"step":108,"content":"护士们闻声赶来，带着绷带、镇定剂、输液袋还有些许无奈和不忍。摩尔就这么紧紧抱着老人，背对着你，你看不到她的表情。","style":3,"background":111,"log_type":1,"src_id":110503109,"trial_step":109},{"step":109,"content":"但余晖勾勒出的颤抖的肩头如此明显，你听到几不可闻的请求，对你的请求。","style":3,"background":111,"log_type":1,"src_id":110503110,"trial_step":110},{"step":110,"speaker":"摩尔","content":"我想……再留在这儿一会儿，请让我……多陪她一段时间。","voice":["vo_trial_10503_1_111"],"voice_bank":"vo_moore_trial","style":1,"background":111,"log_type":1,"src_id":110503111,"trial_step":111},{"step":111,"content":"23:41 \nMBCC局长办公室","style":9,"background":10000,"log_type":1,"src_id":110503113,"trial_step":113},{"step":112,"content":"摩尔暂时留在了疗养院。在连续的高强度工作之后，这也算是给她放了一个短假。","style":3,"background":1040,"log_type":1,"src_id":110503114,"trial_step":114},{"step":113,"content":"至于你，则回到了MBCC。早些时候的会议已经收获了一些成效，桌面上堆积着不少来自各个部门的状况报告。","style":3,"background":1040,"log_type":1,"src_id":110503115,"trial_step":115},{"step":114,"content":"你一眼就看到了第九机关的报道，打开之后迅速阅读，几条关键情报引起了你的注意。","style":3,"background":1040,"log_type":1,"src_id":110503116,"trial_step":116},{"step":115,"content":"“当前已经大致划定了暗网服务器可能存在的区域，排查正在进行中。”","style":3,"background":1040,"log_type":1,"src_id":110503117,"trial_step":117},{"step":116,"content":"“不过，暗网幕后的势力并没有露出更多破绽。真正定位到服务器的具体位置，尚需相当长的时间。人力也存在较大缺口……”","style":3,"background":1040,"log_type":1,"src_id":110503118,"trial_step":118},{"step":117,"content":"你阅读着报告，顿时感觉需要和第九机关谈谈，于是拨通了他们的电话。","style":3,"background":1040,"log_type":1,"src_id":110503119,"trial_step":119},{"step":118,"options":["是我怠慢了主要任务"],"style":6,"background":1040,"log_type":1,"src_id":110503120,"trial_step":120,"course":3,"choices":[{"text":"是我怠慢了主要任务","goto":121}]},{"step":119,"speaker":"局长","content":"抱歉，没想到实际搜查时这么困难，我立刻加派人手……","style":2,"background":1040,"log_type":1,"src_id":110503121,"trial_step":121},{"step":120,"speaker":"9th人员","content":"不用自责，局长，您花在摩尔身上的所有时间都是值得的。","voice":["vo_trial_10503_1_122"],"voice_bank":"vo_moore_trial","style":11,"background":1040,"log_type":1,"src_id":110503122,"trial_step":122},{"step":121,"speaker":"9th人员","content":"说不定对暗网行动来说，这才是最佳的解决路径。","voice":["vo_trial_10503_1_123"],"voice_bank":"vo_moore_trial","style":11,"background":1040,"log_type":1,"src_id":110503123,"trial_step":123},{"step":122,"content":"你顿了顿，消化着特务朋友的这句话，好一会儿，开口问道。","style":3,"background":1040,"log_type":1,"src_id":110503124,"trial_step":124},{"step":123,"speaker":"局长","content":"因为她有能力？还是因为她有嫌疑？","style":2,"background":1040,"log_type":1,"src_id":110503125,"trial_step":125},{"step":124,"content":"他不可置否地笑笑。","style":3,"background":1040,"log_type":1,"src_id":110503126,"trial_step":126},{"step":125,"speaker":"9th人员","content":"这要问您了。","voice":["vo_trial_10503_1_127"],"voice_bank":"vo_moore_trial","style":11,"background":1040,"log_type":1,"src_id":110503127,"trial_step":127},{"step":126,"speaker":"9th人员","content":"对狄斯暗网的关系人我们一直保持监视，也查出过间谍。但摩尔小姐没有表现出任何可疑行径。她要么真的无辜，要么藏得足够深，深到连我们都无法察觉。","voice":["vo_trial_10503_1_128"],"voice_bank":"vo_moore_trial","style":11,"background":1040,"log_type":1,"src_id":110503128,"trial_step":128},{"step":127,"speaker":"9th人员","content":"您看，第九机关必须永远对他人保持怀疑，但怀疑不等于真相，如果可以的话，我们也希望摒弃嫌隙，跟一位真正出色的人才合作。","voice":["vo_trial_10503_1_129"],"voice_bank":"vo_moore_trial","style":11,"background":1040,"log_type":1,"src_id":110503129,"trial_step":129},{"step":128,"speaker":"9th人员","content":"所以局长，这次我们想听您的判断。观察她这么久，您有什么结论吗？","voice":["vo_trial_10503_1_130"],"voice_bank":"vo_moore_trial","style":11,"background":1040,"log_type":1,"src_id":110503130,"trial_step":130},{"step":129,"options":["……我不知道"],"style":6,"background":1040,"log_type":1,"src_id":110503131,"trial_step":131,"course":3,"choices":[{"text":"……我不知道","goto":132}]},{"step":130,"speaker":"局长","content":"连你们都没法确定的事，我才介入几天，同样无法下结论。有太多的可能了，很难有足够的时间去慢慢验证……","style":2,"background":1040,"log_type":1,"src_id":110503132,"trial_step":132},{"step":131,"speaker":"局长","content":"但我想，有一件事是我现在能做、也必须做的……","style":2,"background":1040,"log_type":1,"src_id":110503133,"trial_step":133},{"step":132,"content":"你拿起终端，拨通副官办公室。","style":3,"background":1040,"log_type":1,"src_id":110503134,"trial_step":134},{"step":133,"speaker":"局长","content":"夜莺，帮我联系一个人。嗯……是他……对。","style":2,"background":1040,"log_type":1,"src_id":110503135,"trial_step":135},{"step":134,"speaker":"局长","content":"请尽快。","style":2,"background":1040,"log_type":1,"src_id":110503136,"trial_step":136},{"step":135,"content":"电话挂断，办公室里再无声息。你在昏暗的办公室里安静地思索了好几分钟。","style":3,"background":1040,"log_type":1,"src_id":110503137,"trial_step":137},{"step":136,"content":"终于，一个计划在心底酝酿。","style":3,"background":1040,"log_type":1,"src_id":110503138,"trial_step":138},{"step":137,"content":"█月█日\n14:32 MBCC局长办公室","style":9,"background":10000,"log_type":1,"src_id":110503140,"trial_step":140},{"step":138,"speaker":"摩尔","content":"诶？治、治疗？","voice":["vo_trial_10503_1_141"],"voice_bank":"vo_moore_trial","style":1,"background":1040,"log_type":1,"src_id":110503141,"trial_step":141},{"step":139,"content":"摩尔从她的工作站中抬起头，你所说的话让她吃了一惊。","style":3,"background":1040,"log_type":1,"src_id":110503142,"trial_step":142},{"step":140,"speaker":"局长","content":"没错，自从拜访疗养院那天起，我一直就很在意赫尼女士……你那位邻居奶奶的病情。","style":2,"background":1040,"log_type":1,"src_id":110503143,"trial_step":143},{"step":141,"speaker":"局长","content":"所以我这几天联系了一个医疗团队。去年BR-002事件之后，他们治愈过很多西区的狂厄病人，对轻度狂厄症导致的精神失常这方面非常有经验。","style":2,"background":1040,"log_type":1,"src_id":110503144,"trial_step":144},{"step":142,"speaker":"局长","content":"我跟他们聊了聊，主治医生觉得赫尼女士的情况有很大概率可以治愈，并且给出了具体的治疗方案。","style":2,"background":1040,"log_type":1,"src_id":110503145,"trial_step":145},{"step":143,"speaker":"局长","content":"……摩尔，你怎么看？","style":2,"background":1040,"log_type":1,"src_id":110503146,"trial_step":146},{"step":144,"speaker":"摩尔","content":"……","voice":["vo_trial_10503_1_147"],"voice_bank":"vo_moore_trial","style":1,"background":1040,"log_type":1,"src_id":110503147,"trial_step":147},{"step":145,"speaker":"局长","content":"我和这个医疗团队有过多次合作。他们的水平非常可靠。治疗费用方面也不需要担心……","style":2,"background":1040,"log_type":1,"src_id":110503148,"trial_step":148},{"step":146,"speaker":"摩尔","content":"我……不是在担心这些。","voice":["vo_trial_10503_1_149"],"voice_bank":"vo_moore_trial","style":1,"background":1040,"log_type":1,"src_id":110503149,"trial_step":149},{"step":147,"content":"摩尔的笑容背后，多了些迷茫。","style":3,"background":1040,"log_type":1,"src_id":110503150,"trial_step":150},{"step":148,"speaker":"摩尔","content":"我每天都在希望奶奶她能被治好，希望她恢复正常，能够回想起我。","voice":["vo_trial_10503_1_151"],"voice_bank":"vo_moore_trial","style":1,"background":1040,"log_type":1,"src_id":110503151,"trial_step":151},{"step":149,"speaker":"摩尔","content":"可你告诉我，奶奶真的能被治好了，我却突然觉得有些……害怕。","voice":["vo_trial_10503_1_152"],"voice_bank":"vo_moore_trial","style":1,"background":1040,"log_type":1,"src_id":110503152,"trial_step":152},{"step":150,"speaker":"局长","content":"害怕？","style":2,"background":1040,"log_type":1,"src_id":110503153,"trial_step":153},{"step":151,"speaker":"摩尔","content":"是的，害怕，害怕奶奶清醒过来以后又发现，她的孩子，她最亲近的家人们……都已经不在了。","voice":["vo_trial_10503_1_154"],"voice_bank":"vo_moore_trial","style":1,"background":1040,"log_type":1,"src_id":110503154,"trial_step":154},{"step":152,"speaker":"摩尔","content":"这种清醒的痛苦，真的是她想要的么。","voice":["vo_trial_10503_1_155"],"voice_bank":"vo_moore_trial","style":1,"background":1040,"log_type":1,"src_id":110503155,"trial_step":155},{"step":153,"options":["你也是她的家人"],"style":6,"background":1040,"log_type":1,"src_id":110503156,"trial_step":156,"course":3,"choices":[{"text":"你也是她的家人","goto":157}]},{"step":154,"speaker":"局长","content":"现在的她也始终活在噩梦里，也许向前一步，还有解脱的可能。","style":2,"background":1040,"log_type":1,"src_id":110503157,"trial_step":157},{"step":155,"speaker":"局长","content":"而且……你也是她的家人。你可以支撑她走出噩梦。","style":2,"background":1040,"log_type":1,"src_id":110503158,"trial_step":158},{"step":156,"content":"摩尔看着你，沉默片刻之后，她笑了。","style":3,"background":1040,"log_type":1,"src_id":110503159,"trial_step":159},{"step":157,"speaker":"摩尔","content":"……嗯，你说得对。我怎么把这件事都给忘了呢。","voice":["vo_trial_10503_1_160"],"voice_bank":"vo_moore_trial","style":1,"background":1040,"log_type":1,"src_id":110503160,"trial_step":160},{"step":158,"speaker":"摩尔","content":"是啊，我也是奶奶的家人。","voice":["vo_trial_10503_1_161"],"voice_bank":"vo_moore_trial","style":1,"background":1040,"log_type":1,"src_id":110503161,"trial_step":161},{"step":159,"speaker":"摩尔","content":"我会一直陪在奶奶身边，就像过去他们帮助我一样，帮助她，照顾她……","voice":["vo_trial_10503_1_162"],"voice_bank":"vo_moore_trial","style":1,"background":1040,"log_type":1,"src_id":110503162,"trial_step":162},{"step":160,"content":"摩尔说着，那情形情就像是在说服她自己。","style":3,"background":1040,"log_type":1,"src_id":110503163,"trial_step":163},{"step":161,"speaker":"局长","content":"既然你都同意了，我现在就去通知医疗团队。","style":2,"background":1040,"log_type":1,"src_id":110503164,"trial_step":164},{"step":162,"speaker":"局长","content":"今天办理转院的话，明天就可以进行手术了。医生说术后治疗用不了多久，顺利的话，赫尼女士她明天晚上就能记起你了哦。","style":2,"background":1040,"log_type":1,"src_id":110503165,"trial_step":165},{"step":163,"content":"你一边说着，一边将写有老人转院地址的字条递了过去。","style":3,"background":1040,"log_type":1,"src_id":110503166,"trial_step":166},{"step":164,"speaker":"局长","content":"明天手术的时候，你就过去陪她吧。","style":2,"background":1040,"log_type":1,"src_id":110503167,"trial_step":167},{"step":165,"content":"摩尔接了过去，报之以和煦的笑容。","style":3,"background":1040,"log_type":1,"src_id":110503168,"trial_step":168},{"step":166,"speaker":"摩尔","content":"谢谢你，局长。","voice":["vo_trial_10503_1_169"],"voice_bank":"vo_moore_trial","style":1,"background":1040,"log_type":1,"src_id":110503169,"trial_step":169}]}