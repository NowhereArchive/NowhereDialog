{"id":402902042,"chapter_id":70045,"scene_id":74511,"steps":[{"step":1,"content":"【图科镇-广场】","style":18,"background":2292,"log_type":1},{"step":2,"speaker":"海拉","content":"呼、呼……赢了……","voice":["vo_event_402902042_02"],"voice_bank":"vo_event_29204","style":1,"background":2292,"log_type":1},{"step":3,"content":"在海拉和镇民的合作下，伴随沙暴而来的凶兽被挨个揍跑。","style":3,"background":2292,"log_type":1},{"step":4,"content":"风势在减弱，兽潮开始撤退了。少女松了口气，没能第一时间发现从身后扑来的漏网之鱼。","style":3,"background":2292,"log_type":1},{"step":5,"speaker":"砂兽","content":"吼——！","style":1,"background":2292,"log_type":1},{"step":6,"content":"（空场，枪响）","style":18,"background":2292,"log_type":1},{"step":7,"content":"砂兽尸体歪倒在地，发出沉重的闷响。海拉惊魂未定，向后看去，正好看到赏金猎人冒着硝烟的枪口。","style":3,"background":2292,"log_type":1},{"step":8,"content":"柯琳花里胡哨地转动枪把，向小姑娘抛了个飞吻。海拉听不清她的话，只好通过口型辨认——","style":3,"background":2292,"log_type":1},{"step":9,"content":"“瞧，这次留下来陪你一起打架了吧？”","style":3,"background":2292,"log_type":1},{"step":10,"content":"……哼，油嘴滑舌。","style":3,"background":2292,"log_type":1},{"step":11,"content":"下一刻，海拉身子一空，视野突然抬高——她被什么人托举起来，耳边充满欢呼声。","style":3,"background":2292,"log_type":1},{"step":12,"speaker":"海拉","content":"？！","style":1,"background":2292,"log_type":1},{"step":13,"content":"是图科的镇民们。他们簇拥着海拉，高喊着这次对抗沙暴的胜利，准备拥她去庆功。","style":3,"background":2292,"log_type":1},{"step":14,"content":"人群外侧，莱特大呼小叫地拖来小仓库的箱子。打开箱子，异方晶的蓝光迅速扩散，驱散了小镇中剩下的污染。","style":3,"background":2292,"log_type":1},{"step":15,"speaker":"柯琳","content":"大英雄，怎么憋个脸呢？好不容易打赢了，笑一笑吧？","voice":["vo_event_402902042_08"],"voice_bank":"vo_event_29204","style":1,"background":2292,"log_type":1},{"step":16,"content":"一双手把海拉从众人的拥簇下解救出来，是柯琳。","style":3,"background":2292,"log_type":1},{"step":17,"speaker":"海拉","content":"……没关系吗？你们藏的异方晶都让我看到了。","voice":["vo_event_402902042_09"],"voice_bank":"vo_event_29204","style":1,"background":2292,"log_type":1},{"step":18,"speaker":"柯琳","content":"嗯？","voice":["vo_event_402902042_10"],"voice_bank":"vo_event_29204","style":1,"background":2292,"log_type":1},{"step":19,"content":"她反应了好一会儿才明白过来，一脸好笑地拍拍海拉的脑袋。","style":3,"background":2292,"log_type":1},{"step":20,"speaker":"柯琳","content":"没关系，我们早就是一伙的了。","voice":["vo_event_402902042_11"],"voice_bank":"vo_event_29204","style":1,"background":2292,"log_type":1},{"step":21,"content":"众人已经欢呼着开始庆祝。米拉收起剩余的异方晶，也将箱子带回旅店，封存在柜台后的暗匣里。","style":3,"background":2292,"log_type":1},{"step":22,"content":"这一切都没有避开海拉，图科人已然将海拉视为同伴。","style":3,"background":2292,"log_type":1},{"step":23,"content":"柯琳再次揉了揉海拉的脑袋。","style":3,"background":2292,"log_type":1},{"step":24,"speaker":"柯琳","content":"走！去庆功，今天他们要好好露一手，不赶紧跑就抢不到吃的咯？","voice":["vo_event_402902042_12"],"voice_bank":"vo_event_29204","style":1,"background":2292,"log_type":1},{"step":26,"speaker":"海拉","content":"……","style":1,"background":2292,"log_type":1},{"step":27,"content":"海拉没有回答，只是默默跟上，一起走向图科旅馆。","style":3,"background":2292,"log_type":1}]}