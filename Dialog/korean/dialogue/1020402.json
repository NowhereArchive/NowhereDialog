{"id":1020402,"chapter_id":1020402,"scene_id":1,"steps":[{"step":1,"content":"█월 13일, 17:24, 벵엔 제4병원 정문 앞.","style":9,"background":102,"log_type":1,"src_id":120402001,"trial_step":1},{"step":2,"content":"당신은 왜 따라온 거야…","style":2,"background":102,"log_type":1,"src_id":120402002,"trial_step":2},{"step":3,"content":"괴상한 가면을 쓴 금발 남자가 수상하게 병원 정문 옆 조경 나무 뒤에 숨어 고개를 빼꼼 내밀었다.","style":3,"background":102,"log_type":1,"src_id":120402003,"trial_step":3},{"step":4,"content":"신성에 모습을 드러낼 수 없어서 내게 부탁한 거라고 하지 않았나?","style":2,"background":102,"log_type":1,"src_id":120402004,"trial_step":4},{"step":5,"speaker":"돈","content":"정정당당한 사내대장부가 무서울 게 뭐 있어?","voice":["vo_trial_20402_1_5"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402005,"trial_step":5},{"step":6,"content":"얼굴에 쓴 거나 벗고 말하지.","style":2,"background":102,"log_type":1,"src_id":120402006,"trial_step":6},{"step":7,"speaker":"돈","content":"아이참…","voice":["vo_trial_20402_1_7"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402007,"trial_step":7},{"step":8,"speaker":"돈","content":"너를 혼자 '악마의 소굴'에 보내는 게 불안해서 이러는 거잖아.","voice":["vo_trial_20402_1_8"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402008,"trial_step":8},{"step":9,"content":"우스꽝스러운 가면 너머로 돈의 목소리가 들려왔다. 당신은 자신도 모르게 이마를 짚었다.","style":3,"background":102,"log_type":1,"src_id":120402009,"trial_step":9},{"step":10,"content":"아니 이 가면은… 도대체 어디서 난 거야?","style":2,"background":102,"log_type":1,"src_id":120402010,"trial_step":10},{"step":11,"speaker":"돈","content":"너네 구매센터의 그 보라색 머리 아가씨한테 받았어.","voice":["vo_trial_20402_1_11"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402011,"trial_step":11},{"step":12,"speaker":"돈","content":"변장 도구를 달라고 했더니 돈을 달라고 하더라고, 그래서 좀 깎아 달라고 했더니…","voice":["vo_trial_20402_1_12"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402012,"trial_step":12},{"step":13,"content":"…","style":2,"background":102,"log_type":1,"src_id":120402013,"trial_step":13},{"step":14,"speaker":"돈","content":"괜찮아, 괜찮아. 다른 사람이 날 알아보지만 않으면 돼. 어차피 효과는 같아.","voice":["vo_trial_20402_1_14"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402014,"trial_step":14},{"step":15,"speaker":"돈","content":"누가 온다… 어서 가 봐.","voice":["vo_trial_20402_1_15"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402015,"trial_step":15},{"step":16,"content":"병원 정문에서 건장한 체격의 간호사 한 명이 당신을 향해 걸어오고 있었다.","style":3,"background":102,"log_type":1,"src_id":120402016,"trial_step":16},{"step":17,"speaker":"간호사","content":"MBCC의 국장님이신가요?","voice":["vo_trial_20402_1_17"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402017,"trial_step":17},{"step":18,"content":"간호사가 당신 앞에 서자, 당신은 비로소 이 정신 병원 간호사가 내뿜는 위압감을 여실히 느낄 수 있었다.","style":3,"background":102,"log_type":1,"src_id":120402018,"trial_step":18},{"step":19,"content":"그는 돈보다도 키가 컸고, 근육이 어찌나 큰지 간호사복이 터질 지경이었다.","style":3,"background":102,"log_type":1,"src_id":120402019,"trial_step":19},{"step":20,"options":["…네, 맞습니다"],"style":6,"background":102,"log_type":1,"src_id":120402020,"trial_step":20,"course":3,"choices":[{"text":"…네, 맞습니다","goto":21}]},{"step":21,"speaker":"간호사","content":"알겠습니다.","voice":["vo_trial_20402_1_21"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402021,"trial_step":21},{"step":22,"content":"덩치 큰 간호사는 당신 옆의 돈을 흘겨봤다.","style":3,"background":102,"log_type":1,"src_id":120402022,"trial_step":22},{"step":23,"speaker":"간호사","content":"이분은 국장님의 일행이신 건가요?","voice":["vo_trial_20402_1_23"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402023,"trial_step":23},{"step":24,"content":"…네.","style":2,"background":102,"log_type":1,"src_id":120402024,"trial_step":24},{"step":25,"speaker":"간호사","content":"예약하실 때 일행이 있다고는 안 하셨는데요?","voice":["vo_trial_20402_1_25"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402025,"trial_step":25},{"step":26,"content":"돈은 순간적으로 기지를 발휘해 급히 설명했다.","style":3,"background":102,"log_type":1,"src_id":120402026,"trial_step":26},{"step":27,"speaker":"돈","content":"저는 경호원입니다!","voice":["vo_trial_20402_1_27"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402027,"trial_step":27},{"step":28,"speaker":"돈","content":"저희 MBCC 국장님이 외출을 하시는데, 수행 경호원이 있는 건 당연한 일 아닌가요?","voice":["vo_trial_20402_1_28"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402028,"trial_step":28},{"step":29,"content":"간호사는 당신 둘을 바라보았다. 아무래도 돈의 변명이 통한 것 같았다.","style":3,"background":102,"log_type":1,"src_id":120402029,"trial_step":29},{"step":30,"speaker":"간호사","content":"알겠습니다, 이쪽으로 오시죠. 제가 다스 선생님께 안내해 드리겠습니다.","voice":["vo_trial_20402_1_30"],"voice_bank":"vo_don_trial","style":1,"background":102,"log_type":1,"src_id":120402030,"trial_step":30},{"step":31,"content":"간호사는 마치 움직이는 철탑처럼 당신 둘을 데리고 병원으로 들어갔다.","style":3,"background":102,"log_type":1,"src_id":120402031,"trial_step":31},{"step":32,"content":"가는 길 내내 당신들과 간호사는 가깝지도 멀지도 않은 거리를 유지했다. 정문에 들어서자, 당신은 참지 못하고 작은 소리로 돈에게 말했다.","style":3,"background":120,"log_type":1,"src_id":120402032,"trial_step":32},{"step":33,"content":"이렇게 쉽게 속이다니 뜻밖이네. 심지어 당신의 이상한 분장도 넘어가 줬어.","style":2,"background":120,"log_type":1,"src_id":120402033,"trial_step":33},{"step":34,"speaker":"돈","content":"내가 분장이 너무 완벽해서 그런 거 아닐까?","voice":["vo_trial_20402_1_34"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402034,"trial_step":34},{"step":35,"content":"…내 생각엔 저 사람이 그냥 대수롭지 않게 여기는 거 같은데?","style":2,"background":120,"log_type":1,"src_id":120402035,"trial_step":35},{"step":36,"speaker":"간호사","content":"벵엔 제4병원은 유구한 역사가 있는 정신 전문 병원입니다. 변이의 영향을 받았거나, M 수치가 불안정한 환자들의 치료를 책임지고 있죠.","voice":["vo_trial_20402_1_36"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402036,"trial_step":36},{"step":37,"content":"길을 안내하며 간호사는 이따금 당신에게 병원에 대해 소개해 줬다.","style":3,"background":120,"log_type":1,"src_id":120402037,"trial_step":37},{"step":38,"content":"MBCC가 하는 일과 비슷한 부분이 있군요…","style":2,"background":120,"log_type":1,"src_id":120402038,"trial_step":38},{"step":39,"speaker":"간호사","content":"아니요, 다릅니다.","voice":["vo_trial_20402_1_39"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402039,"trial_step":39},{"step":40,"speaker":"간호사","content":"저희는 병원이고, MBCC는 수감자 수용 기관이죠. 하는 일이 같다고 할 순 없습니다.","voice":["vo_trial_20402_1_40"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402040,"trial_step":40},{"step":41,"content":"간호사는 걸으면서 고개를 돌려 당신과 돈을 쳐다보며 말했다. 그에게 '웃음기'라곤 전혀 없었다.","style":3,"background":120,"log_type":1,"src_id":120402041,"trial_step":41},{"step":42,"speaker":"간호사","content":"게다가 웬만해서 저희는 수감자를 수용하거나 치료하진 않습니다.","voice":["vo_trial_20402_1_42"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402042,"trial_step":42},{"step":43,"content":"어째서죠?","style":2,"background":120,"log_type":1,"src_id":120402043,"trial_step":43},{"step":44,"content":"당신은 무심결에 질문했다.","style":3,"background":120,"log_type":1,"src_id":120402044,"trial_step":44},{"step":45,"speaker":"간호사","content":"수감자들은 폭주하면 파괴력이 너무 커서, 통제하기 어렵기 때문이죠…","voice":["vo_trial_20402_1_45"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402045,"trial_step":45},{"step":46,"speaker":"간호사","content":"앞에 보이는 곳이 환자 활동 구역입니다.","voice":["vo_trial_20402_1_46"],"voice_bank":"vo_don_trial","style":1,"background":120,"log_type":1,"src_id":120402046,"trial_step":46},{"step":47,"content":"소개를 마친 간호사는 발걸음을 빠르게 옮기기 시작했다. 당신은 그의 뒤를 급히 따라갔다.","style":3,"background":120,"log_type":1,"src_id":120402047,"trial_step":47},{"step":48,"content":"이 구역엔 환자복을 입은 환자들이 삼삼오오 모여 서 있거나 앉아 있었다.","style":3,"background":111,"log_type":1,"src_id":120402048,"trial_step":48},{"step":49,"content":"그들 중 일부는 가만히 서 있거나 일부는 의미를 알 수 없는 괴성을 지르고 있었고, 일부는 허공을 향해 손짓발짓하며 장황하게 무언갈 얘기하고 있었다.","style":3,"background":111,"log_type":1,"src_id":120402049,"trial_step":49},{"step":50,"speaker":"간호사","content":"이 활동 구역은 줄곧 저희 제4병원의 대표적인 장소입니다. 환자들은 이곳에서 외부와 똑같은 문화생활을 즐길 수 있죠…","voice":["vo_trial_20402_1_50"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402050,"trial_step":50},{"step":51,"content":"따르릉…","style":3,"background":111,"log_type":1,"src_id":120402051,"trial_step":51},{"step":52,"content":"다급한 벨 소리가 간호사의 말을 끊었다.","style":3,"background":111,"log_type":1,"src_id":120402052,"trial_step":52},{"step":53,"content":"그는 허리에 차고 있던 개인 단말기를 집어 들어 버튼을 누르고 굵은 목소리로 물었다.","style":3,"background":111,"log_type":1,"src_id":120402053,"trial_step":53},{"step":54,"speaker":"간호사","content":"무슨 일이야?","voice":["vo_trial_20402_1_54"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402054,"trial_step":54},{"step":55,"speaker":"소란스러운 소리","content":"연구실의 환자가 스트레스 반응을… 통제가 안 됩니다…","voice":["vo_trial_20402_1_55"],"voice_bank":"vo_don_trial","style":11,"background":111,"log_type":1,"src_id":120402055,"trial_step":55},{"step":56,"speaker":"간호사","content":"알겠어, 바로 갈게.","voice":["vo_trial_20402_1_56"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402056,"trial_step":56},{"step":57,"content":"다급히 전화를 끊은 간호사가 고개를 돌려 당신들을 바라보았다.","style":3,"background":111,"log_type":1,"src_id":120402057,"trial_step":57},{"step":58,"speaker":"간호사","content":"죄송합니다. 급한 일이 생겨서 가봐야 할 것 같습니다. 잠시만 여기서 기다려 주세요.","voice":["vo_trial_20402_1_58"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402058,"trial_step":58},{"step":59,"content":"곧이어 당신과 돈은 2미터가 훌쩍 넘는 간호사가 큰 보폭으로, 마치 전속력으로 달리는 트럭처럼 튀어 나가는 것을 볼 수 있었다.","style":3,"background":111,"log_type":1,"src_id":120402059,"trial_step":59},{"step":60,"content":"그가 코너를 돌자 그의 모습은 더 이상 보이지 않았지만, 천둥소리 같은 발자국 소리는 여전히 복도에 울려 퍼졌다.","style":3,"background":111,"log_type":1,"src_id":120402060,"trial_step":60},{"step":61,"content":"…","style":2,"background":111,"log_type":1,"src_id":120402061,"trial_step":61},{"step":62,"speaker":"돈","content":"…","voice":["vo_trial_20402_1_62"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402062,"trial_step":62},{"step":63,"content":"우리 지금… 여기에 버려진 건 아니겠지?","style":2,"background":111,"log_type":1,"src_id":120402063,"trial_step":63},{"step":64,"content":"이제 어떻게 할까?","style":2,"background":111,"log_type":1,"src_id":120402064,"trial_step":64},{"step":65,"speaker":"돈","content":"어떻게 하긴, 기다려야지. 그 의사 사무실이 어딘지도 모르는데.","voice":["vo_trial_20402_1_65"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402065,"trial_step":65},{"step":66,"content":"아무리 그래도 여기는 정신 병원의 환자 활동 구역인데…","style":2,"background":111,"log_type":1,"src_id":120402066,"trial_step":66},{"step":67,"content":"별문제 없겠지?","style":2,"background":111,"log_type":1,"src_id":120402067,"trial_step":67},{"step":68,"speaker":"돈","content":"내가 있는데, 뭐가 무서워?","voice":["vo_trial_20402_1_68"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402068,"trial_step":68},{"step":69,"content":"무섭다기보단 여기 환자들이… 조금 이상해 보여서 말이야.","style":2,"background":111,"log_type":1,"src_id":120402069,"trial_step":69},{"step":70,"content":"돈은 당신에게 다가와 낮은 소리로 말했다.","style":3,"background":111,"log_type":1,"src_id":120402070,"trial_step":70},{"step":71,"speaker":"돈","content":"네 추측이 맞아… 여기에 있는 환자들은 대부분 무고한 사람들이야… 'M 수치 불안정'이라는 명목으로 니르바나에 의해 강제로 이곳에 갇혔어.","voice":["vo_trial_20402_1_71"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402071,"trial_step":71},{"step":72,"content":"돈의 얘기를 듣고 나서야, 당신은 그들의 몸에 눈에 띄는 상처들이 있다는 걸 발견했다. 심지어 팔다리가 없는 사람도 있었다.","style":3,"background":111,"log_type":1,"src_id":120402072,"trial_step":72},{"step":73,"content":"그렇군, 기회가 되면 이 사람들도 구해야겠어…","style":2,"background":111,"log_type":1,"src_id":120402073,"trial_step":73},{"step":74,"content":"그런데, 궁금한 게 있어…","style":2,"background":111,"log_type":1,"src_id":120402074,"trial_step":74},{"step":75,"content":"당신은 고개를 돌려 돈을 바라보며 물었다.","style":3,"background":111,"log_type":1,"src_id":120402075,"trial_step":75},{"step":76,"options":["넌 어떻게 이곳을 그렇게 잘 아는 거야?"],"style":6,"background":111,"log_type":1,"src_id":120402076,"trial_step":76,"course":3,"choices":[{"text":"넌 어떻게 이곳을 그렇게 잘 아는 거야?","goto":77}]},{"step":77,"content":"의사도 알고, 환자들의 상황도 잘 알고…","style":2,"background":111,"log_type":1,"src_id":120402077,"trial_step":77},{"step":78,"content":"서구 사람이 신성의 정신 병원을 이렇게 잘 안다는 건…","style":2,"background":111,"log_type":1,"src_id":120402078,"trial_step":78},{"step":79,"content":"설마 여기에 있었던 건 아니겠지?","style":2,"background":111,"log_type":1,"src_id":120402079,"trial_step":79},{"step":80,"speaker":"돈","content":"…","voice":["vo_trial_20402_1_80"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402080,"trial_step":80},{"step":81,"speaker":"돈","content":"무슨 소리야! 인맥이라고, 인맥, 알겠어?","voice":["vo_trial_20402_1_81"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402081,"trial_step":81},{"step":82,"content":"돈은 조금 과장되게 가슴을 두드리며 말했다.","style":3,"background":111,"log_type":1,"src_id":120402082,"trial_step":82},{"step":83,"speaker":"돈","content":"나처럼 대단한 사람은 어딜 가도 먹힌다고…","voice":["vo_trial_20402_1_83"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402083,"trial_step":83},{"step":84,"content":"당신이 미처 반박하기도 전에 등 뒤에서 누군가의 목소리가 들려왔다.","style":3,"background":111,"log_type":1,"src_id":120402084,"trial_step":84},{"step":85,"speaker":"환자A","content":"아니, 당신은… 대영웅이잖아?","voice":["vo_trial_20402_1_85"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402085,"trial_step":85},{"step":86,"speaker":"돈","content":"콜록콜록…","voice":["vo_trial_20402_1_86"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402086,"trial_step":86},{"step":87,"speaker":"환자A","content":"나다, 낙원의 황제. 기억이 나지 않느냐?","voice":["vo_trial_20402_1_87"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402087,"trial_step":87},{"step":88,"content":"돈은 그 자리에 얼어붙었다.","style":3,"background":111,"log_type":1,"src_id":120402088,"trial_step":88},{"step":89,"speaker":"돈","content":"음… 저는…","voice":["vo_trial_20402_1_89"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402089,"trial_step":89},{"step":90,"speaker":"환자A","content":"우물쭈물하면서 짐의 말에 응하지 않는다니! 이건 반역이다! 군주를 속인 죄! 이 자의 목을 쳐라! 삼대를 멸하라!!","voice":["vo_trial_20402_1_90"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402090,"trial_step":90},{"step":91,"speaker":"환자A","content":"여봐라, 이 역적을 잡아라!","voice":["vo_trial_20402_1_91"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402091,"trial_step":91},{"step":92,"speaker":"돈","content":"잠깐만, 잠깐만…","voice":["vo_trial_20402_1_92"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402092,"trial_step":92},{"step":93,"content":"돈은 어쩔 수 없다는 듯 고개를 돌리곤 미소를 지었다.","style":3,"background":111,"log_type":1,"src_id":120402093,"trial_step":93},{"step":94,"speaker":"돈","content":"어떻게 당신을 기억 못 하겠습니까, 황제 폐하.","voice":["vo_trial_20402_1_94"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402094,"trial_step":94},{"step":95,"speaker":"환자A","content":"이제야 맞는 말을 하는군. 짐의 대업을 잘 보좌하면 큰 상을… 응? 자네 꼴이 왜 이런가?","voice":["vo_trial_20402_1_95"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402095,"trial_step":95},{"step":96,"speaker":"환자A","content":"못 본 지 얼마나 됐다고, 수염이 이렇게나 길어진 게야?","voice":["vo_trial_20402_1_96"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402096,"trial_step":96},{"step":97,"speaker":"환자A","content":"어서들 와보게! 대영웅이 돌아왔네! 수염도 길러서 돌아왔어!","voice":["vo_trial_20402_1_97"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402097,"trial_step":97},{"step":98,"content":"'낙원의 황제 폐하'가 큰 소리로 외치자, 활동 구역의 환자들이 하나둘씩 모여들었다.","style":3,"background":111,"log_type":1,"src_id":120402098,"trial_step":98},{"step":99,"speaker":"환자B","content":"대영웅, 정말 당신인가요?","voice":["vo_trial_20402_1_99"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402099,"trial_step":99},{"step":100,"content":"일이 이렇게 된 이상, 돈은 더 이상 숨지 않았다. 그는 얼굴에 쓰고 있던 가면을 벗고 멋쩍은 듯 웃었다.","style":3,"background":111,"log_type":1,"src_id":120402100,"trial_step":100},{"step":101,"speaker":"돈","content":"나야, 꼬마 감자. 오랜만이야, 잘 지냈어?","voice":["vo_trial_20402_1_101"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402101,"trial_step":101},{"step":102,"speaker":"환자B","content":"잘 못 지냈어. 매일 물을 줬는데, 아직도 싹이 안 났지 뭐야? 지하 녀석들이 자꾸만 나를 슬라이스로 썰어, 내가 너무 맛있어서 그런가 봐… 내가 싹이 나면 다 독살해 버릴 거야!","voice":["vo_trial_20402_1_102"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402102,"trial_step":102},{"step":103,"speaker":"환자C","content":"독살할 거면 빨리 좀 부탁할게. 그 흰 가운을 입은 놈들이 살아있는 한, 난 결국 시달려 죽고 말 거야. 걸핏하면 날 번개로 공격한다니까?","voice":["vo_trial_20402_1_103"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402103,"trial_step":103},{"step":104,"speaker":"돈","content":"번개로 공격한다고?","voice":["vo_trial_20402_1_104"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402104,"trial_step":104},{"step":105,"speaker":"환자C","content":"그렇다니까? 네가 사라진 후엔 내가 너 대신 피뢰침이 되었어. 내가 안 맞으면, 또 다른 사람이 맞겠지…","voice":["vo_trial_20402_1_105"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402105,"trial_step":105},{"step":106,"speaker":"환자A","content":"다 짐의 잘못이다… 짐이 두더지에게 구멍을 파라고 명령했는데, 역적들한테 들키는 바람에… 짐이 그를 욕보인 게야…","voice":["vo_trial_20402_1_106"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402106,"trial_step":106},{"step":107,"speaker":"환자B","content":"대영웅, 언제 우릴 데리고 나가줄 거야? 이러다간 정말 우리 모두 죽고 말 거야.","voice":["vo_trial_20402_1_107"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402107,"trial_step":107},{"step":108,"speaker":"돈","content":"곧…","voice":["vo_trial_20402_1_108"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402108,"trial_step":108},{"step":109,"content":"돈의 눈빛에서 무언가 결심이 느껴졌다.","style":3,"background":111,"log_type":1,"src_id":120402109,"trial_step":109},{"step":110,"speaker":"돈","content":"곧 내가 데리고 나가 줄게, 약속해.","voice":["vo_trial_20402_1_110"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402110,"trial_step":110},{"step":111,"speaker":"환자B","content":"곧이 언젠데? 네가 사라진 지도 꽤 오래됐잖아…","voice":["vo_trial_20402_1_111"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402111,"trial_step":111},{"step":112,"content":"환자들이 돈을 둘러싸고 웅성대며 이것저것 물었다. 그러던 중 '낙원 황제'가 갑자기 경계하며 고개를 들었다.","style":3,"background":111,"log_type":1,"src_id":120402112,"trial_step":112},{"step":113,"speaker":"환자A","content":"이상한 느낌이 드네, 누군가 오고 있다! 전군, 내 명령을 따라 철수하라!","voice":["vo_trial_20402_1_113"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402113,"trial_step":113},{"step":114,"content":"'낙원 황제'의 호령이 떨어지자, 환자들은 일사불란하게 흩어졌다.","style":3,"background":111,"log_type":1,"src_id":120402114,"trial_step":114},{"step":115,"content":"간호사의 독특하면서도 무거운 발소리가 점점 가까워지자, 돈은 서둘러 다시 가면을 썼다.","style":3,"background":111,"log_type":1,"src_id":120402115,"trial_step":115},{"step":116,"content":"방금 상황이 마무리되자, 돈은 난감한 듯 당신을 바라보았다.","style":3,"background":111,"log_type":1,"src_id":120402116,"trial_step":116},{"step":117,"speaker":"돈","content":"내가 말했잖아, 어디서든 먹힌다고… 거짓말 아니지?","voice":["vo_trial_20402_1_117"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402117,"trial_step":117},{"step":118,"content":"…","style":2,"background":111,"log_type":1,"src_id":120402118,"trial_step":118},{"step":119,"content":"당신은 정말 여기에 있었던…","style":2,"background":111,"log_type":1,"src_id":120402119,"trial_step":119},{"step":120,"speaker":"돈","content":"쉿! 간호사가 왔어.","voice":["vo_trial_20402_1_120"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402120,"trial_step":120},{"step":121,"speaker":"돈","content":"일단 해야 할 일부터 하자. 돌아가서 설명해 줄게. 일단 가볼까?","voice":["vo_trial_20402_1_121"],"voice_bank":"vo_don_trial","style":1,"background":111,"log_type":1,"src_id":120402121,"trial_step":121},{"step":122,"speaker":"간호사","content":"이쪽입니다.","voice":["vo_trial_20402_1_122"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402122,"trial_step":122},{"step":123,"content":"간호사가 사무실 문을 열어주었고, 당신과 돈은 안으로 들어갔다. 그러자, 간호사는 자리를 비켜주며 문을 닫았다.","style":3,"background":1041,"log_type":1,"src_id":120402123,"trial_step":123},{"step":124,"content":"책상 앞에 앉아있던 의사는 고개를 들어보지도 않고, 계속해서 무언가를 쓰며 하던 일에 열중했다.","style":3,"background":1041,"log_type":1,"src_id":120402124,"trial_step":124},{"step":125,"options":["인사한다"],"style":6,"background":1041,"log_type":1,"src_id":120402125,"trial_step":125,"course":3,"choices":[{"text":"인사한다","goto":126}]},{"step":126,"content":"안녕하세요, 저는 MBCC의 국장 ${PlayerName}입니다. 오늘 오후에 뵙기로 약속했었죠.","style":2,"background":1041,"log_type":1,"src_id":120402126,"trial_step":126},{"step":127,"speaker":"의사","content":"다스·알츠.","voice":["vo_trial_20402_1_127"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402127,"trial_step":127},{"step":128,"content":"의사는 자신의 이름을 말했다. 하지만 하던 일은 멈추지 않았다.","style":3,"background":1041,"log_type":1,"src_id":120402128,"trial_step":128},{"step":129,"content":"사무실 안엔 기괴한 적막만이 흘렀다.","style":3,"background":1041,"log_type":1,"src_id":120402129,"trial_step":129},{"step":130,"content":"당신은 잠시 기다렸다가 의사가 더 이상 이어서 말을 할 기미가 보이지 않자 먼저 입을 열었다.","style":3,"background":1041,"log_type":1,"src_id":120402130,"trial_step":130},{"step":131,"content":"제가 오늘 뵙자고 한 건, 치료를 좀 부탁하기 위해서입니다…","style":2,"background":1041,"log_type":1,"src_id":120402131,"trial_step":131},{"step":132,"speaker":"다스","content":"서구의 변이 환자, 잘 알고 있습니다.","voice":["vo_trial_20402_1_132"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402132,"trial_step":132},{"step":133,"content":"그럼…","style":2,"background":1041,"log_type":1,"src_id":120402133,"trial_step":133},{"step":134,"content":"의사가 고개를 들어 당신과 돈을 바라보았다.","style":3,"background":1041,"log_type":1,"src_id":120402134,"trial_step":134},{"step":135,"speaker":"다스","content":"치료할 수 없습니다.","voice":["vo_trial_20402_1_135"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402135,"trial_step":135},{"step":136,"content":"…","style":2,"background":1041,"log_type":1,"src_id":120402136,"trial_step":136},{"step":137,"content":"당신이 훌륭한 정신과 의사라고 들었는데요…","style":2,"background":1041,"log_type":1,"src_id":120402137,"trial_step":137},{"step":138,"speaker":"다스","content":"치료할 수 없다는 건, 고칠 수 없다는 뜻이 아닙니다.","voice":["vo_trial_20402_1_138"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402138,"trial_step":138},{"step":139,"content":"치료비에 대해선 걱정하지 않으셔도 됩니다. MBCC와 신성의 자선 기관에서 충분하게…","style":2,"background":1041,"log_type":1,"src_id":120402139,"trial_step":139},{"step":140,"speaker":"다스","content":"치료할 수 없다는 건, 돈을 받겠다는 뜻이 아닙니다.","voice":["vo_trial_20402_1_140"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402140,"trial_step":140},{"step":141,"speaker":"다스","content":"치료할 수 없다, 말 그대로입니다.","voice":["vo_trial_20402_1_141"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402141,"trial_step":141},{"step":142,"content":"…","style":2,"background":1041,"log_type":1,"src_id":120402142,"trial_step":142},{"step":143,"content":"다스의 이토록 차가운 태도에, 당신은 순간 어떻게 반응해야 할지 갈피를 잡지 못했다.","style":3,"background":1041,"log_type":1,"src_id":120402143,"trial_step":143},{"step":144,"options":["이유를 여쭤봐도 될까요?"],"style":6,"background":1041,"log_type":1,"src_id":120402144,"trial_step":144,"course":3,"choices":[{"text":"이유를 여쭤봐도 될까요?","goto":145}]},{"step":145,"speaker":"다스","content":"저한테 묻지 말고, 당신의 '경호원'에게 물어보시죠.","voice":["vo_trial_20402_1_145"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402145,"trial_step":145},{"step":146,"content":"당신이 고개를 돌리자, 돈이 머리를 긁적거리는 모습이 보였다. 돈은 이내 가면을 벗었고, 어쩔 수 없다는 듯한 미소를 지었다.","style":3,"background":1041,"log_type":1,"src_id":120402146,"trial_step":146},{"step":147,"speaker":"돈","content":"다스, 여긴 내 친구야. 서구 전체의 은인이지. 넌…","voice":["vo_trial_20402_1_147"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402147,"trial_step":147},{"step":148,"speaker":"다스","content":"지명 수배자가 여길 올 생각을 하다니… 서구에서 온 그 환자를 구하려는 거 맞지?","voice":["vo_trial_20402_1_148"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402148,"trial_step":148},{"step":149,"content":"의사는 하던 일을 멈추고 고개를 들었다. 손에 들고 있던 펜의 펜촉이 책상에 세게 부딪혔다.","style":3,"background":1041,"log_type":1,"src_id":120402149,"trial_step":149},{"step":150,"speaker":"다스","content":"그녀는 병원 지하 시설에 갇혀있어… 네가 있었던 그곳에. 경비가 24시간 지키고 있으니까, 네가 노리는 그 기회는 없을 거야.","voice":["vo_trial_20402_1_150"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402150,"trial_step":150},{"step":151,"speaker":"다스","content":"그리고, 나한테서 무슨 도움을 얻을 생각은 하지 마.","voice":["vo_trial_20402_1_151"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402151,"trial_step":151},{"step":152,"content":"의사는 말을 하며 당신을 힐끗 쳐다보았다.","style":3,"background":1041,"log_type":1,"src_id":120402152,"trial_step":152},{"step":153,"speaker":"다스","content":"당신이 MBCC 국장이죠? 당신이 무슨 이유로 이자와 한편이 된 건진 모르겠지만, 틀림없이 사기를 당했을 겁니다.","voice":["vo_trial_20402_1_153"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402153,"trial_step":153},{"step":154,"speaker":"다스","content":"당신의 '경호원'은 한때 제 환자였습니다. 아주 위험한 미치광이였죠. 어떤 수를 써서 제4병원의 통제를 벗어난 건진 모르겠지만요.","voice":["vo_trial_20402_1_154"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402154,"trial_step":154},{"step":155,"content":"의사는 자리에서 일어나 옆에 있는 문서함에서 파일 하나를 꺼내 당신에게 건넸다.","style":3,"background":1041,"log_type":1,"src_id":120402155,"trial_step":155},{"step":156,"speaker":"다스","content":"저 사람의 의료 기록이니까, 못 믿겠으면 직접 보시죠.","voice":["vo_trial_20402_1_156"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402156,"trial_step":156},{"step":157,"speaker":"다스","content":"원칙대로라면, 지금 당장 병원 경호원에게 알려 이 지명 수배자를 다시 구금하고 치료를 받게 해야 하겠죠.","voice":["vo_trial_20402_1_157"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402157,"trial_step":157},{"step":158,"speaker":"다스","content":"하지만 전 의사일 뿐이고, 제가 할 일은 사람을 치료해서 구하는 것이기 때문에, 당신들과 니르바나의 정치 싸움엔 끼어들고 싶진 않습니다.","voice":["vo_trial_20402_1_158"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402158,"trial_step":158},{"step":159,"speaker":"다스","content":"하지만 충고 하나만 하죠. 제4병원은 <b>정식 병원</b>입니다. 니르바나 그룹의 지원을 받고 있어요.","voice":["vo_trial_20402_1_159"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402159,"trial_step":159},{"step":160,"speaker":"다스","content":"그들과 맞서려면 어떤 결과를 마주할지 잘 생각하는 게 좋을 겁니다.","voice":["vo_trial_20402_1_160"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402160,"trial_step":160},{"step":161,"content":"다스는 더 이상 당신과 돈을 보지 않고, 책상 앞으로 돌아가 일을 계속했다.","style":3,"background":1041,"log_type":1,"src_id":120402161,"trial_step":161},{"step":162,"speaker":"다스","content":"치료를 받으려고 온 건 아니니까, 더 이상 할 얘긴 없겠군요.","voice":["vo_trial_20402_1_162"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402162,"trial_step":162},{"step":163,"speaker":"다스","content":"이만 돌아가 주세요.","voice":["vo_trial_20402_1_163"],"voice_bank":"vo_don_trial","style":1,"background":1041,"log_type":1,"src_id":120402163,"trial_step":163},{"step":164,"content":"간호사의 '예의 있는' 안내에 따라 당신과 돈은 사무실에서 나왔다.","style":3,"background":120,"log_type":1,"src_id":120402164,"trial_step":164},{"step":165,"content":"보아하니 이번 일은 당신이 생각했던 것보다 더 어려운 것 같네…","style":2,"background":1018,"log_type":1,"src_id":120402165,"trial_step":165},{"step":166,"content":"병원을 떠난 후, 당신과 돈은 관리국으로 돌아가는 차에 올라탔다.","style":3,"background":1018,"log_type":1,"src_id":120402166,"trial_step":166},{"step":167,"speaker":"돈","content":"맞아. 다스에게도 곤란한 일이 생긴 게 분명해…","voice":["vo_trial_20402_1_167"],"voice_bank":"vo_don_trial","style":1,"background":1018,"log_type":1,"src_id":120402167,"trial_step":167},{"step":168,"speaker":"돈","content":"작년 이맘때만 해도 제4병원에 사직서를 제출한 상태였는데, 분명 무슨 일이 생겨 여태껏 병원에 남을 수밖에 없었던 거야…","voice":["vo_trial_20402_1_168"],"voice_bank":"vo_don_trial","style":1,"background":1018,"log_type":1,"src_id":120402168,"trial_step":168},{"step":169,"content":"그래도 마거리트 여사의 위치를 알려줬고, 당신의 파일도 가지고 나올 수 있었어.","style":2,"background":1018,"log_type":1,"src_id":120402169,"trial_step":169},{"step":170,"content":"전혀 수확이 없는 건 아니야.","style":2,"background":1018,"log_type":1,"src_id":120402170,"trial_step":170},{"step":171,"speaker":"돈","content":"하하, 꽤 긍정적이네.","voice":["vo_trial_20402_1_171"],"voice_bank":"vo_don_trial","style":1,"background":1018,"log_type":1,"src_id":120402171,"trial_step":171},{"step":172,"content":"당신에게서 배운 거야.","style":2,"background":1018,"log_type":1,"src_id":120402172,"trial_step":172},{"step":173,"content":"당신은 손에 들고 있던 의료 기록을 바라보았다.","style":3,"background":1018,"log_type":1,"src_id":120402173,"trial_step":173},{"step":174,"content":"하지만 상황이 변했으니, 우리도 새로운 대책을 마련해야 할 것 같아.","style":2,"background":1018,"log_type":1,"src_id":120402174,"trial_step":174},{"step":175,"speaker":"돈","content":"급할 거 없어. 일단 지금 가지고 있는 정보를 정리해 보자.","voice":["vo_trial_20402_1_175"],"voice_bank":"vo_don_trial","style":1,"background":1018,"log_type":1,"src_id":120402175,"trial_step":175},{"step":176,"speaker":"돈","content":"틀림없이 방법이 있을 거야…","voice":["vo_trial_20402_1_176"],"voice_bank":"vo_don_trial","style":1,"background":1018,"log_type":1,"src_id":120402176,"trial_step":176}]}