{"id":402230102,"chapter_id":50081,"scene_id":58109,"steps":[{"step":1,"content":"[치안국]","style":18,"background":2222,"log_type":1},{"step":2,"speaker":"록산느","content":"방송국 상공에 고농도 변이가 관측되고 있습니다, 신종 변이입니다. 보통 위력이 아니에요… FAC의 지원이 필요합니다!","voice":["vo_event_402230201_2"],"voice_bank":"vo_event_22032","style":1,"background":2222,"log_type":1},{"step":3,"speaker":"록산느","content":"여보세요? 여보세요!","voice":["vo_event_402230201_3"],"voice_bank":"vo_event_22032","style":1,"background":2222,"log_type":1},{"step":4,"content":"알 수 없는 힘에 통신이 완전히 끊기더니, 수화기에서 불규칙한 소음이 들려왔다.","style":3,"background":2222,"log_type":1},{"step":5,"speaker":"혼돈의 속삭임","content":"욕망과 원한을… 줘… 가장 추악한 마음을…","voice":["vo_event_402230201_5"],"voice_bank":"vo_event_22032","style":1,"background":2222,"log_type":1},{"step":6,"content":"[보도실]","style":18,"background":10000,"log_type":1},{"step":7,"speaker":"에단","content":"하늘이 좀 어두워진 것 같네, 비가 오려나?","voice":["vo_event_402230201_7"],"voice_bank":"vo_event_22032","style":1,"background":2221,"log_type":1},{"step":8,"speaker":"모건","content":"몰라, 혹시 비앙카 목소리가 들리지 않았어? 왠지 마음이 뒤숭숭하네…","voice":["vo_event_402230201_8"],"voice_bank":"vo_event_22032","style":1,"background":2221,"log_type":1},{"step":9,"content":"[관리국]","style":18,"background":10000,"log_type":1},{"step":10,"content":"나이팅게일이 지원군과 함께 신성으로 향했고, 수감자들은 관리국에 남아있었다. TV에 사람들이 잇따라 실종되고 있다는 뉴스와 그레이 미러 앱이 갑자기 다운됐다는 뉴스가 나왔다.","style":3,"background":107,"log_type":1},{"step":11,"speaker":"헤카테","content":"국장님…","voice":["vo_event_402230201_11"],"voice_bank":"vo_event_22032","style":1,"background":107,"log_type":1}]}