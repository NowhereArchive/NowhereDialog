{"id":400704201,"chapter_id":50019,"scene_id":51906,"steps":[{"step":1,"content":"싹둑… 싹둑…","style":3,"background":2080,"log_type":1},{"step":2,"content":"안개 속에서는 여전히 가위소리가 들려와, 당신은 달음박질하여 등불을 따라잡고 싶었다.","style":3,"background":2080,"log_type":1},{"step":3,"content":"최소한 동반자 한 명이 나타난 것이다.","style":3,"background":2080,"log_type":1},{"step":4,"content":"그러나 등불은 깜빡거리며 당신에게서 더욱더 멀어졌다.","style":3,"background":2080,"log_type":1}]}