{"id":1040104,"chapter_id":1040104,"scene_id":1,"steps":[{"step":1,"content":"낯선 천장, 낯선 침대, 낯선 커튼.","style":3,"background":10006,"log_type":1,"src_id":140104001,"trial_step":1},{"step":2,"content":"그리고…","style":3,"background":10006,"log_type":1,"src_id":140104002,"trial_step":2},{"step":3,"content":"낯선 사람.","style":3,"background":10006,"log_type":1,"src_id":140104003,"trial_step":3},{"step":4,"speaker":"여름","content":"회복이 좀 됐나요? 국장님?","voice":["vo_trial_40104_1_4"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104004,"trial_step":4},{"step":5,"options":["화상만 입었을 뿐이야","죽는 줄 알았어"],"style":6,"background":111,"log_type":1,"src_id":140104005,"trial_step":5,"course":3,"choices":[{"text":"화상만 입었을 뿐이야","goto":6},{"text":"죽는 줄 알았어","goto":7}]},{"step":6,"speaker":"여름","content":"다행히 화력 조절을 잘 해서요.","voice":["vo_trial_40104_1_6"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104006,"trial_step":6,"next":[8]},{"step":7,"speaker":"여름","content":"열심히 화력 조절했다고요!","voice":["vo_trial_40104_1_7"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104007,"trial_step":7},{"step":8,"speaker":"여름","content":"탓하려면 라플라스를 찾아가서 그의 경솔함을 탓하세요.","voice":["vo_trial_40104_1_8"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104008,"trial_step":8},{"step":9,"content":"사람을 금속 감옥 안에 가둔 게 더 과하다고 생각하는데.","style":2,"background":111,"log_type":1,"src_id":140104009,"trial_step":9},{"step":10,"options":["라플라스는?"],"style":6,"background":111,"log_type":1,"src_id":140104010,"trial_step":10,"course":3,"choices":[{"text":"라플라스는?","goto":11}]},{"step":11,"speaker":"여름","content":"모르겠어요. 현장의 cctv가 모두 타버렸어요.","voice":["vo_trial_40104_1_11"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104011,"trial_step":11},{"step":12,"speaker":"여름","content":"그리고 저도 라플라스의 흔적을 찾지 못했어요.","voice":["vo_trial_40104_1_12"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104012,"trial_step":12},{"step":13,"speaker":"여름","content":"윽… 분명 한 번에 성공할 거라 생각했는데! 라플라스가 방해하지 않았다면 정말 가능했을지도 몰라요!","voice":["vo_trial_40104_1_13"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104013,"trial_step":13},{"step":14,"options":["다음부터 이런 일은 조금 더 일찍 알려줄 수 없어?"],"style":6,"background":111,"log_type":1,"src_id":140104014,"trial_step":14,"course":3,"choices":[{"text":"다음부터 이런 일은 조금 더 일찍 알려줄 수 없어?","goto":15}]},{"step":15,"speaker":"여름","content":"음… 안 돼요.","voice":["vo_trial_40104_1_15"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104015,"trial_step":15},{"step":16,"speaker":"${PlayerName}","content":"왜!","style":2,"background":111,"log_type":1,"src_id":140104016,"trial_step":16},{"step":17,"speaker":"${PlayerName}","content":"이 실험에 내 목숨이 날아갈 수도 있었다고.","style":2,"background":111,"log_type":1,"src_id":140104017,"trial_step":17},{"step":18,"options":["내 몸 안에 있는 건 어때?"],"style":6,"background":111,"log_type":1,"src_id":140104018,"trial_step":18,"course":3,"choices":[{"text":"내 몸 안에 있는 건 어때?","goto":19}]},{"step":19,"speaker":"여름","content":"국장님이 잠든 사이 이 천재가 완~벽하게 검사를 했죠.","voice":["vo_trial_40104_1_19"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104019,"trial_step":19},{"step":20,"speaker":"여름","content":"어… 갑자기 왜 그런 표정을 짓는 거죠.","voice":["vo_trial_40104_1_20"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104020,"trial_step":20},{"step":21,"speaker":"여름","content":"아이, 드론 검사 말이에요. 당연히 아무 짓도 안 했다고요.","voice":["vo_trial_40104_1_21"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104021,"trial_step":21},{"step":22,"speaker":"${PlayerName}","content":"최종 결론은 뭐야?","style":2,"background":111,"log_type":1,"src_id":140104022,"trial_step":22},{"step":23,"speaker":"여름","content":"좋은 소식과 나쁜 소식 중, 어느 거 먼저 들을래요?","voice":["vo_trial_40104_1_23"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104023,"trial_step":23},{"step":24,"speaker":"여름","content":"개인적으로는 좋은 소식을 먼저 듣는 것을 추천해요.","voice":["vo_trial_40104_1_24"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104024,"trial_step":24},{"step":25,"options":["그럼 말해 봐"],"style":6,"background":111,"log_type":1,"src_id":140104025,"trial_step":25,"course":3,"choices":[{"text":"그럼 말해 봐","goto":26}]},{"step":26,"speaker":"여름","content":"현재 국장님의 몸 상태는 양호해요!","voice":["vo_trial_40104_1_26"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104026,"trial_step":26},{"step":27,"content":"나쁜 소식은.","style":2,"background":111,"log_type":1,"src_id":140104027,"trial_step":27},{"step":28,"speaker":"여름","content":"나쁜 소식은… 음, 국장님 몸속의 그건 여전히 존재해요.","voice":["vo_trial_40104_1_28"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104028,"trial_step":28},{"step":29,"speaker":"여름","content":"족쇄를 너무 많이 사용하거나 블랙링에 너무 가까워지면… 저도 마지막에는 어떻게 될지 장담할 수가 없어요.","voice":["vo_trial_40104_1_29"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104029,"trial_step":29},{"step":30,"options":["저번이랑 똑같잖아"],"style":6,"background":111,"log_type":1,"src_id":140104030,"trial_step":30,"course":3,"choices":[{"text":"저번이랑 똑같잖아","goto":31}]},{"step":31,"content":"당신은 헛웃음을 지었다. 열심히 뛰어다녔지만 결국… 제자리로 돌아온 거였다.","style":3,"background":111,"log_type":1,"src_id":140104031,"trial_step":31},{"step":32,"speaker":"여름","content":"그… 만약 제가 국장님께 정중히 사과드린다면, 국장님이 오늘 일을 꿈으로 생각해 주실 수 있을까요?","voice":["vo_trial_40104_1_32"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104032,"trial_step":32},{"step":33,"speaker":"여름","content":"이전과 마찬가지로 아무 일도 일어나지 않았고, 아무것도 추구하지 않던 거예요. 알게 되면 더 위험한 일들도 있으니까요.","voice":["vo_trial_40104_1_33"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104033,"trial_step":33},{"step":34,"content":"적어도 지금 당신의 몸에는 어떠한 실질적인 변이도 일어나지 않았다.","style":3,"background":111,"log_type":1,"src_id":140104034,"trial_step":34},{"step":35,"content":"하지만 여름의 수감실 행은 필수였다. 초콜릿 금지 처벌도 내릴 것이다. 국장에게 이런 짓을 했으니 뒷감당할 준비도 해야 하지 않겠는가.","style":3,"background":111,"log_type":1,"src_id":140104035,"trial_step":35},{"step":36,"content":"당신은 고개를 숙여 낯선 병상을 바라보다 문득 중요한 일이 떠올랐다.","style":3,"background":111,"log_type":1,"src_id":140104036,"trial_step":36},{"step":37,"options":["우리 언제 돌아가지?"],"style":6,"background":111,"log_type":1,"src_id":140104037,"trial_step":37,"course":3,"choices":[{"text":"우리 언제 돌아가지?","goto":38}]},{"step":38,"speaker":"여름","content":"아…","voice":["vo_trial_40104_1_38"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104038,"trial_step":38},{"step":39,"speaker":"여름","content":"잠시 뒤에 가요.","voice":["vo_trial_40104_1_39"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104039,"trial_step":39},{"step":40,"speaker":"${PlayerName}","content":"이건 국장 납치 사건이다, 수감자 여름.","style":2,"background":111,"log_type":1,"src_id":140104040,"trial_step":40},{"step":41,"speaker":"${PlayerName}","content":"늦게 돌아가면 그냥 수감되는 것만으로 끝나진 않을 거야.","style":2,"background":111,"log_type":1,"src_id":140104041,"trial_step":41},{"step":42,"speaker":"여름","content":"그, 그러면… 적어도 <청춘전기> 결말은 보고 돌아가요.","voice":["vo_trial_40104_1_42"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104042,"trial_step":42},{"step":43,"content":"여름이 당신을 향해 눈을 깜빡였다.","style":3,"background":111,"log_type":1,"src_id":140104043,"trial_step":43},{"step":44,"content":"보통 그녀가 이런 행동을 취할 때는 그녀가 잔머리를 굴릴 때이다.","style":3,"background":111,"log_type":1,"src_id":140104044,"trial_step":44},{"step":45,"speaker":"${PlayerName}","content":"어디서 보려고?","style":2,"background":111,"log_type":1,"src_id":140104045,"trial_step":45},{"step":46,"speaker":"여름","content":"물론 밑에서죠.","voice":["vo_trial_40104_1_46"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104046,"trial_step":46},{"step":47,"content":"복도에서 시끌벅적한 소리가 들려왔다. 이곳은 사람이 없는 곳은 아닌 것 같았다.","style":3,"background":111,"log_type":1,"src_id":140104047,"trial_step":47},{"step":48,"options":["이번 <JK 전기>는 왜 비디오가 없지?"],"style":6,"background":111,"log_type":1,"src_id":140104048,"trial_step":48,"course":3,"choices":[{"text":"이번 <JK 전기>는 왜 비디오가 없지?","goto":49}]},{"step":49,"speaker":"${PlayerName}","content":"라플라스가 너한테 미리 줬나?","style":2,"background":111,"log_type":1,"src_id":140104049,"trial_step":49},{"step":50,"speaker":"여름","content":"아뇨.","voice":["vo_trial_40104_1_50"],"voice_bank":"vo_xiayin_trial","style":1,"background":111,"log_type":1,"src_id":140104050,"trial_step":50},{"step":51,"content":"여름은 고개를 저으며 창밖을 보라는 표시를 한다.","style":3,"background":111,"log_type":1,"src_id":140104051,"trial_step":51},{"step":52,"speaker":"여름","content":"이번에는 실사예요!","voice":["vo_trial_40104_1_52"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104052,"trial_step":52},{"step":53,"options":["여긴… 아카데미?"],"style":6,"background":1044,"log_type":1,"src_id":140104053,"trial_step":53,"course":3,"choices":[{"text":"여긴… 아카데미?","goto":54}]},{"step":54,"content":"저질 체력인 여름이 어떻게 위로 올라온 건지 감탄하고 있자, 여름은 벌써 새 옷으로 갈아입은 상태였다.","style":3,"background":1044,"log_type":1,"src_id":140104054,"trial_step":54},{"step":55,"content":"그녀는 연구복을 벗은 후 슈트로 갈아입었다. 가슴에는 작은 꽃 한 송이도 달아놨다.","style":3,"background":1044,"log_type":1,"src_id":140104055,"trial_step":55},{"step":56,"speaker":"여름","content":"졸업식이 곧 시작하겠어요. 같이 가죠, 국장님?","voice":["vo_trial_40104_1_56"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104056,"trial_step":56},{"step":57,"speaker":"여름","content":"이게 바로 <청춘전기> 3화, 졸업식이에요.","voice":["vo_trial_40104_1_57"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104057,"trial_step":57},{"step":58,"content":"여름, 그리고 한 무리의 학생들과 함께 운동장으로 걸어갔다.","style":14,"background":10000,"log_type":1,"src_id":140104058,"trial_step":58},{"step":59,"speaker":"여름","content":"국장님… 여기예요, 여기!","voice":["vo_trial_40104_1_59"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104059,"trial_step":59},{"step":60,"options":["조용히 해!"],"style":6,"background":1044,"log_type":1,"src_id":140104060,"trial_step":60,"course":3,"choices":[{"text":"조용히 해!","goto":61}]},{"step":61,"speaker":"${PlayerName}","content":"난 옷도 없단 말이야. 경비원에게 발견돼서 쫓겨나면 안 된다고.","style":2,"background":1044,"log_type":1,"src_id":140104061,"trial_step":61},{"step":62,"speaker":"여름","content":"히히, 괜찮아요. 부모님이라고 얘기하면 돼요.","voice":["vo_trial_40104_1_150"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104062,"trial_step":62},{"step":63,"speaker":"여름","content":"어차피 이건 아카데미에서의 마지막 하루니까, 아무리 엄격한 경비원이라도… 학생들의 요구를 들어줄지도 몰라요.","voice":["vo_trial_40104_1_63"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104063,"trial_step":63},{"step":64,"options":["왜 갑자기 여기로 온 거야?"],"style":6,"background":1044,"log_type":1,"src_id":140104064,"trial_step":64,"course":3,"choices":[{"text":"왜 갑자기 여기로 온 거야?","goto":65}]},{"step":65,"speaker":"여름","content":"왜냐하면 제겐 졸업이라는 인생의 이력이 없잖아요.","voice":["vo_trial_40104_1_65"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104065,"trial_step":65},{"step":66,"content":"당신은 자신의 귀를 의심했다.","style":3,"background":1044,"log_type":1,"src_id":140104066,"trial_step":66},{"step":67,"content":"졸업을 안 했다고? 그럼 링 연구소는 어떻게 간 거야?","style":2,"background":1044,"log_type":1,"src_id":140104067,"trial_step":67},{"step":68,"speaker":"여름","content":"그건… 그들이 저를 원했기 때문이죠.","voice":["vo_trial_40104_1_68"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104068,"trial_step":68},{"step":69,"speaker":"여름","content":"연구소로 와서 링 물질과 관련된 것을 연구하고 싶진 않은지 묻더라고요.","voice":["vo_trial_40104_1_69"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104069,"trial_step":69},{"step":70,"content":"그래서 간 거고?","style":2,"background":1044,"log_type":1,"src_id":140104070,"trial_step":70},{"step":71,"speaker":"여름","content":"그럼요. 그건 링 물질이라고요! 결국 좋지 않은 결과를 맞았지만…","voice":["vo_trial_40104_1_71"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104071,"trial_step":71},{"step":72,"content":"……","style":2,"background":1044,"log_type":1,"src_id":140104072,"trial_step":72},{"step":73,"content":"당신은 잠시 할 말을 잃었다. 천재의 세계는 확실히 일반인과는 다른 것 같다.","style":3,"background":1044,"log_type":1,"src_id":140104073,"trial_step":73},{"step":74,"speaker":"교장","content":"아… 아…?","voice":["vo_trial_40104_1_74"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104074,"trial_step":74},{"step":75,"speaker":"교장","content":"들리나요?","voice":["vo_trial_40104_1_75"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104075,"trial_step":75},{"step":76,"content":"임시로 세워진 시상대 위에 교장 선생님의 모습을 한 사람이 마이크 테스트를 하고 있었다. 그의 등장에 떠들썩하던 학생들도 조용해졌다.","style":3,"background":1044,"log_type":1,"src_id":140104076,"trial_step":76},{"step":77,"speaker":"여름","content":"보아하니… 곧 시작하겠네요.","voice":["vo_trial_40104_1_77"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104077,"trial_step":77},{"step":78,"speaker":"교장","content":"아이린!","voice":["vo_trial_40104_1_78"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104078,"trial_step":78},{"step":79,"speaker":"아이린","content":"네!","voice":["vo_trial_40104_1_79"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104079,"trial_step":79},{"step":80,"speaker":"교장","content":"네 거다. 앞으로의 날들에서… 이곳의 학생들과 선생님들이 생각날 거다.","voice":["vo_trial_40104_1_80"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104080,"trial_step":80},{"step":81,"speaker":"교장","content":"넌 이곳에서의 여정을 마쳤다. 하지만 머지않아 새로운 여정을 맞이할 거야.","voice":["vo_trial_40104_1_81"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104081,"trial_step":81},{"step":82,"speaker":"교장","content":"넌 성적도 괜찮고 취미도 다양하니 조금만 노력하고 부지런히 고민하면… 자신에게 어울리는 길을 찾을 수 있을 거다.","voice":["vo_trial_40104_1_82"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104082,"trial_step":82},{"step":83,"speaker":"아이린","content":"감사합니다… 정말 감사합니다, 교장 선생님!","voice":["vo_trial_40104_1_83"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104083,"trial_step":83},{"step":84,"content":"여학생이 자신의 졸업증서를 받았다. 그녀는 기뻐하면서도 아쉬워했다.","style":3,"background":1044,"log_type":1,"src_id":140104084,"trial_step":84},{"step":85,"speaker":"교장","content":"그 다음은… 로니!","voice":["vo_trial_40104_1_85"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104085,"trial_step":85},{"step":86,"content":"로니라는 남학생이 천천히 시상대에 올랐다.","style":3,"background":1044,"log_type":1,"src_id":140104086,"trial_step":86},{"step":87,"speaker":"교장","content":"네가 막 왔을 땐 이곳에서 가장 개구쟁이였던 기억이 나는구나. 확실히… 시간이 사람을 변화시키긴 하나보다.","voice":["vo_trial_40104_1_87"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104087,"trial_step":87},{"step":88,"speaker":"로니","content":"아니에요. 모두 교장 선생님의 교육 덕입니다.","voice":["vo_trial_40104_1_88"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104088,"trial_step":88},{"step":89,"speaker":"교장","content":"하하하하… 립 서비스도 많이 배웠구나! 자, 받으렴! 언제나 환경에 적응할 수 있는 사람이 강자란다.","voice":["vo_trial_40104_1_89"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104089,"trial_step":89},{"step":90,"speaker":"교장","content":"앞으로의 활약을 기대하마, 로니!","voice":["vo_trial_40104_1_90"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104090,"trial_step":90},{"step":91,"content":"학생들이 한 명 한 명씩 시상대에 올라 그들의 3년 학업에 대한 졸업장을 받았다.","style":1,"background":1044,"log_type":1,"src_id":140104091,"trial_step":91},{"step":92,"content":"6월의 여름 바람은 너무도 뜨거웠다. 저녁이 가까워졌지만 석양에 여전히 그 온도가 남아있었다.","style":3,"background":1044,"log_type":1,"src_id":140104092,"trial_step":92},{"step":93,"content":"맨 뒤에 서서 교장 선생님의 졸업 연설을 듣다 여름이 갑자기 탄성을 질렀다.","style":3,"background":1044,"log_type":1,"src_id":140104093,"trial_step":93},{"step":94,"speaker":"여름","content":"아, 솔직히 말해서, 쟤네들이 부러워요.","voice":["vo_trial_40104_1_94"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104094,"trial_step":94},{"step":95,"speaker":"여름","content":"쟤네들은 저와 달리 강한 신체를 가지고 있잖아요. 전 어릴 때부터 약하다 보니… 혼자서는 아무것도 할 수 없어서, 교실에 앉아서 문제를 풀 수밖에 없었어요.","voice":["vo_trial_40104_1_95"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104095,"trial_step":95},{"step":96,"speaker":"여름","content":"처음에는 괜찮았어요. 제가 풀던 문제는 모두와 함께 의논할 수 있는 문제였으니까요. 하지만 문제가 어려워지면서 반 친구들은 모두 저를 이상한 사람처럼 대하게 되었죠.","voice":["vo_trial_40104_1_96"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104096,"trial_step":96},{"step":97,"content":"그때 반에… 친구가 없었어?","style":2,"background":1044,"log_type":1,"src_id":140104097,"trial_step":97},{"step":98,"speaker":"여름","content":"네… 굳이 말하자면 한 명은 있었어요.","voice":["vo_trial_40104_1_98"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104098,"trial_step":98},{"step":99,"speaker":"${PlayerName}","content":"누구?","style":2,"background":1044,"log_type":1,"src_id":140104099,"trial_step":99},{"step":100,"speaker":"여름","content":"애니메이션이요.","voice":["vo_trial_40104_1_100"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104100,"trial_step":100},{"step":101,"content":"……","style":2,"background":1044,"log_type":1,"src_id":140104101,"trial_step":101},{"step":102,"options":["사람이어야지"],"style":6,"background":1044,"log_type":1,"src_id":140104102,"trial_step":102,"course":3,"choices":[{"text":"사람이어야지","goto":103}]},{"step":103,"speaker":"여름","content":"그럼… 없어요. 하지만… 그땐 애니메이션만이 저를 반겨주었는걸요.","voice":["vo_trial_40104_1_103"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104103,"trial_step":103},{"step":104,"speaker":"여름","content":"세상을 구하는 그 무적 여고생은 제가 동경하는 모든 것들을 가졌어요. 청춘, 모험, 친구, 그리고 아름다운 일상. 애니메이션은 저한테 무한한 상상력과 용기를 줬죠.","voice":["vo_trial_40104_1_104"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104104,"trial_step":104},{"step":105,"options":["그게 바로 천재들의 대가겠지"],"style":6,"background":1044,"log_type":1,"src_id":140104105,"trial_step":105,"course":3,"choices":[{"text":"그게 바로 천재들의 대가겠지","goto":106}]},{"step":106,"content":"천재들은 모든 사람들이 이해할 수 없을 테니까.","style":3,"background":1044,"log_type":1,"src_id":140104106,"trial_step":106},{"step":107,"speaker":"여름","content":"그러니 <청춘전기>의 결말은 천재 여고생이 세상을 구하고 친구들의 곁으로 돌아와 무사히 졸업하고 영웅 모험에 종지부를 찍어야 해요.","voice":["vo_trial_40104_1_107"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104107,"trial_step":107},{"step":108,"speaker":"여름","content":"하지만… 아카데미에 돌아와도 친구가 없으니, 국장님이 억지로라도 머릿수를 채워주세요.","voice":["vo_trial_40104_1_108"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104108,"trial_step":108},{"step":109,"content":"3화 엔딩에 대해 얘기하고 있을 때 졸업생들의 이름이 모두 불렸다.","style":3,"background":1044,"log_type":1,"src_id":140104109,"trial_step":109},{"step":110,"content":"현장에 있던 학생들은 졸업장을 들고 나와 사진을 찍으며 즐거워했다. 현장에는 당신과 여름만이 남아있었다.","style":3,"background":1044,"log_type":1,"src_id":140104110,"trial_step":110},{"step":111,"options":["넌 안 가?"],"style":6,"background":1044,"log_type":1,"src_id":140104111,"trial_step":111,"course":3,"choices":[{"text":"넌 안 가?","goto":112}]},{"step":112,"content":"당신은 망설이던 여름을 초대했다.","style":3,"background":1044,"log_type":1,"src_id":140104112,"trial_step":112},{"step":113,"speaker":"여름","content":"음… 안될 거 없죠. 잠시 안경 좀 쓸게요! 어때요, 이러니까 더 고등학생 같죠?","voice":["vo_trial_40104_1_113"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104113,"trial_step":113},{"step":114,"content":"하지만 당신이 군중 속에 발을 들여놓으려던 순간, 나이팅게일의 통신을 받았다.","style":3,"background":1044,"log_type":1,"src_id":140104114,"trial_step":114},{"step":115,"speaker":"나이팅게일","content":"국장님, 괜찮으십니까?","voice":["vo_trial_40104_1_115"],"voice_bank":"vo_xiayin_trial","style":11,"background":1044,"log_type":1,"src_id":140104115,"trial_step":115},{"step":116,"speaker":"${PlayerName}","content":"조금 다치기는 했지만 심하지는 않아.","style":2,"background":1044,"log_type":1,"src_id":140104116,"trial_step":116},{"step":117,"speaker":"나이팅게일","content":"수감자 여름이 통제하에 있습니까?","voice":["vo_trial_40104_1_117"],"voice_bank":"vo_xiayin_trial","style":11,"background":1044,"log_type":1,"src_id":140104117,"trial_step":117},{"step":118,"content":"여름은 불편한 듯 당신을 힐끗 보았다.","style":3,"background":1044,"log_type":1,"src_id":140104118,"trial_step":118},{"step":119,"speaker":"${PlayerName}","content":"응.","style":2,"background":1044,"log_type":1,"src_id":140104119,"trial_step":119},{"step":120,"speaker":"나이팅게일","content":"MBCC 추적 부대가 곧 그곳에 도착합니다. 거기 그대로 계십시오.","voice":["vo_trial_40104_1_120"],"voice_bank":"vo_xiayin_trial","style":11,"background":1044,"log_type":1,"src_id":140104120,"trial_step":120},{"step":121,"speaker":"${PlayerName}","content":"알겠어.","style":2,"background":1044,"log_type":1,"src_id":140104121,"trial_step":121},{"step":122,"speaker":"여름","content":"아… 역시, 수감자들이 참석할 수 있는 행사는 아니었군요.","voice":["vo_trial_40104_1_122"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104122,"trial_step":122},{"step":123,"speaker":"${PlayerName}","content":"미안하게 됐어.","style":2,"background":1044,"log_type":1,"src_id":140104123,"trial_step":123},{"step":124,"speaker":"여름","content":"하하하… 국장님 이런 일로 사과하지 마세요.","voice":["vo_trial_40104_1_124"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104124,"trial_step":124},{"step":125,"speaker":"여름","content":"그냥 즐겨본 거예요. 한 번도 경험하지 못한 걸 경험해 보고 싶었거든요.","voice":["vo_trial_40104_1_125"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104125,"trial_step":125},{"step":126,"speaker":"여름","content":"충분히 재미있다면 계속 하겠지만, 이번 상황은 특수하니 여기까지 하죠…","voice":["vo_trial_40104_1_126"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104126,"trial_step":126},{"step":127,"speaker":"여름","content":"이게 바로 저 여름의 원칙이에요.","voice":["vo_trial_40104_1_127"],"voice_bank":"vo_xiayin_trial","style":1,"background":1044,"log_type":1,"src_id":140104127,"trial_step":127},{"step":128,"content":"석양 아래에서 졸업식은 성황리에 막을 내렸고, 당신과 여름도 관리국으로 돌아가는 전용차에 올라탔다.","style":14,"background":10000,"log_type":1,"src_id":140104128,"trial_step":128},{"step":129,"speaker":"여름","content":"그리고, 오늘은 그냥 연습 수준이었어요.","voice":["vo_trial_40104_1_129"],"voice_bank":"vo_xiayin_trial","style":1,"background":1031,"log_type":1,"src_id":140104129,"trial_step":129},{"step":130,"options":["그게 연습 수준이었다고?","정상적인 전투는 얼마나 강한 거야?"],"style":6,"background":1031,"log_type":1,"src_id":140104130,"trial_step":130,"course":3,"choices":[{"text":"그게 연습 수준이었다고?","goto":131},{"text":"정상적인 전투는 얼마나 강한 거야?","goto":null}]},{"step":131,"speaker":"여름","content":"세상의 위기는 제가 상상했던 것보다 더 크더라고요.","voice":["vo_trial_40104_1_131"],"voice_bank":"vo_xiayin_trial","style":1,"background":1031,"log_type":1,"src_id":140104131,"trial_step":131},{"step":132,"speaker":"여름","content":"라플라스와의 대전에서 저는 이상한 힘을 느꼈어요.","voice":["vo_trial_40104_1_132"],"voice_bank":"vo_xiayin_trial","style":1,"background":1031,"log_type":1,"src_id":140104132,"trial_step":132},{"step":133,"speaker":"여름","content":"다행히 국장님이 곁에 있어서 제가 그의 힘을 완전히 소멸시켜버릴 수 있었죠. 그래서… 국장님은 제가 세상을 구하는데 꼭 필요한 촉매제인 셈이죠.","voice":["vo_trial_40104_1_133"],"voice_bank":"vo_xiayin_trial","style":1,"background":1031,"log_type":1,"src_id":140104133,"trial_step":133},{"step":134,"speaker":"여름","content":"아… 아니, 동료요.","voice":["vo_trial_40104_1_134"],"voice_bank":"vo_xiayin_trial","style":1,"background":1031,"log_type":1,"src_id":140104134,"trial_step":134},{"step":135,"speaker":"여름","content":"아무튼, MBCC로 돌아가죠.","voice":["vo_trial_40104_1_135"],"voice_bank":"vo_xiayin_trial","style":1,"background":1031,"log_type":1,"src_id":140104135,"trial_step":135},{"step":136,"speaker":"여름","content":"링 연구소 음모가들의 도움은 필요 없어요.","voice":["vo_trial_40104_1_136"],"voice_bank":"vo_xiayin_trial","style":1,"background":1031,"log_type":1,"src_id":140104136,"trial_step":136},{"step":137,"speaker":"여름","content":"어떤 난제가 닥치더라도 저는 제 시나리오대로 그리고 저만의 방식으로 진실을 찾아 세상을 구할 거예요.","voice":["vo_trial_40104_1_137"],"voice_bank":"vo_xiayin_trial","style":1,"background":1031,"log_type":1,"src_id":140104137,"trial_step":137},{"step":138,"speaker":"여름","content":"<청춘전기>의 막을 완벽하게 내려야죠.","voice":["vo_trial_40104_1_138"],"voice_bank":"vo_xiayin_trial","style":1,"background":1031,"log_type":1,"src_id":140104138,"trial_step":138},{"step":139,"speaker":"여름","content":"국장님, 왜 수감실에 아무것도 가져가지 못하게 하는 거예요?","voice":["vo_trial_40104_1_139"],"voice_bank":"vo_xiayin_trial","style":1,"background":1025,"log_type":1,"src_id":140104139,"trial_step":139},{"step":140,"options":["가지고 들어갈 수 있으면 수감실이겠어?"],"style":6,"background":1025,"log_type":1,"src_id":140104140,"trial_step":140,"course":3,"choices":[{"text":"가지고 들어갈 수 있으면 수감실이겠어?","goto":141}]},{"step":141,"speaker":"여름","content":"하지만… 전 초콜릿이 먹고 싶은걸요.","voice":["vo_trial_40104_1_141"],"voice_bank":"vo_xiayin_trial","style":1,"background":1025,"log_type":1,"src_id":140104141,"trial_step":141},{"step":142,"speaker":"${PlayerName}","content":"초콜릿은 무슨.","style":2,"background":1025,"log_type":1,"src_id":140104142,"trial_step":142},{"step":143,"speaker":"${PlayerName}","content":"지난번 그 일 아직 기억하겠지?","style":2,"background":1025,"log_type":1,"src_id":140104143,"trial_step":143},{"step":144,"speaker":"여름","content":"켁! 그건 예외예요! 예외라고요!","voice":["vo_trial_40104_1_144"],"voice_bank":"vo_xiayin_trial","style":1,"background":1025,"log_type":1,"src_id":140104144,"trial_step":144},{"step":145,"speaker":"여름","content":"이미 다 말했잖아요! 발명에는 언제나 예외가 따른다고요!","voice":["vo_trial_40104_1_145"],"voice_bank":"vo_xiayin_trial","style":1,"background":1025,"log_type":1,"src_id":140104145,"trial_step":145},{"step":146,"speaker":"여름","content":"…음, 그럼 제가 구매센터에서 주문하면 되겠군요!","voice":["vo_trial_40104_1_146"],"voice_bank":"vo_xiayin_trial","style":1,"background":1025,"log_type":1,"src_id":140104146,"trial_step":146},{"step":147,"content":"가능하지. 하지만 최종 결재는 날 거쳐야 해.","style":2,"background":1025,"log_type":1,"src_id":140104147,"trial_step":147},{"step":148,"speaker":"여름","content":"흑흑… 젠장. 이제 나이팅게일 언니에게 몰래 더 많이 달라고도 못하겠네.","voice":["vo_trial_40104_1_148"],"voice_bank":"vo_xiayin_trial","style":1,"background":1025,"log_type":1,"src_id":140104148,"trial_step":148},{"step":149,"speaker":"여름","content":"발명 시간이 지연돼서 <청춘전기>의 지표를 달성하지 못하고 세상을 구할 수 없게 되면 국장님이 책임져야 해요! 저기! 가지 마세요!","voice":["vo_trial_40104_1_149"],"voice_bank":"vo_xiayin_trial","style":1,"background":1025,"log_type":1,"src_id":140104149,"trial_step":149},{"step":150,"content":"천재 발명가는 당신이 수감실에서 나가는 것을 눈물 고인 눈으로 바라보았다.","style":3,"background":1025,"log_type":1,"src_id":140104150,"trial_step":150},{"step":151,"content":"하지만 마지막 초콜릿 주문 결재서에서 당신은 조용히 수량을 늘려주었다…","style":3,"background":10000,"log_type":1,"src_id":140104151,"trial_step":151},{"step":152,"content":"어쩌면, 이걸로 이번 겨울에 졸업하지 못한 소녀의 아쉬움을 조금이나마 달래줄 수 있을지도 모른다.","style":3,"background":10000,"log_type":1,"src_id":140104152,"trial_step":152}]}