{"id":401540005,"chapter_id":50045,"scene_id":45017,"steps":[{"step":1,"speaker":"에코","content":"~~~~","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":2,"speaker":"에코","content":"'호화로운 궁전은 오래가지 못하고.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":3,"speaker":"에코","content":"'모두의 미래가 처량하네.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":4,"speaker":"에코","content":"'나는 미디엄으로 익힌 스테이크를 원하지.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":5,"speaker":"에코","content":"'누가 벽지처럼 바짝 마른 빵을 원하겠는가.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":6,"speaker":"에코","content":"'나는 반짝이는 황금 왕관과 주홍빛 옥이.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":7,"speaker":"에코","content":"'내 고귀한 머리와 몸을 장식하기를 원하네.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":8,"speaker":"에코","content":"'여인이여, 나의 부탁을 들어주오.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":9,"speaker":"에코","content":"'포르투나에는 주인이 되어 줄 여자가 필요하네.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":10,"speaker":"에코","content":"'금발의 여자가 당신의 꿈을 이루어주리.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":11,"speaker":"에코","content":"'당신의 부탁이 그녀의 유일한 목적이라네.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":12,"speaker":"에코","content":"'포르투나, 포르투나.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":13,"speaker":"에코","content":"'탐욕의 냄새를 맡은 마귀가 습격해 올 것이네.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":14,"speaker":"에코","content":"'포르투나, 포르투나.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":15,"speaker":"에코","content":"'다음 이야기는 불타오르며 시작되네.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":16,"speaker":"에코","content":"~~~~","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":17,"speaker":"에코","content":"'금발의 여자가 왕관을 주워 들고.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":18,"speaker":"에코","content":"'그녀는 특별석에서 잠시 휴식을 취하네.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":19,"speaker":"에코","content":"'거센 불길은 완벽한 커튼콜.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":20,"speaker":"에코","content":"'포르투나에 다시 찾아오는 걸 환영하네, 당신을 기다리고 있겠네.'","style":1,"background":2173,"is_centered":true,"log_type":1}]}