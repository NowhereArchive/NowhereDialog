{"id":1010102,"chapter_id":1010102,"scene_id":1,"steps":[{"step":1,"content":"재판까지 남은 시간\n15일","style":9,"background":10000,"log_type":1,"src_id":110102001,"trial_step":1},{"step":2,"content":"당신은 복도를 지나 데이먼의 수감실에 도착했다.","style":3,"background":107,"log_type":1,"src_id":110102002,"trial_step":2},{"step":3,"content":"경호원 몇 명이 문 앞을 지키고 있었다.","style":3,"background":107,"log_type":1,"src_id":110102003,"trial_step":3},{"step":4,"speaker":"경호원","content":"증거물은 준비됐습니다. 용의자 데이먼·쉬어드가 깨어났으니 언제든 심문을 시작하실 수 있습니다.","voice":["vo_trial_10102_1_1"],"voice_bank":"vo_dimeng_trial","style":1,"background":107,"log_type":1,"src_id":110102004,"trial_step":4},{"step":5,"options":["수감실의 문을 연다"],"style":6,"background":107,"log_type":1,"src_id":110102005,"trial_step":5,"course":3,"choices":[{"text":"수감실의 문을 연다","goto":6}]},{"step":6,"content":"당신은 근무자를 향해 고개를 끄덕이고 수감실 문 앞에서 심호흡을 했다.","style":3,"background":107,"log_type":1,"src_id":110102006,"trial_step":6},{"step":7,"content":"수감실 문이 열렸다. 하지만 데이먼은 보이지 않았다.","style":3,"background":107,"log_type":1,"src_id":110102007,"trial_step":7},{"step":8,"speaker":"경호원","content":"국장님, 조심하십시오!","voice":["vo_trial_10102_1_2"],"voice_bank":"vo_dimeng_trial","style":1,"background":107,"log_type":1,"src_id":110102008,"trial_step":8},{"step":9,"content":"심상치 않은 기운을 느끼고 재빨리 고개를 돌린 순간, 데이먼의 탁한 눈동자가 보였다.","style":3,"background":107,"log_type":1,"src_id":110102009,"trial_step":9},{"step":10,"content":"미처 반응하기도 전에 머리에서 강렬한 통증이 느껴지더니 눈앞이 캄캄해졌고, 그만 의식을 잃고 말았다…","style":3,"background":107,"log_type":1,"src_id":110102010,"trial_step":10},{"step":11,"content":"무슨 짓이야?!","style":3,"background":10000,"log_type":1,"src_id":110102011,"trial_step":11},{"step":12,"content":"국장님에게서… 손 떼…","style":3,"background":10000,"log_type":1,"src_id":110102012,"trial_step":12},{"step":13,"content":"총 내려놔… 보내 줘…","style":3,"background":10000,"log_type":1,"src_id":110102013,"trial_step":13},{"step":14,"content":"두 눈을 뜨자 페인트 칠이 벗겨진 천장이 보였다. 팔다리는 꼼짝도 못 할 만큼 꽉 묶인 상태였다.","style":3,"background":1034,"log_type":1,"src_id":110102014,"trial_step":14},{"step":15,"content":"어렴풋이 지난 일이 떠올랐다. 수감실에서 데이먼을 심문하려다 습격을 당한 것 같았다.","style":3,"background":1034,"log_type":1,"src_id":110102015,"trial_step":15},{"step":16,"content":"데이먼은 의자에 앉아 눈을 붙이고 있었다. 연일 계속된 도피와 과거부터 누적되어 온 상처 때문에 지친 것 같았다.","style":3,"background":1034,"log_type":1,"src_id":110102016,"trial_step":16},{"step":17,"speaker":"데이먼","content":"…깼나?","voice":["vo_trial_10102_1_3"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102017,"trial_step":17},{"step":18,"content":"팔다리를 움직이자 기척을 느낀 데이먼이 눈을 떴다. 그는 탁자 위에 놓인 컵을 들고 자리에서 일어나 당신의 입에 가져다 댔다.","style":3,"background":1034,"log_type":1,"src_id":110102018,"trial_step":18},{"step":19,"speaker":"데이먼","content":"……","voice":["vo_trial_10102_1_4"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102019,"trial_step":19},{"step":20,"options":["물을 마신다","거절한다"],"style":6,"background":1034,"log_type":1,"src_id":110102020,"trial_step":20,"course":3,"choices":[{"text":"물을 마신다","goto":21},{"text":"거절한다","goto":22}]},{"step":21,"content":"거부하고 싶었지만 바짝 탄 입술과 목구멍이 수분을 갈구하고 있었다.","style":3,"background":1034,"log_type":1,"src_id":110102021,"trial_step":21,"next":[24]},{"step":22,"speaker":"데이먼","content":"탈수야.","voice":["vo_trial_10102_1_5"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102022,"trial_step":22},{"step":23,"content":"갈라진 입술에서 통증이 느껴졌다. 당신은 데이먼의 말이 옳다고 느끼며 순순히 물을 마셨다.","style":3,"background":1034,"log_type":1,"src_id":110102023,"trial_step":23},{"step":24,"content":"하지만 데이먼은 아무 말도 하지 않았고, 여전히 당신에게 설명할 마음이 없어 보였다.","style":3,"background":1034,"log_type":1,"src_id":110102024,"trial_step":24},{"step":25,"content":"당신은 몸을 뒤척인 끝에 개인 단말기를 지니고 있음을 깨달았다. 그것만 있으면 관리국이 당신의 위치를 추적하는 것은 시간문제이리라.","style":3,"background":1034,"log_type":1,"src_id":110102025,"trial_step":25},{"step":26,"speaker":"데이먼","content":"……","voice":["vo_trial_10102_1_6"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102026,"trial_step":26},{"step":27,"content":"당신의 움직임을 확인한 데이먼이 눈을 가늘게 뜨고 당신을 바라보았다.","style":3,"background":1034,"log_type":1,"src_id":110102027,"trial_step":27},{"step":28,"speaker":"데이먼","content":"가만히 있어.","voice":["vo_trial_10102_1_7"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102028,"trial_step":28},{"step":29,"content":"데이먼의 눈동자는 충혈되어 있었다. 목소리도 위협적이기는 했으나 피곤함이 잔뜩 묻어 있었다.","style":3,"background":1034,"log_type":1,"src_id":110102029,"trial_step":29},{"step":30,"content":"그의 컨디션은 실로 최악이었다. 더는 그 위협적인 태도를 유지하기 힘들 정도였다.","style":3,"background":1034,"log_type":1,"src_id":110102030,"trial_step":30},{"step":31,"options":["당신을 납치한 이유를 묻는다"],"style":6,"background":1034,"log_type":1,"src_id":110102031,"trial_step":31,"course":3,"choices":[{"text":"당신을 납치한 이유를 묻는다","goto":32}]},{"step":32,"content":"너는 네 목표를 달성했다. 관리국을 탈출했어. 그런데 왜 굳이 나를 끌고 온 거지?","style":2,"background":1034,"log_type":1,"src_id":110102032,"trial_step":32},{"step":33,"speaker":"데이먼","content":"……","voice":["vo_trial_10102_1_8"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102033,"trial_step":33},{"step":34,"content":"날 죽일 셈인가?","style":2,"background":1034,"log_type":1,"src_id":110102034,"trial_step":34},{"step":35,"content":"데이먼이 의자에 앉아 몸을 기울였다. 희미한 불빛이 그 앞으로 까만 그림자를 드리웠다.","style":3,"background":1034,"log_type":1,"src_id":110102035,"trial_step":35},{"step":36,"content":"오랜 침묵 끝에 갈라진 목소리가 다시 방 안을 울렸다.","style":3,"background":1034,"log_type":1,"src_id":110102036,"trial_step":36},{"step":37,"speaker":"데이먼","content":"죽이지 않을지도 모르지…","voice":["vo_trial_10102_1_9"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102037,"trial_step":37},{"step":38,"speaker":"데이먼","content":"내 복수를 방해하지 않는다면 보내 줄 수도 있다.","voice":["vo_trial_10102_1_10"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102038,"trial_step":38},{"step":39,"content":"복수. 데이먼의 입에서 다시 한번 그 단어가 흘러나왔다.","style":3,"background":1034,"log_type":1,"src_id":110102039,"trial_step":39},{"step":40,"options":["대체 누구에게 복수를 한다는 거야"],"style":6,"background":1034,"log_type":1,"src_id":110102040,"trial_step":40,"course":3,"choices":[{"text":"대체 누구에게 복수를 한다는 거야","goto":41}]},{"step":41,"speaker":"데이먼","content":"알 필요 없…","voice":["vo_trial_10102_1_11"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102041,"trial_step":41},{"step":42,"content":"띵…","style":3,"background":1034,"log_type":1,"src_id":110102042,"trial_step":42},{"step":43,"content":"갑작스러운 소리가 데이먼의 말을 끊었다. 벽 모퉁이의 수도관에서 흘러나온 소리였다. 정찰 감지 트랩이 반응한 것인지, 데이먼이 즉시 경계 모드에 돌입했다.","style":3,"background":1034,"log_type":1,"src_id":110102043,"trial_step":43},{"step":44,"content":"즉, 누군가 당신을 구하러 왔다는 뜻이었다.","style":3,"background":1034,"log_type":1,"src_id":110102044,"trial_step":44},{"step":45,"content":"시의회의 피해자들이 당신의 복수 대상이었나? 대체 그들이 무슨 짓을 했는데?","style":2,"background":1034,"log_type":1,"src_id":110102045,"trial_step":45},{"step":46,"content":"데이먼은 당신을 무시하고 조심스레 창문 쪽으로 다가가 커튼을 열고 밖을 내다보았다. 그리고 빠른 걸음으로 다가왔다.","style":3,"background":1034,"log_type":1,"src_id":110102046,"trial_step":46},{"step":47,"content":"그들이 널 해쳤나?","style":2,"background":1034,"log_type":1,"src_id":110102047,"trial_step":47},{"step":48,"speaker":"데이먼","content":"닥쳐.","voice":["vo_trial_10102_1_12"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102048,"trial_step":48},{"step":49,"content":"데이먼은 안면 근육을 살짝 일그러뜨렸지만, 여전히 당신의 질문에 대답하지 않았다. 트랩이 반응한 탓인지 다소 불안해하며 그곳을 떠날 채비를 했다.","style":3,"background":1034,"log_type":1,"src_id":110102049,"trial_step":49},{"step":50,"content":"구조대를 위해 시간을 벌어야 했다.","style":3,"background":1034,"log_type":1,"src_id":110102050,"trial_step":50},{"step":51,"options":["데이먼을 자극한다"],"style":6,"background":1034,"log_type":1,"src_id":110102051,"trial_step":51,"course":3,"choices":[{"text":"데이먼을 자극한다","goto":52}]},{"step":52,"content":"계속 도망자의 삶을 살 텐가?","style":2,"background":1034,"log_type":1,"src_id":110102052,"trial_step":52},{"step":53,"speaker":"데이먼","content":"?","voice":["vo_trial_10102_1_13"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102053,"trial_step":53},{"step":54,"content":"8년이다. 네가 죽인 사람은 점점 많아졌고, 네 악명도 높아졌지. 하지만 진실을 아는 사람은 아무도 없어. 사람들은 널 살인마로 치부하고 두려워하며 증오할 뿐이야…","style":2,"background":1034,"log_type":1,"src_id":110102054,"trial_step":54},{"step":55,"content":"너는 도망자로 전락했고, 몸도 많이 망가졌다. 그래서… 네 복수는 어디까지 진행됐는데?","style":2,"background":1034,"log_type":1,"src_id":110102055,"trial_step":55},{"step":56,"speaker":"데이먼","content":"닥치라고!","voice":["vo_trial_10102_1_14"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102056,"trial_step":56},{"step":57,"content":"데이먼이 몸을 숙여 당신의 멱살을 움켜쥐었다.","style":3,"background":1034,"log_type":1,"src_id":110102057,"trial_step":57},{"step":58,"speaker":"데이먼","content":"뭘 안다고 함부로 지껄여!","voice":["vo_trial_10102_1_15"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102058,"trial_step":58},{"step":59,"content":"그럼 말해 봐. 대체 원하는 게 뭐야?","style":2,"background":1034,"log_type":1,"src_id":110102059,"trial_step":59},{"step":60,"content":"8년간 억눌렀던 분노가 터져 나오기 시작했다.","style":3,"background":1034,"log_type":1,"src_id":110102060,"trial_step":60},{"step":61,"speaker":"데이먼","content":"그 새끼들은 아벨이 죽은 것에 대한 대가를 치러야 해!","voice":["vo_trial_10102_1_16"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102061,"trial_step":61},{"step":62,"content":"아벨을 죽게 만든 원흉이 시의회라는 뜻인가?","style":2,"background":1034,"log_type":1,"src_id":110102062,"trial_step":62},{"step":63,"speaker":"데이먼","content":"아직도 모르겠나?","voice":["vo_trial_10102_1_17"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102063,"trial_step":63},{"step":64,"speaker":"데이먼","content":"8년 전, 아벨은 <서구 치안 조례>를 폐기하기 위해서 출마했다…","voice":["vo_trial_10102_1_18"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102064,"trial_step":64},{"step":65,"speaker":"데이먼","content":"시의회의 구더기 새끼들이 아니고서야 누가, 왜 아벨을 죽이겠나?!","voice":["vo_trial_10102_1_19"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102065,"trial_step":65},{"step":66,"content":"데이먼의 얼굴이 살짝 비뚤어져 있었다. 분노와 살의가 오랫동안 그의 신경을 팽팽히 긴장시킨 탓이리라.","style":3,"background":1034,"log_type":1,"src_id":110102066,"trial_step":66},{"step":67,"speaker":"데이먼","content":"놈들은 내 부하였던 펜을 매수해 변이 무기를 지닌 깡패 새끼들을 유세장에 잠입시켰어.","voice":["vo_trial_10102_1_20"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102067,"trial_step":67},{"step":68,"speaker":"데이먼","content":"난 괴변체가 된 아벨을 내 손으로 죽일 수밖에 없었다. 나의…아버지를.","voice":["vo_trial_10102_1_21"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102068,"trial_step":68},{"step":69,"content":"'아버지'라는 단어에서 데이먼의 목소리가 떨렸다.","style":3,"background":1034,"log_type":1,"src_id":110102069,"trial_step":69},{"step":70,"speaker":"데이먼","content":"놈들은 내게 죄를 덮어씌웠어…","voice":["vo_trial_10102_1_22"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102070,"trial_step":70},{"step":71,"speaker":"데이먼","content":"웃긴 게 뭔지 알고 있나? 모든 사람이 시의회의 말을 곧이곧대로 믿었다는 거다. 왜냐하면 난… 신디케이트 출신이니까.","voice":["vo_trial_10102_1_23"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102071,"trial_step":71},{"step":72,"speaker":"데이먼","content":"그렇다면 신디케이트 방식으로 처리하는 수밖에. 안 그래…?","voice":["vo_trial_10102_1_24"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102072,"trial_step":72},{"step":73,"content":"데이먼이 당신 앞으로 다가와 한 마디씩 힘주어 말했다.","style":3,"background":1034,"log_type":1,"src_id":110102073,"trial_step":73},{"step":74,"speaker":"데이먼","content":"그 사건과 관련된 놈들은 전부 죽어야 해.","voice":["vo_trial_10102_1_26"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102074,"trial_step":74},{"step":75,"content":"데이먼은 하소연할 곳 없었던 8년 묵은 분노를 전부 쏟아냈다.","style":3,"background":1034,"log_type":1,"src_id":110102075,"trial_step":75},{"step":76,"content":"단숨에 이야기를 토해낸 그가 숨을 헐떡였다. 두 눈은 시뻘겋게 충혈되어 있었다. 여전히 흉악한 눈빛 깊은 곳에서 무기력감이 감돌고 있었다.","style":3,"background":1034,"log_type":1,"src_id":110102076,"trial_step":76},{"step":77,"options":["내가 도와줄게"],"style":6,"background":1034,"log_type":1,"src_id":110102077,"trial_step":77,"course":3,"choices":[{"text":"내가 도와줄게","goto":78}]},{"step":78,"speaker":"데이먼","content":"날 돕는다고?","voice":["vo_trial_10102_1_27"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102078,"trial_step":78},{"step":79,"content":"데이먼이 냉소로 화답했다.","style":3,"background":1034,"log_type":1,"src_id":110102079,"trial_step":79},{"step":80,"speaker":"데이먼","content":"어떻게? 시의회에 선전포고라도 할 셈인가?","voice":["vo_trial_10102_1_28"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102080,"trial_step":80},{"step":81,"content":"넌 관리국의 수감자다. 네 말이 전부 사실이라면, 나는 너를 보호할 의무가 있어.","style":2,"background":1034,"log_type":1,"src_id":110102081,"trial_step":81},{"step":82,"content":"일단 살아야 배후도 찾아낼 수 있지 않겠나. 그 몸으로 도망다니다간 곧 죽을 거야… 우선 나와 함께 관리국으로 돌아가자. 아직 늦지 않았다.","style":2,"background":1034,"log_type":1,"src_id":110102082,"trial_step":82},{"step":83,"content":"데이먼이 천장을 바라보며 숨을 깊이 들이마셨다. 한결 차분해진 모습이었다.","style":3,"background":1034,"log_type":1,"src_id":110102083,"trial_step":83},{"step":84,"speaker":"데이먼","content":"…8년 전이었다면 널 믿었을지도 몰라.","voice":["vo_trial_10102_1_29"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102084,"trial_step":84},{"step":85,"speaker":"데이먼","content":"하지만 지금은 그 누구도 믿지 않아.","voice":["vo_trial_10102_1_30"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102085,"trial_step":85},{"step":86,"speaker":"데이먼","content":"구조대가 올 때까지 시간을 끌고 있는 거 안다. 더 이상 기회를 줄 생각은 없어.","voice":["vo_trial_10102_1_31"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102086,"trial_step":86},{"step":87,"content":"당신은 데이먼을 설득하기 위해 필사적으로 몸을 움직였다.","style":3,"background":1034,"log_type":1,"src_id":110102087,"trial_step":87},{"step":88,"content":"격렬하게 움직인 탓에 심문 당시 증거로 사용하려 했던 팔찌가 주머니에서 흘러내려 땅에 떨어졌다.","style":3,"background":1034,"log_type":1,"src_id":110102088,"trial_step":88},{"step":89,"speaker":"데이먼","content":"!","voice":["vo_trial_10102_1_32"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102089,"trial_step":89},{"step":90,"content":"데이먼의 동공이 빠르게 수축했다. 그 물건을 보는 건 이미 두 번째지만, 데이먼은 여전히 동요를 감추지 못했다.","style":3,"background":1034,"log_type":1,"src_id":110102090,"trial_step":90},{"step":91,"content":"당신은 그제야 심문 당시 묻고자 했던 질문과 자료 조사 과정에서 발견한 궁금증을 떠올렸다.","style":3,"background":1034,"log_type":1,"src_id":110102091,"trial_step":91},{"step":92,"speaker":"나이팅게일","content":"이변이 없는 한, 시의회가 준 그 팔찌의 주인은 바로 그녀입니다.","voice":["vo_trial_10102_1_33"],"voice_bank":"vo_dimeng_trial","style":1,"background":10000,"log_type":1,"src_id":110102092,"trial_step":92},{"step":93,"speaker":"나이팅게일","content":"아벨의 친딸이자 데이먼의 의붓여동생…","voice":["vo_trial_10102_1_34"],"voice_bank":"vo_dimeng_trial","style":1,"background":10000,"log_type":1,"src_id":110102093,"trial_step":93},{"step":94,"options":["이름을 말한다"],"style":6,"background":1034,"log_type":1,"src_id":110102094,"trial_step":94,"course":3,"choices":[{"text":"이름을 말한다","goto":95}]},{"step":95,"content":"베라·쉬어드.","style":2,"background":1034,"log_type":1,"src_id":110102095,"trial_step":95},{"step":96,"content":"데이먼은 땅에 떨어진 팔찌만 바라볼 뿐, 아무 반응도 보이지 않았다.","style":3,"background":1034,"log_type":1,"src_id":110102096,"trial_step":96},{"step":97,"content":"네게 중요한 인물인가?","style":2,"background":1034,"log_type":1,"src_id":110102097,"trial_step":97},{"step":98,"speaker":"데이먼","content":"내 가족… 내 여동생이었다.","voice":["vo_trial_10102_1_35"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102098,"trial_step":98},{"step":99,"content":"데이먼의 표정은 당신의 질문을 인정하는 듯했다.","style":3,"background":1034,"log_type":1,"src_id":110102099,"trial_step":99},{"step":100,"content":"바닥에서 팔찌를 주워 드는 그의 몸짓이 몹시 부드러웠다.","style":3,"background":1034,"log_type":1,"src_id":110102100,"trial_step":100},{"step":101,"content":"그는 손을 들어올렸고, 하얀 팔찌가 가볍게 흔들렸다. 커튼 틈으로 희미한 빛이 쏟아져 그를 비추자 한번도 본 적 없는 따뜻한 표정을 지은 얼굴이 보였다.","style":3,"background":1034,"log_type":1,"src_id":110102101,"trial_step":101},{"step":102,"content":"지금 어디 있지?","style":2,"background":1034,"log_type":1,"src_id":110102102,"trial_step":102},{"step":103,"speaker":"데이먼","content":"나도… 모른다.","voice":["vo_trial_10102_1_36"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102103,"trial_step":103},{"step":104,"speaker":"데이먼","content":"나는 도망자이고, 그 아이는 의원의 딸이야. 내가 어찌 찾아가겠나.","voice":["vo_trial_10102_1_37"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102104,"trial_step":104},{"step":105,"content":"그건 시의회가 준 팔찌인데…","style":2,"background":1034,"log_type":1,"src_id":110102105,"trial_step":105},{"step":106,"speaker":"데이먼","content":"놈들이 베라를 납치해 날 협박할 거란 가능성을 배제할 수 없지.","voice":["vo_trial_10102_1_38"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102106,"trial_step":106},{"step":107,"content":"그래서 네 몸 상태에도 아랑곳하지 않고 관리국을 탈출한 건가?","style":2,"background":1034,"log_type":1,"src_id":110102107,"trial_step":107},{"step":108,"speaker":"데이먼","content":"베라는 내 마지막 가족이야… 반드시 찾아야 해.","voice":["vo_trial_10102_1_39"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102108,"trial_step":108},{"step":109,"content":"데이먼이 팔찌를 손에 쥐고 당신을 향해 몸을 돌렸다. 전에 없이 평온한 얼굴이었다.","style":3,"background":1034,"log_type":1,"src_id":110102109,"trial_step":109},{"step":110,"options":["내가 도와주겠다"],"style":6,"background":1034,"log_type":1,"src_id":110102110,"trial_step":110,"course":3,"choices":[{"text":"내가 도와주겠다","goto":111}]},{"step":111,"content":"데이먼은 이번엔 단칼에 거절하지 않았다.","style":3,"background":1034,"log_type":1,"src_id":110102111,"trial_step":111},{"step":112,"content":"관리국은 충분한 인력과 촘촘한 정보망을 가지고 있어. 네가 관련 정보만 제공해 주면 그리 어렵지 않게 찾을 수 있을 거야.","style":2,"background":1034,"log_type":1,"src_id":110102112,"trial_step":112},{"step":113,"content":"나는 너의 적이 아니다, 데이먼. 나와 함께 돌아가자. 모든 일을 혼자 짊어질 필요는 없어.","style":2,"background":1034,"log_type":1,"src_id":110102113,"trial_step":113},{"step":114,"content":"데이먼은 아무 반응도 하지 않고 조용히 당신을 응시했다.","style":3,"background":1034,"log_type":1,"src_id":110102114,"trial_step":114},{"step":115,"content":"한 가지 다행인 것은, 그의 두 눈에 더 이상 적의가 보이지 않는다는 점이었다.","style":3,"background":1034,"log_type":1,"src_id":110102115,"trial_step":115},{"step":116,"content":"이윽고 데이먼이 입을 열었다.","style":3,"background":1034,"log_type":1,"src_id":110102116,"trial_step":116},{"step":117,"speaker":"데이먼","content":"고맙다…","voice":["vo_trial_10102_1_40"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102117,"trial_step":117},{"step":118,"content":"데이먼이 창가로 다가가 커튼을 걷었다. 강렬한 햇빛이 쏟아져 당신은 한동안 눈을 제대로 뜰 수 없었다.","style":3,"background":1034,"log_type":1,"src_id":110102118,"trial_step":118},{"step":119,"speaker":"데이먼","content":"너 같은 사람도 있긴 했지. 하지만 그들은… 살아남지 못했어.","voice":["vo_trial_10102_1_41"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102119,"trial_step":119},{"step":120,"speaker":"데이먼","content":"이 디스시티가 그렇다. 선한 사람은 일찍 죽고, 나 같은 범죄자는 지금껏 살아남았지.","voice":["vo_trial_10102_1_42"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102120,"trial_step":120},{"step":121,"content":"데이먼이 창문을 열었다. 흙과 초목의 향을 품은 바람이 불어 들어와 방 안의 옅은 곰팡이 냄새를 깨끗이 쓸어갔다.","style":3,"background":1034,"log_type":1,"src_id":110102121,"trial_step":121},{"step":122,"speaker":"데이먼","content":"이건 나 혼자만의 전쟁이다.","voice":["vo_trial_10102_1_43"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102122,"trial_step":122},{"step":123,"content":"잠깐…","style":2,"background":1034,"log_type":1,"src_id":110102123,"trial_step":123},{"step":124,"speaker":"데이먼","content":"네 훌륭한 부하들이 곧 찾으러 오겠지.","voice":["vo_trial_10102_1_44"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102124,"trial_step":124},{"step":125,"content":"데이먼이 창틀에 몸을 기댔다. 그리고 아직 아물지 않은 상처 부위를 한 손으로 가린 채 창밖을 바라보았다.","style":3,"background":1034,"log_type":1,"src_id":110102125,"trial_step":125},{"step":126,"content":"다시 도망치려는 모양이었다. 하지만 그 몸 상태라면 체포는 시간문제였다.","style":3,"background":1034,"log_type":1,"src_id":110102126,"trial_step":126},{"step":127,"content":"지금 도주하면 안 돼. 시의회는 틀림없이 병력을 동원해 수색을 시작할 거다. 놈들의 손에 잡히는 날엔…","style":2,"background":1034,"log_type":1,"src_id":110102127,"trial_step":127},{"step":128,"content":"언제부터 열려 있었는지 모를 낡은 나무 문 앞에 모자를 쓴 한 사내가 서 있었다.","style":3,"background":1034,"log_type":1,"src_id":110102127,"trial_step":127},{"step":129,"speaker":"신비한 남자","content":"흠흠…","voice":["vo_trial_10102_1_45"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102128,"trial_step":128},{"step":130,"speaker":"신비한 남자","content":"죄송합니다, 본의 아니게 두 분의 대화를 방해하고 말았군요.","voice":["vo_trial_10102_1_46"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102128,"trial_step":128},{"step":131,"content":"지금 도주하면 안 돼. 시의회는 틀림없이 병력을 동원해 수색을 시작할 거다. 놈들의 손에 잡히는 날엔…","style":2,"background":1034,"log_type":1,"src_id":110102127,"trial_step":127},{"step":132,"content":"언제부터 열려 있었는지 모를 낡은 나무 문 앞에 모자를 쓴 한 사내가 서 있었다.","style":3,"background":1034,"log_type":1,"src_id":110102127,"trial_step":127},{"step":133,"speaker":"신비한 남자","content":"흠흠…","voice":["vo_trial_10102_1_45"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102128,"trial_step":128},{"step":134,"speaker":"신비한 남자","content":"죄송합니다, 본의 아니게 두 분의 대화를 방해하고 말았군요.","voice":["vo_trial_10102_1_46"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102128,"trial_step":128},{"step":135,"speaker":"데이먼","content":"넌 뭐야?!","voice":["vo_trial_10102_1_47"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102129,"trial_step":129},{"step":136,"content":"데이먼이 재빨리 경계 태세를 갖추었다. 데이먼조차 그 사내의 접근을 알아채지 못했다는 것이 놀라웠다.","style":3,"background":1034,"log_type":1,"src_id":110102130,"trial_step":130},{"step":137,"speaker":"신비한 남자","content":"제 정체는 중요하지 않습니다. 그보다는 제가 들은 소식이 중요하지요. 15일 후에 그다지 공정하지 않은 '재판'이 당신을 기다린다고 하더군요.","voice":["vo_trial_10102_1_48"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102131,"trial_step":131},{"step":138,"speaker":"신비한 남자","content":"제게 아주 끝내주는 계획이 있는데… 두 분, 들어 보시겠습니까?","voice":["vo_trial_10102_1_49"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102132,"trial_step":132},{"step":139,"content":"사내는 엷은 미소를 머금고 있었다. 두 사람이 대답을 하기도 전에 그가 모자를 벗고 날쌔게 안으로 들어왔다.","style":3,"background":10000,"log_type":1,"src_id":110102133,"trial_step":133},{"step":140,"speaker":"신비한 남자","content":"틀림없이 듣고 싶을 겁니다.","voice":["vo_trial_10102_1_50"],"voice_bank":"vo_dimeng_trial","style":1,"background":10000,"log_type":1,"src_id":110102134,"trial_step":134}]}