{"id":1030101,"chapter_id":1030101,"scene_id":1,"steps":[{"step":1,"speaker":"나이팅게일","content":"국장님, 실패했습니다.","voice":["vo_trial_30101_1_1"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101001,"trial_step":1},{"step":2,"content":"실패라니? 그럴 리가?","style":2,"background":1017,"log_type":1,"src_id":130101002,"trial_step":2},{"step":3,"content":"윽, 잠깐만. 뭘 실패했다는 거지?","style":2,"background":1017,"log_type":1,"src_id":130101003,"trial_step":3},{"step":4,"speaker":"나이팅게일","content":"너무 긴장하실 필요 없습니다, 국장님. 심각한 일은 아니니까요.","voice":["vo_trial_30101_1_4"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101004,"trial_step":4},{"step":5,"speaker":"나이팅게일","content":"백기실업을 목표로 한 조사가 거의 무산됐습니다.","voice":["vo_trial_30101_1_5"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101005,"trial_step":5},{"step":6,"content":"조사원이 습격이라도 당한 건가?","style":2,"background":1017,"log_type":1,"src_id":130101006,"trial_step":6},{"step":7,"speaker":"나이팅게일","content":"아니요, 조사원은 잘 있습니다. 다만 백기실업 관련 정보를 조사하는데 진도가 나가질 않고 있습니다.","voice":["vo_trial_30101_1_7"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101007,"trial_step":7},{"step":8,"content":"그럼 됐어. 나도 지금 당장 결과가 나오길 기대한 건 아니니까.","style":2,"background":1017,"log_type":1,"src_id":130101008,"trial_step":8},{"step":9,"speaker":"나이팅게일","content":"계속 조사하라고 전달하겠습니다.","voice":["vo_trial_30101_1_9"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101009,"trial_step":9},{"step":10,"content":"그래. 하지만 그렇다고 해서 지금까지 나온 결과를 그냥 두고 보고 있을 수는 없지.","style":2,"background":1017,"log_type":1,"src_id":130101010,"trial_step":10},{"step":11,"content":"심문을 준비해줘. 이번 기회에 백 사장이랑 얘기도 좀 해봐야겠어.","style":2,"background":1017,"log_type":1,"src_id":130101011,"trial_step":11},{"step":12,"speaker":"백","content":"오, 왔네.","voice":["vo_trial_30101_1_12"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101013,"trial_step":13,"drawing":1030101},{"step":13,"content":"백은 마치 자기 집 안방처럼 편한 자세로 앉아 있었다.","style":3,"log_type":1,"src_id":130101014,"trial_step":14,"drawing":1030101},{"step":14,"speaker":"백","content":"이렇게 단둘이 보자고 하다니, 은밀하게 할 얘기라도 있나?","voice":["vo_trial_30101_1_14"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101015,"trial_step":15,"drawing":1030101},{"step":15,"content":"……","style":2,"log_type":1,"src_id":130101016,"trial_step":16,"drawing":1030101},{"step":16,"speaker":"백","content":"에이, 부끄러워하지 말고. 하고 싶은 말 있으면 해 봐. 안 놀릴게.","voice":["vo_trial_30101_1_16"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101017,"trial_step":17,"drawing":1030101},{"step":17,"speaker":"백","content":"물론 시간당으로 계산해, 규칙대로 말이야. 아무 말 안 하는 시간도 계산해야 한다?","voice":["vo_trial_30101_1_17"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101018,"trial_step":18,"drawing":1030101},{"step":18,"options":["넌 그런 말 할 자격 없어","말장난하지 말고"],"style":6,"log_type":1,"src_id":130101019,"trial_step":19,"course":3,"drawing":1030101,"choices":[{"text":"넌 그런 말 할 자격 없어","goto":20},{"text":"말장난하지 말고","goto":21}]},{"step":19,"content":"수감자는 심문에 협조할 의무가 있어.","style":2,"log_type":1,"src_id":130101020,"trial_step":20,"drawing":1030101,"next":[22]},{"step":20,"content":"…지금은 심문 중이니까 진지하게 임하도록 해.","style":2,"log_type":1,"src_id":130101021,"trial_step":21,"drawing":1030101},{"step":21,"speaker":"백","content":"그냥 농담한 거 가지고… 정말 내가 이런 걸로 돈을 달라고 하겠어?","voice":["vo_trial_30101_1_21"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101022,"trial_step":22,"drawing":1030105},{"step":22,"speaker":"백","content":"묻고 싶은 게 있다면 물어봐. 듣고 있으니까.","voice":["vo_trial_30101_1_22"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101023,"trial_step":23,"drawing":1030105},{"step":23,"content":"……","style":2,"log_type":1,"src_id":130101024,"trial_step":24,"drawing":1030105},{"step":24,"content":"'백기실업'에 관해 좀 알고 싶어서 이렇게 보자고 했어.","style":2,"log_type":1,"src_id":130101025,"trial_step":25,"drawing":1030105},{"step":25,"speaker":"백","content":"백기에 관해 알고 싶다고? 진작 얘기하지 그랬어. 우리 백기 관련해서 가장 쓸모 있는 정보라면… 음…","voice":["vo_trial_30101_1_25"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101026,"trial_step":26,"drawing":1030101},{"step":26,"speaker":"백","content":"얼마 전에 신디케이트 7일 관광 프로모션을 준비했는데, 관심 있어?","voice":["vo_trial_30101_1_26"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101027,"trial_step":27,"drawing":1030101},{"step":27,"speaker":"백","content":"지금 구매하면 20%나 할인받을 수 있다?","voice":["vo_trial_30101_1_27"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101028,"trial_step":28,"drawing":1030101},{"step":28,"content":"그쪽 사업이야 당연히 궁금하긴 하지.","style":2,"log_type":1,"src_id":130101029,"trial_step":29,"drawing":1030101},{"step":29,"content":"그런데 난 '백기실업'이라는 이름 뒤에 숨겨진 비밀이 더 궁금해.","style":2,"log_type":1,"src_id":130101030,"trial_step":30,"drawing":1030101},{"step":30,"speaker":"백","content":"오호.","voice":["vo_trial_30101_1_30"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101031,"trial_step":31,"drawing":1030105},{"step":31,"content":"백은 눈을 가느다랗게 뜨고는 몸을 앞으로 살짝 기울였다.","style":3,"log_type":1,"src_id":130101032,"trial_step":32,"drawing":1030105},{"step":32,"speaker":"백","content":"궁금한 게 이거였구나? 그런데 다른 사람의 비밀을 알고 싶다면 말이야…","voice":["vo_trial_30101_1_32"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101033,"trial_step":33,"drawing":1030105},{"step":33,"speaker":"백","content":"돈을 달라는 뜻은 아니지만, 그래도 어느 정도 성의 표시는 해야 하는 거 아닌가?","voice":["vo_trial_30101_1_33"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101034,"trial_step":34,"drawing":1030105},{"step":34,"options":["뭘 원하지?"],"style":6,"log_type":1,"src_id":130101035,"trial_step":35,"course":3,"drawing":1030105,"choices":[{"text":"뭘 원하지?","goto":36}]},{"step":35,"content":"백이 앞으로 더 다가왔다.","style":3,"log_type":1,"src_id":130101036,"trial_step":36,"drawing":1030104},{"step":36,"speaker":"백","content":"서구 쇼핑몰은 지금 기간 한정 특가 세일 중! 공동 구매로 초특가 할인 혜택을 누리세요.","voice":["vo_trial_30101_1_36"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101037,"trial_step":37,"drawing":1030104},{"step":37,"speaker":"백","content":"최신형 개인 단말기, 무기, 데드 러버 라디오 팬 미팅 티켓 등등, 각종 핫한 상품이 준비되어 있답니다.","voice":["vo_trial_30101_1_37"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101038,"trial_step":38,"drawing":1030104},{"step":38,"speaker":"백","content":"아직도 고민하시나요? QR코드를 스캔해 다운로드하세요!","voice":["vo_trial_30101_1_38"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101039,"trial_step":39,"drawing":1030104},{"step":39,"content":"……","style":2,"log_type":1,"src_id":130101040,"trial_step":40,"drawing":1030104},{"step":40,"speaker":"백","content":"QR코드를 스캔해 다운로드하세요!","voice":["vo_trial_30101_1_40"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101041,"trial_step":41,"drawing":1030104},{"step":41,"content":"백이 또다시 가슴팍을 가리켰다.","style":3,"log_type":1,"src_id":130101042,"trial_step":42,"drawing":1030104},{"step":42,"content":"……","style":2,"log_type":1,"src_id":130101043,"trial_step":43,"drawing":1030104},{"step":43,"content":"당신은 개인 단말기를 꺼내 정체를 알 수 없는 QR코드를 스캔했다.","style":3,"log_type":1,"src_id":130101044,"trial_step":44,"drawing":1030104},{"step":44,"speaker":"백","content":"하하, 진작에 그랬어야지.","voice":["vo_trial_30101_1_44"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101045,"trial_step":45,"drawing":1030104},{"step":45,"content":"MBCC의 초고속 인터넷 덕에 미처 손쓸 새도 없이 다운로드가 완료됐다.","style":3,"log_type":1,"src_id":130101046,"trial_step":46,"drawing":1030101},{"step":46,"content":"알록달록한 광고 팝업창이 저열한 음질의 촌스러운 음악과 함께 단말기 화면을 가득 채웠고, 어떻게 해도 닫히지 않았다.","style":3,"log_type":1,"src_id":130101047,"trial_step":47,"drawing":1030101},{"step":47,"options":["개인 단말기를 끈다"],"style":6,"log_type":1,"src_id":130101048,"trial_step":48,"course":3,"drawing":1030101,"choices":[{"text":"개인 단말기를 끈다","goto":49}]},{"step":48,"content":"당신은 개인 단말기를 끄고 주머니에 다시 집어넣었다.","style":3,"log_type":1,"src_id":130101049,"trial_step":49,"drawing":1030101},{"step":49,"content":"원하는 대로 다운받았어. 이제 너도 나한테 협조해야겠지?","style":2,"log_type":1,"src_id":130101050,"trial_step":50,"drawing":1030101},{"step":50,"speaker":"백","content":"알겠어.","voice":["vo_trial_30101_1_50"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101051,"trial_step":51,"drawing":1030101},{"step":51,"content":"백이 기지개를 켰다.","style":3,"log_type":1,"src_id":130101052,"trial_step":52,"drawing":1030101},{"step":52,"content":"우선 너희 상황을 간단하게 얘기해 봐.","style":2,"log_type":1,"src_id":130101053,"trial_step":53,"drawing":1030101},{"step":53,"speaker":"백","content":"복수부터 강아지 산책까지, 백기실업이 당신의 근심을 덜어드립니다.","voice":["vo_trial_30101_1_53"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101054,"trial_step":54,"drawing":1030104},{"step":54,"speaker":"백","content":"우리 백기는 유구한 역사를 자랑하며 성실하게 경영해왔습니다. 광범위한 업무 영역과 높은 성공률로 5년 연속 신디케이트 최고의 사업장으로 선정되었지요.","voice":["vo_trial_30101_1_54"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101055,"trial_step":55,"drawing":1030104},{"step":55,"content":"백기는 105년에 설립된 걸로 알고 있는데. 아닌가?","style":2,"log_type":1,"src_id":130101056,"trial_step":56,"drawing":1030104},{"step":56,"speaker":"백","content":"에이, 국장이 뭘 모르네. 원래 신디케이트 같은 데서는 2년 된 회사도 역사가 유구하다고 할 수 있다고.","voice":["vo_trial_30101_1_56"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101057,"trial_step":57,"drawing":1030104},{"step":57,"speaker":"백","content":"크흠. 음, 초창기 멤버는 두 명뿐이었지만, 후에 세 명으로 충원되면서 회사가 자리 잡기 시작했습니다. 인원이 증원되진 않았지만, 그래도 사업 규모는 끊임없이 커졌습니다.","voice":["vo_trial_30101_1_57"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101058,"trial_step":58,"drawing":1030104},{"step":58,"speaker":"백","content":"신디케이트에서 수년을 걸쳐 노력한 결과, 신디케이트에서 내로라하는 갱단 군단과도 장기적으로 협업할 수 있었고…","voice":["vo_trial_30101_1_58"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101059,"trial_step":59,"drawing":1030104},{"step":59,"speaker":"백","content":"음, 그다음은 기억이 잘 안 나네. 어쨌든 백기는 엄청나게 대단하고, 신디케이트에서 무시하는 사람이 없다는 것만 알아 둬. 군단도 함부로 못 건드리고, 군말 없이 의뢰를 맡길 정도지.","voice":["vo_trial_30101_1_59"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101060,"trial_step":60,"drawing":1030104},{"step":60,"speaker":"백","content":"이 정도면 알겠지?","voice":["vo_trial_30101_1_60"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101061,"trial_step":61,"drawing":1030104},{"step":61,"content":"아니. 둘 다 백기 사람인데, 어째서 K.K.는 너랑 완전히 다르게 얘기한 거지?","style":2,"log_type":1,"src_id":130101062,"trial_step":62,"drawing":1030104},{"step":62,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":63,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":64,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":65,"options":["선택1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":66,"content":"테스트","style":18,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":67,"options":["선택1","선택2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":68,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":69,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":63,"course":6,"drawing":1030104},{"step":70,"content":"이건 K.K.의 증언이야. 읽어줘?","style":2,"log_type":1,"src_id":130101064,"trial_step":64,"drawing":1030104},{"step":71,"content":"…그러니까, 백의 경영이 아주 엉망이었다는 거지?","style":2,"background":1017,"log_type":1,"src_id":130101065,"trial_step":65},{"step":72,"speaker":"K.K.","content":"엉망? 엉망 정도가 아니야, 아주 끔찍했지!","voice":["vo_trial_30101_1_64"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101066,"trial_step":66},{"step":73,"speaker":"K.K.","content":"임대료는 반년이나 밀렸고, 수도세랑 전기세는 내본 적도 없어. 거의 굶어 죽을 판이었다고!","voice":["vo_trial_30101_1_65"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101067,"trial_step":67},{"step":74,"speaker":"K.K.","content":"치이는 온종일 포커만 치느라 며칠 동안 코빼기도 안 보일 때가 있어. 어쩌다가 마주치면, 얼토당토않은 소리나 해대고. 일은 죽어도 안 하려고 해.","voice":["vo_trial_30101_1_66"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101068,"trial_step":68},{"step":75,"speaker":"K.K.","content":"그러니 내가 뭘 어쩌겠어? 혼자 하는 수밖에 없었지.","voice":["vo_trial_30101_1_67"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101069,"trial_step":69},{"step":76,"speaker":"K.K.","content":"근데 내가 허구한 날 배달하고 하수구 뚫어서 돈을 벌어오면, 백이 의뢰를 망쳐서 수습하는 데 그 돈을 다 썼지 뭐야.","voice":["vo_trial_30101_1_68"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101070,"trial_step":70},{"step":77,"speaker":"K.K.","content":"백은 자기가 왜 '신디케이트의 삼대 악'이라고 불리는지 전혀 모르는 거야? 아침부터 저녁까지 빚을 불리느라 바빠. 제발 좀 가만히 있었으면 좋겠어.","voice":["vo_trial_30101_1_69"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101071,"trial_step":71},{"step":78,"speaker":"K.K.","content":"가끔은 정말로 절망스러워. 더는 못 살겠다 싶을 정도로…","voice":["vo_trial_30101_1_70"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101072,"trial_step":72},{"step":79,"content":"그렇게 힘든데 왜 다른 길을 알아보지 않았지?","style":2,"background":1017,"log_type":1,"src_id":130101073,"trial_step":73},{"step":80,"speaker":"K.K.","content":"…한 놈은 일머리라고는 눈곱만큼도 없고, 한 놈은 하늘이 무너져도 일하려 하질 않거든… 밥해 먹을 줄도 몰라. 내가 없으면 컵라면밖에 못 먹지.","voice":["vo_trial_30101_1_72"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101074,"trial_step":74},{"step":81,"speaker":"K.K.","content":"일일이 다 떠먹여 줘야 처먹거든. 내가 없으면 둘이 어떻게 하고 살겠어?","voice":["vo_trial_30101_1_73"],"voice_bank":"vo_linglan_trial","style":1,"background":1017,"log_type":1,"src_id":130101075,"trial_step":75},{"step":82,"speaker":"백","content":"K.K. 이 자식, 국장 앞에서 날 모욕하다니…","voice":["vo_trial_30101_1_74"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101076,"trial_step":76,"drawing":1030106},{"step":83,"content":"그 유명한 백 사장이 신디케이트의 삼대 악 중 '채무자'라니. 역시 명불허전이군.","style":2,"log_type":1,"src_id":130101077,"trial_step":77,"drawing":1030106},{"step":84,"speaker":"백","content":"아냐, 나한테 악감정 있는 녀석이 날 질투하는 거라고. 난… 후…","voice":["vo_trial_30101_1_76"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101078,"trial_step":78,"drawing":1030106},{"step":85,"content":"백이 또다시 한숨을 내쉬었다.","style":3,"log_type":1,"src_id":130101079,"trial_step":79,"drawing":1030102},{"step":86,"speaker":"백","content":"오케이, 알겠어. K.K. 말이 맞아. 백기의 경영에 문제가 좀 생겼어. 이제 됐지?","voice":["vo_trial_30101_1_78"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101080,"trial_step":80,"drawing":1030102},{"step":87,"speaker":"백","content":"그래서? 내가 인정한다고 너한테 좋을 게 뭐가 있지?","voice":["vo_trial_30101_1_79"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101081,"trial_step":81,"drawing":1030102},{"step":88,"content":"난 네가 조금 더 진지하게 임해주길 바랄 뿐이야.","style":2,"log_type":1,"src_id":130101082,"trial_step":82,"drawing":1030102},{"step":89,"speaker":"백","content":"뭐? 고작 그것 때문이라고? 너희들도 참… 심지가 아주 뒤틀렸네…","voice":["vo_trial_30101_1_81"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101083,"trial_step":83,"drawing":1030103},{"step":90,"content":"이제 아주 중요한 질문이야. 부디 제대로 대답해주길 바래.","style":2,"log_type":1,"src_id":130101084,"trial_step":84,"drawing":1030102},{"step":91,"options":["조야는 지금 어디 있지?"],"style":6,"log_type":1,"src_id":130101085,"trial_step":85,"course":3,"drawing":1030102,"choices":[{"text":"조야는 지금 어디 있지?","goto":86}]},{"step":92,"speaker":"백","content":"그걸 내가 어떻게 알아?","voice":["vo_trial_30101_1_84"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101086,"trial_step":86,"drawing":1030103},{"step":93,"content":"백 사장이 눈을 뒤집혔다.","style":3,"log_type":1,"src_id":130101087,"trial_step":87,"drawing":1030103},{"step":94,"content":"네가 그랬잖아, 백기는 '신디케이트에서 내로라하는 갱단, 군단과 장기적으로 협업을 할 수 있었다'고.","style":2,"log_type":1,"src_id":130101088,"trial_step":88,"drawing":1030102},{"step":95,"speaker":"백","content":"왜, 허풍 좀 떨면 안 돼? 그리고 좀 전에 벌써 나에 대해 까발렸잖아?","voice":["vo_trial_30101_1_87"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101089,"trial_step":89,"drawing":1030102},{"step":96,"content":"BR-004가 폭발한 날, 치이가 블랙링에 들어갔어. 일반인은 블랙링 안에 있는 것 자체가 불가능한데, 치이는 아무런 영향도 받지 않았지.","style":2,"log_type":1,"src_id":130101090,"trial_step":90,"drawing":1030102},{"step":97,"content":"백기 쪽에서 쉬쉬하고 있는 비밀 같은 게 있는 거 아니야?","style":2,"log_type":1,"src_id":130101091,"trial_step":91,"drawing":1030102},{"step":98,"speaker":"백","content":"아니.","voice":["vo_trial_30101_1_90"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101092,"trial_step":92,"drawing":1030102},{"step":99,"content":"백의 대답은 간단명료했다.","style":3,"log_type":1,"src_id":130101093,"trial_step":93,"drawing":1030102},{"step":100,"content":"조각상 꼭대기에서 조야와 대치하던 사람, 너 아니야?","style":2,"log_type":1,"src_id":130101094,"trial_step":94,"drawing":1030102},{"step":101,"speaker":"백","content":"아니야.","voice":["vo_trial_30101_1_93"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101095,"trial_step":95,"drawing":1030102},{"step":102,"content":"백이 다시 한번 부인했다.","style":3,"log_type":1,"src_id":130101096,"trial_step":96,"drawing":1030103},{"step":103,"speaker":"백","content":"미치지 않은 이상 누가 죽음도 마다하지 않고 블랙링에 뛰어들겠어?","voice":["vo_trial_30101_1_95"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101097,"trial_step":97,"drawing":1030103},{"step":104,"content":"하지만 그날 치이는 조야를 견제하는 걸 도와준 게 자기 친구라고 했어.","style":2,"log_type":1,"src_id":130101098,"trial_step":98,"drawing":1030103},{"step":105,"speaker":"백","content":"그 녀석이 불량배랑 놀아났을지 누가 알아? 어쨌든 난 모르는 일이야.","voice":["vo_trial_30101_1_97"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101099,"trial_step":99,"drawing":1030103},{"step":106,"content":"너는 그 며칠 동안 뭐 하고 있었지?","style":2,"log_type":1,"src_id":130101100,"trial_step":100,"drawing":1030103},{"step":107,"speaker":"백","content":"일했지 뭐 했겠어?","voice":["vo_trial_30101_1_99"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101101,"trial_step":101,"drawing":1030103},{"step":108,"content":"증명할 수 있는 사람 있어?","style":2,"log_type":1,"src_id":130101102,"trial_step":102,"drawing":1030103},{"step":109,"speaker":"백","content":"증명? 어떻게 증명하라는 거야? K.K.는 당신네들 관리국에서 호사를 누리고 있었고 치이는 블랙링에 있었는데, 누가 증명할 수 있겠어…","voice":["vo_trial_30101_1_101"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101103,"trial_step":103,"drawing":1030103},{"step":110,"speaker":"백","content":"나는 말이야, 사장 자리에 앉아 있으면서도 회사 식구들 먹여 살리겠다고 온종일 사방으로 뛰어다녔다고…","voice":["vo_trial_30101_1_102"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101104,"trial_step":104,"drawing":1030103},{"step":111,"content":"백은 눈물 한 방울 없이 건조한 눈가를 닦는 척하며 당신을 흘겨봤다.","style":3,"log_type":1,"src_id":130101105,"trial_step":105,"drawing":1030103},{"step":112,"speaker":"백","content":"직원들은 하나같이 이쪽에서 얻어먹고 저쪽이랑 내통하면서 사장은 안중에도 없고. 결국은 이렇게 누명을 씌우다니, 흑흑흑…","voice":["vo_trial_30101_1_104"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101106,"trial_step":106,"drawing":1030103},{"step":113,"content":"백은 분명히 사실을 말한게 아니다. 하지만 애석하게도 당신에게는 막무가내로 억지 부리는 그녀의 말에 반박할 정보가 없었다.","style":3,"log_type":1,"src_id":130101107,"trial_step":107,"drawing":1030103},{"step":114,"content":"그래도 밑져야 본전이니, 지금 확보된 정보를 이용해 당신의 추측을 확인해보기로 했다.","style":3,"log_type":1,"src_id":130101108,"trial_step":108,"drawing":1030103},{"step":115,"content":"그렇다면 일단 네 말을 믿어보지.","style":2,"log_type":1,"src_id":130101109,"trial_step":109,"drawing":1030103},{"step":116,"content":"그런데 묻고 싶은 게 하나 더 있어.","style":2,"log_type":1,"src_id":130101110,"trial_step":110,"drawing":1030103},{"step":117,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":118,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":119,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":120,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":121,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":122,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":123,"content":"테스트","style":18,"log_type":1,"src_id":2,"trial_step":111,"course":6,"drawing":1030103},{"step":124,"content":"6월부터 ██ 거리에 어떤 세력이 자주 출몰했어. 갱단을 포섭했을 뿐만 아니라 변이 무기를 운반한 것으로 의심되기도 하지.","style":2,"log_type":1,"src_id":130101112,"trial_step":112,"drawing":1030103},{"step":125,"content":"MBCC가 이 조직의 중간급 두목을 하나 체포했는데, 본인이 백기실업 일을 하고 있다고 하더군…","style":2,"log_type":1,"src_id":130101113,"trial_step":113,"drawing":1030103},{"step":126,"content":"설명해봐, 백 사장.","style":2,"log_type":1,"src_id":130101114,"trial_step":114,"drawing":1030103},{"step":127,"speaker":"백","content":"이건 모함이야! 새빨간 거짓말이라고!","voice":["vo_trial_30101_1_113"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101115,"trial_step":115,"drawing":1030106},{"step":128,"speaker":"백","content":"사리 구분 못하는 어디 갱단의 잔당이 틀림없어. 간이 부었네, 감히 이 몸에 죄를 뒤집어씌울 생각을 하다니.","voice":["vo_trial_30101_1_114"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101116,"trial_step":116,"drawing":1030106},{"step":129,"content":"너희 쪽이 돈 문제 때문에 변이 무기 사업에 눈독을 들인 게 아니라는 거지?","style":2,"log_type":1,"src_id":130101117,"trial_step":117,"drawing":1030106},{"step":130,"speaker":"백","content":"그게 말이 돼?! 아무리 궁해도 그 정도는 아니라고.","voice":["vo_trial_30101_1_116"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101118,"trial_step":118,"drawing":1030106},{"step":131,"content":"백은 정보가 담긴 파일을 뺏어 들더니, 파일에 있는 남자를 가리키며 욕을 퍼부어댔다.","style":3,"log_type":1,"src_id":130101119,"trial_step":119,"drawing":1030106},{"step":132,"speaker":"백","content":"얜 누구야? 알지도 못하는 사람을 내가 직원으로 두고 쓴다는 게 말이 돼?","voice":["vo_trial_30101_1_118"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101120,"trial_step":120,"drawing":1030106},{"step":133,"speaker":"백","content":"그리고 백기에는 나랑 치이, K.K. 뿐이라고. 대체 어디서 굴러들어온 건지…","voice":["vo_trial_30101_1_119"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101121,"trial_step":121,"drawing":1030106},{"step":134,"speaker":"백","content":"잠깐, 치이가 이놈들이랑 한패가 된 건 아니겠지?","voice":["vo_trial_30101_1_120"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101122,"trial_step":122,"drawing":1030106},{"step":135,"content":"백의 표정에 분노가 그대로 드러났다.","style":3,"log_type":1,"src_id":130101123,"trial_step":123,"drawing":1030106},{"step":136,"speaker":"백","content":"오호라, 그런 거였어? 일을 안 할 거면 가만히나 있지, 이쪽에서 얻어먹고 저쪽이랑 내통하면서 백기의 명성에 먹칠해?","voice":["vo_trial_30101_1_122"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101124,"trial_step":124,"drawing":1030106},{"step":137,"content":"일단 진정해. 그건 네 추측일 뿐이잖아.","style":2,"log_type":1,"src_id":130101125,"trial_step":125,"drawing":1030106},{"step":138,"speaker":"백","content":"알 게 뭐야, 백기를 사칭하는 사람은 반드시 그 대가를 치르게 될 거야!","voice":["vo_trial_30101_1_124"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101126,"trial_step":126,"drawing":1030106},{"step":139,"content":"백은 그렇게 말하며 당신을 힐끔 쳐다봤다.","style":3,"log_type":1,"src_id":130101127,"trial_step":127,"drawing":1030106},{"step":140,"speaker":"백","content":"국장이 날 좀 도와줘야겠어.","voice":["vo_trial_30101_1_126"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101128,"trial_step":128,"drawing":1030103},{"step":141,"content":"내가 왜 너네 백기의 일에 끼어들어야 하지?","style":2,"log_type":1,"src_id":130101129,"trial_step":129,"drawing":1030103},{"step":142,"speaker":"백","content":"넌 신디케이트 지역의 변이 무기 거래를 근절하고, 난 네 손을 빌려 날 사칭하려 드는 사람을 제거하는 거야. 이런 걸 서로 윈윈한다고 하지!","voice":["vo_trial_30101_1_128"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101130,"trial_step":130,"drawing":1030103},{"step":143,"speaker":"백","content":"설마 MBCC가 변이 무기 사업에 관여하고 싶지 않단 말이냐?","voice":["vo_trial_30101_1_129"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101131,"trial_step":131,"drawing":1030103},{"step":144,"options":["관리국이 두 손 놓고 보고만 있을 순 없지"],"style":6,"log_type":1,"src_id":130101132,"trial_step":132,"course":3,"drawing":1030103,"choices":[{"text":"관리국이 두 손 놓고 보고만 있을 순 없지","goto":133}]},{"step":145,"content":"백의 말이 맞았다. 그 백기실업 직원이 진짜든 가짜든 상관없이, 변이 무기와 관련이 있다면 보고만 있을 수는 없었다.","style":3,"log_type":1,"src_id":130101133,"trial_step":133,"drawing":1030103},{"step":146,"speaker":"백","content":"그럼 됐어. 이번 일은 내가 도울 테니까 걱정하지 마. 절대 실수 안 해. 감히 날 사칭하다니, 간이 부었네.","voice":["vo_trial_30101_1_132"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101134,"trial_step":134,"drawing":1030104},{"step":147,"content":"……","style":2,"log_type":1,"src_id":130101135,"trial_step":135,"drawing":1030104},{"step":148,"content":"우선은 백에게 더 캐물을 것이 없었다.","style":3,"log_type":1,"src_id":130101136,"trial_step":136,"drawing":1030104},{"step":149,"content":"변이 위협을 제거하는 일이 MBCC에 가장 큰 압박을 주고 있었기에, 당신은 처음부터 변이 무기를 거래한 일당을 해치우려 했다. 그런데 지금 백이 이렇게 나서서 자청하다니, 당신도 덩달아 내부 사정을 파헤칠 기회를 얻은 셈이었다.","style":3,"log_type":1,"src_id":130101137,"trial_step":137,"drawing":1030104},{"step":150,"content":"그럼 이번 작전은 너만 믿겠어.","style":2,"log_type":1,"src_id":130101138,"trial_step":138,"drawing":1030104},{"step":151,"speaker":"백","content":"나한테 맡기라고.","voice":["vo_trial_30101_1_137"],"voice_bank":"vo_linglan_trial","style":1,"log_type":1,"src_id":130101139,"trial_step":139,"drawing":1030104},{"step":152,"content":"백이 가슴팍을 두드리며 장담했다.","style":3,"log_type":1,"src_id":130101140,"trial_step":140,"drawing":1030104},{"step":153,"content":"……","style":2,"log_type":1,"src_id":130101141,"trial_step":141,"drawing":1030104},{"step":154,"content":"심문실을 나서니, 나이팅게일이 문밖에서 기다리고 있었다.","style":3,"background":107,"log_type":1,"src_id":130101142,"trial_step":142},{"step":155,"speaker":"나이팅게일","content":"심문은 어떠셨습니까? 순조롭게 진행됐나요?","voice":["vo_trial_30101_1_141"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130101143,"trial_step":143},{"step":156,"content":"순조로웠다고는 할 수 없어. 백이 쉽게 정보를 흘리지 않아. 이런 상황에 대응하는 방법을 잘 알고 있는 것 같아.","style":2,"background":107,"log_type":1,"src_id":130101144,"trial_step":144},{"step":157,"content":"아직 결정적인 증거가 없으니, 짧은 시간 내에 백의 실태를 밝히는 건 어려울 거야.","style":2,"background":107,"log_type":1,"src_id":130101145,"trial_step":145},{"step":158,"speaker":"나이팅게일","content":"그럼 어떻게…","voice":["vo_trial_30101_1_144"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130101146,"trial_step":146},{"step":159,"content":"어찌 됐건 변이 무기를 그대로 두고만 보고 있을 수는 없어.","style":2,"background":107,"log_type":1,"src_id":130101147,"trial_step":147},{"step":160,"content":"당신은 개인 단말기를 꺼냈다.","style":3,"background":107,"log_type":1,"src_id":130101148,"trial_step":148},{"step":161,"content":"우선 작전 부서에 연락할게. 이 골칫거리를 빨리 해결해야 해, 어쩌면 아직…","style":2,"background":107,"log_type":1,"src_id":130101149,"trial_step":149},{"step":162,"speaker":"광고","content":"칼을 맞춤 제작해드립니다. 기간 한정 사전 예약 모집 중입니다.","style":1,"background":107,"log_type":1,"src_id":130101150,"trial_step":150},{"step":163,"speaker":"광고","content":"질산글리세린 대량 구매 시 혜택을 누릴 수 있습니다!","style":1,"background":107,"log_type":1,"src_id":130101151,"trial_step":151},{"step":164,"speaker":"광고","content":"신성 통조림 식품입니다! 한정 수량으로 선착순 판매합니다.","style":1,"background":107,"log_type":1,"src_id":130101152,"trial_step":152},{"step":165,"content":"개인 단말기를 켜자마자 열 개도 넘는 광고창이 쏟아져 나와 당신을 놀라게 했다.","style":3,"background":107,"log_type":1,"src_id":130101153,"trial_step":153},{"step":166,"content":"……","style":2,"background":107,"log_type":1,"src_id":130101154,"trial_step":154},{"step":167,"content":"아니다, 그냥 네가 대신 연락 좀 해 줘. 난 우선 파견 일을 처리하러 갈 테니, 책임자더러 15분 뒤에 내 사무실에 와서 보고하라고 전해줘.","style":2,"background":107,"log_type":1,"src_id":130101155,"trial_step":155},{"step":168,"speaker":"나이팅게일","content":"알겠습니다.","voice":["vo_trial_30101_1_154"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130101156,"trial_step":156},{"step":169,"content":"당신은 단말기를 다시 주머니에 넣고는 빠른 걸음으로 심문 구역을 떠났다.","style":3,"background":107,"log_type":1,"src_id":130101157,"trial_step":157}]}