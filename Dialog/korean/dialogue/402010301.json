{"id":402010301,"chapter_id":50055,"scene_id":55104,"steps":[{"step":1,"speaker":"${PlayerName}","content":"앞으로 날 어쩔 생각이야?","style":2,"background":2195,"log_type":1},{"step":2,"speaker":"엔젤","content":"전처럼 계속 여기 있으면 돼.","voice":["vo_event_402010302_19"],"voice_bank":"vo_event_20103","style":1,"background":2195,"log_type":1},{"step":3,"speaker":"${PlayerName}","content":"의뢰인이 다시 네게 연락할 때까지? 그게 언제인데? 그전까지는 계속 이 상태를 유지해야 하는 거야?","style":2,"background":2195,"log_type":1},{"step":4,"speaker":"엔젤","content":"맞아.","voice":["vo_event_402010302_21"],"voice_bank":"vo_event_20103","style":1,"background":2195,"log_type":1},{"step":5,"speaker":"엔젤","content":"또 궁금한 거 있어?","voice":["vo_event_402010302_22"],"voice_bank":"vo_event_20103","style":1,"background":2195,"log_type":1},{"step":6,"speaker":"${PlayerName}","content":"없어.","style":2,"background":2195,"log_type":1},{"step":7,"content":"당신은 주방으로 돌아왔다.","style":3,"background":2196,"log_type":1},{"step":8,"content":"당연히 궁금한 게 있었다. 다른 사람이 당신에게 물어봤었고, 당신도 그녀에게 물어봤었다.","style":3,"background":2196,"log_type":1},{"step":9,"content":"유저_W21: 물고기는 왜 국장님의 계획을 따라주는 걸까요? 뭔가 계기라도 있는 건가요?","style":3,"background":2196,"log_type":1},{"step":10,"content":"확실히 당신은 그녀의 신뢰를 얻어 집안일을 돕고 의뢰 계획을 짰다. 다만 아직 그녀가 왜 당신을 신뢰하는지는 알 수가 없었다.","style":3,"background":2196,"log_type":1},{"step":11,"content":"아무리 생각해도 전환점이랄 건 그때뿐이었다.","style":3,"background":2196,"log_type":1},{"step":12,"content":"그날은 납치된 후 3일째가 되는 날의 이른 아침이었다. 배가 고파 혼절할 것 같던 당신은 참다못해 이리저리 더듬어 주방으로 갔고, 식칼을 들어 올린 순간 집주인에게 발각되었다.","style":3,"background":2196,"log_type":1},{"step":13,"speaker":"엔젤","content":"……","style":1,"background":2196,"log_type":1},{"step":14,"speaker":"${PlayerName}","content":"…뭘 좀 먹고 싶어서. 이건 겸사겸사…","style":2,"background":2196,"log_type":1},{"step":15,"content":"그녀는 대답 없이 당신을 쳐다봤다.","style":3,"background":2196,"log_type":1},{"step":16,"speaker":"${PlayerName}","content":"…이틀 동안 아무것도 못 먹어서 정말 배고파.","style":2,"background":2196,"log_type":1},{"step":17,"content":"정적이 감돌았다. 살면서 이렇게 시간이 느리게 흘러가는 건 처음이었다. 오랜 침묵 후 마침내 엔젤이 입을 열었다.","style":3,"background":2196,"log_type":1},{"step":18,"speaker":"엔젤","content":"나도 배고파.","voice":["vo_event_402010101_1"],"voice_bank":"vo_event_20101","style":1,"background":2196,"log_type":1},{"step":19,"speaker":"엔젤","content":"요리할 줄 알아?","voice":["vo_event_402010101_2"],"voice_bank":"vo_event_20101","style":1,"background":2196,"log_type":1},{"step":20,"content":"관리국에서 라면을 끓여보기는 했지만, 직감적으로 이렇게 대답해선 안 된다는 것을 느꼈다.","style":3,"background":2196,"log_type":1},{"step":21,"speaker":"${PlayerName}","content":"알아. 먹고 싶은 거 있어?","style":2,"background":2196,"log_type":1},{"step":22,"speaker":"엔젤","content":"단팥죽.","voice":["vo_event_402010101_5"],"voice_bank":"vo_event_20101","style":1,"background":2196,"log_type":1},{"step":23,"speaker":"엔젤","content":"난 따뜻한 단팥죽이 좋아.","voice":["vo_event_402010101_6"],"voice_bank":"vo_event_20101","style":1,"background":2196,"log_type":1},{"step":24,"speaker":"엔젤","content":"그럼 부탁할게.","voice":["vo_event_402010101_7"],"voice_bank":"vo_event_20101","style":1,"background":2196,"log_type":1},{"step":25,"content":"정확히 그때부터 상황이 바뀌기 시작했다. 요리에서 청소로, 당신은 서서히 그녀의 생활에 스며들어 조금씩 그녀와 가까워지며, 빠르게 의뢰 계획까지 맡을 수 있었지만 여전히 위태로웠다.","style":3,"background":2196,"log_type":1},{"step":26,"speaker":"${PlayerName}","content":"정말 내가 협력하길 바라는 거야? 난 당신이 납치해 온 사람인데?","style":2,"background":2195,"log_type":1},{"step":27,"content":"엔젤은 고개조차 들지 않고 대답했다.","style":3,"background":2195,"log_type":1},{"step":28,"speaker":"엔젤","content":"나쁠 건 없지. 그냥 의뢰를 받아서 생활하는 것뿐인데.","voice":["vo_event_402010302_23"],"voice_bank":"vo_event_20103","style":1,"background":2195,"log_type":1},{"step":29,"speaker":"엔젤","content":"그리고 당신이 하는 어떤 행동도 내게 위협이 되지 못해.","voice":["vo_event_402010302_24"],"voice_bank":"vo_event_20103","style":1,"background":2195,"log_type":1},{"step":30,"content":"가만히 죽기만을 기다리는 것과 모험을 하는 것, 둘 중 당신은 언제나처럼 후자를 택했다.","style":3,"background":2196,"log_type":1}]}