{"id":8022,"chapter_id":8,"scene_id":802,"steps":[{"step":1,"speaker":"엘라","content":"흐앗, 핫! 저게 진짜! 가까이 가질 못하게 하네!","voice":["vo_cgplot_8022001"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":2,"speaker":"엘라","content":"오라고 해놓고 이 녀석들을 풀어?! 이 많은 괴물로 날 가로막아서 어디다가 쓰게?!","voice":["vo_cgplot_8022002"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":3,"speaker":"선택지","options":["저 여자가 원하는 건 나야"],"jump":[4],"style":6,"background":710,"log_type":1},{"step":4,"content":"당신은 한발 다가가 왜곡된 환영을 마주했다.","style":3,"background":710,"log_type":1},{"step":5,"speaker":"선택지","options":["내가 어떻게 곁에 있어 주길 바라지?"],"jump":[6],"style":6,"background":710,"log_type":1},{"step":6,"speaker":"'하멜'","content":"하하하, 역시 당신이 최고예요. 그 여자보다 훨씬 낫네요!","voice":["vo_cgplot_8022006"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":7,"speaker":"'하멜'","content":"내가 데리러 갈게요!","voice":["vo_cgplot_8022007"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":8,"speaker":"헤카테","content":"국장님, 위험합니다!","voice":["vo_cgplot_8022008"],"voice_bank":"vo_cgplot_08","style":1,"background":710,"log_type":1},{"step":10,"content":"그녀의 치맛자락이 수많은 환영의 촉수로 갈라지더니 당신에게 달려들었다. 수감자들이 황급히 막으려 했지만, 당신은 그 검은 그림자를 움켜쥐고 당신을 집어삼키게 했다.","style":3,"background":710,"log_type":1}]}