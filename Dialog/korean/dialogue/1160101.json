{"id":1160101,"chapter_id":1160101,"scene_id":1,"steps":[{"step":1,"speaker":"아리엘","content":"여… 여긴?","voice":["vo_trial_160101_1_1"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101002,"trial_step":2,"drawing":1160118},{"step":2,"content":"소녀는 불안을 애써 숨기며 떨리는 목소리로 말했다.","style":3,"log_type":1,"src_id":260101003,"trial_step":3,"drawing":1160118},{"step":3,"content":"심문실이다, 네 죄를 심문하기 위한 곳이지.","style":2,"log_type":1,"src_id":260101004,"trial_step":4,"drawing":1160118},{"step":4,"speaker":"아리엘","content":"앗…","voice":["vo_trial_160101_1_5"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101006,"trial_step":6,"drawing":1160118},{"step":5,"content":"그녀는 갑작스러운 빛에 놀란 듯했다.","style":3,"log_type":1,"src_id":260101007,"trial_step":7,"drawing":1160118},{"step":6,"options":["부드럽게 달랜다","강하게 추궁한다"],"style":6,"log_type":1,"src_id":260101008,"trial_step":8,"course":3,"drawing":1160118,"choices":[{"text":"부드럽게 달랜다","goto":13},{"text":"강하게 추궁한다","goto":9}]},{"step":7,"content":"말해! 네 이름은 뭐고, 무슨 죄를 저질렀으며, 왜 죄를 저지른 거지?","style":2,"log_type":1,"src_id":260101009,"trial_step":9,"drawing":1160118},{"step":8,"speaker":"아리엘","content":"제 이름은 아리엘이고, 저는, 죄… 죄송해요! 다 제 잘못이에요! 제가 잘못한 거예요…","voice":["vo_trial_160101_1_9"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101010,"trial_step":10,"drawing":1160118},{"step":9,"content":"금방이라도 울 듯한 얼굴로 사과했지만, 당신의 질문에 침착하게 답할 수는 없어 보였다. 그녀를 대하는 방식을 바꿔야 할 것 같다.","style":3,"log_type":1,"src_id":260101011,"trial_step":11,"drawing":1160118},{"step":10,"options":["부드럽게 달랜다"],"style":6,"log_type":1,"src_id":260101012,"trial_step":12,"course":3,"drawing":1160118,"choices":[{"text":"부드럽게 달랜다","goto":13}]},{"step":11,"content":"무서워하지 마, 아리엘. 형식적인 심문일 뿐이니까. MBCC는 너를 디스시티의 시민으로서 존중해 줄 거야.","style":2,"log_type":1,"src_id":260101013,"trial_step":13,"drawing":1160118},{"step":12,"speaker":"아리엘","content":"알겠어요…","voice":["vo_trial_160101_1_13"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101014,"trial_step":14,"drawing":1160124},{"step":13,"content":"아직 완전히 안심하지는 못했는지 그녀는 두 손을 꽉 잡고 있었다. 조금 더 부드럽게 말해보자.","style":3,"log_type":1,"src_id":260101016,"trial_step":16,"drawing":1160124},{"step":14,"content":"이제 정확한 확인을 위해 기본적인 정보를 확인하려고 해, 괜찮겠어?","style":2,"log_type":1,"src_id":260101017,"trial_step":17,"drawing":1160124},{"step":15,"content":"그녀는 덜덜 떨며 고개를 끄덕였다.","style":3,"log_type":1,"src_id":260101018,"trial_step":18,"drawing":1160124},{"step":16,"content":"네가 왜 이곳에 온 줄은 알고 있어?","style":2,"log_type":1,"src_id":260101019,"trial_step":19,"drawing":1160124},{"step":17,"speaker":"아리엘","content":"네… FAC 대원 앞에서 이능력을 썼기 때문이죠…","voice":["vo_trial_160101_1_18"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101020,"trial_step":20,"drawing":1160124},{"step":18,"speaker":"아리엘","content":"제 이능력으로 대원들이 다쳤고, 그 때문에 변이체 처리를 방해하게 되었어요…","voice":["vo_trial_160101_1_19"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101021,"trial_step":21,"drawing":1160124},{"step":19,"options":["왜 FAC를 방해했지?"],"style":6,"log_type":1,"src_id":260101022,"trial_step":22,"course":3,"drawing":1160124,"choices":[{"text":"왜 FAC를 방해했지?","goto":23}]},{"step":20,"speaker":"아리엘","content":"정말 고의가 아니었어요… 저, 전 그저 그 아이를 보호하려고… 일이 이렇게 될 줄 몰랐단 말이에요…","voice":["vo_trial_160101_1_21"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101023,"trial_step":23,"drawing":1160113},{"step":21,"speaker":"아리엘","content":"죄송해요! 정말 죄송해요!","voice":["vo_trial_160101_1_22"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101024,"trial_step":24,"drawing":1160113},{"step":22,"content":"그녀는 이런 형식의 문답에 익숙지 않은지, 억눌린 분위기 탓에 말을 제대로 이어 나가질 못했다.","style":3,"log_type":1,"src_id":260101025,"trial_step":25,"drawing":1160113},{"step":23,"options":["침착하고, 천천히 말해봐"],"style":6,"log_type":1,"src_id":260101026,"trial_step":26,"course":3,"drawing":1160113,"choices":[{"text":"침착하고, 천천히 말해봐","goto":27}]},{"step":24,"content":"아이를 보호하려 그랬다고? 그 아이가 누군데?","style":2,"log_type":1,"src_id":260101027,"trial_step":27,"drawing":1160124},{"step":25,"speaker":"아리엘","content":"모르겠어요…","voice":["vo_trial_160101_1_26"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101028,"trial_step":28,"drawing":1160124},{"step":26,"content":"이름도 모르는 거야?","style":2,"log_type":1,"src_id":260101029,"trial_step":29,"drawing":1160124},{"step":27,"speaker":"아리엘","content":"…네.","voice":["vo_trial_160101_1_28"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101030,"trial_step":30,"drawing":1160124},{"step":28,"content":"그럼 네가 구한 뒤에 그 아이는 어디로 갔지?","style":2,"log_type":1,"src_id":260101031,"trial_step":31,"drawing":1160124},{"step":29,"speaker":"아리엘","content":"아마도… 신디케이트?","voice":["vo_trial_160101_1_30"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101032,"trial_step":32,"drawing":1160124},{"step":30,"speaker":"아리엘","content":"죄송해요, 전 정말 몰라요…","voice":["vo_trial_160101_1_31"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101033,"trial_step":33,"drawing":1160124},{"step":31,"content":"아리엘은 제대로 대답하지 못해 눈치가 보였는지, 불안한 얼굴로 당신의 질책을 기다리고 있었다.","style":3,"log_type":1,"src_id":260101034,"trial_step":34,"drawing":1160124},{"step":32,"content":"…변이체를 놓아주면 어떤 일이 벌어지는지 아나?","style":2,"log_type":1,"src_id":260101035,"trial_step":35,"drawing":1160124},{"step":33,"content":"그 아이가 계속 악화되어 결국 괴변체가 됐다면 어쨌을 거야? 다른 시민들에게까지 오염이 확산됐다면?","style":2,"log_type":1,"src_id":260101036,"trial_step":36,"drawing":1160124},{"step":34,"speaker":"아리엘","content":"제가… 너무 충동적이었다는 거 알아요!","voice":["vo_trial_160101_1_35"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101037,"trial_step":37,"drawing":1160112},{"step":35,"speaker":"아리엘","content":"그땐 일고여덟 명이나 되는 경호원들이 경찰봉을 들고 그 아이를 때리려 하고 있었단 말이에요. 게다가 모두 성인 남자였어요.","voice":["vo_trial_160101_1_36"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101038,"trial_step":38,"drawing":1160112},{"step":36,"speaker":"아리엘","content":"골목에 몰린 아이는 제발 놔 달라고 애원하고 있었다고요.","voice":["vo_trial_160101_1_37"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101039,"trial_step":39,"drawing":1160112},{"step":37,"speaker":"아리엘","content":"그 아이는 바닥에 웅크린 채, 손톱으로 바닥을 긁느라 피투성이가 되어 있었거든요…","voice":["vo_trial_160101_1_38"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101040,"trial_step":40,"drawing":1160112},{"step":38,"speaker":"아리엘","content":"한눈에 보기에도 겨우 버티고 있다는 걸 알 수 있었어요. 하지만 그 경호원은 그 아이를 놔주지 않았어요, 심지어…","voice":["vo_trial_160101_1_39"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101041,"trial_step":41,"drawing":1160112},{"step":39,"content":"차마 입에 담기 어려운 광경을 떠올린 것인지, 아리엘의 얼굴은 붉게 상기되었다.","style":3,"log_type":1,"src_id":260101042,"trial_step":42,"drawing":1160129},{"step":40,"options":["그들이 무슨 짓을 했지?"],"style":6,"log_type":1,"src_id":260101043,"trial_step":43,"course":3,"drawing":1160129,"choices":[{"text":"그들이 무슨 짓을 했지?","goto":44}]},{"step":41,"speaker":"아리엘","content":"아주 더러운 말로 그 아이를 모욕했어요.","voice":["vo_trial_160101_1_42"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101044,"trial_step":44,"drawing":1160129},{"step":42,"speaker":"아리엘","content":"머릿속이 더러운 생각으로 가득하니, M 수치가 이렇게 높은 거라며…","voice":["vo_trial_160101_1_43"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101045,"trial_step":45,"drawing":1160129},{"step":43,"speaker":"아리엘","content":"하지만 그런 말을 듣고도, 그 아이는 반항하지 않았어요.","voice":["vo_trial_160101_1_44"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101046,"trial_step":46,"drawing":1160117},{"step":44,"speaker":"아리엘","content":"마음이 급해지니, 갑자기 제 손안에서 이런 동그란 빛이 생겨났어요…","voice":["vo_trial_160101_1_45"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101047,"trial_step":47,"drawing":1160117},{"step":45,"content":"아리엘의 손안에서 따스한 푸른빛이 피어나 한 덩어리로 모이더니, 또 금세 사라져버렸다.","style":3,"log_type":1,"src_id":260101048,"trial_step":48,"drawing":1160117},{"step":46,"speaker":"아리엘","content":"아무리 그 아이가 정말 변이체고, 저와는 모르는 사이라고 해도…","voice":["vo_trial_160101_1_47"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101049,"trial_step":49,"drawing":1160117},{"step":47,"speaker":"아리엘","content":"그래도 그 아이는 선량해 보였어요. 적어도, 그 아이를 모욕한 사람들보다는 선량했겠죠…","voice":["vo_trial_160101_1_48"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101050,"trial_step":50,"drawing":1160125},{"step":48,"speaker":"아리엘","content":"상황을 제멋대로 판단해서 죄송해요.","voice":["vo_trial_160101_1_49"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101051,"trial_step":51,"drawing":1160115},{"step":49,"content":"아리엘은 부모님에게 잘못을 들킨 아이처럼 고개를 푹 숙인 채 당신의 질책을 기다리고 있었다.","style":3,"log_type":1,"src_id":260101052,"trial_step":52,"drawing":1160115},{"step":50,"content":"거짓말을 하는 것 같지는 않았다. 그러나 그녀가 변이체를 대하는 태도와 그녀가 속한 가문 사이에는 큰 모순이 있었다.","style":3,"log_type":1,"src_id":260101053,"trial_step":53,"drawing":1160115},{"step":51,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":52,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":53,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":54,"options":["선택1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":55,"content":"테스트","style":18,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":56,"options":["선택1","선택2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":57,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":58,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":54,"course":6,"drawing":1160115},{"step":59,"content":"우린 이미 네 신분에 대한 조사를 마쳤어. 넌 스펜서 가문의 아가씨지?","style":2,"log_type":1,"src_id":260101055,"trial_step":55,"drawing":1160128},{"step":60,"speaker":"아리엘","content":"알고… 계셨나요?","voice":["vo_trial_160101_1_54"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101056,"trial_step":56,"drawing":1160128},{"step":61,"content":"신성의 상업계에서 가장 명망 있는 가문이지. 신성의 변이체 청소에 줄곧 막대한 경제적 지원을 해오고 있고.","style":2,"log_type":1,"src_id":260101057,"trial_step":57,"drawing":1160128},{"step":62,"content":"물론 동명이인일 가능성도 배제할 수는 없겠지만, 네가 입고 있는 그 드레스는 일반 가정에서 구할 수 있는 옷이 아닐 텐데?","style":2,"log_type":1,"src_id":260101058,"trial_step":58,"drawing":1160128},{"step":63,"speaker":"아리엘","content":"일부러 숨긴 건 아니에요!","voice":["vo_trial_160101_1_57"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101059,"trial_step":59,"drawing":1160111},{"step":64,"speaker":"아리엘","content":"전 단지 아버지가 모르셨으면 해서… 그분은 변이체를 몹시 혐오하시거든요.","voice":["vo_trial_160101_1_58"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101060,"trial_step":60,"drawing":1160111},{"step":65,"speaker":"아리엘","content":"아버지는 변이체를 모든 범죄의 근원이라고 생각해요. 그리고 수감자는, 세상에서 가장 악하고 위험한 존재라 여기시죠…","voice":["vo_trial_160101_1_59"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101061,"trial_step":61,"drawing":1160111},{"step":66,"content":"너도 그렇게 생각해? 조금 전에 넌 감염자를 두둔했잖아.","style":2,"log_type":1,"src_id":260101062,"trial_step":62,"drawing":1160111},{"step":67,"speaker":"아리엘","content":"저요? 모르겠어요…","voice":["vo_trial_160101_1_61"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101063,"trial_step":63,"drawing":1160111},{"step":68,"speaker":"아리엘","content":"전 단지 한 사람의 선악이라는 것을 숫자와 질병으로 정의해서는 안 된다고 생각할 뿐이에요.","voice":["vo_trial_160101_1_62"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101064,"trial_step":64,"drawing":1160111},{"step":69,"speaker":"아리엘","content":"제가 이렇게 말할 때마다, 아버지께서는 스펜서 가문에서 가장 멍청한 아이라고 호되게 꾸짖으셨죠.","voice":["vo_trial_160101_1_63"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101065,"trial_step":65,"drawing":1160115},{"step":70,"speaker":"아리엘","content":"물론, 그런 아버지도 제가 변이체를 돕다가 수감자가 되어버릴 정도로 멍청할 줄은 모르셨겠지만요.","voice":["vo_trial_160101_1_64"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101066,"trial_step":66,"drawing":1160115},{"step":71,"content":"그녀는 여전히 이능력을 쓸 수 있다는 사실이 믿기지 않는 듯 멍하니 자신의 두 손을 바라보고 있었다.","style":3,"log_type":1,"src_id":260101067,"trial_step":67,"drawing":1160115},{"step":72,"speaker":"아리엘","content":"모르는 사람을 위해 충동적으로 움직이고, 결국 사건에 말려들어 버려서…","voice":["vo_trial_160101_1_66"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101068,"trial_step":68,"drawing":1160115},{"step":73,"speaker":"아리엘","content":"이제는 MBCC의 모두와 국장님에게까지 민폐를 끼치게 되었네요… 정말 죄송해요.","voice":["vo_trial_160101_1_67"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101069,"trial_step":69,"drawing":1160115},{"step":74,"options":["민폐가 아니야","사과할 필요 없어"],"style":6,"log_type":1,"src_id":260101070,"trial_step":70,"course":3,"drawing":1160115,"choices":[{"text":"민폐가 아니야","goto":71},{"text":"사과할 필요 없어","goto":71}]},{"step":75,"content":"넌 반사적으로 약자를 도왔을 뿐이야, 그 행동은 결코 악한 게 아니지.","style":2,"log_type":1,"src_id":260101071,"trial_step":71,"drawing":1160128},{"step":76,"speaker":"아리엘","content":"그 경호원들은…","voice":["vo_trial_160101_1_70"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101072,"trial_step":72,"drawing":1160128},{"step":77,"content":"최대한 공정하게 처리하도록 하겠어. 그 아이의 상황도 최대한 찾아봐 주지.","style":2,"log_type":1,"src_id":260101073,"trial_step":73,"drawing":1160128},{"step":78,"speaker":"아리엘","content":"감사합니다…","voice":["vo_trial_160101_1_72"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101074,"trial_step":74,"drawing":1160116},{"step":79,"content":"그녀는 무거운 짐을 내려놓은 듯 미소를 지으며, 생면부지의 낯선 이를 위해 안도의 한숨을 내쉬었다.","style":3,"log_type":1,"src_id":260101075,"trial_step":75,"drawing":1160116},{"step":80,"speaker":"아리엘","content":"그 아이가 신디케이트에서는 어떻게 지내고 있을지 모르겠네요. 그곳엔 갱단이 많다던데, 위험하지는 않을지…","voice":["vo_trial_160101_1_74"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101076,"trial_step":76,"drawing":1160116},{"step":81,"speaker":"아리엘","content":"변이는 조금 나아졌을까요?","voice":["vo_trial_160101_1_75"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101077,"trial_step":77,"drawing":1160116},{"step":82,"options":["너 자신에 대해서는 걱정하지 않는 거야?"],"style":6,"log_type":1,"src_id":260101078,"trial_step":78,"course":3,"drawing":1160116,"choices":[{"text":"너 자신에 대해서는 걱정하지 않는 거야?","goto":79}]},{"step":83,"speaker":"아리엘","content":"…네?","voice":["vo_trial_160101_1_77"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101079,"trial_step":79,"drawing":1160128},{"step":84,"content":"아리엘은 이런 질문에 아주 놀란 듯 보였다. 그녀는 낯선 아이와 MBCC, 그리고 아버지와 가족에 대해서 걱정했다.","style":3,"log_type":1,"src_id":260101080,"trial_step":80,"drawing":1160128},{"step":85,"content":"그러나 그녀는 유일하게, 자신의 처지만은 걱정하지 않았다.","style":3,"log_type":1,"src_id":260101081,"trial_step":81,"drawing":1160128},{"step":86,"speaker":"아리엘","content":"아리엘은 모두에게 짐이 되지 않는 것만으로 만족해요.","voice":["vo_trial_160101_1_80"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101082,"trial_step":82,"drawing":1160115},{"step":87,"speaker":"아리엘","content":"스펜서 가문에서 제 행방을 알아내지만 않으면 수감자의 일에 연루되지는 않을 테니까요.","voice":["vo_trial_160101_1_81"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101083,"trial_step":83,"drawing":1160115},{"step":88,"speaker":"아리엘","content":"아버지께서도 제가 변이체를 도운 일 때문에 화내지 않으실 거고요.","voice":["vo_trial_160101_1_82"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101084,"trial_step":84,"drawing":1160115},{"step":89,"content":"그녀는 아주 작은 목소리로 중얼거렸다.","style":3,"log_type":1,"src_id":260101085,"trial_step":85,"drawing":1160115},{"step":90,"speaker":"아리엘","content":"네… 그거면 돼요… 아리엘 같은 건 사라져 버려도 아무 상관 없으니까요…","voice":["vo_trial_160101_1_84"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101086,"trial_step":86,"drawing":1160115},{"step":91,"options":["무슨 헛소리를 하는 거야?","넌 짐 같은 게 아니야"],"style":6,"log_type":1,"src_id":260101087,"trial_step":87,"course":3,"drawing":1160115,"choices":[{"text":"무슨 헛소리를 하는 거야?","goto":88},{"text":"넌 짐 같은 게 아니야","goto":89}]},{"step":92,"content":"네 능력은 디스시티를 보호하는 데에 큰 보탬이 될 수 있어.","style":2,"log_type":1,"src_id":260101088,"trial_step":88,"drawing":1160115,"next":[90]},{"step":93,"content":"난 네 체내의 M 수치를 조절해서, 네 능력을 디스시티를 보호하는 데에 발휘하도록 할 거야.","style":2,"log_type":1,"src_id":260101089,"trial_step":89,"drawing":1160128},{"step":94,"content":"나와 MBCC에게는 네가 필요해.","style":2,"log_type":1,"src_id":260101090,"trial_step":90,"drawing":1160128},{"step":95,"speaker":"아리엘","content":"국장님?","voice":["vo_trial_160101_1_90"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101091,"trial_step":91,"drawing":1160128},{"step":96,"content":"아리엘은 믿을 수 없다는 듯 당신을 바라보다, 떨리는 눈빛으로 입을 열었다.","style":3,"log_type":1,"src_id":260101092,"trial_step":92,"drawing":1160128},{"step":97,"speaker":"아리엘","content":"다, 다시 한번 말씀해 주시겠어요?","voice":["vo_trial_160101_1_92"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101093,"trial_step":93,"drawing":1160128},{"step":98,"options":["다시 한번 그녀를 격려한다"],"style":6,"log_type":1,"src_id":260101094,"trial_step":94,"course":3,"drawing":1160128,"choices":[{"text":"다시 한번 그녀를 격려한다","goto":95}]},{"step":99,"content":"아리엘, 너는 나, MBCC, 그리고 네가 지켜낸 그 아이에게 있어 결코 아무 쓸모도 없는 아가씨가 아니야.","style":2,"log_type":1,"src_id":260101095,"trial_step":95,"drawing":1160128},{"step":100,"speaker":"아리엘","content":"국장님…","voice":["vo_trial_160101_1_95"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101096,"trial_step":96,"drawing":1160130},{"step":101,"content":"커다란 눈물방울이 그녀의 뺨을 타고 흘러내렸다. 당신과 그녀는 꽤나 당황하고 말았다.","style":3,"log_type":1,"src_id":260101098,"trial_step":98,"drawing":1160130},{"step":102,"content":"왜 우는 거야?","style":2,"log_type":1,"src_id":260101099,"trial_step":99,"drawing":1160130},{"step":103,"speaker":"아리엘","content":"저요…?","voice":["vo_trial_160101_1_98"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101100,"trial_step":100,"drawing":1160130},{"step":104,"content":"그녀는 눈가를 가벼이 훔치고는 축축해진 자신의 손가락을 바라보았다.","style":3,"log_type":1,"src_id":260101101,"trial_step":101,"drawing":1160130},{"step":105,"speaker":"아리엘","content":"제가 왜 울죠? 전… 저도 모르겠어요…","voice":["vo_trial_160101_1_100"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101102,"trial_step":102,"drawing":1160130},{"step":106,"speaker":"아리엘","content":"아무래도, 살면서 이런 말을 들은 적이 처음이라…","voice":["vo_trial_160101_1_101"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101103,"trial_step":103,"drawing":1160130},{"step":107,"content":"그녀는 뺨을 적신 눈물을 서투르게 훔쳤지만, 벅차오르는 감정을 통제할 수 없는 듯 보였다.","style":3,"log_type":1,"src_id":260101104,"trial_step":104,"drawing":1160130},{"step":108,"speaker":"아리엘","content":"이상해요… 눈물이 멈추질 않아요…","voice":["vo_trial_160101_1_103"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101105,"trial_step":105,"drawing":1160130},{"step":109,"speaker":"아리엘","content":"인정을 받는다는 건, 이런 기분이었군요…","voice":["vo_trial_160101_1_104"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101106,"trial_step":106,"drawing":1160130},{"step":110,"speaker":"아리엘","content":"아리엘은… 스펜서 가문만을 위해 존재하지 않아도 됐던 거예요…","voice":["vo_trial_160101_1_105"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101107,"trial_step":107,"drawing":1160130},{"step":111,"content":"수년을 쌓아온 설움이 마침내 터져 나오며, 심문실의 분위기가 가라앉았다. 당신은 아리엘에게 감정을 추스를 시간을 줬다.","style":3,"log_type":1,"src_id":260101108,"trial_step":108,"drawing":1160130},{"step":112,"content":"말리지도, 달래지도 않았고, 추태를 보였다며 꾸짖지도 않았다. 그녀는 마침내 스스로의 감정을 허심탄회하게 쏟아냈다.","style":3,"log_type":1,"src_id":260101109,"trial_step":109,"drawing":1160130},{"step":113,"content":"눈시울이 붉게 물든 그녀는, 한참 뒤에야 눈을 떠 당신을 직시했다.","style":3,"log_type":1,"src_id":260101110,"trial_step":110,"drawing":1160120},{"step":114,"speaker":"아리엘","content":"한 가지만 부탁해도 될까요?","voice":["vo_trial_160101_1_109"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101111,"trial_step":111,"drawing":1160120},{"step":115,"content":"물론이지.","style":2,"log_type":1,"src_id":260101112,"trial_step":112,"drawing":1160120},{"step":116,"speaker":"아리엘","content":"저… 아버지를 만나러 가고 싶어요. 어쩌면, 마지막이 될지도 모르겠지만요…","voice":["vo_trial_160101_1_111"],"voice_bank":"vo_airuier_trial","style":1,"log_type":1,"src_id":260101113,"trial_step":113,"drawing":1160120}]}