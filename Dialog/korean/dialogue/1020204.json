{"id":1020204,"chapter_id":1020204,"scene_id":1,"steps":[{"step":1,"content":"디스씨 부서진 방어선","style":9,"background":10000,"log_type":1,"src_id":120204001,"trial_step":1},{"step":2,"speaker":"나이팅게일","content":"NOX가… 앞에 있어요.","voice":["vo_trial_20204_1_117"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1024,"log_type":1,"src_id":120204002,"trial_step":2},{"step":3,"content":"앰버를 쫓아다닌 지 벌써 두 시간이 지났다. 방금 그녀가 부서진 방어선을 지나 디스씨의 가장 깊은 곳으로 들어갔다.","style":3,"background":1024,"log_type":1,"src_id":120204003,"trial_step":3},{"step":4,"content":"당신과 앰버를 연결하는 족쇄도 그녀가 그곳에 있다는 걸 알려 주고 있었다.","style":3,"background":1024,"log_type":1,"src_id":120204004,"trial_step":4},{"step":5,"speaker":"나이팅게일","content":"국장님…","voice":["vo_trial_20204_1_120"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1024,"log_type":1,"src_id":120204005,"trial_step":5},{"step":6,"speaker":"나이팅게일","content":"저곳은 산 사람이 디딜 수 없는 구역입니다. 국장님… 가시면 안 됩니다.","voice":["vo_trial_20204_1_121"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1024,"log_type":1,"src_id":120204006,"trial_step":6},{"step":7,"content":"당신은 한쪽에 놓인 화물을 운송할 때 쓰이는 안전 로프를 가리키며 해결 방법을 말했다.","style":3,"background":1024,"log_type":1,"src_id":120204007,"trial_step":7},{"step":8,"content":"이걸 내 몸에 감아, 내가 신호를 보내면 너희가 줄을 끌어당기면 돼.","style":2,"background":1024,"log_type":1,"src_id":120204008,"trial_step":8},{"step":9,"speaker":"나이팅게일","content":"어떤 수감자도 포기하고 싶지 않은 국장님의 마음은 저도 잘 알고 있습니다.","voice":["vo_trial_20204_1_124"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1024,"log_type":1,"src_id":120204009,"trial_step":9},{"step":10,"speaker":"나이팅게일","content":"하지만 이건… 목숨을 버리는 짓이에요.","voice":["vo_trial_20204_1_125"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1024,"log_type":1,"src_id":120204010,"trial_step":10},{"step":11,"content":"알잖아, 족쇄는 블랙링의 잠식을 막을 수 있어.","style":2,"background":1024,"log_type":1,"src_id":120204011,"trial_step":11},{"step":12,"content":"게다가 함께 일출을 보러 가기로 앰버와 약속했어. 약속을 어기고 싶지 않아.","style":2,"background":1024,"log_type":1,"src_id":120204012,"trial_step":12},{"step":13,"content":"나이팅게일은 아무 말 없이 당신의 눈을 바라봤다.","style":3,"background":1024,"log_type":1,"src_id":120204013,"trial_step":13},{"step":14,"content":"결국 그녀는 조용히 당신에게 로프를 묶어주었다.","style":3,"background":1024,"log_type":1,"src_id":120204014,"trial_step":14},{"step":15,"speaker":"나이팅게일","content":"이상이 있으면 즉시 신호를 보내주셔야 합니다.","voice":["vo_trial_20204_1_130"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1024,"log_type":1,"src_id":120204015,"trial_step":15},{"step":16,"speaker":"나이팅게일","content":"절대… 망설이지 마시고요.","voice":["vo_trial_20204_1_131"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1024,"log_type":1,"src_id":120204016,"trial_step":16},{"step":17,"content":"당신은 한 손으로 허리에 묶인 로프를 쥐고 얕은 진흙탕을 힘겹게 헤쳐 나갔다.","style":3,"background":110,"log_type":1,"src_id":120204017,"trial_step":17},{"step":18,"content":"앰버!","style":2,"background":110,"log_type":1,"src_id":120204018,"trial_step":18},{"step":19,"content":"앞으로 나아갈수록 하늘과 땅의 빛깔이 바래고, 머리 위의 차가운 붉은 달만이 눈부시고 선명하게 빛날 뿐이었다.","style":3,"background":110,"log_type":1,"src_id":120204019,"trial_step":19},{"step":20,"content":"그리고 전진할수록 근처에 점점 더 많은 '그림자'가 나타났다. 그들은 꼿꼿이 서서 멍한 눈빛으로 붉은 하늘을 바라보았다.","style":3,"background":110,"log_type":1,"src_id":120204020,"trial_step":20},{"step":21,"content":"달 아래, 당신의 몸에서 무언가가 서서히 벗겨지고 있었다.","style":3,"background":110,"log_type":1,"src_id":120204021,"trial_step":21},{"step":22,"speaker":"???","content":"시… 신선한…","voice":["vo_trial_20204_1_137"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204022,"trial_step":22},{"step":23,"speaker":"???","content":"생존자의 기억이다…","voice":["vo_trial_20204_1_138"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204023,"trial_step":23},{"step":24,"content":"생기 없던 그림자들이 돌연 어떤 냄새라도 맡은 듯 탐욕스럽게 코를 들썩이며 중얼거렸다.","style":3,"background":110,"log_type":1,"src_id":120204024,"trial_step":24},{"step":25,"content":"앰버!","style":2,"background":110,"log_type":1,"src_id":120204025,"trial_step":25},{"step":26,"content":"당신은 망설이지 않고 계속해서 소녀의 이름을 불러대며 필사적으로 앞을 향해 걸었다. 그러나 발밑의 진흙과 진흙 속의 알 수 없는 오물이 당신의 걸음을 방해했다.","style":3,"background":110,"log_type":1,"src_id":120204026,"trial_step":26},{"step":27,"content":"당신은 비틀거리며 호수 속으로 떨어졌다. 그러자 수면에 눈부시게 찬란한 무늬가 퍼졌다.","style":3,"background":110,"log_type":1,"src_id":120204027,"trial_step":27},{"step":28,"speaker":"???","content":"생각났어.","voice":["vo_trial_20204_1_143"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204028,"trial_step":28},{"step":29,"speaker":"???","content":"나도 살아있을 때가 있었어.","voice":["vo_trial_20204_1_144"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204029,"trial_step":29},{"step":30,"speaker":"???","content":"우린 죽은 지 너무 오래 지났어…","voice":["vo_trial_20204_1_145"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204030,"trial_step":30},{"step":31,"content":"당신은 몸을 일으켰다. 왠지 모르겠지만 물체의 빛깔이 끊임없이 호수 속으로 흩어지고 있었다. 당신은 당신의 뒤에서 중얼대는 사람들과 평지에 세워진 방어선이 무얼 의미하는지도 잊어버렸지만, 계속 앞으로 나아가야만 했다.","style":3,"background":110,"log_type":1,"src_id":120204031,"trial_step":31},{"step":32,"content":"얼마나 오래 걸었을까, 낯익은 모습이 마침내 당신의 눈에 들어온다.","style":3,"background":110,"log_type":1,"src_id":120204032,"trial_step":32},{"step":33,"content":"앰버, 나 왔어.","style":2,"background":110,"log_type":1,"src_id":120204033,"trial_step":33},{"step":34,"content":"허리의 이물질도 불편하고, 몸과 머리도 무거웠다. 당신은 자신이 왜 이렇게 성가신 물건을 달고 있는지 알 수 없었지만 본능적으로 벗어선 안 된다는 걸 느꼈다.","style":3,"background":110,"log_type":1,"src_id":120204034,"trial_step":34},{"step":35,"content":"여기선 해를 볼 수 없어. 나랑 함께 돌아가자.","style":2,"background":110,"log_type":1,"src_id":120204035,"trial_step":35},{"step":36,"options":["앰버의 손을 잡는다"],"style":6,"background":110,"log_type":1,"src_id":120204036,"trial_step":36,"course":3},{"step":37,"content":"앰버가 천천히 고개를 돌렸다.","style":3,"background":110,"log_type":1,"src_id":120204037,"trial_step":37},{"step":38,"content":"그러나 그녀의 두 눈에는 더 이상 '앰버'의 모습이 존재하지 않았다.","style":3,"background":110,"log_type":1,"src_id":120204038,"trial_step":38},{"step":39,"speaker":"???","content":"하하하하하하하하하!","voice":["vo_trial_20204_1_154"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204039,"trial_step":39},{"step":40,"content":"등 뒤에서 광기 어린 웃음소리가 들려왔다. 당신의 모든 색채를 삼킨 뒤, 당신을 뒤따라오던 그림자들의 눈에 살기가 생생히 드러났다.","style":3,"background":110,"log_type":1,"src_id":120204040,"trial_step":40},{"step":41,"speaker":"???","content":"우리가 그랬잖아, 분명히 말했었잖아!","voice":["vo_trial_20204_1_156"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204041,"trial_step":41},{"step":42,"speaker":"???","content":"저 애는 이미 죽었다고!","voice":["vo_trial_20204_1_157"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204042,"trial_step":42},{"step":43,"speaker":"???","content":"우린 저 애의 기억과 우리 모두의 죽음으로 디스씨의 환상을 만들어냈어.","voice":["vo_trial_20204_1_158"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204043,"trial_step":43},{"step":44,"speaker":"???","content":"우린 규칙도, 디스씨도 분명히 속였다고! 그런데 네가 나타났지!","voice":["vo_trial_20204_1_159"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204044,"trial_step":44},{"step":45,"content":"머리 위의 달은 점점 낮게 드리우며 호수에서 일어나는 모든 일을 차갑게 지켜보고 있었다.","style":3,"background":110,"log_type":1,"src_id":120204045,"trial_step":45},{"step":46,"content":"당신은 마침내 붉은 달이 무얼 상징하는지 깨달았다. 디스씨의 본체, 차가운 규칙, 변이의 시작과 종점, 모든 사람의 결말.","style":3,"background":110,"log_type":1,"src_id":120204046,"trial_step":46},{"step":47,"content":"변이에 감염된 사람들은 죽은 뒤 디스씨에 속하게 된다. 그 누구도 거역할 수 없는 법칙이었다.","style":3,"background":110,"log_type":1,"src_id":120204047,"trial_step":47},{"step":48,"speaker":"???","content":"네가 저 애를 죽이고, 우릴 죽였어.","voice":["vo_trial_20204_1_163"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204048,"trial_step":48},{"step":49,"speaker":"???","content":"그리고 곧 네 자신도 죽이게 되겠지.","voice":["vo_trial_20204_1_164"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204049,"trial_step":49},{"step":50,"speaker":"???","content":"네가 선택한 죽음이니, 이 살아있는 기억들도 이제 필요 없겠지.","voice":["vo_trial_20204_1_165"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204050,"trial_step":50},{"step":51,"speaker":"???","content":"이제 우리 거야!","voice":["vo_trial_20204_1_166"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204051,"trial_step":51},{"step":52,"content":"사방에 있는 '그림자'들의 얼굴이 일그러지며 마치 괴변체과도 같은 육종과 송곳니가 생겨나더니, 당신을 향해 달려들었다.","style":3,"background":110,"log_type":1,"src_id":120204052,"trial_step":52},{"step":53,"content":"그들 중 일부는 당신 뒤에 있는 강철로 만든 로프를 잡아당겼고, 또 다른 일부는 호수면에서 흩어지는 색채를 붙잡았다.","style":3,"background":110,"log_type":1,"src_id":120204053,"trial_step":53},{"step":54,"content":"그리고 그보다 많은 '그림자'들이 당신을 향해 다가오고 있었다.","style":3,"background":110,"log_type":1,"src_id":120204054,"trial_step":54},{"step":55,"content":"달아나야 해… 누군가에게… 신호를 보내야 하는데…","style":2,"background":110,"log_type":1,"src_id":120204055,"trial_step":55},{"step":56,"content":"그게 누구더라? 신호가 뭐지? 여긴… 어디지?","style":2,"background":110,"log_type":1,"src_id":120204056,"trial_step":56},{"step":57,"content":"돌아가야 하지 않나? 그런데 어디로?","style":2,"background":110,"log_type":1,"src_id":120204057,"trial_step":57},{"step":58,"content":"당신은 온 힘을 다해 생각했지만 도무지 답을 찾을 수 없었다.","style":3,"background":110,"log_type":1,"src_id":120204058,"trial_step":58},{"step":59,"content":"안 돼, 돌아갈 수 없어. 앰버가 아직 여기 있잖아…","style":2,"background":110,"log_type":1,"src_id":120204059,"trial_step":59},{"step":60,"speaker":"???","content":"██, ██ 너 ███…","voice":["vo_trial_20204_1_175"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204060,"trial_step":60},{"step":61,"speaker":"???","content":"저 애 ████, 너희 █████…","voice":["vo_trial_20204_1_176"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204061,"trial_step":61},{"step":62,"content":"당신은 시끄러운 그림자들이 무슨 말을 하는지 알 수 없었다.","style":3,"background":110,"log_type":1,"src_id":120204062,"trial_step":62},{"step":63,"content":"의식이 흐려질수록 당신의 머릿속에 커다란 공백이 생겼다. 마치 암석이 바람에 깎여 알록달록한 자갈이 되어 호수에 흩어지는 것만 같았다.","style":3,"background":110,"log_type":1,"src_id":120204063,"trial_step":63},{"step":64,"content":"그리고 그 색채가 마침내 소녀를 물들였다.","style":3,"background":110,"log_type":1,"src_id":120204064,"trial_step":64},{"step":65,"speaker":"???","content":"${PlayerName}?","style":1,"background":110,"log_type":1,"src_id":120204065,"trial_step":65},{"step":66,"content":"소녀가 고개를 돌렸다. 그녀의 눈이 생기를 되찾았다.","style":3,"background":110,"log_type":1,"src_id":120204066,"trial_step":66},{"step":67,"speaker":"소녀","content":"당신이 왜 여기 있어요?","voice":["vo_trial_20204_1_182"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204067,"trial_step":67},{"step":68,"content":"너… 앰버 맞지?","style":2,"background":110,"log_type":1,"src_id":120204068,"trial_step":68},{"step":69,"content":"우리… 같이… 일출을 보러 가야지.","style":2,"background":110,"log_type":1,"src_id":120204069,"trial_step":69},{"step":70,"speaker":"소녀","content":"당신은 여기 와선 안 돼요.","voice":["vo_trial_20204_1_185"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204070,"trial_step":70},{"step":71,"content":"약속을… 어길 순 없어.","style":2,"background":110,"log_type":1,"src_id":120204071,"trial_step":71},{"step":72,"content":"같이 가자… 어서! 시간이 없어.","style":2,"background":110,"log_type":1,"src_id":120204072,"trial_step":72},{"step":73,"content":"콰직!","style":3,"background":110,"log_type":1,"src_id":120204073,"trial_step":73},{"step":74,"content":"등 뒤에서 금속이 부서지는 소리가 들려왔다.","style":3,"background":110,"log_type":1,"src_id":120204074,"trial_step":74},{"step":75,"content":"앰버가 당신을 쳐다봤다. 눈물이 갈라진 뺨 위로 흘러내려 호수로 떨어졌다.","style":3,"background":110,"log_type":1,"src_id":120204075,"trial_step":75},{"step":76,"speaker":"소녀","content":"저는… 시간이 조금 더 남아있을 거라 생각했어요. 하루라도 좋으니까… 친구들과… 일출을 볼 수 있을 거라고…","voice":["vo_trial_20204_1_191"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204076,"trial_step":76},{"step":77,"speaker":"소녀","content":"음… 지금은 이런 얘길 할 때가 아니야.","voice":["vo_trial_20204_1_192"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204077,"trial_step":77},{"step":78,"content":"소녀의 얼굴에 다시 환한 미소가 번졌다.","style":3,"background":110,"log_type":1,"src_id":120204078,"trial_step":78},{"step":79,"content":"소녀는 당신의 눈을 바라보며 그 낯설고도 익숙한 이름을 진지하게 불렀다.","style":3,"background":110,"log_type":1,"src_id":120204079,"trial_step":79},{"step":80,"speaker":"소녀","content":"${PlayerName}.","style":1,"background":110,"log_type":1,"src_id":120204080,"trial_step":80},{"step":81,"speaker":"소녀","content":"고마워요.","voice":["vo_trial_20204_1_196"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204081,"trial_step":81},{"step":82,"speaker":"소녀","content":"고마워요. 덕분에 마지막에 모든 걸 떠올릴 수 있었어요.","voice":["vo_trial_20204_1_197"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204082,"trial_step":82},{"step":83,"speaker":"소녀","content":"용서받을 수 없는 짓을… 그렇게 많이 저질렀는데도…","voice":["vo_trial_20204_1_198"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204083,"trial_step":83},{"step":84,"speaker":"소녀","content":"고마워요… 가장 절망적인 순간에 제 곁에 와줘서…","voice":["vo_trial_20204_1_199"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204084,"trial_step":84},{"step":85,"content":"당신은 소녀의 말을 이해할 수 없었지만, 본능적인 불안감에 그녀의 손을 꽉 붙잡았다.","style":3,"background":110,"log_type":1,"src_id":120204085,"trial_step":85},{"step":86,"speaker":"소녀","content":"저는 아주 오래전에 이미 이곳에 왔었어야 해요. 아무리 몸부림쳐도 벗어날 수 없는 현실이죠.","voice":["vo_trial_20204_1_201"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204086,"trial_step":86},{"step":87,"speaker":"소녀","content":"이걸 진작 알았어야 했는데. 그랬다면 그렇게 많은 잘못을 저지르지 않았을 텐데.","voice":["vo_trial_20204_1_202"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204087,"trial_step":87},{"step":88,"speaker":"소녀","content":"하지만 적어도 지금은 제가 할 수 있는 일이 있어요.","voice":["vo_trial_20204_1_203"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204088,"trial_step":88},{"step":89,"content":"사방에서 괴물이 몰려와 당신 코앞으로 다가왔지만, 당신은 오직 소녀에게만 집중하고 있었다.","style":3,"background":110,"log_type":1,"src_id":120204089,"trial_step":89},{"step":90,"content":"소녀는 당신의 두 손을 꼭 잡았다. 그녀의 몸 전체가 갈라지고 있었다.","style":3,"background":110,"log_type":1,"src_id":120204090,"trial_step":90},{"step":91,"content":"당신은 입을 열었지만, 무슨 말을 해야 할지 몰라 말을 잇지 못했다.","style":3,"background":110,"log_type":1,"src_id":120204091,"trial_step":91},{"step":92,"speaker":"소녀","content":"저는 당신을 지켜줄 수 없어요. 하지만 그 애는 가능할 거예요.","voice":["vo_trial_20204_1_207"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204092,"trial_step":92},{"step":93,"speaker":"소녀","content":"잘 지내요.","voice":["vo_trial_20204_1_208"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204093,"trial_step":93},{"step":94,"speaker":"소녀","content":"안녕…","voice":["vo_trial_20204_1_209"],"voice_bank":"vo_nuokesi_trial","style":1,"background":110,"log_type":1,"src_id":120204094,"trial_step":94},{"step":95,"content":"소녀의 몸이 부서져 하늘을 가득 메우는 별빛이 되었다.","style":3,"background":110,"log_type":1,"src_id":120204095,"trial_step":95},{"step":96,"content":"그리고 그때, 장검을 쥔 '괴물'이 또다시 나타났다.","style":3,"background":110,"log_type":1,"src_id":120204096,"trial_step":96},{"step":97,"content":"그것은 너무나도 길고 절망적인 악몽이었다. 당신이 깨어났을 땐 앰버가 당신을 안고 부서진 방어선을 향해 걸어가고 있었다. 당신은 저도 모르게 살아남은 자의 기쁨을 느꼈다.","style":3,"background":1002,"log_type":1,"src_id":120204097,"trial_step":97},{"step":98,"content":"앰버의 피부는 시체처럼 차가웠지만, 그래도 당신은 살아있어 다행이라고 생각했다.","style":3,"background":1002,"log_type":1,"src_id":120204098,"trial_step":98},{"step":99,"content":"우리… 구출 받은 거지?","style":2,"background":1002,"log_type":1,"src_id":120204099,"trial_step":99},{"step":100,"content":"앰버는 대답하지 않았고, 묵묵히 앞을 향해 걸어갈 뿐이었다.","style":3,"background":1002,"log_type":1,"src_id":120204100,"trial_step":100},{"step":101,"content":"부서진 방어선 위, 나이팅게일이 초조한 모습으로 사람들을 지휘해 로프를 내리고 있었다.","style":3,"background":1002,"log_type":1,"src_id":120204101,"trial_step":101},{"step":102,"content":"그들 뒤로 따스한 금빛 태양이 천천히 떠오르고 있었다.","style":3,"background":1002,"log_type":1,"src_id":120204102,"trial_step":102},{"step":103,"content":"앰버, 일출이야.","style":2,"background":1002,"log_type":1,"src_id":120204103,"trial_step":103},{"step":104,"content":"앰버?","style":2,"background":1002,"log_type":1,"src_id":120204104,"trial_step":104},{"step":105,"content":"당신은 고개를 들었다. 앰버의 창백한 얼굴엔 아무런 반응이 없었다. 눈앞의 모든 것이, 그녀가 늘 갈망하던 일출마저 자신과 무관하다는 듯이.","style":3,"background":1002,"log_type":1,"src_id":120204105,"trial_step":105},{"step":106,"content":"그것은 'NOX'라는 이름의 차가운 껍데기였다.","style":3,"background":1002,"log_type":1,"src_id":120204106,"trial_step":106}]}