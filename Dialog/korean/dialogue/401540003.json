{"id":401540003,"chapter_id":50045,"scene_id":45011,"steps":[{"step":1,"speaker":"음유시인","content":"~~~~","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":2,"speaker":"음유시인","content":"'언 손으로 추운 하루를 마무리하네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":3,"speaker":"음유시인","content":"'굶주린 배는 여전한데.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":4,"speaker":"음유시인","content":"'금발 여인이 나타났네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":5,"speaker":"음유시인","content":"'무대 위 국왕이 크게 넘어졌네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":6,"speaker":"음유시인","content":"'그녀는 모자챙을 올리고 꽃처럼 활짝 웃었네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":7,"speaker":"음유시인","content":"'상자 가득 찬 금화는 그녀의 금발처럼 휘황찬란하네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":8,"speaker":"음유시인","content":"'더 필요한가? 더 필요한가?'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":9,"speaker":"음유시인","content":"'돈이 있다고 벌지 않는 것은 어리석은 일.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":10,"speaker":"음유시인","content":"'더 필요해! 더 필요해!'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":11,"speaker":"음유시인","content":"'벌꿀이 들어가야 조화로워지네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":12,"speaker":"음유시인","content":"'그런데 포르투나, 조심하는 게 좋을 거야.'","style":1,"background":1069,"is_centered":true,"log_type":1}]}