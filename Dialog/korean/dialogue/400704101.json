{"id":400704101,"chapter_id":50019,"scene_id":51905,"steps":[{"step":1,"content":"싹둑… 싹둑…","style":3,"background":10000,"log_type":1},{"step":2,"content":"싹둑… 싹둑…","style":3,"background":10000,"log_type":1},{"step":3,"content":"'그것'은 마치 그림자처럼 당신을 따라다녔다. 아무리 시도해도 그 칠흑 같은 안개에서 출구를 찾을 수가 없었다.","style":3,"background":2080,"log_type":1},{"step":4,"content":"그 소리는 점점 가까워져 안개 속의 얼굴을 볼 수 있을 것만 같았다.","style":3,"background":2080,"log_type":1},{"step":5,"content":"싹둑… 싹둑…","style":3,"background":2080,"log_type":1},{"step":6,"content":"좁고 어두운 골목 안, 더 이상 숨을 곳이 없었다.","style":3,"background":2080,"log_type":1},{"step":7,"content":"이대로 체념해야 하는가…","style":3,"background":2080,"log_type":1},{"step":8,"content":"툭툭.","style":3,"background":2080,"log_type":1},{"step":9,"content":"어깨에 무언가가 닿았다.","style":3,"background":2080,"log_type":1},{"step":10,"speaker":"??","content":"얼른… 따라와요…","voice":["vo_event_400704101_10"],"voice_bank":"vo_event_07041","style":1,"background":2080,"log_type":1},{"step":11,"options":["!!"],"jump":[12],"style":6,"background":2080,"log_type":1},{"step":12,"content":"황급히 고개를 돌려 봤지만 등불 하나만이 눈앞을 스쳐 지나갈 뿐이었다.","style":3,"background":2080,"log_type":1},{"step":13,"content":"등불은 안개를 지나 당신의 앞에 멈췄다. 마치 자신을 따라오라는 것 같았다.","style":3,"background":2080,"log_type":1},{"step":14,"options":["등불을 따라간다"],"jump":[15],"style":6,"background":2080,"log_type":1},{"step":15,"content":"이것이 적인지 아군인지 알 수는 없지만, 최소한 그것은 이 안개 속에서 자유롭게 행동할 수가 있었다.","style":3,"background":2080,"log_type":1},{"step":16,"content":"당신은 속는 셈 치고 등불을 따라가기로 했다. 어쩌면 여기서 나갈 수 있을지도 모른다.","style":3,"background":2080,"log_type":1}]}