{"id":404102502,"chapter_id":50085,"scene_id":58512,"steps":[{"step":1,"speaker":"엘라","content":"…콜록, 콜록…","voice":["vo_event_404102502_1"],"voice_bank":"vo_event_41025","style":1,"background":2391,"log_type":1},{"step":2,"content":"온몸 구석구석이 다 아팠다. 착지 순간 발목까지 접질려 버려, 절뚝거리며 앞으로 나아갈 수밖에 없었다.","style":3,"background":2391,"log_type":1},{"step":3,"content":"착지한 곳은 그녀가 연구소를 빠져나왔던 비밀 통로와 멀지 않았다. 그 출구만 찾을 수 있다면 탈출할 희망이 있다.","style":3,"background":2391,"log_type":1},{"step":4,"content":"비밀 통로의 출구가 눈앞에 다가왔지만, 의식은 이미 멀어지고 있었다.","style":3,"background":2391,"log_type":1},{"step":5,"speaker":"엘라","content":"빨리 나가야 해… 반드시 이 소식을 전해야 해…","voice":["vo_event_404102502_5"],"voice_bank":"vo_event_41025","style":1,"background":2391,"log_type":1},{"step":6,"speaker":"엘라","content":"나는… 반드시…","voice":["vo_event_404102502_6"],"voice_bank":"vo_event_41025","style":1,"background":2391,"log_type":1},{"step":7,"content":"흐릿한 의식 속에서, 그녀는 익숙한 사람이 자신을 향해 달려오는 모습을 본 듯했다.","style":3,"background":2391,"log_type":1},{"step":8,"speaker":"???","content":"…엘라… 엘라…","voice":["vo_event_404102502_9"],"voice_bank":"vo_event_41025","style":1,"background":2391,"log_type":1},{"step":9,"speaker":"히로","content":"엘라!!","voice":["vo_event_404102502_10"],"voice_bank":"vo_event_41025","style":1,"background":2391,"log_type":1}]}