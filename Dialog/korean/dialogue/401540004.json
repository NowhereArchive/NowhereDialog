{"id":401540004,"chapter_id":50045,"scene_id":45015,"steps":[{"step":1,"speaker":"에코","content":"~~~~","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":2,"speaker":"에코","content":"'헤진 천막은 온데간데없고.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":3,"speaker":"에코","content":"샐리","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":4,"speaker":"에코","content":"'스테이크에는 붉은 이슬이 맺혀야 하네.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":5,"speaker":"에코","content":"'금발의 여자는 나의 노래를 듣네.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":6,"speaker":"에코","content":"'그녀가 악의를 숨기든 말든.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":7,"speaker":"에코","content":"'은혜를 잊지 않으리.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":8,"speaker":"에코","content":"'새로운 망토와 황금빛 왕관.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":9,"speaker":"에코","content":"'새로운 왕이 우스갯소리를 하네.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":10,"speaker":"에코","content":"'그녀를 믿네, 그녀를 믿어.'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":11,"speaker":"에코","content":"'무엇과 맞바꾸리?'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":12,"speaker":"에코","content":"'그녀를 믿네, 그녀를… 믿나?'","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":13,"speaker":"에코","content":"'포르투나의 앞날에 재앙이 숨겨져 있네.'","style":1,"background":2173,"is_centered":true,"log_type":1}]}