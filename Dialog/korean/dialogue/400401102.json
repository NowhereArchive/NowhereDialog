{"id":400401102,"chapter_id":50016,"scene_id":51619,"steps":[{"step":1,"speaker":"어흥","content":"뭐야, 그런 이야기 아니거든! 감히 감독의 대본을 몰래 바꾸다니!","voice":["vo_event_400401102_1"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":2,"speaker":"린","content":"읏, 그렇지만… 넌 정말 무서운걸…","voice":["vo_event_400401102_2"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":3,"speaker":"어흥","content":"에휴… 됐어, 됐어. 특별히 나랑 함께 창작할 수 있도록 허락해 주지 뭐!","voice":["vo_event_400401102_3"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":4,"speaker":"어흥","content":"무서운 어흥 대마왕이어도 괜찮아. 하지만 이건 '용기'에 관한 이야기야.","voice":["vo_event_400401102_4"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":5,"speaker":"어흥","content":"앞으로 어떻게 이어 나갈 건데?","voice":["vo_event_400401102_5"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":6,"speaker":"린","content":"그게… 이건 어때?","voice":["vo_event_400401102_6"],"voice_bank":"vo_event_04011","style":1,"background":2040,"log_type":1},{"step":7,"speaker":"린","content":"이… 세계에… 요, 용기 사탕이라는 게 있는 거야!","voice":["vo_event_400401102_9"],"voice_bank":"vo_event_04011","style":1,"background":4038,"log_type":1},{"step":8,"speaker":"린","content":"용기 사탕을 먹으면 대마왕을 이길 수 있어!","voice":["vo_event_400401102_10"],"voice_bank":"vo_event_04011","style":1,"background":4038,"log_type":1}]}