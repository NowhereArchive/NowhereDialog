{"id":400400501,"chapter_id":50016,"scene_id":51635,"steps":[{"step":1,"speaker":"어흥","content":"……","voice":["vo_event_400400501_1"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":2,"speaker":"어흥","content":"바보 스크립터.","voice":["vo_event_400400501_2"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":3,"speaker":"${PlayerName}","content":"응?","style":2,"background":2048,"log_type":1},{"step":4,"speaker":"어흥","content":"네가 말한 괴수가 스텔라라는 걸 알아… 스텔라가 늘 말썽만 피워서, 그래서 미운 거야?","voice":["vo_event_400400501_4"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":5,"speaker":"${PlayerName}","content":"그게…","style":2,"background":2048,"log_type":1},{"step":6,"speaker":"어흥","content":"스텔라가 말도 안 듣고 장난이 심하다는 건 나도 알고 있어. 다 내가… 내가 스텔라를 잘 돌보지 못해서 그래.","voice":["vo_event_400400501_6"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":7,"content":"소녀는 잠시 생각했다.","style":3,"background":2048,"log_type":1},{"step":8,"speaker":"어흥","content":"그렇지만... 그렇지만! 스텔라는 아직 어리고 가족들과도 헤어졌잖아. 돌봐주는 사람이 없으면 더 통제하기 어려울 거야.","voice":["vo_event_400400501_8"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":9,"speaker":"어흥","content":"앞으로 어흥이가 스텔라의 가족이 되어 줄 거야. 어흥이가 스텔라와 함께하며 잘 가르치고 지켜줄 거야.","voice":["vo_event_400400501_9"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":10,"speaker":"스텔라","content":"뀨우…","voice":["vo_event_400400501_10"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":11,"speaker":"어흥","content":"어흥이가 약속할게. 스텔라는 절대 괴수가 되지 않을 거야. 그러니까 스텔라한테 화내지 마, 응? 알겠지?","voice":["vo_event_400400501_11"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":12,"speaker":"선택지","options":["알겠어","상황을 보고 결정할게"],"jump":[13,13],"style":6,"background":2048,"log_type":1},{"step":13,"speaker":"어흥","content":"고, 고마워! 더 이상 네게 장난치지 말라고 할게!","voice":["vo_event_400400501_14"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":14,"speaker":"어흥","content":"스텔라, 앞으로는 말썽 피우면 안 돼. 바보 스크립터 ${PlayerName} 귀찮게 하지 말고. 너랑 스크립터 모두 촬영팀의 일원이잖아. 친하게 지내야지.","voice":["vo_event_400400501_15"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":15,"speaker":"스텔라","content":"뀨우…","voice":["vo_event_400400501_16"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":16,"speaker":"어흥","content":"좋아, 스텔라가 너한테 사과했어. 그럼 어흥이는 이만 자러 갈게. 으~ 졸려!","voice":["vo_event_400400501_17"],"voice_bank":"vo_event_04005","style":1,"background":2048,"log_type":1},{"step":17,"content":"소녀는 졸려 하며 어린 마수를 안고 떠나갔다. 당신은 그 모습을 보며 과연 약속을 지킬 수 있을지 고민에 빠졌다.","style":3,"background":2048,"log_type":1}]}