{"id":400400402,"chapter_id":50016,"scene_id":51634,"steps":[{"step":1,"speaker":"${PlayerName}","content":"마침내 정의는 악을 물리쳤어. 슈퍼 라이언이 괴수를 처치하고 도시의 위험은 영원히 사라졌…","style":2,"background":4077,"log_type":1},{"step":2,"speaker":"어흥","content":"잠깐, 잠깐! 멈춰!","voice":["vo_event_400400402_3"],"voice_bank":"vo_event_04004","style":1,"background":4077,"log_type":1},{"step":3,"speaker":"어흥","content":"어떻게 그래? 받아들일 수 없어!","voice":["vo_event_400400402_4"],"voice_bank":"vo_event_04004","style":1,"background":4077,"log_type":1},{"step":4,"speaker":"어흥","content":"결말은 이런 식이어야지!","voice":["vo_event_400400402_5"],"voice_bank":"vo_event_04004","style":1,"background":4078,"log_type":1},{"step":5,"speaker":"어흥","content":"스타 비스트를 쓰러트린 후, 슈퍼 라이언은 또다시 괴수한테 손을 내밀었어.","voice":["vo_event_400400402_7"],"voice_bank":"vo_event_04004","style":1,"background":4078,"log_type":1},{"step":6,"speaker":"어흥","content":"'다시 나의 친구가 되어, 나와 함께 도시를 지키지 않을래?'","voice":["vo_event_400400402_8"],"voice_bank":"vo_event_04004","style":1,"background":4078,"log_type":1},{"step":7,"speaker":"스텔라","content":"뀨우! 뀨우!","voice":["vo_event_400400402_9"],"voice_bank":"vo_event_04004","style":1,"background":4078,"log_type":1},{"step":9,"speaker":"${PlayerName}","content":"하지만 진정한 결말은 슈퍼 라이언이 괴수를 처치하는 건데…","style":2,"background":2048,"log_type":1},{"step":10,"speaker":"어흥","content":"아냐, 아냐! 내가 말한 결말이 더 좋아! 슈퍼 라이언과 괴수는 여전히 친구라고!","voice":["vo_event_400400402_12"],"voice_bank":"vo_event_04004","style":1,"background":2048,"log_type":1},{"step":11,"speaker":"${PlayerName}","content":"아냐, 결말은…","style":2,"background":2048,"log_type":1},{"step":12,"content":"당신은 토라진 채 어린 마수를 안고 글썽이는 소녀의 모습을 보았다.","style":3,"background":2048,"log_type":1},{"step":13,"speaker":"${PlayerName}","content":"그래, 네 결말이 더 아름답긴 하지만… 그건 이룰 수 없어.","style":2,"background":2048,"log_type":1},{"step":14,"speaker":"${PlayerName}","content":"지금은 작고 귀여운 동물일지라도, 언젠가는 제어할 수 없는 거대한 괴수로 성장할 거야.","style":2,"background":2048,"log_type":1},{"step":15,"speaker":"${PlayerName}","content":"그때가 되면 돌이킬 수 없어.","style":2,"background":2048,"log_type":1},{"step":16,"content":"소녀는 침묵했다.","style":3,"background":2048,"log_type":1}]}