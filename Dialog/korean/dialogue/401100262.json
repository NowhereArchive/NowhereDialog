{"id":401100262,"chapter_id":50027,"scene_id":52713,"steps":[{"step":1,"speaker":"크리스티나","content":"쿨럭쿨럭… 오염 함정까지 준비해 놓았다니…","voice":["vo_event_401102602_1"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":2,"speaker":"크리스티나","content":"그래도 FAC 장갑차에 변이 억제 장치가 있어서 다행이야, 저장된 큐브가 다 소진되기 전에 나가야 해.","voice":["vo_event_401102602_2"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":3,"speaker":"크리스티나","content":"이 차가 어디로 향하는지도 모르는데, 좀 전에 시간을 너무 낭비했어, 더 서둘러야 해…","voice":["vo_event_401102602_3"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":4,"content":"크리스티나는 의식을 잃은 총사령관을 일으키려 애썼지만, 곧 총사령관의 몸에 복잡한 장치가 설치되어 있는 것을 발견했다.","style":3,"background":922,"log_type":1},{"step":5,"speaker":"크리스티나","content":"설마 이건… 오염 폭탄?","voice":["vo_event_401102602_5"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":6,"content":"그때 어둠 한구석에서 지직거리는 전파 잡음이 들려왔다.","style":3,"background":922,"log_type":1},{"step":7,"speaker":"크리스티나","content":"?!","voice":["vo_event_401102602_7"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":8,"speaker":"크리스티나","content":"차량… 무전기?","voice":["vo_event_401102602_8"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":9,"content":"무전기에서 익숙한 목소리가 들려왔다.","style":3,"background":922,"log_type":1},{"step":10,"speaker":"코쿠리코","content":"안녕, 꼬마 탐정님.","voice":["vo_event_401102602_10"],"voice_bank":"vo_event_11026","style":11,"background":922,"log_type":1}]}