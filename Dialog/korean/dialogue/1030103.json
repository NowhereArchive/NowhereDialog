{"id":1030103,"chapter_id":1030103,"scene_id":1,"steps":[{"step":1,"content":"이게 네 계획이야?","style":2,"background":10000,"log_type":1,"src_id":130103001,"trial_step":1},{"step":2,"content":"당신과 백은 통풍관 안에 엎드려 있었다. 통풍관 안은 좁고 갑갑했으며, 냄새도 고약했다.","style":3,"background":10000,"log_type":1,"src_id":130103002,"trial_step":2},{"step":3,"speaker":"백","content":"걱정하지 마, 난 예전에 늘 이렇게 했거든. 한 번도 실수한 적 없어.","voice":["vo_trial_30103_1_3"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103003,"trial_step":3},{"step":4,"content":"백의 얼굴이 가까이 다가오자, 자신만만해하는 표정이 그대로 보였다.","style":3,"background":10000,"log_type":1,"src_id":130103004,"trial_step":4},{"step":5,"content":"정말이지…?","style":2,"background":10000,"log_type":1,"src_id":130103005,"trial_step":5},{"step":6,"speaker":"백","content":"잠깐… 우웩… 으윽…","voice":["vo_trial_30103_1_6"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103006,"trial_step":6},{"step":7,"speaker":"백","content":"후, 위험했다.","voice":["vo_trial_30103_1_7"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103007,"trial_step":7},{"step":8,"speaker":"백","content":"…방금 뭐라고 했어?","voice":["vo_trial_30103_1_8"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103008,"trial_step":8},{"step":9,"content":"아무 말도.","style":2,"background":10000,"log_type":1,"src_id":130103009,"trial_step":9},{"step":10,"speaker":"백","content":"아, 그럼 계속 가볼까? 벌써 3층이니까 얼마 안 남았어.","voice":["vo_trial_30103_1_10"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103010,"trial_step":10},{"step":11,"content":"……","style":2,"background":10000,"log_type":1,"src_id":130103011,"trial_step":11},{"step":12,"content":"당신과 백은 계속해서 통풍관을 기어갔다. 통풍관 안은 끔찍했고 밑으로도 적들이 판을 쳤지만, 그나마 가장 나은 방법이었다.","style":3,"background":10000,"log_type":1,"src_id":130103012,"trial_step":12},{"step":13,"content":"공격을 가할 경우, 그에 뒤따를 손실을 예측할 수 없으며 더욱이 K.K.와 치이의 안전을 보장할 수 없다고 판단했다. 그러나 백의 능력을 사용하면, 구출에 실패한다고 해도 당신과 탈출하는 것은 어렵지 않을 것이었다.","style":3,"background":10000,"log_type":1,"src_id":130103013,"trial_step":13},{"step":14,"content":"하지만 지금 백의 모습을 보자니, 잘못된 선택을 했다는 생각을 거둘 수가 없었다.","style":3,"background":10000,"log_type":1,"src_id":130103014,"trial_step":14},{"step":15,"speaker":"경비A","content":"고약한 냄새가 나지 않아?","voice":["vo_trial_30103_1_15"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103015,"trial_step":15},{"step":16,"speaker":"경비B","content":"…그런 것 같기도 하고. **, 진짜 * 같네. 환풍기 좀 켜자.","voice":["vo_trial_30103_1_16"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103016,"trial_step":16},{"step":17,"speaker":"경비A","content":"그래.","voice":["vo_trial_30103_1_17"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103017,"trial_step":17},{"step":18,"speaker":"백","content":"웃기고 있네. 나한테서 무슨 고약한 냄새가 난다는 거야?","voice":["vo_trial_30103_1_18"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103018,"trial_step":18},{"step":19,"content":"백이 발끈하며 확인이라도 하려는 듯 당신에게 얼굴을 들이밀었다.","style":3,"background":10000,"log_type":1,"src_id":130103019,"trial_step":19},{"step":20,"options":["그녀를 밀쳐낸다"],"style":6,"background":10000,"log_type":1,"src_id":130103020,"trial_step":20,"course":3,"choices":[{"text":"그녀를 밀쳐낸다","goto":21}]},{"step":21,"content":"백의 얼굴을 밀쳐냈다. 그와 동시에 밑에 있던 경비가 환풍기를 켰는데, 이상한 소리와 함께 낡은 통풍 설비가 쉴 새 없이 덜컹거렸다.","style":3,"background":10000,"log_type":1,"src_id":130103021,"trial_step":21},{"step":22,"speaker":"경비B","content":"냄새가 더 심해진 것 같은데?","voice":["vo_trial_30103_1_22"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103022,"trial_step":22},{"step":23,"speaker":"경비A","content":"그러게… 좀 있으면 나아지겠지.","voice":["vo_trial_30103_1_23"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103023,"trial_step":23},{"step":24,"content":"시끄럽게 돌아가는 환풍기 덕에 오히려 움직임을 감출 수 있었다. 그렇게 당신 일행은 격렬한 진동을 견디며 전보다 훨씬 빠른 속도로 나아갔다.","style":3,"background":10000,"log_type":1,"src_id":130103024,"trial_step":24},{"step":25,"content":"한참을 엉금엉금 기어서 가는데, 백의 안색이 점점 안 좋아졌다.","style":3,"background":10000,"log_type":1,"src_id":130103025,"trial_step":25},{"step":26,"speaker":"백","content":"…국장…","voice":["vo_trial_30103_1_26"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103026,"trial_step":26},{"step":27,"content":"왜?","style":2,"background":10000,"log_type":1,"src_id":130103027,"trial_step":27},{"step":28,"speaker":"백","content":"내가 국장한테 토하면 싫겠지…?","voice":["vo_trial_30103_1_28"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103028,"trial_step":28},{"step":29,"content":"뭐라는 거야?!","style":2,"background":10000,"log_type":1,"src_id":130103029,"trial_step":29},{"step":30,"speaker":"백","content":"…더는 못 참겠어…","voice":["vo_trial_30103_1_30"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103030,"trial_step":30},{"step":31,"content":"당신이 미처 반응할 새도 없이 백이 통풍구를 걷어차고는 곧장 뛰어내렸다.","style":3,"background":10000,"log_type":1,"src_id":130103031,"trial_step":31},{"step":32,"content":"탁! 퍽!","style":3,"background":10000,"log_type":1,"src_id":130103032,"trial_step":32},{"step":33,"speaker":"백","content":"우웩…","voice":["vo_trial_30103_1_33"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103033,"trial_step":33},{"step":34,"content":"몇 초 뒤 당신이 통풍구 밖으로 고개를 내밀자, 백은 개운하다는 듯한 표정으로 당신을 향해 V자를 해 보였다.","style":3,"background":10000,"log_type":1,"src_id":130103034,"trial_step":34},{"step":35,"speaker":"백","content":"이제 괜찮아, 국장. 국장도 내려와.","voice":["vo_trial_30103_1_35"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130103035,"trial_step":35},{"step":36,"content":"괜찮기는! 너 지금 사람을 밟고 있잖아. 게다가 그 위에 토를 했다고!","style":2,"background":1038,"log_type":1,"src_id":130103036,"trial_step":36},{"step":37,"content":"잠깐, 아까 화장실에 있던 사람 아니야?","style":2,"background":1038,"log_type":1,"src_id":130103037,"trial_step":37},{"step":38,"speaker":"백","content":"음? 이 뚱뚱이를 알아?","voice":["vo_trial_30103_1_38"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103038,"trial_step":38},{"step":39,"content":"아는 건 아니고. 아까 우리 정체를 들통나게 한 게 이 사람이야.","style":2,"background":1038,"log_type":1,"src_id":130103039,"trial_step":39},{"step":40,"content":"당신도 통풍구에서 뛰어내렸다. 주변을 둘러보니 이곳은 인테리어가 잘 되어 있는 넓은 사무실이었다.","style":3,"background":1038,"log_type":1,"src_id":130103040,"trial_step":40},{"step":41,"speaker":"백","content":"이 뚱뚱이, 아무래도 보통 사람은 아닌 것 같은데? 혼자서 이 넓은 공간을 쓰다니.","voice":["vo_trial_30103_1_41"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103041,"trial_step":41},{"step":42,"speaker":"백","content":"착지하자마자 기절시켜서 다행이야.","voice":["vo_trial_30103_1_42"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103042,"trial_step":42},{"step":43,"content":"맞아, 잘했어. 이 사람 목청이 아주 우렁차거든.","style":2,"background":1038,"log_type":1,"src_id":130103043,"trial_step":43},{"step":44,"content":"이제 어쩔 생각이지?","style":2,"background":1038,"log_type":1,"src_id":130103044,"trial_step":44},{"step":45,"speaker":"백","content":"높으신 분을 어렵게 잡았잖아? 어쩌면 이자가 치이랑 K.K.가 어디에 있는지 알지도 몰라.","voice":["vo_trial_30103_1_45"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103045,"trial_step":45},{"step":46,"speaker":"백","content":"통풍관을 더는 기어 다니고 싶지도 않고. 너무 끔찍하단 말이야.","voice":["vo_trial_30103_1_46"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103046,"trial_step":46},{"step":47,"content":"네가 그렇게 하자고 한 거잖아…","style":2,"background":1038,"log_type":1,"src_id":130103047,"trial_step":47},{"step":48,"speaker":"백","content":"하하.","voice":["vo_trial_30103_1_48"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103048,"trial_step":48},{"step":49,"speaker":"백","content":"엇, 이것 좀 봐. 이 뚱뚱이 돈이 좀 많은가 본데? 명함집에 금칠이 되어 있어.","voice":["vo_trial_30103_1_49"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103049,"trial_step":49},{"step":50,"content":"백은 사무 책상 위에 놓인 사치스러운 명함집을 집어 들고는 화제를 돌렸다.","style":3,"background":1038,"log_type":1,"src_id":130103050,"trial_step":50},{"step":51,"content":"거래한 자들에 대한 정보가 있을 거야. 열어보자.","style":2,"background":1038,"log_type":1,"src_id":130103051,"trial_step":51},{"step":52,"options":["안에 있는 명함을 살펴본다"],"style":6,"background":1038,"log_type":1,"src_id":130103052,"trial_step":52,"course":3,"choices":[{"text":"안에 있는 명함을 살펴본다","goto":54}]},{"step":53,"content":"명함집을 열어 안에 든 명함들을 꺼낸 백은 이내 금칠이 된 명함집을 아무렇지도 않게 허리춤에 찬 주머니에 집어넣었다.","style":3,"background":1038,"log_type":1,"src_id":130103053,"trial_step":53},{"step":54,"speaker":"백","content":"늑대 형님… 모르는 사람이야. 우사미 타츠야라, 이름만 봐서는 야나기 잔당 같은데…","voice":["vo_trial_30103_1_54"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103054,"trial_step":54},{"step":55,"speaker":"백","content":"백…?!","voice":["vo_trial_30103_1_55"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103055,"trial_step":55},{"step":56,"content":"계속 뒤적거리던 백은 뒤에 있는 명함 가득 인쇄되어 있는 자신의 이름을 발견했다.","style":3,"background":1038,"log_type":1,"src_id":130103056,"trial_step":56},{"step":57,"speaker":"백","content":"너였구나…!?","voice":["vo_trial_30103_1_57"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103057,"trial_step":57},{"step":58,"content":"백은 천천히 몸을 돌려 정신을 잃은 뚱뚱이를 죽일 듯 노려봤다.","style":3,"background":1038,"log_type":1,"src_id":130103058,"trial_step":58},{"step":59,"speaker":"백","content":"날 사칭하고… 치이랑 K.K.를 붙잡은 게 바로 네놈이란 말이지…","voice":["vo_trial_30103_1_59"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103059,"trial_step":59},{"step":60,"content":"팟!","style":1,"background":1038,"log_type":1,"src_id":130103060,"trial_step":60},{"step":61,"speaker":"'백 사장'","content":"악!","voice":["vo_trial_30103_1_61"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103061,"trial_step":61},{"step":62,"content":"백은 손바닥으로 사칭범의 뺨을 인정사정없이 내리쳤다.","style":3,"background":1038,"log_type":1,"src_id":130103062,"trial_step":62},{"step":63,"content":"그러자 '백 사장'이 천천히 정신을 차렸다.","style":3,"background":1038,"log_type":1,"src_id":130103063,"trial_step":63},{"step":64,"speaker":"백","content":"소리 지르지 마! 소리 질렀다간 네 지방을 개밥으로 만들어버릴 테니까.","voice":["vo_trial_30103_1_64"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103064,"trial_step":64},{"step":65,"speaker":"'백 사장'","content":"우웁! 우우웁!","voice":["vo_trial_30103_1_65"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103065,"trial_step":65},{"step":66,"content":"백은 재빨리 테이프로 '백 사장'의 입을 막고 우악스럽게 그를 의자에 묶었다.","style":3,"background":1038,"log_type":1,"src_id":130103066,"trial_step":66},{"step":67,"content":"작업을 끝낸 백은 험상궂은 표정을 지으며 단도를 꺼낸 뒤, '백 사장'의 목에 가져다 댔다.","style":3,"background":1038,"log_type":1,"src_id":130103067,"trial_step":67},{"step":68,"speaker":"백","content":"말해, 그 두 녀석을 어디에 가둬놨지?","voice":["vo_trial_30103_1_68"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103068,"trial_step":68},{"step":69,"speaker":"'백 사장'","content":"우우웁…","voice":["vo_trial_30103_1_69"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103069,"trial_step":69},{"step":70,"content":"입이 막혀 있잖아.","style":2,"background":1038,"log_type":1,"src_id":130103070,"trial_step":70},{"step":71,"speaker":"백","content":"아… 확실히 잡아두려다가.","voice":["vo_trial_30103_1_71"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103071,"trial_step":71},{"step":72,"speaker":"백","content":"크흠… '백 사장' 맞지? 내가 이제 몇 가지 질문을 할 거야. 그러니 바른대로 대답해야 한다?","voice":["vo_trial_30103_1_72"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103072,"trial_step":72},{"step":73,"speaker":"백","content":"난 낮에 있었던 그 두 녀석이랑은 달라. 게다가 오늘은 내가 머리도 좀 아프고, 기분도 좀 안 좋거든. 그래서 제대로 협조해주지 않으면 내가 널 어떻게 해버릴지도 몰라.","voice":["vo_trial_30103_1_73"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103073,"trial_step":73},{"step":74,"speaker":"백","content":"밖에 있는 사람들이 널 따라다닌 지 얼마 안 됐지?","voice":["vo_trial_30103_1_74"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103074,"trial_step":74},{"step":75,"speaker":"백","content":"저들은 우리가 경찰이라는 걸 알아. 저들이 들어왔을 때 내가 널 방패로 삼는다면 저들이 총을 쏠까, 안 쏠까?","voice":["vo_trial_30103_1_75"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103075,"trial_step":75},{"step":76,"speaker":"'백 사장'","content":"우우웁!","voice":["vo_trial_30103_1_76"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103076,"trial_step":76},{"step":77,"speaker":"백","content":"그러니까 협조하는 게 좋을 거야. 수작 부릴 생각 말고. 알겠어?","voice":["vo_trial_30103_1_77"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103077,"trial_step":77},{"step":78,"speaker":"'백 사장'","content":"웁웁.","voice":["vo_trial_30103_1_78"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103078,"trial_step":78},{"step":79,"content":"백은 그의 입을 막고 있던 테이프를 떼어내더니 그를 바닥에서 번쩍 들어 올렸다.","style":3,"background":1038,"log_type":1,"src_id":130103079,"trial_step":79},{"step":80,"speaker":"'백 사장'","content":"왜 또 너냐고… 내가 너희를 건드렸니…","voice":["vo_trial_30103_1_80"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103080,"trial_step":80},{"step":81,"content":"'백 사장'이 원망스럽다는 표정으로 당신을 바라봤다.","style":3,"background":1038,"log_type":1,"src_id":130103081,"trial_step":81},{"step":82,"speaker":"백","content":"쓸데없는 소리는 집어치우고, 낮에 있던 그 두 녀석 어디에 가둬놨지?","voice":["vo_trial_30103_1_82"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103082,"trial_step":82},{"step":83,"speaker":"'백 사장'","content":"접견실.","voice":["vo_trial_30103_1_83"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103083,"trial_step":83},{"step":84,"speaker":"백","content":"사실대로 말 안 하네?","voice":["vo_trial_30103_1_84"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103084,"trial_step":84},{"step":85,"content":"백이 '백 사장'의 정강이를 걷어찼다. 그는 고통에 차 온몸을 부르르 떨었지만 감히 소리를 내진 못했다.","style":3,"background":1038,"log_type":1,"src_id":130103085,"trial_step":85},{"step":86,"speaker":"'백 사장'","content":"진짜야! 당신, 아까 도망쳤잖아. 난 경찰들이 와서 보복할까 봐 그 둘은 건드리지도 않았다고.","voice":["vo_trial_30103_1_86"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103086,"trial_step":86},{"step":87,"speaker":"'백 사장'","content":"게다가 난 그냥 사업이나 하는 사람인데 사람을 가둬놓을 데가 어디 있겠어. 평소에 사람 없는 접견실 밖에 둘 데가 없지…","voice":["vo_trial_30103_1_87"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103087,"trial_step":87},{"step":88,"speaker":"백","content":"…흠.","voice":["vo_trial_30103_1_88"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103088,"trial_step":88},{"step":89,"content":"눈을 뜨자 활짝 핀 장미꽃이 보였다. 새빨갛게 물든 이곳을 바라보며 당신은 자신이 지금 몽경 속에 있다는 걸 확신했다.","style":3,"background":1038,"log_type":1,"src_id":130103089,"trial_step":89},{"step":90,"content":"우선 진정해. 내가 몇 가지만 더 물어볼게.","style":2,"background":1038,"log_type":1,"src_id":130103090,"trial_step":90},{"step":91,"speaker":"'백 사장'","content":"다 물어봐. 난 절대로 숨기는 거 없어.","voice":["vo_trial_30103_1_91"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103091,"trial_step":91},{"step":92,"content":"당신, 어디에서 온 거지?","style":2,"background":1038,"log_type":1,"src_id":130103092,"trial_step":92},{"step":93,"speaker":"'백 사장'","content":"신성.","voice":["vo_trial_30103_1_93"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103093,"trial_step":93},{"step":94,"speaker":"백","content":"신성 사람이 신디케이트까지 와서 사업을 한다고? 미쳤냐?","voice":["vo_trial_30103_1_94"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103094,"trial_step":94},{"step":95,"speaker":"'백 사장'","content":"신성에서 하던 사업이 망했잖아… 그런데 마침 어떤 호구가 돈을 주면서 희귀한 자원이 있다고 하지 뭐야.","voice":["vo_trial_30103_1_95"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103095,"trial_step":95},{"step":96,"speaker":"'백 사장'","content":"거기서 빚쟁이한테 시달리고 있던 터라, 눈 딱 감고 그냥 와버렸지.","voice":["vo_trial_30103_1_96"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103096,"trial_step":96},{"step":97,"speaker":"백","content":"호구? 그 사람의 목적은 뭔데?","voice":["vo_trial_30103_1_97"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103097,"trial_step":97},{"step":98,"speaker":"'백 사장'","content":"그걸 내가 어떻게 알아? 그 사람은 신비롭게 얼굴도 보여준 적이 없다고.","voice":["vo_trial_30103_1_98"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103098,"trial_step":98},{"step":99,"speaker":"'백 사장'","content":"아, 그런데 그 사람이 조건을 하나 내걸었어. 내가 설립하는 회사 이름이 반드시 백기실업이어야 한다고 하더군. 다른 건 내가 알아서 해도 된다면서.","voice":["vo_trial_30103_1_99"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103099,"trial_step":99},{"step":100,"speaker":"백","content":"……?","voice":["vo_trial_30103_1_100"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103100,"trial_step":100},{"step":101,"speaker":"'백 사장'","content":"나도 눈치가 없진 않아. 그 백기라는 데를 알아봤어. 그런데 결과가 어땠는지 알아? 유령회사더라고, 사람도 얼마 없는.","voice":["vo_trial_30103_1_101"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103101,"trial_step":101},{"step":102,"speaker":"'백 사장'","content":"외부에서는 그자들이 군단과 관계가 있다고 하는데, 정말인 것처럼 허풍을 떤 거였지 뭐야. 그런데 최근에 군단이 무너지고, 백기도 종적을 감췄지.","voice":["vo_trial_30103_1_102"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103102,"trial_step":102},{"step":103,"content":"그래서 마음 놓고 사칭을 했다?","style":2,"background":1038,"log_type":1,"src_id":130103103,"trial_step":103},{"step":104,"speaker":"'백 사장'","content":"당연하지. 눈앞에 이득이 있는데 두고만 보면 그게 바보지 뭐야.","voice":["vo_trial_30103_1_104"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103104,"trial_step":104},{"step":105,"content":"보복당할 수도 있다는 생각은 안 해봤나?","style":2,"background":1038,"log_type":1,"src_id":130103105,"trial_step":105},{"step":106,"speaker":"'백 사장'","content":"보복은 무슨, 고작 그 몇 명 가지고 뭘 할 수 있겠어. 게다가 그 백기는 등록한 정보도 전부 거짓이던데.","voice":["vo_trial_30103_1_106"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103106,"trial_step":106},{"step":107,"speaker":"'백 사장'","content":"나도 성이 백이야. 그 사람은 백기실업이라고 해도 되는데, 나라고 안 될 이유가 있나?","voice":["vo_trial_30103_1_107"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103107,"trial_step":107},{"step":108,"speaker":"백","content":"……","voice":["vo_trial_30103_1_108"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103108,"trial_step":108},{"step":109,"speaker":"백","content":"……","voice":["vo_trial_30103_1_109"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103109,"trial_step":109},{"step":110,"content":"백의 입꼬리가 부자연스럽게 올라가며, 미소라고 부를 수 없는 미소를 지었다.","style":3,"background":1038,"log_type":1,"src_id":130103110,"trial_step":110},{"step":111,"speaker":"백","content":"여기 잘 봐.","voice":["vo_trial_30103_1_111"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103111,"trial_step":111},{"step":112,"content":"백이 손을 들었다.","style":3,"background":1038,"log_type":1,"src_id":130103112,"trial_step":112},{"step":113,"speaker":"'백 사장'","content":"뭔데?","voice":["vo_trial_30103_1_113"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103113,"trial_step":113},{"step":114,"content":"백이 주먹을 쥐어 보였다.","style":3,"background":1038,"log_type":1,"src_id":130103114,"trial_step":114},{"step":115,"content":"퍽!","style":1,"background":1038,"log_type":1,"src_id":130103115,"trial_step":115},{"step":116,"content":"그 순간, '백 사장'의 얼굴에 백의 주먹이 곧장 내리꽂혔다. 그의 뚱뚱한 몸이 의자와 함께 넘어갔고, 그대로 또다시 정신을 잃고 말았다.","style":3,"background":1038,"log_type":1,"src_id":130103116,"trial_step":116},{"step":117,"content":"당신은 앞으로 다가가 정신을 잃은 '백 사장'의 입에 다시 테이프를 붙였다.","style":3,"background":1038,"log_type":1,"src_id":130103117,"trial_step":117},{"step":118,"speaker":"백","content":"후…","voice":["vo_trial_30103_1_118"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103118,"trial_step":118},{"step":119,"content":"백이 매섭게 숨을 내쉬었다.","style":3,"background":1038,"log_type":1,"src_id":130103119,"trial_step":119},{"step":120,"speaker":"백","content":"자, 치이랑 K.K.를 구하러 가자.","voice":["vo_trial_30103_1_120"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103120,"trial_step":120},{"step":121,"content":"계획은 있고? 건물에 있는 경비들이 내 얼굴을 봐서, 건물 안에서 이동하는 게 쉽지 않아.","style":2,"background":1038,"log_type":1,"src_id":130103121,"trial_step":121},{"step":122,"speaker":"백","content":"흐음…","voice":["vo_trial_30103_1_122"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103122,"trial_step":122},{"step":123,"content":"주변을 둘러보던 백이 사무실 구석에서 청소 카트 한 대를 발견했다.","style":3,"background":1038,"log_type":1,"src_id":130103123,"trial_step":123},{"step":124,"speaker":"백","content":"좋은 생각이 있어!","voice":["vo_trial_30103_1_124"],"voice_bank":"vo_linglan_trial","style":1,"background":1038,"log_type":1,"src_id":130103124,"trial_step":124},{"step":125,"content":"…","style":2,"background":1038,"log_type":1,"src_id":130103125,"trial_step":125},{"step":126,"content":"백이 청소 카트를 밀고 성큼성큼 걸어가며 감탄했다. 당신은 청소 카트 아래의 천 자락 안에 숨어 있었다.","style":3,"background":120,"log_type":1,"src_id":130103126,"trial_step":126},{"step":127,"speaker":"백","content":"네가 골격이 작아서 다행이야. 다른 사람이었으면 못 들어갔을걸.","voice":["vo_trial_30103_1_128"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103127,"trial_step":127},{"step":128,"content":"…","style":2,"background":120,"log_type":1,"src_id":130103128,"trial_step":128},{"step":129,"speaker":"백","content":"아, 거기 도착해도 나오지 말고 그대로 있어. 내가 안에 있는 경비를 다 해치울 테니까. 그런 다음에 우리 넷이 다시 입구 쪽으로 가는 거야.","voice":["vo_trial_30103_1_130"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103129,"trial_step":129},{"step":130,"speaker":"백","content":"내가 있는 한 분명히 빠져나갈 수 있어.","voice":["vo_trial_30103_1_131"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103130,"trial_step":130},{"step":131,"content":"그래, 내가 행동대에 연락해뒀어. 건물만 빠져나가면 곧바로 우리를 지원해줄 거야.","style":2,"background":120,"log_type":1,"src_id":130103131,"trial_step":131},{"step":132,"content":"앞에 복도에서 오른쪽으로 꺾으면 바로 접견실이야.","style":2,"background":120,"log_type":1,"src_id":130103132,"trial_step":132},{"step":133,"content":"당신의 안내에 따라 청소 카트를 끌며 나아가던 백은 곧 접견실 문 앞에 다다랐다.","style":3,"background":120,"log_type":1,"src_id":130103133,"trial_step":133},{"step":134,"speaker":"경비","content":"거기 서.","voice":["vo_trial_30103_1_135"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103134,"trial_step":134},{"step":135,"speaker":"경비","content":"처음 보는 얼굴인데, 새로 왔나?","voice":["vo_trial_30103_1_136"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103135,"trial_step":135},{"step":136,"speaker":"백","content":"크흠, 네.","voice":["vo_trial_30103_1_137"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103136,"trial_step":136},{"step":137,"speaker":"경비","content":"이 시간에 웬 청소지?","voice":["vo_trial_30103_1_138"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103137,"trial_step":137},{"step":138,"speaker":"백","content":"백 사장님께서 지시하셔서요…","voice":["vo_trial_30103_1_139"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103138,"trial_step":138},{"step":139,"speaker":"경비","content":"백기가 다 망해가는데 뭐 하러 그 사람 말을 듣고 있는 거야.","voice":["vo_trial_30103_1_140"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103139,"trial_step":139},{"step":140,"speaker":"경비","content":"됐다, 내가 신입이랑 무슨 말을 하겠어… 들어가.","voice":["vo_trial_30103_1_141"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103140,"trial_step":140},{"step":141,"speaker":"백","content":"응","voice":["vo_trial_30103_1_142"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103141,"trial_step":141},{"step":142,"content":"펑!","style":1,"background":120,"log_type":1,"src_id":130103142,"trial_step":142},{"step":143,"content":"갑작스러운 소리에 결국 참지 못하고 천 자락 뒤로 고개를 빼보니, 경비가 이미 바닥에 쓰러져 있었다.","style":3,"background":120,"log_type":1,"src_id":130103143,"trial_step":143},{"step":144,"content":"뭐 하는 거야?","style":2,"background":120,"log_type":1,"src_id":130103144,"trial_step":144},{"step":145,"speaker":"백","content":"백기가 망했다고 했잖아. 화가 나서 그만…","voice":["vo_trial_30103_1_146"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103145,"trial_step":145},{"step":146,"speaker":"백","content":"아니다, 일 처리를 미리 한 셈이지? 지금 한 명을 해치웠으니 도망칠 때 처치할 사람이 하나 줄었잖아.","voice":["vo_trial_30103_1_147"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103146,"trial_step":146},{"step":147,"content":"…이 사람을 처리하자. 들키지 않게.","style":2,"background":120,"log_type":1,"src_id":130103147,"trial_step":147},{"step":148,"content":"백에게 따지고 들 시간이 없었다. 당신과 백은 정신을 잃은 경비를 쓰레기통에 던져넣은 뒤 접견실 문 앞으로 돌아왔다.","style":3,"background":120,"log_type":1,"src_id":130103148,"trial_step":148},{"step":149,"content":"접견실 문 너머로 목소리가 들려왔다.","style":3,"background":120,"log_type":1,"src_id":130103149,"trial_step":149},{"step":150,"speaker":"경비A","content":"앗싸! 이겼다!","voice":["vo_trial_30103_1_151"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103150,"trial_step":150},{"step":151,"speaker":"치이","content":"에이… 제가 이길 줄 알았는데.","voice":["vo_trial_30103_1_152"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103151,"trial_step":151},{"step":152,"speaker":"경비A","content":"이 녀석 어리긴 해도… 포커 치는 솜씨가 제법이란 말이야? 네가 경찰만 아니었어도 계속 같이하는 건데.","voice":["vo_trial_30103_1_153"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103152,"trial_step":152},{"step":153,"speaker":"치이","content":"아이고, 저 경찰 아니라니까요. 저도 협박받아서 그랬던 거라고요…","voice":["vo_trial_30103_1_154"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103153,"trial_step":153},{"step":154,"speaker":"경비A","content":"알 게 뭐야. 어쨌거나 난 이번 주 급여만 받으면 이쪽 일은 더 안 할 거야. 그러니 정말 경찰이 아니라면 자주 오라고.","voice":["vo_trial_30103_1_155"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103154,"trial_step":154},{"step":155,"speaker":"치이","content":"좋아요, 다음에는 제가 꼭 이길 겁니다.","voice":["vo_trial_30103_1_156"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103155,"trial_step":155},{"step":156,"content":"다들 꽤 안전해 보이는데?","style":2,"background":120,"log_type":1,"src_id":130103156,"trial_step":156},{"step":157,"speaker":"백","content":"치이는 항상 저래. 어디를 가든 잘 어울리지…","voice":["vo_trial_30103_1_158"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103157,"trial_step":157},{"step":158,"speaker":"백","content":"잠깐, 저 녀석들이 좀 전에 뭐라고 했더라? 이제 곧 해산하려는 건가?","voice":["vo_trial_30103_1_159"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103158,"trial_step":158},{"step":159,"content":"그게 사실이라면 당장 공격하는 건 좋은 생각이 아니야.","style":2,"background":120,"log_type":1,"src_id":130103159,"trial_step":159},{"step":160,"content":"우선 섣불리 움직이지 마. 작전 부서 사람들에게는 계속 대기하라고 할게.","style":2,"background":120,"log_type":1,"src_id":130103160,"trial_step":160},{"step":161,"content":"작전 부서에 메시지를 보내려고 단말기를 켜는 순간, 실수로 다른 아이콘을 건드리고 말았다…","style":3,"background":120,"log_type":1,"src_id":130103161,"trial_step":161},{"step":162,"speaker":"광고 멘트","content":"러스트 리버 밀입국 1회에 10만! 인원 충족 시 출발합니다!","voice":["vo_trial_30103_1_163"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103162,"trial_step":162},{"step":163,"content":"광고 멘트에 귀청이 울리는 신디케이트 특유의 촌스러운 음악이 더해져, 하마터면 간이 떨어질 뻔했다.","style":3,"background":120,"log_type":1,"src_id":130103163,"trial_step":163},{"step":164,"content":"의심할 것도 없이, 어제 백이 당신을 속여 깔게 한 악성 어플이었다.","style":3,"background":120,"log_type":1,"src_id":130103164,"trial_step":164},{"step":165,"speaker":"경비A","content":"밖에 누구지?! 제이슨! 어디 갔어?","voice":["vo_trial_30103_1_166"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103165,"trial_step":165},{"step":166,"speaker":"백","content":"너 뭐 해!","voice":["vo_trial_30103_1_167"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103166,"trial_step":166},{"step":167,"content":"지금 내 탓 하는 거야?","style":2,"background":120,"log_type":1,"src_id":130103167,"trial_step":167},{"step":168,"speaker":"백","content":"아니, 그 어플 깔고 안 지웠어?","voice":["vo_trial_30103_1_169"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103168,"trial_step":168},{"step":169,"content":"…","style":2,"background":120,"log_type":1,"src_id":130103169,"trial_step":169},{"step":170,"content":"당신은 이 어플을 조사하면 중요한 정보가 나오지 않을까 싶어서 지우지 않았다는 걸 그녀에게 알리고 싶지 않았다.","style":3,"background":120,"log_type":1,"src_id":130103170,"trial_step":170},{"step":171,"speaker":"백","content":"…됐다. 지금은 말해봤자 늦었으니까 바로 시작하자고!","voice":["vo_trial_30103_1_172"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103171,"trial_step":171},{"step":172,"speaker":"백","content":"흐아!","voice":["vo_trial_30103_1_173"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103172,"trial_step":172},{"step":173,"content":"탕!","style":1,"background":120,"log_type":1,"src_id":130103173,"trial_step":173},{"step":174,"content":"접견실 문을 걷어찬 백은 가장 가까이에 있는 경비 둘을 칼로 내리쳤다.","style":3,"background":1045,"log_type":1,"src_id":130103174,"trial_step":174},{"step":175,"content":"접견실에는 치이와 K.K.까지 해서 열 명 남짓한 인원이 있었는데, 다들 화들짝 놀라 어리둥절한 얼굴로 백을 쳐다봤다.","style":3,"background":1045,"log_type":1,"src_id":130103175,"trial_step":175},{"step":176,"speaker":"백","content":"멍하니 뭐 하는 거야? 움직이라고!","voice":["vo_trial_30103_1_177"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130103176,"trial_step":176},{"step":177,"content":"멀지 않은 곳에 있던 치이가 가장 먼저 움직였다. 그는 경비가 정신을 못 차리고 있는 틈을 타, 조금 전까지 같이 포커를 치자고 약속했던 사람의 얼굴에 주먹을 내리꽂았다. 그리고는 그자가 가지고 있던 무기를 뺏어 들었다.","style":3,"background":1045,"log_type":1,"src_id":130103177,"trial_step":177},{"step":178,"content":"당신은 구석에 있는 K.K.에게 재빨리 다가가 묶여 있는 밧줄을 풀어주었다.","style":3,"background":1045,"log_type":1,"src_id":130103178,"trial_step":178},{"step":179,"speaker":"K.K.","content":"감사합니다…","voice":["vo_trial_30103_1_180"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130103179,"trial_step":179},{"step":180,"speaker":"백","content":"오글거리게 그러고 있지 말고, 어서 도망쳐!","voice":["vo_trial_30103_1_181"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130103180,"trial_step":180},{"step":181,"content":"일행 네 명은 주저 없이 아래층을 향해 달려 나갔다.","style":3,"background":10000,"log_type":1,"src_id":130103181,"trial_step":181},{"step":182,"content":"이번 탈출은 이상하리만큼 순조로웠다. 도망치는 동안 당신 일행을 막는 이가 없었기에, 금세 입구에 다다를 수 있었다.","style":3,"background":10000,"log_type":1,"src_id":130103182,"trial_step":182},{"step":183,"content":"K.K.가 길가에 있는 봉고차의 유리창을 깨부쉈고, 치이가 뛰어 들어가 시동을 걸었다.","style":3,"background":10000,"log_type":1,"src_id":130103183,"trial_step":183},{"step":184,"speaker":"백","content":"내가 운전할게!","voice":["vo_trial_30103_1_185"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103184,"trial_step":184},{"step":185,"content":"백이 운전석에 앉자 엔진이 괴성을 질렀다. 경련을 일으키듯 몇 번 떨리던 차량은 엄청난 속도로 건물 주차장을 빠져나갔다.","style":3,"background":1031,"log_type":1,"src_id":130103185,"trial_step":185},{"step":186,"speaker":"백","content":"하, 너무 쉽잖아. 대체 어쩌다가 저놈들한테 붙잡힌 거야? 쪽팔리지도 않냐?","voice":["vo_trial_30103_1_187"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103186,"trial_step":186},{"step":187,"speaker":"K.K.","content":"…저 사람들, 우리를 막을 생각도 없었어.","voice":["vo_trial_30103_1_188"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103187,"trial_step":187},{"step":188,"speaker":"치이","content":"본인들 사장도 꽁무니를 빼려고 하는데, 굳이 목숨 걸고 우리랑 싸울 이유가 없겠지…","voice":["vo_trial_30103_1_189"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103188,"trial_step":188},{"step":189,"content":"어쨌든 다들 빠져나왔으니 그렇게 하나하나 따지고 들 필요 없어.","style":2,"background":1031,"log_type":1,"src_id":130103189,"trial_step":189},{"step":190,"speaker":"백","content":"맞는 말이야. 그럼 오늘 밤에 축하 파티나 할까?","voice":["vo_trial_30103_1_191"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103190,"trial_step":190},{"step":191,"speaker":"치이","content":"좋지.","voice":["vo_trial_30103_1_192"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103191,"trial_step":191},{"step":192,"speaker":"K.K.","content":"둘 다 조용히 해.","voice":["vo_trial_30103_1_193"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103192,"trial_step":192},{"step":193,"content":"백이 평소답지 않게 기가 죽었다.","style":3,"background":1031,"log_type":1,"src_id":130103193,"trial_step":193},{"step":194,"speaker":"백","content":"싫으면 그냥 싫다고 하면 되지, 뭘 그렇게 무섭게 구냐…","voice":["vo_trial_30103_1_195"],"voice_bank":"vo_linglan_trial","style":1,"background":1031,"log_type":1,"src_id":130103194,"trial_step":194}]}