{"id":2052,"chapter_id":2,"scene_id":205,"steps":[{"step":1,"speaker":"엘라","content":"이 녀석들, 별로 강하지는 않은데 진짜 끝이 없네.","voice":["vo_cgplot_2052001"],"voice_bank":"vo_cgplot_02","style":1,"background":122,"log_type":1},{"step":2,"speaker":"아이언","content":"시간을 끄는 거야.","voice":["vo_cgplot_2052002"],"voice_bank":"vo_cgplot_02","style":1,"background":122,"log_type":1},{"step":3,"content":"그때 한 무리의 갱단이 몰래 이동하는 것을 예리하게 포착해냈다. 양동작전이었다. 그들은 멀리 돌아 습격하려고 했는데, 그중 실루엣 하나가 아주 익숙했다.","style":3,"background":122,"log_type":1},{"step":4,"speaker":"선택지","options":["내가 막으러 갈게"],"jump":[5],"style":6,"background":122,"log_type":1},{"step":5,"content":"당신은 아이언의 대답을 기다리지 않고 수감자를 데리고 빠르게 이동해, 병원 옆 골목길에서 적의 기습을 저지했다.","style":3,"background":1029,"log_type":1},{"step":6,"speaker":"테드","content":"하하, 역시 국장이라면 내 의도를 알아차릴 줄 알았다.","voice":["vo_cgplot_2052006"],"voice_bank":"vo_cgplot_02","style":1,"background":1029,"log_type":1},{"step":7,"speaker":"테드","content":"구하러 왔어, 국장.","voice":["vo_cgplot_2052007","vo_cgplot_2052007f"],"voice_bank":"vo_cgplot_02","style":1,"background":1029,"log_type":1}]}