{"id":4112,"chapter_id":4,"scene_id":412,"steps":[{"step":1,"speaker":"히로","content":"으윽!!","voice":["vo_cgplot_4112001"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":2,"content":"불결의 화신이 사라지고 히로는 드디어 그림자를 떨쳐냈다. 그녀는 탈진해 조야의 품에서 정신을 잃었다.","style":3,"background":405,"log_type":1},{"step":3,"options":["괜찮아?"],"jump":[4],"style":6,"background":405,"log_type":1},{"step":4,"speaker":"조야","content":"히로는 이겨낼 수 있어, 이보다 백배 더한 고통도 이겨냈어.","voice":["vo_cgplot_4112004"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":5,"speaker":"조야","content":"돌아올 거야, 누군가가 돌아오길 기다리는 걸 아니까.","voice":["vo_cgplot_4112005"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":6,"speaker":"조야","content":"이제, 저것 차례야…","voice":["vo_cgplot_4112006"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":7,"content":"조야는 일어나 열려있는 제단을 바라봤다.","style":3,"background":405,"log_type":1}]}