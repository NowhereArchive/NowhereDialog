{"id":1060202,"chapter_id":1060202,"scene_id":1,"steps":[{"step":1,"content":"며칠 만에 당신과 엔퍼는 다시 벨페고르 미술관에 들어섰다.","style":3,"background":2038,"log_type":1,"src_id":160202001,"trial_step":1},{"step":2,"content":"햇빛이 유리창을 뚫고 난장판이 된 미술관을 환히 비췄고, 먼지와 부스러기는 광원을 찾지 못한 나방처럼 공기 중을 떠돌았다.","style":3,"background":2038,"log_type":1,"src_id":160202002,"trial_step":2},{"step":3,"speaker":"엔퍼","content":"진짜 완전히 부서졌네요.","voice":["vo_trial_60202_1_1"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202003,"trial_step":3},{"step":4,"content":"환각과도 같던 '마법'은 없어졌지만, 당신은 이곳이 소시아를 전시하던 전시홀이라는 걸 알 수 있었다.","style":3,"background":2038,"log_type":1,"src_id":160202004,"trial_step":4},{"step":5,"content":"다만 소시아뿐만 아니라 전시홀의 모든 예술품이 모두 산산조각 나 있었다.","style":3,"background":2038,"log_type":1,"src_id":160202005,"trial_step":5},{"step":6,"content":"이 전시홀에 전시된 작품은 자신의 성장 궤적과도 같다고 했던 엔퍼의 말이 어렴풋이 기억이 났다.","style":3,"background":2038,"log_type":1,"src_id":160202006,"trial_step":6},{"step":7,"content":"마지막에 여기로 와도 되는데…","style":2,"background":2038,"log_type":1,"src_id":160202007,"trial_step":7},{"step":8,"speaker":"엔퍼","content":"상관없어요. 전 국장님이 생각하는 것만큼 연약하지 않아요.","voice":["vo_trial_60202_1_2"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202008,"trial_step":8},{"step":9,"speaker":"엔퍼","content":"'마음은 슬픔조차 다스리는 법.'","voice":["vo_trial_60202_1_3"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202009,"trial_step":9},{"step":10,"speaker":"엔퍼","content":"국장님도 보셨잖아요.","voice":["vo_trial_60202_1_4"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202010,"trial_step":10},{"step":11,"content":"그래, 너나 나나 울 필요는 없지.","style":2,"background":2038,"log_type":1,"src_id":160202011,"trial_step":11},{"step":12,"speaker":"엔퍼","content":"맞아요.","voice":["vo_trial_60202_1_5"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202012,"trial_step":12},{"step":13,"content":"엔퍼는 쥐고 있던 도구를 내려놓고 조각 하나를 들어 자세히 살펴보기 시작했다.","style":3,"background":2038,"log_type":1,"src_id":160202013,"trial_step":13},{"step":14,"speaker":"엔퍼","content":"많은 사람들이 <공포 속에서 잠든 사람>을 본 후에 악몽 때문에 잠들지 못했던 밤을 떠올렸다고 해요.","voice":["vo_trial_60202_1_6"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202014,"trial_step":14},{"step":15,"speaker":"엔퍼","content":"하지만 이젠 이 작품도 편히 잠들 수 있겠네요.","voice":["vo_trial_60202_1_7"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202015,"trial_step":15},{"step":16,"content":"엔퍼는 다른 재질의 조각들을 쓸어낸 후 그 작품의 조각만 한데 모아 쌓았다.","style":3,"background":2038,"log_type":1,"src_id":160202016,"trial_step":16},{"step":17,"content":"마치 예술품이 잠든 안식처 같았다.","style":3,"background":2038,"log_type":1,"src_id":160202017,"trial_step":17},{"step":18,"speaker":"엔퍼","content":"'무거운 억압하에 너와 나는 '철창' 속에 갇혀있지. 가늘고 약해 보이는 창살에도 결코 빠져나갈 수는 없어…'","voice":["vo_trial_60202_1_8"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202018,"trial_step":18},{"step":19,"speaker":"엔퍼","content":"하지만 어두운 밤은 지나고 철창도 결국 부서졌네요…","voice":["vo_trial_60202_1_9"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202019,"trial_step":19},{"step":20,"content":"당신은 엔퍼가 조각 속에서 자신의 예술품을 그러모으는 것을 보며 조금 미안한 감정을 느꼈고, 티슈를 건네며 사과했다.","style":3,"background":2038,"log_type":1,"src_id":160202020,"trial_step":20},{"step":21,"content":"미안해. 내가 혼자 착각한 건 아닌가 모르겠네.","style":2,"background":2038,"log_type":1,"src_id":160202021,"trial_step":21},{"step":22,"speaker":"엔퍼","content":"왜 그렇게 생각하세요?","voice":["vo_trial_60202_1_10"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202022,"trial_step":22},{"step":23,"content":"네가 이 작품들을 자식처럼 여기고 있는 걸 아니까… 네가… 이런 상황을 마주하게 하는 건, 아무래도 좀 매정한 것 같아서.","style":2,"background":2038,"log_type":1,"src_id":160202023,"trial_step":23},{"step":24,"content":"미처 생각을 못 했어.","style":2,"background":2038,"log_type":1,"src_id":160202024,"trial_step":24},{"step":25,"content":"엔퍼는 티슈를 받고 가볍게 고개를 흔들었다.","style":3,"background":2038,"log_type":1,"src_id":160202025,"trial_step":25},{"step":26,"speaker":"엔퍼","content":"사과하실 거 없어요. 제가 같이 오자고 했잖아요.","voice":["vo_trial_60202_1_11"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202026,"trial_step":26},{"step":27,"speaker":"엔퍼","content":"그리고… 절 위해 슬퍼하실 필요 없어요.","voice":["vo_trial_60202_1_12"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202027,"trial_step":27},{"step":28,"content":"엔퍼는 소시아가 전시됐던 전시대 앞에 서서 고개를 들고 마치 소시아가 아직 그 자리에 서 있는 것처럼 바라봤다.","style":3,"background":2038,"log_type":1,"src_id":160202028,"trial_step":28},{"step":29,"speaker":"엔퍼","content":"정말 텅 비었네요…","voice":["vo_trial_60202_1_13"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202029,"trial_step":29},{"step":30,"speaker":"엔퍼","content":"소시아의 곁을 지키던 '친구들'도 모두 조각나 버리고 말았어요.","voice":["vo_trial_60202_1_14"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202030,"trial_step":30},{"step":31,"content":"엔퍼는 조그만 흰색 조각을 주워 들었다. 소시아의 곁을 둘러싸고 있던 조각상의 눈으로 보이는 조각이었다.","style":3,"background":2038,"log_type":1,"src_id":160202031,"trial_step":31},{"step":32,"options":["복원하고 싶어?","나중에 더 훌륭한 작품을 만들 수 있을 거야"],"style":6,"background":2038,"log_type":1,"src_id":160202032,"trial_step":32,"course":3,"choices":[{"text":"복원하고 싶어?","goto":33},{"text":"나중에 더 훌륭한 작품을 만들 수 있을 거야","goto":40}]},{"step":33,"speaker":"엔퍼","content":"복원이요?","voice":["vo_trial_60202_1_15"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202033,"trial_step":33},{"step":34,"content":"전부 네가 가장 아끼던 작품이잖아.","style":2,"background":2038,"log_type":1,"src_id":160202034,"trial_step":34},{"step":35,"content":"물론, 네가 나중에 더 완벽한 작품을 만들어 낼 수 있을 거라 믿지만…","style":2,"background":2038,"log_type":1,"src_id":160202035,"trial_step":35},{"step":36,"content":"그래도 소시아를 많이 좋아했잖아.","style":2,"background":2038,"log_type":1,"src_id":160202036,"trial_step":36},{"step":37,"content":"엔퍼는 웃기만 할 뿐 아무 말도 하지 않았다. 당신은 엔퍼가 아직 주저하고 있다고 생각해 말을 이어갔다.","style":3,"background":2038,"log_type":1,"src_id":160202037,"trial_step":37},{"step":38,"content":"마녀의 밤은 이미 종결됐으니 소시아한테 문제는 없을 거야.","style":2,"background":2038,"log_type":1,"src_id":160202038,"trial_step":38},{"step":39,"content":"어차피 수감자들이 관리국으로 들인 물건은 이미 차고 넘치거든. 조각상이 하나 더 생긴다고 해도… 나이팅게일은 허락해 줄 거야.","style":2,"background":2038,"log_type":1,"src_id":160202039,"trial_step":39,"next":[46]},{"step":40,"content":"하지만 전부 네가 가장 아끼던 작품이라는 걸 알고 있어.","style":2,"background":2038,"log_type":1,"src_id":160202040,"trial_step":40},{"step":41,"content":"이미 마녀의 밤은 종결됐으니 이 아이들한테 문제는 없을 거야.","style":2,"background":2038,"log_type":1,"src_id":160202041,"trial_step":41},{"step":42,"content":"어차피 수감자들이 관리국으로 들인 물건은 이미 차고 넘치거든. 조각상이 하나 더 생긴다고 해도… 나이팅게일은 허락해 줄 거야.","style":2,"background":2038,"log_type":1,"src_id":160202042,"trial_step":42},{"step":43,"speaker":"엔퍼","content":"저더러 이걸 다 복원하라는 거예요?","voice":["vo_trial_60202_1_16"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202043,"trial_step":43},{"step":44,"content":"이 아이들을 정말 좋아하잖아?","style":2,"background":2038,"log_type":1,"src_id":160202044,"trial_step":44},{"step":45,"speaker":"엔퍼","content":"그렇긴 하죠.","voice":["vo_trial_60202_1_17"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202045,"trial_step":45},{"step":46,"content":"엔퍼는 당신을 향해 고개를 끄덕였고 파편을 집어 들었다.","style":3,"background":2038,"log_type":1,"src_id":160202046,"trial_step":46},{"step":47,"content":"하지만 당신은 엔퍼가 소시아를 복원하는 것이 아니라 망치와 끌을 들고 뭔가를 새로 조각하고 있다는 것을 눈치챘다.","style":3,"background":2038,"log_type":1,"src_id":160202047,"trial_step":47},{"step":48,"content":"작업하는 소리가 울렸지만, 전혀 시끄럽게 느껴지지 않았다. 당신은 전시대 옆에 앉아 마음을 가라앉힌 채 그 소리를 듣고 있었다.","style":3,"background":2038,"log_type":1,"src_id":160202048,"trial_step":48},{"step":49,"content":"마치 껍데기를 깨는 소리 같았다.","style":3,"background":2038,"log_type":1,"src_id":160202049,"trial_step":49},{"step":50,"speaker":"엔퍼","content":"…후.","voice":["vo_trial_60202_1_18"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202050,"trial_step":50},{"step":51,"content":"얼마 후 소리가 멈췄고, 당신이 고개를 들자 전시대에서 얼굴을 받치고 생글거리며 당신을 바라보는 엔퍼가 보였다.","style":3,"background":2038,"log_type":1,"src_id":160202051,"trial_step":51},{"step":52,"speaker":"엔퍼","content":"주무시는 줄 알았어요.","voice":["vo_trial_60202_1_19"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202052,"trial_step":52},{"step":53,"speaker":"엔퍼","content":"제 작품 보실래요?","voice":["vo_trial_60202_1_20"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202053,"trial_step":53},{"step":54,"content":"엔퍼는 춤을 청하듯 당신을 향해 손을 내밀어 당신을 일으켜 세웠다.","style":3,"background":2038,"log_type":1,"src_id":160202054,"trial_step":54},{"step":55,"content":"그리고 엔퍼의 곁에는 파편을 사용해 조각한 조그만 물체들이 있었다.","style":3,"background":2038,"log_type":1,"src_id":160202055,"trial_step":55},{"step":56,"content":"이것들은… 뭐지?","style":2,"background":2038,"log_type":1,"src_id":160202056,"trial_step":56},{"step":57,"content":"부서진 조각들은 엔퍼의 손을 거쳐 고치 같은 것이 됐다.","style":3,"background":2038,"log_type":1,"src_id":160202057,"trial_step":57},{"step":58,"content":"하지만 불규칙한 모양이 또 한편으로는 안에서 무언가가 몸부림치고 있는 듯한 느낌을 줬다.","style":3,"background":2038,"log_type":1,"src_id":160202058,"trial_step":58},{"step":59,"speaker":"엔퍼","content":"예술의 잔재일 뿐이에요.","voice":["vo_trial_60202_1_21"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202059,"trial_step":59},{"step":60,"content":"엄청 독특하네.","style":2,"background":2038,"log_type":1,"src_id":160202060,"trial_step":60},{"step":61,"content":"사실 당신조차도 이 조그만 것들은… 엔퍼가 만들었던 옛 작품들에 비해 훨씬 보잘것없다는 사실을 쉽게 알아챌 수 있었다.","style":3,"background":2038,"log_type":1,"src_id":160202061,"trial_step":61},{"step":62,"content":"하지만 당신은 엔퍼를 어떻게 위로해야 좋을지 몰라 그저 그 조그만 작품들을 자세히 살펴볼 뿐이었다.","style":3,"background":2038,"log_type":1,"src_id":160202062,"trial_step":62},{"step":63,"content":"당신은 조각상들의 중앙에 조그만 하트 모양의 각인이 있는 것을 보았다.","style":3,"background":2038,"log_type":1,"src_id":160202063,"trial_step":63},{"step":64,"speaker":"EMP","content":"돌려 말하지 않아도 돼요.","voice":["vo_trial_60202_1_22"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202064,"trial_step":64},{"step":65,"content":"엔퍼가 조각상 하나를 향해 손짓하자, 고치 하나가 손짓에 맞춰 쓰러졌다.","style":3,"background":2038,"log_type":1,"src_id":160202065,"trial_step":65},{"step":66,"speaker":"엔퍼","content":"이것들은… 제 3년 전 작품보다도 못해요.","voice":["vo_trial_60202_1_23"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202066,"trial_step":66},{"step":67,"content":"그 정도는… 아니잖아.","style":2,"background":2038,"log_type":1,"src_id":160202067,"trial_step":67},{"step":68,"speaker":"엔퍼","content":"그 정도예요.","voice":["vo_trial_60202_1_24"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202068,"trial_step":68},{"step":69,"content":"엔퍼는 텅 빈 전시홀을 둘러봤다. 부서진 조각만 남은 전시홀은 바람조차 통하지 않는 새장과 같아, 온 힘을 다해도 빠져나올 수 없을 것처럼, 숨 막힐 정도로 가슴을 아프게 했다.","style":3,"background":2038,"log_type":1,"src_id":160202069,"trial_step":69},{"step":70,"speaker":"엔퍼","content":"하지만 무섭진 않아요.","voice":["vo_trial_60202_1_25"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202070,"trial_step":70},{"step":71,"speaker":"엔퍼","content":"예술가란… 원래 이런 거니까요.","voice":["vo_trial_60202_1_26"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202071,"trial_step":71},{"step":72,"speaker":"엔퍼","content":"저희는 창작 속에서 몸부림치고, 성장하고 자신을 무로 돌아가게 했다가, 결국 또 완전한 개체로 진화하죠.","voice":["vo_trial_60202_1_27"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202072,"trial_step":72},{"step":73,"content":"엔퍼가 두 손을 펼치자 그녀의 들어올려진 파란 옷자락이 마치 빛나는 날개처럼 보였다.","style":3,"background":2038,"log_type":1,"src_id":160202073,"trial_step":73},{"step":74,"speaker":"엔퍼","content":"창작을 반복하는 건 끝없이 자신의 틀을 깨는 것과 같아요.","voice":["vo_trial_60202_1_28"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202074,"trial_step":74},{"step":75,"speaker":"엔퍼","content":"한번 또 한 번 고치를 깨부수고, 마지막엔 모두를 놀라게 할 나방이 되어 나타나는 거예요.","voice":["vo_trial_60202_1_29"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202075,"trial_step":75},{"step":76,"speaker":"엔퍼","content":"그 후엔…","voice":["vo_trial_60202_1_30"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202076,"trial_step":76},{"step":77,"content":"엔퍼는 몸을 돌려 미소 지으며 당신을 바라봤다.","style":3,"background":2038,"log_type":1,"src_id":160202077,"trial_step":77},{"step":78,"speaker":"엔퍼","content":"모두를 놀라게 한 후에는 등불에 달려들어 세상에 가장 완벽한 잔재를 남기죠.","voice":["vo_trial_60202_1_31"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202078,"trial_step":78},{"step":79,"speaker":"엔퍼","content":"이 예술품들은…","voice":["vo_trial_60202_1_32"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202079,"trial_step":79},{"step":80,"content":"엔퍼는 조각 하나를 당신에게 건넸다. 단면은 거칠지만 표면은 세심하게 다듬어진 깨끗한 색의 석고였다.","style":3,"background":2038,"log_type":1,"src_id":160202080,"trial_step":80},{"step":81,"content":"끌로 새겨내 움푹 패인 자국은 바람에 의해 휘날리는 여인의 베일 같았다. 그리고 여기에도 하트 모양의 각인이 숨어 있었다.","style":3,"background":2038,"log_type":1,"src_id":160202081,"trial_step":81},{"step":82,"speaker":"엔퍼","content":"바로 예술가들이 벗어낸 고치이자 타 버린 후 남은 흔적이에요…","voice":["vo_trial_60202_1_33"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202082,"trial_step":82},{"step":83,"speaker":"엔퍼","content":"산산조각이 났다 하더라도 자신이 존재했다는 걸 증명해주죠.","voice":["vo_trial_60202_1_34"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202083,"trial_step":83},{"step":84,"speaker":"엔퍼","content":"다만… 조각이다 보니 더 쉽게 잊히고 말아요.","voice":["vo_trial_60202_1_35"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202084,"trial_step":84},{"step":85,"speaker":"엔퍼","content":"그래서… 전 누구도 잊을 수 없는 가장 완벽한 흔적을 남기고 싶어요.","voice":["vo_trial_60202_1_36"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202085,"trial_step":85},{"step":86,"content":"조각은 엔퍼의 손 안에서 으스러져 손가락 사이로 서서히 떨어졌다.","style":3,"background":2038,"log_type":1,"src_id":160202086,"trial_step":86},{"step":87,"speaker":"엔퍼","content":"어떤 난관이 제 앞을 가로막아도… 전 다 헤쳐 나갈 거예요.","voice":["vo_trial_60202_1_37"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202087,"trial_step":87},{"step":88,"options":["난 널 믿어"],"style":6,"background":2038,"log_type":1,"src_id":160202088,"trial_step":88,"course":3,"choices":[{"text":"난 널 믿어","goto":89}]},{"step":89,"speaker":"엔퍼","content":"하하… 국장님은 참 귀여우시네요.","voice":["vo_trial_60202_1_38"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202089,"trial_step":89},{"step":90,"speaker":"엔퍼","content":"고마워요.","voice":["vo_trial_60202_1_39"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202090,"trial_step":90},{"step":91,"speaker":"엔퍼","content":"어쨌든 전 이미 이 난관을 헤쳐 나가기로 결심했어요.","voice":["vo_trial_60202_1_40"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202091,"trial_step":91},{"step":92,"speaker":"엔퍼","content":"소시아는 이미 실패했고, 저는 유리병 속에 갇혀 버렸죠.","voice":["vo_trial_60202_1_41"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202092,"trial_step":92},{"step":93,"speaker":"엔퍼","content":"하지만 그렇다고 제가 계속 실패할 거란 뜻은 아니에요. 소시아를 깨부순 것처럼, 제가 나약한 이유를 찾아내서 그 유리병을 깨고 고치를 깨부술 거예요.","voice":["vo_trial_60202_1_42"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202093,"trial_step":93},{"step":94,"speaker":"엔퍼","content":"그 과정이 아무리 고통스럽다고 하더라도요.","voice":["vo_trial_60202_1_43"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202094,"trial_step":94},{"step":95,"speaker":"엔퍼","content":"그런데…","voice":["vo_trial_60202_1_44"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202095,"trial_step":95},{"step":96,"content":"엔퍼가 말끝을 늘려서 당신은 조금 긴장이 됐다.","style":3,"background":2038,"log_type":1,"src_id":160202096,"trial_step":96},{"step":97,"speaker":"엔퍼","content":"서두르지 않으면 오늘도 '마녀의 밤'이 계속될 거예요.","voice":["vo_trial_60202_1_45"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202097,"trial_step":97},{"step":98,"content":"당신은 어깨를 으쓱이고는 다시 엔퍼와 정리를 시작했다.","style":3,"background":2038,"log_type":1,"src_id":160202098,"trial_step":98},{"step":99,"content":"정리를 하면서 각별히 주의를 기울인 당신은 다른 작품의 조각에도 예상대로 하트 모양의 흔적이 있다는 것을 발견했다.","style":3,"background":2038,"log_type":1,"src_id":160202099,"trial_step":99},{"step":100,"content":"당신은 엔퍼가 했던 말을 떠올리며 문득 깨달았다. 예술품이 예술가가 이 세상에 존재했던 흔적이라면…","style":3,"background":2038,"log_type":1,"src_id":160202100,"trial_step":100},{"step":101,"content":"그럼 이 작품들에 남은 각인도 예술가가 이 세상에 남기고자 하는 흔적이 아닌가!","style":3,"background":2038,"log_type":1,"src_id":160202101,"trial_step":101},{"step":102,"content":"그럼 이것들은… 도대체 무엇을 표현하고 싶었던 걸까?","style":2,"background":2038,"log_type":1,"src_id":160202102,"trial_step":102},{"step":103,"content":"어… 이건…?","style":2,"background":2038,"log_type":1,"src_id":160202103,"trial_step":103},{"step":104,"content":"당신은 폐허에서 조각 여러 개를 꺼낸 뒤 하나로 합쳐 한 폭의 유화를 만들어냈다.","style":3,"background":2038,"log_type":1,"src_id":160202104,"trial_step":104},{"step":105,"content":"당신은 마녀의 밤에서 이 그림을 본 적이 있었다. 붓 터치를 보아 이 그림은 엔퍼가 아주 어렸을 때 그린 그림인 듯했다.","style":3,"background":2038,"log_type":1,"src_id":160202105,"trial_step":105},{"step":106,"content":"하지만 이 그림의 특이한 점은, 그림이 미숙한데도 불구하고 전시홀에 걸려있었다는 것이 아니라… 이 그림에 하트 모양 각인이 없다는 것이었다.","style":3,"background":2038,"log_type":1,"src_id":160202106,"trial_step":106},{"step":107,"options":["직접 물어본다"],"style":6,"background":2038,"log_type":1,"src_id":160202107,"trial_step":107,"course":3,"choices":[{"text":"직접 물어본다","goto":108}]},{"step":108,"content":"당신은 유화를 들고 엔퍼의 곁으로 갔다.","style":3,"background":2038,"log_type":1,"src_id":160202108,"trial_step":108},{"step":109,"speaker":"엔퍼","content":"음? 그걸 찾으셨군요.","voice":["vo_trial_60202_1_46"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202109,"trial_step":109},{"step":110,"speaker":"엔퍼","content":"정말 그립네요…","voice":["vo_trial_60202_1_47"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202110,"trial_step":110},{"step":111,"content":"내 추측이 맞다면… 이건 네가 어린 시절에 그린 거겠지?","style":2,"background":2038,"log_type":1,"src_id":160202111,"trial_step":111},{"step":112,"speaker":"엔퍼","content":"네. 엄청 어릴 때요… 어머니가 아직 살아계실 때였죠.","voice":["vo_trial_60202_1_48"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202112,"trial_step":112},{"step":113,"content":"어머니…","style":2,"background":2038,"log_type":1,"src_id":160202113,"trial_step":113},{"step":114,"content":"엔퍼, 네 작품엔 모두 특별한 흔적이 있다는 걸… 알고 있어?","style":2,"background":2038,"log_type":1,"src_id":160202114,"trial_step":114},{"step":115,"speaker":"엔퍼","content":"흔적이요…?","voice":["vo_trial_60202_1_49"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202115,"trial_step":115},{"step":116,"content":"응… 하트 모양의 흔적.","style":2,"background":2038,"log_type":1,"src_id":160202116,"trial_step":116},{"step":117,"content":"그리고 여기에 전시된 작품들 뿐만 아니라…","style":2,"background":2038,"log_type":1,"src_id":160202117,"trial_step":117},{"step":118,"content":"당신은 전시대 위에 있는 고치 모양 조각을 집어들어 그 흔적을 엔퍼에게 보여줬다.","style":3,"background":2038,"log_type":1,"src_id":160202118,"trial_step":118},{"step":119,"content":"방금 손 가는 대로 만든 작품에도 무의식적으로 이 흔적을 새겼어.","style":2,"background":2038,"log_type":1,"src_id":160202119,"trial_step":119},{"step":120,"content":"엔퍼는 그림과 조각을 받아들고, 한참을 자세히 들여보고 나서야 입을 열었다.","style":3,"background":2038,"log_type":1,"src_id":160202120,"trial_step":120},{"step":121,"speaker":"엔퍼","content":"이 그림은… 제가 아주 어렸을 때 사진 한 장을 모사해서 그린 거예요…","voice":["vo_trial_60202_1_50"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202121,"trial_step":121},{"step":122,"speaker":"엔퍼","content":"아시다시피 제 어머니는 유화 작가였고, 저도 어릴 때부터 유화 기술을 배웠어요.","voice":["vo_trial_60202_1_51"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202122,"trial_step":122},{"step":123,"speaker":"엔퍼","content":"다만… 어머니가 돌아가시면서 저는 유화를 거의 그리지 않게 됐죠.","voice":["vo_trial_60202_1_52"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202123,"trial_step":123},{"step":124,"speaker":"엔퍼","content":"이번 마녀의 밤을 개최하기 위해서 모든 작품을 꺼내왔고 마침 이 전시홀에 유화 한 폭이 모자랐어요.","voice":["vo_trial_60202_1_53"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202124,"trial_step":124},{"step":125,"speaker":"엔퍼","content":"그냥 무심코 이걸 발견해서 빈 공간을 채운 것뿐이에요.","voice":["vo_trial_60202_1_54"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202125,"trial_step":125},{"step":126,"content":"하지만 이 그림에는 하트 모양 흔적이 없어.","style":2,"background":2038,"log_type":1,"src_id":160202126,"trial_step":126},{"step":127,"content":"엔퍼는 조각상의 흔적을 만지며 살짝 미간을 찌푸렸다.","style":3,"background":2038,"log_type":1,"src_id":160202127,"trial_step":127},{"step":128,"speaker":"엔퍼","content":"그런데…","voice":["vo_trial_60202_1_55"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202128,"trial_step":128},{"step":129,"speaker":"엔퍼","content":"제가 왜 이 흔적을 새겼을까요…?","voice":["vo_trial_60202_1_56"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202129,"trial_step":129},{"step":130,"speaker":"엔퍼","content":"마치 제 마음속 깊은 곳에 이 각인이 새겨져 있는 것 같아요.","voice":["vo_trial_60202_1_57"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202130,"trial_step":130},{"step":131,"content":"엔퍼는 고개를 숙여 그림을 꿰뚫기라도 할 듯 들여다보았다.","style":3,"background":2038,"log_type":1,"src_id":160202131,"trial_step":131},{"step":132,"speaker":"엔퍼","content":"저는 왜 무의식적으로 작품에 이런 흔적을 남기고 있는 걸까요?","voice":["vo_trial_60202_1_58"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202132,"trial_step":132},{"step":133,"speaker":"엔퍼","content":"그리고 제가 또 언제…","voice":["vo_trial_60202_1_59"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202133,"trial_step":133},{"step":134,"content":"엔퍼는 그 유화를 전시대 위에 두고 잠시 바라본 뒤 당신 쪽으로 몸을 돌렸다.","style":3,"background":2038,"log_type":1,"src_id":160202134,"trial_step":134},{"step":135,"speaker":"엔퍼","content":"이 흔적이 도대체 무엇을 의미하는지 알아야겠어요.","voice":["vo_trial_60202_1_60"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202135,"trial_step":135},{"step":136,"content":"너는 무의식적으로 이 흔적을 남기고 있고, 소시아도 네가 줄곧 놓지 못한 것이 있다고 했으니…","style":2,"background":2038,"log_type":1,"src_id":160202136,"trial_step":136},{"step":137,"content":"그게… 네 막막함의 근원이 아닐까?","style":2,"background":2038,"log_type":1,"src_id":160202137,"trial_step":137},{"step":138,"content":"엔퍼는 갑자기 눈을 반짝이더니 당신을 쳐다봤다.","style":3,"background":2038,"log_type":1,"src_id":160202138,"trial_step":138},{"step":139,"speaker":"엔퍼","content":"그럼… 저와 함께 이 근원을 찾으러 가주실래요?","voice":["vo_trial_60202_1_61"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202139,"trial_step":139},{"step":140,"content":"엔퍼는 당신의 대답을 기다리지도 않고 손을 잡아 끌었다.","style":3,"background":2038,"log_type":1,"src_id":160202140,"trial_step":140},{"step":141,"speaker":"엔퍼","content":"가요! 같이 집으로 가 봐요!","voice":["vo_trial_60202_1_62"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202141,"trial_step":141}]}