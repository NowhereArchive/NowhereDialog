{"id":1020203,"chapter_id":1020203,"scene_id":1,"steps":[{"step":1,"content":"소녀의 패닉이 끝나고 시간이 얼마나 흘렀을까.","style":3,"background":10000,"log_type":1,"src_id":120203001,"trial_step":1},{"step":2,"content":"주변은 폐허와 끝없는 어둠뿐이었다.","style":3,"background":10000,"log_type":1,"src_id":120203002,"trial_step":2},{"step":3,"speaker":"검은 그림자","content":"어서 일어나. 여길 떠나야 해.","voice":["vo_trial_20203_1_3"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203003,"trial_step":3},{"step":4,"content":"소녀가 눈을 뜨고 벽돌 파편 위에서 힘겹게 몸을 일으켰다.","style":3,"background":10000,"log_type":1,"src_id":120203004,"trial_step":4},{"step":5,"speaker":"소녀","content":"여긴… 어디지?","voice":["vo_trial_20203_1_5"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203005,"trial_step":5},{"step":6,"speaker":"???","content":"디스씨.","voice":["vo_trial_20203_1_6"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203006,"trial_step":6},{"step":7,"content":"눈앞의 흐릿한 검은 그림자가 기괴한 목소리로 말했다.","style":3,"background":1037,"log_type":1,"src_id":120203007,"trial_step":7},{"step":8,"speaker":"소녀","content":"디스씨는 이렇지 않아…","voice":["vo_trial_20203_1_8"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203008,"trial_step":8},{"step":9,"speaker":"검은 그림자","content":"잊은 거야?","voice":["vo_trial_20203_1_9"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203009,"trial_step":9},{"step":10,"content":"차가운 기억이 소녀의 머릿속으로 쏟아져 들어왔다. 소녀는 그대로 주저앉았고, 하얗게 변하기 시작한 그녀의 눈에서 눈물이 쏟아졌다.","style":3,"background":1037,"log_type":1,"src_id":120203010,"trial_step":10},{"step":11,"speaker":"소녀","content":"간병인님… 의사 선생님… 모두가…","voice":["vo_trial_20203_1_11"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203011,"trial_step":11},{"step":12,"speaker":"검은 그림자","content":"슬퍼할 시간 없어, 주위를 돌아봐.","voice":["vo_trial_20203_1_12"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203012,"trial_step":12},{"step":13,"content":"소녀가 사방을 둘러봤다. 기이한 생물들이 폐허 위를 가득 메우고 있었다.","style":3,"background":1037,"log_type":1,"src_id":120203013,"trial_step":13},{"step":14,"speaker":"소녀","content":"이건…","voice":["vo_trial_20203_1_14"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203014,"trial_step":14},{"step":15,"speaker":"검은 그림자","content":"인간이야.","voice":["vo_trial_20203_1_15"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203015,"trial_step":15},{"step":16,"speaker":"검은 그림자","content":"아니, 대부분은 한때 인간이었던 것들이지.","voice":["vo_trial_20203_1_16"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203016,"trial_step":16},{"step":17,"content":"소녀가 깜짝 놀라며 뒷걸음질 쳤다.","style":3,"background":1037,"log_type":1,"src_id":120203017,"trial_step":17},{"step":18,"speaker":"검은 그림자","content":"살고 싶지?","voice":["vo_trial_20203_1_18"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203018,"trial_step":18},{"step":19,"speaker":"검은 그림자","content":"지금 도망치지 않으면 더는 기회가 없을 거야.","voice":["vo_trial_20203_1_19"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203019,"trial_step":19},{"step":20,"content":"소녀는 망설임 없이 검은 그림자의 '제안'에 따랐다.","style":3,"background":1037,"log_type":1,"src_id":120203020,"trial_step":20},{"step":21,"content":"이상하게도, 아까까지만 해도 병으로 고통스러워하며 걷는 것조차 간병인의 부축을 받아야 했던 소녀가…","style":3,"background":1037,"log_type":1,"src_id":120203021,"trial_step":21},{"step":22,"content":"지금은 붉은 달 아래에서 고통조차 그녀를 쫓아오지 못할 정도로 점점 더 빠르게 달리고 있었다.","style":3,"background":1037,"log_type":1,"src_id":120203022,"trial_step":22},{"step":23,"content":"그러나 소녀는 기뻐할 틈이 없었다. 주변의 괴물이 점점 많아져 두려움에 심장이 튀어나올 것만 같았다.","style":3,"background":1037,"log_type":1,"src_id":120203023,"trial_step":23},{"step":24,"speaker":"소녀","content":"여기서 죽을 순 없어. 나가고 싶어…","voice":["vo_trial_20203_1_24"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203024,"trial_step":24},{"step":25,"content":"소녀는 미친 듯이 달렸다. 내쉬는 숨에 피가 섞여 나올 때까지, 사지의 감각이 사라질 때까지, 심장이 멎을 때까지, 아주 작지만 굳은 의지를 붙잡고 있었다.","style":3,"background":1037,"log_type":1,"src_id":120203025,"trial_step":25},{"step":26,"speaker":"소녀","content":"일출을… 다시 한 번 보고 싶어…","voice":["vo_trial_20203_1_26"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203026,"trial_step":26},{"step":27,"content":"그러나 아무리 굳건한 의지라 해도 잔혹한 현실 앞에서는 무너지기 마련이다.","style":3,"background":1037,"log_type":1,"src_id":120203027,"trial_step":27},{"step":28,"content":"너무나도 긴 도주에 소녀는 얼마나 달렸는지도 잊어버렸고, 마침내 벽돌 파편 위로 쓰러졌다.","style":3,"background":1037,"log_type":1,"src_id":120203028,"trial_step":28},{"step":29,"content":"출발점과 별다를 점 없는 곳이었다.","style":3,"background":1037,"log_type":1,"src_id":120203029,"trial_step":29},{"step":30,"speaker":"검은 그림자","content":"하하…","voice":["vo_trial_20203_1_30"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203030,"trial_step":30},{"step":31,"content":"검은 그림자의 실성한 듯한 웃음소리가 귓가에 울려퍼졌다.","style":3,"background":1037,"log_type":1,"src_id":120203031,"trial_step":31},{"step":32,"speaker":"검은 그림자","content":"하하하!","voice":["vo_trial_20203_1_32"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203032,"trial_step":32},{"step":33,"speaker":"검은 그림자","content":"하하하하하하하하하하하!","voice":["vo_trial_20203_1_33"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203033,"trial_step":33},{"step":34,"content":"소녀는 그 짜증 나는 웃음소리가 들리지 않는 듯 폐허 위에 엎드린 채 앞을 향해 기어가고 있었다.","style":3,"background":1037,"log_type":1,"src_id":120203034,"trial_step":34},{"step":35,"speaker":"검은 그림자","content":"넌 살아 있어. 어째서 너만 살아 있는 거지?","voice":["vo_trial_20203_1_35"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203035,"trial_step":35},{"step":36,"speaker":"검은 그림자","content":"수감자인 데다가 이렇게나 허약하면서… 만약 우리가 너였다면…","voice":["vo_trial_20203_1_36"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203036,"trial_step":36},{"step":37,"speaker":"검은 그림자","content":"너 혼자서는 벗어날 수 없을 거야.","voice":["vo_trial_20203_1_37"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203037,"trial_step":37},{"step":38,"content":"소녀의 구부러진 팔이 벽돌 파편 위에 검붉은 흔적을 남겼다.","style":3,"background":1037,"log_type":1,"src_id":120203038,"trial_step":38},{"step":39,"speaker":"검은 그림자","content":"그렇게나 살고 싶어?","voice":["vo_trial_20203_1_39"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203039,"trial_step":39},{"step":40,"speaker":"검은 그림자","content":"우리도 살고 싶어.","voice":["vo_trial_20203_1_40"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203040,"trial_step":40},{"step":41,"speaker":"검은 그림자","content":"우릴 받아들이고, 우리의 껍데기가 되어… 함께 살아가자…","voice":["vo_trial_20203_1_41"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203041,"trial_step":41},{"step":42,"content":"소녀의 몸이 잠시 멈칫하더니, 피로와 어둠이 끝없이 몰려와 의식을 잃고 말았다.","style":3,"background":1037,"log_type":1,"src_id":120203042,"trial_step":42},{"step":43,"speaker":"변이한 소년","content":"누가 좀 살려줘…","voice":["vo_trial_20203_1_43"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203043,"trial_step":43},{"step":44,"speaker":"변이한 소년","content":"그런 모습으로 변하고 싶지 않아…","voice":["vo_trial_20203_1_44"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203044,"trial_step":44},{"step":45,"speaker":"변이한 소년","content":"죽고 싶지 않아…","voice":["vo_trial_20203_1_45"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203045,"trial_step":45},{"step":46,"content":"어두운 주방 안, 인간이 아닌 괴물의 절망적인 울부짖음이 들려왔다.","style":3,"background":1034,"log_type":1,"src_id":120203046,"trial_step":46},{"step":47,"content":"NOX가 손에 쥔 장검을 들어 올렸다. 마치 이런 일을 이미 수천 번 겪어본 사람처럼 냉혹하고 매끄러운 동작이었다.","style":3,"background":1034,"log_type":1,"src_id":120203047,"trial_step":47},{"step":48,"speaker":"변이한 소년","content":"엄… 마…?","voice":["vo_trial_20203_1_48"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203048,"trial_step":48},{"step":49,"speaker":"변이한 소년","content":"날… 데리러… 온 거야?","voice":["vo_trial_20203_1_49"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203049,"trial_step":49},{"step":50,"content":"NOX가 멈췄다. 그녀는 자신이 왜 이곳에 나타났는지, 무엇을 하고 있는 건지 알 수 없었다.","style":3,"background":1034,"log_type":1,"src_id":120203050,"trial_step":50},{"step":51,"speaker":"변이한 소년","content":"혼자는… 너무 무서워…","voice":["vo_trial_20203_1_51"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203051,"trial_step":51},{"step":52,"speaker":"변이한 소년","content":"난… 그런 모습으로… 변하고 싶지 않아…","voice":["vo_trial_20203_1_52"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203052,"trial_step":52},{"step":53,"content":"타앙!","style":3,"background":1034,"log_type":1,"src_id":120203053,"trial_step":53},{"step":54,"content":"장검이 바닥에 떨어지고, NOX의 회백색 눈동자에 동요와 고통이 가득 차올랐다.","style":3,"background":1034,"log_type":1,"src_id":120203054,"trial_step":54},{"step":55,"content":"그때, 사라지지 않고 있던 검은 그림자가 다시 그녀 앞에 나타났다.","style":3,"background":1034,"log_type":1,"src_id":120203055,"trial_step":55},{"step":56,"speaker":"검은 그림자","content":"저 소년을 죽이고 받아들여.","voice":["vo_trial_20203_1_56"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203056,"trial_step":56},{"step":57,"speaker":"검은 그림자","content":"예전처럼 말이야.","voice":["vo_trial_20203_1_57"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203057,"trial_step":57},{"step":58,"content":"NOX는 검은 그림자의 속삭임에 반응하지 않고 비틀거리며 뒷걸음질 쳤다.","style":3,"background":1034,"log_type":1,"src_id":120203058,"trial_step":58},{"step":59,"speaker":"검은 그림자","content":"너도 살고 싶잖아. 우리도 살고 싶어. 저 애도 마찬가지야.","voice":["vo_trial_20203_1_59"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203059,"trial_step":59},{"step":60,"speaker":"소녀","content":"이런 건… 살아있는 게… 아니야…","voice":["vo_trial_20203_1_60"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203060,"trial_step":60},{"step":61,"speaker":"검은 그림자","content":"꼭 해야만 하는 일이야.","voice":["vo_trial_20203_1_61"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203061,"trial_step":61},{"step":62,"speaker":"검은 그림자","content":"약속했잖아.","voice":["vo_trial_20203_1_62"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203062,"trial_step":62},{"step":63,"content":"소녀는 필사적으로 뒷걸음질 쳤지만, 검은 그림자는 끝까지 그녀를 쫓아갔다.","style":3,"background":1034,"log_type":1,"src_id":120203063,"trial_step":63},{"step":64,"content":"소녀의 몸에서 검은 안개가 퍼져 나와 사지를 꽉 붙잡았다.","style":3,"background":1034,"log_type":1,"src_id":120203064,"trial_step":64},{"step":65,"content":"소녀는 검은 그림자에게 사로잡혀 다시 장검을 들어올렸다. 소녀가 본능적으로 저항하자, 장검이 허공에서 멈칫했다.","style":3,"background":1034,"log_type":1,"src_id":120203065,"trial_step":65},{"step":66,"speaker":"소녀","content":"아… 안돼…","voice":["vo_trial_20203_1_66"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1034,"log_type":1,"src_id":120203066,"trial_step":66},{"step":67,"content":"검은 그림자는 결국 소녀의 두 눈을 가렸다. 장검이 허공을 가르자, 소년의 울음소리가 멈췄다.","style":3,"background":1034,"log_type":1,"src_id":120203067,"trial_step":67},{"step":68,"content":"그러나 소녀의 흐느낌이 어둠 속에 울려 퍼졌다.","style":3,"background":1034,"log_type":1,"src_id":120203068,"trial_step":68},{"step":69,"speaker":"소녀","content":"누가 좀 살려줘…","voice":["vo_trial_20203_1_69"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203069,"trial_step":69},{"step":70,"content":"늘 그렇듯, 아무런 대답도 돌아오지 않았다.","style":3,"background":10000,"log_type":1,"src_id":120203070,"trial_step":70},{"step":71,"content":"소녀는 어둠 속에서 하염없이 기다렸다.","style":3,"background":10000,"log_type":1,"src_id":120203071,"trial_step":71},{"step":72,"speaker":"소녀","content":"이상해, 여긴 어디지? 나는… 왜 여기에 있는 거지?","voice":["vo_trial_20203_1_72"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203072,"trial_step":72},{"step":73,"speaker":"소녀","content":"난… 저들을 막아야 해. 하지만… 나 혼자서는 아무것도 할 수 없어…","voice":["vo_trial_20203_1_73"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203073,"trial_step":73},{"step":74,"speaker":"소녀","content":"누가 좀 살려줘…","voice":["vo_trial_20203_1_74"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203074,"trial_step":74},{"step":75,"speaker":"소녀","content":"난… 누구지?","voice":["vo_trial_20203_1_75"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203075,"trial_step":75},{"step":76,"content":"절망적인 기다림 속에서 소녀의 기억은 점점 희미해져 갔다. 어둠이 다가오자 소녀는 다 타버린 재처럼 서서히 빛을 잃어가고 있었다.","style":3,"background":10000,"log_type":1,"src_id":120203076,"trial_step":76},{"step":77,"content":"한 줄기 빛이 어둠의 가장자리를 가르고, 어떤 사람의 목소리가 소녀를 깨웠다.","style":3,"background":10000,"log_type":1,"src_id":120203077,"trial_step":77},{"step":78,"content":"포기하지 마, 내가 여기에 있어!","style":2,"background":10000,"log_type":1,"src_id":120203078,"trial_step":78},{"step":79,"content":"누군가가 희미하지만 무시할 수 없는 빛과 함께 온 힘을 다해 이 어둠을 헤집고 들어오고 있었다.","style":3,"background":10000,"log_type":1,"src_id":120203079,"trial_step":79},{"step":80,"content":"그 빛은 극도로 야윈 소녀의 고통스러운 몸, 그리고 그 위를 빽빽하게 기어가고 있는 공포의 검은 그림자를 비추었다.","style":3,"background":10000,"log_type":1,"src_id":120203080,"trial_step":80},{"step":81,"content":"고통스러운 거 알아, 하지만… 포기하지 마!","style":2,"background":10000,"log_type":1,"src_id":120203081,"trial_step":81},{"step":82,"content":"일출 보고 싶다고 했지? 기억나? 내가 데려가 주겠다고 약속했잖아. 디스시티의 일출 말이야!","style":2,"background":10000,"log_type":1,"src_id":120203082,"trial_step":82},{"step":83,"content":"그 약속 지키러 온 거야!","style":2,"background":10000,"log_type":1,"src_id":120203083,"trial_step":83},{"step":84,"content":"소녀는 로봇처럼 고개를 들고 그 사람을 바라보았다.","style":3,"background":10000,"log_type":1,"src_id":120203084,"trial_step":84},{"step":85,"content":"내 손 잡아! 함께 여길 떠나자!","style":2,"background":10000,"log_type":1,"src_id":120203085,"trial_step":85},{"step":86,"content":"앰버!","style":2,"background":10000,"log_type":1,"src_id":120203086,"trial_step":86},{"step":87,"content":"앰버, 모든 편지의 첫 줄에 적힌 이름, 아침 햇살과 희망의 힘을 상징하는 그 이름이 회백색의 눈동자를 다시 밝혔다.","style":3,"background":10000,"log_type":1,"src_id":120203087,"trial_step":87},{"step":88,"content":"그녀가 손을 뻗자, 만신창이가 된 몸에서 눈 부신 빛이 솟구쳤다.","style":3,"background":10000,"log_type":1,"src_id":120203088,"trial_step":88},{"step":89,"speaker":"앰버","content":"니노","voice":["vo_trial_20203_1_89"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203089,"trial_step":89},{"step":90,"speaker":"앰버","content":"드디어… 와 줬구나…","voice":["vo_trial_20203_1_90"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203090,"trial_step":90},{"step":91,"content":"앰버에게 붙은 검은 그림자가 그녀의 몸에서 미친 듯이 달아났고, 귀를 찌르는 듯한 그들의 울부짖음이 어둠을 뒤흔들었다.","style":3,"background":10000,"log_type":1,"src_id":120203091,"trial_step":91},{"step":92,"speaker":"검은 그림자","content":"이러는 게 어딨어! 약속했잖아!","voice":["vo_trial_20203_1_92"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203092,"trial_step":92},{"step":93,"speaker":"검은 그림자","content":"너 혼자서는 디스씨에 대항할 수 없어!","voice":["vo_trial_20203_1_93"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203093,"trial_step":93},{"step":94,"speaker":"검은 그림자","content":"난 죽고 싶지 않아, 우린 함께해야만 살 수 있다고!!","voice":["vo_trial_20203_1_94"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203094,"trial_step":94},{"step":95,"speaker":"앰버","conte