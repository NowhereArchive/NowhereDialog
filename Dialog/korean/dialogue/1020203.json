6"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1,"log_type":1,"src_id":120203106,"trial_step":106},{"step":107,"content":"행복한 환상에서 깨어난 당신은 아수라장을 마주했다.","style":3,"background":1,"log_type":1,"src_id":120203107,"trial_step":107},{"step":108,"content":"어지러움이 가시기도 전에, 당신은 억지로 몸을 일으켰다.","style":3,"background":1,"log_type":1,"src_id":120203108,"trial_step":108},{"step":109,"speaker":"나이팅게일","content":"국장님…","voice":["vo_trial_20203_1_109"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1,"log_type":1,"src_id":120203109,"trial_step":109},{"step":110,"content":"늘 침착하던 나이팅게일의 목소리에 불안감이 가득했다.","style":3,"background":1,"log_type":1,"src_id":120203110,"trial_step":110},{"step":111,"speaker":"나이팅게일","content":"NOX가 속박을 파괴했습니다. 저희는…","voice":["vo_trial_20203_1_111"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1,"log_type":1,"src_id":120203111,"trial_step":111},{"step":112,"content":"저희는 NOX를 막을 수 없었습니다.","style":1,"background":1,"log_type":1,"src_id":120203112,"trial_step":112}]}