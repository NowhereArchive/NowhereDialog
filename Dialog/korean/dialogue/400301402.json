{"id":400301402,"chapter_id":50014,"scene_id":51404,"steps":[{"step":1,"content":"미술관 깊숙한 곳에선 갑자기 고동 소리가 한 번씩 들려왔다.","style":3,"background":2025,"log_type":1},{"step":2,"speaker":"헤카테","content":"이 그림은… 왜 이렇게 강한 힘을 가지고 있는 거지…","voice":["vo_event_03014_34"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":3,"speaker":"헤카테","content":"마치… 이게… 내 정신을 읽고 있는 것 같아…","voice":["vo_event_03014_35"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":4,"speaker":"???","content":"그는 이미 죽었어. 그는 이미 죽었어. 그는 이미 죽었어…","female_content":"그녀는 이미 죽었어. 그녀는 이미 죽었어. 그녀는 이미 죽었어…","voice":["vo_event_03014_36"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":5,"content":"헤카테는 고통스럽게 머리를 감싸 쥐었다.","style":3,"background":2025,"log_type":1},{"step":6,"speaker":"???","content":"포기해… 포기해… 어쩔 수 없어…","voice":["vo_event_03014_38"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":7,"speaker":"달리아의 해설","content":"이것은 공포의 그림으로, 사람들의 내면의 공포를 불러 일으킵니다.","voice":["vo_event_03014_39"],"voice_bank":"vo_event_03_p1b","style":11,"background":2025,"log_type":1},{"step":8,"speaker":"달리아의 해설","content":"이 그림은 돌아갈 곳을 상실하는 것에 대한 사람들의 공포를 일깨워 사람마다… 다른 것을 보게 만들죠.","voice":["vo_event_03014_40"],"voice_bank":"vo_event_03_p1b","style":11,"background":2025,"log_type":1},{"step":9,"speaker":"달리아의 해설","content":"레버린스… 처럼요.","voice":["vo_event_03014_41"],"voice_bank":"vo_event_03_p1b","style":11,"background":2025,"log_type":1},{"step":10,"speaker":"레버린스","content":"전투 형태… 전투 형태… 전투 형태…","voice":["vo_event_03014_42"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":11,"speaker":"헤카테","content":"레버린스! 왜 그래?!","voice":["vo_event_03014_43"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":12,"speaker":"헤카테","content":"…! 설마, 저 그림이…","voice":["vo_event_03014_44"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":13,"content":"검은 그림자가 하나씩 격파되고 난 후에도 미술관 내부는 예상처럼 원래의 모습으로 돌아가지 않았다.","style":3,"background":2025,"log_type":1},{"step":14,"content":"그 대신, 더 광폭해졌다.","style":3,"background":2025,"log_type":1},{"step":15,"content":"아주 작은 소리가 레버린스의 머리 속을 파고들었다.","style":3,"background":2025,"log_type":1},{"step":16,"content":"아주 작은 소리였다.","style":3,"background":2025,"log_type":1},{"step":17,"speaker":"??","content":"왔구나.","voice":["vo_event_03014_49"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":18,"speaker":"레버린스","content":"……?","style":1,"background":2025,"log_type":1},{"step":19,"speaker":"??","content":"이미 오래 전에 날 잊어버린 줄 알았어.","voice":["vo_event_03014_51"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":20,"speaker":"레버린스","content":"마… 리…?","voice":["vo_event_03014_52"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":21,"speaker":"??","content":"하하… 이름도 기억하고 있네?","voice":["vo_event_03014_53"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":22,"speaker":"레버린스","content":"마리… 마리?","voice":["vo_event_03014_54"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":23,"speaker":"레버린스","content":"당신은… 누굽니까? 나는… 또 누구죠?","voice":["vo_event_03014_55"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":24,"content":"레버린스의 머리 속에서 장면이 하나씩 번뜩였다.","style":3,"background":10000,"log_type":1},{"step":25,"content":"오후의 식당, 기분 좋은 향기.","style":3,"background":1005,"log_type":1},{"step":26,"content":"갱단, 혼란, 싸움, 공포, 폭도.","style":3,"background":1008,"log_type":1},{"step":27,"content":"늦어버린 행동… 그리고, 늦어버린 사과.","style":3,"background":1029,"log_type":1},{"step":28,"content":"자책. 그렇다, 모든 것이 자신 때문이었다.","style":3,"background":1029,"log_type":1},{"step":29,"speaker":"'마리'","content":"너는… 모든 걸 잊은 거짓말쟁이, 약속을 지키지 않는 거짓말쟁이, 레버린스야.","voice":["vo_event_03014_70"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":30,"speaker":"'마리'","content":"이렇게 하자… 오랜만에 이렇게 만나기도 쉽지 않잖아. 너한테 다시 기회를 줄게… 여기 있는 모든 적을 없애 버려.","voice":["vo_event_03014_71"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":31,"speaker":"'마리'","content":"이건 네 주인… 마리의 명령이야.","voice":["vo_event_03014_73"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":32,"speaker":"헤카테","content":"여기에 마리는 없어… 정신 좀 차려!","voice":["vo_event_03014_56"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":33,"content":"헤카테는 두통을 참으며, 레버린스에게 다가갈 준비를 했다.","style":3,"background":2025,"log_type":1},{"step":34,"speaker":"레버린스","content":"가동 준비, 가동 준비.","voice":["vo_event_03014_58"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":35,"speaker":"레버린스","content":"전투 형태, 풀 가동.","voice":["vo_event_03014_59"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":36,"speaker":"레버린스","content":"부족해… 너무 부족해…","voice":["vo_event_03014_60"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":37,"speaker":"레버린스","content":"저들을 없애기엔 부족해. 너무 부족해.","voice":["vo_event_03014_61"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":38,"content":"레버린스의 몸에선 탁탁거리는 소리가 났고, 그녀의 수감자 에너지는 걷잡을 수 없이 치솟았다.","style":3,"background":2025,"log_type":1},{"step":39,"speaker":"레버린스","content":"'과부하 모드' 가동 준비, '과부하 모드' 가동 준비.","voice":["vo_event_03014_62"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":40,"speaker":"사샤","content":"와! 멋진데! 이거야말로 수감자가 취해야 할 모습이지! 온몸에서 빨간 빛을 뿜어내고 있어!","voice":["vo_event_03014_63"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":41,"speaker":"헤카테","content":"빨리 피해!","voice":["vo_event_03014_64"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":42,"content":"악몽은 사샤를 밀어냈고, 그와 동시에 레버린스에게 몇 차례 공격을 받았다.","style":3,"background":2025,"log_type":1},{"step":43,"speaker":"레버린스","content":"없앤다… 없앤다… 마리의 적을 모두 없앤다.","voice":["vo_event_03014_66"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":44,"speaker":"레버린스","content":"다시는 너희들이 마리를 해치게 두지 않겠다!","voice":["vo_event_03014_67"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":45,"speaker":"레버린스","content":"마리를 지키는 것은… 내 사명이다!","voice":["vo_event_03014_68"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1},{"step":46,"speaker":"레버린스","content":"과부하 모드, 풀 가동!","voice":["vo_event_03014_69"],"voice_bank":"vo_event_03_p1b","style":1,"background":2025,"log_type":1}]}