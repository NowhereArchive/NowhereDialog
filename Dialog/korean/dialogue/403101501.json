{"id":403101501,"chapter_id":21000105,"scene_id":502,"steps":[{"step":1,"speaker":"필기아","content":"앞에 장애물이 있으니까 조심하세요.","voice":["vo_event_403101501_3"],"voice_bank":"vo_event_31015","style":1,"background":2310106,"log_type":1},{"step":2,"content":"당신은 적절히 방향을 틀며 현창 밖 필기아를 향해 고개를 끄덕였다.","style":3,"background":2310106,"log_type":1},{"step":3,"content":"상처를 입은 괴물의 울부짖음이 조금씩 가까워졌지만, 당신이 할 수 있는 건 많지 않았다. 그저 필기아의 안내를 믿으며 망가진 이 잠수함이 괴물의 추격을 따돌리고 당신들을 구해주길 기도하는 수밖에 없었다.","style":3,"background":2310106,"log_type":1},{"step":4,"speaker":"필기아","content":"라그나는… 어때요?","voice":["vo_event_403101501_7"],"voice_bank":"vo_event_31015","style":1,"background":2310106,"log_type":1},{"step":5,"speaker":"${PlayerName}","content":"좋지 않아… 무언가에 의식을 빼앗긴 것 같아…","style":2,"background":2307,"log_type":1},{"step":6,"content":"그는 마치 끔찍한 악몽을 꾸는 듯 두 눈을 질끈 감고 이따금 두려움에 가득 찬 표정을 지었다. 가끔 소름 끼치는 웃음소리를 내며 알 수 없는 잠꼬대를 하기도 했다.","style":3,"background":2307,"log_type":1},{"step":7,"speaker":"필기아","content":"벵엔 의사 선생님이 잘 치료해 줄 거예요, 분명…","voice":["vo_event_403101501_13"],"voice_bank":"vo_event_31015","style":1,"background":2307,"log_type":1},{"step":8,"speaker":"괴물","content":"…!!!","voice":["vo_event_403101501_15"],"voice_bank":"vo_event_31015","style":1,"background":2307,"log_type":1},{"step":9,"speaker":"${PlayerName}","content":"…일단 이곳부터 빠져나가자.","style":2,"background":2310106,"log_type":1},{"step":10,"speaker":"필기아","content":"네.","voice":["vo_event_403101501_17"],"voice_bank":"vo_event_31015","style":1,"background":2310106,"log_type":1}]}