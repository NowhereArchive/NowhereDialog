{"id":6321,"chapter_id":6,"scene_id":611,"steps":[{"step":1,"speaker":"어렴풋하게 들리는 목소리","content":"<i><size=30>…정신… 차려…</size></i>","voice":["vo_cgplot_6221001","vo_cgplot_6221001f"],"voice_bank":"vo_cgplot_06","style":1,"background":602,"log_type":1},{"step":2,"speaker":"조야","content":"대체 누구지?! 나와!","voice":["vo_cgplot_6221002"],"voice_bank":"vo_cgplot_06","style":1,"background":602,"log_type":1},{"step":3,"content":"조야는 질퍽거리는 세계를 뛰어다니며 끊임없이 길의 불결함을 떨쳐냈다, 소리가 텅 빈 세계에 울려 퍼졌고, 안개는 모든 울림을 흡수했다.","style":3,"background":602,"log_type":1},{"step":4,"speaker":"어렴풋하게 들리는 목소리","content":"<i><size=30>조야…조야……</size></i>","voice":["vo_cgplot_6221004","vo_cgplot_6221004f"],"voice_bank":"vo_cgplot_06","style":1,"background":602,"log_type":1},{"step":5,"speaker":"조야","content":"날 왜 깨운 거지? 여긴 어디야?!","voice":["vo_cgplot_6221005"],"voice_bank":"vo_cgplot_06","style":1,"background":602,"log_type":1},{"step":6,"speaker":"조야","content":"내가 어디로 가길 원하지?","voice":["vo_cgplot_6221006"],"voice_bank":"vo_cgplot_06","style":1,"background":602,"log_type":1},{"step":7,"speaker":"혼돈의 목소리","content":"<color=#dg1f1f><size=30><i>넌 어디에도 못 가…</size></color></i>","voice":["vo_cgplot_6221007"],"voice_bank":"vo_cgplot_06","style":1,"background":602,"log_type":1},{"step":8,"content":"갑자기 왜곡된 목소리가 들려왔다. 안개가 자욱해지면서 모든 것을 집어삼켰다.","style":3,"background":10000,"log_type":1},{"step":9,"speaker":"조야","content":"넌 누구지?","voice":["vo_cgplot_6221009"],"voice_bank":"vo_cgplot_06","style":1,"background":10000,"log_type":1},{"step":10,"speaker":"혼돈의 목소리","content":"<color=#dg1f1f><i>넌 링에 속하고, 내게 속하지, 넌… 바로 나다…</color></i>","voice":["vo_cgplot_6221010"],"voice_bank":"vo_cgplot_06","style":1,"background":10000,"log_type":1},{"step":11,"speaker":"혼돈의 목소리","content":"<color=#dg1f1f><size=44>어디에도 못 가!</size></color>","voice":["vo_cgplot_6221011"],"voice_bank":"vo_cgplot_06","style":1,"background":10000,"log_type":1},{"step":12,"speaker":"조야","content":"저리 가!","voice":["vo_cgplot_6221012"],"voice_bank":"vo_cgplot_06","style":1,"background":10000,"log_type":1}]}