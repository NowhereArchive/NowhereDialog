{"id":1120101,"chapter_id":1120101,"scene_id":1,"steps":[{"step":1,"content":"심문실로 통하는 텅 빈 복도에는 경고등만이 기계적으로 깜빡이고 있었다.","style":3,"background":10000,"log_type":1,"src_id":220101001,"trial_step":1},{"step":2,"content":"뒤따라오는 나인티나인의 거친 숨소리와 특제 쇠사슬이 땅에 끌리는 소리는 듣기만 해도 온몸에 소름이 끼쳤다.","style":3,"background":10000,"log_type":1,"src_id":220101002,"trial_step":2},{"step":3,"content":"손발이 묶이고 눈까지 가려져 있음에도, 뿜어져 나오는 그녀의 위험한 기운이 목덜미에서 느껴졌다.","style":3,"background":10000,"log_type":1,"src_id":220101003,"trial_step":3},{"step":4,"speaker":"나인티나인","content":"당신이지?","voice":["vo_trial_120101_1_5"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101005,"trial_step":5,"drawing":1120104},{"step":5,"options":["날 알아보겠나?","그래, 구면이지"],"style":6,"log_type":1,"src_id":220101006,"trial_step":6,"course":3,"drawing":1120104,"choices":[{"text":"날 알아보겠나?","goto":7},{"text":"그래, 구면이지","goto":null}]},{"step":6,"speaker":"나인티나인","content":"난 당신의 체취를 알거든.","voice":["vo_trial_120101_1_7"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101007,"trial_step":7,"drawing":1120104},{"step":7,"content":"나인티나인은 차분하게 앞에 앉았다. 방금까지 느껴왔던 공포가 비현실적으로 느껴질 만큼 고요한 모습이었다.","style":3,"log_type":1,"src_id":220101008,"trial_step":8,"drawing":1120104},{"step":8,"content":"물론 그녀는 여전히 짐승의 본능을 표출하고 있었다. 칠흑 같은 어둠 속에서도 감각 기관이 여전히 날카롭게 곤두선 듯한 그녀의 모습에 절로 자세를 고쳐잡았다.","style":3,"log_type":1,"src_id":220101009,"trial_step":9,"drawing":1120104},{"step":9,"options":["심문을 시작한다"],"style":6,"log_type":1,"src_id":220101010,"trial_step":10,"course":3,"drawing":1120104,"choices":[{"text":"심문을 시작한다","goto":11}]},{"step":10,"content":"며칠 전 검으로 나를 베려 한 혐의로… FAC가 널 고위험군으로 분류했다.","style":2,"log_type":1,"src_id":220101011,"trial_step":11,"drawing":1120104},{"step":11,"speaker":"나인티나인","content":"군단이 당신을 생포하래.","voice":["vo_trial_120101_1_12"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101012,"trial_step":12,"drawing":1120104},{"step":12,"speaker":"나인티나인","content":"그들의 돈을 받았으면, 그에 상응하는 일을 해야지.","voice":["vo_trial_120101_1_13"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101013,"trial_step":13,"drawing":1120104},{"step":13,"content":"이런 일을 자주 하나?","style":2,"log_type":1,"src_id":220101014,"trial_step":14,"drawing":1120104},{"step":14,"speaker":"나인티나인","content":"무슨 일?","voice":["vo_trial_120101_1_15"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101015,"trial_step":15,"drawing":1120104},{"step":15,"content":"목표물을 베는 일.","style":2,"log_type":1,"src_id":220101016,"trial_step":16,"drawing":1120104},{"step":16,"speaker":"나인티나인","content":"응, 그들은 돈을 주고, 우리는 돈이 필요하니까.","voice":["vo_trial_120101_1_17"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101017,"trial_step":17,"drawing":1120104},{"step":17,"speaker":"나인티나인","content":"사람을 베는 것만큼 쉬운 일도 없거든.","voice":["vo_trial_120101_1_18"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101018,"trial_step":18,"drawing":1120104},{"step":18,"content":"나인티나인은 마치 일상 이야기를 하듯 담담하게 대답했다.","style":3,"log_type":1,"src_id":220101019,"trial_step":19,"drawing":1120104},{"step":19,"content":"하지만 족쇄가 보내는 요란한 경고에 마음속에서 불안한 예감이 스멀스멀 올라왔다.","style":3,"log_type":1,"src_id":220101020,"trial_step":20,"drawing":1120104},{"step":20,"content":"나인티나인은 그동안 체포한 기존의 수감자와는 전혀 다른 부류 같았다.","style":3,"log_type":1,"src_id":220101021,"trial_step":21,"drawing":1120104},{"step":21,"content":"제 발로 MBCC를 찾아왔다고 해도, 우리는 너의 위험성을 검토하기 위해 심문을 해야 해. 일종의 관례 같은 거지.","style":2,"log_type":1,"src_id":220101022,"trial_step":22,"drawing":1120104},{"step":22,"content":"협조해 주길 바란다.","style":2,"log_type":1,"src_id":220101023,"trial_step":23,"drawing":1120104},{"step":23,"speaker":"나인티나인","content":"어떤 질문이라도 대답하지.","voice":["vo_trial_120101_1_24"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101024,"trial_step":24,"drawing":1120104},{"step":24,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":25,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":26,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":27,"options":["선택1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":28,"content":"테스트","style":18,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":29,"options":["선택1","선택2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":30,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":31,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":25,"course":6,"drawing":1120104},{"step":32,"options":["군단의 임무는?"],"style":6,"log_type":1,"src_id":220101026,"trial_step":26,"course":3,"drawing":1120104,"choices":[{"text":"군단의 임무는?","goto":27}]},{"step":33,"speaker":"나인티나인","content":"조금 전에 설명했잖아.","voice":["vo_trial_120101_1_27"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101027,"trial_step":27,"drawing":1120104},{"step":34,"speaker":"나인티나인","content":"당신을 생포하라고 했다니까.","voice":["vo_trial_120101_1_28"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101028,"trial_step":28,"drawing":1120104},{"step":35,"content":"그날 했던 행동이 날 생포하려는 것이었다고?","style":2,"log_type":1,"src_id":220101029,"trial_step":29,"drawing":1120104},{"step":36,"speaker":"나인티나인","content":"맞아, 난 항상 임무를 완수하도록 노력하지. 그렇지 않으면 그들이 돈을 안 주니까.","voice":["vo_trial_120101_1_30"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101030,"trial_step":30,"drawing":1120104},{"step":37,"content":"군단이 <color=#fb9259>생포</color>를 명했다고 했지.","style":2,"log_type":1,"src_id":220101031,"trial_step":31,"drawing":1120104},{"step":38,"content":"하지만 그때 넌 내 목숨을 원했어.","style":2,"log_type":1,"src_id":220101032,"trial_step":32,"drawing":1120104},{"step":39,"content":"나인티나인이 고개를 들었다. 두 눈은 가려져 있었음도 꿰뚫어 보는 듯했다.","style":3,"log_type":1,"src_id":220101033,"trial_step":33,"drawing":1120104},{"step":40,"speaker":"나인티나인","content":"나는 단지 나의 임무를 수행하고 있을 뿐이야.","voice":["vo_trial_120101_1_34"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101034,"trial_step":34,"drawing":1120104},{"step":41,"options":["……"],"style":6,"log_type":1,"src_id":220101035,"trial_step":35,"course":3,"drawing":1120104,"choices":[{"text":"……","goto":36}]},{"step":42,"speaker":"나인티나인","content":"그들이 좌표와 해결 방안을 제공하면, 난 그저 그들의 요구대로 타겟을 추적해…... 죽이는 거지.","voice":["vo_trial_120101_1_36"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101036,"trial_step":36,"drawing":1120104},{"step":43,"speaker":"나인티나인","content":"하지만 당신도 꽤 대단하군, 지금 내 앞에 멀쩡히 서 있잖아?","voice":["vo_trial_120101_1_37"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101037,"trial_step":37,"drawing":1120104},{"step":44,"content":"나인티나인은 마음 가는 대로 사람을 베어 버리는 잔악한 괴물답지 않게 몹시 협조적으로 대답했다.","style":3,"log_type":1,"src_id":220101038,"trial_step":38,"drawing":1120104},{"step":45,"content":"하지만 그래서 더욱 두려웠다. 나인티나인이 정말 죽일 마음이 없는 건지 아니면 타이밍을 재고 있는 건지 알 수 없었기 때문이다.","style":3,"log_type":1,"src_id":220101039,"trial_step":39,"drawing":1120104},{"step":46,"content":"족쇄가 가져다주는 불안감을 억누르며 정신을 가다듬고 다시 용기를 내어 질문했다.","style":3,"log_type":1,"src_id":220101040,"trial_step":40,"drawing":1120104},{"step":47,"options":["지하 괴물"],"style":6,"log_type":1,"src_id":220101041,"trial_step":41,"course":3,"drawing":1120104,"choices":[{"text":"지하 괴물","goto":42}]},{"step":48,"content":"지하 괴물들을 기억하나?","style":2,"log_type":1,"src_id":220101042,"trial_step":42,"drawing":1120104},{"step":49,"speaker":"나인티나인","content":"물론이지.","voice":["vo_trial_120101_1_43"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101043,"trial_step":43,"drawing":1120104},{"step":50,"speaker":"나인티나인","content":"강한 놈들이야. 내 검도 두려워하지 않았지. 두 다리를 자르면 기어서라도 쫓아오더군.","voice":["vo_trial_120101_1_44"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101044,"trial_step":44,"drawing":1120104},{"step":51,"content":"맞아, 아주 무서운 존재들이지.","style":2,"log_type":1,"src_id":220101045,"trial_step":45,"drawing":1120104},{"step":52,"content":"하지만 그 괴물들… 어째서인지 널 닮았던데.","style":2,"log_type":1,"src_id":220101046,"trial_step":46,"drawing":1120104},{"step":53,"content":"나인티나인이 색다른 반응을 보이길 바라며, 조심스레 질문을 던진 뒤 조용히 그녀의 안색을 살폈다.","style":3,"log_type":1,"src_id":220101047,"trial_step":47,"drawing":1120104},{"step":54,"speaker":"나인티나인","content":"뭘 알고 싶은 거지?","voice":["vo_trial_120101_1_48"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101048,"trial_step":48,"drawing":1120104},{"step":55,"content":"나인티나인이 무심한 목소리로 내뱉은 반응에 가슴이 철렁 내려앉았다.","style":3,"log_type":1,"src_id":220101049,"trial_step":49,"drawing":1120104},{"step":56,"content":"그냥, 궁금해서.","style":2,"log_type":1,"src_id":220101050,"trial_step":50,"drawing":1120104},{"step":57,"speaker":"나인티나인","content":"내 몸에서 나왔으니 날 닮을 수밖에.","voice":["vo_trial_120101_1_51"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101051,"trial_step":51,"drawing":1120104},{"step":58,"content":"무슨 뜻이지? 네 클론이란 거야?","style":2,"log_type":1,"src_id":220101052,"trial_step":52,"drawing":1120104},{"step":59,"speaker":"나인티나인","content":"아니, 난 뭔지 몰라.","voice":["vo_trial_120101_1_53"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101053,"trial_step":53,"drawing":1120104},{"step":60,"speaker":"나인티나인","content":"하지만 내 의식이 흐려질 때, 늘 나와 똑같이 생긴… 괴물들이 많이 나와.","voice":["vo_trial_120101_1_54"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101054,"trial_step":54,"drawing":1120104},{"step":61,"speaker":"나인티나인","content":"지하에서도 마찬가지지.","voice":["vo_trial_120101_1_55"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101055,"trial_step":55,"drawing":1120104},{"step":62,"content":"설마… 변이 결정체?! 당신의 마음속 불안한 마음이 더욱 커졌다.","style":3,"log_type":1,"src_id":220101056,"trial_step":56,"drawing":1120104},{"step":63,"content":"자료에 의하면 실제로 파르마 실험실이 끔찍한 불법 실험을 하고 있으며, 변이 결정체를 이용해 변이 무기를 제작하고 있는 것으로 나타났다.","style":3,"log_type":1,"src_id":220101057,"trial_step":57,"drawing":1120104},{"step":64,"content":"너의 감염 정도는 상당히 높아… 의식을 잃었을 때는 분명 변이 상태에 빠졌을 거야.","style":2,"log_type":1,"src_id":220101058,"trial_step":58,"drawing":1120104},{"step":65,"content":"네 말대로라면 이런 상황이 처음은 아니겠지... 그럼, 파르마 실험실에 있을 때도 이런 일이 있었나?","style":2,"log_type":1,"src_id":220101059,"trial_step":59,"drawing":1120104},{"step":66,"content":"조심스럽게 그 이름을 입 밖으로 내자, 말을 마치기도 전에 갑자기 심문실의 온도가 올라가는 것이 확연히 느껴졌고, 나인티나인의 눈썹이 치켜 올라갔다. 검은 천으로 가려져 있었음에도 그 눈은 여전히 당신을 노려보고 있었다.","style":3,"log_type":1,"src_id":220101060,"trial_step":60,"drawing":1120104},{"step":67,"speaker":"나인티나인","content":"나는 거기에서 매일 주사를 맞고 의식을 잃었지.","voice":["vo_trial_120101_1_61"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101061,"trial_step":61,"drawing":1120104},{"step":68,"speaker":"나인티나인","content":"내 몸이 끓는 물처럼 바글바글 끓어올랐어.","voice":["vo_trial_120101_1_62"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101062,"trial_step":62,"drawing":1120104},{"step":69,"speaker":"나인티나인","content":"그리고 파괴, 또 파괴했어…내가 본 모든 것을...","voice":["vo_trial_120101_1_63"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101063,"trial_step":63,"drawing":1120104},{"step":70,"content":"나인티나인은 그녀가 실험실에서 겪은 일을 담담하게 말하고 있었다. 눈길은 잠시도 당신에게서 떼지 않고, 언제라도 사냥감을 낚아채려는 맹수처럼 보였다.","style":3,"log_type":1,"src_id":220101064,"trial_step":64,"drawing":1120104},{"step":71,"speaker":"나인티나인","content":"놈들의 목적은 알 수 없었지만, 거기에서는…","voice":["vo_trial_120101_1_65"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101065,"trial_step":65,"drawing":1120104},{"step":72,"speaker":"나인티나인","content":"나로인해 만들어진 수많은 나인티나인은, 다 그런 괴물들이야.","voice":["vo_trial_120101_1_66"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101066,"trial_step":66,"drawing":1120104},{"step":73,"content":"그들이...정말 너의 결정체를 이용해 무기를 만들고 있다고?!","style":2,"log_type":1,"src_id":220101067,"trial_step":67,"drawing":1120104},{"step":74,"content":"나인티나인의 말에 파르마 실험실이 한 짓을 차츰 알게 되었고, 나인티나인을 바라보는 당신의 눈에는 떨리는 분노가 확연히 담겨 있었다.","style":3,"log_type":1,"src_id":220101068,"trial_step":68,"drawing":1120104},{"step":75,"content":"그러나 이걸로 끝낼 수는 없다. 파르마 실험실에 대해 더 깊이 이해할 수 있는 기회를 놓칠 수는 없다. 당신은 마음을 가라앉히고 FAC가 건네준 또 다른 자료를 들었다…","style":3,"log_type":1,"src_id":220101069,"trial_step":69,"drawing":1120104},{"step":76,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":77,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":78,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":79,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":80,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":81,"content":"테스트","style":3,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":82,"content":"테스트","style":18,"log_type":1,"src_id":2,"trial_step":70,"course":6,"drawing":1120104},{"step":83,"options":["조금 더 자세히 얘기 나눠보자"],"style":6,"log_type":1,"src_id":220101071,"trial_step":71,"course":3,"drawing":1120104,"choices":[{"text":"조금 더 자세히 얘기 나눠보자","goto":72}]},{"step":84,"content":"피를 뽑는 것 외에 그들이 또 무슨 짓을 했지?","style":2,"log_type":1,"src_id":220101072,"trial_step":72,"drawing":1120104},{"step":85,"speaker":"나인티나인","content":"여기랑 여기, 그리고 여기, 다 분해했다가 다시 조립했어.","voice":["vo_trial_120101_1_73"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101073,"trial_step":73,"drawing":1120104},{"step":86,"speaker":"나인티나인","content":"그리고 싸움을 시켰지… 그런데 실수로 상대방을 죽여버렸어.","voice":["vo_trial_120101_1_74"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101074,"trial_step":74,"drawing":1120104},{"step":87,"speaker":"나인티나인","content":"전투장 벽의 움푹 팬 곳마다 피와 뇌수가 묻어 있었고, 가끔은 부러진 뼈도 있었어.","voice":["vo_trial_120101_1_75"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101075,"trial_step":75,"drawing":1120104},{"step":88,"content":"나인티나인의 목소리에는 광기가 물들어 있었고, 그녀의 말뜻을 들어보면 당신과도 한판 붙겠다는 것 같았다.","style":3,"log_type":1,"src_id":220101076,"trial_step":76,"drawing":1120104},{"step":89,"speaker":"나인티나인","content":"겁나? 내가…... 괴물이라서?","voice":["vo_trial_120101_1_77"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101077,"trial_step":77,"drawing":1120104},{"step":90,"content":"심문실에는 보이지 않는 압박감이 조금씩 당신을 향해 다가왔다. 지금 당신은 '괴물'과 대화를 하고 있는 것이 틀림없다.","style":3,"log_type":1,"src_id":220101078,"trial_step":78,"drawing":1120104},{"step":91,"options":["대체 네 정체가 뭐야?","너는 괴물인가?"],"style":6,"log_type":1,"src_id":220101079,"trial_step":79,"course":3,"drawing":1120104,"choices":[{"text":"대체 네 정체가 뭐야?","goto":80},{"text":"너는 괴물인가?","goto":82}]},{"step":92,"speaker":"나인티나인","content":"나는 나인티나인이지.","voice":["vo_trial_120101_1_80"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101080,"trial_step":80,"drawing":1120104},{"step":93,"speaker":"나인티나인","content":"하지만 괴물이기도 해.","voice":["vo_trial_120101_1_81"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101081,"trial_step":81,"drawing":1120104,"next":[84]},{"step":94,"speaker":"나인티나인","content":"맞아.","voice":["vo_trial_120101_1_82"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101082,"trial_step":82,"drawing":1120104},{"step":95,"speaker":"나인티나인","content":"파르마 실험실엔 전부 괴물뿐이니까.","voice":["vo_trial_120101_1_83"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101083,"trial_step":83,"drawing":1120104,"next":[84]},{"step":96,"options":["그렇다면 엘라 역시 괴물인가?"],"style":6,"log_type":1,"src_id":220101084,"trial_step":84,"course":3,"drawing":1120104,"choices":[{"text":"그렇다면 엘라 역시 괴물인가?","goto":85}]},{"step":97,"speaker":"나인티나인","content":"……","style":1,"log_type":1,"src_id":220101085,"trial_step":85,"drawing":1120104},{"step":98,"content":"동물적 본능이 위험을 알렸다. 나인티나인은 아무 말도 하지 않았지만, 이미 위협을 느끼고 있었다.","style":3,"log_type":1,"src_id":220101086,"trial_step":86,"drawing":1120104},{"step":99,"content":"너… 그녀를 알지?","style":2,"log_type":1,"src_id":220101087,"trial_step":87,"drawing":1120104},{"step":100,"speaker":"나인티나인","content":"알아, 알기만 하는 게 아냐.","voice":["vo_trial_120101_1_88"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101088,"trial_step":88,"drawing":1120104},{"step":101,"speaker":"나인티나인","content":"하지만 그녀는 괴물이 아니야, 나를 비추는 태양이야.","voice":["vo_trial_120101_1_89"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101089,"trial_step":89,"drawing":1120104},{"step":102,"speaker":"나인티나인","content":"그녀는 내 손을 잡고 지하에서 데리고 나가 주었고, 다시 자유를 만끽하게 해줬어.","voice":["vo_trial_120101_1_90"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101090,"trial_step":90,"drawing":1120104},{"step":103,"speaker":"나인티나인","content":"난…… 난 반드시 그녀를 지킬 거야… 쭉…","voice":["vo_trial_120101_1_91"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101091,"trial_step":91,"drawing":1120104},{"step":104,"content":"당신은 몹시 놀랐다. 엘라를 심문할 때 그녀는 나인티나인에 대해 이야기하는 것을 꺼려 했다. 그래서 당신은 항상 엘라가 나인티나인을 극도로 혐오한다고 생각했다. 실제로 그녀는 유달리 원한이 많은 어린 소녀였다.","style":3,"log_type":1,"src_id":220101092,"trial_step":92,"drawing":1120104},{"step":105,"content":"하지만 나인티나인의 말은 당신의 생각을 완전히 뒤집어 놓았다.","style":3,"log_type":1,"src_id":220101093,"trial_step":93,"drawing":1120104},{"step":106,"content":"나인티나인의 호흡이 점점 가빠졌고, 심문실 전체가 찜통이 되는 것 같았다. 하지만 한 줄기 오싹한 기운이 등골을 서늘하게 했다. 그것은 나인티나인이 뱉어낸 살의였다.","style":3,"log_type":1,"src_id":220101094,"trial_step":94,"drawing":1120104},{"step":107,"speaker":"나인티나인","content":"…질문은 끝이야?","voice":["vo_trial_120101_1_95"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101095,"trial_step":95,"drawing":1120104},{"step":108,"content":"뭐?","style":2,"log_type":1,"src_id":220101096,"trial_step":96,"drawing":1120104},{"step":109,"content":"둘 뿐인 심문실에서 나인티나인이 처음으로 질문을 던졌다. 그녀는 단단히 묶여 있었지만 여전히 공포스러웠다.","style":3,"log_type":1,"src_id":220101097,"trial_step":97,"drawing":1120104},{"step":110,"content":"나인티나인이 조용히 허리를 세우더니, 경계등의 불빛을 가렸다.","style":3,"log_type":1,"src_id":220101098,"trial_step":98,"drawing":1120104},{"step":111,"speaker":"나인티나인","content":"이제 내가 물어보지.","voice":["vo_trial_120101_1_99"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101099,"trial_step":99,"drawing":1120104},{"step":112,"speaker":"나인티나인","content":"얼마 전 MBCC에서 대대적인 탈옥 사건이 발생했지? 다들 그 일에 대해 떠들던데.","voice":["vo_trial_120101_1_100"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101100,"trial_step":100,"drawing":1120104},{"step":113,"speaker":"나인티나인","content":"수감자 전원이 신디케이트로 달아났다고 했지만… 난 그녀를 못 찾았어.","voice":["vo_trial_120101_1_101"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101101,"trial_step":101,"drawing":1120104},{"step":114,"speaker":"나인티나인","content":"오랫동안 곳곳을 샅샅이 뒤졌지만, 어디에도 없더군…","voice":["vo_trial_120101_1_102"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101102,"trial_step":102,"drawing":1120104},{"step":115,"speaker":"나인티나인","content":"당신… 엘라의 행방을 알아?","voice":["vo_trial_120101_1_103"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101103,"trial_step":103,"drawing":1120104},{"step":116,"content":"엘라는 MBCC에 있어.","style":2,"log_type":1,"src_id":220101105,"trial_step":105,"drawing":1120104},{"step":117,"content":"그녀 역시 탈옥하려 했지만 실패하고 말았지.","style":2,"log_type":1,"src_id":220101106,"trial_step":106,"drawing":1120104},{"step":118,"speaker":"나인티나인","content":"탈옥에 실패했다고?","voice":["vo_trial_120101_1_107"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101107,"trial_step":107,"drawing":1120104},{"step":119,"content":"감옥 문을 부수지 못했거든. 물론 도망가려고 발버둥치긴 했지만…","style":2,"log_type":1,"src_id":220101108,"trial_step":108,"drawing":1120104},{"step":120,"content":"국장으로서… 수감자가 도주하도록 내버려 둘 수는 없잖아.","style":2,"log_type":1,"src_id":220101109,"trial_step":109,"drawing":1120104},{"step":121,"speaker":"나인티나인","content":"그래서… 당신이 붙잡았어?","voice":["vo_trial_120101_1_110"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101110,"trial_step":110,"drawing":1120104},{"step":122,"content":"아마도…","style":2,"log_type":1,"src_id":220101111,"trial_step":111,"drawing":1120104},{"step":123,"content":"정신을 차려보니 족쇄가 이미 그녀를 옥죄고 있더군.","style":2,"log_type":1,"src_id":220101112,"trial_step":112,"drawing":1120104},{"step":124,"speaker":"나인티나인","content":"그렇군.","voice":["vo_trial_120101_1_113"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101113,"trial_step":113,"drawing":1120104},{"step":125,"content":"나인티나인이 일리가 있다는 듯 고개를 끄덕였다. 그런데…","style":3,"log_type":1,"src_id":220101114,"trial_step":114,"drawing":1120104},{"step":126,"speaker":"나인티나인","content":"엘라는 신디케이트에서 가장 자유로운 녀석이야…","voice":["vo_trial_120101_1_115"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101115,"trial_step":115,"drawing":1120104},{"step":127,"speaker":"나인티나인","content":"갱단의 밀실도, 치안국의 감옥도… 심지어 파르마 실험실도 그녀를 가두지 못했어.","voice":["vo_trial_120101_1_116"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101116,"trial_step":116,"drawing":1120104},{"step":128,"speaker":"나인티나인","content":"그런데 당신에게 붙잡혔다…?","voice":["vo_trial_120101_1_117"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101117,"trial_step":117,"drawing":1120104},{"step":129,"content":"나인티나인의 목소리는 침착했지만 점차 후끈해지는 실내 온도는 그녀가 조만간 폭주할 것을 예고하고 있었다.","style":3,"log_type":1,"src_id":220101119,"trial_step":119,"drawing":1120105},{"step":130,"content":"나인티나인의 온몸에서 김이 나기 시작했고, 순간적으로 상승한 체온이 쇠사슬을 녹여버렸다.","style":3,"log_type":1,"src_id":220101120,"trial_step":120,"drawing":1120105},{"step":131,"content":"등 뒤로 거대한 검은 그림자가 피어올랐다. 그녀는 이미 까맣게 변한 두 손으로 재갈과 안대를 걷어냈다.","style":3,"log_type":1,"src_id":220101121,"trial_step":121,"drawing":1120105},{"step":132,"speaker":"나인티나인","content":"듣자 하니…","voice":["vo_trial_120101_1_120"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101122,"trial_step":122,"drawing":1120100},{"step":133,"speaker":"나인티나인","content":"수감자의 몸에 국장의 족쇄가 채워지면, 어느 한쪽이 죽기전에는 풀지 못한다며…?","voice":["vo_trial_120101_1_121"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101123,"trial_step":123,"drawing":1120100},{"step":134,"content":"순간적으로 나인티나인이 순순히 자수를 하러 온 것이 아닐 수도 있음을 느꼈다.\n그녀는 생각보다 훨씬 더 똑똑한, 정확히는 동물적인 감각이 뛰어난 자였다. 그녀는 당신을 죽이고 엘라를 구출하러 온 것이었다.","style":3,"log_type":1,"src_id":220101124,"trial_step":124,"drawing":1120100},{"step":135,"content":"어두컴컴한 심문실에서 핏빛 루비 같은 두 눈동자가 당신의 목덜미를 응시하고 있다. 가장 연약하고 치명적인 동맥이 있는 곳이었다.","style":3,"log_type":1,"src_id":220101125,"trial_step":125,"drawing":1120100},{"step":136,"content":"위험한 기운이 도처에서 뿜어져 나와 한 발짝도 움직일 수 없었다.","style":3,"log_type":1,"src_id":220101126,"trial_step":126,"drawing":1120100},{"step":137,"speaker":"나인티나인","content":"날 속였군, 국장.","voice":["vo_trial_120101_1_125"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101127,"trial_step":127,"drawing":1120103},{"step":138,"content":"나인티나인이 순식간에 튀어 오르더니, 마치 최상위 포식자가 초식 동물을 향해 달려들듯 당신을 향해 돌진했다. 그녀의 움직임에 주변 공기가 뜨거워졌다.","style":3,"log_type":1,"src_id":220101128,"trial_step":128,"drawing":1120103},{"step":139,"content":"본능적으로 족쇄 능력을 사용해 나인티나인에게 공격 금지 명령을 내렸다.","style":3,"log_type":1,"src_id":220101129,"trial_step":129,"drawing":1120103},{"step":140,"speaker":"나인티나인","content":"이것이 족쇄라는 거군. 이것으로 우리를 속박하는 건가!?","voice":["vo_trial_120101_1_128"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101130,"trial_step":130,"drawing":1120103},{"step":141,"speaker":"나인티나인","content":"바로 이것 때문에 엘라가… 내 곁으로 돌아오지 못하는 거야!","voice":["vo_trial_120101_1_129"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101131,"trial_step":131,"drawing":1120103},{"step":142,"content":"나인티나인은 족쇄의 힘에 짓눌려 무릎을 꿇으면서도 거칠게 반항했다. 고통이 그녀의 분노를 북돋았으며 그녀를 더욱 난폭하게 만들었다.","style":3,"log_type":1,"src_id":220101132,"trial_step":132,"drawing":1120103},{"step":143,"speaker":"나인티나인","content":"이... 구역질나고 비겁한 인간들아!","voice":["vo_trial_120101_1_131"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101133,"trial_step":133,"drawing":1120103},{"step":144,"speaker":"나인티나인","content":"내가 네들도 똑같이 느끼게 해줄 거야… 실험실의 물건따위의 취급을 받는 기분이 어떤지!","voice":["vo_trial_120101_1_132"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101134,"trial_step":134,"drawing":1120103},{"step":145,"content":"족쇄의 속박에도 굴하지 않고 그녀는 끊임없이 공격을 시도했다. 움직임은 충분히 피할 수 있을 만큼 느려졌지만 심문실이 무너지기 시작했다.","style":3,"log_type":1,"src_id":220101135,"trial_step":135,"drawing":1120103},{"step":146,"speaker":"나인티나인","content":"죽일 거야… 당신을 죽이고 엘라를 해방시키겠어!","voice":["vo_trial_120101_1_134"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101136,"trial_step":136,"drawing":1120103},{"step":147,"speaker":"나인티나인","content":"우리는… 자유를 얻을 거야!!!","voice":["vo_trial_120101_1_135"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101137,"trial_step":137,"drawing":1120103},{"step":148,"content":"당신과 그녀를 묶은 족쇄가 윙윙거리며 금방이라도 끊어져 버릴 것 같았다. 나인티나인의 이능력이 안개를 흩뿌리며 당신의 팔을 불태웠다.","style":3,"log_type":1,"src_id":220101138,"trial_step":138,"drawing":1120103},{"step":149,"speaker":"나인티나인","content":"넌 날 막을 수 없어! ! 너는… 반드시 내 손에 죽을 거야!","voice":["vo_trial_120101_1_137"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101139,"trial_step":139,"drawing":1120103},{"step":150,"content":"멈춰, 나인티나인! 계속 이러면, 네가 죽어 버릴 거야!","style":2,"log_type":1,"src_id":220101140,"trial_step":140,"drawing":1120103},{"step":151,"speaker":"나인티나인","content":"난 두렵지 않아, 난 그녀를 원할 뿐이야. 그저 우리가 더 이상 누군가에 속박당하는 고통을 받지 않길 바랄 뿐이야!","voice":["vo_trial_120101_1_139"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101141,"trial_step":141,"drawing":1120103},{"step":152,"content":"켁켁….!","style":2,"log_type":1,"src_id":220101142,"trial_step":142,"drawing":1120103},{"step":153,"content":"족쇄의 진동이 점점 격렬해졌고, 반격의 위력으로 목덜미가 순간 비릿했다.","style":3,"log_type":1,"src_id":220101143,"trial_step":143,"drawing":1120103},{"step":154,"content":"그럼… 넌 그녀만 혼자… 이 세상에 남겨놔도…괜찮겠어……?","style":2,"log_type":1,"src_id":220101144,"trial_step":144,"drawing":1120103},{"step":155,"content":"나인티나인의 공격은 멈추지 않았고, 마지못해 이를 악물고 몇 마디를 짜냈다.","style":3,"log_type":1,"src_id":220101145,"trial_step":145,"drawing":1120103},{"step":156,"speaker":"나인티나인","content":"그녀…살아만 있다면… 나……자유, 후회는 없어.","voice":["vo_trial_120101_1_144"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101146,"trial_step":146,"drawing":1120103},{"step":157,"content":"심문실의 이상 신호를 감지한 나이팅게일이 재빨리 지원군을 요청했지만, 당신은 나인티나인에게 가한 속박을 계속 유지해야 했다. 그렇지 않으면 MBCC가 전멸당할 우려가 있었기 때문이다.","style":3,"log_type":1,"src_id":220101147,"trial_step":147,"drawing":1120103},{"step":158,"content":"나인티나인, 더 이상 능력을 쓰지 마! 변이가 폭주되고 있어! 윽…! 자신이 진정한 괴물로 되어도…상관없는건가?!","style":2,"log_type":1,"src_id":220101148,"trial_step":148,"drawing":1120103},{"step":159,"speaker":"나인티나인","content":"맞아! 난 괴물이야! 엘라를 놓아줘!!!","voice":["vo_trial_120101_1_147"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101149,"trial_step":149,"drawing":1120103},{"step":160,"content":"나인티나인의 이변은 오히려 빨라지고 있었고, 변이는 계속해서 그녀를 잠식하고 있었다. 게다가 그녀에게 족쇄를 사용한 당신 역시 큰 정신적 압박을 받았다.","style":3,"log_type":1,"src_id":220101150,"trial_step":150,"drawing":1120103},{"step":161,"content":"그러나 나인티나인은 이런 고통에 매우 익숙해져 있는 듯, 몸부림치며 한 걸음 한 걸음 당신의 앞으로 다가와 당신의 목을 졸랐다.","style":3,"log_type":1,"src_id":220101151,"trial_step":151,"drawing":1120103},{"step":162,"speaker":"나인티나인","content":"다시 한 번 말한다, 엘라를 내게 돌려줘!","voice":["vo_trial_120101_1_150"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101152,"trial_step":152,"drawing":1120103},{"step":163,"content":"나이팅게일과 지원군이 그녀를 향해 총을 쏘았지만 그녀의 몸에 박힌 총알은 끓는 피에 금세 밀려나갔고, 당신의 목을 조르던 손은 여전히 풀리지 않았다. 점차 의식이 흐려지는 것이 느껴졌다.","style":3,"log_type":1,"src_id":220101153,"trial_step":153,"drawing":1120103},{"step":164,"speaker":"나이팅게일","content":"쯧, 연결해…!","style":1,"log_type":1,"src_id":220101154,"trial_step":154,"drawing":1120103},{"step":165,"speaker":"심문 무전","content":"하지마, 나인티나인!!! 그를 죽이지 마!!","female_content":"하지마, 나인티나인!!! 그녀를 죽이지 마!!","style":11,"log_type":1,"src_id":220101155,"trial_step":155,"drawing":1120103},{"step":166,"speaker":"나인티나인","content":"?!","style":1,"log_type":1,"src_id":220101156,"trial_step":156,"drawing":1120102},{"step":167,"content":"무전기에서 들려오는 소리에 나인티나인은 공격을 멈춘 채 멍하니 있었고, 당신은 자신을 옥죄던 힘이 느슨해지는 것을 느꼈다.","style":3,"log_type":1,"src_id":220101157,"trial_step":157,"drawing":1120102},{"step":168,"speaker":"나인티나인","content":"너… 너 어디 있어?","voice":["vo_trial_120101_1_156"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101158,"trial_step":158,"drawing":1120102},{"step":169,"content":"나인티나인은 익숙한 목소리를 듣고 막연히 소리의 근원지를 향해 걸어갔고, 나이팅게일은 그녀의 허점을 공략해 고압의 전기 충격을 가한 후 목에 강력한 마취제를 주입했다.","style":3,"log_type":1,"src_id":220101159,"trial_step":159,"drawing":1120102},{"step":170,"content":"나인티나인이 쓰러지면서 금속 의자에 부딪혀 큰소리가 전해지자, 무전기 반대쪽에서 갑자기 화난 외침이 들려왔다.","style":3,"log_type":1,"src_id":220101160,"trial_step":160},{"step":171,"speaker":"심문 무전","content":"나인티나인? 나인티나인 왜 그래? 이 자식들아, 그녀에게 도대체 무슨 짓을 한 거야?!! 날 놔줘, 놓으라고!! 나인티나인…!!!!","style":11,"log_type":1,"src_id":220101161,"trial_step":161},{"step":172,"content":"나이팅게일이 무전을 끊었지만, 당신은 그 소리가 누구인지 알아차릴 수 있었다. 엘라의 목소리였다.","style":3,"log_type":1,"src_id":220101162,"trial_step":162},{"step":173,"content":"그제야 나인티나인의 체온이 떨어지기 시작했고, 그대로 의식을 잃었다. 상부 보고를 거친 뒤, 나인티나인은 한층 더 삼엄한 수감실로 압송되었다.","style":3,"log_type":1,"src_id":220101163,"trial_step":163},{"step":174,"content":"나이팅게일! 결과는?!","style":2,"background":1017,"log_type":1,"src_id":220101164,"trial_step":164},{"step":175,"speaker":"나이팅게일","content":"수감자 나인티나인의 폭주로 인해 FAC가 그녀의 조사에 개입했습니다.","style":1,"background":1017,"log_type":1,"src_id":220101165,"trial_step":165},{"step":176,"speaker":"나이팅게일","content":"나인티나인은 오랫동안 실험 대상으로 살아왔고, 또한 지난번 임무 수행 중 블랙워터 지하에서 이변의 영향을 받았습니다.","style":1,"background":1017,"log_type":1,"src_id":220101166,"trial_step":166},{"step":177,"speaker":"나이팅게일","content":"이미 사지가 괴변화하는 중이며, 점점 온몸으로 퍼지고 있습니다.","style":1,"background":1017,"log_type":1,"src_id":220101167,"trial_step":167},{"step":178,"speaker":"나이팅게일","content":"투옥 당시 이미 1차 감염 단계를 넘었고, 현재 2차 감염으로 치닫고 있습니다.","style":1,"background":1017,"log_type":1,"src_id":220101168,"trial_step":168},{"step":179,"speaker":"나이팅게일","content":"국장님도 느끼셨겠지만, 족쇄로는 더 이상 그녀의 이변을 막을 수 없습니다.","style":1,"background":1017,"log_type":1,"src_id":220101169,"trial_step":169},{"step":180,"speaker":"나이팅게일","content":"그녀는 곧 완전한 괴변체가 될 것이고, 그때는 국장님의 의식 또한 더욱 심각하게 오염시킬 겁니다.","style":1,"background":1017,"log_type":1,"src_id":220101170,"trial_step":170},{"step":181,"speaker":"나이팅게일","content":"FAC는 국장님의 생명에 위협을 가하는 그 어떤 요소도 허락하지 않겠다는 입장입니다.","style":1,"background":1017,"log_type":1,"src_id":220101171,"trial_step":171},{"step":182,"content":"그래서, 어쩌겠다는 거지…?","style":2,"background":1017,"log_type":1,"src_id":220101172,"trial_step":172},{"step":183,"speaker":"나이팅게일","content":"…수감자 나인티나인은 사형에 처해질 예정입니다.","style":1,"background":1017,"log_type":1,"src_id":220101173,"trial_step":173},{"step":184,"content":"유감이군. 당시 탈옥자가 너무 많았거든.","style":2,"log_type":1,"src_id":220101177,"trial_step":177,"drawing":1120104},{"step":185,"content":"엘라의 행방은 우리도 알 수 없었어.","style":2,"log_type":1,"src_id":220101178,"trial_step":178,"drawing":1120104},{"step":186,"speaker":"나인티나인","content":"……","style":1,"log_type":1,"src_id":220101179,"trial_step":179,"drawing":1120104},{"step":187,"speaker":"나인티나인","content":"…………","style":1,"log_type":1,"src_id":220101180,"trial_step":180,"drawing":1120104},{"step":188,"speaker":"나인티나인","content":"아니, 당신이 붙잡았잖아.","voice":["vo_trial_120101_1_179"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101181,"trial_step":181,"drawing":1120104},{"step":189,"speaker":"나인티나인","content":"엘라는… 신디케이트에서 가장 자유로운 녀석이야… 그렇게 쉽게 속박을 허용하지 않는다고.","voice":["vo_trial_120101_1_180"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101182,"trial_step":182,"drawing":1120104},{"step":190,"content":"당신의 대답은 나인티나인을 자극한 것이 분명했다. 그녀의 감정 상태가 불안정해지나 싶더니, 급격한 분노를 표출하기 시작했다.","style":3,"log_type":1,"src_id":220101183,"trial_step":183,"drawing":1120104},{"step":191,"content":"순식간에 상승한 체온은 쇠사슬마저 끊어냈다.","style":3,"log_type":1,"src_id":220101185,"trial_step":185,"drawing":1120105},{"step":192,"speaker":"나인티나인","content":"엘라가 돌아오지 않는 건… 전부 당신 때문이야!","voice":["vo_trial_120101_1_183"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101186,"trial_step":186,"drawing":1120105},{"step":193,"content":"나인티나인의 등 뒤에서 거대한 검은 그림자가 계속해서 피어올랐다. 그녀가 새까맣게 변한 두 손으로 손쉽게 재갈과 안대를 걷어냈다.","style":3,"log_type":1,"src_id":220101187,"trial_step":187,"drawing":1120105},{"step":194,"speaker":"나인티나인","content":"결국 너가 엘라를 가둔거야!","voice":["vo_trial_120101_1_185"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101188,"trial_step":188,"drawing":1120103},{"step":195,"speaker":"나인티나인","content":"당신을 죽여버리겠어.","voice":["vo_trial_120101_1_186"],"voice_bank":"vo_jiushijiu_trial","style":1,"log_type":1,"src_id":220101189,"trial_step":189,"drawing":1120103}]}