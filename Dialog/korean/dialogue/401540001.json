{"id":401540001,"chapter_id":50045,"scene_id":45002,"steps":[{"step":1,"speaker":"음유시인","content":"~~~~","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":2,"speaker":"음유시인","content":"'한해의 끝자락 깊은 밤에 화려한 옷차림의 사람들이 발걸음하네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":3,"speaker":"음유시인","content":"'일 년에 단 한 번 오픈하는 신비로운 극장.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":4,"speaker":"음유시인","content":"'눈이 내리는 것 때문인가, 달빛이 차가운 것 때문인가?'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":5,"speaker":"음유시인","content":"'방문객의 흔들리는 마음이 보이네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":6,"speaker":"음유시인","content":"'전설적인 악장이 문틈으로 새어 나오고.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":7,"speaker":"음유시인","content":"'그대 또한 해방을 모색하는가?'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":8,"speaker":"음유시인","content":"'주저하지 말라, 주저하지 말라.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":9,"speaker":"음유시인","content":"'장막을 장식한 금빛 태슬이 바닥을 스치네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":10,"speaker":"음유시인","content":"'주저하지 말라, 주저하지 말라.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":11,"speaker":"음유시인","content":"'막이 오르고 첫 번째 극이 시작되네.'","style":1,"background":1069,"is_centered":true,"log_type":1}]}