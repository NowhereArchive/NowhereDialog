{"id":1060403,"chapter_id":1060403,"scene_id":1,"steps":[{"step":1,"speaker":"??","content":"젊은 나이에 희생되다니… 딸이 불쌍하게 됐어.","voice":["vo_trial_60403_1_1"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403002,"trial_step":2},{"step":2,"speaker":"?","content":"어쩌다가 그렇게 된 거야?","voice":["vo_trial_60403_1_2"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403003,"trial_step":3},{"step":3,"speaker":"??","content":"글쎄, 아무런 정보도 공개하지 않을 생각인가 봐. 심지어 이름조차 표기하지 않았어.","voice":["vo_trial_60403_1_3"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403004,"trial_step":4},{"step":4,"speaker":"??","content":"사람을 보내 훈장 하나만 수여했을 뿐이지.","voice":["vo_trial_60403_1_4"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403005,"trial_step":5},{"step":5,"speaker":"?","content":"에휴, 그래도 어떻게 보면 명예로운 죽음이지. 디스를 위해 목숨을 바쳤으니, 무의미한 죽음은 아니잖아?","voice":["vo_trial_60403_1_5"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403006,"trial_step":6},{"step":6,"content":"여자아이가 추모하는 행인을 거칠게 쫓아냈다.","style":3,"background":4189001,"log_type":1,"src_id":160403007,"trial_step":7},{"step":7,"speaker":"코쿠리코","content":"가! 가라고! 당신들 추모 따윈 필요 없어!","voice":["vo_trial_60403_1_7"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403008,"trial_step":8},{"step":8,"speaker":"코쿠리코","content":"하… 당신들의 노력, 당신들의 이름, 아무도 기억해 주지 않을 거야!","voice":["vo_trial_60403_1_8"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403009,"trial_step":9},{"step":9,"content":"여자아이가 묘지 앞에 있는 개양귀비를 걷어차며 화풀이했다.","style":3,"background":4189001,"log_type":1,"src_id":160403010,"trial_step":10},{"step":10,"content":"FAC 훈장 뒤에 있던 씨앗이었다. 씨앗은 훈장과 함께 깜깜한 흙 속에 파묻혀졌다.","style":3,"background":4189001,"log_type":1,"src_id":160403011,"trial_step":11},{"step":11,"speaker":"코쿠리코","content":"정말 다른 사람의 목숨이 자기 목숨보다 더 가치 있다고 생각한 거야?","voice":["vo_trial_60403_1_11"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403012,"trial_step":12},{"step":12,"speaker":"코쿠리코","content":"그건 대체 누가 정한 거지? 무슨 근거로?","voice":["vo_trial_60403_1_12"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403013,"trial_step":13},{"step":13,"content":"여자아이가 차갑게 웃으며 손톱으로 손목을 긁어 상처를 냈다. 그러자 기이한 검은 연기가 뿜어져 나왔다.","style":3,"background":4189001,"log_type":1,"src_id":160403014,"trial_step":14},{"step":14,"speaker":"코쿠리코","content":"이봐, 냄새나는 놈, 넌 날 삼키고 싶은 거지?","voice":["vo_trial_60403_1_14"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403015,"trial_step":15},{"step":15,"speaker":"변이","content":"…","style":1,"background":4189001,"log_type":1,"src_id":160403016,"trial_step":16},{"step":16,"speaker":"코쿠리코","content":"좋을 대로 해. 대신 나랑 거래 하나 하자.","voice":["vo_trial_60403_1_16"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403017,"trial_step":17},{"step":17,"speaker":"코쿠리코","content":"난 다른 사람을 위한 의미 없는 희생양 따윈 되고 싶지 않아, 그 누구도 내 목숨을 이용하게 내버려 둘 순 없어.","voice":["vo_trial_60403_1_17"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403018,"trial_step":18},{"step":18,"speaker":"코쿠리코","content":"강해져야만… 나를 위해 살아갈 수 있어.","voice":["vo_trial_60403_1_18"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4189001,"log_type":1,"src_id":160403019,"trial_step":19},{"step":19,"speaker":"주요 인사","content":"왜…","voice":["vo_trial_60403_1_20"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403021,"trial_step":21},{"step":20,"speaker":"코쿠리코","content":"왜냐니? 돈을 받았으니까 일을 하는 거지, 암살자로서 당연한 도리 아니야?","voice":["vo_trial_60403_1_21"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403022,"trial_step":22},{"step":21,"speaker":"주요 인사","content":"…하! 그래… 돈만 받으면 뭐든 시키는 대로 하는 미친 것들이군!","voice":["vo_trial_60403_1_22"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403023,"trial_step":23},{"step":22,"speaker":"코쿠리코","content":"아? 그럼 당신들이 디스의 안정을 위해 미친놈의 변이 이능력에 희생당한 거라고 하면, 더 가치 있는 죽음이 되려나? '귀빈' 여러분?","voice":["vo_trial_60403_1_23"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403024,"trial_step":24},{"step":23,"content":"암살자는 그들의 답을 기다려 주지 않았다. 골목은 금세 피비린내로 진동했다.","style":3,"background":4190001,"log_type":1,"src_id":160403025,"trial_step":25},{"step":24,"speaker":"코쿠리코","content":"뭐야, 내가 이렇게 화려한 솜씨를 보여줬는데, 아무도 안 웃어?","voice":["vo_trial_60403_1_25"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403026,"trial_step":26},{"step":25,"speaker":"코쿠리코","content":"당신들이 가장 좋아하는 '명예'를 줬잖아? 그럼 좋아해야 하는 거 아닌가?","voice":["vo_trial_60403_1_26"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403027,"trial_step":27},{"step":26,"content":"코쿠리코는 손가락으로 억지로 굳어 있는 얼굴을 미소 짓게 만들더니, 이내 짜증 내며 손을 뗐다.","style":3,"background":4190001,"log_type":1,"src_id":160403028,"trial_step":28},{"step":27,"speaker":"코쿠리코","content":"당신들은 다른 이들에게 절망과 고통, 그리고 슬픔을 줬어, 난 단지 당신들도 그걸 느껴보게 했을 뿐이야.","voice":["vo_trial_60403_1_28"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403029,"trial_step":29},{"step":28,"speaker":"코쿠리코","content":"그래야 모두가 공평한 디스시티가 되는 거지, 하하하하하… 쿨럭쿨럭!","voice":["vo_trial_60403_1_29"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403030,"trial_step":30},{"step":29,"content":"감정이 격해지자 고통이 몰려왔지만, 코쿠리코는 이미 이능력으로 인한 고통에 익숙해진 듯 아무렇지 않게 입가를 닦고 피바다 속에 씨앗을 하나 묻었다.","style":3,"background":4190001,"log_type":1,"src_id":160403031,"trial_step":31},{"step":30,"speaker":"코쿠리코","content":"그때 그 허울뿐인 표창은 이제 돌려주지~","voice":["vo_trial_60403_1_31"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4190001,"log_type":1,"src_id":160403032,"trial_step":32},{"step":31,"content":"왜소한 실루엣이 어두운 골목 끝에서 사라졌다.","style":3,"background":4190001,"log_type":1,"src_id":160403033,"trial_step":33},{"step":32,"content":"열 송이? 백 송이? 천 송이? 코쿠리코는 자신이 피운 개양귀비가 얼마나 되는지도 잊은 지 오래였다.","style":1,"background":10006,"log_type":1,"src_id":160403034,"trial_step":34},{"step":33,"speaker":"코쿠리코","content":"화원의 의뢰든, 숙명으로 만난 원수든… 난 전부 해치울 수 있어.","voice":["vo_trial_60403_1_34"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403035,"trial_step":35},{"step":34,"content":"코쿠리코는 마침내 복수의 핵심을 건드렸다.","style":3,"background":10006,"log_type":1,"src_id":160403036,"trial_step":36},{"step":35,"speaker":"사부님","content":"성공했어?","voice":["vo_trial_60403_1_37"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403038,"trial_step":38},{"step":36,"speaker":"코쿠리코","content":"네.","voice":["vo_trial_60403_1_38"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403039,"trial_step":39},{"step":37,"speaker":"사부님","content":"그 사람인 건 확인했고?","voice":["vo_trial_60403_1_39"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403040,"trial_step":40},{"step":38,"speaker":"코쿠리코","content":"확인했어요. 부모님이 참여하신 작전의 주요 책임자였어요.","voice":["vo_trial_60403_1_40"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403041,"trial_step":41},{"step":39,"speaker":"사부님","content":"좋아, 요 몇 년 동안 고생 많았어. 푹 좀 쉬어.","voice":["vo_trial_60403_1_41"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403042,"trial_step":42},{"step":40,"speaker":"코쿠리코","content":"…","style":1,"background":4191001,"log_type":1,"src_id":160403043,"trial_step":43},{"step":41,"speaker":"사부님","content":"왜, 내 계획이 마음에 안 들어?","voice":["vo_trial_60403_1_43"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403044,"trial_step":44},{"step":42,"speaker":"코쿠리코","content":"제가 며칠 비운 동안 화원에 사람이 많이 줄었네요?","voice":["vo_trial_60403_1_44"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403045,"trial_step":45},{"step":43,"speaker":"사부님","content":"맞아, 지하에서 위험한 임무를 의뢰했어. 큰 그림을 위해 몇몇은 미끼로 삼아야 했지.","voice":["vo_trial_60403_1_45"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403046,"trial_step":46},{"step":44,"speaker":"사부님","content":"결국 목적을 달성했으니, 그 애들이 헛되게 죽은 건 아니야.","voice":["vo_trial_60403_1_46"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403047,"trial_step":47},{"step":45,"content":"이제 어린 티를 벗은 암살자는 말없이 손끝에 묻은 먼지를 불었다.","style":3,"background":4191001,"log_type":1,"src_id":160403048,"trial_step":48},{"step":46,"speaker":"사부님","content":"지하를 위해 희생한 건, 암살자로서 명예로운 일이야.","voice":["vo_trial_60403_1_48"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403049,"trial_step":49},{"step":47,"speaker":"사부님","content":"코쿠리코, 널 지지해 주고, 훈련 시켜주고, 네가 복수할 수 있도록 정보를 수집해 준 게 화원이라는 사실을 잊지 마.","voice":["vo_trial_60403_1_49"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403050,"trial_step":50},{"step":48,"speaker":"사부님","content":"언젠가는 너도…","voice":["vo_trial_60403_1_50"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403051,"trial_step":51},{"step":49,"speaker":"코쿠리코","content":"나도 당신들 계획을 위해 희생되어야 하는 건가?","voice":["vo_trial_60403_1_51"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403052,"trial_step":52},{"step":50,"speaker":"코쿠리코","content":"난 화원이 수감자를 받아주길래 얼마나 좋은 곳인가 했는데… 역시 다 똑같았어.","voice":["vo_trial_60403_1_52"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403053,"trial_step":53},{"step":51,"speaker":"코쿠리코","content":"당신들의 야망에 화원 사람들이 무슨 상관이지?","voice":["vo_trial_60403_1_53"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4191001,"log_type":1,"src_id":160403054,"trial_step":54},{"step":52,"speaker":"코쿠리코","content":"빛이 없는 곳에 관심이 많아 보이네, 그렇다면 내가 직접 보내주지.","voice":["vo_trial_60403_1_55"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4192001,"log_type":1,"src_id":160403056,"trial_step":56},{"step":53,"speaker":"코쿠리코","content":"나 혼자서만 감동하는 그런 우스운 사람이 되지 않을 거야. 내 꽃송이들도…","voice":["vo_trial_60403_1_56"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4192001,"log_type":1,"src_id":160403057,"trial_step":57},{"step":54,"speaker":"코쿠리코","content":"똑같아.","voice":["vo_trial_60403_1_57"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4192001,"log_type":1,"src_id":160403058,"trial_step":58},{"step":55,"speaker":"가로파노","content":"더는 가족을 잃고 싶지 않아요…","voice":["vo_trial_60403_1_59"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403060,"trial_step":60},{"step":56,"speaker":"코쿠리코","content":"화원이 네 집이야, 내가 가족을 만들어 줄게.","voice":["vo_trial_60403_1_60"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403061,"trial_step":61},{"step":57,"speaker":"시슬","content":"그 사람은 벌을 받아야 해요!","voice":["vo_trial_60403_1_61"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403062,"trial_step":62},{"step":58,"speaker":"코쿠리코","content":"그럼 최고의 벌을 줘, 내가 가르쳐주지.","voice":["vo_trial_60403_1_62"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403063,"trial_step":63},{"step":59,"speaker":"월하미인","content":"더 강해질 거예요, 아무도 저를 짓밟지 못하도록요!","voice":["vo_trial_60403_1_63"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403064,"trial_step":64},{"step":60,"speaker":"코쿠리코","content":"그럼 날 이겨 봐, 날 죽이던가.","voice":["vo_trial_60403_1_64"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403065,"trial_step":65},{"step":61,"speaker":"진","content":"용서해 주세요, 다시 그 사람을 따라야 할 것 같습니다.","voice":["vo_trial_60403_1_65","vo_trial_60403_1_65f"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403066,"trial_step":66},{"step":62,"speaker":"코쿠리코","content":"하, 네 전부를 다른 사람에게 걸면, 배신당할 게 두렵지도 않아?","voice":["vo_trial_60403_1_66"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403067,"trial_step":67},{"step":63,"speaker":"진","content":"…상관없어요.","voice":["vo_trial_60403_1_67"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403068,"trial_step":68},{"step":64,"speaker":"코쿠리코","content":"후회하지 마.","voice":["vo_trial_60403_1_68"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403069,"trial_step":69},{"step":65,"content":"가서 마음껏 이루고, 마음껏 복수해! 내 꽃, 내 화원이라면 자유롭게 마음껏 자라야 해.","voice":["vo_trial_60403_1_69"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403070,"trial_step":70},{"step":66,"content":"방해되는 잡초는 없애버리면 돼.","voice":["vo_trial_60403_1_70"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403071,"trial_step":71},{"step":67,"speaker":"변이","content":"크아아…","style":1,"background":4193,"log_type":1,"src_id":160403073,"trial_step":73},{"step":68,"content":"<color=#7683a2><i>시간이 다 됐네, 날 데려갈 거야?</i></color>","voice":["vo_trial_60403_1_73"],"voice_bank":"vo_coquelicot_trial","style":3,"background":4193,"log_type":1,"src_id":160403074,"trial_step":74},{"step":69,"content":"<color=#7683a2><i>조금만 더 기다려 줘…</i></color>","voice":["vo_trial_60403_1_74"],"voice_bank":"vo_coquelicot_trial","style":3,"background":4193,"log_type":1,"src_id":160403075,"trial_step":75},{"step":70,"content":"무엇을 기다리는지는 코쿠리코 자신도 확실하지 않았다.","style":3,"background":4193,"log_type":1,"src_id":160403076,"trial_step":76},{"step":71,"content":"코쿠리코는 의식의 마지막 꽃밭에 가만히 누워 자신의 일생을 돌아보고 있을 뿐이었다.","style":3,"background":4193,"log_type":1,"src_id":160403077,"trial_step":77},{"step":72,"content":"증오, 혼돈, 포악함, 난폭함… 이게 코쿠리코의 전부인가 보다.","style":3,"background":4193,"log_type":1,"src_id":160403078,"trial_step":78},{"step":73,"content":"삶의 마지막 순간도 함께 죽는 심문 해프닝으로 끝을 맺었다.","style":3,"background":4193,"log_type":1,"src_id":160403079,"trial_step":79},{"step":74,"content":"<color=#7683a2><i>그 질문에는 끝까지 대답을 안 해줬네…</i></color>","voice":["vo_trial_60403_1_79","vo_trial_60403_1_79f"],"voice_bank":"vo_coquelicot_trial","style":3,"background":4193,"log_type":1,"src_id":160403080,"trial_step":80},{"step":75,"content":"'의뢰를 수락하고, 지하를 노출하고, 자발적으로 체포되고, 지금은 또 족쇄의 한계를 시험해 보고 있어… '\n'정말로 아무런 계획 없이 움직였던 거 맞아??'","style":2,"background":4193,"log_type":1,"src_id":160403081,"trial_step":81},{"step":76,"content":"<color=#7683a2><i>국장 녀석, 나한테 그렇게 많은 변이를 받았으니, 얼마 못 가 결국 죽고 말겠지.</i></color>","voice":["vo_trial_60403_1_81"],"voice_bank":"vo_coquelicot_trial","style":3,"background":4193,"log_type":1,"src_id":160403082,"trial_step":82},{"step":77,"content":"<color=#7683a2><i>내 대답을 들을 수도 없겠군, 나도… 딱히 대답할 필요 없고.</i></color>","voice":["vo_trial_60403_1_82","vo_trial_60403_1_82f"],"voice_bank":"vo_coquelicot_trial","style":3,"background":4193,"log_type":1,"src_id":160403083,"trial_step":83},{"step":78,"speaker":"코쿠리코","content":"낙원과 지하는 일단 화원이 전멸한 줄 알고 있어, 마지막 위협인 족쇄는 내가 해결했고. 내 화원은…","voice":["vo_trial_60403_1_83"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403084,"trial_step":84},{"step":79,"speaker":"코쿠리코","content":"이제 걱정할 필요 없어.","voice":["vo_trial_60403_1_84"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403085,"trial_step":85},{"step":80,"speaker":"코쿠리코","content":"아무것도…","voice":["vo_trial_60403_1_85"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403086,"trial_step":86},{"step":81,"speaker":"가로파노","content":"그 누구도 그들을 해치지 못하게 할 거야… 날 이용할 생각 꿈도 꾸지 마…","voice":["vo_trial_60403_1_128"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403088,"trial_step":88},{"step":82,"speaker":"가로파노","content":"…으앗!!!","voice":["vo_trial_60403_1_129"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403089,"trial_step":89},{"step":83,"content":"<color=#7683a2><i>이건…</i></color>","voice":["vo_trial_60403_1_89"],"voice_bank":"vo_coquelicot_trial","style":3,"background":4193,"log_type":1,"src_id":160403090,"trial_step":90},{"step":84,"speaker":"시슬","content":"죄송해요… 사부님… 제가 잘못했어요, 용서해 주세요…","voice":["vo_trial_60403_1_90"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403091,"trial_step":91},{"step":85,"speaker":"코쿠리코","content":"또야?! 울긴 왜 울어?","voice":["vo_trial_60403_1_91"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403092,"trial_step":92},{"step":86,"speaker":"코쿠리코","content":"내가 몇 번을 말해! 제멋대로 움직이지 말라고! 다른 사람한테 신경 끄라고!","voice":["vo_trial_60403_1_92"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403093,"trial_step":93},{"step":87,"speaker":"코쿠리코","content":"난 틈만 나면 널 가둬두는 나쁜 여자일 뿐이야. 그러니까 나한테 그만 좀 매달려, 내가 네 엄마도 아니고.","voice":["vo_trial_60403_1_93"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403094,"trial_step":94},{"step":88,"speaker":"시슬","content":"안 돼, 안 돼요… 저는…","voice":["vo_trial_60403_1_94"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403095,"trial_step":95},{"step":89,"speaker":"월하미인","content":"아직 사부님을 이기진 못했어요! 아직 화원의 가장 강한 꽃이 되지 못했어요!","voice":["vo_trial_60403_1_95"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403096,"trial_step":96},{"step":90,"content":"<color=#7683a2><i>왜 이제 와서 이런 기억들이 떠오르는 거지?</i></color>","voice":["vo_trial_60403_1_96"],"voice_bank":"vo_coquelicot_trial","style":3,"background":4193,"log_type":1,"src_id":160403097,"trial_step":97},{"step":91,"speaker":"화원 암살자","content":"사부님, 저희가 엄호할 테니 우선 피하세요.","voice":["vo_trial_60401_1_84"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4193,"log_type":1,"src_id":160403098,"trial_step":98},{"step":92,"content":"<color=#7683a2><i>대체 왜 마지막 순간에…</i></color>","voice":["vo_trial_60403_1_98"],"voice_bank":"vo_coquelicot_trial","style":3,"background":4193,"log_type":1,"src_id":160403099,"trial_step":99},{"step":93,"content":"<color=#7683a2><i>이런 기억을 봐야 하는 거야?</i></color>","voice":["vo_trial_60403_1_99"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4194,"log_type":1,"src_id":160403100,"trial_step":100},{"step":94,"speaker":"코쿠리코","content":"웃기는군… 마지막까지 걱정하는 건가? 지금까지 모든 건 다 혼자 해냈는데, 어떻게 이런 기억들이…","voice":["vo_trial_60403_1_100"],"voice_bank":"vo_coquelicot_trial","style":1,"background":4194,"log_type":1,"src_id":160403101,"trial_step":101},{"step":95,"speaker":"???","content":"그럼 왜 아직도 여기에 남으셔서…","voice":["vo_trial_60403_1_101"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403102,"trial_step":102},{"step":96,"speaker":"진","content":"저희가 나타나길 기다리시는 거죠?","voice":["vo_trial_60403_1_102"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403103,"trial_step":103},{"step":97,"speaker":"코쿠리코","content":"?!","voice":["vo_trial_60403_1_103"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403104,"trial_step":104},{"step":98,"speaker":"진","content":"정말로… 걱정 안 하셨어요?","voice":["vo_trial_60403_1_104"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403105,"trial_step":105},{"step":99,"speaker":"진","content":"사부님…","voice":["vo_trial_60403_1_105"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403106,"trial_step":106},{"step":100,"speaker":"가로파노","content":"사부님?","voice":["vo_trial_60403_1_106"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403107,"trial_step":107},{"step":101,"speaker":"심전계","content":"<color=#7683a2><size=30>'삐… 삐…'</size></color>","style":11,"background":10006,"log_type":1,"src_id":160403108,"trial_step":108},{"step":102,"speaker":"??","content":"<color=#7683a2><size=30>의료팀, 어떻게 된 거야?</size></color>","style":11,"background":10006,"log_type":1,"src_id":160403109,"trial_step":109},{"step":103,"speaker":"의료팀","content":"<color=#7683a2><size=30>의식이 돌아왔어요! 효과가 있어요!</size></color>","voice":["vo_trial_60403_1_109"],"voice_bank":"vo_coquelicot_trial","style":11,"background":10006,"log_type":1,"src_id":160403110,"trial_step":110},{"step":104,"speaker":"의료팀","content":"<color=#7683a2><size=30>그런데… 계속 이렇게 하다간 국장님 몸이…!</size></color>","voice":["vo_trial_60403_1_110"],"voice_bank":"vo_coquelicot_trial","style":11,"background":10006,"log_type":1,"src_id":160403111,"trial_step":111},{"step":105,"content":"<color=#7683a2><size=30>괜찮아, 다 생각이 있어. 계속해, 코쿠리코 몸 안에 있는 모든 변이를 내게 옮겨.</size></color>","style":11,"background":10006,"log_type":1,"src_id":160403112,"trial_step":112},{"step":106,"speaker":"월하미인","content":"저기!","voice":["vo_trial_60403_1_112"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403113,"trial_step":113},{"step":107,"speaker":"시슬","content":"제가 잘못했어요!","voice":["vo_trial_60403_1_113"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403114,"trial_step":114},{"step":108,"speaker":"화원 암살자","content":"코쿠리코 님…","voice":["vo_trial_60403_1_114"],"voice_bank":"vo_coquelicot_trial","style":1,"background":10006,"log_type":1,"src_id":160403115,"trial_step":115},{"step":109,"speaker":"심전계","content":"<color=#7683a2><size=30>'삐삐삐…'</size></color>","style":11,"background":10006,"log_type":1,"src_id":160403116,"trial_step":116},{"step":110,"speaker":"의료팀","content":"<color=#7683a2><size=30>심박수와 혈압을 확인해 주세요!</size></color>","voice":["vo_trial_60403_1_116"],"voice_bank":"vo_coquelicot_trial","style":11,"background":10006,"log_type":1,"src_id":160403117,"trial_step":117},{"step":111,"speaker":"의료팀","content":"<color=#7683a2><size=30>전부 정상으로 돌아왔어요!</size></color>","voice":["vo_trial_60403_1_117"],"voice_bank":"vo_coquelicot_trial","style":11,"background":10006,"log_type":1,"src_id":160403118,"trial_step":118},{"step":112,"speaker":"의료팀","content":"<color=#7683a2><size=30>국장님, 족쇄가 감당할 수 없을 만큼의 변이를 흡수하셨습니다!</size></color>","voice":["vo_trial_60403_1_118"],"voice_bank":"vo_coquelicot_trial","style":11,"background":10006,"log_type":1,"src_id":160403119,"trial_step":119},{"step":113,"content":"<color=#7683a2><size=30>계속해!</size></color>","style":11,"background":10006,"log_type":1,"src_id":160403120,"trial_step":120},{"step":114,"content":"<color=#7683a2><size=35>코쿠리코는 삶에 대한 끈을 놓지 않았어.</size></color>","style":11,"background":10006,"log_type":1,"src_id":160403121,"trial_step":121},{"step":115,"content":"<color=#7683a2>…코쿠리코가 깨어나길 기다리는 사람도 있고.</color>","style":11,"background":10006,"log_type":1,"src_id":160403122,"trial_step":122},{"step":116,"content":"<color=#7683a2><i>홀로 피어난 개양귀비가 얼마나 아름다운데… 어떤 바보가 나를 위해 자꾸 쓸데없는 짓을 하네…</i></color>","voice":["vo_trial_60403_1_123"],"voice_bank":"vo_coquelicot_trial","style":3,"background":1027,"log_type":1,"src_id":160403124,"trial_step":124},{"step":117,"content":"<color=#7683a2><i>이번이야말로… 질문에 대한 답을 할 기회인가?</i></color>","voice":["vo_trial_60403_1_124","vo_trial_60403_1_124f"],"voice_bank":"vo_coquelicot_trial","style":3,"background":1027,"log_type":1,"src_id":160403125,"trial_step":125},{"step":118,"speaker":"${PlayerName}","content":"'의뢰를 수락하고, 지하를 노출하고, 자발적으로 체포되고, 지금은 또 족쇄의 한계를 시험해 보고 있어… '\n'정말로 아무런 계획 없이 움직였던 거 맞아??'","style":1,"background":1027,"log_type":1,"src_id":160403126,"trial_step":126},{"step":119,"speaker":"코쿠리코","content":"<color=#7683a2><i>아니, 난…</i></color>","voice":["vo_trial_60403_1_126"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1027,"log_type":1,"src_id":160403127,"trial_step":127},{"step":120,"speaker":"코쿠리코","content":"<color=#7683a2><i>내 화원을 위해 그런 거야.</i></color>","voice":["vo_trial_60403_1_127"],"voice_bank":"vo_coquelicot_trial","style":1,"background":1027,"log_type":1,"src_id":160403128,"trial_step":128}]}