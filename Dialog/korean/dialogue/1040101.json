103},{"step":84,"speaker":"여름","content":"흠! 국장님.","voice":["vo_trial_40101_1_74","vo_trial_40101_1_29f"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101076,"trial_step":76,"drawing":1040109},{"step":85,"speaker":"여름","content":"그… 학술상의 교류는 관점상의 마찰을 피할 수 없는 법이죠.","voice":["vo_trial_40101_1_75"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101077,"trial_step":77,"drawing":1040109},{"step":86,"speaker":"여름","content":"그 물건을 제게 주실 수 있을까요? 저 여름이 약속할게요. 다음 위대한 발명에 국장님의 이름을 새길게요!","voice":["vo_trial_40101_1_76"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101078,"trial_step":78,"drawing":1040109},{"step":87,"options":["넌 이 암호를 풀 수 있지?"],"style":6,"log_type":1,"src_id":140101079,"trial_step":79,"course":3,"drawing":1040109,"choices":[{"text":"넌 이 암호를 풀 수 있지?","goto":80}]},{"step":88,"content":"MBCC가 지난주 수십 명의 해커를 고용해 100시간가량 작업했지만 이 암호 체인을 뚫지 못했어.","style":2,"log_type":1,"src_id":140101080,"trial_step":80,"drawing":1040109},{"step":89,"speaker":"여름","content":"흥, 저 여름이를 무시하시는 건가요!","voice":["vo_trial_40101_1_79"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101081,"trial_step":81,"drawing":1040108},{"step":90,"speaker":"여름","content":"제게 주기만 한다면 변이 결정이든, 블랙링이든… 무슨 문제든 전부 대답해 줄 수 있다고요!","voice":["vo_trial_40101_1_80"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101082,"trial_step":82,"drawing":1040109},{"step":91,"options":["약속했다?"],"style":6,"log_type":1,"src_id":140101083,"trial_step":83,"course":3,"drawing":1040109,"choices":[{"text":"약속했다?","goto":84}]},{"step":92,"speaker":"여름","content":"약속!","voice":["vo_trial_40101_1_82"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101084,"trial_step":84,"drawing":1040109},{"step":93,"content":"여름이 빠르게 큐브의 모서리를 누르자 큐브가 펼쳐지며 모든 포장이 떨어져 나갔고, 그 비디오를 단단히 감쌌다.","style":3,"log_type":1,"src_id":140101085,"trial_step":85,"drawing":1040109},{"step":94,"speaker":"여름","content":"안에 있는 게… 어떻게 변했는지 볼까…","voice":["vo_trial_40101_1_84"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101086,"trial_step":86,"drawing":1040109},{"step":95,"content":"사실, 당신은 조금 긴장했다.","style":3,"log_type":1,"src_id":140101087,"trial_step":87,"drawing":1040109},{"step":96,"content":"이전 링 연구소에서 손꼽히던 천재들이나 흥미를 가질만한 것이 곧 당신 앞에 펼쳐질 수도 있으니 말이다.","style":3,"log_type":1,"src_id":140101088,"trial_step":88,"drawing":1040109},{"step":97,"options":["이런 걸 정말 내게 보여줘도 되는 거야?","안에는 대체 뭐가 있지?"],"style":6,"log_type":1,"src_id":140101089,"trial_step":89,"course":3,"drawing":1040109,"choices":[{"text":"이런 걸 정말 내게 보여줘도 되는 거야?","goto":90},{"text":"안에는 대체 뭐가 있지?","goto":93}]},{"step":98,"speaker":"여름","content":"당연하죠, 왜 안 되는데요?","voice":["vo_trial_40101_1_88"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101090,"trial_step":90,"drawing":1040109},{"step":99,"speaker":"여름","content":"이런 위대한 걸작을 아무에게도 보여주지 않으면 너무 재미없잖아요.","voice":["vo_trial_40101_1_89"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101091,"trial_step":91,"drawing":1040109},{"step":100,"content":"남들이 자신의 연구 성과를 훔쳐봐도 신경 쓰지 않다니. 과학자인 여름이 이렇게 고상할 줄은 몰랐다.","style":3,"log_type":1,"src_id":140101092,"trial_step":92,"drawing":1040109,"next":[96]},{"step":101,"speaker":"여름","content":"물론 제 가장 중요한 걸작이죠!","voice":["vo_trial_40101_1_91"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101093,"trial_step":93,"drawing":1040109},{"step":102,"speaker":"여름","content":"하지만 이런 위대한 걸작을 아무에게도 보여주지 않으면 너무 재미없잖아요.","voice":["vo_trial_40101_1_92"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101094,"trial_step":94,"drawing":1040109},{"step":103,"speaker":"여름","content":"이번엔 제가 특별히 허락해 드릴게요, 저랑 같이 봐요!","voice":["vo_trial_40101_1_93"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101095,"trial_step":95,"drawing":1040109},{"step":104,"content":"포장이 하나하나 벗겨지자 당신도 모르게 긴장하기 시작했다.","style":3,"log_type":1,"src_id":140101096,"trial_step":96,"drawing":1040109},{"step":105,"content":"심문실의 벽은 칠흑 같은 화면으로 가려졌고, 천재의 걸작이 곧 당신의 눈앞에 펼쳐지려고 한다.","style":3,"log_type":1,"src_id":140101097,"trial_step":97,"drawing":1040109},{"step":106,"content":"세상은 또다시 파멸에 이르렀고, 수수께끼 같은 재앙은 사람들에게 불행을 가져왔다.","voice":["vo_trial_40101_1_97"],"voice_bank":"vo_xiayin_trial","style":3,"background":10000,"is_centered":true,"log_type":1,"src_id":140101099,"trial_step":99},{"step":107,"content":"건강을 빼앗긴 썸머는 몸이 병약해져 항상 누워만 있었기에 애니메이션이나 보며 시간을 보낼 수밖에 없었다.","voice":["vo_trial_40101_1_98"],"voice_bank":"vo_xiayin_trial","style":3,"background":10000,"is_centered":true,"log_type":1,"src_id":140101100,"trial_step":100},{"step":108,"content":"하지만, 거대한 로봇을 타고 세상을 구하는 여고생을 보고 드디어 자신만의 꿈을 찾았다.","voice":["vo_trial_40101_1_99"],"voice_bank":"vo_xiayin_trial","style":3,"background":10000,"is_centered":true,"log_type":1,"src_id":140101101,"trial_step":101},{"step":109,"content":"'나도 무적의 여고생이 되어 진실을 밝히고 세상을 구할 거야!'","voice":["vo_trial_40101_1_100"],"voice_bank":"vo_xiayin_trial","style":3,"background":10000,"is_centered":true,"log_type":1,"src_id":140101102,"trial_step":102},{"step":110,"content":"그녀는 생기발랄한 어린 천재가 되었다.","voice":["vo_trial_40101_1_101"],"voice_bank":"vo_xiayin_trial","style":3,"background":10000,"is_centered":true,"log_type":1,"src_id":140101103,"trial_step":103},{"step":111,"content":"모든 도시에서 유명한 천재 발명가.","voice":["vo_trial_40101_1_102"],"voice_bank":"vo_xiayin_trial","style":3,"background":10000,"is_centered":true,"log_type":1,"src_id":140101104,"trial_step":104},{"step":112,"content":"…최고 위치에 있는 연구소의 최연소 수석 과학자.","voice":["vo_trial_40101_1_103"],"voice_bank":"vo_xiayin_trial","style":3,"background":10000,"is_centered":true,"log_type":1,"src_id":140101105,"trial_step":105},{"step":113,"content":"…재난에 광명을 빼앗긴 소녀는 이제 어려움을 이겨내고 다시 재난의 앞으로 돌아왔다.","voice":["vo_trial_40101_1_104"],"voice_bank":"vo_xiayin_trial","style":3,"background":10000,"is_centered":true,"log_type":1,"src_id":140101106,"trial_step":106},{"step":114,"content":"이번엔 미스터리에 도전해 인류를 구하겠다고 마음먹었다.","voice":["vo_trial_40101_1_105"],"voice_bank":"vo_xiayin_trial","style":3,"background":10000,"is_centered":true,"log_type":1,"src_id":140101107,"trial_step":107},{"step":115,"content":"다음 화에 계속…","voice":["vo_trial_40101_1_106"],"voice_bank":"vo_xiayin_trial","style":14,"background":10000,"log_type":1,"src_id":140101108,"trial_step":108},{"step":116,"speaker":"여름","content":"어때요, 어때! 괜찮죠!","voice":["vo_trial_40101_1_107"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101109,"trial_step":109,"drawing":1040102},{"step":117,"speaker":"여름","content":"흥, 링 연구소 녀석들 꽤 괜찮은걸. 오랜 시간을 거쳐 드디어 여기까지 왔어!","voice":["vo_trial_40101_1_108"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101110,"trial_step":110,"drawing":1040102},{"step":118,"options":["……"],"style":6,"log_type":1,"src_id":140101111,"trial_step":111,"course":3,"drawing":1040102,"choices":[{"text":"……","goto":112}]},{"step":119,"content":"애초에 희대의 발명이나 위대한 발견 같은 건 없었고, 퀄리티 낮은 애니메이션만 상영될 뿐이었다.","style":3,"log_type":1,"src_id":140101112,"trial_step":112,"drawing":1040102},{"step":120,"content":"앞에 있는 소녀는 도저히 금기 물질 연구자를 연상시킬 수 없었다.","style":3,"log_type":1,"src_id":140101113,"trial_step":113,"drawing":1040102},{"step":121,"speaker":"여름","content":"하하하하… 몇 번을 봐도 여운이 남는다니까요.","voice":["vo_trial_40101_1_112"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101114,"trial_step":114,"drawing":1040102},{"step":122,"speaker":"여름","content":"이 극장판은 총 3편으로, 썸머라는 천재 소녀가 세상을 구하는 무적 여고생이 되는 이야기예요.","voice":["vo_trial_40101_1_113"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101115,"trial_step":115,"drawing":1040102},{"step":123,"options":["이야기의 주인공인…"],"style":6,"log_type":1,"src_id":140101116,"trial_step":116,"course":3,"drawing":1040102,"choices":[{"text":"이야기의 주인공인…","goto":117}]},{"step":124,"speaker":"${PlayerName}","content":"썸머는 널 모델로 만든 건가?","style":2,"log_type":1,"src_id":140101117,"trial_step":117,"drawing":1040103},{"step":125,"speaker":"여름","content":"맞아요! 제 꿈은 이 뜨겁고 감동적인 이야기를 촬영해 세상에 퍼뜨리는 거거든요!","voice":["vo_trial_40101_1_116"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101118,"trial_step":118,"drawing":1040103},{"step":126,"speaker":"여름","content":"타고난 약골이지만 지능은 측정하지 못할 정도로 뛰어나 월반하여 바로 고등학교로 진학한 뒤, 최고 연구소에 들어가 방방곡곡을 누비며 세상을 구할 구원의 손길로 찬양받는다.","voice":["vo_trial_40101_1_117"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101119,"trial_step":119,"drawing":1040103},{"step":127,"speaker":"여름","content":"뭔가 끓어오르는 게 느껴지지 않나요? 국장님!","voice":["vo_trial_40101_1_118"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101120,"trial_step":120,"drawing":1040103},{"step":128,"speaker":"여름","content":"큼… 제작은 됐고, 각본은 어땠나요?","voice":["vo_trial_40101_1_119"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101121,"trial_step":121,"drawing":1040102},{"step":129,"options":["……"],"style":6,"log_type":1,"src_id":140101122,"trial_step":122,"course":3,"drawing":1040102,"choices":[{"text":"……","goto":123}]},{"step":130,"content":"망상이라기보다는 중2병이라고 할 정도로 기상천외하네.","style":2,"log_type":1,"src_id":140101123,"trial_step":123,"drawing":1040102},{"step":131,"speaker":"여름","content":"그 침묵은 무슨 뜻이죠.","voice":["vo_trial_40101_1_122"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101124,"trial_step":124,"drawing":1040108},{"step":132,"content":"모든 사람의 취미는 존중받아야 마땅하다 생각해.","style":2,"log_type":1,"src_id":140101125,"trial_step":125,"drawing":1040108},{"step":133,"speaker":"여름","content":"흥… 국장님! 애니메이션 안 보시죠! 그러면 빨리 늙는다고요!","voice":["vo_trial_40101_1_124"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101126,"trial_step":126,"drawing":1040109},{"step":134,"options":["최근에 <굿바이 뇌광 협객>을 봤어","최근에 <우드 - 블랙워터의 고아>를 봤어"],"style":6,"log_type":1,"src_id":140101127,"trial_step":127,"course":3,"drawing":1040109,"choices":[{"text":"최근에 <굿바이 뇌광 협객>을 봤어","goto":128},{"text":"최근에 <우드 - 블랙워터의 고아>를 봤어","goto":130}]},{"step":135,"speaker":"여름","content":"오! 그거요… 저도 최근에 빠졌어요!","voice":["vo_trial_40101_1_126"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101128,"trial_step":128,"drawing":1040102},{"step":136,"speaker":"여름","content":"여고생과 거대 로봇이라니… 잘 어울리지 않나요!","voice":["vo_trial_40101_1_127"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101129,"trial_step":129,"drawing":1040103,"next":[138]},{"step":137,"speaker":"여름","content":"오…? 국장님도 유행에 따라 애니메이션 보는 걸 좋아하시네요…","voice":["vo_trial_40101_1_128"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101130,"trial_step":130,"drawing":1040109},{"step":138,"content":"왜 그렇게 말하지?","style":2,"log_type":1,"src_id":140101131,"trial_step":131,"drawing":1040109},{"step":139,"speaker":"여름","content":"'명장면'이 너무 많잖아요. 어딜 가나 상영하느라 바빴고, 관심도 많이 받았거든요.","voice":["vo_trial_40101_1_130"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101132,"trial_step":132,"drawing":1040109},{"step":140,"speaker":"여름","content":"제길, 마지막 결말을 그렇게 대충 만들어 놓다니… 우드 시리즈라고 도저히 인정하지 못하겠어요!","voice":["vo_trial_40101_1_131"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101133,"trial_step":133,"drawing":1040109},{"step":141,"content":"여름은 말할수록 흥이 났다. 보아하니 오랫동안 다른 사람과 애니메이션에 관한 이야기를 나누지 못한 것 같다.","style":3,"log_type":1,"src_id":140101134,"trial_step":134,"drawing":1040102},{"step":142,"content":"그녀와 계속 이야기하고 싶지만, 지금은 더 중요한 일이 있다.","style":3,"log_type":1,"src_id":140101135,"trial_step":135,"drawing":1040102},{"step":143,"options":["이제 내 질문에 대답해 줘야겠어"],"style":6,"log_type":1,"src_id":140101136,"trial_step":136,"course":3,"drawing":1040102,"choices":[{"text":"이제 내 질문에 대답해 줘야겠어","goto":137}]},{"step":144,"speaker":"${PlayerName}","content":"내 요청을 수락했잖아.","style":2,"log_type":1,"src_id":140101137,"trial_step":137,"drawing":1040102},{"step":145,"speaker":"여름","content":"흠흠, 당연하죠. 저 여름이는 영웅이 될 몸이니 말한 건 지켜야죠!","voice":["vo_trial_40101_1_136"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101138,"trial_step":138,"drawing":1040102},{"step":146,"speaker":"여름","content":"국장님이 그런 변이 무기를 얻을 수 있었다는 건 블랙워터와 많은 접촉을 했다는 건데. 사실… 그걸 모르면 안 되죠.","voice":["vo_trial_40101_1_137"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101139,"trial_step":139,"drawing":1040102},{"step":147,"speaker":"여름","content":"하지만 이 비디오를 봐서라도 하나하나 따지고 들어가진 않을게요.","voice":["vo_trial_40101_1_138"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101140,"trial_step":140,"drawing":1040102},{"step":148,"speaker":"여름","content":"좀 더 자세히 알고 싶나요, 아니면 대충 알고 싶나요?","voice":["vo_trial_40101_1_139"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101141,"trial_step":141,"drawing":1040102},{"step":149,"options":["자세히","대충"],"style":6,"log_type":1,"src_id":140101142,"trial_step":142,"course":3,"drawing":1040102,"choices":[{"text":"자세히","goto":143},{"text":"대충","goto":151}]},{"step":150,"speaker":"여름","content":"학구열이 이리 높으실 줄이야.","voice":["vo_trial_40101_1_141"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101143,"trial_step":143,"drawing":1040102},{"step":151,"speaker":"여름","content":"아쉽네요… 이곳은 공간이 너무 작아요.","voice":["vo_trial_40101_1_142"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101144,"trial_step":144,"drawing":1040108},{"step":152,"speaker":"${PlayerName}","content":"공간이 작다고?","style":2,"log_type":1,"src_id":140101145,"trial_step":145,"drawing":1040108},{"step":153,"speaker":"여름","content":"네… 어디 보자, 적어도 이~만큼 큰 칠판이 필요해요.","voice":["vo_trial_40101_1_144"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101146,"trial_step":146,"drawing":1040108},{"step":154,"speaker":"${PlayerName}","content":"뭘 하려고?","style":2,"log_type":1,"src_id":140101147,"trial_step":147,"drawing":1040108},{"step":155,"speaker":"여름","content":"당연히 그 결정체 구조를 그려주려 하는 거죠.","voice":["vo_trial_40101_1_146"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101148,"trial_step":148,"drawing":1040108},{"step":156,"speaker":"${PlayerName}","content":"…그렇게까지 자세할 필요는 없어.","style":2,"log_type":1,"src_id":140101149,"trial_step":149,"drawing":1040108},{"step":157,"speaker":"${PlayerName}","content":"난 변이 결정, 블랙링 그리고 수감자의 관계만 알면 충분해.","style":2,"log_type":1,"src_id":140101150,"trial_step":150,"drawing":1040108,"next":[154]},{"step":158,"speaker":"여름","content":"대충 해달라고요? 반응성을 아세요? 극성은요? 생물학적 활성은요? 존재 형태는요? 아니면 다른 건요?","voice":["vo_trial_40101_1_149"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101151,"trial_step":151,"drawing":1040109},{"step":159,"content":"여름의 말을 듣자니 현기증이 날 것 같다.","style":3,"log_type":1,"src_id":140101152,"trial_step":152,"drawing":1040109},{"step":160,"speaker":"${PlayerName}","content":"그런 건 다 필요 없어. 그저 변이 결정, 블랙링 그리고 수감자의 관계만 알면 충분하다고.","style":2,"log_type":1,"src_id":140101153,"trial_step":153,"drawing":1040109},{"step":161,"speaker":"여름","content":"네… 알겠어요. 어디 보자… 어떻게 시각적으로 설명할 수 있을까.","voice":["vo_trial_40101_1_152"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101154,"trial_step":154,"drawing":1040108},{"step":162,"speaker":"여름","content":"맞다! 이걸로 하죠!","voice":["vo_trial_40101_1_153"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101155,"trial_step":155,"drawing":1040108},{"step":163,"content":"여름이 손을 뻗어 책상 위에 놓인 얼음물을 가져왔다.","style":3,"log_type":1,"src_id":140101156,"trial_step":156,"drawing":1040108},{"step":164,"speaker":"여름","content":"그 무기를 가지고 있다면 그 땅굴에도 가봤겠죠, 안 그래요? 그 땅굴의 환경을 이 물이 담긴 잔으로 생각해 보자고요.","voice":["vo_trial_40101_1_155"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101157,"trial_step":157,"drawing":1040102},{"step":165,"speaker":"여름","content":"지속적으로 온도를 낮춘다면 컵 속의 얼음이 점점 많아지겠죠. 마찬가지로… 땅굴의 오염 정도가 높아질수록 링 물질도 많아져요.","voice":["vo_trial_40101_1_156"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101158,"trial_step":158,"drawing":1040102},{"step":166,"speaker":"여름","content":"변이 결정도 흔히 볼 수 있는 결정들은 아니거든요. 그것들은 링 물질이 수감자의 정신 에너지를 흡수한 후 생성되는 결정체예요.","voice":["vo_trial_40101_1_157"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101159,"trial_step":159,"drawing":1040109},{"step":167,"options":["변이 결정은 또 어떻게 수감자에게 영향을 미치는 거지?"],"style":6,"log_type":1,"src_id":140101160,"trial_step":160,"course":3,"drawing":1040109,"choices":[{"text":"변이 결정은 또 어떻게 수감자에게 영향을 미치는 거지?","goto":161}]},{"step":168,"speaker":"여름","content":"변이의 본질이 정신 폭주라는 건… 아시겠죠.","voice":["vo_trial_40101_1_159"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101161,"trial_step":161,"drawing":1040109},{"step":169,"speaker":"여름","content":"보이지 않고 만질 수 없는 정신 에너지는 저희의 현실 세계에 투사되어 일종의 '물질'이 되었어요.","voice":["vo_trial_40101_1_160"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101162,"trial_step":162,"drawing":1040109},{"step":170,"speaker":"여름","content":"가시, 오염, 에일리언 모두 그런 '물질'이죠.","voice":["vo_trial_40101_1_161"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101163,"trial_step":163,"drawing":1040109},{"step":171,"options":["내가 땅굴에서 본 것처럼?"],"style":6,"log_type":1,"src_id":140101164,"trial_step":164,"course":3,"drawing":1040109,"choices":[{"text":"내가 땅굴에서 본 것처럼?","goto":165}]},{"step":172,"speaker":"여름","content":"맞아요. 링 물질은 일종의 특수한 오염이에요.","voice":["vo_trial_40101_1_163"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101165,"trial_step":165,"drawing":1040109},{"step":173,"speaker":"여름","content":"그것과 강렬한 폭주 의지를 지닌 정신 오염은 달라요… 링 물질이 대체 '누구'에게서 온 건지는 찾지 못했어요.","voice":["vo_trial_40101_1_164"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101166,"trial_step":166,"drawing":1040109},{"step":174,"speaker":"여름","content":"오히려 텅 비어있는 촉매제 같죠. 다른 사람의 의지만 증폭시키잖아요.","voice":["vo_trial_40101_1_165"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101167,"trial_step":167,"drawing":1040109},{"step":175,"speaker":"여름","content":"그래서 특정 조건에서 링 물질은 수감자의 폭주 정신에 공명해요. 복사기처럼 구상화된 폭주 의식체로 변해버리죠.","voice":["vo_trial_40101_1_166"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101168,"trial_step":168,"drawing":1040109},{"step":176,"speaker":"여름","content":"소위 말하는 변이 결정은 수감자의 감정 파동을 복제해 만든 정신 결정이기도 하고, 간편 정신력 발생기이기도 해요.","voice":["vo_trial_40101_1_167"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101169,"trial_step":169,"drawing":1040109},{"step":177,"options":["그럼 파르마실험실은…"],"style":6,"log_type":1,"src_id":140101170,"trial_step":170,"course":3,"drawing":1040109,"choices":[{"text":"그럼 파르마실험실은…","goto":171}]},{"step":178,"speaker":"${PlayerName}","content":"그곳에서 이런 걸 많이 봤어.","style":2,"log_type":1,"src_id":140101171,"trial_step":171,"drawing":1040109},{"step":179,"speaker":"여름","content":"맞아요. 아마 그곳에서 수감자의 정신을 자극해 오랜 시간 동안 폭주시키고 공명 시간을 연장해 그들이 원하는 수감자의 능력을 얻었을 거예요.","voice":["vo_trial_40101_1_170"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101172,"trial_step":172,"drawing":1040109},{"step":180,"speaker":"여름","content":"제가 다크웹에서 나인티나인이라 불리는 사람에 대해 알아봤는데요, 아마 신디케이트에서 가장 인기 있는 퓨리 전투능력자 중 하나일 거예요.","voice":["vo_trial_40101_1_171"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101173,"trial_step":173,"drawing":1040109},{"step":181,"content":"그녀의 말이 맞다. 신디케이트는 힘을 숭상하고, 나인티나인은 극단적인 힘의 대명사이기 때문에 인기상품이 되는 것은 시간문제였다.","style":3,"log_type":1,"src_id":140101174,"trial_step":174,"drawing":1040109},{"step":182,"content":"나인티나인의 부상 당시 모습을 떠올렸다. 힘의 작용하에 얼마나 많은 고통을 감춰왔을지 모를 모습을.","style":3,"log_type":1,"src_id":140101175,"trial_step":175,"drawing":1040109},{"step":183,"content":"하지만… 파르마의 기술은 어디서 왔을까. 분명 신디케이트의 조건은 극악이고, 변이 결정의 정제도 엄청나게 어려울 텐데 말이다.","style":3,"log_type":1,"src_id":140101176,"trial_step":176,"drawing":1040109},{"step":184,"content":"신디케이트의 변이 무기는 특정 시점에 급속히 확장되었다. 외력의 도움 없이는 어려운 일이다.","style":3,"log_type":1,"src_id":140101177,"trial_step":177,"drawing":1040109},{"step":185,"content":"변이 결정은 링 물질이 변화하며 발전한 것이며, 여름은 그들과 뗄 수 없는 관계가 있다.","style":3,"log_type":1,"src_id":140101178,"trial_step":178,"drawing":1040109},{"step":186,"options":["그 변이 무기와 네 변이 무기는 어떤 차이가 있지?"],"style":6,"log_type":1,"src_id":140101179,"trial_step":179,"course":3,"drawing":1040109,"choices":[{"text":"그 변이 무기와 네 변이 무기는 어떤 차이가 있지?","goto":180}]},{"step":187,"content":"당신은 벽 구석에 놓인 드론으로 시선을 돌렸다.","style":3,"log_type":1,"src_id":140101180,"trial_step":180,"drawing":1040109},{"step":188,"content":"그 두 무기의 외형과 구동 방식은… 공교롭게도 닮아 있었다.","style":3,"log_type":1,"src_id":140101181,"trial_step":181,"drawing":1040109},{"step":189,"speaker":"여름","content":"그 두 무기는 완전히 다르다고요! 국장님, 제 유일한 발명품을 그런 양산형 불량품과 비교하지 마세요!","voice":["vo_trial_40101_1_180"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101182,"trial_step":182,"drawing":1040108},{"step":190,"speaker":"여름","content":"윽… 이 카피쟁이들, 감히 이 여름 님의 머리 위까지 기어오르려 하다니…","voice":["vo_trial_40101_1_181"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101183,"trial_step":183,"drawing":1040108},{"step":191,"speaker":"여름","content":"제가 힘들게 연구한 링 물질 제2정의를 이해하지 못하더니, 뜻밖에도 이런 쓰레기 같은 걸 만들어 냈군요…","voice":["vo_trial_40101_1_182"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101184,"trial_step":184,"drawing":1040108},{"step":192,"content":"여름이 계속해서 링 물질에 관한 이야기를 하려 하자, 당신이 서둘러 화제를 돌렸다.","style":3,"log_type":1,"src_id":140101185,"trial_step":185,"drawing":1040108},{"step":193,"options":["여기 보여줄 게 하나 더 있어"],"style":6,"log_type":1,"src_id":140101186,"trial_step":186,"course":3,"drawing":1040103,"choices":[{"text":"여기 보여줄 게 하나 더 있어","goto":187}]},{"step":194,"speaker":"여름","content":"어? 뭔데요? 두 번째 극장판인가요! 원고만 나왔던 걸로 기억하는데…","voice":["vo_trial_40101_1_185"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101187,"trial_step":187,"drawing":1040103},{"step":195,"content":"당신은 고개를 저으며 문서 하나를 여름에게 건넸다.","style":3,"log_type":1,"src_id":140101188,"trial_step":188,"drawing":1040103},{"step":196,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":189,"course":6,"drawing":1040103},{"step":197,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":189,"course":6,"drawing":1040103},{"step":198,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":189,"course":6,"drawing":1040103},{"step":199,"options":["선택1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":189,"course":6,"drawing":1040103},{"step":200,"content":"테스트","style":18,"log_type":1,"src_id":1,"trial_step":189,"course":6,"drawing":1040103},{"step":201,"options":["선택1","선택2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":189,"course":6,"drawing":1040103},{"step":202,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":189,"course":6,"drawing":1040103},{"step":203,"content":"테스트","style":3,"log_type":1,"src_id":1,"trial_step":189,"course":6,"drawing":1040103},{"step":204,"content":"여름은 문서를 들어 올리며 눈을 가늘게 뜨고 깨진 글자를 자세히 들여다보았다.","style":3,"log_type":1,"src_id":140101190,"trial_step":190,"drawing":1040109},{"step":205,"speaker":"여름","content":"이게 뭐지… 응? 구해줘?","voice":["vo_trial_40101_1_189"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101191,"trial_step":191,"drawing":1040109},{"step":206,"speaker":"여름","content":"어떤 미치광이가 실험실을 습격했습니다… 어서 저를 구해주세요?","voice":["vo_trial_40101_1_190"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101192,"trial_step":192,"drawing":1040109},{"step":207,"speaker":"여름","content":"절 데리고 임무에 가려는 건가요, 국장님? 아… 오늘은 안 돼요. 이제 방으로 돌아갈 체력밖에 안 남아 있단 말이에요.","voice":["vo_trial_40101_1_191"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101193,"trial_step":193,"drawing":1040109},{"step":208,"options":["이건 파르마에서 온 구조 요청 편지야"],"style":6,"log_type":1,"src_id":140101194,"trial_step":194,"course":3,"drawing":1040109,"choices":[{"text":"이건 파르마에서 온 구조 요청 편지야","goto":195}]},{"step":209,"content":"이곳에서 큰 폭발이 일어났다고 해. 변이 무기에 의해 일어난 폭발이라더군.","style":2,"log_type":1,"src_id":140101195,"trial_step":195,"drawing":1040109},{"step":210,"content":"사진 속에는 황량한 파르마에 하늘을 가로지르는 빛이 반짝이고 있었다.","style":3,"log_type":1,"src_id":140101196,"trial_step":196,"drawing":1040109},{"step":211,"content":"이 사건을 알고 있나?","style":2,"log_type":1,"src_id":140101197,"trial_step":197,"drawing":1040109},{"step":212,"speaker":"여름","content":"흠, 아쉽네요! 여름 선생님의 질의응답은 여기서 끝!","voice":["vo_trial_40101_1_196"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101198,"trial_step":198,"drawing":1040102},{"step":213,"speaker":"여름","content":"벌써 7시 58분이에요. 제가 가장 좋아하는 <괴도의 정체>가 곧 시작한단 말이에요. 여기 오기 전에 제때 보내주겠다고 약속했잖아요.","voice":["vo_trial_40101_1_197"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101199,"trial_step":199,"drawing":1040102},{"step":214,"speaker":"여름","content":"질의응답 시간 끝. 다음 상담은 2화를 가져온 후입니다.","voice":["vo_trial_40101_1_198"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101200,"trial_step":200,"drawing":1040102},{"step":215,"speaker":"여름","content":"아 맞다, 애니메이션에 대해 얘기하고 싶다면 언제든지 환영이에요~","voice":["vo_trial_40101_1_199"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101201,"trial_step":201,"drawing":1040102},{"step":216,"content":"보아하니 이 천재는 또 본 성격이 나오는 것 같다.","style":3,"log_type":1,"src_id":140101202,"trial_step":202,"drawing":1040102},{"step":217,"content":"당신은 한숨을 쉬며 심문실의 문을 열었다.","style":3,"log_type":1,"src_id":140101203,"trial_step":203,"drawing":1040102},{"step":218,"speaker":"여름","content":"특촬물아~ 내가 왔다~","voice":["vo_trial_40101_1_202"],"voice_bank":"vo_xiayin_trial","style":1,"log_type":1,"src_id":140101204,"trial_step":204,"drawing":1040102},{"step":219,"content":"여름은 드론의 도움을 받아 날아가듯 심문실을 빠져나갔다.","style":14,"background":10000,"log_type":1,"src_id":140101205,"trial_step":205,"drawing":1040102}]}