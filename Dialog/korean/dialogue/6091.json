{"id":6091,"chapter_id":6,"scene_id":610,"steps":[{"step":1,"speaker":"헤카테","content":"이 힘은…?","voice":["vo_cgplot_6091001"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":2,"content":"족쇄의 다른 쪽 끝에서 강력한 힘이 전해졌다. 당신의 손에서 빛이 뿜어져 나왔고, 빛이 닿는 곳에 보라색 녹이 녹아 왜곡되며, 당신들을 보호하는 힘이 됐다.","style":3,"background":511,"log_type":1},{"step":3,"speaker":"엘라","content":"으, 아직 머리가 아프긴 한데… 계속 머리를 쥐어짜는 듯했던 손이 사라진 것 같아.","voice":["vo_cgplot_6091003"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":4,"speaker":"헤카테","content":"족쇄에 변화가 생긴 겁니까? 국장님, 이 오염에 영향을 가할 수 있으신 건가요?","voice":["vo_cgplot_6091004"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":5,"options":["내가 그러는 게 아니야, 조야야"],"jump":[6],"style":6,"background":511,"log_type":1},{"step":6,"content":"족쇄의 다른 쪽 끝에서부터 조야의 의지가 전해졌어.","style":2,"background":511,"log_type":1},{"step":7,"speaker":"엘라","content":"아직 살아있다는 건가?","voice":["vo_cgplot_6091007"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":8,"speaker":"헤카테","content":"아직 의식이 있나요?","voice":["vo_cgplot_6091008"],"voice_bank":"vo_cgplot_06","style":1,"background":511,"log_type":1},{"step":9,"content":"조야가 무엇을 겪었는지 알 수 없었지만, 족쇄를 통해 힘이 전해지며 결의와 전투 의지를 느낄 수 있었다.","style":3,"background":511,"log_type":1},{"step":10,"options":["조야가 아직 싸우고 있어, 우리도 질 수 없어"],"jump":[11],"style":6,"background":511,"log_type":1},{"step":11,"content":"블랙링이 무엇이 됐든, 여기서 그것을 파괴해야 했다!","style":3,"background":511,"log_type":1}]}