{"id":1050402,"chapter_id":1050402,"scene_id":1,"steps":[{"step":1,"content":"<i>' 남서쪽의 땅은 인적이 드문 황무지였다, 그곳에는 벌거벗은 산과 말라버린 나무들뿐이었다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402001,"trial_step":1},{"step":2,"speaker":"에티","content":"황무지를 지나면 저편에는 뭐가 있을까?","voice":["vo_trial_50402_1_2"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402002,"trial_step":2},{"step":3,"content":"<i>' 마법사 에티는 메마른 큰 나무를 타고 올라가 먼 곳을 내다봤다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402003,"trial_step":3},{"step":4,"speaker":"에티","content":"뭐? 여기… 여기 큰 나무가 어디 있어…","voice":["vo_trial_50402_1_4"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402004,"trial_step":4},{"step":5,"content":"에티가 다급하게 주위를 둘러보다가 활동 구역 안에 있는 가로등을 발견했다.","style":3,"background":1020,"log_type":1,"src_id":150402005,"trial_step":5},{"step":6,"content":"에티는 당신을 흘겨보더니 가로등 위로 휙 하고 올라갔다.","style":3,"background":1020,"log_type":1,"src_id":150402006,"trial_step":6},{"step":7,"content":"…크흠.","style":2,"background":1020,"log_type":1,"src_id":150402007,"trial_step":7},{"step":8,"content":"<i>' 나무 위에서 주변을 살피던 마법사 에티는 제법 규모가 있어 보이는 마을을 발견했다. 그 마을에서 어쩌면 관련 정보를 얻을 수 있을지도 모른다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402008,"trial_step":8},{"step":9,"speaker":"에티","content":"근데 난 지금 아무것도 없는걸, 저쪽으로 가는 게 쉬운 일이 아니라고…","voice":["vo_trial_50402_1_9"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402009,"trial_step":9},{"step":10,"speaker":"에티","content":"우선 좀 살펴볼게, 이 근처에 뭐가 있나 말이야.","voice":["vo_trial_50402_1_10"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402010,"trial_step":10},{"step":11,"content":"당신은 주사위를 꺼내서 바닥에 굴렸다.","style":3,"background":1020,"log_type":1,"src_id":150402011,"trial_step":11},{"step":12,"speaker":"에티","content":"역시 나야, 대성공이군~!","voice":["vo_trial_50402_1_12"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402012,"trial_step":12},{"step":13,"content":"<i>' 주변 상황을 살펴보던 마법사 에티는 오른쪽에서 이야기를 나누고 있는 여자 두 명을 발견했다. 그들은 손에 빵 한 봉지를 들고 있었다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402013,"trial_step":13},{"step":14,"speaker":"에티","content":"오오! 빵이다!","voice":["vo_trial_50402_1_14"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402014,"trial_step":14},{"step":15,"content":"에티는 눈을 반짝이며 여자들이 있는 곳으로 달려갔다.","style":3,"background":1020,"log_type":1,"src_id":150402015,"trial_step":15},{"step":16,"speaker":"엘라","content":"아… 하하, 친구, 여기서 뭐 해?","voice":["vo_trial_50402_1_16"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402016,"trial_step":16},{"step":17,"speaker":"나인티나인","content":"식량을 찾고 있었어.","voice":["vo_trial_50402_1_17"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402017,"trial_step":17},{"step":18,"speaker":"엘라","content":"아! 그랬구나! 그게 모… 모험을 떠날 때 식량이 없으면 안 되지!","voice":["vo_trial_50402_1_18"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402018,"trial_step":18},{"step":19,"content":"엘라가 담장 밑에서 나인티나인의 어깨를 툭툭 치며 당신을 힐긋힐긋 쳐다봤다.","style":3,"background":1020,"log_type":1,"src_id":150402019,"trial_step":19},{"step":20,"content":"<i>' 마법사 에티는 그들에게 가까이 다가가서 무얼 하고 있는지 자세히 확인했다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402020,"trial_step":20},{"step":21,"speaker":"에티","content":"안녕~ 친구들~! 너희들도 모험가야?","voice":["vo_trial_50402_1_21"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402021,"trial_step":21},{"step":22,"content":"에티는 엘라와 나인티나인을 이리저리 자세히 살펴봤다.","style":3,"background":1020,"log_type":1,"src_id":150402022,"trial_step":22},{"step":23,"speaker":"에티","content":"조금 전에 얼핏 들었는데, 너희들 지금 먹을 거를 찾고 있다고?","voice":["vo_trial_50402_1_23"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402023,"trial_step":23},{"step":24,"speaker":"에티","content":"여기는 인적이 전혀 없는 것 같은데, 이런 데에 먹을 게 있겠어?","voice":["vo_trial_50402_1_24"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402024,"trial_step":24},{"step":25,"speaker":"나인티나인","content":"음… 그게, 내가 듣기로는 예전에 어떤 회색 트렌치코트를 입은 사람이 이곳에…","voice":["vo_trial_50402_1_25"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402025,"trial_step":25},{"step":26,"speaker":"나인티나인","content":"이곳에 식량을 묻어뒀다는군.","voice":["vo_trial_50402_1_26"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402026,"trial_step":26},{"step":27,"speaker":"나인티나인","content":"배가 너무 고파서 그걸 파냈어.","voice":["vo_trial_50402_1_27"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402027,"trial_step":27},{"step":28,"content":"나인티나인이 손짓하며 어색한 시선으로 당신을 쳐다봤다.","style":3,"background":1020,"log_type":1,"src_id":150402028,"trial_step":28},{"step":29,"content":"당신은 에티 뒤에서 몰래 나인티나인에게 엄지를 치켜세웠다.","style":3,"background":1020,"log_type":1,"src_id":150402029,"trial_step":29},{"step":30,"speaker":"에티","content":"그렇군, 솔직하게 말해줘서 고마워~","voice":["vo_trial_50402_1_30"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402030,"trial_step":30},{"step":31,"content":"에티가 살짝 웃고는 당신을 향해 돌아보며 이야기했다.","style":3,"background":1020,"log_type":1,"src_id":150402031,"trial_step":31},{"step":32,"speaker":"에티","content":"쟤네 둘한테 공격 마법을 써야겠어!","voice":["vo_trial_50402_1_32"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402032,"trial_step":32},{"step":33,"speaker":"엘라","content":"뭐?!","voice":["vo_trial_50402_1_33"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402033,"trial_step":33},{"step":34,"speaker":"엘라","content":"왜 갑자기 우리를 공격하겠다는 거야?!","voice":["vo_trial_50402_1_34"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402034,"trial_step":34},{"step":35,"speaker":"엘라","content":"나보다도 더 막무가내인 녀석이 있다니!","voice":["vo_trial_50402_1_35"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402035,"trial_step":35},{"step":36,"speaker":"에티","content":"딱 보면 몰라?","voice":["vo_trial_50402_1_36"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402036,"trial_step":36},{"step":37,"speaker":"에티","content":"난 지금 장비도 없고 식량도 없잖아, 계속 모험하려면 당연히 식량을 모아야지!","voice":["vo_trial_50402_1_37"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402037,"trial_step":37},{"step":38,"speaker":"엘라","content":"으으으!!","voice":["vo_trial_50402_1_38"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402038,"trial_step":38},{"step":39,"content":"엘라가 입을 삐죽거리며 인상을 쓰고 에티를 쳐다봤다. 당장이라도 주먹이 나갈 것 같았다.","style":3,"background":1020,"log_type":1,"src_id":150402039,"trial_step":39},{"step":40,"content":"당신은 서둘러 그 둘 사이로 가서 두 사람의 옷자락을 붙잡았다.","style":3,"background":1020,"log_type":1,"src_id":150402040,"trial_step":40},{"step":41,"content":"하하. 괜찮아, 괜찮아, 너희들이 반격하면 되지.","style":2,"background":1020,"log_type":1,"src_id":150402041,"trial_step":41},{"step":42,"speaker":"엘라","content":"너, 너 두고 봐! 내가 나인티나인한테 너를 혼쭐내달라고 할 거야!","voice":["vo_trial_50402_1_42"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402042,"trial_step":42},{"step":43,"content":"엘라는 쪼그리고 앉아 어깨에 파이프를 둘러멨다. 그 모습이 마치 길거리 깡패 같았다.","style":3,"background":1020,"log_type":1,"src_id":150402043,"trial_step":43},{"step":44,"content":"<i>' 행동치에 따라 마법사인 에티는 이번 턴에서 먼저 공격할 수 있다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402044,"trial_step":44},{"step":45,"options":["주사위를 던진다"],"style":6,"background":1020,"log_type":1,"src_id":150402045,"trial_step":45,"course":3,"choices":[{"text":"주사위를 던진다","goto":46}]},{"step":46,"content":"당신은 다시 주사위를 굴렸다. 주사위가 데구루루 구르더니 10에서 멈췄다.","style":3,"background":1020,"log_type":1,"src_id":150402046,"trial_step":46},{"step":47,"content":"<i>' 마법사 에티는 식량을 빼앗기 위해 조금 전에 만난 두 모험가를 공격했다. 에티의 교활하고 냉혹한 공격은 곧바로 그중 한 명에게 대미지를…'</i>","style":2,"background":1020,"log_type":1,"src_id":150402047,"trial_step":47},{"step":48,"speaker":"에티","content":"미안하게 됐어, 친구…","voice":["vo_trial_50402_1_48"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402048,"trial_step":48},{"step":49,"content":"당신이 말을 마치기도 전에 에티는 마법 지팡이를 꺼내 들고 뒤로 크게 한 걸음 물러나서는 앞에 있는 두 사람에게 크게 소리쳤다.","style":3,"background":1020,"log_type":1,"src_id":150402049,"trial_step":49},{"step":50,"speaker":"에티","content":"<i>' 서리 광선— RAY OF FROST— !'</i>","voice":["vo_trial_50402_1_50"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402050,"trial_step":50},{"step":51,"content":"썰렁한 바람이 불어왔다. 에티는 꿋꿋이 같은 자세를 유지했고, 엘라와 나인티나인은 한 걸음 떨어진 곳에서 고개를 갸우뚱 한 채 에티를 쳐다봤다.","style":3,"background":1020,"log_type":1,"src_id":150402051,"trial_step":51},{"step":52,"speaker":"에티","content":"……","style":1,"background":1020,"log_type":1,"src_id":150402052,"trial_step":52},{"step":53,"speaker":"엘라&나인티나인","content":"……","style":1,"background":1020,"log_type":1,"src_id":150402053,"trial_step":53},{"step":54,"speaker":"에티","content":"운영자, 뭐해…","voice":["vo_trial_50402_1_54"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402054,"trial_step":54},{"step":55,"content":"아! 어어!","style":2,"background":1020,"log_type":1,"src_id":150402055,"trial_step":55},{"step":56,"content":"당신은 에티의 차가운 시선을 느끼고 황급히 주사위를 던졌다.","style":3,"background":1020,"log_type":1,"src_id":150402056,"trial_step":56},{"step":57,"content":"주사위가 에티의 발밑으로 굴러가더니 8에서 멈췄다.","style":3,"background":1020,"log_type":1,"src_id":150402057,"trial_step":57},{"step":58,"content":"<i>' 마법사의 마법은… 음, 야만인 나인티나인에게 명중했다. 나인티나인이 받은 대미지는, 어, 계산해 볼게…'</i>","style":2,"background":1020,"log_type":1,"src_id":150402058,"trial_step":58},{"step":59,"content":"<i>' 아, 불쌍한 야만인 나인티나인은 총 5포인트의 대미지를 받았다, 게다가 마법의 영향으로 나인티나인은 1턴 동안 행동 불능에 빠졌다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402059,"trial_step":59},{"step":60,"speaker":"나인티나인","content":"마법의 영향…?","voice":["vo_trial_50402_1_60"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402060,"trial_step":60},{"step":61,"content":"<size=30>나인티나인, 그냥 그렇다고 해줘, 부탁할게.</size>","style":2,"background":1020,"log_type":1,"src_id":150402061,"trial_step":61},{"step":62,"speaker":"나인티나인","content":"응… 아.","voice":["vo_trial_50402_1_62"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402062,"trial_step":62},{"step":63,"content":"나인티나인은 한 걸음 물러나 바닥에 앉았다. 엘라는 그 모습을 보고 뛰쳐나와 나인티나인의 앞을 막아섰다. 그러고는 고래고래 소리치며 파이프를 휘둘렀다.","style":3,"background":1020,"log_type":1,"src_id":150402063,"trial_step":63},{"step":64,"speaker":"엘라","content":"괘씸한… 녀석! 내가, 내가 반드시 되갚아 줄 거야!","voice":["vo_trial_50402_1_64"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402064,"trial_step":64},{"step":65,"content":"<i>' 조그만 몸집의 부랑자는 불같이 화를 내며 씩씩거렸고 응징해 주겠다고 소리쳤다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402065,"trial_step":65},{"step":66,"speaker":"엘라","content":"내 파이프 맛을 봐라!!!","voice":["vo_trial_50402_1_66"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402066,"trial_step":66},{"step":67,"content":"엘라는 두 손으로 쥔 파이프를 에티의 마법 지팡이를 향해 휘둘렀다.","style":3,"background":1020,"log_type":1,"src_id":150402067,"trial_step":67},{"step":68,"content":"당신은 허리를 숙인 채로 엘라의 앞에서 주사위를 살며시 던졌다.","style":3,"background":1020,"log_type":1,"src_id":150402068,"trial_step":68},{"step":69,"content":"<i>' 2포인트.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402069,"trial_step":69},{"step":70,"content":"<i>' 부랑자 엘라는 간이 무기인 파이프로 공격했다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402070,"trial_step":70},{"step":71,"content":"<i>' 포인트로 계산해 보면, 마법사 에티는 총… 음… 1포인트의 대미지를 받았다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402071,"trial_step":71},{"step":72,"speaker":"엘라","content":"뭐?!","voice":["vo_trial_50402_1_72"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402072,"trial_step":72},{"step":73,"speaker":"엘라","content":"#$%#$%%……&$&*&……(……%##$$@!@#…………&!!!!","voice":["vo_trial_50402_1_73"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402073,"trial_step":73},{"step":74,"speaker":"에티","content":"뭐라는지 하나도 모르겠네…","voice":["vo_trial_50402_1_74"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402074,"trial_step":74},{"step":75,"content":"<i>' 흠흠, 공격이 제대로 먹히지 않자 부랑자 엘라는 부랑자의 언어로 성질을 부리며 말을 했다. 엘라가 하는 말은 전보 암호 소리처럼 귀에 거슬리면서도 신기했다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402075,"trial_step":75},{"step":76,"content":"<i>' 부랑자 엘라가 하는 말을 해독하려면, 룬 표식을 읽을 수 있는 스킬을 배워야 한다. 주사위를 굴려 대성공하거나, 행운을 소모해야 한다…'</i>","style":2,"background":1020,"log_type":1,"src_id":150402076,"trial_step":76},{"step":77,"speaker":"에티","content":"필요 없어. 너희들한테는 이제 두 가지 선택지밖에 없어. 하나는 나랑 계속 싸우는 건데, 참고로 다음 턴에 저 야만인 녀석을 완전히 쓰러트릴 자신 있어.","voice":["vo_trial_50402_1_77"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402077,"trial_step":77},{"step":78,"speaker":"에티","content":"아니면… 나한테 순순히 식량을 넘기는 방법도 있지.","voice":["vo_trial_50402_1_78"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402078,"trial_step":78},{"step":79,"content":"에티는 마법 지팡이를 집어넣고 자신만만하게 쓰고 있던 모자를 흔들어 댔다. 모자 위의 드래곤 뿔이 왠지 모르게 기세등등해 보였다.","style":3,"background":1020,"log_type":1,"src_id":150402079,"trial_step":79},{"step":80,"content":"<i>' 부랑자 엘라는 마법사 에티의 도발에 분노가 치민 듯, 가차 없이 달려들었다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402080,"trial_step":80},{"step":81,"speaker":"엘라","content":"뭐라고? 으아아아아아아아!!!","voice":["vo_trial_50402_1_81"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402081,"trial_step":81},{"step":82,"content":"엘라가 파이프를 들고 에티에게 달려들었다.","style":3,"background":1020,"log_type":1,"src_id":150402082,"trial_step":82},{"step":83,"content":"<i>' 그런데 너무 파이프를 힘껏 휘둘렀던 탓에, 나인티나인이 내려놓았던 빵 주머니가 파이프에 맞아 울타리 쪽으로 튕겨 나갔다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402083,"trial_step":83},{"step":84,"content":"나인티나인은 자신의 이름을 듣고 고개를 들어 잠시 고민하더니, 그 갈색 주머니를 담장의 철조망 쪽으로 던졌다.","style":3,"background":1020,"log_type":1,"src_id":150402084,"trial_step":84},{"step":85,"speaker":"엘라","content":"……","style":1,"background":1020,"log_type":1,"src_id":150402085,"trial_step":85},{"step":86,"content":"……","style":2,"background":1020,"log_type":1,"src_id":150402086,"trial_step":86},{"step":87,"speaker":"에티","content":"……","style":1,"background":1020,"log_type":1,"src_id":150402087,"trial_step":87},{"step":88,"speaker":"에티","content":"게임 운영자 너, 이거 너무 반칙인 거 아니야?!","voice":["vo_trial_50402_1_88"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402088,"trial_step":88},{"step":89,"content":"아주 합리적인 방향으로 전개되고 있는데, 불가능한 일은 아니잖아?","style":2,"background":1020,"log_type":1,"src_id":150402089,"trial_step":89},{"step":90,"speaker":"에티","content":"으으으!","voice":["vo_trial_50402_1_90"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402090,"trial_step":90},{"step":91,"content":"<i>' 세상이 어둠에 뒤덮였을 때, 인간들의 협력과 신뢰는 더욱 시험에 오르게 된다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402091,"trial_step":91},{"step":92,"content":"<i>' 하늘을 날 수 없는 사람이더라도 친구와 함께한다면, 이제껏 가보지 못했던 높은 곳에 오를 수 있다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402092,"trial_step":92},{"step":93,"content":"<i>' 이제 식량이 없어서 셋은커녕 단 한 명도 인근에 있는 도시에 갈 수 없게 되었다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402093,"trial_step":93},{"step":94,"speaker":"엘라","content":"뭐? 그럼, 우리가 저 빵을 꼭 가지고 가야 한다는 거야?","voice":["vo_trial_50402_1_94"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402094,"trial_step":94},{"step":95,"speaker":"엘라","content":"설정이 왜 이렇게 많아! 이봐!","voice":["vo_trial_50402_1_95"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402095,"trial_step":95},{"step":96,"speaker":"에티","content":"말이 안 되는 건 아니야, 식량이 없으면 우린 살아남을 수 없으니까.","voice":["vo_trial_50402_1_96"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402096,"trial_step":96},{"step":97,"speaker":"나인티나인","content":"그러니까… 지금 빵이 위험한 상태에 빠졌는데, 우리 모두 빵이 필요한 거네.","voice":["vo_trial_50402_1_97"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402097,"trial_step":97},{"step":98,"content":"에티, 엘라, 나인티나인은 담장에 다가가 빵이 든 주머니를 올려다보며 각자 생각에 빠졌다.","style":3,"background":1020,"log_type":1,"src_id":150402098,"trial_step":98},{"step":99,"content":"<i>' 세 모험가는 담장을 자세히 살펴봤다. 얼마 지나지 않아 그들은 자신이 가지고 있는 스킬과 힘으로는 담장 위의 전기 철조망에서 빵을 안전하게 빼낼 방법이 없다는 것을 깨달았다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402099,"trial_step":99},{"step":100,"speaker":"에티","content":"뭐?! 이렇게 낮은 담장에서 못 꺼낸다고?!","voice":["vo_trial_50402_1_100"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402100,"trial_step":100},{"step":101,"content":"에티가 믿을 수 없다는 듯 당신을 쳐다봤다. 하지만 당신은 아랑곳하지 않으며 손바닥에 빼곡히 적힌 글씨를 보았다.","style":3,"background":1020,"log_type":1,"src_id":150402101,"trial_step":101},{"step":102,"content":"당신이 신경도 쓰지 않자, 에티는 또다시 '지배자의 룰'이 발동됐음을 깨닫고 콧방귀를 뀌었다. 그러더니 한참 생각하다가 엘라 앞으로 다가갔다.","style":3,"background":1020,"log_type":1,"src_id":150402102,"trial_step":102},{"step":103,"speaker":"에티","content":"어때, 함께 해볼래?","voice":["vo_trial_50402_1_103"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402103,"trial_step":103},{"step":104,"content":"엘라는 파이프를 내려놓고 바닥에 기댄 채로 씩 웃었다.","style":3,"background":1020,"log_type":1,"src_id":150402104,"trial_step":104},{"step":105,"speaker":"엘라","content":"같이 해보자고? 저 빵은 원래 우리 거야!","voice":["vo_trial_50402_1_105"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402105,"trial_step":105},{"step":106,"speaker":"에티","content":"근데 너희는 나한테 졌잖아?","voice":["vo_trial_50402_1_106"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402106,"trial_step":106},{"step":107,"speaker":"에티","content":"너희가 빵을 되찾았다고 쳐, 부랑자와 야만인 둘이서 마법사의 도움 없이 모험에서 살아남을 수 있을 것 같아? 생각해 봐, 누가 너희들이 싸울 때 옆에서 같이 공격해 주고 보호해 줄 수 있는지, 그리고 너희가 다치기라도 하면 치료는 누가 해줄지…","voice":["vo_trial_50402_1_107"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402107,"trial_step":107},{"step":108,"speaker":"엘라","content":"흠… 다른 건 몰라도 나인티나인은 싸울 때 힐러가 필요하긴 하지.","voice":["vo_trial_50402_1_108"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402108,"trial_step":108},{"step":109,"speaker":"에티","content":"그럼~ 같이 하는 거지?","voice":["vo_trial_50402_1_109"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402109,"trial_step":109},{"step":110,"content":"에티가 웃으며 엘라에게 손을 내밀었다.","style":3,"background":1020,"log_type":1,"src_id":150402110,"trial_step":110},{"step":111,"content":"엘라는 에티를 보며 눈동자를 한 바퀴 굴리고는 두 손으로 에티의 손을 꼭 붙잡았다.","style":3,"background":1020,"log_type":1,"src_id":150402111,"trial_step":111},{"step":112,"speaker":"엘라","content":"좋아! 그럼… 네가 보물을 찾으면, 우리한테 3분의 1을 나누는 거다!","voice":["vo_trial_50402_1_112"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402112,"trial_step":112},{"step":113,"speaker":"에티","content":"뭐…?","voice":["vo_trial_50402_1_113"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402113,"trial_step":113},{"step":114,"content":"<i>' 마법사 에티와 부랑자 엘라가 손을 잡았다. 셋은 기분 좋게 협력을 약속했다!'</i>","style":2,"background":1020,"log_type":1,"src_id":150402114,"trial_step":114},{"step":115,"content":"당신은 에티가 말을 이어 나가지 못하게 막으려는 듯 이야기하며 황급히 셋을 다시 담장 아래로 밀어냈다.","style":3,"background":1020,"log_type":1,"src_id":150402115,"trial_step":115},{"step":116,"speaker":"엘라","content":"헤헤, 친구, 운명의 인도 아래 다 같이 전설 속의 성을 찾아보자고!","voice":["vo_trial_50402_1_116"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402116,"trial_step":116},{"step":117,"speaker":"나인티나인","content":"내가 가진 힘을 잘 활용해 줘!","voice":["vo_trial_50402_1_117"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402117,"trial_step":117},{"step":118,"content":"엘라는 여전히 에티의 손을 잡고 있었다. 늘 차가웠던 에티의 손은 그 순간만큼은 매우 따뜻했다.","style":3,"background":1020,"log_type":1,"src_id":150402118,"trial_step":118},{"step":119,"content":"한참이 지나서야 에티가 다시 고개를 들었다.","style":3,"background":1020,"log_type":1,"src_id":150402119,"trial_step":119},{"step":120,"speaker":"에티","content":"후… 그래, 모험은 함께하는 사람이 많을수록 좋으니까… 보물을 나눠 가져야 하더라도 말이야…","voice":["vo_trial_50402_1_120"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402120,"trial_step":120},{"step":121,"speaker":"에티","content":"근데 내가 이번 모험의 리더인 건 반대하는 사람 없지? 아무래도… 내가 제일 강하잖아.","voice":["vo_trial_50402_1_121"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402121,"trial_step":121},{"step":122,"speaker":"엘라","content":"음… 그래! 네가 제일 강하다고 해줄게!","voice":["vo_trial_50402_1_122"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402122,"trial_step":122},{"step":123,"speaker":"나인티나인","content":"그래…","voice":["vo_trial_50402_1_123"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402123,"trial_step":123},{"step":124,"speaker":"에티","content":"좋아~! 합의 끝!","voice":["vo_trial_50402_1_124"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402124,"trial_step":124},{"step":125,"speaker":"에티","content":"그러면 이제…","voice":["vo_trial_50402_1_125"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402125,"trial_step":125},{"step":126,"content":"에티가 눈을 반짝였다.","style":3,"background":1020,"log_type":1,"src_id":150402126,"trial_step":126},{"step":127,"speaker":"에티","content":"자, 엘라! 나인티나인! 저 담장을 부숴!","voice":["vo_trial_50402_1_127"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402127,"trial_step":127},{"step":128,"content":"?","style":2,"background":1020,"log_type":1,"src_id":150402128,"trial_step":128},{"step":129,"speaker":"엘라","content":"오오오! 관리국... 아니, 이 담장을 부수라고?!","voice":["vo_trial_50402_1_129"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402129,"trial_step":129},{"step":130,"speaker":"나인티나인","content":"가능할 것 같은데.","voice":["vo_trial_50402_1_130"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402130,"trial_step":130},{"step":131,"content":"?!","style":2,"background":1020,"log_type":1,"src_id":150402131,"trial_step":131},{"step":132,"content":"<i>' 그렇지만 공공기물인 담장을 파손하면 책임을 져야 한다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402132,"trial_step":132},{"step":133,"speaker":"에티","content":"괜찮아, 부순 다음에 바로 도망치면 돼.","voice":["vo_trial_50402_1_133"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402133,"trial_step":133},{"step":134,"speaker":"엘라","content":"이해했어, 우리가 재빨리 도망치면, 누가 범인인지 모르겠지!","voice":["vo_trial_50402_1_134"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402134,"trial_step":134},{"step":135,"speaker":"에티","content":"응, 맞아, 바로 그거야!","voice":["vo_trial_50402_1_135"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402135,"trial_step":135},{"step":136,"content":"에티와 엘라가 턱을 만지며 서로를 쳐다보더니 하이 파이브를 했다.","style":3,"background":1020,"log_type":1,"src_id":150402136,"trial_step":136},{"step":137,"content":"…좋아.","style":2,"background":1020,"log_type":1,"src_id":150402137,"trial_step":137},{"step":138,"content":"나인티나인이 자신의 검을 들어 어깨에 올리자 팔 주위에서 붉은 안개가 서서히 나타났다. 나인티나인이 이능력을 사용한 것이다.","style":3,"background":1020,"log_type":1,"src_id":150402138,"trial_step":138},{"step":139,"options":["이렇게까지 해야 하나?"],"style":6,"background":1020,"log_type":1,"src_id":150402139,"trial_step":139,"course":3,"choices":[{"text":"이렇게까지 해야 하나?","goto":140}]},{"step":140,"speaker":"나인티나인","content":"준비됐어.","voice":["vo_trial_50402_1_140"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402140,"trial_step":140},{"step":141,"content":"<i>'…무시무시한 힘을 가진 야만인은 검으로 많은 사람을 가둔 담장을 겨누고는 공격할 태세를 갖췄다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402141,"trial_step":141},{"step":142,"content":"주사위가 세 사람 앞을 데구루루 구르더니 당신 앞에서 멈췄다.","style":3,"background":1020,"log_type":1,"src_id":150402143,"trial_step":143},{"step":143,"content":"<i>' 음… 어… 5가 나왔네…'</i>","style":2,"background":1020,"log_type":1,"src_id":150402144,"trial_step":144},{"step":144,"content":"<i>' 음, 야만인 나인티나인은 온 힘을 다해 담장을 내리쳤지만, 담장은 그들이 생각했던 것보다 더 두껍고 단단했다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402145,"trial_step":145},{"step":145,"content":"<i>' 모험가들을 가둔 담장은 매우 견고했다. 담장은 나인티나인의 공격에도 끄떡하지 않았고 오히려 공격의 충격으로 인해 나인티나인은 머리를 다쳤다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402146,"trial_step":146},{"step":146,"speaker":"나인티나인","content":"?","style":1,"background":1020,"log_type":1,"src_id":150402147,"trial_step":147},{"step":147,"speaker":"엘라","content":"?","style":1,"background":1020,"log_type":1,"src_id":150402148,"trial_step":148},{"step":148,"speaker":"에티","content":"?","style":1,"background":1020,"log_type":1,"src_id":150402149,"trial_step":149},{"step":149,"content":"다시… 다시 던질게…","style":2,"background":1020,"log_type":1,"src_id":150402150,"trial_step":150},{"step":150,"content":"당신은 셋이 지켜보는 가운데 주사위를 살며시 던졌다.","style":3,"background":1020,"log_type":1,"src_id":150402151,"trial_step":151},{"step":151,"content":"주사위가 멈췄다. 당신은 주사위의 숫자 8을 보고 무안한 듯 시선을 피했다.","style":3,"background":1020,"log_type":1,"src_id":150402152,"trial_step":152},{"step":152,"content":"<i>' 담장… 담장이 5포인트의 대미지를 반사했다. 나인티나인은 좀 전의 마법사 에티와의 대결에서 이미 3포인트의 대미지를 받았고…'</i>","style":2,"background":1020,"log_type":1,"src_id":150402153,"trial_step":153},{"step":153,"content":"<i>' 불쌍한 나인티나인, 검이 담장에서 튕겨 나가 도리어 자신에게 대미지를 주는 바람에 그대로 쓰러지고 말았다… 어… 넌 죽었어, 나인티나인.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402154,"trial_step":154},{"step":154,"speaker":"나인티나인","content":"근데 나 멀쩡히 살아있어.","voice":["vo_trial_50402_1_155"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402155,"trial_step":155},{"step":155,"content":"수치가 그렇다는 말이야, 수치가.","style":2,"background":1020,"log_type":1,"src_id":150402156,"trial_step":156},{"step":156,"speaker":"엘라","content":"나인티나인, 너 운이 너무 안 좋은 거 아냐…?","voice":["vo_trial_50402_1_157"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402157,"trial_step":157},{"step":157,"speaker":"에티","content":"…괜찮아, 패배도 게임의 일부야, 적응해야 해.","voice":["vo_trial_50402_1_158"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402158,"trial_step":158},{"step":158,"content":"주사위가 데구루루 구르며 당신의 발밑에서 멈췄다. 당신은 15가 반짝이는 것을 보고 가슴이 철렁 내려앉았다.","style":3,"background":1020,"log_type":1,"src_id":150402161,"trial_step":161},{"step":159,"content":"<i>' 야만인은 대검을 들고 깊게 숨을 내쉬며 힘을 모았다. 그랬더니 온몸에서 붉은 안개가 뿜어져 나왔다. 나인티나인은 분노의 포효를 내지르며 온 힘을 다해 담장을 내리쳤다.'</i>","style":2,"background":1020,"log_type":1,"src_id":150402162,"trial_step":162},{"step":160,"speaker":"나인티나인","content":"하앗!!!","voice":["vo_trial_50402_1_161"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402163,"trial_step":163},{"step":161,"content":"당신의 말이 끝나기가 무섭게 나인티나인은 대검으로 담장을 내리쳤다!","style":3,"background":1020,"log_type":1,"src_id":150402164,"trial_step":164},{"step":162,"content":"큰 소리와 함께 담장에 2미터 높이의 커다란 구멍이 생겼다. 철조망에 걸려있던 빵은 에티의 품속으로 떨어졌다.","style":3,"background":1020,"log_type":1,"src_id":150402165,"trial_step":165},{"step":163,"speaker":"엘라","content":"오예! 역시 나인티나인이야!!","voice":["vo_trial_50402_1_164"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402166,"trial_step":166},{"step":164,"speaker":"나인티나인","content":"대성공이군, 이제 가자.","voice":["vo_trial_50402_1_165"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402167,"trial_step":167},{"step":165,"speaker":"에티","content":"정말 훌륭했어, 친구!","voice":["vo_trial_50402_1_166"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402168,"trial_step":168},{"step":166,"content":"에티가 빵 하나를 삼등분한 뒤 두 사람과 나누었다. 셋은 빵을 물고 그 커다란 구멍으로 들어갔다. 당신은 뒤에서 조금 천천히 가자고 소리쳤지만, 조금도 기다려 주지 않았다.","style":3,"background":1020,"log_type":1,"src_id":150402169,"trial_step":169},{"step":167,"content":"<i>' 나인티나인이 담장에 구멍을 내는 데 성공하면서 갓 결성된 모험대는 처음으로 맞닥뜨린 역경을 성공적으로 극복했다…'</i>","style":2,"background":1020,"log_type":1,"src_id":150402170,"trial_step":170},{"step":168,"content":"그들을 따라잡을 수 없었던 당신은 대사를 읊으며 빠른 걸음으로 순식간에 사라진 무리를 따라갔다.","style":3,"background":1020,"log_type":1,"src_id":150402171,"trial_step":171},{"step":169,"speaker":"나이팅게일","content":"……","style":1,"background":1020,"log_type":1,"src_id":150402172,"trial_step":172},{"step":170,"speaker":"K.K.","content":"……","style":1,"background":1020,"log_type":1,"src_id":150402173,"trial_step":173},{"step":171,"content":"부서진 담장 쪽에서 나이팅게일과 K.K.가 쇠사슬을 든 채 당황한 얼굴을 하고 있었다. 그들의 발밑에는 부서진 돌이 널브러져 있었다. 어떤 돌들은 마치 선을 그어놓고 자른 듯 모서리가 매끈했다.","style":3,"background":1020,"log_type":1,"src_id":150402174,"trial_step":174},{"step":172,"speaker":"나이팅게일","content":"나인티나인의 키 정도인 구멍이라고 하지 않았어?!","voice":["vo_trial_50402_1_173"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402175,"trial_step":175},{"step":173,"speaker":"나이팅게일","content":"이… 이게 어떻게 된…","voice":["vo_trial_50402_1_174"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402176,"trial_step":176},{"step":174,"speaker":"K.K.","content":"하, 나인티나인이 하는 말 못 들었어? 대성공이라는데!","voice":["vo_trial_50402_1_175"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402177,"trial_step":177},{"step":175,"speaker":"나이팅게일","content":"이대로 내버려 둬도 괜찮을까… 저렇게 여럿이 계속하다 보면… 쓸데없는 번거로움만 생길 것 같은데.","voice":["vo_trial_50402_1_176"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402178,"trial_step":178},{"step":176,"speaker":"K.K.","content":"에이, 걱정 안 해도 돼, 국장도 다 생각이 있겠지.","voice":["vo_trial_50402_1_177"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402179,"trial_step":179},{"step":177,"speaker":"K.K.","content":"중이병 소녀는 그에 걸맞은 방식으로 상대해 줘야 하고, 난 국장을 믿어.","voice":["vo_trial_50402_1_178"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402180,"trial_step":180},{"step":178,"speaker":"K.K.","content":"게다가 백 사장한테 한두 번 속아 넘어간 것도 아니잖아, 국장도 어느 정도 경험이 있겠지.","voice":["vo_trial_50402_1_179","vo_trial_50402_1_179f"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402181,"trial_step":181},{"step":179,"speaker":"나이팅게일","content":"그래, 우리 쪽에 사람이 없는 것도 아니고, 잘 수습하겠지.","voice":["vo_trial_50402_1_180"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402182,"trial_step":182},{"step":180,"speaker":"나이팅게일","content":"가자, 다음 단계를 시작한다.","voice":["vo_trial_50402_1_181"],"voice_bank":"vo_etti_trial","style":1,"background":1020,"log_type":1,"src_id":150402183,"trial_step":183}]}