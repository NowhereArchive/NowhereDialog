{"id":400701402,"chapter_id":50019,"scene_id":51909,"steps":[{"step":1,"speaker":"광기의 가위","content":"어디 숨겼어. 어디 숨겼지?","voice":["vo_event_400701402_01"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":2,"speaker":"광기의 가위","content":"배에? 머리에? 갈라서 확인해 보자. 무조건 너한테 있어!","voice":["vo_event_400701402_02"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":3,"content":"그것이 포효하며 당신을 향해 달려든 순간, 당신은 무의식적으로 그것을 향해 손을 들었다. 발광하던 인간은 당신의 그 동작을 보더니 순간 멈췄다.","style":3,"background":2075,"log_type":1},{"step":4,"speaker":"광기의 가위","content":"이건?! 으윽!!!","voice":["vo_event_400701402_04"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":5,"content":"그것이 문득 드러낸 겁에 질린 표정에 당신은 용기가 샘솟았다.","style":3,"background":2075,"log_type":1},{"step":6,"options":["난 지지 않아!"],"jump":[7],"style":6,"background":2075,"log_type":1},{"step":9,"content":"아무 일도 일어나지 않았다. 당신은 손을 든 채 자신이 왜 이런 행동을 했는지 알 수 없었고, 상대도 다소 놀란 것 같았다.","style":3,"background":2075,"log_type":1},{"step":10,"speaker":"광기의 가위","content":"…","voice":["vo_event_400701402_09"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":11,"speaker":"${PlayerName}","content":"…","style":2,"background":2075,"log_type":1},{"step":12,"speaker":"${PlayerName}","content":"내가 그랬지… 난 아무것도 기억나지 않는다고…","style":2,"background":2075,"log_type":1},{"step":13,"content":"잠깐의 침묵 후, 당신이 상대보다 먼저 반응하며 즉시 행동에 나섰다.","style":3,"background":2075,"log_type":1},{"step":14,"options":["도망친다!","뒤를 봐! 가위다!"],"jump":[15,15],"style":6,"background":2075,"log_type":1},{"step":15,"content":"당신은 크게 외치며 녀석의 뒤를 가리킨 후 냅다 뒤돌아 달렸다.","style":3,"background":2075,"log_type":1},{"step":16,"content":"하지만 한 걸음 내딛기도 전에 발이 걸려 넘어지고 말았다. 칠흑 같은 어둠 속에서 기괴한 머리카락이 이미 당신의 발목을 휘감고 있었다.","style":3,"background":2075,"log_type":1},{"step":17,"speaker":"광기의 가위","content":"넌 도망 못 가. 너도 똑같이, 도망칠 수 없다고!!! 아…","voice":["vo_event_400701402_17"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":20,"content":"띠링…","style":3,"background":10000,"log_type":1},{"step":21,"content":"뒤쪽에서 갑자기 등이 켜졌다.","style":3,"background":10000,"log_type":1},{"step":22,"speaker":"광기의 가위","content":"??","voice":["vo_event_400701402_21"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":23,"content":"당신은 천천히 눈을 떴다. 안개가 빠르게 걷히고 그 기괴한 머리카락 생물들도 빛을 피하는 곤충처럼 사방으로 흩어졌다.","style":3,"background":2075,"log_type":1},{"step":24,"content":"그 광기의 가위도 예외가 아니었다. 그것은 불쾌한 듯 비명을 지르며 안개를 따라 길모퉁이로 사라졌다.","style":3,"background":2075,"log_type":1},{"step":25,"content":"뒤에 있던 가게 문이 열리며 경쾌한 방울 소리가 당신의 귓가에 울렸다.","style":3,"background":2075,"log_type":1},{"step":26,"speaker":"??","content":"…여긴 어떻게 왔어요?","voice":["vo_event_400701402_25"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":27,"speaker":"??","content":"집에서 쉬면서 제가 퇴근할 때까지 기다리라고 했잖아요?","voice":["vo_event_400701402_26"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":29,"content":"익숙한 목소리와 함께 은은한 향기가 코를 간지럽히며 아직 고르지 않은 당신의 호흡을 진정시켰다.","style":3,"background":4118,"log_type":1},{"step":30,"content":"여인이 앞으로 다가와 당신의 헝클어진 머리카락을 어루만지며 안쓰러운 듯 말했다.","style":3,"background":4119,"log_type":1},{"step":32,"speaker":"??","content":"…또 이런 모양이 되다니. 이대로 돌아갈 수는 없죠…","voice":["vo_event_400701402_29"],"voice_bank":"vo_event_07014","style":1,"background":4122,"log_type":1},{"step":33,"speaker":"??","content":"자, 손 주세요. 집에 가기 전에 일단 수습 좀 해드릴게요.","voice":["vo_event_400701402_30"],"voice_bank":"vo_event_07014","style":1,"background":4122,"log_type":1}]}