{"id":1060204,"chapter_id":1060204,"scene_id":1,"steps":[{"step":1,"content":"짙은 어둠이 한순간에 모든 걸 덮어 버렸고, 세상은 삽시간에 조용해졌다.","style":3,"background":10000,"log_type":1,"src_id":160204001,"trial_step":1},{"step":2,"options":["엔퍼…?"],"style":6,"background":10000,"log_type":1,"src_id":160204002,"trial_step":2,"course":3,"choices":[{"text":"엔퍼…?","goto":3}]},{"step":3,"content":"경계는 보이지 않았고, 괴이하고 지칠 줄 모르는 것만이 희미하게 당신의 눈앞을 스쳐 지나갔다.","style":3,"background":10000,"log_type":1,"src_id":160204003,"trial_step":3},{"step":4,"content":"하지만 여기의 느낌은 아주 익숙했다. 당신은 이것이 엔퍼의 능력이라는 것을 알 수 있었다. 허망한 사람은 엔퍼의 작품이니 지금 당신이 보는 것은…","style":3,"background":10000,"log_type":1,"src_id":160204004,"trial_step":4},{"step":5,"content":"엔퍼 자신의 두려움이다.","style":3,"background":109,"log_type":1,"src_id":160204005,"trial_step":5},{"step":6,"speaker":"엔퍼","content":"국장님, 보세요. 전… 이런 것들도 무서워했었네요…","voice":["vo_trial_60204_1_1"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204006,"trial_step":6},{"step":7,"content":"어둠 속에서 갑자기 엔퍼의 목소리가 들려왔다. 앞쪽을 보자 멀지 않은 곳에서 엔퍼가 뒷짐을 지고 번쩍이는 영화 스크린 같은 것을 지켜보고 있었다.","style":3,"background":109,"log_type":1,"src_id":160204007,"trial_step":7},{"step":8,"content":"스크린 안에선 당신이 본 적 없던 엔퍼의 모습이 끊임없이 반복해서 나오고 있었다.","style":3,"background":109,"log_type":1,"src_id":160204008,"trial_step":8},{"step":9,"speaker":"'소녀'","content":"앗…! 엄마! 꿀벌이 저를 쐈어요!","voice":["vo_trial_60204_1_2"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204009,"trial_step":9},{"step":10,"speaker":"'소녀'","content":"아야… 꿀벌 무서워… 흑흑, 꿀벌이 세상에서 없어지면 좋겠어요!","voice":["vo_trial_60204_1_3"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204010,"trial_step":10},{"step":11,"content":"어린 아이가 다친 손가락을 들어올리고 한 부인의 품에 뛰어들어 눈물을 글썽였다.","style":3,"background":109,"log_type":1,"src_id":160204011,"trial_step":11},{"step":12,"speaker":"'소녀'","content":"퉤, 퉤!","voice":["vo_trial_60204_1_4"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204012,"trial_step":12},{"step":13,"speaker":"'소녀'","content":"아, 뜨거워… 입천장 덴 것 같아…","voice":["vo_trial_60204_1_5"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204013,"trial_step":13},{"step":14,"speaker":"'소녀'","content":"아파…","voice":["vo_trial_60204_1_6"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204014,"trial_step":14},{"step":15,"content":"엔퍼는 스크린 속 뜨거운 홍차가 가득 채워진 잔을 멀리 밀어내는 소녀를 보며 웃음 터뜨렸다.","style":3,"background":109,"log_type":1,"src_id":160204015,"trial_step":15},{"step":16,"speaker":"엔퍼","content":"하하… 어릴 때는…","voice":["vo_trial_60204_1_7"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204016,"trial_step":16},{"step":17,"speaker":"엔퍼","content":"공포라는 것은 불과 꿀벌한테 쏘이고, 입천장을 데는 홍차일 뿐이었어요.","voice":["vo_trial_60204_1_8"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204017,"trial_step":17},{"step":18,"speaker":"엔퍼","content":"그녀들이 만들어낸 건… 유치하고, 생생하고, 순진하기 짝이 없어요.","voice":["vo_trial_60204_1_9"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204018,"trial_step":18},{"step":19,"speaker":"엔퍼","content":"하지만 그녀들 자신처럼… 닿기만 해도 부서질 정도로 연약하죠.","voice":["vo_trial_60204_1_10"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204019,"trial_step":19},{"step":20,"content":"엔퍼는 앞으로 걸어가더니 당신에게 손을 흔들었다.","style":3,"background":109,"log_type":1,"src_id":160204020,"trial_step":20},{"step":21,"speaker":"엔퍼","content":"기억의 깊은 곳엔 분명 더 많은 '화면 조각'이 있을 거예요. 같이 보러 가요.","voice":["vo_trial_60204_1_11"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204021,"trial_step":21},{"step":22,"speaker":"엔퍼","content":"그것이 저의 연약함을 알고, 제가 왜 막막한지 안다며 떠들었잖아요.","voice":["vo_trial_60204_1_12"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204022,"trial_step":22},{"step":23,"speaker":"엔퍼","content":"그럼 도대체 무엇이 나의 두려움 깊은 곳에 숨어 있길래 저를 막막하게 만드는 건지 직접 가서 확인해야겠어요.","voice":["vo_trial_60204_1_13"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204023,"trial_step":23},{"step":24,"content":"당신은 엔퍼가 걸어간 흔적을 따라 천천히 앞으로 나아갔다.","style":3,"background":109,"log_type":1,"src_id":160204024,"trial_step":24},{"step":25,"content":"눈앞에 또 하나의 스크린이 나타났다.","style":3,"background":109,"log_type":1,"src_id":160204025,"trial_step":25},{"step":26,"content":"스크린은 아까처럼 빛나지 않았고, 마치 무거운 먹구름이 쌓인 것처럼 어두웠다.","style":3,"background":109,"log_type":1,"src_id":160204026,"trial_step":26},{"step":27,"speaker":"엔퍼","content":"……","style":1,"background":109,"log_type":1,"src_id":160204027,"trial_step":27},{"step":28,"speaker":"엔퍼","content":"이 구름들 기억해요.","voice":["vo_trial_60204_1_15"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204028,"trial_step":28},{"step":29,"content":"엔퍼는 스크린을 바라보며 중얼거렸다.","style":3,"background":109,"log_type":1,"src_id":160204029,"trial_step":29},{"step":30,"content":"그녀의 말에 응답하듯 스크린에 눈 부신 번개가 쳤지만, 여전히 '공포'를 밝힐 수는 없었다.","style":3,"background":109,"log_type":1,"src_id":160204030,"trial_step":30},{"step":31,"speaker":"'소녀'","content":"아빠…?","voice":["vo_trial_60204_1_16"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204031,"trial_step":31},{"step":32,"speaker":"'소녀'","content":"혹시… 엄마 못 봤어요?","voice":["vo_trial_60204_1_17"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204032,"trial_step":32},{"step":33,"speaker":"'아빠'","content":"엄마? 엄마는 여기 계시잖니?","voice":["vo_trial_60204_1_18"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204033,"trial_step":33},{"step":34,"content":"천둥과 번개가 치자 소녀의 눈앞이 환해졌다.","style":3,"background":109,"log_type":1,"src_id":160204034,"trial_step":34},{"step":35,"content":"소녀가 밟고 있던 따뜻한 액체는 자신이 생각하는 뜨거운 물이 아니었고, 콧끝을 맴도는 냄새도 역시 비 오는 날 특유의 흙냄새가 아니었다.","style":3,"background":109,"log_type":1,"src_id":160204035,"trial_step":35},{"step":36,"speaker":"'아빠'","content":"잘 기억해두거라! 잘 배워두거라!!!","voice":["vo_trial_60204_1_19"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204036,"trial_step":36},{"step":37,"content":"아버지는 소녀를 들어 자신 앞에 던졌고, 고개를 돌리지 못하도록 소녀의 얼굴을 붙잡았다.","style":3,"background":109,"log_type":1,"src_id":160204037,"trial_step":37},{"step":38,"speaker":"'아빠'","content":"이래야만… 이래야만 내가 성공할 수 있어! 그들이 그랬었지. 삶과 죽음 사이엔 분명 가장 자극적인 영감이 있을 거라고 말이야! 하하하하!!","voice":["vo_trial_60204_1_20"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204038,"trial_step":38},{"step":39,"speaker":"'아빠'","content":"넌… 엄청나게 성공한 아버지와 가정을 가지게 될 거다!","voice":["vo_trial_60204_1_21"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204039,"trial_step":39},{"step":40,"content":"소녀의 모든 감각이 증폭됐지만 유독 아무 소리도 들리지 않았고, 심지어 자신의 심장 박동 소리조차 들리지 않았다.","style":3,"background":109,"log_type":1,"src_id":160204040,"trial_step":40},{"step":41,"content":"소녀는 아직도 눈앞에서 간들간들 흔들리는 옷자락을 보며 머릿속이 하얘졌다.","style":3,"background":109,"log_type":1,"src_id":160204041,"trial_step":41},{"step":42,"speaker":"엔퍼","content":"빨리 가죠…","voice":["vo_trial_60204_1_22"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204042,"trial_step":42},{"step":43,"content":"꽉 쥔 엔퍼의 손이 미세하게 떨리고 있었다.","style":3,"background":109,"log_type":1,"src_id":160204043,"trial_step":43},{"step":44,"content":"비명 소리가 침묵을 깼고, 당신은 급히 고개를 들어 소리가 나는 쪽을 쳐다봤다.","style":3,"background":109,"log_type":1,"src_id":160204044,"trial_step":44},{"step":45,"content":"스크린 속 소녀는 거칠게 밀려 바닥에 내동댕이쳐졌다.","style":3,"background":109,"log_type":1,"src_id":160204045,"trial_step":45},{"step":46,"content":"소녀는 놀라서 두 눈을 크게 뜨고 아버지가 계속해서 조각끌을 내려치는 것을 보았다.","style":3,"background":109,"log_type":1,"src_id":160204046,"trial_step":46},{"step":47,"content":"이건?!","style":2,"background":109,"log_type":1,"src_id":160204047,"trial_step":47},{"step":48,"content":"화면이 되돌아가기 시작했고, 소녀가 밀려난 그 장면까지 되감긴 후 계속 반복해서 재생됐다.","style":3,"background":109,"log_type":1,"src_id":160204048,"trial_step":48},{"step":49,"speaker":"엔퍼","content":"……","voice":["vo_trial_60204_1_23"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204049,"trial_step":49},{"step":50,"speaker":"엔퍼","content":"왜… 왜 여기 그 분이 있지… 말이 안 되는데.","voice":["vo_trial_60204_1_24"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204050,"trial_step":50},{"step":51,"content":"빛과 어둠이 엔퍼의 얼굴에 교차했다. 당신은 엔퍼가 중얼거리는 소리만 들을 수 있을 뿐, 그녀의 표정은 제대로 볼 수 없었다.","style":3,"background":109,"log_type":1,"src_id":160204051,"trial_step":51},{"step":52,"speaker":"엔퍼","content":"어머니… 어머니…","voice":["vo_trial_60204_1_25"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204052,"trial_step":52},{"step":53,"content":"엔퍼가 어머니를 부르는 소리만 은은히 들려왔다.","style":3,"background":109,"log_type":1,"src_id":160204053,"trial_step":53},{"step":54,"content":"마치 마음속의 저주를 조금씩 더 깊게 새기듯 스크린에서는 아직도 모든 것이 반복해서 재생되고 있었다.","style":3,"background":109,"log_type":1,"src_id":160204054,"trial_step":54},{"step":55,"options":["나… 저 사람 알아"],"style":6,"background":109,"log_type":1,"src_id":160204055,"trial_step":55,"course":3,"choices":[{"text":"나… 저 사람 알아","goto":56}]},{"step":56,"speaker":"엔퍼","content":"…뭐라고요?","voice":["vo_trial_60204_1_26"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204056,"trial_step":56},{"step":57,"content":"당신은 엔퍼를 밀친 사람의 모습을 한참 보더니 그게 마녀의 밤에서 엔퍼를 위해 최후의 일격을 막아준 사람과 아주 비슷하다는 것을 알아챘다.","style":3,"background":109,"log_type":1,"src_id":160204057,"trial_step":57},{"step":58,"content":"난 저 사람이 왜 여기에 있는지 알아… 엔퍼.","style":2,"background":109,"log_type":1,"src_id":160204058,"trial_step":58},{"step":59,"speaker":"엔퍼","content":"그럴 리가… 그분은… 그날 부터 내 세계에서 사라졌을 텐데…","voice":["vo_trial_60204_1_27"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204059,"trial_step":59},{"step":60,"speaker":"엔퍼","content":"그때부터 제 의식엔 공포만이 남게 됐다고요!","voice":["vo_trial_60204_1_28"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204060,"trial_step":60},{"step":61,"content":"네가 무의식적으로 그 흔적을 남기는 건… 그분이 네 의식 깊은 곳에 사랑을 각인시켜 뒀기 때문이야.","style":2,"background":109,"log_type":1,"src_id":160204061,"trial_step":61},{"step":62,"content":"그래서 넌 계속 사랑을 두려워하고 있던 거지, 엔퍼.","style":2,"background":109,"log_type":1,"src_id":160204062,"trial_step":62},{"step":63,"content":"이게… 네 '사랑'의 근원이었어.","style":2,"background":109,"log_type":1,"src_id":160204063,"trial_step":63},{"step":64,"content":"엔퍼는 스크린 속의 그 의아한 소녀처럼 천천히 고개를 들고 눈을 크게 뜬 채 당신을 바라봤다.","style":3,"background":109,"log_type":1,"src_id":160204064,"trial_step":64},{"step":65,"speaker":"엔퍼","content":"사랑…의 근원?","voice":["vo_trial_60204_1_29"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204065,"trial_step":65},{"step":66,"speaker":"'허망한 사람'","content":"하하하… 그래, 그래! 이게 바로 네가 계속 남겨놨던 사랑! 줄곧 버리지 않았던 사랑이야!","voice":["vo_trial_60204_1_30"],"voice_bank":"vo_enfer_trial","style":1,"background":109,"log_type":1,"src_id":160204066,"trial_step":66},{"step":67,"content":"주변의 어둠이 불안하게 요동쳤고, 그 무서운 소리가 다시 한 번 울려 퍼지며 당신들을 중심에 포위해 뒀다.","style":3,"background":10000,"log_type":1,"src_id":160204067,"trial_step":67},{"step":68,"speaker":"'허망한 사람'","content":"그녀 때문에, 사랑이라는 것 때문에! 넌 막막해하고 정체되어 있던 거야!","voice":["vo_trial_60204_1_31"],"voice_bank":"vo_enfer_trial","style":1,"background":10000,"log_type":1,"src_id":160204068,"trial_step":68},{"step":69,"speaker":"엔퍼","content":"난… 그녀의… 구원 때문에… 사랑 때문에…","voice":["vo_trial_60204_1_32"],"voice_bank":"vo_enfer_trial","style":1,"background":10000,"log_type":1,"src_id":160204069,"trial_step":69},{"step":70,"speaker":"엔퍼","content":"연약했던 거야…","voice":["vo_trial_60204_1_33"],"voice_bank":"vo_enfer_trial","style":1,"background":10000,"log_type":1,"src_id":160204070,"trial_step":70},{"step":71,"speaker":"'허망한 사람'","content":"그래!!","voice":["vo_trial_60204_1_34"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204071,"trial_step":71},{"step":72,"speaker":"'허망한 사람'","content":"목격했으니 반드시 계승할 수 있어!","voice":["vo_trial_60204_1_35"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204072,"trial_step":72},{"step":73,"speaker":"'허망한 사람'","content":"순수한 공포, 인간의 공포만 있으면! 너는 가장 완벽한 작품을 만들어낼 수 있어!","voice":["vo_trial_60204_1_36"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204073,"trial_step":73},{"step":74,"speaker":"'허망한 사람'","content":"사랑 따윈 필요 없어. 공포와… 두려움… 통곡만 있으면 돼!","voice":["vo_trial_60204_1_37"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204074,"trial_step":74},{"step":75,"speaker":"'허망한 사람'","content":"그녀를 제거해! 찢어발기고! 버리고! 잊고! 포기해!","voice":["vo_trial_60204_1_38"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204075,"trial_step":75},{"step":76,"speaker":"'허망한 사람'","content":"어떻게 해야 하는지 알잖아.","voice":["vo_trial_60204_1_39"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204076,"trial_step":76},{"step":77,"content":"발 아래의 어둠이 울렁이기 시작하며 다시 한 번 융화된 액체가 되어 역청처럼 쏟아졌다.","style":3,"background":110,"log_type":1,"src_id":160204077,"trial_step":77},{"step":78,"content":"엔퍼! 그 말 듣지 마!!","style":2,"background":110,"log_type":1,"src_id":160204078,"trial_step":78},{"step":79,"content":"뭔가 이상하다는 것을 깨달은 당신은 바로 엔퍼를 향해 달리기 시작했지만, 아무리 달려도 거리는 조금도 좁혀지지 않는 것 같았다.","style":3,"background":110,"log_type":1,"src_id":160204079,"trial_step":79},{"step":80,"content":"이 기억들은 네 의식 속 깊은 곳에 있어! 네가 받은 사랑은 네 의식 깊숙한 곳에 숨겨져 있다고!","style":2,"background":110,"log_type":1,"src_id":160204080,"trial_step":80},{"step":81,"content":"정말로 그걸 다 지워버리고 싶은 거야?!","style":2,"background":110,"log_type":1,"src_id":160204081,"trial_step":81},{"step":82,"content":"이걸… 지워버린 다는 건!! 절대로 네 막막함과 연약함을 해결할 방법이 아니야! 이건 도망치는 거지! 맞서는 게 아니야!","style":2,"background":110,"log_type":1,"src_id":160204082,"trial_step":82},{"step":83,"speaker":"'허망한 사람'","content":"닥쳐… 닥쳐닥쳐닥쳐닥쳐!!","voice":["vo_trial_60204_1_40"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204083,"trial_step":83},{"step":84,"speaker":"'허망한 사람'","content":"너에겐… 공포도, 진실도 없어! 여기에 있으면 안 되고, 있을 자격도 없어!","voice":["vo_trial_60204_1_41"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204084,"trial_step":84},{"step":85,"speaker":"'허망한 사람'","content":"엔퍼한테서 떨어져! 나한테서 떨어져! 엔퍼한테서 떨어져! 나한테서 떨어져!","voice":["vo_trial_60204_1_42"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204085,"trial_step":85},{"step":86,"content":"당신의 말이 '허망한 사람'을 화나게 한 것 같았다. 허망한 사람은 비명을 지르며 해일과 같은 검은 파도를 일으켜 당신을 공격했다!","style":3,"background":110,"log_type":1,"src_id":160204086,"trial_step":86},{"step":87,"content":"그것들은 수많은 가시로 변했고, 무수한 검은색 조각끌처럼 땡그랑거리는 소리를 내며 이 공간을 찢었다.","style":3,"background":110,"log_type":1,"src_id":160204087,"trial_step":87},{"step":88,"content":"여… 여기서 떠나야 할 건 너야!","style":2,"background":110,"log_type":1,"src_id":160204088,"trial_step":88},{"step":89,"content":"엔퍼! 여긴 네 마음속이야! 네 의식이라고!","style":2,"background":110,"log_type":1,"src_id":160204089,"trial_step":89},{"step":90,"content":"네 힘은 전부 여기서 나오는 거잖아!","style":2,"background":110,"log_type":1,"src_id":160204090,"trial_step":90},{"step":91,"speaker":"엔퍼","content":"하지만 제 힘은… 연약함에 사로잡혀…","voice":["vo_trial_60204_1_43"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204091,"trial_step":91},{"step":92,"content":"쓸데없는 말은 듣지 마!","style":2,"background":110,"log_type":1,"src_id":160204092,"trial_step":92},{"step":93,"content":"순수한 공포는 너에게 앞으로 나아갈 거대한 힘을 줄 수 있어. 하지만 널 심연과 동화시킬 뿐 네가 심연을 건너게 할 수는 없지.","style":2,"background":110,"log_type":1,"src_id":160204093,"trial_step":93},{"step":94,"content":"나방이 고치를 부순다고 더 순수해지는 건 아니잖아. 복잡한 무늬도, 색채도 모두 나방의 놀라운 점이야.","style":2,"background":110,"log_type":1,"src_id":160204094,"trial_step":94},{"step":95,"content":"네 말처럼 나방이 불에 달려들 때 공포만 품고 있을 거라고는 누가 장담할 수 있지?","style":2,"background":110,"log_type":1,"src_id":160204095,"trial_step":95},{"step":96,"content":"엔퍼는 멈칫하더니 몸을 돌려 말없이 당신을 바라봤고, 눈에는 탐구심이 가득했다.","style":3,"background":110,"log_type":1,"src_id":160204096,"trial_step":96},{"step":97,"content":"어쩌면 나방은 불꽃을 사랑하기 때문에 무섭더라도 의연히 불꽃을 향해 날아간 건 아닐까?","style":2,"background":110,"log_type":1,"src_id":160204097,"trial_step":97},{"step":98,"speaker":"엔퍼","content":"…불꽃을 사랑한다고요?","voice":["vo_trial_60204_1_44"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204098,"trial_step":98},{"step":99,"speaker":"엔퍼","content":"그 힘엔 공포만 있는 게 아니라 사랑도 있었다. 이건가요?","voice":["vo_trial_60204_1_45"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204099,"trial_step":99},{"step":100,"content":"그래.","style":2,"background":110,"log_type":1,"src_id":160204100,"trial_step":100},{"step":101,"options":["사랑을 회피하지 마, 엔퍼"],"style":6,"background":110,"log_type":1,"src_id":160204101,"trial_step":101,"course":3,"choices":[{"text":"사랑을 회피하지 마, 엔퍼","goto":102}]},{"step":102,"content":"'허망한 사람'은 다시 격노했고 먹구름 속의 천둥처럼 울부짖었다.","style":3,"background":110,"log_type":1,"src_id":160204102,"trial_step":102},{"step":103,"content":"허망한 사람은 검은 가시들을 조종해 한편으론 엔퍼를 완전히 덮치면서 한편으론 당신을 향해 검은 가시비를 쏟아지게 했다!","style":3,"background":110,"log_type":1,"src_id":160204103,"trial_step":103},{"step":104,"content":"쯧… 한발 늦었나…","style":2,"background":110,"log_type":1,"src_id":160204104,"trial_step":104},{"step":105,"content":"그럼… 최대한 해 볼 수 밖에 없겠네.","style":2,"background":110,"log_type":1,"src_id":160204105,"trial_step":105},{"step":106,"content":"당신은 몸을 돌려 멀지 않은 곳에서 완전히 삼켜진 엔퍼를 바라보며, 손에 있는 빨간 족쇄를 가시나무처럼 뻗어 지게 했다.","style":3,"background":110,"log_type":1,"src_id":160204106,"trial_step":106},{"step":107,"content":"검은 비가 세차게 내렸다.","style":3,"background":110,"log_type":1,"src_id":160204107,"trial_step":107},{"step":108,"speaker":"???","content":"멈춰, 넌 아직 저 사람한테 손 댈 자격이 없어.","voice":["vo_trial_60204_1_46","vo_trial_60204_1_46f"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204108,"trial_step":108},{"step":109,"content":"검은 바늘이 당신의 눈앞 몇 센티미터 앞에서 멈춘 채 꼼짝도 하지 않았다.","style":3,"background":110,"log_type":1,"src_id":160204109,"trial_step":109},{"step":110,"content":"당신은 족쇄를 바라봤다. 분명 조금 더 있어야 수감자에게 닿을 수 있었다.","style":3,"background":110,"log_type":1,"src_id":160204110,"trial_step":110},{"step":111,"speaker":"엔퍼","content":"맞아. 여기는 내 각인, 내 의식이야…","voice":["vo_trial_60204_1_47"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204111,"trial_step":111},{"step":112,"speaker":"엔퍼","content":"이곳의 모든 것은 나한테 복종해야 해.","voice":["vo_trial_60204_1_48"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204112,"trial_step":112},{"step":113,"content":"어둠 속의 색채가 엄청난 공포에 쫓기듯 초조와 불안에 떨며 이곳에서 달아나려는 것 같았다.","style":3,"background":110,"log_type":1,"src_id":160204113,"trial_step":113},{"step":114,"content":"엔퍼를 감싼 검은 액체가 몸부림치기 시작했다. 한 번 움직일 때마다 엄청난 힘이 소모되는데도 멈추지 않았고, 가슴에 작은 구멍이 점점 드러날 때까지 애써 버텼다.","style":3,"background":110,"log_type":1,"src_id":160204114,"trial_step":114},{"step":115,"content":"얼마 지나지 않아 가느다란 팔 한 쌍이 구멍에서 뻗어 나와 무시무시한 검은 형체를 움켜쥐고 힘껏 양쪽으로 찢어버렸다.","style":3,"background":110,"log_type":1,"src_id":160204115,"trial_step":115},{"step":116,"speaker":"엔퍼","content":"고작 이 정도로… 나를 가두려던 거야?","voice":["vo_trial_60204_1_49"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204116,"trial_step":116},{"step":117,"content":"그 푸른 형체는 검고 두꺼운 고치를 벗어나 거만하게 고개를 들고 자신의 의식 세계를 덮은 검은 그림자를 바라봤다.","style":3,"background":110,"log_type":1,"src_id":160204117,"trial_step":117},{"step":118,"content":"엔퍼의 눈빛은 마녀의 밤 중 당신 앞에서 지옥의 문을 쪼갰던 사람을 떠올리게 했다.","style":3,"background":110,"log_type":1,"src_id":160204118,"trial_step":118},{"step":119,"content":"도도하며 만장의 기염을 토했다.","style":3,"background":110,"log_type":1,"src_id":160204119,"trial_step":119},{"step":120,"speaker":"엔퍼","content":"지워버리거나… 자신의 막막함과 연약함을 묻어두라고?","voice":["vo_trial_60204_1_50"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204120,"trial_step":120},{"step":121,"speaker":"엔퍼","content":"하, 그러면 너와 똑같아질 뿐이야. 결국은 100년 후에 잊힐 조각상이 돼서 영원히 어두운 지하실에 잠들 뿐이라고!","voice":["vo_trial_60204_1_51"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204121,"trial_step":121},{"step":122,"speaker":"엔퍼","content":"결국은… 소멸해서 재가 되겠지.","voice":["vo_trial_60204_1_52"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204122,"trial_step":122},{"step":123,"content":"엔퍼는 손을 들어 자신의 무기… 푸른 망치와 끌을 쥐었다.","style":3,"background":110,"log_type":1,"src_id":160204123,"trial_step":123},{"step":124,"content":"엔퍼는 한 걸음씩 당신에게 다가와 당신과 함께 검은 바늘 비 속에 섰다.","style":3,"background":110,"log_type":1,"src_id":160204124,"trial_step":124},{"step":125,"speaker":"엔퍼","content":"너한테… 허망이라는 이름이 붙여진 이유는, 네 모든 건 내 허망함에 불과했고 내가 나 자신의 허망함에 사로잡혀 있었기 때문이야.","voice":["vo_trial_60204_1_53"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204125,"trial_step":125},{"step":126,"speaker":"엔퍼","content":"진실을 제대로 보지 못한 사람은 너였어.","voice":["vo_trial_60204_1_54"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204126,"trial_step":126},{"step":127,"speaker":"'허망한 사람'","content":"무슨 소리야! 그녀는 널 연약하게 만들고 널 지옥에 남겨 두었어!","voice":["vo_trial_60204_1_55"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204127,"trial_step":127},{"step":128,"speaker":"'허망한 사람'","content":"계속 그렇게 생각했잖아! 다 알고 있다고!","voice":["vo_trial_60204_1_56"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204128,"trial_step":128},{"step":129,"content":"엔퍼는 조각끌을 들고 허공에 있는 한 점을 향해 웃었다.","style":3,"background":110,"log_type":1,"src_id":160204129,"trial_step":129},{"step":130,"speaker":"엔퍼","content":"그래. 어머니는 어쩔 수 없이 날 지옥으로 보냈지… 하지만 내가 제일 좋아하는 게… 지옥이잖아?","voice":["vo_trial_60204_1_57"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204130,"trial_step":130},{"step":131,"speaker":"엔퍼","content":"난… 네 증인이긴 하지만, 절대로 네 계승자는 아니야.","voice":["vo_trial_60204_1_58"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204131,"trial_step":131},{"step":132,"speaker":"엔퍼","content":"넌 사랑을 두려워하고, 사랑이 결국 너에게 가져다 줄 지옥을 두려워하고 있지… 그래서 마주하길 거부하는 거야.","voice":["vo_trial_60204_1_59"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204132,"trial_step":132},{"step":133,"speaker":"엔퍼","content":"하지만 난 달라.","voice":["vo_trial_60204_1_60"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204133,"trial_step":133},{"step":134,"content":"엔퍼는 푸른 망치를 들고 세차게 끌을 두드렸고, 허공에 있는 점에서 큰 소리가 났다.","style":3,"background":110,"log_type":1,"src_id":160204134,"trial_step":134},{"step":135,"content":"검은색이 조금씩 벗겨지며 하트 모양의 각인이 드러났다. 엔퍼가 만든 모든 작품에 있는 그 각인이었다.","style":3,"background":110,"log_type":1,"src_id":160204135,"trial_step":135},{"step":136,"speaker":"엔퍼","content":"나는 사랑 덕분에… 이 지옥 같은 세상에 살아 있는 거야…","voice":["vo_trial_60204_1_61"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204136,"trial_step":136},{"step":137,"speaker":"엔퍼","content":"그리고 살아 있는 동안 누군가가 나한테 말해줬어… 사랑 역시 공포처럼 내 힘이 될 수 있다고 말이야.","voice":["vo_trial_60204_1_62"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204137,"trial_step":137},{"step":138,"content":"엔퍼는 당신의 곁으로 다가와 일으켜 세워주고는 당신과 함께 끌을 쥐고 하트 모양의 각인을 겨누게 했다.","style":3,"background":110,"log_type":1,"src_id":160204138,"trial_step":138},{"step":139,"speaker":"엔퍼","content":"저는 공포의 지배자예요. 그러니 사랑을 두려워하지 않죠… 저는 사랑을 뚫어버리고… 사랑을 제 힘의 일부분으로 받아들여 계속해서 만들고, 찢어내고, 다시 태어나게 할 거예요…","voice":["vo_trial_60204_1_63"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204139,"trial_step":139},{"step":140,"speaker":"엔퍼","content":"가장 완벽한 작품이 될 때까지요.","voice":["vo_trial_60204_1_64"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204140,"trial_step":140},{"step":141,"content":"엔퍼는 당신을 바라보며 말했다.","style":3,"background":110,"log_type":1,"src_id":160204141,"trial_step":141},{"step":142,"speaker":"엔퍼","content":"국장님, 족쇄를 시전해주세요.","voice":["vo_trial_60204_1_65"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204142,"trial_step":142},{"step":143,"speaker":"엔퍼","content":"제가 함께 고치를 깰게요.","voice":["vo_trial_60204_1_66"],"voice_bank":"vo_enfer_trial","style":1,"background":110,"log_type":1,"src_id":160204143,"trial_step":143},{"step":144,"content":"붉고 푸른 빛이 의식 전체를 덮었고, 어둠은 그것들에 의해 삼켜져 사라졌다.","style":3,"background":10006,"log_type":1,"src_id":160204145,"trial_step":145},{"step":145,"content":"빛 아래서 당신은 화려한 파란색 나방이 검은 고치에서 몸부림치다 날아가는 것을 보았다.","style":3,"background":10006,"log_type":1,"src_id":160204146,"trial_step":146},{"step":146,"content":"나방은 날개에 불빛을 머금고 먼 곳을 향해 가볍게 날아갔다.","style":3,"background":10006,"log_type":1,"src_id":160204147,"trial_step":147},{"step":147,"content":"그곳이 설령 지옥이라 하더라도… 그녀는 이제 공포에만 휩싸여 있지는 않을 것이다.","style":3,"background":10006,"log_type":1,"src_id":160204148,"trial_step":148}]}