{"id":1030104,"chapter_id":1030104,"scene_id":1,"steps":[{"step":1,"speaker":"정보요원","content":"죄송합니다, 국장님. 아직도 백의 배후를 알아내지 못했습니다.","voice":["vo_trial_30104_1_1"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104001,"trial_step":1},{"step":2,"content":"정보요원이 책상 앞에 앉아 있는 당신에게 요 며칠간의 진행 상황을 보고했다.","style":3,"background":1040,"log_type":1,"src_id":130104002,"trial_step":2},{"step":3,"content":"급하지 않아. 이 일은 오랫동안 계속해야 할 수도 있어. 인내심을 갖고 임하면 언젠가는 진전이 있을 거야.","style":2,"background":1040,"log_type":1,"src_id":130104003,"trial_step":3},{"step":4,"speaker":"정보요원","content":"국장님…","voice":["vo_trial_30104_1_4"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104004,"trial_step":4},{"step":5,"content":"정보요원이 난처한 표정을 드러냈다.","style":3,"background":1040,"log_type":1,"src_id":130104005,"trial_step":5},{"step":6,"speaker":"정보요원","content":"알려진 정보처럼, 백이 정말 그냥 평범한 수감자인 건 아닐까요?","voice":["vo_trial_30104_1_6"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104006,"trial_step":6},{"step":7,"speaker":"정보요원","content":"모든 소문과 증거가 그것을 입증하고 있습니다. 심지어는 국장님께서 겪으신 일마저도요.","voice":["vo_trial_30104_1_7"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104007,"trial_step":7},{"step":8,"speaker":"정보요원","content":"그 무식한 군단 놈들을 제외하면 그 어떤 대형 조직과도 결탁한 적이 없습니다. 정말로 어떤 비밀이 있다고 해도, 이렇게까지 빈틈이 없기란 불가능합니다.","voice":["vo_trial_30104_1_8"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104008,"trial_step":8},{"step":9,"content":"아니, 놓친 게 있어.","style":2,"background":1040,"log_type":1,"src_id":130104009,"trial_step":9},{"step":10,"content":"백기실업을 사칭하는 곳을 급습한 날, 거기 사장이 어떤 알 수 없는 사람이 자기에게 사업 자금과 변이 무기를 줬다고 했어.","style":2,"background":1040,"log_type":1,"src_id":130104010,"trial_step":10},{"step":11,"content":"그리고 그 상대가 내건 조건은 오직 하나였지. 백기라는 명의로 신디케이트에 회사를 설립할 것.","style":2,"background":1040,"log_type":1,"src_id":130104011,"trial_step":11},{"step":12,"speaker":"정보요원","content":"하지만 그 사람의 단편적인 주장입니다. 그걸 증거로 내세우기엔…","voice":["vo_trial_30104_1_12"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104012,"trial_step":12},{"step":13,"content":"이것뿐이라면 당연히 증거로 부족하지.","style":2,"background":1040,"log_type":1,"src_id":130104013,"trial_step":13},{"step":14,"content":"하지만 가장 흥미로웠던 건 백의 반응이었어.","style":2,"background":1040,"log_type":1,"src_id":130104014,"trial_step":14},{"step":15,"speaker":"정보요원","content":"백의 반응이요?","voice":["vo_trial_30104_1_15"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104015,"trial_step":15},{"step":16,"content":"그간 봐온 백의 모습을 떠올린다면, 과연 백이 '백기실업'의 평판에 대해 신경 쓰는 사람일까?","style":2,"background":1040,"log_type":1,"src_id":130104016,"trial_step":16},{"step":17,"content":"숨어 있던 세력이 대놓고 모의를 짰어. 놈들의 목표가 백이 아니면 누구겠어?","style":2,"background":1040,"log_type":1,"src_id":130104017,"trial_step":17},{"step":18,"content":"백이 걸려들었다는 건, 백과 그 적대 세력이 암묵적인 관계를 맺었다는 걸지도 모르지. 하지만 백은 아무런 준비도 없이 약속 장소로 나간 게 아니야. 나를 통해 MBCC의 힘을 통째로 이용했어.","style":2,"background":1040,"log_type":1,"src_id":130104018,"trial_step":18},{"step":19,"speaker":"정보요원","content":"그런 거였군요…","voice":["vo_trial_30104_1_19"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104019,"trial_step":19},{"step":20,"content":"백 사장은 연기력이 뛰어나지만 성미가 급해. 나한테 자신이 무해하고 별 볼 일 없는 사람이라는 걸 보여주려고 안달이 나 있지.","style":2,"background":1040,"log_type":1,"src_id":130104020,"trial_step":20},{"step":21,"content":"정체를 밝혀내기 전까지는 그녀의 연기에 장단을 좀 맞춰주자고.","style":2,"background":1040,"log_type":1,"src_id":130104021,"trial_step":21},{"step":22,"speaker":"정보요원","content":"국장님! 조금 전에 정보기관에서 레트·백의 정보를 확인했습니다.","voice":["vo_trial_30104_1_22"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104022,"trial_step":22},{"step":23,"content":"백을 사칭한 사람 말인가?","style":2,"background":1040,"log_type":1,"src_id":130104023,"trial_step":23},{"step":24,"speaker":"정보요원","content":"맞습니다.","voice":["vo_trial_30104_1_24"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104024,"trial_step":24},{"step":25,"speaker":"정보요원","content":"레트·백, 신성 출신. 반년 전 파산 후 실종됨.","voice":["vo_trial_30104_1_25"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104025,"trial_step":25},{"step":26,"speaker":"정보요원","content":"지금 스파이로부터 소식을 받았는데, 그자를 닮은 사람이 러스트 리버에 가장 근접해 있는 사르트 거리에 나타났다고 합니다. 신성으로 도주할 가능성이 아주 큽니다.","voice":["vo_trial_30104_1_26"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104026,"trial_step":26},{"step":27,"content":"신디케이트에서 그런 체형을 보기는 어렵지. 틀린 정보는 아닐 거야.","style":2,"background":1040,"log_type":1,"src_id":130104027,"trial_step":27},{"step":28,"content":"백의 정체를 밝힐 때가 됐군. 인원을 소집하고 체포할 준비를 하도록.","style":2,"background":1040,"log_type":1,"src_id":130104028,"trial_step":28},{"step":29,"content":"아직도 안 나왔나?","style":2,"background":1008,"log_type":1,"src_id":130104029,"trial_step":29},{"step":30,"content":"당신과 MBCC의 작전요원 전체가 매복한 지 세 시간째였지만, 뒤를 밟는 자가 아직 아무런 소식을 전하지 않았다.","style":3,"background":1008,"log_type":1,"src_id":130104030,"trial_step":30},{"step":31,"speaker":"정보요원","content":"신성에 밀입국하는 '정기편'이 20분 뒤면 마감됩니다. 지금 가지 않으면 다음 주까지 기다려야 합니다…","voice":["vo_trial_30104_1_31"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104031,"trial_step":31},{"step":32,"content":"정보에 문제가 있는 게 아니라면, 예기치 못한 상황이 발생한 것일지도 모르지.","style":2,"background":1008,"log_type":1,"src_id":130104032,"trial_step":32},{"step":33,"speaker":"정보요원","content":"전체적으로 샅샅이 수색해볼까요?","voice":["vo_trial_30104_1_33"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104033,"trial_step":33},{"step":34,"content":"우리 인원으로는 무리야.","style":2,"background":1008,"log_type":1,"src_id":130104034,"trial_step":34},{"step":35,"content":"…10분만 더 기다려보고, 그래도 안 나타나면 바로 움직인다. 여관이나 호텔 위주로 수색하도록.","style":2,"background":1008,"log_type":1,"src_id":130104035,"trial_step":35},{"step":36,"speaker":"정보요원","content":"알겠습니다.","voice":["vo_trial_30104_1_36"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104036,"trial_step":36},{"step":37,"speaker":"정보요원","content":"국장님, 말씀하신 시간이 지났습니다.","voice":["vo_trial_30104_1_37"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104037,"trial_step":37},{"step":38,"content":"10분이 지나도록 아무런 움직임이 없었다.","style":3,"background":1008,"log_type":1,"src_id":130104038,"trial_step":38},{"step":39,"content":"더는 기다릴 수 없어… 시작해.","style":2,"background":1008,"log_type":1,"src_id":130104039,"trial_step":39},{"step":40,"speaker":"정보요원","content":"예!","voice":["vo_trial_30104_1_40"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104040,"trial_step":40},{"step":41,"content":"유능한 MBCC의 작전요원들이 매우 효율적으로 움직이기 시작했다. 두 팀이 거리의 주요 출구를 봉쇄했고, 나머지 몇 팀은 앞서 말한 주요 구역을 수색하기 시작했다.","style":3,"background":1008,"log_type":1,"src_id":130104041,"trial_step":41},{"step":42,"content":"그리고 불과 몇 분 만에 작전요원이 소식을 전해왔다.","style":3,"background":1008,"log_type":1,"src_id":130104042,"trial_step":42},{"step":43,"speaker":"정보요원","content":"국장님, 7-4구역에서 목표물을 찾아냈습니다!","voice":["vo_trial_30104_1_43"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104043,"trial_step":43},{"step":44,"content":"거기 지키고 있어. 지금 바로 갈게!","style":2,"background":1008,"log_type":1,"src_id":130104044,"trial_step":44},{"step":45,"speaker":"정보요원","content":"여기입니다!","voice":["vo_trial_30104_1_45"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130104045,"trial_step":45},{"step":46,"content":"도구를 이용해 강제로 부순 문을 열고 들어가 보니, 아수라장이 펼쳐져 있었다.","style":3,"background":10000,"log_type":1,"src_id":130104046,"trial_step":46},{"step":47,"content":"찬장과 책상, 그리고 침대 한쪽까지 부서져 있었으며 수상한 핏자국도 보였다.","style":3,"background":1034,"log_type":1,"src_id":130104047,"trial_step":47},{"step":48,"content":"방 한가운데에는 '백 사장'이 의자에 묶여 있었다. 입에는 테이프가 붙어 있고 눈가에는 눈물이 고인 그는 인사불성이 된 지 오래인 듯했다.","style":3,"background":1034,"log_type":1,"src_id":130104048,"trial_step":48},{"step":49,"content":"지난번에 봤을 때도 이랬는데…","style":2,"background":1034,"log_type":1,"src_id":130104049,"trial_step":49},{"step":50,"speaker":"작전요원","content":"국장님, 방에서 이걸 발견했습니다.","voice":["vo_trial_30104_1_50"],"voice_bank":"vo_linglan_trial","style":1,"background":1034,"log_type":1,"src_id":130104050,"trial_step":50},{"step":51,"content":"작전요원이 건넨 지퍼백에는 소형 캠코더가 담겨 있었다.","style":3,"background":1034,"log_type":1,"src_id":130104051,"trial_step":51},{"step":52,"options":["캠코더를 켠다"],"style":6,"background":1034,"log_type":1,"src_id":130104052,"trial_step":52,"course":3,"choices":[{"text":"캠코더를 켠다","goto":53}]},{"step":53,"content":"지퍼백을 열고 캠코더의 전원 버튼을 누른 뒤 영상을 확인했다.","style":3,"background":1034,"log_type":1,"src_id":130104053,"trial_step":53},{"step":54,"content":"넙데데한 얼굴이 겁에 질린 표정으로 화면을 가득 채웠다.","style":3,"background":1034,"log_type":1,"src_id":130104054,"trial_step":54},{"step":55,"speaker":"'백 사장'","content":"저, 저, 저 사람들이 날 해치려고 해!!","voice":["vo_trial_30104_1_55"],"voice_bank":"vo_linglan_trial","style":1,"background":1034,"log_type":1,"src_id":130104055,"trial_step":55},{"step":56,"speaker":"'백 사장'","content":"역시 신디케이트에는 제대로 된 게 하나도 없어. 앞에서는 돈이랑 물건을 내주면서, 뒤에서 날 이용하려 한다고!","voice":["vo_trial_30104_1_56"],"voice_bank":"vo_linglan_trial","style":1,"background":1034,"log_type":1,"src_id":130104056,"trial_step":56},{"step":57,"speaker":"'백 사장'","content":"이제 경찰들에게 걸렸으니, 입막음을 하려고 할 거야.","voice":["vo_trial_30104_1_57"],"voice_bank":"vo_linglan_trial","style":1,"background":1034,"log_type":1,"src_id":130104057,"trial_step":57},{"step":58,"speaker":"'백 사장'","content":"나, 나, 난 이걸 기록으로 남겨야겠어. 내가 죽더라도 이것만은 꼭 전해야 해…","voice":["vo_trial_30104_1_58"],"voice_bank":"vo_linglan_trial","style":1,"background":1034,"log_type":1,"src_id":130104058,"trial_step":58},{"step":59,"speaker":"'백 사장'","content":"혀, 혀, 혀, 형님, 아니, 누님? 누가 됐든, 디스시티의 정의를 위해 나 대신 복수해줘…","voice":["vo_trial_30104_1_59"],"voice_bank":"vo_linglan_trial","style":1,"background":1034,"log_type":1,"src_id":130104059,"trial_step":59},{"step":60,"speaker":"101","content":"머리를 쓰긴 썼지만, 본인을 추격하는 사람을 얕잡아 봤어.","style":2,"background":1034,"log_type":1,"src_id":130104060,"trial_step":60},{"step":61,"speaker":"101","content":"이 사람들이 누가 봐도 수상한 캠코더를 빠뜨릴 리 없어. 겨우 영상 하나 때문에 기 죽을 리는 더욱 만무하고.","style":2,"background":1034,"log_type":1,"src_id":130104061,"trial_step":61},{"step":62,"speaker":"101","content":"게다가 이 사람은 자기를 너무 과대평가했어. 어떤 직책도 없는 사람은 살해당한다고 한들 아무런 파장을 일으키지 못하는데 말이야.","style":2,"background":1034,"log_type":1,"src_id":130104062,"trial_step":62},{"step":63,"content":"영상은 계속 재생되고 있었다. '백 사장'이 침대 위에서 뒤적거리는 바람에 침대가 육중한 무게에 괴로워하며 삐걱거리는 소리를 냈다. 그리고 한참 지나도 다른 화면이 나오지 않았다.","style":3,"background":1034,"log_type":1,"src_id":130104063,"trial_step":63},{"step":64,"options":["빨리 감기를 누른다"],"style":6,"background":1034,"log_type":1,"src_id":130104064,"trial_step":64,"course":3,"choices":[{"text":"빨리 감기를 누른다","goto":65}]},{"step":65,"content":"영상 속의 시간이 빠르게 흘렀고, 이내 창밖에서 수상한 기척이 들려왔다.","style":3,"background":1034,"log_type":1,"src_id":130104065,"trial_step":65},{"step":66,"speaker":"'백 사장'","content":"거기 누구야?!","voice":["vo_trial_30104_1_66"],"voice_bank":"vo_linglan_trial","style":1,"background":1034,"log_type":1,"src_id":130104066,"trial_step":66},{"step":67,"content":"'백 사장'은 흠칫 놀라더니 침대 옆에 있던 캠코더를 집어 들었다.","style":3,"background":1034,"log_type":1,"src_id":130104067,"trial_step":67},{"step":68,"content":"그리고는 천천히 창가로 다가가 무슨 소리인지 확인했다.","style":3,"background":1034,"log_type":1,"src_id":130104068,"trial_step":68},{"step":69,"content":"순간 검은 실루엣이 나타났다. 영상에 잔상을 남길 정도로 빨랐는데, 그자의 움직임을 제대로 볼 수조차 없었다.","style":3,"background":1034,"log_type":1,"src_id":130104069,"trial_step":69},{"step":70,"speaker":"'백 사장'","content":"으아아아아악!","voice":["vo_trial_30104_1_70"],"voice_bank":"vo_linglan_trial","style":1,"background":1034,"log_type":1,"src_id":130104070,"trial_step":70},{"step":71,"content":"캠코더가 벽 모퉁이로 날아갔다. 카메라가 어두컴컴한 벽면을 비췄지만, 소리는 그대로 녹음됐다.","style":3,"background":1034,"log_type":1,"src_id":130104071,"trial_step":71},{"step":72,"content":"챙!","style":3,"background":10000,"log_type":1,"src_id":130104072,"trial_step":72},{"step":73,"content":"무기끼리 부딪치는 소리였다. 누군가가 습격자를 저지한 듯했다.","style":3,"background":10000,"log_type":1,"src_id":130104073,"trial_step":73},{"step":74,"speaker":"???","content":"너희가 분노를 참지 못할 거라고 예상했어.","voice":["vo_trial_30104_1_74"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130104074,"trial_step":74},{"step":75,"speaker":"???","content":"누굴 믿고 감히 날 도발하는 거야?","voice":["vo_trial_30104_1_75"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130104075,"trial_step":75},{"step":76,"content":"습격자는 대답이 없었다. 무기가 허공을 가르는 날카로운 소리만 들려올 뿐이었다.","style":3,"background":10000,"log_type":1,"src_id":130104076,"trial_step":76},{"step":77,"content":"이 소리는 오래 지속되지 않아, 방은 금세 적막해졌다.","style":3,"background":10000,"log_type":1,"src_id":130104077,"trial_step":77},{"step":78,"content":"영상은 여기까지였다.","style":3,"background":10000,"log_type":1,"src_id":130104078,"trial_step":78},{"step":79,"speaker":"작전요원","content":"국장님, 이제 어떻게 할까요?","voice":["vo_trial_30104_1_79"],"voice_bank":"vo_linglan_trial","style":1,"background":1034,"log_type":1,"src_id":130104079,"trial_step":79},{"step":80,"speaker":"101","content":"우선 레트·백을 통제한다. 그리고 창가에 혈흔이 있을 거야.","style":2,"background":1034,"log_type":1,"src_id":130104080,"trial_step":80},{"step":81,"speaker":"101","content":"혈흔을 쫓아가.","style":2,"background":1034,"log_type":1,"src_id":130104081,"trial_step":81},{"step":82,"speaker":"작전요원","content":"예!","voice":["vo_trial_30104_1_82"],"voice_bank":"vo_linglan_trial","style":1,"background":1034,"log_type":1,"src_id":130104082,"trial_step":82},{"step":83,"content":"빠른 속도로 출동한 행동대는 분광계로 혈흔을 따라 추적에 나섰다.","style":3,"background":10000,"log_type":1,"src_id":130104083,"trial_step":83},{"step":84,"content":"당신 일행은 곧 한 뒷골목에 다다랐다. 싸웠던 흔적이 역력했는데, 안쪽으로 들어가자 어둠이 모든 것을 뒤덮었다.","style":3,"background":10000,"log_type":1,"src_id":130104084,"trial_step":84},{"step":85,"content":"짙은 어둠에 왠지 모르게 마음이 불안해졌다. 당신은 걸음을 멈추고 부하들에게 계속 추격하라고 해야 하는 건지 망설였다.","style":3,"background":1008,"log_type":1,"src_id":130104085,"trial_step":85},{"step":86,"speaker":"???","content":"내가 너라면, 여기부터는 더 쫓지 않겠어.","voice":["vo_trial_30104_1_86"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104086,"trial_step":86},{"step":87,"content":"익숙한 목소리가 들려왔다. 골목에 강한 바람이 불어오며 먼지를 일으키자 눈을 뜨기 힘들어졌다.","style":3,"background":1008,"log_type":1,"src_id":130104087,"trial_step":87},{"step":88,"speaker":"???","content":"난 네가 좋아. 네 용기도 마음에 들고.","voice":["vo_trial_30104_1_88"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104088,"trial_step":88},{"step":89,"speaker":"???","content":"그런데 말이야, 용기만으로 해결되지 않는 일들도 있는 법이야.","voice":["vo_trial_30104_1_89"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104089,"trial_step":89},{"step":90,"content":"목소리만 들려올 뿐, 목소리 주인의 모습은 보이지 않았다.","style":3,"background":1008,"log_type":1,"src_id":130104090,"trial_step":90},{"step":91,"options":["백?"],"style":6,"background":1008,"log_type":1,"src_id":130104091,"trial_step":91,"course":3,"choices":[{"text":"백?","goto":92}]},{"step":92,"content":"대체 나한테 뭘 숨기고 있는 거지?","style":2,"background":1008,"log_type":1,"src_id":130104092,"trial_step":92},{"step":93,"speaker":"???","content":"위험한 비밀들…","voice":["vo_trial_30104_1_93"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104093,"trial_step":93},{"step":94,"speaker":"???","content":"알게 되는 순간, 더는 무시할 수 없게 되지. 네가 소중하게 여기는 모든 게 위협을 받게 될 거야.","voice":["vo_trial_30104_1_94"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104094,"trial_step":94},{"step":95,"speaker":"???","content":"그래도 알고 싶어?","voice":["vo_trial_30104_1_95"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104095,"trial_step":95},{"step":96,"content":"당신은 눈 앞에 펼쳐진 어둠을 바라보며 마른침을 삼켰다.","style":3,"background":1008,"log_type":1,"src_id":130104096,"trial_step":96},{"step":97,"speaker":"???","content":"당신도 알게 될 거야. 반드시 알아야 하기도 하고. 하지만 지금은 때가 아니야…","voice":["vo_trial_30104_1_97"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104097,"trial_step":97},{"step":98,"speaker":"???","content":"착하지? 이만 돌아가. 아직 이르니 마지막으로 평화로운 나날을 즐기도록 해.","voice":["vo_trial_30104_1_98"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104098,"trial_step":98},{"step":99,"content":"바람이 잦아들었다. 그제야 당신은 불과 몇 초도 채 지나지 않았다는 것을 깨달았다.","style":3,"background":1008,"log_type":1,"src_id":130104099,"trial_step":99},{"step":100,"content":"조금 전에 무슨 소리 못 들었나?","style":2,"background":1008,"log_type":1,"src_id":130104100,"trial_step":100},{"step":101,"speaker":"작전요원","content":"바람 소리밖에 못 들었습니다.","voice":["vo_trial_30104_1_101"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104101,"trial_step":101},{"step":102,"speaker":"작전요원","content":"다른 소리를 들으셨습니까?","voice":["vo_trial_30104_1_102"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104102,"trial_step":102},{"step":103,"content":"아니.","style":2,"background":1008,"log_type":1,"src_id":130104103,"trial_step":103},{"step":104,"speaker":"작전요원","content":"계속 추격할까요?","voice":["vo_trial_30104_1_104"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104104,"trial_step":104},{"step":105,"content":"당신은 돌길 위로 깊게 난 칼자국을 봤다.","style":3,"background":1008,"log_type":1,"src_id":130104105,"trial_step":105},{"step":106,"content":"철수한다, 돌아가자.","style":2,"background":1008,"log_type":1,"src_id":130104106,"trial_step":106},{"step":107,"content":"철수하고 MBCC에 복귀했을 때는 이미 다음 날 새벽이 되어 있었다. 식당에 온 당신은 그곳을 지키고 있는 백기 측 세 사람과 마주쳤다.","style":3,"background":107,"log_type":1,"src_id":130104107,"trial_step":107},{"step":108,"speaker":"백","content":"이 QR코드 스캔해 봐.","voice":["vo_trial_30104_1_108"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104108,"trial_step":108},{"step":109,"speaker":"엘라","content":"썩 꺼져!","voice":["vo_trial_30104_1_109"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104109,"trial_step":109},{"step":110,"speaker":"엘라","content":"광고창이 밑도 끝도 없이 쏟아져 나오는데 삭제되지도 않아서, 결국 국장이 단말기 바꿨다는 걸 내가 모를 줄 알아?","voice":["vo_trial_30104_1_110"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104110,"trial_step":110},{"step":111,"content":"백은 엘라에게 욕을 얻어먹고는 성이 나서 돌아갔다.","style":3,"background":107,"log_type":1,"src_id":130104111,"trial_step":111},{"step":112,"content":"오늘은 어쩐 일로 '일'할 마음이 생긴 거지, 백 사장?","style":2,"background":107,"log_type":1,"src_id":130104112,"trial_step":112},{"step":113,"speaker":"백","content":"…K.K.가 좀 다쳐서 일을 못 하고 있는데, 백기는 파산하기 직전이거든…","voice":["vo_trial_30104_1_113"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104113,"trial_step":113},{"step":114,"speaker":"백","content":"파산은 별일 아니지만, 돈이 없는 건 큰일이잖아. 그러니 이 사장님께서 직접 복귀하는 수밖에.","voice":["vo_trial_30104_1_114"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104114,"trial_step":114},{"step":115,"speaker":"K.K.","content":"하…","voice":["vo_trial_30104_1_115"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104115,"trial_step":115},{"step":116,"speaker":"치이","content":"복귀라… 하하하, 삼십 분이 넘도록 그놈의 QR코드를 스캔해주는 사람이 하나도 없었거든, 하하하하.","voice":["vo_trial_30104_1_116"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104116,"trial_step":116},{"step":117,"speaker":"백","content":"너, 너, 너, 너희 정말 사장님을 그렇게 대할 거야?! 이렇게 고생고생 돈 벌어서 너희를 키워주는 일이 쉬운 줄 알아?","voice":["vo_trial_30104_1_117"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104117,"trial_step":117},{"step":118,"speaker":"치이","content":"그래, 그래, 네가 우리를 키워주고 있지.","voice":["vo_trial_30104_1_118"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104118,"trial_step":118},{"step":119,"speaker":"치이","content":"아, 국장님. 포커 칠 줄 아세요? 이제 막 사건을 종결했다고 하던데, 휴가를 즐기셔야 하는 거 아닙니까?","voice":["vo_trial_30104_1_119"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104119,"trial_step":119},{"step":120,"speaker":"백","content":"포커? 나도 할래!","voice":["vo_trial_30104_1_120"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104120,"trial_step":120},{"step":121,"speaker":"치이","content":"넌 돈 벌어서 우리 먹여 살려야 하잖아?","voice":["vo_trial_30104_1_121"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104121,"trial_step":121},{"step":122,"speaker":"백","content":"한참 동안 일만 했다고. 일과 휴식을 적절하게 조절할 줄도 알아야지.","voice":["vo_trial_30104_1_122"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104122,"trial_step":122},{"step":123,"speaker":"K.K.","content":"겨우 30분 했으면서.","voice":["vo_trial_30104_1_123"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104123,"trial_step":123},{"step":124,"speaker":"K.K.","content":"그리고 잊어버렸을까 봐 말해주는 건데, 지금이 월말인데 우리 통장에 돈이 한 푼도 없어.","voice":["vo_trial_30104_1_124"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104124,"trial_step":124},{"step":125,"speaker":"치이","content":"포커 칠 게 아니라면 다른 거라도 하러 가죠. 훠궈나 먹으러 갈까요?","voice":["vo_trial_30104_1_125"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104125,"trial_step":125},{"step":126,"content":"관리국 식당에는 없는 걸로 아는데?","style":2,"background":107,"log_type":1,"src_id":130104126,"trial_step":126},{"step":127,"speaker":"치이","content":"괜찮습니다, K.K.가 해주겠죠.","voice":["vo_trial_30104_1_127"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104127,"trial_step":127},{"step":128,"speaker":"K.K.","content":"?","voice":["vo_trial_30104_1_128"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104128,"trial_step":128},{"step":129,"speaker":"치이","content":"네가 관리국에 잡혀간 뒤로 내가 얼마나 힘들게 살았는지 모르지? 두 달 동안 컵라면이랑 쌀밥만 먹고 살았다, 다른 반찬 없이…","voice":["vo_trial_30104_1_129"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104129,"trial_step":129},{"step":130,"speaker":"K.K.","content":"요리를 배우면 되잖아?","voice":["vo_trial_30104_1_130"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104130,"trial_step":130},{"step":131,"speaker":"치이","content":"귀찮아.","voice":["vo_trial_30104_1_131"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104131,"trial_step":131},{"step":132,"speaker":"K.K.","content":"……","voice":["vo_trial_30104_1_132"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104132,"trial_step":132},{"step":133,"speaker":"치이","content":"K.K. 누님, 훠궈 국물만 좀 만들어 주라. 이 정도는 괜찮잖아. 재료는 내가 준비할게…","voice":["vo_trial_30104_1_133"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104133,"trial_step":133},{"step":134,"content":"치이가 당신과 백에게 눈짓을 한 뒤 K.K.를 데리고 식당으로 들어갔다. 그렇게 문 앞에는 당신과 백만 남게 되었다.","style":3,"background":107,"log_type":1,"src_id":130104134,"trial_step":134},{"step":135,"content":"묻고 싶은 것이 가득했지만, 막상 물으려 하니 차마 입이 떨어지지 않았다.","style":3,"background":107,"log_type":1,"src_id":130104135,"trial_step":135},{"step":136,"speaker":"백","content":"내가 그렇게 무서워? 왜 아무 말도 안 해?","voice":["vo_trial_30104_1_136"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104136,"trial_step":136},{"step":137,"speaker":"백","content":"아니면 말할 수 없는 비밀이라도 있어? 나한테 털어놓고 싶긴 한데, 말하기 껄끄럽다거나.","voice":["vo_trial_30104_1_137"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104137,"trial_step":137},{"step":138,"content":"…너희 계속 K.K.를 속이고 있는 거지?","style":2,"background":107,"log_type":1,"src_id":130104138,"trial_step":138},{"step":139,"speaker":"백","content":"응…","voice":["vo_trial_30104_1_139"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104139,"trial_step":139},{"step":140,"content":"왜지?","style":2,"background":107,"log_type":1,"src_id":130104140,"trial_step":140},{"step":141,"speaker":"백","content":"그 애는 착한 애니까. 게다가… 나한테 너무 소중한 사람이기도 하거든. 이런 난장판에 끌어들이고 싶지 않아.","voice":["vo_trial_30104_1_141"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104141,"trial_step":141},{"step":142,"content":"그럼 치이는?","style":2,"background":107,"log_type":1,"src_id":130104142,"trial_step":142},{"step":143,"content":"당신의 질문에 백이 웃음을 지었다.","style":3,"background":107,"log_type":1,"src_id":130104143,"trial_step":143},{"step":144,"speaker":"백","content":"치이도 나처럼 그 난장판 속에서 도망쳐 나왔어.","voice":["vo_trial_30104_1_144"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104144,"trial_step":144},{"step":145,"content":"……","style":2,"background":107,"log_type":1,"src_id":130104145,"trial_step":145},{"step":146,"content":"그날 BR-004에 있었던 사람, 너 맞지?","style":2,"background":107,"log_type":1,"src_id":130104146,"trial_step":146},{"step":147,"speaker":"백","content":"그게 중요해?","voice":["vo_trial_30104_1_147"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104147,"trial_step":147},{"step":148,"content":"난 조야가 어디에 있는지 알고 싶어.","style":2,"background":107,"log_type":1,"src_id":130104148,"trial_step":148},{"step":149,"speaker":"백","content":"어휴, 걱정을 사서 하네…","voice":["vo_trial_30104_1_149"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104149,"trial_step":149},{"step":150,"speaker":"백","content":"아무도 찾지 못하는 곳에 있어, 됐지? 참나, 내 걱정이나 그렇게 하지.","voice":["vo_trial_30104_1_150"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104150,"trial_step":150},{"step":151,"content":"내겐 너도 똑같이 중요해. 하지만 조야의 안전이…","style":2,"background":107,"log_type":1,"src_id":130104151,"trial_step":151},{"step":152,"content":"그 순간, 백이 당신의 입을 막았다.","style":3,"background":107,"log_type":1,"src_id":130104152,"trial_step":152},{"step":153,"speaker":"백","content":"더 물으면 규칙 위반이다?","voice":["vo_trial_30104_1_153"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104153,"trial_step":153},{"step":154,"speaker":"백","content":"훠궈나 먹으러 가자고. K.K.가 만드는 훠궈가 진짜 맛있거든. 안 먹으면 후회할걸.","voice":["vo_trial_30104_1_154"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104154,"trial_step":154},{"step":155,"content":"잠깐…","style":2,"background":107,"log_type":1,"src_id":130104155,"trial_step":155},{"step":156,"content":"…됐다. 언젠가는 내가 네 '속사정'을 알아내고 말 거야.","style":2,"background":107,"log_type":1,"src_id":130104156,"trial_step":156},{"step":157,"speaker":"백","content":"오호… 정말?","voice":["vo_trial_30104_1_157"],"voice_bank":"vo_linglan_trial","style":1,"background":107,"log_type":1,"src_id":130104157,"trial_step":157},{"step":158,"content":"백은 평상시와 같은 표정을 지었지만, 그 표정 아래 교활한 웃음은 감추지 못했다.","style":3,"background":107,"log_type":1,"src_id":130104158,"trial_step":158}]}