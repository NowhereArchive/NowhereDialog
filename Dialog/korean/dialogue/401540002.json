{"id":401540002,"chapter_id":50045,"scene_id":45007,"steps":[{"step":1,"speaker":"음유시인","content":"~~~~","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":2,"speaker":"음유시인","content":"'남루한 옷, 우스꽝스러운 왕관.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":3,"speaker":"음유시인","content":"'선명한 인끈은 대대로 전해지고.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":4,"speaker":"음유시인","content":"'천막은 헤졌으나 관객들의 사랑은 막을 수 없네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":5,"speaker":"음유시인","content":"'무대 위 국왕의 화장이 어수선해지면, 무대 아래 관객들이 웃음꽃을 피우네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":6,"speaker":"음유시인","content":"'이곳의 매표소는 지붕이 없네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":7,"speaker":"음유시인","content":"'동전 다섯 개가 짤랑거리네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":8,"speaker":"음유시인","content":"'많다, 많아.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":9,"speaker":"음유시인","content":"'다섯이 따뜻한 밥을 먹을 수 있네.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":10,"speaker":"음유시인","content":"'많다, 많아.'","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":11,"speaker":"음유시인","content":"'함께 노래하며 춤추자.'","style":1,"background":1069,"is_centered":true,"log_type":1}]}