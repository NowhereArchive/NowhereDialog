{"id":400401202,"chapter_id":50016,"scene_id":51620,"steps":[{"step":1,"speaker":"어흥","content":"그리하여, 어흥 대마왕은 또다시 부하를 보내 마을을 습격했어~","voice":["vo_event_400401202_2"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":2,"speaker":"어흥","content":"이번 습격은 규모가 더 컸어. 마을 사람들은 하~ 나~ 도~ 어흥 괴물들의 공격을 막아내지 못했지.","voice":["vo_event_400401202_3"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":3,"speaker":"어흥","content":"헤헤, 이제 어떡할래… 사람들을 구할 거야? 아니면 도망갈 거야?","voice":["vo_event_400401202_4"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":4,"speaker":"어흥","content":"용감한 여주인공님?","voice":["vo_event_400401202_5"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":5,"speaker":"린","content":"그… 그게…","voice":["vo_event_400401202_6"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":6,"speaker":"마을 주민","content":"린, 우리 걱정은 말고 어서 사탕을 찾으러 가. 너만은 무사해야 해!","voice":["vo_event_400401202_8"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":7,"speaker":"린","content":"그, 그렇지만…","voice":["vo_event_400401202_9"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":8,"speaker":"마을 주민","content":"어서 가…! 넌 반드시 용기 사탕을 찾아야 해! 네가 우리의 희망이야!","voice":["vo_event_400401202_10"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":9,"speaker":"마을 주민","content":"힘내, 린!","voice":["vo_event_400401202_11"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":10,"speaker":"마을 주민","content":"우리 모두의 목숨이 너한테 달렸어!","voice":["vo_event_400401202_12"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":11,"speaker":"린","content":"…아… 알겠어요! 반드시 사탕을 찾을게요!","voice":["vo_event_400401202_13"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":12,"speaker":"린","content":"여러분을 꼭 구하러 올 거예요!","voice":["vo_event_400401202_14"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":13,"content":"그렇게 마을을 떠난 린은 마지막 불씨가 되어 어흥 대마왕을 쓰러트릴 방법을 찾는 여정에 올랐다.","style":3,"background":4040,"log_type":1}]}