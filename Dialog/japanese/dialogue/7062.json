{"id":7062,"chapter_id":7,"scene_id":707,"steps":[{"step":1,"content":"力ずくで前に進み、あなたはヘラの手を掴んだ。","style":3,"background":704,"log_type":1},{"step":2,"speaker":"選択肢","options":["ヘラ——！！！"],"jump":[3],"style":6,"background":704,"log_type":1},{"step":3,"speaker":"ヘラ","content":"<size=44>イヤッ！！</size>","voice":["vo_cgplot_7072003"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":4,"content":"彼女はあなたの手を振り払い、見たことのない恐ろしい顔であなたを見て、叫びながらパレードの隊列の中に消えた。","style":3,"background":704,"log_type":1},{"step":5,"content":"ヘカテーの焦る声が後ろから聞こえてきた。あなたが隊列に飲み込まれないよう、悪夢が全力であなたを隊列から引き離した。あなたたちはしばらくパレードから離れた。","style":3,"background":704,"log_type":1},{"step":6,"speaker":"ヘカテー","content":"ヘラは……ただ幻覚を見ているだけ。","voice":["vo_cgplot_7072006"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":7,"speaker":"ヘカテー","content":"彼女の態度はそのせい。","voice":["vo_cgplot_7072007"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":8,"speaker":"選択肢","options":["分かっている"],"jump":[9],"style":6,"background":704,"log_type":1},{"step":9,"content":"自分を諭すようにそう言った。","style":3,"background":704,"log_type":1},{"step":10,"speaker":"選択肢","options":["彼女を追いかけて、連れ帰るぞ"],"jump":[11],"style":6,"background":704,"log_type":1},{"step":11,"content":"まだ間に合う。彼女を追いかけなければ。","style":3,"background":704,"log_type":1},{"step":12,"speaker":"ヘカテー","content":"でも、局長……わたしたちで追いつける？","voice":["vo_cgplot_7072012"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":14,"content":"ダンダンダンダン——","style":3,"background":702,"log_type":1},{"step":15,"speaker":"ウサギのぬいぐるみ","content":"カーニバルへようこそ！ようこそ——！ようこそ——！","voice":["vo_cgplot_7072014"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":16,"content":"紙吹雪の中、ウサギのぬいぐるみはいつものようにドラムを叩いている。","style":3,"background":702,"log_type":1},{"step":17,"content":"ボロボロの旗を羽織った老人は、まだカーニバルの入り口の階段のところに座っていた。","style":3,"background":702,"log_type":1},{"step":18,"speaker":"ヘカテー","content":"……また……戻ってきた。","voice":["vo_cgplot_7072017"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":19,"speaker":"老人","content":"出て行け。ここは人間の居場所ではない。ここにいても道を見失うだけだ……","voice":["vo_cgplot_7072018"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":20,"speaker":"老人","content":"彼女に会いに行く道を見失い、もう永遠に会えない……","voice":["vo_cgplot_7072019"],"voice_bank":"vo_cgplot_07","style":1,"background":702,"log_type":1},{"step":21,"content":"これがハーメルの力、これが<color=#fb9259>無限カーニバル</color>。ここの主を倒すどころか、彼女に近寄ることもできない。","style":3,"background":702,"log_type":1}]}