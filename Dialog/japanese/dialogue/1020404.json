{"id":1020404,"chapter_id":1020404,"scene_id":1,"steps":[{"step":1,"content":"█月16日、15:12、班彦第四病院、主任医師の医局。","style":9,"background":1038,"log_type":1,"src_id":120404001,"trial_step":1},{"step":2,"content":"あなたとドナルドは大男の看護師の案内で、病院内の見知らぬ医局に来ていた。","style":3,"background":1038,"log_type":1,"src_id":120404002,"trial_step":2},{"step":3,"speaker":"？？","content":"どうぞお座りください。","voice":["vo_trial_20404_1_3"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404003,"trial_step":3},{"step":4,"speaker":"？？","content":"院長は普段第四病院だけでなく、第一、第二病院と班彦医学院も管理しておりますので、忙しくて直接お目にかかれません……","voice":["vo_trial_20404_1_4"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404004,"trial_step":4},{"step":5,"speaker":"？？","content":"ですので、今回は私が応対いたします。","voice":["vo_trial_20404_1_5"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404005,"trial_step":5},{"step":6,"speaker":"？？","content":"まずは自己紹介をしておきましょう。私は第四病院の経営責任者、ジョーンズです。","voice":["vo_trial_20404_1_6"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404006,"trial_step":6},{"step":7,"speaker":"ジョーンズ","content":"MBCCの局長様がわざわざ訪ねて来られるとは、どのようなご用でしょうか？","voice":["vo_trial_20404_1_7"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404007,"trial_step":7},{"step":8,"content":"第四病院の責任者は両手を組んでゆったりと座り、気楽に微笑んでいる。あなたのこれから話す内容を全く予想できていない様子だ。","style":3,"background":1038,"log_type":1,"src_id":120404008,"trial_step":8},{"step":9,"options":["私は交渉に来た"],"style":6,"background":1038,"log_type":1,"src_id":120404009,"trial_step":9,"course":3,"choices":[{"text":"私は交渉に来た","goto":10}]},{"step":10,"speaker":"ジョーンズ","content":"交渉ですか？","voice":["vo_trial_20404_1_10"],"voice_bank":"vo_don_trial","style":1,"background":1038,"log_type":1,"src_id":120404010,"trial_step":10},{"step":11,"content":"あなたは建前や迂遠な言い回しを一切しない。それがジョーンズには少し予想外だったようだ。","style":3,"background":1038,"log_type":1,"src_id":120404011,"trial_step":11},{"step