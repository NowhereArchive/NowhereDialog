,"drawing":1040301},{"step":99,"speaker":"コフィン","content":"いいわ、約束よ。","voice":["vo_trial_40301_1_101"],"voice_bank":"vo_oak_trial","style":1,"log_type":1,"src_id":140301101,"trial_step":101,"drawing":1040301},{"step":100,"speaker":"コフィン","content":"全力を尽くしてあなたに協力するわ——でも、ロマネスクの石碑に触れたり、亡者の呟きを聞かなければならない。そのために精神が耐えられなくなろうとも、逃げ出すことはできないわ。","voice":["vo_trial_40301_1_102"],"voice_bank":"vo_oak_trial","style":1,"log_type":1,"src_id":140301102,"trial_step":102,"drawing":1040301},{"step":101,"speaker":"コフィン","content":"私を失望させないでね。","voice":["vo_trial_40301_1_103"],"voice_bank":"vo_oak_trial","style":1,"log_type":1,"src_id":140301103,"trial_step":103,"drawing":1040301},{"step":102,"content":"取調室から離れる時、コフィンは前よりも「楽しそう」に見えた。","style":3,"background":10000,"log_type":1,"src_id":140301104,"trial_step":104},{"step":103,"content":"あなたは最速の手続きで申請を完了させたが、ナイチンゲールはまだ何やら心配している。","style":3,"background":1017,"log_type":1,"src_id":140301105,"trial_step":105},{"step":104,"content":"あなたは「コフィンは何度も助けてくれたことがあるから、大丈夫だ」と何度も繰り返して、ようやく彼女に同意してもらった。","style":3,"background":1017,"log_type":1,"src_id":140301106,"trial_step":106}]}