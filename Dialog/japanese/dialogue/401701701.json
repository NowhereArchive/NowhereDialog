{"id":401701701,"chapter_id":21000103,"scene_id":306,"steps":[{"step":1,"content":"ある寒い朝、ようやくメカの最終稼働テストが完了した。","style":3,"background":2176,"log_type":1},{"step":2,"content":"メンバーたちの研究データを全て持ち寄り、残った隙間にも、食べ物と薬品をいっぱいに詰め込んだ。","style":3,"background":2176,"log_type":1},{"step":3,"speaker":"ヴァニラ","content":"準備できたか？","voice":["vo_event_401701701_3"],"voice_bank":"vo_event_17017","style":1,"background":2176,"log_type":1},{"step":4,"content":"メカの上からヴァニラの声が聞こえる。","style":3,"background":2176,"log_type":1},{"step":5,"options":["問題ない"],"jump":[6],"style":6,"background":2176,"log_type":1},{"step":6,"content":"寒さで吐息が白く染まる。あなたは彼女の方に親指を立てて、準備ができたことを合図した。","style":3,"background":2176,"log_type":1},{"step":7,"speaker":"ヴァニラ","content":"それじゃ出発しよう。","voice":["vo_event_401701701_7"],"voice_bank":"vo_event_17017","style":1,"background":2176,"log_type":1}]}