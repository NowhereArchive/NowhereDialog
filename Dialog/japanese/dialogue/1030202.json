:1029,"log_type":1,"src_id":130202163,"trial_step":163},{"step":164,"speaker":"サンティー","content":"本当よ本当。コージにだけは嘘をつかないわ。","voice":["vo_trial_30202_1_75"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202164,"trial_step":164},{"step":165,"speaker":"サンティー","content":"心配そうな顔をしてどうしたの？あなたがもう帰ってきたんだから、万霊教団の残党如き、あたしたち野良の子の敵じゃないわ。コージが手を下せば、すぐに終わることじゃない。","voice":["vo_trial_30202_1_76"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202165,"trial_step":165},{"step":166,"speaker":"サンティー","content":"昔みたいに、ね？","voice":["vo_trial_30202_1_77"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202166,"trial_step":166},{"step":167,"content":"サンティーの予想とは異なり、コージは顔色を曇らせたままだ。いつものように頷いてはくれなかった。","style":3,"background":1029,"log_type":1,"src_id":130202167,"trial_step":167},{"step":168,"speaker":"コージ","content":"本当に狂瞳結晶に手を出してないのね？","voice":["vo_trial_30202_1_78"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202168,"trial_step":168},{"step":169,"speaker":"サンティー","content":"何回言わせる気よ？本当だって。","voice":["vo_trial_30202_1_79"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202169,"trial_step":169},{"step":170,"speaker":"サンティー","content":"何焦ってるのよ。今回は手に負えないって言いたいの？","voice":["vo_trial_30202_1_80"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202170,"trial_step":170},{"step":171,"content":"そんな質問に返事をする気もなく、コージは他の野良の子について問い詰める。","style":3,"background":1029,"log_type":1,"src_id":130202171,"trial_step":171},{"step":172,"speaker":"コージ","content":"サンティーについてきた他の子たちは？彼らも追われてるの？","voice":["vo_trial_30202_1_81"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202172,"trial_step":172},{"step":173,"content":"返事を貰えないうえに逆に質問されるこの状況に、サンティーは少し動揺したようで、慌てて返事をする。","style":3,"background":1029,"log_type":1,"src_id":130202173,"trial_step":173},{"step":174,"speaker":"サンティー","content":"だ、大丈夫よ。あの倉庫に隠れてなさいって言ったわ。ハリーもみんなに知らせに行ったから、心配なんてないわよ。","voice":["vo_trial_30202_1_82"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202174,"trial_step":174},{"step":175,"speaker":"サンティー","content":"……そんなにヤバい状況なの？","voice":["vo_trial_30202_1_83"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202175,"trial_step":175},{"step":176,"speaker":"コージ","content":"サンティーはそう思わない？","voice":["vo_trial_30202_1_84"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202176,"trial_step":176},{"step":177,"speaker":"コージ","content":"早くここから離れないと。あのしつこいやつがついてくるかもしれない。","voice":["vo_trial_30202_1_85"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202177,"trial_step":177},{"step":178,"speaker":"サンティー","content":"誰？万霊教団のこと？","voice":["vo_trial_30202_1_86"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202178,"trial_step":178},{"step":179,"speaker":"コージ","content":"……管理局の局長よ。","voice":["vo_trial_30202_1_87"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202179,"trial_step":179},{"step":180,"speaker":"サンティー","content":"管理局の局長って、あなたを捕まえた人でしょ？お人よしだって聞いたけど……","voice":["vo_trial_30202_1_88","vo_trial_30202_1_88f"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202180,"trial_step":180},{"step":181,"content":"サンティーは急に目を輝かせた。","style":3,"background":1029,"log_type":1,"src_id":130202181,"trial_step":181},{"step":182,"content":"コージはあなたの端末を持って一人去ってしまったが、あなたは枷を通して、彼女の行方を探し続けていた。","style":3,"background":10000,"log_type":1,"src_id":130202182,"trial_step":182},{"step":183,"content":"そしてようやく、路地裏でコージを見つけた。","style":3,"background":1029,"log_type":1,"src_id":130202183,"trial_step":183},{"step":184,"speaker":"局長","content":"コージ、サンティーは見つかったか？","style":2,"background":1029,"log_type":1,"src_id":130202184,"trial_step":184},{"step":185,"content":"あなたに気づいたコージは、咄嗟にサンティーを庇った。","style":3,"background":1029,"log_type":1,"src_id":130202185,"trial_step":185},{"step":186,"speaker":"コージ","content":"来ないで！","voice":["vo_trial_30202_1_89"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202186,"trial_step":186},{"step":187,"content":"落ち着くんだ、コージ。あなたを責めるつもりはない。まずはサンティーを保護して、それから狂瞳結晶の在り処を突き止めるんだ。","style":2,"background":1029,"log_type":1,"src_id":130202187,"trial_step":187},{"step":188,"speaker":"コージ","content":"サンティーはわたしが守る。手を出さないで。","voice":["vo_trial_30202_1_90"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202188,"trial_step":188},{"step":189,"content":"意外なことに、サンティーが自分から質問を投げかけた。","style":3,"background":1029,"log_type":1,"src_id":130202189,"trial_step":189},{"step":190,"speaker":"サンティー","content":"あなたが例の局長さん？","voice":["vo_trial_30202_1_91"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202190,"trial_step":190},{"step":191,"content":"そうだ。","style":2,"background":1029,"log_type":1,"src_id":130202191,"trial_step":191},{"step":192,"speaker":"サンティー","content":"あたしを保護してくれるって本当？よかった！早く連れて行ってよ。","voice":["vo_trial_30202_1_92"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202192,"trial_step":192},{"step":193,"content":"サンティーの予想外の言葉にあなたとコージは呆然としたが、あなたはすぐに返事をする。","style":3,"background":1029,"log_type":1,"src_id":130202193,"trial_step":193},{"step":194,"content":"それは構わない。だが……","style":2,"background":1029,"log_type":1,"src_id":130202194,"trial_step":194},{"step":195,"speaker":"サンティー","content":"聞きたいことは分かるわ。万霊教団の狂瞳結晶を盗んだのはあたしじゃないけど、本当の犯人を知ってるの。たぶん奴らは内部で揉めてて、あたしたちは濡れ衣を着せられたんだと思うのよ。","voice":["vo_trial_30202_1_93"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202195,"trial_step":195},{"step":196,"speaker":"サンティー","content":"取引をしない？狂瞳結晶が欲しいんでしょ？協力してあげてもいいわ。その代わりに、あたしの身の安全を保証してよ。","voice":["vo_trial_30202_1_94"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202196,"trial_step":196},{"step":197,"content":"あなただけか？他の野良の子は？","style":2,"background":1029,"log_type":1,"src_id":130202197,"trial_step":197},{"step":198,"speaker":"サンティー","content":"安心して、彼らなら大丈夫。完璧な隠れ家に行かせたの。あなたが万霊教団の連中を全員捕まえるまで、しばらく辛抱すれば大丈夫よ。","voice":["vo_trial_30202_1_95"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202198,"trial_step":198},{"step":199,"content":"完璧な隠れ家だと？","style":2,"background":1029,"log_type":1,"src_id":130202199,"trial_step":199},{"step":200,"content":"不審な目で見るあなたに、サンティーは少し焦った様子で説明する。","style":3,"background":1029,"log_type":1,"src_id":130202200,"trial_step":200},{"step":201,"speaker":"サンティー","content":"あーもう！あたしが一番狙われてるのよ、のこのこあそこに行くわけないじゃん。居場所がバレちゃうじゃない！","voice":["vo_trial_30202_1_96"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202201,"trial_step":201},{"step":202,"speaker":"サンティー","content":"とにかく、あなたが応じてくれないなら、コージは協力しないわよ！あたしたちは一番の親友なんだから！あたしの言うことなら、コージはなんでも聞いてくれるの！","voice":["vo_trial_30202_1_97"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202202,"trial_step":202},{"step":203,"content":"と言いながら、サンティーはコージの袖を引っ張った。","style":3,"background":1029,"log_type":1,"src_id":130202203,"trial_step":203},{"step":204,"content":"コージ、その隠れ家は本当に安全なのか？巻き添えにされた他の野良の子たちは大丈夫か？私の助けが必要か？","style":2,"background":1029,"log_type":1,"src_id":130202204,"trial_step":204},{"step":205,"content":"コージは少し躊躇ったが、肯定的な返事をする。親友の言葉を信じているようだ。","style":3,"background":1029,"log_type":1,"src_id":130202205,"trial_step":205},{"step":206,"content":"そうか。","style":2,"background":1029,"log_type":1,"src_id":130202206,"trial_step":206},{"step":207,"options":["サンティーの要求を受け入れる"],"style":6,"background":1029,"log_type":1,"src_id":130202207,"trial_step":207,"course":3,"choices":[{"text":"サンティーの要求を受け入れる","goto":208}]},{"step":208,"content":"分かった。約束しよう。","style":2,"background":1029,"log_type":1,"src_id":130202208,"trial_step":208},{"step":209,"content":"MBCCがこの周辺にいる万霊教団の信者を逮捕しに向かう。あなたは一旦私と一緒に管理局に戻るんだ。","style":2,"background":1029,"log_type":1,"src_id":130202209,"trial_step":209},{"step":210,"content":"だが約束は守ってもらう。盗まれた狂瞳結晶の捜索に協力してくれ……","style":2,"background":1029,"log_type":1,"src_id":130202210,"trial_step":210},{"step":211,"speaker":"サンティー","content":"もちろん！","voice":["vo_trial_30202_1_98"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202211,"trial_step":211},{"step":212,"content":"サンティーは満面の笑みでそう答えた。","style":3,"background":1029,"log_type":1,"src_id":130202212,"trial_step":212}]}