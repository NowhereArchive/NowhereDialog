{"id":1030202,"chapter_id":1030202,"scene_id":1,"steps":[{"step":1,"speaker":"マフィアメンバー","content":"逃がすか！","voice":["vo_trial_30202_1_1"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202001,"trial_step":1},{"step":2,"content":"狭い路地裏で、屈強な男が男の子の袖を掴み、地面に押さえ込んだ。","style":3,"background":1029,"log_type":1,"src_id":130202002,"trial_step":2},{"step":3,"speaker":"マフィアメンバー","content":"あれを渡せ！","voice":["vo_trial_30202_1_2"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202003,"trial_step":3},{"step":4,"speaker":"男の子","content":"何も盗んでないってば……","voice":["vo_trial_30202_1_3"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202004,"trial_step":4},{"step":5,"speaker":"マフィアメンバー","content":"××××！クソガキが！嘘ばっかりつきやがって！","voice":["vo_trial_30202_1_4"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202005,"trial_step":5},{"step":6,"content":"男は拳を握りしめ、男の子を殴りつけた。","style":3,"background":1029,"log_type":1,"src_id":130202006,"trial_step":6},{"step":7,"speaker":"マフィアメンバー","content":"他の奴は？この××××どもが、盗んだものをどこに隠した！？","voice":["vo_trial_30202_1_5"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202007,"trial_step":7},{"step":8,"content":"凄惨な悲鳴が路地裏に響く。","style":3,"background":1029,"log_type":1,"src_id":130202008,"trial_step":8},{"step":9,"speaker":"男の子","content":"知らない……本当に知らないってば！","voice":["vo_trial_30202_1_6"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202009,"trial_step":9},{"step":10,"content":"男の子が泣き喚き、必死に弁明をするが、男は見逃す気が全くないようだ。","style":3,"background":1029,"log_type":1,"src_id":130202010,"trial_step":10},{"step":11,"speaker":"マフィアメンバー","content":"クソガキめ、まだ白状しねぇのか。ならもう用はねぇ……","voice":["vo_trial_30202_1_7"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202011,"trial_step":11},{"step":12,"content":"男はナイフを振りかざした。","style":3,"background":1029,"log_type":1,"src_id":130202012,"trial_step":12},{"step":13,"options":["ナイフを受け止める"],"style":6,"background":1029,"log_type":1,"src_id":130202013,"trial_step":13,"course":3,"choices":[{"text":"ナイフを受け止める","goto":14}]},{"step":14,"content":"あなたはナイフを防げるような武器を持っていない。咄嗟に手でそのナイフを受け止めるしかなかった。","style":3,"background":1029,"log_type":1,"src_id":130202014,"trial_step":14},{"step":15,"content":"急に現れたあなたの姿を見て、唖然とした男は怒鳴り散らかした。","style":3,"background":1029,"log_type":1,"src_id":130202015,"trial_step":15},{"step":16,"speaker":"マフィアメンバー","content":"誰だ！てめぇは！？","voice":["vo_trial_30202_1_8"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202016,"trial_step":16},{"step":17,"content":"男はもう一度ナイフを振り上げ、邪魔者のあなたもまとめて始末しようとする。しかし突然、おぞましい気配が背後から彼に襲い掛かった。","style":3,"background":1029,"log_type":1,"src_id":130202017,"trial_step":17},{"step":18,"content":"背筋に寒気が走る。男がナイフを振り上げた姿勢のまま、ゆっくりと後ろを振り返ると、そこに立っていたのは、暗くて小さな子供の姿だった。","style":3,"background":1029,"log_type":1,"src_id":130202018,"trial_step":18},{"step":19,"content":"次の瞬間、地面に蠢く影が形を変えて、狼狽える男の胸元に突き刺さった。男は強い力で地面に叩きつけられ、やんちゃな子供に弄ばれたボロボロのぬいぐるみと化した。","style":3,"background":1029,"log_type":1,"src_id":130202019,"trial_step":19},{"step":20,"options":["コージを止める"],"style":6,"background":1029,"log_type":1,"src_id":130202020,"trial_step":20,"course":3,"choices":[{"text":"コージを止める","goto":21}]},{"step":21,"content":"コージ、やめろ！","style":2,"background":1029,"log_type":1,"src_id":130202021,"trial_step":21},{"step":22,"content":"もしかしたら彼からマフィアに関する情報を聞き出せるかもしれない。","style":2,"background":1029,"log_type":1,"src_id":130202022,"trial_step":22},{"step":23,"content":"ナイフで切られた手の傷口から血が流れている。しかしそんなことに構う暇なく、あなたは手を伸ばした。","style":3,"background":1029,"log_type":1,"src_id":130202023,"trial_step":23},{"step":24,"content":"ここで彼女を止めなければ、コージはきっと男の子に暴力を振るったこの男に止めを刺してしまう。","style":3,"background":1029,"log_type":1,"src_id":130202024,"trial_step":24},{"step":25,"speaker":"コージ","content":"……余計なお世話よ。","voice":["vo_trial_30202_1_9"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202025,"trial_step":25},{"step":26,"content":"路地の入口には二人のマフィアが地面に倒れている。あの二人を片付けるために、コージが現れるのが少し遅くなったのだ。そうでなければ、あなたの出番などなかっただろう。","style":3,"background":1029,"log_type":1,"src_id":130202026,"trial_step":26},{"step":27,"content":"あの二人はまだ生きているのか？","style":2,"background":1029,"log_type":1,"src_id":130202027,"trial_step":27},{"step":28,"speaker":"コージ","content":"生きてるけど、暫くは目を覚まさないわ。","voice":["vo_trial_30202_1_10"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202028,"trial_step":28},{"step":29,"content":"コージが不機嫌そうに返事をした。あなたに目を向けることなく、彼女は真っ直ぐにあの男の子の前に歩いていき、影で男の子を支える。","style":3,"background":1029,"log_type":1,"src_id":130202029,"trial_step":29},{"step":30,"speaker":"男の子","content":"コ……コージ？帰ってきたの！？","voice":["vo_trial_30202_1_11"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202030,"trial_step":30},{"step":31,"speaker":"コージ","content":"あ……うん……","voice":["vo_trial_30202_1_12"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202031,"trial_step":31},{"step":32,"content":"コージは曖昧な返事で男の子の質問を誤魔化した。","style":3,"background":1029,"log_type":1,"src_id":130202032,"trial_step":32},{"step":33,"speaker":"男の子","content":"やっと帰ってきた！どこに行ったのかって、みんなが心配してるよ！","voice":["vo_trial_30202_1_13"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202033,"trial_step":33},{"step":34,"content":"男の子は目を見開いて、前歯がかけた笑顔を見せる。","style":3,"background":1029,"log_type":1,"src_id":130202034,"trial_step":34},{"step":35,"speaker":"コージ","content":"うん、わたしは大丈夫。","voice":["vo_trial_30202_1_131"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202035,"trial_step":35},{"step":36,"content":"コージの「冷たさ」に慣れているのか、男の子は顔色一つ変えなかった——コージの後ろにいるあなたに気づくまでは。","style":3,"background":1029,"log_type":1,"src_id":130202036,"trial_step":36},{"step":37,"speaker":"男の子","content":"この……おじさんは誰？","female_content":"この……おばさんは誰？","voice":["vo_trial_30202_1_14","vo_trial_30202_1_14f"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202037,"trial_step":37},{"step":38,"content":"男の子の表情に警戒心が自然と浮かんだ。今しがた彼を助けたとはいえ、大人に対する不信感はそう簡単に消えるものではないようだ。","style":3,"background":1029,"log_type":1,"src_id":130202038,"trial_step":38},{"step":39,"content":"どう説明すればいいのかと悩んでいる時、コージがあなたの手のひらの傷口を一瞥して、あなたを紹介してくれた。","style":3,"background":1029,"log_type":1,"src_id":130202039,"trial_step":39},{"step":40,"speaker":"コージ","content":"彼のことなら放っておいて。わたしの連れよ、危険はないわ。","female_content":"彼女のことなら放っておいて。わたしの連れよ、危険はないわ。","voice":["vo_trial_30202_1_15","vo_trial_30202_1_15f"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202040,"trial_step":40},{"step":41,"speaker":"コージ","content":"拠点に連れてって。みんなに聞きたいことがあるの。","voice":["vo_trial_30202_1_16"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202041,"trial_step":41},{"step":42,"speaker":"男の子","content":"コージも遊園地に行ってくれるの？やった！","voice":["vo_trial_30202_1_17"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202042,"trial_step":42},{"step":43,"content":"先程までの危険を忘れたように、興奮した男の子が喜びの声をあげた。","style":3,"background":1029,"log_type":1,"src_id":130202043,"trial_step":43},{"step":44,"speaker":"男の子","content":"久々に帰ってきたから、みんなコージに会いたがってるよ！","voice":["vo_trial_30202_1_18"],"voice_bank":"vo_crache_trial","style":1,"background":1029,"log_type":1,"src_id":130202044,"trial_step":44},{"step":45,"content":"男の子に連れられて、あなたたちはシンジケートの複雑な路地をしばらく進んだ。","style":3,"background":1028,"log_type":1,"src_id":130202045,"trial_step":45},{"step":46,"content":"そしてようやく、小さな「遊園地」の前に辿り着いた。","style":3,"background":1028,"log_type":1,"src_id":130202046,"trial_step":46},{"step":47,"content":"それはとても簡素なところだった。ブランコとすべり台以外は何もない。周りの建設途中のビルが陽射しを遮っているせいで、長年修繕されていないこの楽園は深い影に覆われている。","style":3,"background":1028,"log_type":1,"src_id":130202047,"trial_step":47},{"step":48,"speaker":"男の子","content":"見て！誰が帰ってきたと思う？","voice":["vo_trial_30202_1_19"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202048,"trial_step":48},{"step":49,"content":"すべり台の下から、小さな「キノコ」が次から次へと出てきた。","style":3,"background":1028,"log_type":1,"src_id":130202049,"trial_step":49},{"step":50,"speaker":"野良の子メンバー","content":"コージ？","voice":["vo_trial_30202_1_20"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202050,"trial_step":50},{"step":51,"speaker":"野良の子メンバー","content":"コージが帰ってきた！","voice":["vo_trial_30202_1_21"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202051,"trial_step":51},{"step":52,"content":"十数人の「キノコ」がコージを囲む。彼女の周りに集まる彼らはとても楽しそうで、まるで祭りのような賑わいを見せていた。","style":3,"background":1028,"log_type":1,"src_id":130202052,"trial_step":52},{"step":53,"speaker":"野良の子メンバー","content":"コージ様！","voice":["vo_trial_30202_1_22"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202053,"trial_step":53},{"step":54,"speaker":"野良の子メンバー","content":"うううぅ、会いたかった……","voice":["vo_trial_30202_1_23"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202054,"trial_step":54},{"step":55,"speaker":"野良の子メンバー","content":"あなたがいない時に、またあの悪い人たちが私たちをいじめ始めたのよ。","voice":["vo_trial_30202_1_24"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202055,"trial_step":55},{"step":56,"content":"野良の子たちがコージの周りに集まって、わーわーと騒ぐ。一方で、あなたの存在に気づく警戒心が強い子供もいる。","style":3,"background":1028,"log_type":1,"src_id":130202056,"trial_step":56},{"step":57,"speaker":"野良の子メンバー","content":"どうして大人がついてきてるの？","voice":["vo_trial_30202_1_25"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202057,"trial_step":57},{"step":58,"content":"何人かの子供が小声で呟きながら、腰にぶら下げた武器を手に取った。","style":3,"background":1028,"log_type":1,"src_id":130202058,"trial_step":58},{"step":59,"speaker":"コージ","content":"彼は他の大人とは違う。一応……協力しに来てくれたの。","female_content":"彼女は他の大人とは違う。一応……協力しに来てくれたの。","voice":["vo_trial_30202_1_26","vo_trial_30202_1_26f"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202059,"trial_step":59},{"step":60,"speaker":"野良の子メンバー","content":"大人？協力！？","voice":["vo_trial_30202_1_27"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202060,"trial_step":60},{"step":61,"content":"にわかには信じがたいようだが、頼もしい「コージ様」がそう言っているので、彼らは異議を唱えなかった。","style":3,"background":1028,"log_type":1,"src_id":130202061,"trial_step":61},{"step":62,"speaker":"野良の子メンバー","content":"そうそう、さっきこれを拾ったの。きっと気に入ってくれるよ！","voice":["vo_trial_30202_1_28"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202062,"trial_step":62},{"step":63,"content":"一人の子供がリコーダーを高く掲げて、コージの目の前に差し出した。","style":3,"background":1028,"log_type":1,"src_id":130202063,"trial_step":63},{"step":64,"speaker":"野良の子メンバー","content":"やめろよ、コージの鼻の穴に入っちゃうじゃん……","voice":["vo_trial_30202_1_29"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202064,"trial_step":64},{"step":65,"speaker":"野良の子メンバー","content":"これ、俺が拾ったカード。まだ遊んでないけど、全部あげるよ！","voice":["vo_trial_30202_1_30"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202065,"trial_step":65},{"step":66,"speaker":"野良の子メンバー","content":"僕のもあげる！","voice":["vo_trial_30202_1_31"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202066,"trial_step":66},{"step":67,"content":"子供たちが我先にと自分のプレゼントをコージに渡す。路地裏で出会ったあの男の子はどこからかキャンディマシンまで持ち出してきた。","style":3,"background":1028,"log_type":1,"src_id":130202067,"trial_step":67},{"step":68,"speaker":"男の子","content":"ドーズが先月こじ開けてくれたんだ。ブルーベリー味は全部残しといてあげたよ。","voice":["vo_trial_30202_1_32"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202068,"trial_step":68},{"step":69,"speaker":"コージ","content":"ロリポップは嫌いなんだけど……うっ……","voice":["vo_trial_30202_1_33"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202069,"trial_step":69},{"step":70,"content":"青紫色のロリポップがコージの口に放り込まれた。コージは眉間にしわを寄せて文句を言おうとしたが、味が悪くなかったからか、声のトーンを少し落とした。","style":3,"background":1028,"log_type":1,"src_id":130202070,"trial_step":70},{"step":71,"speaker":"コージ","content":"次は手で渡して。わたしの口に入れないで……","voice":["vo_trial_30202_1_34"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202071,"trial_step":71},{"step":72,"content":"話の途中で、自分が見つめられているのに気づいたコージは、怒りのこもった目であなたを睨んで、口を結んだ。","style":3,"background":1028,"log_type":1,"src_id":130202072,"trial_step":72},{"step":73,"content":"10分後、野良の子たちはようやく落ち着いてくれた。","style":3,"background":1028,"log_type":1,"src_id":130202073,"trial_step":73},{"step":74,"options":["狂瞳結晶について聞く"],"style":6,"background":1028,"log_type":1,"src_id":130202074,"trial_step":74,"course":3,"choices":[{"text":"狂瞳結晶について聞く","goto":75}]},{"step":75,"content":"コージに目を向けると、彼女はすぐにあなたのしようとしていることが分かったようだ。眉間にしわを寄せたものの、止めはしなかった。","style":3,"background":1028,"log_type":1,"src_id":130202075,"trial_step":75},{"step":76,"content":"コージの黙認を得たあなたは、キャンディマシンの隣に立っている男の子に歩み寄った。","style":3,"background":1028,"log_type":1,"src_id":130202076,"trial_step":76},{"step":77,"content":"ちょっと質問してもいいだろうか？","style":2,"background":1028,"log_type":1,"src_id":130202077,"trial_step":77},{"step":78,"content":"男の子は緊張して本能的にキャンディマシンを抱きしめ、身体を縮めた。彼はきょろきょろとコージとあなたを交互に見て、戸惑いながらこう言った。","style":3,"background":1028,"log_type":1,"src_id":130202078,"trial_step":78},{"step":79,"speaker":"男の子","content":"何が聞きたいの？","voice":["vo_trial_30202_1_35"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202079,"trial_step":79},{"step":80,"content":"子供たちの注目がこちらに向けられた。大人との会話は彼らにとってあまり見慣れない光景のようだ。","style":3,"background":1028,"log_type":1,"src_id":130202080,"trial_step":80},{"step":81,"content":"狂瞳結晶を知っているか？","style":2,"background":1028,"log_type":1,"src_id":130202081,"trial_step":81},{"step":82,"content":"その質問を聞いて、男の子は困惑した表情を見せた。周りにいるほとんどの子供たちも