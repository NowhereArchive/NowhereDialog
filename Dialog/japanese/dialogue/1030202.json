130202128,"trial_step":128},{"step":129,"content":"いや、彼女が逃げている最中なら同じところには居続けないだろうな……一刻も早く彼女を見つけ出さないと。","style":2,"background":1028,"log_type":1,"src_id":130202129,"trial_step":129},{"step":130,"options":["管理局に連絡する"],"style":6,"background":1028,"log_type":1,"src_id":130202130,"trial_step":130,"course":3,"choices":[{"text":"管理局に連絡する","goto":131}]},{"step":131,"content":"あなたはすぐにナイチンゲールに電話をかけた。","style":3,"background":1028,"log_type":1,"src_id":130202131,"trial_step":131},{"step":132,"content":"情報部門に知らせてくれ。野良の子のメンバーと、万霊教団のメンバーと推測される者の位置情報を調べてほしい。リアルタイムの位置情報を必要としている。","style":2,"background":1028,"log_type":1,"src_id":130202132,"trial_step":132},{"step":133,"content":"できるだけ早くだ。","style":2,"background":1028,"log_type":1,"src_id":130202133,"trial_step":133},{"step":134,"speaker":"ナイチンゲール","content":"分かりました。","voice":["vo_trial_30202_1_60"],"voice_bank":"vo_crache_trial","style":1,"background":1028,"log_type":1,"src_id":130202134,"trial_step":134},{"step":135,"content":"5分後、リアルタイムのマップがあなたの端末に送信された。","style":3,"background":1028,"log_type":1,"src_id":130202135,"trial_step":135},{"step":136,"content":"ぎっしりと詰まった緑の点を見て、あなたは思わず頭を抱えた。こんなに数が多いのでは、MBCC全員を動かしたとしても、短時間では全てを調査できないだろう。","style":3,"background":1028,"log_type":1,"src_id":130202136,"trial_step":136},{"step":137,"content":"コージ、あなたの能力はシンジケートの全ての影に届く。これはあなたにしかできないことだ……","style":2,"background":1028,"log_type":1,"src_id":130202137,"trial_step":137},{"step":138,"content":"頼ってもいいだろうか？","style":2,"background":1028,"log_type":1,"src_id":130202138,"trial_step":138},{"step":139,"content":"あなたはコージに端末を渡した。彼女はスクリーンを一瞥し、躊躇うことなく能力を発動した。","style":3,"background":1028,"log_type":1,"src_id":130202139,"trial_step":139},{"step":140,"content":"瞬く間に、その小さな姿が影に融けて消えた。","style":3,"background":1028,"log_type":1,"src_id":130202140,"trial_step":140},{"step":141,"content":"ゴミだらけの路地裏で、ピンク色の髪の少女が息を切らして、ゴミ箱の中に隠れていた。あの恐ろしい大人たちの笑い声が間近に聞こえる。","style":3,"background":1029,"log_type":1,"src_id":130202141,"trial_step":141},{"step":142,"speaker":"マフィアメンバー","content