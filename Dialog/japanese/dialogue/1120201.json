goto":21},{"text":"どういう意味だ？","goto":null}]},{"step":26,"speaker":"ウェンディ","content":"なんだか、懐かしい匂いがする。くんくん……","voice":["vo_trial_120201_1_21"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201021,"trial_step":21,"drawing":1120201},{"step":27,"speaker":"ウェンディ","content":"ちょっと嗅いでいい？こっちに来てよ。","voice":["vo_trial_120201_1_22"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201022,"trial_step":22,"drawing":1120201},{"step":28,"content":"期待の顔、澄んだ眼差し。しかしどこか背筋が凍るような感じがする。","style":3,"log_type":1,"src_id":220201023,"trial_step":23,"drawing":1120201},{"step":29,"content":"検察の報告書を思い出す——ウェンディは一級異変と認定され、彼女の精神は狂瞳病の影響を受け、非常に不安定な状態にあると。","style":3,"log_type":1,"src_id":220201024,"trial_step":24,"drawing":1120201},{"step":30,"options":["応じる","断る"],"style":6,"log_type":1,"src_id":220201025,"trial_step":25,"course":3,"drawing":1120201,"choices":[{"text":"応じる","goto":26},{"text":"断る","goto":34}]},{"step":31,"content":"ウェンディはしっかりと取調室の椅子に縛られている、少しだけなら問題ないだろうと、あなたは彼女に近づいた。","style":3,"log_type":1,"src_id":220201026,"trial_step":26,"drawing":1120201},{"step":32,"speaker":"ウェンディ","content":"うん……懐かしい匂い……あんたの首も、柔らかくて細いね……触ってみてもいい？","voice":["vo_trial_120201_1_27"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201027,"trial_step":27,"drawing":1120201},{"step":33,"speaker":"ウェンディ","content":"触りたいなぁ……あんたの首をへし折ったら、赤い血が出るかな？","voice":["vo_trial_120201_1_28"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201028,"trial_step":28,"drawing":1120201},{"step":34,"options":["すぐ後ろへ下がる"],"style":6,"log_type":1,"src_id":220201029,"trial_step":29,"course":3,"drawing":1120201},{"step":35,"speaker":"ウェンディ","content":"あはははははっ——！！","voice":["vo_trial_120201_1_30"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201030,"trial_step":30,"drawing":1120216},{"step":36,"speaker":"ウェンディ","content":"あんたにも死体の匂いがする！錆の川のように臭い匂い！！","voice":["vo_trial_120201_1_31"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201031,"trial_step":31,"drawing":1120216},{"step":37,"content":"彼女は落ち着きをなくして、周りの匂いを嗅ぎ続ける。最後に、彼女はあなたを見て、くくっと不気味に笑った。","style":3,"log_type":1,"src_id":220201032,"trial_step":32,"drawing":1120216},{"step":38,"speaker":"ウェンディ","content":"知ってる……そう……この匂いを知ってる！錆の川からのプレゼント、柔らかいケーキ！あはははっ！切って、分けて、こっちに一切れ、あっちに一切れ……あんたもほしいの？でもダメー！あんたには綺麗なお葬式をしてあげるからさ！あはははっ——！","voice":["vo_trial_120201_1_33"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201033,"trial_step":33,"drawing":1120216,"next":[37]},{"step":39,"speaker":"ウェンディ","content":"え～だめなの……でも気になる。","voice":["vo_trial_120201_1_34"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201034,"trial_step":34,"drawing":1120206},{"step":40,"speaker":"ウェンディ","content":"あんたの首……細くて柔らかそうだ……その脈打つ動脈……中に流れている赤い血が見える……","voice":["vo_trial_120201_1_35"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201035,"trial_step":35,"drawing":1120206},{"step":41,"speaker":"ウェンディ","content":"あんたの身体はいいね。その匂い、一体なんだろう……懐かしい感じがする……","voice":["vo_trial_120201_1_36"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201036,"trial_step":36,"drawing":1120206},{"step":42,"options":["何の話だ……"],"style":6,"log_type":1,"src_id":220201037,"trial_step":37,"course":3,"drawing":1120206},{"step":43,"speaker":"ウェンディ","content":"うーん！！分かったよ、あははははははっ！死体の匂いだ！錆の川のように臭い匂い！！","voice":["vo_trial_120201_1_38"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201038,"trial_step":38,"drawing":1120216},{"step":44,"speaker":"ウェンディ","content":"錆の川で楽しいパーティー——ゴミ山に埋められた美食家、赤と白のクリーム！切って、切って、切り分けて——あはははッ！断面はどうかな？零れていくのは汚い水かな……それとも気持ち悪い粘液かな……！","voice":["vo_trial_120201_1_39"],"voice_bank":"vo_wendy_trial","style":1,"log_type":1,"src_id":220201039,"trial_step":39,"drawing":1120216},{"step":45,"content":"取調室の椅子が彼女の動きで揺さぶられ、金属と金属が衝突し、鈍い音を立てる。","style":3,"log_type":1,"src_id":220201040,"trial_step":40,"drawing":1120216},{"step":46,"content":"目の前の人が錆の川の刈り取る者だと、あなたはようやく実感した。血塗れで、化け物と一緒に踊る狂人。この恐ろしい幽霊を捕まえるために、あなたたちは丸一晩も錆の川に時間をかけた。","style":3,"log_type":1,"src_id":220201041,"trial_step":41,"drawing":1120216},{"step":47,"content":"彼女は狂っている——その狂気が死者の匂いと共に襲ってくる。あなたは徐々に恐怖を感じた。","style":3,"log_type":1,"src_id":220201042,"trial_step":42,"drawing":1120216},{"step":48,"content":"いますぐここから立ち去りたい衝動を抑えて、彼女を拘束する鎖をもう一度確認した。尋問を続けなければならない、彼女は重大な犯罪の容疑者だ。","style":3,"log_type":1,"src_id":220201043,"trial_step":43,"drawing":1120216},{"step":49,"content":"＊","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":50,"content":"＊","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":51,"content":"＊","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":52,"content":"＊","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":53,"content":"＊","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":54,"content":"＊","style":3,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":55,"content":"＊","style":18,"log_type":1,"src_id":2,"trial_step":44,"course":6,"drawing":1120201},{"step":56,"content":"これは狂瞳武器についての報告書だ。","style":3,"log_type":1,"src_id":220201045,"trial_step":45,"drawing":1120201},{"step":57,"content":"あれは狂瞳結晶で作られた邪道武器。マフィアたちがコンビクトの力を求めるため、狂瞳病にまで手を出した。彼らは罪のない一般人を化け物に変え、シンジケートに血の雨を降らせている。","style":3,"log_type":1,"src_id":220201046,"trial_step":46,"drawing":1120201},{"step":58,"content":"FACはまだ狂瞳武器を生産している黒幕を突き止めていないが、最初の生産ルートを見つけた——それは、錆の川だ。","style":3,"log_type":1,"src_id":220201047,"trial_step":47,"drawing":1120201},{"step":59,"content":"上級の狂瞳結晶はコンビクトの実験から得られる物。大量の下級結晶は、錆の川に転がっている死瞳の死体から採取されたものだ。","style":3,"log_type":1,"src_id":220201048,"trial_step":48,"drawing":1120201},{"step":60,"content":"すると、死瞳の死体を違法密売する団体も露になった。逮捕された最初の容疑者は、目の前に座る彼女だ。","style":3,"log_type":1,"src_id":220201049,"trial_step":49,"drawing":1120201},{"step":61,"content":"調査のために、いくつか質問させてくれ。できれば、真剣に答えて欲しい。","style":2,"log_type":1,"src_id":220201050,"trial