{"id":1020203,"chapter_id":1020203,"scene_id":1,"steps":[{"step":1,"content":"最初の崩壊から、どのぐらいの時間が経ったのだろう。","style":3,"background":10000,"log_type":1,"src_id":120203001,"trial_step":1},{"step":2,"content":"周りは廃墟以外、見渡す限りの暗闇だった。","style":3,"background":10000,"log_type":1,"src_id":120203002,"trial_step":2},{"step":3,"speaker":"黒影","content":"早く起きろ。ここを離れるんだ。","voice":["vo_trial_20203_1_3"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203003,"trial_step":3},{"step":4,"content":"少女が目を覚まして、辛うじて瓦礫から身体を起こした。","style":3,"background":10000,"log_type":1,"src_id":120203004,"trial_step":4},{"step":5,"speaker":"少女","content":"ここは……どこですか？","voice":["vo_trial_20203_1_5"],"voice_bank":"vo_nuokesi_trial","style":1,"background":10000,"log_type":1,"src_id":120203005,"trial_step":5},{"step":6,"speaker":"？？？","content":"内海だ。","voice":["vo_trial_20203_1_6"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203006,"trial_step":6},{"step":7,"content":"目前のぼんやりとした黒影が不気味な声をあげた。","style":3,"background":1037,"log_type":1,"src_id":120203007,"trial_step":7},{"step":8,"speaker":"少女","content":"内海はこんなのじゃなかったはず……","voice":["vo_trial_20203_1_8"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203008,"trial_step":8},{"step":9,"speaker":"黒影","content":"もう忘れたのか？","voice":["vo_trial_20203_1_9"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203009,"trial_step":9},{"step":10,"content":"冷酷な記憶が少女の脳裏に流れ込んだ。膝をつく少女の白い瞳から涙が零れた。","style":3,"background":1037,"log_type":1,"src_id":120203010,"trial_step":10},{"step":11,"speaker":"少女","content":"介護者さん……先生……彼らは全員……","voice":["vo_trial_20203_1_11"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203011,"trial_step":11},{"step":12,"speaker":"黒影","content":"感傷に浸っている場合じゃない。周りを見ろ。","voice":["vo_trial_20203_1_12"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203012,"trial_step":12},{"step":13,"content":"少女が周りを見渡すと、廃墟の上は夥しい不気味な生物で満ち溢れていた。","style":3,"background":1037,"log_type":1,"src_id":120203013,"trial_step":13},{"step":14,"speaker":"少女","content":"これは……","voice":["vo_trial_20203_1_14"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203014,"trial_step":14},{"step":15,"speaker":"黒影","content":"人間だ。","voice":["vo_trial_20203_1_15"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203015,"trial_step":15},{"step":16,"speaker":"黒影","content":"もしくは、かつて人間だったものだ。","voice":["vo_trial_20203_1_16"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203016,"trial_step":16},{"step":17,"content":"少女が慌てて何歩か後ずさる。","style":3,"background":1037,"log_type":1,"src_id":120203017,"trial_step":17},{"step":18,"speaker":"黒影","content":"お前も生きていたいだろ？","voice":["vo_trial_20203_1_18"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203018,"trial_step":18},{"step":19,"speaker":"黒影","content":"今逃げ出せなければ、もうチャンスはない。","voice":["vo_trial_20203_1_19"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203019,"trial_step":19},{"step":20,"content":"少女は反射的に、黒影の「提案」に従った。","style":3,"background":1037,"log_type":1,"src_id":120203020,"trial_step":20},{"step":21,"content":"でも奇妙だ。ほんの少し前までは病に苛まれたままで、介護者の手伝いなしでは自分で歩くことも叶わなかったのに。","style":3,"background":1037,"log_type":1,"src_id":120203021,"trial_step":21},{"step":22,"content":"あの血のように赤い月に照らされ、痛みから逃げ出すように、むしろ足は速まっていく。","style":3,"background":1037,"log_type":1,"src_id":120203022,"trial_step":22},{"step":23,"content":"それでも、少女に喜んでいる暇はなかった。周りの化け物は数が増す一方で、恐怖は胸から溢れんばかりであった。","style":3,"background":1037,"log_type":1,"src_id":120203023,"trial_step":23},{"step":24,"speaker":"少女","content":"ここで死んでは駄目、出ていかないと……","voice":["vo_trial_20203_1_24"],"voice_bank":"vo_nuokesi_trial","style":1,"background":1037,"log_type":1,"src_id":120203024,"trial_step"