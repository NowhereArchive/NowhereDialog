{"id":1060604,"chapter_id":1060604,"scene_id":1,"steps":[{"step":1,"speaker":"局長","content":"明日？","style":2,"background":1040,"log_type":1,"src_id":160604001,"trial_step":1},{"step":2,"content":"通信機の向こうから、議員の意気揚々とした声が聞こえた。","style":3,"background":1040,"log_type":1,"src_id":160604002,"trial_step":2},{"step":3,"speaker":"議員","content":"ああ、明日ここを離れるようだ。杜若大使の書類は後ほどMBCCに届くだろう。彼女が管理局を出た後は、念入りに彼女の部屋を調べてくれ。ディスの安全を脅かす可能性を決して残さないようにな。","voice":["vo_trial_60604_1_3"],"voice_bank":"vo_duruo_trial","style":11,"background":1040,"log_type":1,"src_id":160604003,"trial_step":3},{"step":4,"speaker":"局長","content":"昨日砂の海から帰ったばかりだというのに、少し急すぎないか？","style":2,"background":1040,"log_type":1,"src_id":160604004,"trial_step":4},{"step":5,"speaker":"議員","content":"そもそも、データべース侵入の件を不問にして、彼女を東洲に帰らせること自体が十分な譲歩なのだ。彼女がディスに戻ったのも所詮は一時的滞在にすぎん。","voice":["vo_trial_60604_1_5"],"voice_bank":"vo_duruo_trial","style":11,"background":1040,"log_type":1,"src_id":160604005,"trial_step":5},{"step":6,"speaker":"議員","content":"それでは頼むぞ。この件について議論する余地はない。決定を下す前に当人の意見を聞いたが、杜若大使も特に異論ないようだ。","voice":["vo_trial_60604_1_6"],"voice_bank":"vo_duruo_trial","style":11,"background":1040,"log_type":1,"src_id":160604006,"trial_step":6},{"step":7,"content":"議員の話を裏付けるために杜若の部屋を訪ねた時、彼女は香を焚いていた。床には荷物が散らばったままだ。片付けの最中のように見える。","style":3,"background":2189,"log_type":1,"src_id":160604007,"trial_step":7},{"step":8,"options":["明日帰るのか？"],"style":6,"background":2189,"log_type":1,"src_id":160604008,"trial_step":8,"course":3,"choices":[{"text":"明日帰るのか？","goto":9}]},{"step":9,"speaker":"杜若","content":"そうですよ。名残惜しいですか？","voice":["vo_trial_60604_1_9"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604009,"trial_step":9},{"step":10,"speaker":"杜若","content":"今回お別れしたら、本当に長い間再会できないかもしれません。","voice":["vo_trial_60604_1_10"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604010,"trial_step":10},{"step":11,"content":"管理局の中で、このVIP休憩室は採光がいい方だ。東洲の人は霊気を集めるために日当たりのいい部屋が必要だと、杜若がここを訪ねたばかりの時にそう言ったからだ。","style":3,"background":2189,"log_type":1,"src_id":160604011,"trial_step":11},{"step":12,"content":"光の中で立ち尽くす杜若の周囲に煙がゆらゆらと立ち昇り、すぐに霧散する。","style":3,"background":2189,"log_type":1,"src_id":160604012,"trial_step":12},{"step":13,"speaker":"局長","content":"あなたがいつでもディスに来られるよう、上に話を付けてみる。","style":2,"background":2189,"log_type":1,"src_id":160604013,"trial_step":13},{"step":14,"speaker":"杜若","content":"感謝いたします。","voice":["vo_trial_60604_1_14"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604014,"trial_step":14},{"step":15,"content":"煙が満ちる部屋で、沈黙がしばらく続く。","style":3,"background":2189,"log_type":1,"src_id":160604015,"trial_step":15},{"step":16,"speaker":"杜若","content":"記念として、何か持ち帰ってもよろしいでしょうか？あのニューシティの、局長さんに言わせれば観光客向けのキーホルダーも買えなかったのですから。","voice":["vo_trial_60604_1_16"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604016,"trial_step":16},{"step":17,"content":"あなたは何をあげればいいか戸惑い、周りを見渡した。","style":3,"background":2189,"log_type":1,"src_id":160604017,"trial_step":17},{"step":18,"options":["この本はどうだ？","このペンはどうだ？"],"style":6,"background":2189,"log_type":1,"src_id":160604018,"trial_step":18,"course":3,"choices":[{"text":"この本はどうだ？","goto":19},{"text":"このペンはどうだ？","goto":null}]},{"step":19,"content":"彼女は首を横に振った。","style":3,"background":2189,"log_type":1,"src_id":160604019,"trial_step":19},{"step":20,"speaker":"杜若","content":"これが欲しいです。","voice":["vo_trial_60604_1_20"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604020,"trial_step":20},{"step":21,"content":"杜若は窓を押し開けて、窓の外にある枝を指差した。","style":3,"background":2189,"log_type":1,"src_id":160604021,"trial_step":21},{"step":22,"speaker":"杜若","content":"東洲には「折柳」という言葉があります。柳枝を折って別れるという惜別の意味です。よろしければ、枝を一つ折ってはくれませんか。","voice":["vo_trial_60604_1_22"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604022,"trial_step":22},{"step":23,"speaker":"杜若","content":"短い枝でいいですから。","voice":["vo_trial_60604_1_23"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604023,"trial_step":23},{"step":24,"content":"あなたは彼女の言う通りにした。杜若が大切そうにあなたの手から枝を受け取る。","style":3,"background":2189,"log_type":1,"src_id":160604024,"trial_step":24},{"step":25,"speaker":"杜若","content":"ありがとうございます……この枝を見ると、ディスであなたと共にいられた日々を思い出します。これがあれば長い帰路も飽きることなく過ごせるでしょう。","voice":["vo_trial_60604_1_25"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604025,"trial_step":25},{"step":26,"speaker":"局長","content":"本当にもう少しだけでも残らないのか？","style":2,"background":2189,"log_type":1,"src_id":160604026,"trial_step":26},{"step":27,"speaker":"杜若","content":"どうして私を引き止めるのでしょう？","voice":["vo_trial_60604_1_27"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604027,"trial_step":27},{"step":28,"content":"杜若が枝を回す手を止める。","style":3,"background":2189,"log_type":1,"src_id":160604028,"trial_step":28},{"step":29,"content":"太陽が昇りつつある中、彼女は静かにここに立っている。","style":3,"background":2189,"log_type":1,"src_id":160604029,"trial_step":29},{"step":30,"content":"明日になれば太陽はいつものようにこの部屋を照らすだろうが、目の前の人はここを離れ、とても遠い場所に行く。","style":3,"background":2189,"log_type":1,"src_id":160604030,"trial_step":30},{"step":31,"speaker":"杜若","content":"局長さん？","voice":["vo_trial_60604_1_31"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604031,"trial_step":31},{"step":32,"content":"彼女はわざとあなたの返答を催促した。","style":3,"background":2189,"log_type":1,"src_id":160604032,"trial_step":32},{"step":33,"content":"だが答えを口にする前に、誰かがドアをノックした。","style":3,"background":2189,"log_type":1,"src_id":160604033,"trial_step":33},{"step":34,"speaker":"MBCC局員","content":"ここは杜若様の部屋でしょうか？","voice":["vo_trial_60604_1_34"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604034,"trial_step":34},{"step":35,"speaker":"MBCC局員","content":"こちらは東洲に戻られるための書類です。お受け取りください。","voice":["vo_trial_60604_1_35"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604035,"trial_step":35},{"step":36,"content":"局員は書類を杜若に渡した後、簡単な挨拶をして部屋を出ていった。","style":3,"background":2189,"log_type":1,"src_id":160604036,"trial_step":36},{"step":37,"content":"気まずい様子のあなたを見て、杜若は小さくため息をつき、荷物の整理に戻った。","style":3,"background":2189,"log_type":1,"src_id":160604037,"trial_step":37},{"step":38,"options":["手伝おうか"],"style":6,"background":2189,"log_type":1,"src_id":160604038,"trial_step":38,"course":3,"choices":[{"text":"手伝おうか","goto":39}]},{"step":39,"content":"日光の下、埃が空を舞う。あなたと杜若は協力し合って、黙々と荷物を整理していった。","style":3,"background":2189,"log_type":1,"src_id":160604039,"trial_step":39},{"step":40,"content":"本、衣服、書類。","style":3,"background":2189,"log_type":1,"src_id":160604040,"trial_step":40},{"step":41,"speaker":"杜若","content":"またこうして手伝ってくれますか？","voice":["vo_trial_60604_1_41"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604041,"trial_step":41},{"step":42,"speaker":"局長","content":"ディスの規約を破らない限りは。","style":2,"background":2189,"log_type":1,"src_id":160604042,"trial_step":42},{"step":43,"speaker":"杜若","content":"それはどのような規約でしょう？","voice":["vo_trial_60604_1_43"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604043,"trial_step":43},{"step":44,"content":"杜若が急にあなたに近づくと、小さい声でそう尋ねた。","style":3,"background":2189,"log_type":1,"src_id":160604044,"trial_step":44},{"step":45,"speaker":"杜若","content":"狂瞳病に関する知識を知りたい、と言いましたら？","voice":["vo_trial_60604_1_45"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604045,"trial_step":45},{"step":46,"speaker":"局長","content":"許される範囲内でいいなら、答えよう。","style":2,"background":2189,"log_type":1,"src_id":160604046,"trial_step":46},{"step":47,"speaker":"杜若","content":"もし急に局長さんとお話ししたくなりましたら？","voice":["vo_trial_60604_1_47"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604047,"trial_step":47},{"step":48,"speaker":"局長","content":"必ず電話に出よう。","style":2,"background":2189,"log_type":1,"src_id":160604048,"trial_step":48},{"step":49,"speaker":"杜若","content":"では……私がずっとディスに来れないとしたら？","voice":["vo_trial_60604_1_49"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604049,"trial_step":49},{"step":50,"speaker":"局長","content":"……","style":2,"background":2189,"log_type":1,"src_id":160604050,"trial_step":50},{"step":51,"options":["東洲へ会いに行く","議員たちは喜ぶだろうな"],"style":6,"background":2189,"log_type":1,"src_id":160604051,"trial_step":51,"course":3,"choices":[{"text":"東洲へ会いに行く","goto":52},{"text":"議員たちは喜ぶだろうな","goto":53}]},{"step":52,"speaker":"杜若","content":"変な人ですね。そんなに私に会いたいのですか？","voice":["vo_trial_60604_1_52"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604052,"trial_step":52,"next":[54]},{"step":53,"speaker":"杜若","content":"それはつまり——ずっと会わなければ、局長さんの機嫌を損ねてしまうということでしょうか？","voice":["vo_trial_60604_1_53"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604053,"trial_step":53,"next":[54]},{"step":54,"content":"今度は、彼女はあなたの返答を待たずに、距離を置いた。","style":3,"background":2189,"log_type":1,"src_id":160604054,"trial_step":54},{"step":55,"speaker":"杜若","content":"ふふっ、からかうのはこれくらいにして……","voice":["vo_trial_60604_1_55"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604055,"trial_step":55},{"step":56,"speaker":"杜若","content":"今度会うまで、今日の局長さんをしっかり覚えておきますね。私を引き止めてくれたあなたのその表情を。","voice":["vo_trial_60604_1_56"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604056,"trial_step":56},{"step":57,"speaker":"杜若","content":"一人の神話学者として、機会があれば、またディスを訪ねることにします。あなたが望むなら、会いに来てもいいですよ。","voice":["vo_trial_60604_1_57"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604057,"trial_step":57},{"step":58,"speaker":"杜若","content":"局長さん、その時には越境申請の手続きをよろしく頼みます。その代わりに、これをどうぞ。","voice":["vo_trial_60604_1_58"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604058,"trial_step":58},{"step":59,"content":"彼女は東洲の糸綴じ本を一冊取り出して、あなたに差し出した。本の表紙には何も書かれていない。","style":3,"background":2189,"log_type":1,"src_id":160604059,"trial_step":59},{"step":60,"speaker":"局長","content":"これはなんだ？","style":2,"background":2189,"log_type":1,"src_id":160604060,"trial_step":60},{"step":61,"speaker":"杜若","content":"私が神話をまとめるためのノートです。","voice":["vo_trial_60604_1_61"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604061,"trial_step":61},{"step":62,"content":"彼女は最初のページを開いて、あなたに見せてくれた。","style":3,"background":2189,"log_type":1,"src_id":160604062,"trial_step":62},{"step":63,"content":"<i>今は昔、ディスといふ場所ありけり。神暴れ、災ひおこれり。勇敢なる者身を挺して、災ひと対抗せり。</i>","style":14,"background":2193,"log_type":1,"src_id":160604063,"trial_step":63},{"step":64,"speaker":"杜若","content":"昔々あるところに、ディスという都市がありました。神が怒り、多くの災いが降りかかりましたが、一人の勇敢な者が身を挺して、人々を守ってくれました。","voice":["vo_trial_60604_1_64"],"voice_bank":"vo_duruo_trial","style":1,"background":2193,"log_type":1,"src_id":160604064,"trial_step":64},{"step":65,"content":"<i>かの者苦難を経て、幾度も命を落とすところなりき。何人かが欺き、中傷す。異邦の者がともに往なむとすれど、勇敢なる者いなび、神を殺すと誓ふ。</i>","style":14,"background":4243,"log_type":1,"src_id":160604065,"trial_step":65},{"step":66,"speaker":"杜若","content":"その者は多くの困難を乗り越えましたが、人々に誤解され、中傷されて、不公平極まりない仕打ちに遭いました。一人の異邦人がその人を連れ出そうとしましたが断られます。その者は自分の場所に残り、引き続き災いと対抗する道を選びました。","voice":["vo_trial_60604_1_66"],"voice_bank":"vo_duruo_trial","style":1,"background":4243,"log_type":1,"src_id":160604066,"trial_step":66},{"step":67,"content":"一番下に小さな字で何か書かれていることにあなたは気づいた。その筆跡はとても鮮やかで、書かれたばかりの注釈のようだ。","style":3,"background":4243,"log_type":1,"src_id":160604067,"trial_step":67},{"step":68,"speaker":"局長","content":"ではこの言葉は？どういう意味なんだ？","style":2,"background":2189,"log_type":1,"src_id":160604068,"trial_step":68},{"step":69,"content":"杜若はまた意地悪そうな笑みを浮かべた。","style":3,"background":2189,"log_type":1,"src_id":160604069,"trial_step":69},{"step":70,"speaker":"杜若","content":"ゆっくりお考えください。東洲の人は皆含みをもたせますから。","voice":["vo_trial_60604_1_70"],"voice_bank":"vo_duruo_trial","style":1,"background":2189,"log_type":1,"src_id":160604070,"trial_step":70},{"step":71,"content":"<color=#fb9259><i>「今日ぞ知るや、山と海を平らにすること能はず」</color></i>","style":14,"background":10006,"is_centered":true,"log_type":1,"src_id":160604071,"trial_step":71}]}