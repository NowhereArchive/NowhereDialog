nk":"vo_coquelicot_trial","style":1,"log_type":1,"src_id":160402034,"trial_step":34,"drawing":1060401},{"step":34,"content":"……では、なぜ他人を巻き込んだ？","style":2,"log_type":1,"src_id":160402035,"trial_step":35,"drawing":1060401},{"step":35,"speaker":"コクリコ","content":"ついでに行った正義の儀式ってとこ。","voice":["vo_trial_60402_1_35"],"voice_bank":"vo_coquelicot_trial","style":1,"log_type":1,"src_id":160402036,"trial_step":36,"drawing":1060401},{"step":36,"content":"その裏事情は何も知らないのか？","style":2,"log_type":1,"src_id":160402037,"trial_step":37,"drawing":1060401},{"step":37,"speaker":"コクリコ","content":"知らないわね～","voice":["vo_trial_60402_1_37"],"voice_bank":"vo_coquelicot_trial","style":1,"log_type":1,"src_id":160402038,"trial_step":38,"drawing":1060400},{"step":38,"content":"取り調べ椅子の上で楽な姿勢をとり、指をさり気なくあなたの方に近づけて、彼女は無邪気に瞬きをする。","style":3,"log_type":1,"src_id":160402039,"trial_step":39,"drawing":1060400},{"step":39,"content":"コクリコはあなたを信用していない。彼女の態度はごまかし以外の何物でもない。","style":3,"log_type":1,"src_id":160402040,"trial_step":40,"drawing":1060400},{"step":40,"content":"何も分からない依頼のために、花庭園を上庭と戦わせて、危く全滅させるところだった。","style":2,"log_type":1,"src_id":160402041,"trial_step":41,"drawing":1060400},{"step":41,"content":"これほどまでに大きな代償を払ったというのに、あなたが何も知らないと、私が信じると思うのか？","style":2,"log_type":1,"src_id":160402042,"trial_step":42,"drawing":1060400},{"step":42,"content":"あなたはコクリコと距離をとり、分厚い物証を彼女の目の前に置いた。","style":3,"log_type":1,"src_id":160402043,"trial_step":43,"drawing":1060400},{"step":43,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":44,"course":6,"drawing":1060400},{"step":44,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":44,"course":6,"drawing":1060400},{"step":45,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":44,"course":6,"drawing":1060400},{"step":46,"options":["選択肢1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":44,"course":6,"drawing":1060400},{"step":47,"content":"＊","style":18,"log_type":1,"src_id":1,"trial_step":44,"course":6,"drawing":1060400},{"step":48,"options":["選択肢1","選択肢2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":44,"course":6,"drawing":1060400},{"step":49,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":44,"course":6,"drawing":1060400},{"step":50,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":44,"course":6,"drawing":1060400},{"step":51,"speaker":"コクリコ","content":"局長がどんな調査をしたのか、見せてもらうわ。","voice":["vo_trial_60402_1_44"],"voice_bank":"vo_coquelicot_trial","style":1,"log_type":1,"src_id":160402045,"trial_step":45,"drawing":1060403},{"step":52,"speaker":"コクリコ","content":"へぇ～「花庭園は設立当初から、上庭のメンバーと反狂瞳作戦要員を主要ターゲットとしている。花庭園の武器や物資の供給源は地底と深く関わっている」","voice":["vo_trial_60402_1_45"],"voice_bank":"vo_coquelicot_trial","style":1,"log_type":1,"src_id":160402046,"trial_step":46,"drawing":1060403},{"step":53,"speaker":"コクリコ","content":"「彼女たちは未知の手段で一般人をコンビクトに変えている。今この技術を所有しているのは……」","voice":["vo_trial_60402_1_46"],"voice_bank":"vo_coquelicot_trial","style":1,"log_type":1,"src_id":160402047,"trial_step":47,"drawing":1060403},{"step":54,"content":"パルマと、そして——","style":2,"log_type":1,"src_id":160402048,"trial_step":48,"drawing":1060403},{"step":55,"speaker":"コクリコ","content":"パルマの飼い主、地底勢力だと判明した。ハハハハハハッ！","voice":["vo_trial_60402_1_48"],"voice_bank":"vo_coquelicot_trial","style":1,"log_type":1,"src_id":160402049,"trial_step":49,"drawing":1060402},{"step":56,"content":"あなたの真剣な表情を見ても尚、彼女の笑いは止まらない。","style":3,"log_type":1,"src_id":160402050,"trial_step":50,"drawing":1060402},{"step":57,"speaker":"コクリコ","content":"全てを知っているのに、どうして私の芝居に付き合ってくれたの？","voice":["vo_trial_60402_1_50"],"voice_bank":"vo_coquelicot_trial","style":1,"log_type":1,"src_id":160402051,"trial_step":51,"drawing":1060402},{"step":58,"speaker":"コクリコ","content":"そうよ、かつてこの場所を育て、「師匠」と呼ばれる傀儡を操り、あの可憐な花たちを集めていた、独り善がりな奴らがいたわ。","voice":["vo_trial_60402_1_51"],"voice_bank":"vo_coquelicot_trial","style":1,"log_type":1,"src_id":160402052,"trial_step":52,"drawing":1060402},{"step":59,"speaker":"コクリコ","content":"私もその中の一人。「私の師匠」に呼び寄せられ、導かれ、力を操り、彼女のために働いて