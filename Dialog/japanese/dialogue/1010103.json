1010,"log_type":1,"src_id":110103134,"trial_step":134},{"step":135,"speaker":"デーモン","content":"俺の個人口座は一つしかない。それは俺の義妹……ヴィラが管理している。","voice":["vo_trial_10103_1_74"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103135,"trial_step":135},{"step":136,"speaker":"事務官","content":"あなたがヴィラの指図を受けて、彼女の実の父を殺害した、ということですか？","voice":["vo_trial_10103_1_75"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103136,"trial_step":136},{"step":137,"speaker":"デーモン","content":"黙れ！","voice":["vo_trial_10103_1_76"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103137,"trial_step":137},{"step":138,"content":"デーモンの頭が怒りで沸騰する——彼にとって、ヴィラは最後の家族だ。ヴィラに罪を被せることなど許すわけがない。","style":3,"background":1010,"log_type":1,"src_id":110103138,"trial_step":138},{"step":139,"speaker":"事務官","content":"幸い、ヴィラさんは我々に秘密裡に保護されています。でないと、彼女まであなたに殺害されてしまうかもしれませんからね。","voice":["vo_trial_10103_1_77"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103139,"trial_step":139},{"step":140,"content":"ここまで来ると、市議会も自分の切り札を隠さなかった。","style":3,"background":1010,"log_type":1,"src_id":110103140,"trial_step":140},{"step":141,"speaker":"デーモン","content":"ヴィラが……やはりお前らに……","voice":["vo_trial_10103_1_78"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103141,"trial_step":141},{"step":142,"speaker":"事務官","content":"ヴィラさんが105年1月に我々に保護プログラムの実行を申し込みました——あなたに殺害されないようにと、彼女はずっと逃げています。","voice":["vo_trial_10103_1_79"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103142,"trial_step":142},{"step":143,"speaker":"デーモン","content":"彼女はどこにいる！？","voice":["vo_trial_10103_1_80"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103143,"trial_step":143},{"step":144,"speaker":"事務官","content":"実に残念ですが、ヴィラさんの安全を保証するために、彼女は証人としてここには来ません。","voice":["vo_trial_10103_1_81"],"voice_bank":"vo_dimeng_trial","style":1,"backg