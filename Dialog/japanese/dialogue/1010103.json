rc_id":110103167,"trial_step":167},{"step":168,"content":"こんな肝心な時に邪魔されるとは思わなかったのだろう、裁判官が不快そうな顔をしている。","style":3,"background":1010,"log_type":1,"src_id":110103168,"trial_step":168},{"step":169,"speaker":"第九機関メンバー","content":"事務官さんにお尋ねしたいのですが……その供述を記録した時間は？","voice":["vo_trial_10103_1_95"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103169,"trial_step":169},{"step":170,"content":"事務官が怪訝な顔を裁判官に向ける。","style":3,"background":1010,"log_type":1,"src_id":110103170,"trial_step":170},{"step":171,"speaker":"裁判官","content":"2日前だ。","voice":["vo_trial_10103_1_97"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103171,"trial_step":171},{"step":172,"content":"悪名高い第九機関のスパイの前だ、裁判官も隠そうとはしなかった。","style":3,"background":1010,"log_type":1,"src_id":110103172,"trial_step":172},{"step":173,"speaker":"第九機関メンバー","content":"供述の尋問と記録をした人物は？","voice":["vo_trial_10103_1_98"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103173,"trial_step":173},{"step":174,"speaker":"裁判官","content":"重要な供述だ、私自ら行った。","voice":["vo_trial_10103_1_99"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103174,"trial_step":174},{"step":175,"content":"こんな状況だ、さすがのベテラン裁判官でも少し焦りが見える。さっさと相手の質問に答えて、この裁判を終わりにするつもりだろう。","style":3,"background":1010,"log_type":1,"src_id":110103175,"trial_step":175},{"step":176,"speaker":"第九機関メンバー","content":"あれ？それはおかしいですね……","voice":["vo_trial_10103_1_100"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103176,"trial_step":176},{"step":177,"content":"男の声が笑ったように聞こえた。","style":3,"background":1010,"log_type":1,"src_id":110103177,"trial_step":177},{"step":178,"speaker":"第九機関メンバー","content":"5時間前、私の配下が一つのパルマの拠点を襲撃しました。その「パルマ」がどういう意味なのか、はっきりとお分かりでしょう。","voice":["vo_trial_10103_1_101"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103178,"trial_step":178},{"step":179,"speaker":"第九機関メンバー","content":"そして、その基地から多くの死体が見つかりました。ついさっき、遺伝子検査を終えたところです。その中の一つの死体の身分が解明されています——","voice":["vo_trial_10103_1_102"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103179,"trial_step":179},{"step":180,"speaker":"第九機関メンバー","content":"その死体は、議員アベル・スヒルデルの娘、ヴィラ・スヒルデルのものです。","voice":["vo_trial_10103_1_103"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103180,"trial_step":180},{"step":181,"content":"それを聞いて、デーモンの全身が硬直し、茫然としている。","style":3,"background":1010,"log_type":1,"src_id":110103181,"trial_step":181},{"step":182,"content":"その歯は震えているが、何も言い出せなかった。","style":3,"background":1010,"log_type":1,"src_id":110103182,"trial_step":182},{"step":183,"speaker":"裁判官","content":"そ、それが……","voice":["vo_trial_10103_1_104"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103183,"trial_step":183},{"step":184,"speaker":"第九機関メンバー","content":"死亡時期で言い訳をしたいのなら、やめておいたほうがいいですよ。ヴィラさんは少なくとも6年前に亡くなったはずです。","voice":["vo_trial_10103_1_105"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103184,"trial_step":184},{"step":185,"speaker":"裁判官","content":"それは、それは……","voice":["vo_trial_10103_1_106"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103185,"trial_step":185},{"step":186,"speaker":"第九機関メンバー","content":"おかしいですね、ヴィラさんの死を知らないとでも？パルマから彼女の情報が伝わらなかったのでしょうか？では、パルマの誰と情報のやり取りをしていたのでしょうか？後で死体安置所を確認してみます？","voice":["vo_trial_10103_1_107"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103186,"trial_step":186},{"step":187,"content":"裁判官の顔が真っ青になって、何も言わなくなった——これ以上は何を言っても無駄だと、悟ったからだ。","style":3,"background":1010,"log_type":1,"src_id":110103187,"trial_step":187},{"step":188,"content":"たった一言で、情勢が逆転した。全て、あの第九機関の男のおかげだ。","style":3,"background":1010,"log_type":1,"src_id":110103188,"trial_step":188},{"step":189,"content":"男は依然として淡く微笑んでいる。","style":3,"background":1010,"log_type":1,"src_id":110103189,"trial_step":189},{"step":190,"speaker":"第九機関メンバー","content":"上からの命令です。ニューシティ議員殺害事件に関する裁判を一時停止して、容疑者デーモン・スヒルデルをMBCCに帰します。","voice":["vo_trial_10103_1_108"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103190,"trial_step":190},{"step":191,"speaker":"第九機関メンバー","content":"今一番重要なことは、市議会の不正行為を調査して、パルマの勢力を排除することです……ブラック様、ご協力をお願いします。","voice":["vo_trial_10103_1_109"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103191,"trial_step":191},{"step":192,"content":"今回の勝者、第九機関の男がゆっくりと裁判官の前へと歩を進め、一緒に来るように促した。","style":3,"background":1010,"log_type":1,"src_id":110103192,"trial_step":192},{"step":193,"content":"先日の交渉も協力の提案も目くらましに過ぎない。第九機関があなたとデーモンを利用したのだ。","style":3,"background":1010,"log_type":1,"src_id":110103193,"trial_step":193},{"step":194,"content":"彼らの本当の目的は、この裁判を口実に、市議会を問い糾すことだった。","style":3,"background":1010,"log_type":1,"src_id":110103194,"trial_step":194},{"step":195,"speaker":"デーモン","content":"何故だ……","voice":["vo_trial_10103_1_110"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103195,"trial_step":195},{"step":196,"content":"デーモンの声が掠れていた。彼が今回の裁判の主役だったのに、騒然としているこの裁判所で、彼の言葉に耳を傾ける者はあなたしかいなかった。","style":3,"background":1010,"log_type":1,"src_id":110103196,"trial_step":196},{"step":197,"content":"彼は地面に跪いて微動だにしない。けれど、その声は震えていた。","style":3,"background":1010,"log_type":1,"src_id":110103197,"trial_step":197},{"step":198,"speaker":"第九機関メンバー","content":"お悔やみ申し上げます。デーモンさん。","voice":["vo_trial_10103_1_111"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103198,"trial_step":198},{"step":199,"speaker":"第九機関メンバー","content":"あなたへの裁判はこれで終わりましたが、もっと重要なことがありまして……","voice":["vo_trial_10103_1_112"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103199,"trial_step":199},{"step":200,"speaker":"デーモン","content":"ヴィラが何をしたというのだ……どうして彼女までこんな目に……","voice":["vo_trial_10103_1_113"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103200,"trial_step":200},{"step":201,"content":"裁判官がこちらに顔を向けた。その顔色は優れないが、彼が無理をして口を開く。","style":3,"background":1010,"log_type":1,"src_id":110103201,"trial_step":201},{"step":202,"speaker":"裁判官","content":"私は無関係だ……","voice":["vo_trial_10103_1_114"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103202,"trial_step":202},{"step":203,"speaker":"デーモン","content":"お前が……供述を書き写したと……","voice":["vo_trial_10103_1_115"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103203,"trial_step":203},{"step":204,"speaker":"裁判官","content":"そんな嘘を信じたのか？","voice":["vo_trial_10103_1_116"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103204,"trial_step":204},{"step":205,"speaker":"裁判官","content":"彼女をパルマに渡したのは私一人の判断じゃない。それ以降、彼女がどうなったのか誰も知らないのだ。","voice":["vo_trial_10103_1_117"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103205,"trial_step":205},{"step":206,"content":"それでも彼女の名義で偽の供述を作ったのか？","style":2,"background":1010,"log_type":1,"src_id":110103206,"trial_step":206},{"step":207,"content":"裁判官の顔が真っ青だった。","style":3,"background":1010,"log_type":1,"src_id":110103207,"trial_step":207},{"step":208,"speaker":"裁判官","content":"誰も彼女の死を望んではいなかった……パルマがそんなことをするとは本当に思ってなかったのだ。","voice":["vo_trial_10103_1_118"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103208,"trial_step":208},{"step":209,"speaker":"デーモン","content":"ならばお前も死ね。","voice":["vo_trial_10103_1_119"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103209,"trial_step":209},{"step":210,"content":"あっという間に起きたことだ。阻止する時間なんてなかった。","style":3,"background":10000,"log_type":1,"src_id":110103210,"trial_step":210},{"step":211,"content":"デーモンが重い鎖を断ち切って、相手の前に飛び掛かった。次の瞬間、裁判官の頭が地面に落ちて、まるで水がたまった鉢のように粉々になった。","style":3,"background":10000,"log_type":1,"src_id":110103211,"trial_step":211},{"step":212,"content":"それから5秒間、誰も反応できなかった。デーモンは糸が切れた人形のように、地面に跪いて、動かなくなった。その身体から、魂が消えてしまったかのようだった。","style":3,"background":1010,"log_type":1,"src_id":110103212,"trial_step":212},{"step":213,"content":"8年振りに、デーモンがまた公衆の目前で人を殺した。","style":3,"background":1010,"log_type":1,"src_id":110103213,"trial_step":213},{"step":214,"speaker":"第九機関メンバー","content":"うっ……","voice":["vo_trial_10103_1_120"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103214,"trial_step":214},{"step":215,"content":"すみません、彼を止められなかった。","style":2,"background":1010,"log_type":1,"src_id":110103215,"trial_step":215},{"step":216,"content":"あなたたちの調査はどうします……？","style":2,"background":1010,"log_type":1,"src_id":110103216,"trial_step":216},{"step":217,"speaker":"第九機関メンバー","content":"それならご心配なく。もう充分ですから。とりあえず、ご協力に感謝します。","voice":["vo_trial_10103_1_121"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103217,"trial_step":217},{"step":218,"content":"彼は恐怖で崩れ落ちた事務官を一瞥して、またデーモンに目をやる。","style":3,"background":1010,"log_type":1,"src_id":110103218,"trial_step":218},{"step":219,"speaker":"第九機関メンバー","content":"駒としては、デーモンはあまりにも不安定です。どうかお気を付けください。","voice":["vo_trial_10103_1_122"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103219,"trial_step":219},{"step":220,"speaker":"第九機関メンバー","content":"裁判の最中で人を殺した罪は簡単に言い逃れられないでしょう。うまく処理しないと、管理局が非難されるかもしれません。","voice":["vo_trial_10103_1_123"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103220,"trial_step":220},{"step":221,"content":"善処します。","style":2,"background":1010,"log_type":1,"src_id":110103221,"trial_step":221},{"step":222,"speaker":"第九機関メンバー","content":"あなたの判断を信じます。あっ、そうだ……","voice":["vo_trial_10103_1_124"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103222,"trial_step":222},{"step":223,"speaker":"第九機関メンバー","content":"よろしく伝えておいてくれと、ラングリーから頼まれました。","voice":["vo_trial_10103_1_125"],"voice_bank":"vo_dimeng_trial","style":1,"background":1010,"log_type":1,"src_id":110103223,"trial_step":223},{"step":224,"content":"男が最後に帽子を外してあなたに一礼をして、足早にこの場から去った。彼に続いて、FACの役員もデーモンを一瞥して、何も言わずに去っていった。","style":3,"background":1010,"log_type":1,"src_id":110103224,"trial_step":224},{"step":225,"content":"裁判所のホールに残ったのは、デーモン、あなた、そして散らかる汚い犯行現場だけだった。","style":3,"background":1010,"log_type":1,"src_id":110103225,"trial_step":225}]}