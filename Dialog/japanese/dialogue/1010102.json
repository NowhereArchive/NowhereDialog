{"id":1010102,"chapter_id":1010102,"scene_id":1,"steps":[{"step":1,"content":"裁判まであと\n15日","style":9,"background":10000,"log_type":1,"src_id":110102001,"trial_step":1},{"step":2,"content":"廊下を通り抜けて、デーモンが収監されている独房の前に来た。","style":3,"background":107,"log_type":1,"src_id":110102002,"trial_step":2},{"step":3,"content":"何名かの警備員がここで待機している。","style":3,"background":107,"log_type":1,"src_id":110102003,"trial_step":3},{"step":4,"speaker":"警備員","content":"証拠はすでに準備されています。容疑者デーモン・スヒルデルは目覚めています。いつでも尋問を開始できます。","voice":["vo_trial_10102_1_1"],"voice_bank":"vo_dimeng_trial","style":1,"background":107,"log_type":1,"src_id":110102004,"trial_step":4},{"step":5,"options":["独房のドアを開ける"],"style":6,"background":107,"log_type":1,"src_id":110102005,"trial_step":5,"course":3,"choices":[{"text":"独房のドアを開ける","goto":6}]},{"step":6,"content":"ドアを開けようと警備員に頷いて、独房と向き合い深く息を吸う。","style":3,"background":107,"log_type":1,"src_id":110102006,"trial_step":6},{"step":7,"content":"独房のドアが開けられたが、そこにはデーモンの姿はなかった。","style":3,"background":107,"log_type":1,"src_id":110102007,"trial_step":7},{"step":8,"speaker":"警備員","content":"局長、気をつけて！","voice":["vo_trial_10102_1_2"],"voice_bank":"vo_dimeng_trial","style":1,"background":107,"log_type":1,"src_id":110102008,"trial_step":8},{"step":9,"content":"嫌な予感がしたあなたが振り返ると、デーモンの暗い目が視界に入った。","style":3,"background":107,"log_type":1,"src_id":110102009,"trial_step":9},{"step":10,"content":"何とかして抵抗しようとしたが、頭に気を失いそうなほどの激痛が走った。","style":3,"background":107,"log_type":1,"src_id":110102010,"trial_step":10},{"step":11,"content":"何をしている！？","style":3,"background":10000,"log_type":1,"src_id":110102011,"trial_step":11},{"step":12,"content":"局長を……放せ……","style":3,"background":10000,"log_type":1,"src_id":110102012,"trial_step":12},{"step":13,"content":"銃を下ろせ……ヤツを通せ……","style":3,"background":10000,"log_type":1,"src_id":110102013,"trial_step":13},{"step":14,"content":"目を開けると、古びた天井が視界に入った。あなたの手足がしっかりと拘束されていて、身動きができない。","style":3,"background":1034,"log_type":1,"src_id":110102014,"trial_step":14},{"step":15,"content":"ぼんやりとした意識で先ほどまでのことを思い出す——独房でデーモンを尋問しようとした時、襲撃されたことを。","style":3,"background":1034,"log_type":1,"src_id":110102015,"trial_step":15},{"step":16,"content":"椅子に座ったデーモンがうたた寝をしている。数日間も続いた逃亡生活と、昔に負った古傷で疲れたみたいだ。","style":3,"background":1034,"log_type":1,"src_id":110102016,"trial_step":16},{"step":17,"speaker":"デーモン","content":"……目覚めたか？","voice":["vo_trial_10102_1_3"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102017,"trial_step":17},{"step":18,"content":"あなたの音が耳に入ったせいか、デーモンが目覚めたようだ。彼が机に置いてあるカップを手に取り、あなたの元に歩み寄ると、水が入ったカップをあなたの口元に沿えた。","style":3,"background":1034,"log_type":1,"src_id":110102018,"trial_step":18},{"step":19,"speaker":"デーモン","content":"……","voice":["vo_trial_10102_1_4"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102019,"trial_step":19},{"step":20,"options":["飲む","拒絶する"],"style":6,"background":1034,"log_type":1,"src_id":110102020,"trial_step":20,"course":3,"choices":[{"text":"飲む","goto":21},{"text":"拒絶する","goto":22}]},{"step":21,"content":"断りたいが、ひび割れた唇も、渇いた喉も、水を欲しがっている。","style":3,"background":1034,"log_type":1,"src_id":110102021,"trial_step":21,"next":[24]},{"step":22,"speaker":"デーモン","content":"きみは脱水症になっていた。","voice":["vo_trial_10102_1_5"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102022,"trial_step":22},{"step":23,"content":"ひび割れた唇が痛む。デーモンの言う通りだ。あなたは大人しく水を飲んだ。","style":3,"background":1034,"log_type":1,"src_id":110102023,"trial_step":23},{"step":24,"content":"そして、デーモンは黙ったままだ。何も説明するつもりがないようだ。","style":3,"background":1034,"log_type":1,"src_id":110102024,"trial_step":24},{"step":25,"content":"辛うじて身体を動かすと、個人用の端末がまだ残っていることに気づいた——これでは、管理局があなたの位置を特定できるはずだ。","style":3,"background":1034,"log_type":1,"src_id":110102025,"trial_step":25},{"step":26,"speaker":"デーモン","content":"……","voice":["vo_trial_10102_1_6"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102026,"trial_step":26},{"step":27,"content":"デーモンがあなたの行動に気づいて、目を細める。","style":3,"background":1034,"log_type":1,"src_id":110102027,"trial_step":27},{"step":28,"speaker":"デーモン","content":"動き回るな。","voice":["vo_trial_10102_1_7"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102028,"trial_step":28},{"step":29,"content":"デーモンの目が血走った。脅しのつもりで言っているはずなのに、とても疲れているように聞こえる。","style":3,"background":1034,"log_type":1,"src_id":110102029,"trial_step":29},{"step":30,"content":"彼の状況がよくない。脅しも犯行も、無理をしているようにしか見えない。","style":3,"background":1034,"log_type":1,"src_id":110102030,"trial_step":30},{"step":31,"options":["拉致の理由を聞く"],"style":6,"background":1034,"log_type":1,"src_id":110102031,"trial_step":31,"course":3,"choices":[{"text":"拉致の理由を聞く","goto":32}]},{"step":32,"content":"管理局から逃げ出した以上、お前は目的を果たしたはずだ。どうして私を解放しない？","style":2,"background":1034,"log_type":1,"src_id":110102032,"trial_step":32},{"step":33,"speaker":"デーモン","content":"……","voice":["vo_trial_10102_1_8"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102033,"trial_step":33},{"step":34,"content":"私を殺すためか？","style":2,"background":1034,"log_type":1,"src_id":110102034,"trial_step":34},{"step":35,"content":"デーモンがただ座り込む。暗い灯りの下で、真っ暗な闇が生じる。","style":3,"background":1034,"log_type":1,"src_id":110102035,"trial_step":35},{"step":36,"content":"長い沈黙の後、彼が掠れた声で言った。","style":3,"background":1034,"log_type":1,"src_id":110102036,"trial_step":36},{"step":37,"speaker":"デーモン","content":"殺す必要はない……","voice":["vo_trial_10102_1_9"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102037,"trial_step":37},{"step":38,"speaker":"デーモン","content":"俺の復讐の邪魔をしなければ、解放しよう。","voice":["vo_trial_10102_1_10"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102038,"trial_step":38},{"step":39,"content":"復讐。デーモンからこの言葉を聞いたのはこれで2回目だ。","style":3,"background":1034,"log_type":1,"src_id":110102039,"trial_step":39},{"step":40,"options":["一体誰に復讐を？"],"style":6,"background":1034,"log_type":1,"src_id":110102040,"trial_step":40,"course":3,"choices":[{"text":"一体誰に復讐を？","goto":41}]},{"step":41,"speaker":"デーモン","content":"それを教える義理はない……","voice":["vo_trial_10102_1_11"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102041,"trial_step":41},{"step":42,"content":"ガチャン——","style":3,"background":1034,"log_type":1,"src_id":110102042,"trial_step":42},{"step":43,"content":"突如響いた音がデーモンの話を遮った。それは隅の排水管からの音だ。偵察に向けた対策の何かが発動したのだろう。デーモンが警戒を強める。","style":3,"background":1034,"log_type":1,"src_id":110102043,"trial_step":43},{"step":44,"content":"それは、誰かがあなたを助けにきた合図でもあった。","style":3,"background":1034,"log_type":1,"src_id":110102044,"trial_step":44},{"step":45,"content":"お前の復讐の相手は、あの死んでいる市議会の連中か？彼らは何をしたんだ？","style":2,"background":1034,"log_type":1,"src_id":110102045,"trial_step":45},{"step":46,"content":"デーモンは返事をせずに、立ち上がって窓辺に歩いて行き、カーテンを開いて外の様子を確認していた。そして、彼は足早であなたのところまで来た。","style":3,"background":1034,"log_type":1,"src_id":110102046,"trial_step":46},{"step":47,"content":"彼らがお前に罪を着せたのか？","style":2,"background":1034,"log_type":1,"src_id":110102047,"trial_step":47},{"step":48,"speaker":"デーモン","content":"黙れ。","voice":["vo_trial_10102_1_12"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102048,"trial_step":48},{"step":49,"content":"デーモンの表情が硬くなったが、正面から返事をしなかった。トラップが発動したせいか、彼はとても不安そうに見えるが、ここから去るつもりはないようだ。","style":3,"background":1034,"log_type":1,"src_id":110102049,"trial_step":49},{"step":50,"content":"救助のためにも、もっと時間を稼がなければ。","style":3,"background":1034,"log_type":1,"src_id":110102050,"trial_step":50},{"step":51,"options":["デーモンを刺激する"],"style":6,"background":1034,"log_type":1,"src_id":110102051,"trial_step":51,"course":3,"choices":[{"text":"デーモンを刺激する","goto":52}]},{"step":52,"content":"ずっと逃げているつもりか？","style":2,"background":1034,"log_type":1,"src_id":110102052,"trial_step":52},{"step":53,"speaker":"デーモン","content":"？","voice":["vo_trial_10102_1_13"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102053,"trial_step":53},{"step":54,"content":"もう8年だ。お前に殺された人は増えて、お前の悪名も知られるようになった。だが、真実は未だに謎のままだ。人々にとって、お前は恐ろしい、憎むべき人殺しに過ぎない……","style":2,"background":1034,"log_type":1,"src_id":110102054,"trial_step":54},{"step":55,"content":"そして今のお前はこんな有様だ。あちこち逃げ回って、いつ倒れてもおかしくない……そんな代価を支払って、お前の復讐はどこまで進んだんだ？","style":2,"background":1034,"log_type":1,"src_id":110102055,"trial_step":55},{"step":56,"speaker":"デーモン","content":"黙れ！","voice":["vo_trial_10102_1_14"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102056,"trial_step":56},{"step":57,"content":"デーモンが俯いて、あなたの襟を掴む。","style":3,"background":1034,"log_type":1,"src_id":110102057,"trial_step":57},{"step":58,"speaker":"デーモン","content":"きみに何がわかる！","voice":["vo_trial_10102_1_15"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102058,"trial_step":58},{"step":59,"content":"そう言うのなら教えてくれ。お前はいったい何がしたい？","style":2,"background":1034,"log_type":1,"src_id":110102059,"trial_step":59},{"step":60,"content":"8年間も抑えられていた怒りが解き放たれた。","style":3,"background":1034,"log_type":1,"src_id":110102060,"trial_step":60},{"step":61,"speaker":"デーモン","content":"ヤツらはアベルの死の代価を支払わねばならない！","voice":["vo_trial_10102_1_16"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102061,"trial_step":61},{"step":62,"content":"アベルを殺害した元凶は、市議会だと言いたいのか？","style":2,"background":1034,"log_type":1,"src_id":110102062,"trial_step":62},{"step":63,"speaker":"デーモン","content":"見て分からないのか？","voice":["vo_trial_10102_1_17"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102063,"trial_step":63},{"step":64,"speaker":"デーモン","content":"8年前、アベルは『西区治安条例』を廃止しようと、議長候補になった……","voice":["vo_trial_10102_1_18"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102064,"trial_step":64},{"step":65,"speaker":"デーモン","content":"市議会のゴミども以外に、彼を殺して喜ぶヤツがどこにいるんだ！？","voice":["vo_trial_10102_1_19"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102065,"trial_step":65},{"step":66,"content":"ずっと張りつめていたデーモンが怒りと殺意で表情を歪めた。","style":3,"background":1034,"log_type":1,"src_id":110102066,"trial_step":66},{"step":67,"speaker":"デーモン","content":"ヤツらが俺の昔の部下、フィンを買収して、狂瞳武器を暴徒に持たせて会場に入らせた。","voice":["vo_trial_10102_1_20"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102067,"trial_step":67},{"step":68,"speaker":"デーモン","content":"結局、俺は死瞳になったアベルを、俺の……父を、この手で殺すしかなかった。","voice":["vo_trial_10102_1_21"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102068,"trial_step":68},{"step":69,"content":"「父」という言葉を口にするとき、デーモンの声は明らかに震えていた。","style":3,"background":1034,"log_type":1,"src_id":110102069,"trial_step":69},{"step":70,"speaker":"デーモン","content":"そしてヤツらは、その罪の全てを俺に被せた……","voice":["vo_trial_10102_1_22"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102070,"trial_step":70},{"step":71,"speaker":"デーモン","content":"一番笑えたことは、誰も彼もが市議会の言い訳を疑うことなく受け入れたことだ。俺が……シンジケート人という理由だけで。","voice":["vo_trial_10102_1_23"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102071,"trial_step":71},{"step":72,"speaker":"デーモン","content":"それならば、俺はシンジケート人らしくケリをつけるしかなかった……","voice":["vo_trial_10102_1_24"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102072,"trial_step":72},{"step":73,"content":"デーモンがあなたに近づいて、ゆっくりと言う。","style":3,"background":1034,"log_type":1,"src_id":110102073,"trial_step":73},{"step":74,"speaker":"デーモン","content":"この事件に関わった全員に、引導を渡してやる。","voice":["vo_trial_10102_1_26"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102074,"trial_step":74},{"step":75,"content":"デーモンのその言葉に、8年間で溜まった怒りと悔しさが表れていた。","style":3,"background":1034,"log_type":1,"src_id":110102075,"trial_step":75},{"step":76,"content":"話を終えると、彼は目を血走らせながら、肩で息をしていた。とても険しい表情だが、とても脆く見える姿だった。","style":3,"background":1034,"log_type":1,"src_id":110102076,"trial_step":76},{"step":77,"options":["私ならお前を助けられる"],"style":6,"background":1034,"log_type":1,"src_id":110102077,"trial_step":77,"course":3,"choices":[{"text":"私ならお前を助けられる","goto":78}]},{"step":78,"speaker":"デーモン","content":"俺を？","voice":["vo_trial_10102_1_27"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102078,"trial_step":78},{"step":79,"content":"デーモンが鼻で笑った。","style":3,"background":1034,"log_type":1,"src_id":110102079,"trial_step":79},{"step":80,"speaker":"デーモン","content":"どうやって俺を助けるというんだ？市議会に宣戦布告でもするつもりか？","voice":["vo_trial_10102_1_28"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102080,"trial_step":80},{"step":81,"content":"お前は管理局のコンビクトだ。先の話が本当なら、私にはお前を守る義務がある。","style":2,"background":1034,"log_type":1,"src_id":110102081,"trial_step":81},{"step":82,"content":"黒幕を捕縛するためにも、生きなければならない。このまま逃げてしまえば、お前はいつか死んでしまう……私と一緒に管理局に戻るんだ。今ならまだ間に合う。","style":2,"background":1034,"log_type":1,"src_id":110102082,"trial_step":82},{"step":83,"content":"デーモンが顔を上げて、深く息を吸って自分を落ち着かせる。","style":3,"background":1034,"log_type":1,"src_id":110102083,"trial_step":83},{"step":84,"speaker":"デーモン","content":"……8年前の俺なら、きみを信じたかもしれない。","voice":["vo_trial_10102_1_29"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102084,"trial_step":84},{"step":85,"speaker":"デーモン","content":"でも今の俺は違う。","voice":["vo_trial_10102_1_30"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102085,"trial_step":85},{"step":86,"speaker":"デーモン","content":"時間稼ぎだろう？これ以上、チャンスをあげるつもりはない。","voice":["vo_trial_10102_1_31"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102086,"trial_step":86},{"step":87,"content":"弁解するため、あなたは必死に起き上がろうとする。","style":3,"background":1034,"log_type":1,"src_id":110102087,"trial_step":87},{"step":88,"content":"あなたの動きが激しかったせいか、証拠として持っていたあのブレスレットがポケットから床に落ちた。","style":3,"background":1034,"log_type":1,"src_id":110102088,"trial_step":88},{"step":89,"speaker":"デーモン","content":"！","voice":["vo_trial_10102_1_32"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102089,"trial_step":89},{"step":90,"content":"デーモンが目を見開き、ブレスレットをじっと見つめる——彼にそれを見せたのはこれで二回目だが、その動揺はまだ隠せていなかった。","style":3,"background":1034,"log_type":1,"src_id":110102090,"trial_step":90},{"step":91,"content":"彼の様子を見て、あなたが尋問する時に聞きたかった質問と、資料を調べる時に分かったことを思い出す。","style":3,"background":1034,"log_type":1,"src_id":110102091,"trial_step":91},{"step":92,"speaker":"ナイチンゲール","content":"資料が正しければ、市議会からのブレスレットはこの人の所有物かと。","voice":["vo_trial_10102_1_33"],"voice_bank":"vo_dimeng_trial","style":1,"background":10000,"log_type":1,"src_id":110102092,"trial_step":92},{"step":93,"speaker":"ナイチンゲール","content":"アベルの実の娘、デーモンの義妹——","voice":["vo_trial_10102_1_34"],"voice_bank":"vo_dimeng_trial","style":1,"background":10000,"log_type":1,"src_id":110102093,"trial_step":93},{"step":94,"options":["あの名前を口にする"],"style":6,"background":1034,"log_type":1,"src_id":110102094,"trial_step":94,"course":3,"choices":[{"text":"あの名前を口にする","goto":95}]},{"step":95,"content":"ヴィラ・スヒルデル。","style":2,"background":1034,"log_type":1,"src_id":110102095,"trial_step":95},{"step":96,"content":"デーモンは床に落ちたブレスレットを見つめたままで、返事をしなかった。","style":3,"background":1034,"log_type":1,"src_id":110102096,"trial_step":96},{"step":97,"content":"お前にとって大切な人なのか？","style":2,"background":1034,"log_type":1,"src_id":110102097,"trial_step":97},{"step":98,"speaker":"デーモン","content":"彼女は俺の家族……俺の妹だ。","voice":["vo_trial_10102_1_35"],"voice_bank":"vo_dimeng_trial","style":1,"background":1034,"log_type":1,"src_id":110102098,"trial_step":98},{"step":99,"content":"デーモンは否定しなかった。","style":3,"background":1034,"log_type":1,"src_id":110102099,"trial_step":99},{"step":100,"content":"デーモンがブレスレットを拾い上げる、その動作はとても優しいものだった。","style":3,"background":1034,"log_type":1,"src_id":110102100,"trial_step":100},{"step":101,"content":"カーテンの隙間から昏い光が差し込む。白いブレスレットが揺れて、それを見つめるデ