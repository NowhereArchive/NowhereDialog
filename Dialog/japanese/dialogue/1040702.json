{"id":1040702,"chapter_id":1040702,"scene_id":1,"steps":[{"step":1,"speaker":"モーガン＆イサン","content":"……","style":1,"background":2221,"log_type":1,"src_id":140702001,"trial_step":1},{"step":2,"content":"二人はオフィスの中で特に目立つあのデスクに視線を向けた。元々はビアンカの席だが、今はもう雑物置き場と化している。","style":3,"background":2221,"log_type":1,"src_id":140702002,"trial_step":2},{"step":3,"speaker":"イサン","content":"……あの後、彼女からは連絡あった？","voice":["vo_trial_40702_1_3"],"voice_bank":"vo_bianca_trial","style":1,"background":2221,"log_type":1,"src_id":140702003,"trial_step":3},{"step":4,"speaker":"モーガン","content":"ないね。辞職のお知らせが急に来ただけで。彼女がデスクに置いていたリンゴのカプセルトイの山を片付けたのも私。","voice":["vo_trial_40702_1_4"],"voice_bank":"vo_bianca_trial","style":1,"background":2221,"log_type":1,"src_id":140702004,"trial_step":4},{"step":5,"content":"二人は見つめ合って、ため息をついた。","style":3,"background":2221,"log_type":1,"src_id":140702005,"trial_step":5},{"step":6,"speaker":"モーガン","content":"ポジティブに考えよう。あのビアンカだ、大人しくしているはずがない。しばらくしたらニュースであいつの顔が見れるかもね……","voice":["vo_trial_40702_1_6"],"voice_bank":"vo_bianca_trial","style":1,"background":2221,"log_type":1,"src_id":140702006,"trial_step":6},{"step":7,"speaker":"ビアンカ","content":"ふふん～","voice":["vo_trial_40702_1_7"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702007,"trial_step":7},{"step":8,"speaker":"ビアンカ","content":"一人の記者が闇を暴いて～悪人を懲らしめるのはアタシだけ～記者になる理由を知った～","voice":["vo_trial_40702_1_8"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702008,"trial_step":8},{"step":9,"options":["待って……","少し休ませて……"],"style":6,"background":1019,"log_type":1,"src_id":140702009,"trial_step":9,"course":3,"choices":[{"text":"待って……","goto":10},{"text":"少し休ませて……","goto":null}]},{"step":10,"content":"キャーー！","style":3,"background":1019,"log_type":1,"src_id":140702010,"trial_step":10},{"step":11,"content":"目的地に近づくにつれ、あなたの体力も限界に近づいていく。","style":3,"background":1019,"log_type":1,"src_id":140702011,"trial_step":11},{"step":12,"speaker":"ビアンカ","content":"もう疲れちゃった？もう一踏ん張りだよ、あと少し——このままじゃスクープに逃げられちゃうよ？","voice":["vo_trial_40702_1_12"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702012,"trial_step":12},{"step":13,"content":"あなたは呼吸を整えつつ、ビアンカを観察する。彼女はいつものように軽薄で能天気で、足取りも軽く、鼻歌を口ずさむ余裕まである。","style":3,"background":1019,"log_type":1,"src_id":140702013,"trial_step":13},{"step":14,"options":["私たちの行動目標は忘れていないな？"],"style":6,"background":1019,"log_type":1,"src_id":140702014,"trial_step":14,"course":3,"choices":[{"text":"私たちの行動目標は忘れていないな？","goto":15}]},{"step":15,"speaker":"ビアンカ","content":"「目立たない、勝手に能力を使わない、単独行動しない！」","voice":["vo_trial_40702_1_15"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702015,"trial_step":15},{"step":16,"speaker":"ビアンカ","content":"工場に潜入し、闇に隠された真相を暴き、その情報を持ち帰り白日の下に晒す——うぅ、なんて格好いい響き！","voice":["vo_trial_40702_1_16"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702016,"trial_step":16},{"step":17,"speaker":"ビアンカ","content":"見て、着いたよ。ここがコエンに隠されたもう一つの工場。","voice":["vo_trial_40702_1_17"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702017,"trial_step":17},{"step":18,"content":"あなたは遠くにある工場を見上げた。高くそびえる工場の外壁は内部の建築物をほぼ全て隠している。大型機械の稼働音だけが微かに聞こえてくる。","style":3,"background":1019,"log_type":1,"src_id":140702018,"trial_step":18},{"step":19,"content":"外からは目立った排水管は見当たらない。各貨物用の出入口も厳重に警備に見張られていて、まるで堅牢な砦のようだ。","style":3,"background":1019,"log_type":1,"src_id":140702019,"trial_step":19},{"step":20,"options":["前回はどうやって入り込んだ？"],"style":6,"background":1019,"log_type":1,"src_id":140702020,"trial_step":20,"course":3,"choices":[{"text":"前回はどうやって入り込んだ？","goto":21}]},{"step":21,"speaker":"ビアンカ","content":"簡単だよ。あそこを見て。壁の下の辺りに小さな穴があるでしょ。一人ならなんとか通り抜けられる——","voice":["vo_trial_40702_1_21"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702021,"trial_step":21},{"step":22,"options":["……","他に方法は？"],"style":6,"background":1019,"log_type":1,"src_id":140702022,"trial_step":22,"course":3,"choices":[{"text":"……","goto":23},{"text":"他に方法は？","goto":null}]},{"step":23,"speaker":"ビアンカ","content":"なになに、そんな怒らないでって！冗談だよ冗談！このビアンカはニューシティ随一の記者だよ？独自のルートがあるに決まってるじゃない！","voice":["vo_trial_40702_1_23"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702023,"trial_step":23},{"step":24,"content":"例えば？","style":2,"background":1019,"log_type":1,"src_id":140702024,"trial_step":24},{"step":25,"speaker":"ビアンカ","content":"一番危険な場所こそ逆に安全だったりする。潜入だって同じ。相手の思考の盲点を突けば、向かうところ敵なしだよ！","voice":["vo_trial_40702_1_25"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702025,"trial_step":25},{"step":26,"speaker":"ビアンカ","content":"入るなら——正門から！","voice":["vo_trial_40702_1_26"],"voice_bank":"vo_bianca_trial","style":1,"background":1019,"log_type":1,"src_id":140702026,"trial_step":26},{"step":27,"content":"……","style":2,"background":922,"log_type":1,"src_id":140702027,"trial_step":27},{"step":28,"content":"狭い。ただでさえ狭い空間は中身不明の箱のせいで余計に窮屈さが増している。あなたとビアンカは狭い隙間に身を縮めるしかなかった。","style":3,"background":922,"log_type":1,"src_id":140702028,"trial_step":28},{"step":29,"content":"それだけではない。一定のリズムで箱が揺れている……そう、今入っている「コンテナ」は運ばれている真っ最中だ。","style":3,"background":922,"log_type":1,"src_id":140702029,"trial_step":29},{"step":30,"content":"……これが「正門から入る」ということなのか？","style":2,"background":922,"log_type":1,"src_id":140702030,"trial_step":30},{"step":31,"speaker":"ビアンカ","content":"えへへ……","voice":["vo_trial_40702_1_31"],"voice_bank":"vo_bianca_trial","style":1,"background":922,"log_type":1,"src_id":140702031,"trial_step":31},{"step":32,"speaker":"ビアンカ","content":"人がコンテナに入って、コンテナが正門に入る……間違ってないよね？","voice":["vo_trial_40702_1_32"],"voice_bank":"vo_bianca_trial","style":1,"background":922,"log_type":1,"src_id":140702032,"trial_step":32},{"step":33,"content":"振動が止まった。フォークリフトの音が聞こえ、そして一瞬浮くような感覚がする。輸送が終了し、コンテナがようやく地面に降ろされた。","style":3,"background":922,"log_type":1,"src_id":140702033,"trial_step":33},{"step":34,"speaker":"戸惑う作業員","content":"今日のブツはいつもより重いな。仕入先でも変えたか？","voice":["vo_trial_40702_1_34"],"voice_bank":"vo_bianca_trial","style":1,"background":922,"log_type":1,"src_id":140702034,"trial_step":34},{"step":35,"content":"声が近づいてくる。一人がコンテナをチェックしようとしたが、もう一人がそれを止める。","style":3,"background":922,"log_type":1,"src_id":140702035,"trial_step":35},{"step":36,"speaker":"気弱な作業員","content":"やめろって！さっさと運んでさっさと退勤しよう。こんな場所に長居したくないよ。","voice":["vo_trial_40702_1_36"],"voice_bank":"vo_bianca_trial","style":1,"background":922,"log_type":1,"src_id":140702036,"trial_step":36},{"step":37,"content":"二人は急いでこの場を去った。あなたは顔を壁に当てて耳を澄ませる。今は機械の稼働音しか聞こえない。","style":3,"background":922,"log_type":1,"src_id":140702037,"trial_step":37},{"step":38,"options":["もう行ったようだ"],"style":6,"background":922,"log_type":1,"src_id":140702038,"trial_step":38,"course":3,"choices":[{"text":"もう行ったようだ","goto":39}]},{"step":39,"content":"出ていこう。","style":2,"background":922,"log_type":1,"src_id":140702039,"trial_step":39},{"step":40,"speaker":"ビアンカ","content":"よし、再びこのビアンカの出番だね！ちょっと離れて！ついでに耳も塞いでね……そうそう、怪我しないように。","voice":["vo_trial_40702_1_40"],"voice_bank":"vo_bianca_trial","style":1,"background":922,"log_type":1,"src_id":140702040,"trial_step":40},{"step":41,"content":"暗闇の中、ビアンカの動きは見えない。彼女が何かを壁に当てるのが分かった。","style":3,"background":922,"log_type":1,"src_id":140702041,"trial_step":41},{"step":42,"content":"ドカン——！","style":3,"background":922,"log_type":1,"src_id":140702042,"trial_step":42},{"step":43,"speaker":"ビアンカ","content":"ヒャッハーー！潜入作戦大成功！","voice":["vo_trial_40702_1_43"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702043,"trial_step":43},{"step":44,"content":"つい先ほどまで無傷な箱は内側からの暴力によってこじ開けられた。振り向くと、ビアンカが凶器としていつものカメラを手にしていた。","style":3,"background":302,"log_type":1,"src_id":140702044,"trial_step":44},{"step":45,"content":"これが「勝手に能力を使わない」？","style":2,"background":302,"log_type":1,"src_id":140702045,"trial_step":45},{"step":46,"speaker":"ビアンカ","content":"あはは……別にスパイ映画じゃないからさ、臨機応変にやろうよ。ほら、吹き飛ばした方が何かと楽でしょ？大した音も立ててないし効率的だよ！","voice":["vo_trial_40702_1_46"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702046,"trial_step":46},{"step":47,"speaker":"ビアンカ","content":"もう、局長また怒ったの？説教なら調査が終わってからにしてね。","voice":["vo_trial_40702_1_47"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702047,"trial_step":47},{"step":48,"content":"ビアンカは先にコンテナから出て、ニコニコしながらあなたに手を差し伸べた。","style":1,"background":302,"log_type":1,"src_id":140702048,"trial_step":48},{"step":49,"options":["ビアンカの手を取る"],"style":6,"background":302,"log_type":1,"src_id":140702049,"trial_step":49,"course":3,"choices":[{"text":"ビアンカの手を取る","goto":50}]},{"step":50,"content":"そうだな、お説教は後にしよう。あと、さっきの音はうるさかった。警備員が来る前に調査を急ごう。","style":2,"background":302,"log_type":1,"src_id":140702050,"trial_step":50},{"step":51,"content":"警備員が一周回るのには30分ほどかかるだろう。調査の時間には余裕がある。怪しいところはじっくり調べられそうだ。","style":3,"background":302,"log_type":1,"src_id":140702051,"trial_step":51},{"step":52,"options":["調査を開始する"],"style":6,"background":302,"log_type":1,"src_id":140702052,"trial_step":52,"course":3,"choices":[{"text":"調査を開始する","goto":53}]},{"step":53,"content":"あなたは周囲を見渡した。この廃棄物処理工場の内部構造は思ったよりも単純だ。巨大な工作機械を除けば、隅に置かれたコンテナの山しかない。だだっ広い空間の中には、あなたとビアンカしかいないようだ。","style":3,"background":302,"log_type":1,"src_id":140702053,"trial_step":53},{"step":54,"content":"工場の中には見張りすらいない。ここの人員配置は異常だ。ほとんどの警備員は扉を見張っており、それ以外の作業員は誰もが分厚い防護服を着てただ物を運んでいる。","style":3,"background":302,"log_type":1,"src_id":140702054,"trial_step":54},{"step":55,"content":"あなたの予想通り、ここは錆の川とまだ距離があるため、狂瞳の濃度はそこまで高くない。だからあんなに分厚い防護服はいらないはずだ。","style":3,"background":302,"log_type":1,"src_id":140702055,"trial_step":55},{"step":56,"content":"どうして彼らは加工場に長居したくないのだろう。あれほど完璧な防護服を着ていながら、いったいどんな理由が？","style":2,"background":302,"log_type":1,"src_id":140702056,"trial_step":56},{"step":57,"content":"きっと他の何かが隠れている……ビアンカ、あそこを見てみよう。","style":2,"background":302,"log_type":1,"src_id":140702057,"trial_step":57},{"step":58,"content":"ビアンカ？","style":2,"background":302,"log_type":1,"src_id":140702058,"trial_step":58},{"step":59,"content":"振り向くと、ビアンカは先ほどのコンテナの横に立ち、何かを撮っているようだった。","style":3,"background":302,"log_type":1,"src_id":140702059,"trial_step":59},{"step":60,"speaker":"ビアンカ","content":"前に忍び込んだ時はじっくり見れなかった。何か光ってる感じがしたと思ったら、やっぱり……","voice":["vo_trial_40702_1_60"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702060,"trial_step":60},{"step":61,"content":"ビアンカは真顔でこちらを向いた。","style":3,"background":302,"log_type":1,"src_id":140702061,"trial_step":61},{"step":62,"speaker":"ビアンカ","content":"コンテナの中身は、<color=#fb9259>銃</color>だよ。","voice":["vo_trial_40702_1_62"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702062,"trial_step":62},{"step":63,"options":["！？"],"style":6,"background":302,"log_type":1,"src_id":140702063,"trial_step":63,"course":3,"choices":[{"text":"！？","goto":64}]},{"step":64,"speaker":"ビアンカ","content":"厳密に言えば、銃の部品。銃器には詳しくないけど、弾倉が改造されてることくらいは分かる。使ってる銃弾も通常の火薬のそれじゃないみたい。","voice":["vo_trial_40702_1_64"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702064,"trial_step":64},{"step":65,"speaker":"ビアンカ","content":"……ふふっ、なるほど。道理でこんな危険な場所に工場を隠してるんだ。これが治安局にバレたらタダじゃ済まないよね。","voice":["vo_trial_40702_1_65"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702065,"trial_step":65},{"step":66,"speaker":"ビアンカ","content":"何が廃棄物処理工場だ、違法な武器の製造工場だよ、ここは！","voice":["vo_trial_40702_1_66"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702066,"trial_step":66},{"step":67,"speaker":"ビアンカ","content":"怪しいのはそれだけじゃないよ。正体不明の加工物に違法武器の部品、あまりに奇妙な立地……錆の川の狂瞳濃度が高く、ここは武器の取引に向いてない。","voice":["vo_trial_40702_1_67"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702067,"trial_step":67},{"step":68,"options":["他にも目的があるかもしれない"],"style":6,"background":302,"log_type":1,"src_id":140702068,"trial_step":68,"course":3,"choices":[{"text":"他にも目的があるかもしれない","goto":69}]},{"step":69,"content":"錆の川に何かを求めているのか？とはいえ、狂瞳以外ここには汚染された——","style":2,"background":302,"log_type":1,"src_id":140702069,"trial_step":69},{"step":70,"content":"あなたは口を閉じた。ビアンカはあなたと見つめ合い、目を光らせる。","style":3,"background":302,"log_type":1,"src_id":140702070,"trial_step":70},{"step":71,"speaker":"ビアンカ","content":"生産ラインを見に行こう！証拠はきっとそこにある！","voice":["vo_trial_40702_1_71"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702071,"trial_step":71},{"step":72,"content":"ビアンカはあなたを引っ張ったまま飛び出して、加工機械の傍まで走った。機械の稼働音は轟々と響き渡り、無数の部品はここで殺傷能力を持つ真の武器に組み立てられていく。","style":3,"background":302,"log_type":1,"src_id":140702072,"trial_step":72},{"step":73,"content":"カメラはこの工場の真実を記録した。銃の装填に使うガラスの管に、吐き気を催すような真紅の液が注がれている。狂瞳から抽出した液体だ。","style":3,"background":302,"log_type":1,"src_id":140702073,"trial_step":73},{"step":74,"speaker":"ビアンカ","content":"……グレーちゃん、これは大スクープだよ。","voice":["vo_trial_40702_1_74"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702074,"trial_step":74},{"step":75,"speaker":"ビアンカ","content":"コイツらが作っているのは、狂瞳関連の武器だ。","voice":["vo_trial_40702_1_75"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702075,"trial_step":75},{"step":76,"speaker":"警備員","content":"——おい！そこに誰かいるのか！","voice":["vo_trial_40702_1_76"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702076,"trial_step":76},{"step":77,"content":"懐中電灯の光が急に室内に差し込んだ。警備員が訝しげな顔で近づいてくる。","style":3,"background":302,"log_type":1,"src_id":140702077,"trial_step":77},{"step":78,"speaker":"警備員","content":"変だな。人が喋っている声が聞こえたんだが。気のせいか？","voice":["vo_trial_40702_1_78"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702078,"trial_step":78},{"step":79,"content":"電灯の光がコンテナから工作機械へ向けられる。あなたとビアンカは身体を縮めて光の届かない影の中に潜み、じっとしていた。","style":3,"background":302,"log_type":1,"src_id":140702079,"trial_step":79},{"step":80,"content":"警備員はまだ傍にいる。二人はジェスチャーと唇の動きを読むことで辛うじてどうにかお互いの思考を読み取る。","style":3,"background":302,"log_type":1,"src_id":140702080,"trial_step":80},{"step":81,"speaker":"ビアンカ","content":"（誰かが来た！どうするの！）","voice":["vo_trial_40702_1_81"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702081,"trial_step":81},{"step":82,"content":"足音が近づいてくる。光も自分たちの隠れる影を照らそうとしている。","style":3,"background":302,"log_type":1,"src_id":140702082,"trial_step":82},{"step":83,"content":"（もう逃げ道はない。調査が失敗すればやぶ蛇だ）","style":2,"background":302,"log_type":1,"src_id":140702083,"trial_step":83},{"step":84,"content":"（何としても証拠を持ち帰らないと）","style":2,"background":302,"log_type":1,"src_id":140702084,"trial_step":84},{"step":85,"speaker":"ビアンカ","content":"（何とって……何を？出るの？今から？）","voice":["vo_trial_40702_1_85"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702085,"trial_step":85},{"step":86,"content":"（証拠を、持ち帰る、だ）","style":2,"background":302,"log_type":1,"src_id":140702086,"trial_step":86},{"step":87,"speaker":"ビアンカ","content":"（今から、帰る？分かった！スリーカウントしたら走るね、3、2——）","voice":["vo_trial_40702_1_87"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702087,"trial_step":87},{"step":88,"content":"（待ってくれ！）","style":2,"background":302,"log_type":1,"src_id":140702088,"trial_step":88},{"step":89,"speaker":"ビアンカ","content":"1！逃げるよ！","voice":["vo_trial_40702_1_89"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702089,"trial_step":89},{"step":90,"content":"ビアンカはあなたを掴んで猛ダッシュで飛び出し、警備員が気づくよりも早く出口まで走った。","style":3,"background":302,"log_type":1,"src_id":140702090,"trial_step":90},{"step":91,"speaker":"警備員","content":"なんだ！？侵入者だ！扉だ、扉を閉じろ！！","voice":["vo_trial_40702_1_91"],"voice_bank":"vo_bianca_trial","style":1,"background":302,"log_type":1,"src_id":140702091,"trial_step":91},{"step":92,"content":"鉄製の大扉がゆっくりと閉じていく。懸命に走るが、扉が閉じきる前に外に出ることはできなかった。","style":3,"background":302,"log_type":1,"src_id":140702092,"trial_step":92},{"step":93,"options":["ビアンカ、吹き飛ばせ！"],"style":6,"background":302,"log_type":1,"s