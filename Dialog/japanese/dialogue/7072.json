{"id":7072,"chapter_id":7,"scene_id":708,"steps":[{"step":1,"content":"ぬいぐるみたちは倒れても、その燃える身体を引きずり、ハーメルの幻影に向かって這い進んでいく。","style":3,"background":704,"log_type":1},{"step":2,"speaker":"ぬいぐるみたち","content":"ハーメル……ハーメル……","voice":["vo_cgplot_7082002"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":3,"speaker":"ぬいぐるみたち","content":"うああぁぁ——ハーメル——助けて——！","voice":["vo_cgplot_7082003"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":4,"speaker":"ハーメルの幻影","content":"もちろんですよ。わたしを愛してくれるなら……ずっと、愛してくれますよね？","voice":["vo_cgplot_7082004"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":5,"content":"ハーメルが手を広げると、黒い炎が手のひらから溢れ出した。周りのぬいぐるみたちが黒く染まり、彼女に侵蝕されていく。","style":3,"background":704,"log_type":1},{"step":6,"speaker":"ハーメルの幻影","content":"あなたは？","voice":["vo_cgplot_7082006"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":7,"content":"ハーメルは不気味な笑顔を浮かべ、あなたに振り向く。","style":3,"background":704,"log_type":1},{"step":8,"speaker":"ハーメルの幻影","content":"素敵なショーでしょう？気に入りますか？","voice":["vo_cgplot_7082008"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":9,"speaker":"選択肢","options":["お前は一体誰だ！？"],"jump":[10],"style":6,"background":704,"log_type":1},{"step":10,"content":"彼女は無邪気に狂ったような笑い声を上げた。","style":3,"background":704,"log_type":1},{"step":11,"speaker":"ハーメルの幻影","content":"あはははっ……わたしはハーメルですよ、あなたたちが大好きな<size=44>ハーメル</size>～！","voice":["vo_cgplot_7082011"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":12,"content":"彼女の手の中の黒い炎が暴走し、瞬く間に周囲に広がっていく。パレードや遊園地を飲み込みつつ、あなたに襲いかかった！","style":3,"background":704,"log_type":1},{"step":13,"speaker":"？？？","content":"もうやめて。","voice":["vo_cgplot_7082013"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1},{"step":15,"content":"その時、背の高い傀儡があなたたちの前に現れ、黒い炎を掻き消した。","style":3,"background":704,"log_type":1},{"step":16,"speaker":"ハーメルの幻影","content":"あなたなの？","voice":["vo_cgplot_7082015"],"voice_bank":"vo_cgplot_07","style":1,"background":704,"log_type":1}]}