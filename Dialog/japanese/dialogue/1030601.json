rc_id":130601070,"trial_step":70,"drawing":1030600},{"step":75,"content":"報告書の内容を一瞥すると、エンジェルははっきりと返事をした。","style":3,"log_type":1,"src_id":130601071,"trial_step":71,"drawing":1030600},{"step":76,"speaker":"エンジェル","content":"いいだろう。","voice":["vo_trial_30601_1_72"],"voice_bank":"vo_angel_trial","style":1,"log_type":1,"src_id":130601072,"trial_step":72,"drawing":1030600},{"step":77,"content":"よし、では始めよう。まずは事件の背景からだ。","style":2,"log_type":1,"src_id":130601073,"trial_step":73,"drawing":1030600},{"step":78,"content":"西区の再建に伴い、マフィアどもの居場所が狭くなったため、彼らは何者かが設立した得体の知れないダークウェブに逃げ込んだ。","style":2,"log_type":1,"src_id":130601074,"trial_step":74,"drawing":1030600},{"step":79,"content":"そして、その匿名性と煩雑性を利用して、私を含む西区の要人に対して一連の襲撃を仕掛けたが、政府機関は迅速に反撃することができなかった。","style":2,"log_type":1,"src_id":130601075,"trial_step":75,"drawing":1030600},{"step":80,"speaker":"エンジェル","content":"……","voice":["vo_trial_30601_1_76"],"voice_bank":"vo_angel_trial","style":1,"log_type":1,"src_id":130601076,"trial_step":76,"drawing":1030601},{"step":81,"content":"エンジェルは目を細めて、何か言いたげな顔をしたが、結局言葉を飲み込み、あなたの次の言葉を待つことにした。","style":3,"log_type":1,"src_id":130601077,"trial_step":77,"drawing":1030601},{"step":82,"content":"これが私たちが最初に行った分析だ。だが行動を続けるうちに、ある重要な勢力を忘れていたことに気づいた——","style":2,"log_type":1,"src_id":130601078,"trial_step":78,"drawing":1030600},{"step":83,"content":"ダークウェブの深層に隠れている黒幕だ。","style":2,"log_type":1,"src_id":130601079,"trial_step":79,"drawing":1030600},{"step":84,"content":"エンジェルは軽く首を縦に振り、あなたの話に賛同した。","style":3,"log_type":1,"src_id":130601080,"trial_step":80,"drawing":1030600},{"step":85,"content":"この前言われたように、私たちのような者が接触できるのはダークウェブの表層だけだ。だから自分が拉致された間にあなたのアカウントを利用して秘密裏に準備した政府機関の反撃は、全ての敵を一掃したと思い込んでしまった。","style":2,"log_type":1,"src_id":130601081,"trial_step":81,"drawing":1030600},{"step":86,"content":"だがあなたは深層の存在を、そこに更に隠された勢力がいることを示してくれた。真のマフィアのリーダーと、新しい採掘地によって利益が減少したイレギュラーキューブの利益集団がいることをな。","style":2,"log_type":1,"src_id":130601082,"trial_step":82,"drawing":1030600},{"step":87,"content":"この前捕まえたのは雑魚にすぎない。彼らこそが本物の黒幕と出資者だ。","style":2,"log_type":1,"src_id":130601083,"trial_step":83,"drawing":1030600},{"step":88,"content":"深層に隠れている首謀者に気づかなかったせいで彼らを逃すところだった。あなたが陰で手伝ってくれなければ、事件は解決できなかっただろう。","style":2,"log_type":1,"src_id":130601084,"trial_step":84,"drawing":1030600},{"step":89,"speaker":"エンジェル","content":"……","voice":["vo_trial_30601_1_85"],"voice_bank":"vo_angel_trial","style":1,"log_type":1,"src_id":130601085,"trial_step":85,"drawing":1030603},{"step":90,"content":"エンジェルは目を光らせた。","style":3,"log_type":1,"src_id":130601086,"trial_step":86,"drawing":1030603},{"step":91,"content":"あなたは報告書を数ページめくると、「合同作戦」の部分を指差した。","style":3,"log_type":1,"src_id":130601087,"trial_step":87,"drawing":1030603},{"step":92,"content":"あなたは当時ダークウェブの深層で、局長が欲しいなら入札しろという情報を拡散した。だが、本当の目的は私を高く売ることではなかったはずだ。","style":2,"log_type":1,"src_id":130601088,"trial_step":88,"drawing":1030603},{"step":93,"content":"今更隠すような話でもない。エンジェルは堂々と頷いた。","style":3,"log_type":1,"src_id":130601089,"trial_step":89,"drawing":1030600},{"step":94,"speaker":"エンジェル","content":"そうだ。お前の情報を拡散したのは罠を仕掛けるためだ。","voice":["vo_trial_30601_1_90"],"voice_bank":"vo_angel_trial","style":1,"log_type":1,"src_id":130601090,"trial_step":90,"drawing":1030600},{"step":95,"speaker":"エンジェル","content":"あの連中はお前を殺すことに執着していたから、その情報を受けてすぐに取り乱した。奴らはお前を取り逃すまいと慌てたが、情報はあまりに急で、十分な準備をする時間がなかった。だから慌てて暗殺者を再度募集したんだ。","voice":["vo_trial_30601_1_91"],"voice_bank":"vo_angel_trial","style":1,"log_type":1,"src_id":130601091,"trial_step":91,"drawing":1030600},{"step":96,"speaker":"エンジェル","content":"その行動はあまりに軽率で、多くの隙が生まれた。最終的にはお前たちに事件を解決するチャンスを与えてしまった。","voice":["vo_trial_30601_1_92"],"voice_bank":"vo_angel_trial","style":1,"log_type":1,"src_id":130601092,"trial_step":92,"drawing":1030600},{"step":97,"content":"あなたは笑いながら頷いた。","style":3,"log_type":1,"src_id":130601093,"trial_step":93,"drawing":1030600},{"step":98,"content":"それに、あなたが助けてくれたのは今回だけではない。","style":2,"log_type":1,"src_id":130601094,"trial_step":94,"drawing":1030600},{"step":99,"content":"少し驚いたエンジェルはあなたを見て、困惑する表情を浮かべた。","styl