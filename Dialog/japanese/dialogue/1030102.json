pe":1,"src_id":130102214,"trial_step":214},{"step":214,"content":"だがすでに手遅れだ。他の護衛たちはとっくに態勢を整え、行く手を阻んでいる。","style":3,"background":120,"log_type":1,"src_id":130102215,"trial_step":215},{"step":215,"speaker":"澈","content":"ふっ……対応が早いじゃねえか。","voice":["vo_trial_30102_1_216"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102216,"trial_step":216},{"step":216,"speaker":"K.K.","content":"いつもの？","voice":["vo_trial_30102_1_217"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102217,"trial_step":217},{"step":217,"speaker":"澈","content":"お好きに。","voice":["vo_trial_30102_1_218"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102218,"trial_step":218},{"step":218,"content":"二人はじゃんけんをして——案の定、K.K.が負ける。","style":3,"background":120,"log_type":1,"src_id":130102219,"trial_step":219},{"step":219,"speaker":"K.K.","content":"なんで一回も勝てないんだ……","voice":["vo_trial_30102_1_220"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102220,"trial_step":220},{"step":220,"speaker":"澈","content":"最初にグーを出すのをやめたら？","voice":["vo_trial_30102_1_221"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102221,"trial_step":221},{"step":221,"speaker":"K.K.","content":"……","voice":["vo_trial_30102_1_222"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102222,"trial_step":222},{"step":222,"content":"押し寄せる人混みを前にして、K.K.はトンファーを握りしめる。","style":3,"background":120,"log_type":1,"src_id":130102223,"trial_step":223},{"step":223,"speaker":"K.K.","content":"まあいい。別に変わらない。","voice":["vo_trial_30102_1_224"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130102224,"trial_step":224},{"step":224,"content":"明らかに彼女はここを一人で守り切るつもりだ。","style":3,"background":120,"log_type":1,"src_id":130102225,"trial_step":225},{"step":225,"content":"行動部門にはすでに知らせた。増援が来るまで持ち堪えることさえできれば……","style":2,"background":1