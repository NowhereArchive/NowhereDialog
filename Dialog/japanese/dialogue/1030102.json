":1,"background":1019,"log_type":1,"src_id":130102089,"trial_step":89},{"step":90,"speaker":"護衛","content":"コホン、ヒョウさんか、思い出したぞ。それならはやく言ってくれよ——ヒョウさんは来ていないのか？","voice":["vo_trial_30102_1_90"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102090,"trial_step":90},{"step":91,"speaker":"澈","content":"もう本当にそれっすよ。昨日打ち上げに付き合わせられたんすけど、お客さんは平気なのに、ヒョウさんだけ二日酔いっすよ。","voice":["vo_trial_30102_1_91"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102091,"trial_step":91},{"step":92,"speaker":"澈","content":"だから俺みたいな新入りが来るしかなかったんすよ。","voice":["vo_trial_30102_1_92"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102092,"trial_step":92},{"step":93,"speaker":"護衛","content":"お客さんは？お前一人か？","voice":["vo_trial_30102_1_93"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102093,"trial_step":93},{"step":94,"speaker":"澈","content":"だから兄さんたちに話を通しておこうと思って。お客さんが来るときに入れなかったら、この商売が台無しじゃないっすか。","voice":["vo_trial_30102_1_94"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102094,"trial_step":94},{"step":95,"content":"護衛たちは視線を合わせ、表情を緩めた。","style":3,"background":1019,"log_type":1,"src_id":130102095,"trial_step":95},{"step":96,"speaker":"護衛","content":"ヒョウさん本当に酒好きだな。身体壊したらどうするんだ？","voice":["vo_trial_30102_1_96"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102096,"trial_step":96},{"step":97,"speaker":"澈","content":"そりゃヒョウさんこれしか趣味がないっすから。酒に金を使いすぎて俺らの給料も降ろせないところだったんすよ。","voice":["vo_trial_30102_1_97"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102097,"trial_step":97},{"step":98,"speaker":"澈","content":"テスト1","voice":["vo_trial_30102_1_98"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102098,"trial_step":98},{"step":99,"speaker":"護衛","content":"じゃあ転職でもしたらどうだ？","voice":["vo_trial_30102_1_99"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102099,"trial_step":99},{"step":100,"speaker":"澈","content":"いやぁ……このご時世じゃあ。食肉目もなくなったし……かろうじて飯が食えるだけ上出来っすよ。","voice":["vo_trial_30102_1_100"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102100,"trial_step":100},{"step":101,"speaker":"護衛","content":"全くだ……世知辛ぇな。","voice":["vo_trial_30102_1_101"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102101,"trial_step":101},{"step":102,"speaker":"護衛の手下A","content":"お偉いさんたちは俺らの生死なんて知ったこっちゃない。シンジケートの何処にまともなボスがいるってんだ。","voice":["vo_trial_30102_1_102"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102102,"trial_step":102},{"step":103,"content":"もう一人の護衛が口を挟む。","style":3,"background":1019,"log_type":1,"src_id":130102103,"trial_step":103},{"step":104,"speaker":"護衛の手下A","content":"俺らのボスもそうだ。どっかから狂瞳武器を仕入れて、こんなご時世に隠す気もさらさらない。もういつバレたっておかしくねぇよ。","voice":["vo_trial_30102_1_104"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102104,"trial_step":104},{"step":105,"speaker":"護衛の手下B","content":"全くその通りだ。俺は毎日FACにビビって夜も寝れないよ。うちのハク社長は絶対よそから来た奴だろうな……","voice":["vo_trial_30102_1_105"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102105,"trial_step":105},{"step":106,"speaker":"護衛の手下B","content":"金払いが良いだけマシだな。じゃなきゃとっくにやらないぞ。","voice":["vo_trial_30102_1_106"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102106,"trial_step":106},{"step":107,"speaker":"護衛","content":"おい——","voice":["vo_trial_30102_1_107"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102107,"trial_step":107},{"step":108,"content":"さすがに言いすぎだと思ったのか、護衛のリーダーが注意をする。","style":3,"background":1019,"log_type":1,"src_id":130102108,"trial_step":108},{"step":109,"speaker":"護衛","content":"ヒョウさんとこの奴ならいいか。お客さんに来ていいと伝えてくれ。同行者は三人まで、時間は明日朝までだ。","voice":["vo_trial_30102_1_109"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102109,"trial_step":109},{"step":110,"speaker":"澈","content":"三人だけっすか？","voice":["vo_trial_30102_1_110"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102110,"trial_step":110},{"step":111,"speaker":"護衛","content":"非常時だからな。前々から色んな奴にウチのブツが狙われているんだ。","voice":["vo_trial_30102_1_111"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102111,"trial_step":111},{"step":112,"speaker":"護衛","content":"安心しろ、ウチの白記事務所はちゃんとした会社だ。脅しとかボッタクリみたいな真似はしない。","voice":["vo_trial_30102_1_112"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102112,"trial_step":112},{"step":113,"speaker":"澈","content":"……分かりました。じゃ兄さんたちの言った通り、お客さんを呼んで来ますね。","voice":["vo_trial_30102_1_113"],"voice_bank":"vo_linglan_trial","style":1,"background":1019,"log_type":1,"src_id":130102113,"trial_step":113},{"step":114,"speaker":"K.K.","content":"話しただけで通してくれるようになったのか？","voice":["vo_trial_30102_1_114"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130102114,"trial_step":114},{"step":115,"speaker":"澈","content":"そりゃそうさ。奴らも一応商売をやってるんだぜ。疑いすぎると客が来なくなる。","voice":["vo_trial_30102_1_115"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130102115,"trial_step":115},{"step":116,"speaker":"K.K.","content":"……ハクイツが言ったように、本当に寝返ったわけじゃないよな？","voice":["vo_trial_30102_1_116"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130102116,"trial_step":116},{"step":117,"speaker":"澈","content":"なに言ってんだ……","voice":["vo_trial_30102_1_117"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130102117,"trial_step":117},{"step":118,"speaker":"澈","content":"つまりこういうことだ。人が多すぎれば入れない。少なければ当然危険はある。後は自分で決めてくれ。","voice":["vo_trial_30102_1_118"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130102118,"trial_step":118},{"step":119,"content":"あなたはどう思う？","style":2,"background":1008,"log_type":1,"src_id":130102119,"trial_step":119},{"step":120,"speaker":"澈","content":"俺？入ってみるのもいいと思うぞ。狂瞳武器の取引なんてやる連中が人質をとって身代金を請求するなんて効率の悪い真似はしないだろ。","voice":["vo_trial_30102_1_120"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130102120,"trial_step":120},{"step":121,"content":"K.K.は？","style":2,"background":1008,"log_type":1,"src_id":130102121,"trial_step":121},{"step":122,"speaker":"K.K.","content":"私の考えは変わらない。強行突破して敵を警戒させたらまずい。ここら辺の地形は複雑だから、敵を逃がしやすいしな。","voice":["vo_trial_30102_1_122"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130102122,"trial_step":122},{"step":123,"options":["ビルに入る"],"style":6,"background":1008,"log_type":1,"src_id":130102123,"trial_step":123,"course":3,"choices":[{"text":"ビルに入る","goto":124}]},{"step":124,"content":"それなら、私たちだけで入ってみるとしよう。","style":2,"background":1008,"log_type":1,"src_id":130102124,"trial_step":124},{"step":125,"content":"あなたたち三人は護衛に「守られて」ビルに入った。","style":3,"background":10000,"log_type":1,"src_id":130102125,"trial_step":125},{"step":126,"speaker":"護衛","content":"すまないが、ウチのボスはちょっと用事がある。面会まで少し待ってくれ。","voice":["vo_trial_30102_1_126"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102126,"trial_step":126},{"step":127,"options":["護衛に案内を頼む"],"style":6,"background":10000,"log_type":1,"src_id":130102127,"trial_step":127,"course":3,"choices":[{"text":"護衛に案内を頼む","goto":128}]},{"step":128,"speaker":"護衛","content":"構わないぞ。どこが見たい？","voice":["vo_trial_30102_1_128"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102128,"trial_step":128},{"step":129,"content":"護衛に案内してもらい、「白記事務所」の会議室、社宅、オフィスエリアを見せてもらった。何処もそれなりに立派で、ニューシティのそこら辺の会社よりもしっかりしている。","style":3,"background":1045,"log_type":1,"src_id":130102129,"trial_step":129},{"step":130,"content":"シンジケートで狂瞳武器を売り捌くような組織が、正規の会社と同様の設備を全て揃えているのだ。","style":3,"background":1045,"log_type":1,"src_id":130102130,"trial_step":130},{"step":131,"speaker":"澈","content":"わおっ、本当にご立派っすね。柳生のビルよりもちゃんとしてるじゃないっすか。","voice":["vo_trial_30102_1_131"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130102131,"trial_step":131},{"step":132,"speaker":"護衛","content":"いろいろ手を回したからな。あのハク社長はニューシティから来たって聞いてるぜ。","voice":["vo_trial_30102_1_132"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130102132,"trial_step":132},{"step":133,"speaker":"護衛","content":"このブツだけが本物で、他のはただの飾りさ。","voice":["vo_trial_30102_1_133"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130102133,"trial_step":133},{"step":134,"content":"護衛の言う通り、ビルの中で一番目立つのは、彼らが手にしている狂瞳武器だ。","style":3,"background":1045,"log_type":1,"src_id":130102134,"trial_step":134},{"step":135,"speaker":"護衛","content":"ここは休憩室、更に外にはゲストルーム。ウチのボスはまだ取り込み中なんで、そこで待っててくれないか？","voice":["vo_trial_30102_1_135"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130102135,"trial_step":135},{"step":136,"content":"護衛がそう言った時、澈があなたに目配せをした。","style":3,"background":1045,"log_type":1,"src_id":130102136,"trial_step":136},{"step":137,"options":["トイレはどこにある？"],"style":6,"background":1045,"log_type":1,"src_id":130102137,"trial_step":137,"course":3,"choices":[{"text":"トイレはどこにある？","goto":138}]},{"step":138,"speaker":"護衛","content":"トイレか。そこを出て右だ。","voice":["vo_trial_30102_1_138"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130102138,"trial_step":138},{"step":139,"content":"そうか。なら失礼する。","style":2,"background":1045,"log_type":1,"src_id":130102139,"trial_step":139},{"step":140,"speaker":"護衛","content":"お前、昨日あのヒョウさんとやらと酒飲みで勝ったらしいな？ヒョロガリに見えて案外やるじゃないか。","voice":["vo_trial_30102_1_140"],"voice_bank":"vo_linglan_trial","style":1,"background":1045,"log_type":1,"src_id":130102140,"trial_step":140},{"step":141,"content":"調子が良かっただけだ……私も危なかったよ。","style":2,"background":1045,"log_ty