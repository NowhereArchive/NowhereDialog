":100,"log_type":1,"src_id":130102250,"trial_step":250},{"step":250,"speaker":"護衛","content":"追え！","voice":["vo_trial_30102_1_251"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102251,"trial_step":251},{"step":251,"content":"ビルを脱出してひたすら逃げるが、それでも追手を撒くことはできない。","style":3,"background":100,"log_type":1,"src_id":130102252,"trial_step":252},{"step":252,"speaker":"護衛","content":"止まれ！","voice":["vo_trial_30102_1_253"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102253,"trial_step":253},{"step":253,"speaker":"護衛","content":"よく走れるじゃねぇか、このヒョロガリ……","voice":["vo_trial_30102_1_254"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102254,"trial_step":254},{"step":254,"speaker":"護衛","content":"撃て！逃すな！奴は政府の人間だ！","voice":["vo_trial_30102_1_255","vo_trial_30102_1_255f"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102255,"trial_step":255},{"step":255,"content":"銃弾があなたのすぐ傍を掠めていく。それでもあなたは足を止めない。","voice":["vo_trial_30102_1_256"],"voice_bank":"vo_linglan_trial","style":3,"background":100,"log_type":1,"src_id":130102256,"trial_step":256},{"step":256,"speaker":"護衛","content":"××雑魚エイムが。","voice":["vo_trial_30102_1_257"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102257,"trial_step":257},{"step":257,"speaker":"護衛","content":"じゃあお前がやれよ！","voice":["vo_trial_30102_1_258"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102258,"trial_step":258},{"step":258,"speaker":"護衛","content":"黙れ！はやく仕留めろ！","voice":["vo_trial_30102_1_259","vo_trial_30102_1_259f"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102259,"trial_step":259},{"step":259,"speaker":"護衛","content":"待て、なんの音だ？","voice":["vo_trial_30102_1_260"],"voice_bank":"vo_linglan_trial","style":1,"background":100,"log_type":1,"src_id":130102260,"trial_step":260},{"step":260,"content":"あ