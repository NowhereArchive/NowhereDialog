al_step":155},{"step":155,"speaker":"澈","content":"なんでこんなところに……次入る時には先に声を掛けてくれ。","voice":["vo_trial_30102_1_156"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102156,"trial_step":156},{"step":156,"content":"K.K.は少し気まずそうな表情をしている。","style":3,"background":10000,"log_type":1,"src_id":130102157,"trial_step":157},{"step":157,"speaker":"K.K.","content":"水を飲みすぎて……女子トイレの下水道が詰まってたんだ……","voice":["vo_trial_30102_1_158"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102158,"trial_step":158},{"step":158,"speaker":"澈","content":"ちっ、はやく済ませろ。","voice":["vo_trial_30102_1_159"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102159,"trial_step":159},{"step":159,"content":"K.K.も黙ったまま個室を開けて入った。","style":3,"background":10000,"log_type":1,"src_id":130102160,"trial_step":160},{"step":160,"speaker":"K.K.","content":"……鍵がない。","voice":["vo_trial_30102_1_161"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102161,"trial_step":161},{"step":161,"speaker":"澈","content":"外はサマになっているのに、こういうとこは手を抜いてるな。","voice":["vo_trial_30102_1_162"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102162,"trial_step":162},{"step":162,"speaker":"澈","content":"安心しろ、見張っててやるから。","voice":["vo_trial_30102_1_163"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102163,"trial_step":163},{"step":163,"content":"あなたたちは扉の前で待機する。突然、変な臭いが漂ってきた。","style":3,"background":10000,"log_type":1,"src_id":130102164,"trial_step":164},{"step":164,"speaker":"澈","content":"腐った玉ネギみたいな匂いだ……K.K.、昨日なに食った？","voice":["vo_trial_30102_1_165"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102165,"trial_step":165},{"step":165,"speaker":"澈","content":"つーか待てよ、デカイ方かよ？","voice":["vo_trial_30102_1_166"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102166,"trial_step":166},{"step":166,"speaker":"K.K.","content":"違う！私じゃない！","voice":["vo_trial_30102_1_167"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102167,"trial_step":167},{"step":167,"content":"個室からK.K.の怒り気味の声が聞こえる。それに続くのは水を流す音。","style":3,"background":10000,"log_type":1,"src_id":130102168,"trial_step":168},{"step":168,"speaker":"澈","content":"じゃあなんの臭いだ？局長じゃないよな？","voice":["vo_trial_30102_1_169"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102169,"trial_step":169},{"step":169,"content":"K.K.は顔を歪ませながら個室から出てきた。どうやら奥の方が臭いも強い。","style":3,"background":10000,"log_type":1,"src_id":130102170,"trial_step":170},{"step":170,"speaker":"K.K.","content":"なら澈だろ。","voice":["vo_trial_30102_1_171"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102171,"trial_step":171},{"step":171,"speaker":"澈","content":"ちっ、お前なら俺のこと分かってるだろ。自分がやったなら認めてるぞ。","voice":["vo_trial_30102_1_172"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102172,"trial_step":172},{"step":172,"content":"なら可能性は一つだ……","style":2,"background":10000,"log_type":1,"src_id":130102173,"trial_step":173},{"step":173,"content":"三人の視線は同じ方向——残り最後の個室に向けられる。","style":3,"background":10000,"log_type":1,"src_id":130102174,"trial_step":174},{"step":174,"speaker":"澈","content":"嘘……だろう、中に人が？","voice":["vo_trial_30102_1_175"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102175,"trial_step":175},{"step":175,"speaker":"K.K.","content":"事前に見なかったのか？","voice":["vo_trial_30102_1_176"],"voice_bank":"vo_linglan_trial","style":1,"background":10000,"log_type":1,"src_id":130102176,"trial_step":176},{"step":176,"content":"見ていない……","style":2,"background":10000,"log_type":1,"src_id":130102177,"trial_step":177},{"step":177,"speaker":"K.K.","content":"さっき言ったこと全部聞かれたんじゃないか？","voice":["vo_trial_30102_1_178"],"voice_bank":"vo_linglan_trial","style":1,"backg