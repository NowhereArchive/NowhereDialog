{"id":401701501,"chapter_id":21000103,"scene_id":305,"steps":[{"step":1,"content":"昨日至近距離でメカを観察して以来、あなたはメカ製造の進捗により関心を寄せるようになった。","style":3,"background":2176,"log_type":1},{"step":2,"content":"この辺りの比較的安全なエリアは全部探索済みだが、物資はまだまだ足りない。近くの作業台で仕事に励むヴァニラを見て、今度こそ新しいエリアを探索しようとあなたは心を決めた。","style":3,"background":2176,"log_type":1},{"step":3,"options":["いってくる"],"jump":[4],"style":6,"background":2176,"log_type":1},{"step":4,"content":"ヴァニラは手を振って別れの挨拶をする。","style":3,"background":2176,"log_type":1},{"step":5,"speaker":"ヴァニラ","content":"ああ、いってこい。","voice":["vo_event_401701501_5"],"voice_bank":"vo_event_17015","style":1,"background":2176,"log_type":1},{"step":6,"content":"ヴァニラが顔を上げて、温かい笑顔を見せてくれた。","style":3,"background":2176,"log_type":1}]}