{"id":401100262,"chapter_id":50027,"scene_id":52713,"steps":[{"step":1,"speaker":"クリスティナ","content":"コホンコホン……まだ汚染のトラップがあるなんて……","voice":["vo_event_401102602_1"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":2,"speaker":"クリスティナ","content":"FACの装備に反狂瞳病装置があって本当によかった。イレギュラーキューブが尽きる前に早く出ないと。","voice":["vo_event_401102602_2"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":3,"speaker":"クリスティナ","content":"この車はいったいどこに向かってるんだろう。さっきは時間をかけ過ぎたから、急がなきゃ——","voice":["vo_event_401102602_3"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":4,"content":"昏睡状態の司令官を引きずってここから出ようと試みたが、司令官の身体に恐ろしい装置がつけられていることに気づいた。","style":3,"background":922,"log_type":1},{"step":5,"speaker":"クリスティナ","content":"これは……汚染爆弾？","voice":["vo_event_401102602_5"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":6,"content":"その時、闇の向こう側から電波に乗った音が聞こえた。","style":3,"background":922,"log_type":1},{"step":7,"speaker":"クリスティナ","content":"！？","voice":["vo_event_401102602_7"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":8,"speaker":"クリスティナ","content":"車内……通信機？","voice":["vo_event_401102602_8"],"voice_bank":"vo_event_11026","style":1,"background":922,"log_type":1},{"step":9,"content":"通信機の向こうから、聞き覚えのある声が聞こえた。","style":3,"background":922,"log_type":1},{"step":10,"speaker":"コクリコ","content":"こんにちは、刑事ちゃん。","voice":["vo_event_401102602_10"],"voice_bank":"vo_event_11026","style":11,"background":922,"log_type":1}]}