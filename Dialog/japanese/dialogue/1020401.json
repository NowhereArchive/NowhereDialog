{"id":1020401,"chapter_id":1020401,"scene_id":1,"steps":[{"step":1,"content":"█月12日、12:35。MBCC食堂。","style":9,"background":1014,"log_type":1,"src_id":120401001,"trial_step":1},{"step":2,"content":"ドナルドとこんな場所でもう一度会えるとは思わなかった——","style":3,"background":1014,"log_type":1,"src_id":120401002,"trial_step":2},{"step":3,"speaker":"ドナルド","content":"外にいたコンビクトからMBCCのメシがうまいとは聞いていたが、嘘じゃねぇようだな……","voice":["vo_trial_20401_1_3"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401003,"trial_step":3},{"step":4,"content":"ドナルドは口元を油だらけにしながら、片手に焼き豚、片手に搾りたてのジュースを持っている。","style":3,"background":1014,"log_type":1,"src_id":120401004,"trial_step":4},{"step":5,"speaker":"ドナルド","content":"ここの料理人の腕を宣伝すりゃ……マジで逮捕隊なんか必要なくなるぜ……外のコンビクト連中が勝手に来るようになんだろ。","voice":["vo_trial_20401_1_5"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401005,"trial_step":5},{"step":6,"content":"そう言ってドナルドは、キッチンにいるケルビンとイグニに向かって親指を立てた。","style":3,"background":1014,"log_type":1,"src_id":120401006,"trial_step":6},{"step":7,"content":"あっという間に焼き豚を食べ終えると、ドナルドはまたキッチンに向かって叫ぶ。","style":3,"background":1014,"log_type":1,"src_id":120401007,"trial_step":7},{"step":8,"speaker":"ドナルド","content":"追加でラーメンもう一丁！その後はデザートで胃袋をいっぱいに満たしてぇから、あるやつ全部出してくれ。","voice":["vo_trial_20401_1_8"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401008,"trial_step":8},{"step":9,"speaker":"ドナルド","content":"特にアイスは必ずだ。MBCCのアイスは有名だからな……","voice":["vo_trial_20401_1_9"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401009,"trial_step":9},{"step":10,"content":"ケルビンが「お客さん」の注文を持って来て、一目散にキッチンに逃げ帰る。そしてこっそりと頭を出して、あなたたちの方を窺う。","style":3,"background":1014,"log_type":1,"src_id":120401010,"trial_step":10},{"step":11,"content":"他のコンビクトも、この堂々と管理局の食事をたかる金髪の男のことが気になるのか、数人まとまってひそひそと話をしている。","style":3,"background":1014,"log_type":1,"src_id":120401011,"trial_step":11},{"step":12,"content":"あなたが振り返ってドナルドの方に目を向けると、テーブルの料理はもうなくなっていた。彼は満足そうに椅子に座り、つま楊枝を使っている。","style":3,"background":1014,"log_type":1,"src_id":120401012,"trial_step":12},{"step":13,"content":"西区の偉大なる大英雄がそこまで空腹になるとはな。意外と仲間外れにされていたりするのか？","style":2,"background":1014,"log_type":1,"src_id":120401013,"trial_step":13},{"step":14,"speaker":"ドナルド","content":"はっ、んなわけねぇだろ。ここ最近いろんなところを駆け回っててな、メシを食えてなかっただけだ。","voice":["vo_trial_20401_1_14"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401014,"trial_step":14},{"step":15,"speaker":"ドナルド","content":"やっぱお前はいい奴だな……俺の力を借りたい時は遠慮なく言えよ。手伝えるかどうかは別の話だが、俺の心はいつまでもお前と一緒だ。","voice":["vo_trial_20401_1_15"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401015,"trial_step":15},{"step":16,"content":"そんな、ご飯を一回食べさせただけで……","style":2,"background":1014,"log_type":1,"src_id":120401016,"trial_step":16},{"step":17,"options":["ところで"],"style":6,"background":1014,"log_type":1,"src_id":120401017,"trial_step":17,"course":3,"choices":[{"text":"ところで","goto":18}]},{"step":18,"content":"あなたのような忙しい人が、ご飯を食べるためだけにわざわざここまで来たわけではないだろう？","style":2,"background":1014,"log_type":1,"src_id":120401018,"trial_step":18},{"step":19,"speaker":"ドナルド","content":"げっぷ……俺のことをよく分かってるじゃねぇか。","voice":["vo_trial_20401_1_19"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401019,"trial_step":19},{"step":20,"content":"ドナルドはつま楊枝をゴミ箱に入れて、立ち上がる。","style":3,"background":1014,"log_type":1,"src_id":120401020,"trial_step":20},{"step":21,"speaker":"ドナルド","content":"もちろん、用事がある。","voice":["vo_trial_20401_1_21"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401021,"trial_step":21},{"step":22,"content":"それは何だ？","style":2,"background":1014,"log_type":1,"src_id":120401022,"trial_step":22},{"step":23,"content":"ドナルドが周りを見回してから、声を抑えながらあなたに近づいた。","style":3,"background":1014,"log_type":1,"src_id":120401023,"trial_step":23},{"step":24,"speaker":"ドナルド","content":"誰かに聞かれたらまずい。静かなところで話そう。","voice":["vo_trial_20401_1_24"],"voice_bank":"vo_don_trial","style":1,"background":1014,"log_type":1,"src_id":120401024,"trial_step":24},{"step":25,"content":"……分かった。場所を用意しておく。","style":2,"background":1014,"log_type":1,"src_id":120401025,"trial_step":25},{"step":26,"content":"ついてきてくれ。","style":2,"background":1014,"log_type":1,"src_id":120401026,"trial_step":26},{"step":27,"speaker":"ドナルド","content":"……","voice":["vo_trial_20401_1_28"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401028,"trial_step":28,"drawing":1020401},{"step":28,"content":"……","style":2,"log_type":1,"src_id":120401029,"trial_step":29,"drawing":1020401},{"step":29,"speaker":"ドナルド","content":"いや……","voice":["vo_trial_20401_1_30"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401030,"trial_step":30,"drawing":1020401},{"step":30,"speaker":"ドナルド","content":"管理局は大事な話をこんなところでするのか？","voice":["vo_trial_20401_1_31"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401031,"trial_step":31,"drawing":1020401},{"step":31,"options":["そうだ"],"style":6,"log_type":1,"src_id":120401032,"trial_step":32,"course":3,"drawing":1020401,"choices":[{"text":"そうだ","goto":33}]},{"step":32,"content":"普段ここに来る人は絶対にいない。","style":2,"log_type":1,"src_id":120401033,"trial_step":33,"drawing":1020401},{"step":33,"speaker":"ドナルド","content":"ああ、そりゃそうだろ？まともな奴ならここに来たい気にゃならねぇだろうが。","voice":["vo_trial_20401_1_34"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401034,"trial_step":34,"drawing":1020401},{"step":34,"speaker":"ドナルド","content":"おい、知らねぇと思うなよ。MBCCにおけるコンビクトの取り調べは録画がされてんだろ。","voice":["vo_trial_20401_1_35"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401035,"trial_step":35,"drawing":1020401},{"step":35,"content":"安心してくれ、前もってカメラは全部切っておいた。","style":2,"log_type":1,"src_id":120401036,"trial_step":36,"drawing":1020401},{"step":36,"speaker":"ドナルド","content":"気ぃ遣ってくれてありがとな……って褒めてやるとでも思ったか？","voice":["vo_trial_20401_1_37"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401037,"trial_step":37,"drawing":1020401},{"step":37,"content":"どういたしまして。","style":2,"log_type":1,"src_id":120401038,"trial_step":38,"drawing":1020401},{"step":38,"speaker":"ドナルド","content":"調子に乗りやがって……別に人に顔向けできないほどのことじゃねぇし、ここまでする必要はねぇよ……","voice":["vo_trial_20401_1_39"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401039,"trial_step":39,"drawing":1020402},{"step":39,"content":"静かなところで話そうと言ったのは、誰だったろうな？","style":2,"log_type":1,"src_id":120401040,"trial_step":40,"drawing":1020402},{"step":40,"content":"そうだ、あなたが言ったんだった、ミスタードナルド。","style":2,"log_type":1,"src_id":120401041,"trial_step":41,"drawing":1020402},{"step":41,"content":"それに忘れないでくれ。あなた自身は本当に「人に顔向けできない」はずだ。まだ涅槃に指名手配されているからな。","style":2,"log_type":1,"src_id":120401042,"trial_step":42,"drawing":1020402},{"step":42,"speaker":"ドナルド","content":"あぁ……まあ……そりゃそうだがな。別に今に始まったことじゃねぇしなぁ。","voice":["vo_trial_20401_1_43"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401043,"trial_step":43,"drawing":1020402},{"step":43,"speaker":"ドナルド","content":"……実は、この「用事」は涅槃と関わっているんだ。","voice":["vo_trial_20401_1_44"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401044,"trial_step":44,"drawing":1020405},{"step":44,"options":["何があった？"],"style":6,"log_type":1,"src_id":120401045,"trial_step":45,"course":3,"drawing":1020405,"choices":[{"text":"何があった？","goto":46}]},{"step":45,"speaker":"ドナルド","content":"あのどうしようもねぇ指名手配のせいだ。涅槃の面倒な奴らが俺をいじめてくるんだよ。ぼっちで孤独な俺は、お前のところに助けを求めるしかなくてさ……","voice":["vo_trial_20401_1_46"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401046,"trial_step":46,"drawing":1020404},{"step":46,"content":"冗談はよしてくれ。あなたの人脈と腕があれば、涅槃に捕まることなどないだろう。","style":2,"log_type":1,"src_id":120401047,"trial_step":47,"drawing":1020404},{"step":47,"speaker":"ドナルド","content":"冗談じゃねぇよ……確かに、俺がその気になって隠れれば、奴らに捕まるわけがねぇ。","voice":["vo_trial_20401_1_48"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401048,"trial_step":48,"drawing":1020405},{"step":48,"speaker":"ドナルド","content":"だがな……まぁ、ちょいと事情が複雑でな。奴らは俺を「あぶり出そう」としているんだ。","voice":["vo_trial_20401_1_49"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401049,"trial_step":49,"drawing":1020405},{"step":49,"content":"あぶり出す？それはどういう意味だ……","style":2,"log_type":1,"src_id":120401050,"trial_step":50,"drawing":1020405},{"step":50,"speaker":"ドナルド","content":"まず一つ説明しておかねぇとな——","voice":["vo_trial_20401_1_51"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401051,"trial_step":51,"drawing":1020405},{"step":51,"content":"ドナルドが姿勢を正して、珍しく真剣な表情を見せた。","style":3,"log_type":1,"src_id":120401052,"trial_step":52,"drawing":1020400},{"step":52,"speaker":"ドナルド","content":"ここ半年で、西区に一群の「精神病者」が現れたんだ。それは知ってるか？","voice":["vo_trial_20401_1_53"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401053,"trial_step":53,"drawing":1020400},{"step":53,"content":"あなたは首を横に振った。","style":3,"log_type":1,"src_id":120401054,"trial_step":54,"drawing":1020400},{"step":54,"speaker":"ドナルド","content":"ま、目覚めたばかりだから、知らねぇのも当然だよな。","voice":["vo_trial_20401_1_55"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401055,"trial_step":55,"drawing":1020400},{"step":55,"speaker":"ドナルド","content":"簡単に言うとな、この半年間BR-002から狂瞳がずっとバラ撒かれている。んで、西区の大勢の人がこいつの影響を受けちまった。","voice":["vo_trial_20401_1_56"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401056,"trial_step":56,"drawing":1020400},{"step":56,"speaker":"ドナルド","content":"だがな、これまでの狂瞳病の患者と違って、そいつらの症状はけっこう軽いらしい。多くは重度のノイローゼに陥るが、すぐに命に関わるようなもんじゃねぇ。","voice":["vo_trial_20401_1_57"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401057,"trial_step":57,"drawing":1020400},{"step":57,"speaker":"ドナルド","content":"早いうちに治療を受ければ治せるし、予後の生活にもあまり影響しねぇが……","voice":["vo_trial_20401_1_58"],"voice_bank":"vo_don_trial","style":1,"log_type":1,"src_id":120401058,"trial_step":58,"drawing":1020400},{"step":58,"content":"しかし今の西区には、彼らを治療する医療リソースがない。そういうことか？","style":2,"log_type":1,"src_id":120401059,"trial_step":59,"drawing":1020400},{"step":59,"speaker":"ドナルド","content":"そうだ。西区はしばらくこの問題を解決できねぇ。"