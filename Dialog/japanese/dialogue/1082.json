{"id":1082,"chapter_id":1,"scene_id":111,"steps":[{"step":1,"speaker":"彼岸の医師","content":"クソ……コンビクト共め……","voice":["vo_cgplot_1082001"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":2,"speaker":"彼岸の医師","content":"テッド、お前は部下が狂瞳病に感染しているというのに放置したのか……お前はそれがどうなるか知っているのか？！","voice":["vo_cgplot_1082002"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":3,"speaker":"テッド","content":"コンビクトのところに身を寄せているお前に、私に何かを言う資格があるとでも思ってるのか？","voice":["vo_cgplot_1082003"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":4,"speaker":"テッド","content":"お前たちだけがやりたい放題だった日々にはもううんざりだ……怪物を追い出して昔のシンジケートを取り戻せるのなら、私は全てを利用する。","voice":["vo_cgplot_1082004"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":5,"speaker":"テッド","content":"行くぞ、局長。中に入ってあのRを見つけろ。","voice":["vo_cgplot_1082005"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":6,"speaker":"彼岸の医師","content":"お前が……そんなことを……","voice":["vo_cgplot_1082006"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":7,"content":"冷たく硬い義手が、いきなり足首を掴んできた。","style":3,"background":122,"log_type":1},{"step":8,"speaker":"彼岸の医師","content":"ブランド……ローラ……外勤隊……彼らが救援に出たまま戻ってこない、何があった？","voice":["vo_cgplot_1082008"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":9,"speaker":"彼岸のメンバー","content":"お願いだ、ローラはまだ若い、助けてやってくれ……お願いだ……","voice":["vo_cgplot_1082009"],"voice_bank":"vo_cgplot_01","style":1,"background":100,"log_type":1},{"step":10,"speaker":"彼岸の医師","content":"ブランド先生は人を助けに行ったんだ。彼岸を包囲しながら殺し合いをしていたお前らを助けにな。秒単位で正確に手術を行うような人が、時間通りに戻ってこなかった……","voice":["vo_cgplot_1082010"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":11,"speaker":"彼岸の医師","content":"彼をどうした？！！","voice":["vo_cgplot_1082011"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":12,"options":["どういうこと？","……"],"jump":[13,13],"style":6,"background":122,"log_type":1},{"step":13,"content":"テッドは彼を蹴飛ばし、あなたを引き寄せた。","style":3,"background":122,"log_type":1},{"step":14,"speaker":"テッド","content":"何をとぼけている。彼らは敵だ、局長、自分の立場を忘れるな。","voice":["vo_cgplot_1082014"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":15,"speaker":"ヘカテー","content":"局長！うしろ！","voice":["vo_cgplot_1082015"],"voice_bank":"vo_cgplot_01","style":1,"background":122,"log_type":1},{"step":16,"content":"あなたは振り向いた。あなたたちが来た方向、硝煙の中にゆらゆらと揺れる姿が浮かんだ。","style":3,"background":122,"log_type":1},{"step":17,"content":"——その顔と、血に染まった白衣を知っている。","style":3,"background":122,"log_type":1}]}