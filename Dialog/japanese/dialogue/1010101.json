{"id":1010101,"chapter_id":1010101,"scene_id":1,"steps":[{"step":1,"content":"裁判まであと\n30日間","style":9,"background":10000,"log_type":1,"src_id":110101001,"trial_step":1,"drawing":1010101},{"step":2,"content":"後ろの扉が低くて太い音を出して閉じた。あなたの前にかの有名な「ニューシティ殺人鬼」が座っている。","style":3,"log_type":1,"src_id":110101003,"trial_step":3,"drawing":1010101},{"step":3,"speaker":"デーモン","content":"……","style":1,"log_type":1,"src_id":110101004,"trial_step":4,"drawing":1010102},{"step":4,"content":"デーモンが頭を上げて、一瞥をくれた。","style":3,"log_type":1,"src_id":110101005,"trial_step":5,"drawing":1010102},{"step":5,"content":"手術が終わったばかりで、傷口がまだ完全にふさがってないせいか、微かに血生臭い匂いがする。","style":3,"log_type":1,"src_id":110101006,"trial_step":6,"drawing":1010101},{"step":6,"content":"デーモン・スヒルデル、聞きたいことがある。","style":2,"log_type":1,"src_id":110101007,"trial_step":7,"drawing":1010101},{"step":7,"speaker":"デーモン","content":"……","style":1,"log_type":1,"src_id":110101008,"trial_step":8,"drawing":1010102},{"step":8,"content":"デーモンはまた頭を上げて、今度は獲物を狙うような目になった。","style":3,"log_type":1,"src_id":110101009,"trial_step":9,"drawing":1010102},{"step":9,"content":"つい先日、管理局が60時間かけてこの男を逮捕した。その後に手術を施し、彼の体内に残る300グラム以上もあった弾片を取り出した。そして4時間前に、彼に死んでもおかしくないほど大量の鎮静剤を投与した。","style":3,"log_type":1,"src_id":110101010,"trial_step":10,"drawing":1010102},{"step":10,"content":"それでも、この男からは恐ろしいオーラが漂っていて、あなたを傷つけるだけの力を持っている。","style":3,"log_type":1,"src_id":110101011,"trial_step":11,"drawing":1010102},{"step":11,"options":["彼をなだめる","彼を威嚇する"],"style":6,"log_type":1,"src_id":110101012,"trial_step":12,"course":3,"drawing":1010102,"choices":[{"text":"彼をなだめる","goto":13},{"text":"彼を威嚇する","goto":17}]},{"step":12,"content":"私は敵ではない。","style":2,"log_type":1,"src_id":110101013,"trial_step":13,"drawing":1010101},{"step":13,"content":"ちょっと事情を知りたいだけなんだ。お前を含めて、管理局のコンビクトを守るのが私の責任だ。","style":2,"log_type":1,"src_id":110101014,"trial_step":14,"drawing":1010101},{"step":14,"speaker":"デーモン","content":"……感謝してほしいか？","voice":["vo_trial_10101_1_15"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101015,"trial_step":15,"drawing":1010101},{"step":15,"content":"と、感謝する気持ちが全くない言葉を吐いた。","style":3,"log_type":1,"src_id":110101016,"trial_step":16,"drawing":1010101,"next":[21]},{"step":16,"content":"自分の立場を考えてみろ、デーモン。","style":2,"log_type":1,"src_id":110101017,"trial_step":17,"drawing":1010101},{"step":17,"content":"多くの人がお前の命を狙っている。あなたを守れるのは管理局だけだ。私たちの調査に協力した方がいいじゃないのか？","style":2,"log_type":1,"src_id":110101018,"trial_step":18,"drawing":1010101},{"step":18,"speaker":"デーモン","content":"やつらが俺を殺したいなら、殺しに来ればいい。","voice":["vo_trial_10101_1_19"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101019,"trial_step":19,"drawing":1010101},{"step":19,"content":"脅迫されても、デーモンはまったく動じなかった。","style":3,"log_type":1,"src_id":110101020,"trial_step":20,"drawing":1010101},{"step":20,"content":"非協力的な態度は予想済みだ。数時間前に、あなたに忠告する人がいたからだ。","style":3,"log_type":1,"src_id":110101021,"trial_step":21,"drawing":1010101},{"step":21,"speaker":"事務官","content":"これがデーモン・スヒルデルに関する全ての資料です。","voice":["vo_trial_10101_1_5"],"voice_bank":"vo_dimeng_trial","style":1,"background":1017,"log_type":1,"src_id":110101022,"trial_step":22,"drawing":1010101},{"step":22,"content":"……","style":2,"background":1017,"log_type":1,"src_id":110101023,"trial_step":23,"drawing":1010101},{"step":23,"content":"机に山ほどの資料が積み上げられている。机の向こうで、一人の事務官がにっこりとあなたに笑顔を向けている。","style":3,"background":1017,"log_type":1,"src_id":110101024,"trial_step":24,"drawing":1010101},{"step":24,"speaker":"事務官","content":"局長さん、デーモン・スヒルデルは市議会に移送しなければなりません。彼の死刑は8年前に執行されるべきでした。もう十分に期限は延ばしているのです。","voice":["vo_trial_10101_1_6"],"voice_bank":"vo_dimeng_trial","style":1,"background":1017,"log_type":1,"src_id":110101025,"trial_step":25,"drawing":1010101},{"step":25,"speaker":"事務官","content":"8年前、彼は裁判から逃れられました。その後、反省する様子もなく、また12人の市議会の役人を襲って、殺しました。","voice":["vo_trial_10101_1_7"],"voice_bank":"vo_dimeng_trial","style":1,"background":1017,"log_type":1,"src_id":110101026,"trial_step":26,"drawing":1010101},{"step":26,"speaker":"事務官","con