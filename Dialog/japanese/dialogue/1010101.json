ent":"犯行について話さなければ","options":["犯行について話さなければ"],"style":6,"log_type":1,"src_id":110101037,"trial_step":37,"drawing":1010101,"next":[38]},{"step":37,"content":"デーモンが軽蔑した目であなたが持っている資料を見た。","style":3,"log_type":1,"src_id":110101038,"trial_step":38,"drawing":1010103},{"step":38,"speaker":"デーモン","content":"市議会から？","voice":["vo_trial_10101_1_39"],"voice_bank":"vo_dimeng_trial","style":1,"log_type":1,"src_id":110101039,"trial_step":39,"drawing":1010103},{"step":39,"content":"「市議会」という言葉を口にすると、彼の声が荒々しくなる。","style":3,"log_type":1,"src_id":110101040,"trial_step":40,"drawing":1010103},{"step":40,"content":"その通り。","style":2,"log_type":1,"src_id":110101041,"trial_step":41,"drawing":1010103},{"step":41,"content":"あなたの答えを聞くと、デーモンが鼻でふんと笑って口を閉じた。","style":3,"log_type":1,"src_id":110101042,"trial_step":42,"drawing":1010101},{"step":42,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":43,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":44,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":45,"options":["選択肢1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":46,"content":"＊","style":18,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":47,"options":["選択肢1","選択肢2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":48,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":49,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":43,"course":6,"drawing":1010101},{"step":50,"content":"あなたは最初の資料を手にする。","style":3,"log_type":1,"src_id":110101044,"trial_step":44,"drawing":1010101},{"step":51,"content":"特別派遣部隊、元副隊長<color=#e45515>フィン</color>、105年12月24日、自宅マンションのベランダから墜落して、死亡。墜落による傷以外に、刃物による傷跡も見られる。生前、残酷な拷問を受けたと考えられる。","style":2,"log_type":1,"src_id":110101045,"trial_