{"id":1060202,"chapter_id":1060202,"scene_id":1,"steps":[{"step":1,"content":"あなたは久しぶりにエンフェルと共に再びベルフェゴール美術館に足を踏み入れた。","style":3,"background":2038,"log_type":1,"src_id":160202001,"trial_step":1},{"step":2,"content":"陽の光がガラスから射し込み、辺り一面荒らされた館内を照らしている。空気中に漂う塵は、光を求めて飛び交う蛾を思わせた。","style":3,"background":2038,"log_type":1,"src_id":160202002,"trial_step":2},{"step":3,"speaker":"エンフェル","content":"徹底的に荒らされてしまったのう。","voice":["vo_trial_60202_1_1"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202003,"trial_step":3},{"step":4,"content":"人を惑わす「魔法」などなくても、あなたには分かる。ここはソシアが飾られていた場所だ。","style":3,"background":2038,"log_type":1,"src_id":160202004,"trial_step":4},{"step":5,"content":"ソシアだけではなく、ホールにあった美術品の何もかもが、砕かれて破壊されていた。","style":3,"background":2038,"log_type":1,"src_id":160202005,"trial_step":5},{"step":6,"content":"このホールで展示されていた作品は自分の成長の軌跡に等しいとエンフェルが言っていたのを、あなたはぼんやりと思い出す。","style":3,"background":2038,"log_type":1,"src_id":160202006,"trial_step":6},{"step":7,"content":"ここは最後にしてもいいのだが……","style":2,"background":2038,"log_type":1,"src_id":160202007,"trial_step":7},{"step":8,"speaker":"エンフェル","content":"構わん。わらわはそなたが思うほど軟弱ではない。","voice":["vo_trial_60202_1_2"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202008,"trial_step":8},{"step":9,"speaker":"エンフェル","content":"「心の繋がりは悲しみを溶かしていく」","voice":["vo_trial_60202_1_3"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202009,"trial_step":9},{"step":10,"speaker":"エンフェル","content":"そなたにも経験があるじゃろう。","voice":["vo_trial_60202_1_4"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202010,"trial_step":10},{"step":11,"content":"そうだな、私たちが今ここで泣く必要はない。","style":2,"background":2038,"log_type":1,"src_id":160202011,"trial_step":11},{"step":12,"speaker":"エンフェル","content":"これでよい。","voice":["vo_trial_60202_1_5"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202012,"trial_step":12},{"ste