k":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202050,"trial_step":50},{"step":51,"content":"しばらくして、音が止んだ。身体を起こして見上げると、エンフェルは台座の上で頬杖をついたまま、目を細めながらあなたを見下ろしていた。","style":3,"background":2038,"log_type":1,"src_id":160202051,"trial_step":51},{"step":52,"speaker":"エンフェル","content":"寝てしまったかと思ったわ。","voice":["vo_trial_60202_1_19"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202052,"trial_step":52},{"step":53,"speaker":"エンフェル","content":"わらわの作品を見てくれ、どうじゃ？","voice":["vo_trial_60202_1_20"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202053,"trial_step":53},{"step":54,"content":"まるでダンスに誘うように、彼女はあなたに向かって手を伸ばした。","style":3,"background":2038,"log_type":1,"src_id":160202054,"trial_step":54},{"step":55,"content":"彼女の手にあるのは、欠片を利用して彫り出された小物だった。","style":3,"background":2038,"log_type":1,"src_id":160202055,"trial_step":55},{"step":56,"content":"これは……何だ？","style":2,"background":2038,"log_type":1,"src_id":160202056,"trial_step":56},{"step":57,"content":"砕けた欠片はエンフェルの手により、繭のような何かを形作られていた。","style":3,"background":2038,"log_type":1,"src_id":160202057,"trial_step":57},{"step":58,"content":"その規則性のない形状は、何かがその中で藻掻いているように感じられた。","style":3,"background":2038,"log_type":1,"src_id":160202058,"trial_step":58},{"step":59,"speaker":"エンフェル","content":"芸術の残滓じゃな。","voice":["vo_trial_60202_1_21"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202059,"trial_step":59},{"step":60,"content":"随分とユニークだな。","style":2,"background":2038,"log_type":1,"src_id":160202060,"trial_step":60},{"step":61,"content":"これらの小物がエンフェルの今までの作品にはとても及ばないことはあなたにも分かった。","style":3,"background":2038,"log_type":1,"src_id":160202061,"trial_step":61},{"step":62,"content":"どうやってエンフェルを慰めればいいのか分からず、あなたはその小物を手に取ってじっと眺める。","style":3,"background":2038,"log_type":1,"src_id":160202062,"trial_step":62},{"step":63,"content":"各彫刻の中央には、小さなハート状の印がついていた。","style":3,"background":2038,"log_type":1,"src_id":160202063,"trial_step":63},{"step":64,"speaker":"EMP","content":"そんな婉曲な言い方をせずともよい。","voice":["vo_trial_60202_1_22"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202064,"trial_step":64},{"step":65,"content":"エンフェルは彫刻の一つを指で小突いて、コロンと倒した。","style":3,"background":2038,"log_type":1,"src_id":160202065,"trial_step":65},{"step":66,"speaker":"エンフェル","content":"これらは……わらわの三年前の作品にも及ばん。","voice":["vo_trial_60202_1_23"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202066,"trial_step":66},{"step":67,"content":"それほどか……","style":2,"background":2038,"log_type":1,"src_id":160202067,"trial_step":67},{"step":68,"speaker":"エンフェル","content":"それほどじゃ。","voice":["vo_trial_60202_1_24"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202068,"trial_step":68},{"step":69,"content":"エンフェルはこのだだっ広いホールを見渡した。部屋の床には欠片が散らばり、風通しの悪い牢獄のような息苦しさを感じる。","style":3,"background":2038,"log_type":1,"src_id":160202069,"trial_step":69},{"step":70,"speaker":"エンフェル","content":"別に気にする必要はない。","voice":["vo_trial_60202_1_25"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202070,"trial_step":70},{"step":71,"speaker":"エンフェル","content":"美術家とは……このようなものなのじゃ。","voice":["vo_trial_60202_1_26"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202071,"trial_step":71},{"step":72,"speaker":"エンフェル","content":"創作の中で足掻き、成長し、虚無に帰り、最後に完成した個体へと進化する。","voice":["vo_trial_60202_1_27"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202072,"trial_step":72},{"step":73,"content":"エンフェルは両手を広げた。青色の裾が翻り、鱗粉の輝く翅を思わせた。","style":3,"background":2038,"log_type":1,"src_id":160202073,"trial_step":73},{"step":74,"speaker":"エンフェル","content":"度重なる創作は、己を何度も引き裂いてゆく。","voice":["vo_trial_60202_1_28"],"voice_bank":"vo_enfer_trial","style":1,"background":2038,"log_type":1,"src_id":160202074,"trial_step":74},{"step":75,"speaker":"エンフェル","content":"何度も繭を破り羽化して、最後には誰もを驚かす蛾へ