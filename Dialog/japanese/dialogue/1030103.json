l","style":1,"background":120,"log_type":1,"src_id":130103162,"trial_step":162},{"step":163,"content":"広告のキャッチコピーとシンジケート特有の古臭い音楽に驚かされる。","style":3,"background":120,"log_type":1,"src_id":130103163,"trial_step":163},{"step":164,"content":"昨日ハクイツに騙されてダウンロードした悪質アプリだ。見るまでもなく分かる。","style":3,"background":120,"log_type":1,"src_id":130103164,"trial_step":164},{"step":165,"speaker":"護衛A","content":"外に誰かいるぞ！！ジェンセン！どこだ！？","voice":["vo_trial_30103_1_166"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103165,"trial_step":165},{"step":166,"speaker":"ハクイツ","content":"何やってるの！","voice":["vo_trial_30103_1_167"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103166,"trial_step":166},{"step":167,"content":"あなたが薦めたアプリだ！","style":2,"background":120,"log_type":1,"src_id":130103167,"trial_step":167},{"step":168,"speaker":"ハクイツ","content":"そんな悪質アプリ、なんですぐ削除しないの？","voice":["vo_trial_30103_1_169"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103168,"trial_step":168},{"step":169,"content":"……","style":2,"background":120,"log_type":1,"src_id":130103169,"trial_step":169},{"step":170,"content":"ならどうしてそんなアプリをダウンロードさせたのかと問い詰めたくなる。","style":3,"background":120,"log_type":1,"src_id":130103170,"trial_step":170},{"step":171,"speaker":"ハクイツ","content":"……まあ、もう遅いわ。行くわよ！","voice":["vo_trial_30103_1_172"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103171,"trial_step":171},{"step":172,"speaker":"ハクイツ","content":"はっ！","voice":["vo_trial_30103_1_173"],"voice_bank":"vo_linglan_trial","style":1,"background":120,"log_type":1,"src_id":130103172,"trial_step":172},{"step":173,"content":"バン——","style":1,"background":120,"log_type":1,"src_id":130103173,"trial_step":173},{"step":174,"content":"ハクイツがドアを蹴破り、刀でドア近くにいた護衛二人を倒した。","style":3,"background":1045,"log_type":1,"src_id":130103174,"trial_step":174},{"step":175,"content":"ゲストルームにいるのは十人ほどだ——澈とK.K.を含めて。その瞬間誰もが固まった。ハクイツ