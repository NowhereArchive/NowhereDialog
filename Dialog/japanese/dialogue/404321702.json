{"id":404321702,"chapter_id":50088,"scene_id":58861,"steps":[{"step":1,"content":"ヒルダの銃口を前にして、あなたは不思議と、吹っ切れたようだった。","style":3,"background":2506,"log_type":1},{"step":2,"content":"あなたは銃を下ろした。そして目を閉じ、審判の時を待った。","style":3,"background":2506,"log_type":1},{"step":3,"content":"（暗転に入る）","style":18,"background":10000,"hide_button":true,"log_type":1},{"step":4,"speaker":"ヒルダ","content":"……何があったのか、教えてくれないか。","voice":["vo_event_404321802_01"],"voice_bank":"vo_event_43218","style":1,"background":10000,"log_type":1},{"step":5,"content":"（暗転消失）","style":18,"background":2506,"log_type":1},{"step":6,"content":"目を開けると、ヒルダが銃を下ろしているのが見えた。","style":3,"background":2506,"log_type":1},{"step":7,"content":"彼女の唇はぎゅっと結ばれ、いつもの冷淡な顔に決然とした表情が浮かんでいた。","style":3,"background":2506,"log_type":1},{"step":8,"speaker":"ヒルダ","content":"君がモグラでないと信じている。だが、一体何があったのか教えてほしい。","voice":["vo_event_404321802_05"],"voice_bank":"vo_event_43218","style":1,"background":2506,"log_type":1},{"step":9,"content":"あなたはさっき起こった出来事の一部始終をヒルダに話したが、書簡については血に濡れて、全く読めなくなっていたので話さなかった。","style":3,"background":2506,"log_type":1},{"step":10,"content":"すべてを話し終えると、ヒルダはノーランの亡骸を、ただ静かに見つめていた。","style":3,"background":2506,"log_type":1},{"step":11,"speaker":"ヒルダ","content":"手伝ってもらえるか？","voice":["vo_event_404321802_08"],"voice_bank":"vo_event_43218","style":1,"background":2506,"log_type":1},{"step":12,"speaker":"ヒルダ","content":"彼らの遺体を納めるのを手伝ってほしい。それが終わったら……眠るといい。","voice":["vo_event_404321802_09"],"voice_bank":"vo_event_43218","style":1,"background":2506,"log_type":1},{"step":13,"speaker":"ヒルダ","content":"今度こそ、本当にモグラはいなくなった。","voice":["vo_event_404321802_10"],"voice_bank":"vo_event_43218","style":1,"background":2506,"log_type":1}]}