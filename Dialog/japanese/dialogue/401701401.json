{"id":401701401,"chapter_id":21000103,"scene_id":304,"steps":[{"step":1,"content":"あなたはメカを装着して、近くの足場で作業しているヴァニラに向けて手を振った。","style":3,"background":2176,"log_type":1},{"step":2,"options":["いってくる"],"jump":[3],"style":6,"background":2176,"log_type":1},{"step":3,"content":"あなたの声に、ヴァニラが少し顔を上げた。","style":3,"background":2176,"log_type":1},{"step":4,"speaker":"ヴァニラ","content":"メカを強化したとはいえ、あまり危険な場所には入るな。","voice":["vo_event_401701401_4"],"voice_bank":"vo_event_17014","style":1,"background":2176,"log_type":1},{"step":5,"content":"そう言われたものの、急いで物資を集めて、ヴァニラをここから連れ出して幻月の危機を解決するためには、危険な場所にまで足を踏み入れる必要がある。そう考えながらも、あなたはいい子のフリをして頷いた。","style":3,"background":2176,"log_type":1},{"step":6,"content":"幸い、ヴァニラはそれ以上何も言わずに、笑いながらあなたに向けて手を振った。","style":3,"background":2176,"log_type":1},{"step":7,"speaker":"ヴァニラ","content":"早く戻ってこいよ。","voice":["vo_event_401701401_7"],"voice_bank":"vo_event_17014","style":1,"background":2176,"log_type":1}]}