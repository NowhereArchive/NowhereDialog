{"id":404603001,"chapter_id":220100,"scene_id":705,"steps":[{"step":1,"speaker":"亡霊","content":"<i><color=#dg1f1f>グ——グッ——</i></color>","style":1,"background":2552105,"log_type":1},{"step":2,"content":"一匹の亡霊が壁の裏から襲いかかってきた。離塵があなたを庇うように、数本の木剣を呼び出す。","style":3,"background":2552105,"log_type":1},{"step":3,"speaker":"離塵","content":"疾速神威、正体を露わさん！","voice":["vo_event_404603001_03"],"voice_bank":"vo_event_46031","style":1,"background":2552105,"log_type":1},{"step":4,"content":"木剣が怪物の手足を貫くと、断末魔をあげ、もがきながら消えていった。","style":3,"background":2552105,"log_type":1},{"step":6,"content":"消滅する直前、怪物が非常に滑らかな人の姿へと変わるのが見えた。毛髪もなければシワもなく、眼窩は闇に染まっている。","style":3,"background":2552105,"log_type":1},{"step":8,"speaker":"離塵","content":"よせ、見るな。","voice":["vo_event_404603001_06"],"voice_bank":"vo_event_46031","style":1,"background":2552105,"log_type":1},{"step":9,"content":"彼女はあなたを、自分の後ろへ隠すように引っ張った。","style":3,"background":2552105,"log_type":1},{"step":10,"content":"離塵が怪物を倒しているにもかかわらず、陽界はさらに物騒になっていた。微かだが足元の地面まで歪んでいるように見える。","style":3,"background":2552105,"log_type":1},{"step":11,"content":"次々と現れる亡霊が、あなたたちを追いかける。","style":3,"background":2552105,"log_type":1},{"step":12,"speaker":"離塵","content":"邪悪を切り尽くし、塵と化せ！","voice":["vo_event_404603001_08"],"voice_bank":"vo_event_46031","style":1,"background":2552105,"log_type":1},{"step":13,"speaker":"亡霊","content":"<i><color=#dg1f1f>ギィアアアアアア——！</i></color>","style":1,"background":2552105,"log_type":1},{"step":14,"content":"悲鳴が消え入る前に、霧の中からもう一つのぼやけた影が迫ってきた。","style":3,"background":2552105,"log_type":1},{"step":15,"content":"次の瞬間、影が急に身を構え、あなたたちに襲いかかる——","style":3,"background":2552105,"log_type":1}]}