{"id":401540002,"chapter_id":50045,"scene_id":45007,"steps":[{"step":1,"speaker":"吟遊詩人","content":"～～～～","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":2,"speaker":"吟遊詩人","content":"「ボロ布の服に、滑稽な王冠」","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":3,"speaker":"吟遊詩人","content":"「鮮やかなリボンは、代々伝わるもの」","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":4,"speaker":"吟遊詩人","content":"「天幕は古びているが、観衆が好むならそれでいい」","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":5,"speaker":"吟遊詩人","content":"「身だしなみは乱れ、国王は観衆に笑われる」","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":6,"speaker":"吟遊詩人","content":"「公衆はいても興収がない」","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":7,"speaker":"吟遊詩人","content":"「五つの銅貨が音を立てて鳴る」","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":8,"speaker":"吟遊詩人","content":"「もう十分、もう十分」","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":9,"speaker":"吟遊詩人","content":"「五人の腹を満たすのにもう十分だ」","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":10,"speaker":"吟遊詩人","content":"「もう十分、もう十分」","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":11,"speaker":"吟遊詩人","content":"「踊りながら歌を歌おう」","style":1,"background":1069,"is_centered":true,"log_type":1}]}