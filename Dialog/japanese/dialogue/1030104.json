ial_step":24},{"step":25,"speaker":"情報員","content":"ルドー・ハク、ニューシティ市民です。半年前に破産したあと行方不明になりました。","voice":["vo_trial_30104_1_25"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104025,"trial_step":25},{"step":26,"speaker":"情報員","content":"さらに情報が入っております。彼によく似た人物が錆の川近くのサルトル街に現れました。ニューシティに逃げるつもりかもしれません。","voice":["vo_trial_30104_1_26"],"voice_bank":"vo_linglan_trial","style":1,"background":1040,"log_type":1,"src_id":130104026,"trial_step":26},{"step":27,"content":"あの身体つきはシンジケートではあまり見ない。情報は確かだろう。","style":2,"background":1040,"log_type":1,"src_id":130104027,"trial_step":27},{"step":28,"content":"ハクイツの正体を突き止めるチャンスが来た。隊員を集結させろ。確保の準備だ。","style":2,"background":1040,"log_type":1,"src_id":130104028,"trial_step":28},{"step":29,"content":"まだ来ないのか？","style":2,"background":1008,"log_type":1,"src_id":130104029,"trial_step":29},{"step":30,"content":"あなたとMBCCの同行メンバーはもう3時間も待ち伏せをしている。だが監視担当からはまだなんの情報も届いていない。","style":3,"background":1008,"log_type":1,"src_id":130104030,"trial_step":30},{"step":31,"speaker":"情報員","content":"ニューシティへの密航ルートはもうすぐ閉じられます。今行かないと次のチャンスは来週になります……","voice":["vo_trial_30104_1_31"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104031,"trial_step":31},{"step":32,"content":"情報に間違いがないのであれば、アクシデントが起きたのかもしれない。","style":2,"background":1008,"log_type":1,"src_id":130104032,"trial_step":32},{"step":33,"speaker":"情報員","content":"虱潰しに探しますか？","voice":["vo_trial_30104_1_33"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type":1,"src_id":130104033,"trial_step":33},{"step":34,"content":"私たちの人数では、その効果には期待できない。","style":2,"background":1008,"log_type":1,"src_id":130104034,"trial_step":34},{"step":35,"content":"……あと10分だけ待とう。それでもターゲットが現れないなら行動を開始する。旅館やレストランのような場所を優先して捜査しよう。","style":2,"background":1008,"log_type":1,"src_id":130104035,"trial_step":35},{"step":36,"speaker":"情報員","content":"分かりました。","voice":["vo_trial_30104_1_36"],"voice_bank":"vo_linglan_trial","style":1,"background":1008,"log_type