":44},{"step":45,"content":"他に何かオススメは？","style":2,"background":1005,"log_type":1,"src_id":220303045,"trial_step":45},{"step":46,"speaker":"店員","content":"当店のストロベリーパフェを心からお勧めいたします。","style":1,"background":1005,"log_type":1,"src_id":220303046,"trial_step":46},{"step":47,"speaker":"ペガシ","content":"パフェって……アイスクリーム？","style":1,"background":1005,"log_type":1,"src_id":220303047,"trial_step":47},{"step":48,"speaker":"店員","content":"そうでございます。","style":1,"background":1005,"log_type":1,"src_id":220303048,"trial_step":48},{"step":49,"speaker":"ペガシ","content":"いりません。","style":1,"background":1005,"log_type":1,"src_id":220303049,"trial_step":49},{"step":50,"content":"最後に、あなたはもう何品かのメニューを注文した。注文後、店員は急いで店内の奥へ戻っていった。","style":3,"background":1005,"log_type":1,"src_id":220303050,"trial_step":50},{"step":51,"content":"昼時の店内は満席だったが、幸いにも、料理がすぐに出てきた。あっという間に料理がテーブルの上に並べられた。","style":3,"background":1005,"log_type":1,"src_id":220303051,"trial_step":51},{"step":52,"content":"ペガシはパンを小さく千切って、ボウルの中のスープでよく湿らせて口に入れた——これはディスシティではほとんど見られない食べ方だ。","style":3,"background":1005,"log_type":1,"src_id":220303052,"trial_step":52},{"step":53,"content":"どうだ？口に合うか？","style":2,"background":1005,"log_type":1,"src_id":220303053,"trial_step":53},{"step":54,"speaker":"ペガシ","content":"はい。","style":1,"background":1005,"log_type":1,"src_id":220303054,"trial_step":54},{"step":55,"content":"懐かしい味か。","style":2,"background":1005,"log_type":1,"src_id":220303055,"trial_step":55},{"step":56,"speaker":"ペガシ","content":"……うん。","style":1,"background":1005,"log_type":1,"src_id":220303056,"trial_step":56},{"step":57,"content":"ペガシは頷いた。","style":3,"background":1005,"log_type":1,"src_id":220303057,"trial_step":57},{"step":58,"content":"この店は、レフアが経営している。","style":2,"background":1005,"log_type":1,"src_id":220303058,"trial_step":58},{"step":59,"content":"ペガシは食器を置いて、信じられないように目を見開いた。","style":3,"background":1005,"log_type":1,"src_id":220303059,"trial_step":59},{"step":60,"content":"満席の客を見回し、ペガシは少し安堵の笑みを浮かべた。","style":3,"background":1005,"log_type":1,"src_id":220303060,"trial_step":60},{"step":61,"speaker":"ペガシ","content":"元気にしているんですね。","style":1,"background":1005,"log_type":1,"src_id":220303061,"trial_step":61},{"step":62,"content":"ああ。みんな元気だ。","style":1,"background":1005,"log_type":1,"src_id":220303062,"trial_step":62},{"step":63,"content":"この人たちを覚えているか？","style":2,"background":1005,"log_type":1,"src_id":220303063,"trial_step":63},{"step":64,"content":"あなたはポケットから集合写真を取り出した。","style":3,"background":1005,"log_type":1,"src_id":220303064,"trial_step":64},{"step":65,"speaker":"ペガシ","content":"これは……ボリス？リディア、ナスティア先生……レフアさん？なんで、みんなが一緒にいるの？","style":1,"background":1005,"log_type":1,"src_id":220303065,"trial_step":65},{"step":66,"content":"マエクタウンの人は、ディスシティで新しい生活を始めた。","style":2,"background":1005,"log_type":1,"src_id":220303066,"trial_step":66},{"step":67,"content":"彼らはサポートグループも結成している。実は先日彼らと話をしたのだが——あなたのことを喜んで受け入れてくれるそうだ。","style":2,"background":1005,"log_type":1,"src_id":220303067,"trial_step":67},{"step":68,"speaker":"ペガシ","content":"私は……コンビクトです。","style":1,"background":1005,"log_type":1,"src_id":220303068,"trial_step":68},{"step":69,"speaker":"ペガシ","content":"彼らは私を助けられない。私も彼らを助けられない。","style":1,"background":1005,"log_type":1,"src_id":220303069,"trial_step":69},{"step":70,"options":["そんなに拒まなくともいい","ペガシの選択を尊重する"],"style":6,"background":1005,"log_type":1,"src_id":220303070,"trial_step":70,"course":3,"choices":[{"text":"そんなに拒まなくともいい","goto":71},{"text":"ペガシの選択を尊重する","goto":73}]},{"step":71,"content":"試してみよう。もしかしたら、あなたの手助けになるかもしれない。","style":2,"background":1005,"log_type":1,"src_id":220303071,"trial_step":71},{"step":72,"speaker":"ペガシ","content":"……私にはその資格がない。","style":1,"background":1005,"log_type":1,"src_id":220303072,"trial_step":72,"next":[73]},{"step":73,"content":"辺りが沈黙に包まれる。ペガシは目の前にあるスープを素早く飲み干した。","style":3,"background":1005,"log_type":1,"src_id":220303073,"trial_step":73},{"step":74,"speaker":"ペガシ","content":"行きましょう。","style":1,"background":1005,"log_type":1,"src_id":220303074,"trial_step":74},{"step":75,