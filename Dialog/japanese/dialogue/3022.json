{"id":3022,"chapter_id":3,"scene_id":302,"steps":[{"step":1,"speaker":"ヘラ","content":"わあぁぁ——！","voice":["vo_cgplot_3022001"],"voice_bank":"vo_cgplot_03","style":1,"background":205,"log_type":1},{"step":2,"content":"砲弾が炸裂した瞬間、車両が吹き飛びそうなほどに揺れた。ヘラはあなたを悪夢の中に押し込めたが、彼女自身は振り落とされてしまう。","style":3,"background":205,"log_type":1},{"step":3,"content":"彼女を掴もうとしたが、煙の中から飛び出してきた2台の車があなたたちの車両に激しくぶつかってくる。","style":3,"background":205,"log_type":1},{"step":4,"content":"ようやく車は停止した。眩暈から立ち直る間もなく、軍団の大部隊が群がってくるのが見える。","style":3,"background":303,"log_type":1},{"step":5,"speaker":"ヘカテー","content":"局長、しっかりして。","voice":["vo_cgplot_3022005"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1},{"step":6,"speaker":"ヘカテー","content":"……わたしたちは包囲された。","voice":["vo_cgplot_3022006"],"voice_bank":"vo_cgplot_03","style":1,"background":303,"log_type":1}]}