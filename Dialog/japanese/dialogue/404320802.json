{"id":404320802,"chapter_id":50088,"scene_id":58866,"steps":[{"step":1,"content":"あなたは負傷したふりをして倒れたが、予想外にもその体にヘレナがつまずいて転倒した。","style":3,"background":2174,"log_type":1},{"step":2,"speaker":"ヘレナ","content":"きゃあっ——！","voice":["vo_event_404320802_01"],"voice_bank":"vo_event_43208","style":1,"background":2174,"log_type":1},{"step":3,"content":"鋭いハイヒールがあなたを踏みつけ、肋骨がきしむ音をはっきりと聞いた。","style":3,"background":2174,"log_type":1},{"step":4,"content":"——おそらく内出血しただろう。","style":3,"background":2174,"log_type":1},{"step":5,"speaker":"ヘレナ","content":"${PlayerName}！${PlayerName}、大丈夫！？","voice":["vo_event_404320802_04"],"voice_bank":"vo_event_43208","style":1,"background":2174,"log_type":1},{"step":6,"content":"彼女は恐怖に駆られ、慌てて屈み込むと、あなたの怪我の具合を確かめようとする。あなたは苦しげに息をした。","style":3,"background":2174,"log_type":1},{"step":7,"content":"だが、まさにその時——","style":3,"background":2174,"log_type":1},{"step":8,"content":"（赤い光＋銃声）","style":18,"background":2174,"log_type":1},{"step":9,"content":"ヘレナは一言も発さず、崩れるように倒れた。","style":3,"background":2174,"log_type":1},{"step":10,"content":"あなたが胸の傷を押さえながら見上げると、視線は濃い煙と揺らめく炎に遮られた。","style":3,"background":2174,"log_type":1},{"step":11,"content":"火の海の中に漆黒の人影が見える。その銃口は、あなたに向けられているようだった。","style":3,"background":2174,"log_type":1},{"step":12,"speaker":"しゃがれた声","content":"ディス——万歳！","voice":["vo_event_404320802_11"],"voice_bank":"vo_event_43208","style":1,"background":2174,"log_type":1},{"step":13,"content":"（黒い画面）","style":18,"background":10000,"log_type":1},{"step":14,"content":"（赤い光＋銃声）","style":18,"background":10000,"log_type":1}]}