{"id":1060103,"chapter_id":1060103,"scene_id":1,"steps":[{"step":1,"content":"「距離を置いて、彼女を傷つけるな」それがあなたが出発前に警備兵たちに出した唯一の命令だった。","style":3,"background":1031,"log_type":1,"src_id":160103001,"trial_step":1},{"step":2,"speaker":"ナイチンゲール","content":"しかし、彼女にはブラックリングを抑えるほどの幻覚能力があります……","voice":["vo_trial_60103_1_2"],"voice_bank":"vo_hameier_trial","style":1,"background":1031,"log_type":1,"src_id":160103002,"trial_step":2},{"step":3,"content":"私はMBCCの立場を背くことはしない。それについては信じてくれるか？","style":2,"background":1031,"log_type":1,"src_id":160103003,"trial_step":3},{"step":4,"speaker":"ナイチンゲール","content":"もちろんです。","voice":["vo_trial_60103_1_4"],"voice_bank":"vo_hameier_trial","style":1,"background":1031,"log_type":1,"src_id":160103004,"trial_step":4},{"step":5,"content":"では私の判断も信じてくれ。MBCCもハーメルも納得のいく解決方法を見つける。","style":2,"background":1031,"log_type":1,"src_id":160103005,"trial_step":5},{"step":6,"content":"反抗と自己犠牲の二択で、彼女はいつも後者を選ぶ。","style":2,"background":1031,"log_type":1,"src_id":160103006,"trial_step":6},{"step":7,"content":"舞台へ戻り、自分の思うままに踊る——これは彼女が自分のために出した唯一の選択だ。私もそれを叶えてあげたい。","style":2,"background":1031,"log_type":1,"src_id":160103007,"trial_step":7},{"step":8,"content":"前方にいる警備兵からの位置情報で、あなたとナイチンゲールたちはカーニバルから1km離れたところで、ようやくハーメルに追いついた。","style":3,"background":1037,"log_type":1,"src_id":160103009,"trial_step":9},{"step":9,"content":"早めに到着した警備兵たちはハーメルの後ろについている。あなたの命令を守り、彼らはずっと一定の距離を保っている。","style":3,"background":1037,"log_type":1,"src_id":160103010,"trial_step":10},{"step":10,"options":["ハーメル、待ってくれ！私と話し合ってくれないか？"],"style":6,"background":1037,"log_type":1,"src_id":160103011,"trial_step":11,"course":3,"choices":[{"text":"ハーメル、待ってくれ！私と話し合ってくれないか？","goto":12}]},{"step":11,"content":"彼女はもう誰の声も聞こえないかのように、心虚ろにカーニバルの方へゆっくりと歩き続ける。","style":3,"background":1037,"log_type":1,"src_id":160103012,"trial_step":12},{"step":12,"content":"ハーメル、あなたが本当に求めているものが分かった。あなたは自分を受け入れてくれる舞台が欲しいのだ。","style":2,"background":1037,"log_type":1,"src_id":160103013,"trial_step":13},{"step":13,"content":"彼女は振り返らない。","style":3,"background":1037,"log_type":1,"src_id":160103014,"trial_step":14},{"step":14,"content":"ハーメル！","style":2,"background":1037,"log_type":1,"src_id":160103015,"trial_step":15},{"step":15,"content":"錆の川は汚水と汚泥に満ちているが、ハーメルの足が汚れることはない。","style":3,"background":1037,"log_type":1,"src_id":160103016,"trial_step":16},{"step":16,"content":"彼女は帰路を辿る幽霊のように軽く浮き、廃墟と化したブラックリングの遺跡へと近づいていく。","style":3,"background":1037,"log_type":1,"src_id":160103017,"trial_step":17},{"step":17,"speaker":"幽影","content":"無駄だ……","voice":["vo_trial_60103_1_18"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160103018,"trial_step":18},{"step":18,"content":"見慣れた黒影が再びあなたの前に立ち塞がる。","style":3,"background":1037,"log_type":1,"src_id":160103019,"trial_step":19},{"step":19,"speaker":"幽影","content":"彼女はただあそこへ帰りたいだけだ。誰にも彼女を止めることはできない。","voice":["vo_trial_60103_1_20"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160103020,"trial_step":20},{"step":20,"speaker":"幽影","content":"誰にも——","voice":["vo_trial_60103_1_21"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160103021,"trial_step":21},{"step":21,"content":"幽影の言葉と共に、青色の幻境が視界を遮った。","style":3,"background":711,"log_type":1,"src_id":160103022,"trial_step":22},{"step":22,"content":"全ての人が深海のような幻に包まれた。幽影が浮かび上がると、幻覚が急速に広まって全ての道を塞ぎ、ハーメルの姿も完全に隠された。","style":3,"background":711,"log_type":1,"src_id":160103023,"trial_step":23},{"step":23,"content":"またお前か……ハーメルの負の感情から生み出された幽影だな？今度は何をする気だ。","style":2,"background":711,"log_type":1,"src_id":160103024,"trial_step":24},{"step":24,"speaker":"幽影","content":"あなたたちを彼女には近づけさせない。","voice":["vo_trial_60103_1_25"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103025,"trial_step":25},{"step":25,"options":["私はただ彼女を助けたいだけだ"],"style":6,"background":711,"log_type":1,"src_id":160103026,"trial_step":26,"course":3,"choices":[{"text":"私はただ彼女を助けたいだけだ","goto":27}]},{"step":26,"content":"私は夢の中で彼女の過去を見た。カーニバルへ戻りたい気持ちを理解している。","style":2,"background":711,"log_type":1,"src_id":160103027,"trial_step":27},{"step":27,"speaker":"幽影","content":"はは、理解しているだと……","voice":["vo_trial_60103_1_28"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103028,"trial_step":28},{"step":28,"speaker":"幽影","content":"彼女は何度もその言葉に騙されたんだ。二度と信じるものか——","voice":["vo_trial_60103_1_29"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103029,"trial_step":29},{"step":29,"content":"シュッ！あなたと言い争うこともなく、幽影はいきなり攻撃を仕掛けた。","style":3,"background":711,"log_type":1,"src_id":160103030,"trial_step":30},{"step":30,"speaker":"ナイチンゲール","content":"局長、危ない！","voice":["vo_trial_60103_1_31"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103031,"trial_step":31},{"step":31,"content":"ナイチンゲールが迅速に銃を放ち、触手の攻撃を防ぐ。","style":3,"background":711,"log_type":1,"src_id":160103032,"trial_step":32},{"step":32,"speaker":"幽影","content":"あなたは優れた副官、命令に従う部下、そしてコンビクトたちがいる……彼らはあなたを友人だと思い、その選択を認めてくれる……","voice":["vo_trial_60103_1_33"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103033,"trial_step":33},{"step":33,"speaker":"幽影","content":"だがハーメルは？","voice":["vo_trial_60103_1_34"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103034,"trial_step":34},{"step":34,"content":"幽影は左右に揺れ、悲痛と怒りの混じった語気であなたを問い詰める。","style":3,"background":711,"log_type":1,"src_id":160103035,"trial_step":35},{"step":35,"speaker":"幽影","content":"ハーメルには自分を理解する家族がいない。自分を認めてくれる友人もいない。","voice":["vo_trial_60103_1_36"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103036,"trial_step":36},{"step":36,"speaker":"幽影","content":"23年前のディスしか知らない彼女にとって、今のディスシティは見慣れた場所さえない。","voice":["vo_trial_60103_1_37"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103037,"trial_step":37},{"step":37,"speaker":"幽影","content":"あなたたちは死瞳を殲滅し、全ての観客を奪った。彼女に残されたのは……カーニバルしかない……","voice":["vo_trial_60103_1_38"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103038,"trial_step":38},{"step":38,"content":"幽影は再びあなたへ近づく。ナイチンゲールは躊躇うことなく銃を構えた。","style":3,"background":711,"log_type":1,"src_id":160103039,"trial_step":39},{"step":39,"options":["待て、話を続けさせてくれ"],"style":6,"background":711,"log_type":1,"src_id":160103040,"trial_step":40,"course":3,"choices":[{"text":"待て、話を続けさせてくれ","goto":41}]},{"step":40,"content":"目の前のクラゲは言動が激しくハーメルの性格と真逆ではあるが、本質はハーメルの負の感情の持ち主だ。","style":3,"background":711,"log_type":1,"src_id":160103041,"trial_step":41},{"step":41,"content":"あれが話したことは、ハーメルが口に出せなかった本当の気持ちかもしれない。","style":3,"background":711,"log_type":1,"src_id":160103042,"trial_step":42},{"step":42,"speaker":"幽影","content":"悲しみも、滅びも、脆さも——これはディスの未来、美の予言、彼女が感じた全てだ！","voice":["vo_trial_60103_1_43"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103043,"trial_step":43},{"step":43,"speaker":"幽影","content":"ダンサーの手足を拘束するようなことも、その美しさを讃えないことも、檻に戻すことも許されない！","voice":["vo_trial_60103_1_44"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103044,"trial_step":44},{"step":44,"speaker":"幽影","content":"ダンサーは舞台へ戻るべきだ！！！","voice":["vo_trial_60103_1_45"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103045,"trial_step":45},{"step":45,"content":"その言葉と共に、幽影はその場で旋回し始め、青色の幻境も歪んで変化していく。","style":3,"background":711,"log_type":1,"src_id":160103046,"trial_step":46},{"step":46,"content":"歪む景色にあなたは生理的な嫌悪感を覚える。","style":3,"background":711,"log_type":1,"src_id":160103047,"trial_step":47},{"step":47,"content":"彼女を捕まえにきたわけではない……","style":2,"background":711,"log_type":1,"src_id":160103048,"trial_step":48},{"step":48,"content":"幽影はあなたに説明する機会を与えず、幻境をさらに強化させた。視覚的な苦痛だけではなく、海の怪物が呻くような声も加わり、あなたの目眩がより強くなる。","style":3,"background":711,"log_type":1,"src_id":160103049,"trial_step":49},{"step":49,"content":"被害を受けたのはあなただけではない。警備兵も、ナイチンゲールまでが不調を訴える。","style":3,"background":711,"log_type":1,"src_id":160103050,"trial_step":50},{"step":50,"content":"枷が以前感じたことのある痛みを受け取った。何かが新たに起こっているようだ。","style":3,"background":711,"log_type":1,"src_id":160103051,"trial_step":51},{"step":51,"speaker":"ハーメル","content":"またあなたたちのために踊りに来ました。わたしのこと、覚えていますか？","voice":["vo_trial_60103_1_52"],"voice_bank":"vo_hameier_trial","style":1,"background":10006,"log_type":1,"src_id":160103052,"trial_step":52},{"step":52,"content":"ハーメルは誰もいないカーニバルの廃墟へ向かって微笑んだ。その笑みの中にはどこか懐かしさが含まれている。それと同時に、多くの彷徨う死瞳が、カーニバルの外で空に向かい頭を上げた。","style":3,"background":10006,"log_type":1,"src_id":160103053,"trial_step":53},{"step":53,"speaker":"彷徨う死瞳","content":"ハーメル……踊って……私たちのために……声をかけて……","voice":["vo_trial_60103_1_54"],"voice_bank":"vo_hameier_trial","style":1,"background":10006,"log_type":1,"src_id":160103054,"trial_step":54},{"step":54,"content":"彼らはハーメルの名前を繰り返しながら同じ方向へ向かう。","style":3,"background":10006,"log_type":1,"src_id":160103055,"trial_step":55},{"step":55,"content":"これ以上長引かせるわけにはいかない。カーニバルに集まり続ける死瞳たちを止めるため、そしてハーメルの精神状態のためにも、このクラゲとは決着をつけなければいけない。","style":3,"background":711,"log_type":1,"src_id":160103056,"trial_step":56},{"step":56,"content":"お前がハーメルの一部であるかもしれないと思い、ハーメルに影響することを危惧して手出しをしてこなかったが。","style":2,"background":711,"log_type":1,"src_id":160103057,"trial_step":57},{"step":57,"content":"お前が私と話し合う気がないなら、無理矢理協力させるしかない。","style":2,"background":711,"log_type":1,"src_id":160103058,"trial_step":58},{"step":58,"options":["枷を発動する"],"style":6,"background":711,"log_type":1,"src_id":160103059,"trial_step":59,"course":3,"choices":[{"text":"枷を発動する","goto":60}]},{"step":59,"content":"あなたは右手を伸ばし、手のひらから赤い光を放った。だが幽影に触れた瞬間、それは水泡と化す。<color=#fb9259>まさか、枷が効かないのか？</color>","style":3,"background":711,"log_type":1,"src_id":160103060,"trial_step":60},{"step":60,"speaker":"ナイチンゲール","content":"局長、その泡はただの幻術です。奴の力は明らかに弱まっています。もう一度やれば必ず……！！","voice":["vo_trial_60103_1_61"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103061,"trial_step":61},{"step":61,"speaker":"幽影","content":"黙れ！誰にもハーメルの邪魔はさせない！","voice":["vo_trial_60103_1_62"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103062,"trial_step":62},{"step":62,"content":"その黒い幻影は身体を伸ばしながら空中に飛び上がり、周囲の全てを巻き込むように風の流れを操った。","style":3,"background":711,"log_type":1,"src_id":160103063,"trial_step":63},{"step":63,"content":"罪のない参戦者たちが幻境に巻き込まれ、瓦礫、小石、幻影……中心にいるあなた以外の全てが幽影の幻境と共に回り始める。","style":3,"background":711,"log_type":1,"src_id":160103064,"trial_step":64},{"step":64,"options":["枷を発動する"],"style":6,"background":711,"log_type":1,"src_id":160103065,"trial_step":65,"course":3,"choices":[{"text":"枷を発動する","goto":66}]},{"step":65,"content":"泡があなたの手のひらを包み、枷の赤い光を飲み込んだ。幽影はあなたの前に立ち塞がる。","style":3,"background":711,"log_type":1,"src_id":160103066,"trial_step":66},{"step":66,"speaker":"幽影","content":"あなたは本当に彼女を理解し、受け入れるつもりか？ならばその枷は何だ？","voice":["vo_trial_60103_1_67"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103067,"trial_step":67},{"step":67,"content":"枷は彼女の狂瞳病を抑え、精神状態の悪化を防ぐことができる。","style":2,"background":711,"log_type":1,"src_id":160103068,"trial_step":68},{"step":68,"speaker":"幽影","content":"だが狂瞳病がもたらした幻覚も、彼女のダンスの一部なのだ！","voice":["vo_trial_60103_1_69"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103069,"trial_step":69},{"step":69,"content":"だから私は行かなければならない！彼女の精神を蝕み狂瞳病を悪化させる死瞳より、枷を使い不測の事態を防げる私の方が、観客として相応しい。","style":2,"background":711,"log_type":1,"src_id":160103070,"trial_step":70},{"step":70,"speaker":"幽影","content":"あ……あなたは彼女を捕まえに来たのではないのか？","voice":["vo_trial_60103_1_71"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103071,"trial_step":71},{"step":71,"content":"彼女を連れ戻したいとは思うが、何よりその願いを叶えてあげたい。","style":2,"background":711,"log_type":1,"src_id":160103072,"trial_step":72},{"step":72,"content":"彼女は憂いを帯びたダンスを理解できる観客を望んでいた。死瞳を惑わすのをやめさせ、代わりに私が彼女の観客となろう。彼女が感じた世界はたとえどのようなものであれ、ハーメルのダンスである限り、私は見届ける。","style":2,"background":711,"log_type":1,"src_id":160103073,"trial_step":73},{"step":73,"speaker":"幽影","content":"私心も、利用することも、無理強いすることもないのか？彼女が踊りたいものを踊らせるのか？","voice":["vo_trial_60103_1_74"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103074,"trial_step":74},{"step":74,"content":"もちろんだ。","style":2,"background":711,"log_type":1,"src_id":160103075,"trial_step":75},{"step":75,"content":"気が済むまで踊らせてやる。","style":2,"background":711,"log_type":1,"src_id":160103076,"trial_step":76},{"step":76,"speaker":"幽影","content":"気が済むまで……","voice":["vo_trial_60103_1_77"],"voice_bank":"vo_hameier_trial","style":1,"background":711,"log_type":1,"src_id":160103077,"trial_step":77},{"step":77,"content":"クラゲ状の黒影は顔こそないものの、警戒心を少し緩めたのが分かった。","style":3,"background":711,"log_type":1,"src_id":160103078,"trial_step":78},{"step":78,"content":"あなたの手のひらから赤いトゲが広がっていく。今度は幻覚に干渉されることはない。","style":3,"background":711,"log_type":1,"src_id":160103080,"trial_step":80},{"step":79,"content":"ハーメルはずっと他人の気持ちを優先的に考え、自分の最も強い願いを心の奥深くに隠していた。","style":2,"background":711,"log_type":1,"src_id":160103081,"trial_step":81},{"step":80,"content":"戸惑い、迷い、孤独……彼女の悪夢を私に見せてくれて、彼女の代わりに話してくれてありがとう。","style":2,"background":711,"log_type":1,"src_id":160103082,"trial_step":82},{"step":81,"content":"枷のトゲは幽影と混ざり合い、少し力を入れただけで黒い煙と化して消えた。","style":3,"background":711,"log_type":1,"src_id":160103083,"trial_step":83},{"step":82,"content":"幽影の消滅とともに、青色の幻境もだんだんと消えていく。深夜に目覚めてから追い続けてきたせいで、幻境の外はもう夜明けを迎えていた。","style":3,"background":10000,"log_type":1,"src_id":160103084,"trial_step":84},{"step":83,"speaker":"ナイチンゲール","content":"局長、本当に一人で行くつもりですか？","voice":["vo_trial_60103_1_86"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160103086,"trial_step":86},{"step":84,"content":"空中に巻き上げられた全ての人は、そっと地面に下ろされた。","style":3,"background":1037,"log_type":1,"src_id":160103087,"trial_step":87},{"step":85,"content":"ハーメルは最も負の側面を強くしても、誰も傷つけようとせず、MBCCに損害をもたらすこともなかった。","style":3,"background":1037,"log_type":1,"src_id":160103088,"trial_step":88},{"step":86,"content":"心配するな。枷があるから私は大丈夫だ。ブラックリングが活動していたカーニバルからも出られたのだ。その廃墟に私が閉じ込められるわけがないだろう？","style":2,"background":1037,"log_type":1,"src_id":160103089,"trial_step":89},{"step":87,"content":"私が戻るまで、あなたたちはこの場で待機してくれ。","style":2,"background":1037,"log_type":1,"src_id":160103090,"trial_step":90},{"step":88,"speaker":"ナイチンゲール","content":"ですが……","voice":["vo_trial_60103_1_91"],"voice_bank":"vo_hameier_trial","style":1,"background":1037,"log_type":1,"src_id":160103091,"trial_step":91},{"step":89,"content":"副官はまだ安心できないようだ。","style":3,"background":1037,"log_type":1,"src_id":160103092,"trial_step":92},{"step":90,"content":"私の選択を信じると、そう約束してくれたのではなかったか？","style":2,"background":1037,"log_type":1,"src_id":160103093,"trial_step":93},{"step":91,"content":"私はただダンスを見に行くだけだ。それが終われば、目を覚ましたダンサーを連れて帰る。","style":2,"background":1037,"log_type":1,"src_id":160103094,"trial_step":94}]}