{"id":4112,"chapter_id":4,"scene_id":412,"steps":[{"step":1,"speaker":"ホロ","content":"——うっ！！","voice":["vo_cgplot_4112001"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":2,"content":"汚泥の化身が消え去る。ホロは影を振りほどき、ゾーヤの懐で気を失った。","style":3,"background":405,"log_type":1},{"step":3,"options":["大丈夫か？"],"jump":[4],"style":6,"background":405,"log_type":1},{"step":4,"speaker":"ゾーヤ","content":"ホロは平気だ。これより何倍もひどい傷を負ったことがある。","voice":["vo_cgplot_4112004"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":5,"speaker":"ゾーヤ","content":"帰ってくるさ。待ってる人がいることを、彼女は心得ているからな。","voice":["vo_cgplot_4112005"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":6,"speaker":"ゾーヤ","content":"次は、あいつの番だ——","voice":["vo_cgplot_4112006"],"voice_bank":"vo_cgplot_04","style":1,"background":405,"log_type":1},{"step":7,"content":"彼女が立ち上がり、開かれた石壇を見る。","style":3,"background":405,"log_type":1}]}