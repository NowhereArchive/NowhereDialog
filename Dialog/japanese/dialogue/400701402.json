{"id":400701402,"chapter_id":50019,"scene_id":51909,"steps":[{"step":1,"speaker":"シザーフリーク","content":"どこに隠した？どこに隠した！？","voice":["vo_event_400701402_01"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":2,"speaker":"シザーフリーク","content":"腹の中か？頭の中か？何処にある、切り裂いてやる！","voice":["vo_event_400701402_02"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":3,"content":"相手は叫びながら向かってくる。あなたが無意識に手を上げると、その狂った者は反射的に動きを止めた。","style":3,"background":2075,"log_type":1},{"step":4,"speaker":"シザーフリーク","content":"これは！？ウウッ！","voice":["vo_event_400701402_04"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":5,"content":"相手は突然怯えた表情を浮かべ、それを見たあなたは勇気を奮い立たせた。","style":3,"background":2075,"log_type":1},{"step":6,"options":["負けるものか！"],"jump":[7],"style":6,"background":2075,"log_type":1},{"step":9,"content":"だが、何も起こらなかった。あなたが何故手を上げているのか分からず、相手も少し困惑しているようだ。","style":3,"background":2075,"log_type":1},{"step":10,"speaker":"シザーフリーク","content":"……","voice":["vo_event_400701402_09"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":11,"speaker":"%u","content":"……","style":2,"background":2075,"log_type":1},{"step":12,"speaker":"%u","content":"だから言っただろう……私は何も覚えていないと……","style":2,"background":2075,"log_type":1},{"step":13,"content":"短い沈黙の後、あなたは相手よりも早く動き出した。","style":3,"background":2075,"log_type":1},{"step":14,"options":["走れ！","後ろを見ろ！ハサミだ！"],"jump":[15,15],"style":6,"background":2075,"log_type":1},{"step":15,"content":"あなたは後ろを指差して大声で叫び、そのまま何も考えずに身を翻して走る。","style":3,"background":2075,"log_type":1},{"step":16,"content":"しかし、一歩も進まないうちに地面に倒れ込んでしまった。暗闇の中で、奇妙な髪の毛があなたの足首に巻きついている。","style":3,"background":2075,"log_type":1},{"step":17,"speaker":"シザーフリーク","content":"逃げられない、お前も同じ、逃げられない！！アァ——","voice":["vo_event_400701402_17"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":20,"content":"チリン——","style":3,"background":10000,"log_type":1},{"step":21,"content":"背後で光が突如放たれた。","style":3,"background":10000,"log_type":1},{"step":22,"speaker":"シザーフリーク","content":"？？","voice":["vo_event_400701402_21"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":23,"content":"あなたはゆっくりと目を開けた。霧が急速に晴れ、あの得体の知れない髪が、光を忌避する虫のように四散して逃げていく。","style":3,"background":2075,"log_type":1},{"step":24,"content":"シザーフリークも例外ではなかった。叫び声をあげながら、霧と共に街角に消えていった。","style":3,"background":2075,"log_type":1},{"step":25,"content":"後ろの店のドアが誰かによって開けられ、心地よいカウベルの音があなたの耳に響く。","style":3,"background":2075,"log_type":1},{"step":26,"speaker":"？？","content":"……どうしてここに？","voice":["vo_event_400701402_25"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":27,"speaker":"？？","content":"わたしが仕事から帰ってくるまで、家で休んで待っているように言ったじゃないですか。","voice":["vo_event_400701402_26"],"voice_bank":"vo_event_07014","style":1,"background":2075,"log_type":1},{"step":29,"content":"なんて耳に心地よい声なのだろう。それに続いて淡い香りが漂ってきて、あなたの乱れた呼吸を穏やかにしてくれる。","style":3,"background":4118,"log_type":1},{"step":30,"content":"女性はあなたの前に来て、手で乱れた髪を整えてくれた。その声には労わる気持ちが深く込められている。","style":3,"background":4119,"log_type":1},{"step":32,"speaker":"？？","content":"……またこんなにボサボサになってしまって。このまま帰らせるわけにはいきませんね……","voice":["vo_event_400701402_29"],"voice_bank":"vo_event_07014","style":1,"background":4122,"log_type":1},{"step":33,"speaker":"？？","content":"さあ、いらっしゃい。帰る前に、わたしが手入れしてさしあげます。","voice":["vo_event_400701402_30"],"voice_bank":"vo_event_07014","style":1,"background":4122,"log_type":1}]}