{"id":1220102,"chapter_id":1220102,"scene_id":1,"steps":[{"step":1,"content":"管理局の警報がまた鳴り響いた。3秒ほど間を置いて、あなたは内線電話を取った。","style":3,"background":10000,"log_type":1,"src_id":320102001,"trial_step":1},{"step":2,"options":["何があった？"],"style":6,"background":107,"log_type":1,"src_id":320102002,"trial_step":2,"course":3,"choices":[{"text":"何があった？","goto":3}]},{"step":3,"speaker":"ナイチンゲール","content":"ヘラが、また脱獄しました……","style":1,"background":107,"log_type":1,"src_id":320102003,"trial_step":3},{"step":4,"content":"はぁ……また彼女か。ナインティナインは？","style":2,"background":107,"log_type":1,"src_id":320102004,"trial_step":4},{"step":5,"speaker":"ナイチンゲール","content":"ナインティナインはいますが、何も教えてくれません。","style":1,"background":107,"log_type":1,"src_id":320102005,"trial_step":5},{"step":6,"content":"……分かった、今行く。","style":2,"background":107,"log_type":1,"src_id":320102006,"trial_step":6},{"step":7,"content":"独房区域に到着すると、すでにナイチンゲールが扉を守っていた。扉の周りでは後方部隊の者たちが忙しくしている。","style":3,"background":17,"log_type":1,"src_id":320102007,"trial_step":7},{"step":8,"content":"177番独房の扉は内側から破られており、電子部品は今も火花を散らしている。一見して、この被害は明らかにナインティナインの仕業だと分かる。","style":3,"background":17,"log_type":1,"src_id":320102008,"trial_step":8},{"step":9,"content":"しかし、不思議なことに、ナインティナインは片隅に黙って座り、眠たそうにまぶたを擦っている——彼女が脱獄に大きな役割を果たしたことが示唆されているにもかかわらずだ。","style":3,"background":17,"log_type":1,"src_id":320102009,"trial_step":9},{"step":10,"content":"どうにも奇妙だ。ヘラが脱獄して、ナインティナインをここに置いておくはずがない。","style":3,"background":17,"log_type":1,"src_id":320102010,"trial_step":10},{"step":11,"content":"もちろん、何か裏があるなら話は別だが。","style":3,"background":17,"log_type":1,"src_id":320102011,"trial_step":11},{"step":12,"content":"ナイチンゲール、他に何かトラブルは起きていないか？","style":2,"background":17,"log_type":1,"src_id":320102012,"trial_step":12},{"step":13,"content":"あなたはナイチンゲールに小声で尋ねる。","style":3,"background":17,"log_type":1,"src_id":320102013,"trial_step":13},{"step":14,"speaker":"ナイチンゲール","content":"情報部はすでに街の監視カメラの映像を確認しておりますが……トラブルどころか、管理局から逃げ出したヘラの姿さえ見つかっておりません。","style":1,"background":17,"log_type":1,"src_id":320102014,"trial_step":14},{"step":15,"content":"ナイチンゲールの話の続きはあまり聞けなかった。なぜなら、隅に座っているナインティナインが目を開けてあなたを見つめ、二度瞬きをしたからだ。","style":3,"background":17,"log_type":1,"src_id":320102015,"trial_step":15},{"step":16,"content":"少しの間、あなたはナインティナインとそうやって顔を見合わせていたが、彼女が内緒話をしたいということに、はっと気がついた。","style":3,"background":17,"log_type":1,"src_id":320102016,"trial_step":16},{"step":17,"content":"ナイチンゲールはあなたのおかしい様子に気づき、独房に振り向こうとしたところを、彼女を引き寄せ、ある座標を小声で教えた。","style":3,"background":17,"log_type":1,"src_id":320102017,"trial_step":17},{"step":18,"speaker":"ナイチンゲール","content":"ヘラの居場所ですか？","style":1,"background":17,"log_type":1,"src_id":320102018,"trial_step":18},{"step":19,"content":"そう、彼女はここにいるようだ。今のうちに急げ。","style":2,"background":17,"log_type":1,"src_id":320102019,"trial_step":19},{"step":20,"speaker":"ナイチンゲール","content":"私一人で、ですか？","style":1,"background":17,"log_type":1,"src_id":320102020,"trial_step":20},{"step":21,"content":"あなたの腕であれば、ヘラを連れ戻すのは簡単だろう。私は沈黙しているナインティナインに対応する。","style":2,"background":17,"log_type":1,"src_id":320102021,"trial_step":21},{"step":22,"content":"ナイチンゲールは迷わず頷いた。","style":3,"background":17,"log_type":1,"src_id":320102022,"trial_step":22},{"step":23,"speaker":"ナイチンゲール","content":"了解しました。すぐに出発します。","style":1,"background":17,"log_type":1,"src_id":320102023,"trial_step":23},{"step":24,"content":"ナイチンゲールがいなくなった後、あなたは手を叩いて後方部隊の全員に撤退するように合図をした。","style":3,"background":17,"log_type":1,"src_id":320102024,"trial_step":24},{"step":25,"content":"言ってくれ。今回は何を企んでいる？","style":2,"background":17,"log_type":1,"src_id":320102025,"trial_step":25},{"step":26,"content":"ナインティナインは黙ったまま、一枚のメモを差し出した。","style":3,"background":17,"log_type":1,"src_id":320102026,"trial_step":26},{"step":27,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":28,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":29,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":30,"options":["選択肢1"],"jump":[5],"style":6,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":31,"content":"＊","style":18,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":32,"options":["選択肢1","選択肢2"],"jump":[7,9],"style":4,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":33,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":34,"content":"＊","style":3,"log_type":1,"src_id":1,"trial_step":27,"course":6},{"step":35,"content":"「フンッ！あたしを閉じ込めることも、見つけることもできないもんだ！」","style":3,"background":17,"log_type":1,"src_id":320102028,"trial_step":28},{"step":36,"content":"筆跡は歪だが、挑発は強い。","style":3,"background":17,"log_type":1,"src_id":320102029,"trial_step":29},{"step":37,"content":"あなたはため息をついた。この「脱獄」の性質がどのようなものか概ね分かってしまったからだ。","style":3,"background":17,"log_type":1,"src_id":320102030,"trial_step":30},{"step":38,"content":"これほど「雑な」脱獄を見るのは初めてだ……安心しろ。これなら彼女を連れ帰ることができる。","style":2,"background":17,"log_type":1,"src_id":320102031,"trial_step":31},{"step":39,"content":"30分後、あなたはシンジケートの南区にある廃棄された二階建ての建物の前に到着した。","style":3,"background":100,"log_type":1,"src_id":320102032,"trial_step":32},{"step":40,"content":"ヘラはこの中にいる。これは、枷が明確に教えてくれる情報だ。\nちなみに、先ほどナイチンゲールに伝えた座標は、真逆の方向にある。","style":3,"background":100,"log_type":1,"src_id":320102033,"trial_step":33},{"step":41,"content":"確かに、隠れるには悪くない場所だ……","style":2,"background":100,"log_type":1,"src_id":320102034,"trial_step":34},{"step":42,"content":"建物は荒廃しているが、中はかなり頑丈にできている。二階に上がると、あるドアが半開きになっていた。","style":3,"background":100,"log_type":1,"src_id":320102035,"trial_step":35},{"step":43,"content":"へ……","style":2,"background":105,"log_type":1,"src_id":320102036,"trial_step":36},{"step":44,"content":"ヘラの名前を呼ぼうとした時、部屋の中からゴソゴソと音が聞こえた。","style":3,"background":105,"log_type":1,"src_id":320102037,"trial_step":37},{"step":45,"speaker":"？？？","content":"ああもう——、一体どれほどの缶を集めたんだよ！","style":1,"background":105,"log_type":1,"src_id":320102038,"trial_step":38},{"step":46,"content":"ヘラの声だ。\n足音を抑えながら、できるだけ息を殺して近づき、扉の隙間から中を覗き込む。","style":3,"background":105,"log_type":1,"src_id":320102039,"trial_step":39},{"step":47,"content":"驚いたことに、家の中はかなり手入れが行き届いていて、家具や家電が全てきちんと陳列されている。","style":3,"background":105,"log_type":1,"src_id":320102040,"trial_step":40},{"step":48,"content":"扉脇の冷蔵庫には、小さなメモが幾つも貼られている。この歪な字は明らかにヘラの筆跡だ。全てナインティナインに教える生活の常識のようだ。","style":3,"background":105,"log_type":1,"src_id":320102041,"trial_step":41},{"step":49,"options":["彼女をからかう","そのまま入る"],"style":6,"background":105,"log_type":1,"src_id":320102042,"trial_step":42,"course":3,"choices":[{"text":"彼女をからかう","goto":43},{"text":"そのまま入る","goto":57}]},{"step":50,"content":"あなたは通信機に残っている演習の録音を探し出し、再生する。","style":3,"background":105,"log_type":1,"src_id":320102043,"trial_step":43},{"step":51,"speaker":"録音","content":"よく聞け！こちらはMBCC特殊作戦部隊だ。君はもう取り囲まれている！","style":11,"background":105,"log_type":1,"src_id":320102044,"trial_step":44},{"step":52,"speaker":"録音","content":"コンビクト全員！両手を頭の上に乗せ、抵抗せずに今すぐ出てこい！","style":11,"background":105,"log_type":1,"src_id":320102045,"trial_step":45},{"step":53,"speaker":"ヘラ","content":"くそっ、早すぎない！？","style":1,"background":105,"log_type":1,"src_id":320102046,"trial_step":46},{"step":54,"content":"寝室から雑然とした物音がして、微かにヘラの呟きが聞こえた。","style":3,"background":105,"log_type":1,"src_id":320102047,"trial_step":47},{"step":55,"content":"2分ほどして、寝室のドアが内側からゆっくりと押し開けられた。少女は用心深くドアの隙間から外を覗いた。","style":3,"background":105,"log_type":1,"src_id":320102048,"trial_step":48},{"step":56,"speaker":"ヘラ","content":"……","style":1,"background":105,"log_type":1,"src_id":320102049,"trial_step":49},{"step":57,"content":"……","style":2,"background":105,"log_type":1,"src_id":320102050,"trial_step":50},{"step":58,"speaker":"ヘラ","content":"……","style":1,"background":105,"log_type":1,"src_id":320102051,"trial_step":51},{"step":59,"content":"……","style":2,"background":105,"log_type":1,"src_id":320102052,"trial_step":52},{"step":60,"speaker":"ヘラ","content":"なんであんた一人なの？作戦部隊は？","style":1,"background":105,"log_type":1,"src_id":320102053,"trial_step":53},{"step":61,"content":"あなたは肩をすくめる。","style":3,"background":105,"log_type":1,"src_id":320102054,"trial_step":54},{"step":62,"speaker":"ヘラ","content":"このバカ！×××！意地悪者！！！","style":1,"background":105,"log_type":1,"src_id":320102055,"trial_step":55},{"step":63,"content":"騙されたことに気づいたヘラは、怒りで飛び跳ねた。","style":3,"background":105,"log_type":1,"src_id":320102056,"trial_step":56,"next":[65]},{"step":64,"content":"自分の息を殺し続け、そして寝室の扉の取っ手を慎重に開ける。","style":3,"background":105,"log_type":1,"src_id":320102057,"trial_step":57},{"step":65,"content":"部屋の中では、ヘラがスーツケースに自分の荷物を入れていた。部屋は彼女に荒らされ、服や小物が床のあちこちに散かしている。","style":3,"background":105,"log_type":1,"src_id":320102058,"trial_step":58},{"step":66,"content":"うっかり水のペットボトルを蹴ってしまい、人の気配に気づいたヘラが振り返って叫び声をあげる。","style":3,"background":105,"log_type":1,"src_id":320102059,"trial_step":59},{"step":67,"speaker":"ヘラ","content":"しまった！誰よ！！","style":1,"background":105,"log_type":1,"src_id":320102060,"trial_step":60},{"step":68,"speaker":"ヘラ","content":"……","style":1,"background":105,"log_type":1,"src_id":320102061,"trial_step":61},{"step":69,"content":"しかし、それがあなただと分かると、ヘラは顔を真っ赤にした。","style":3,"background":105,"log_type":1,"src_id":320102062,"trial_step":62},{"step":70,"speaker":"ヘラ","content":"あんた！いつ入ってきたの！","style":1,"background":105,"log_type":1,"src_id":320102063,"trial_step":63},{"step":71,"content":"ヘラは慌ててスーツケースを倒してしまい、せっかく片づけた荷物を全てぶちまけてしまった。","style":3,"background":105,"log_type":1,"src_id":320102064,"trial_step":64},{"step":72,"speaker":"ヘラ","content":"いや！いやいやいや！どうやってここを見つけたの？","style":1,"background":105,"log_type":1,"src_id":320102065,"trial_step":65},{"step":73,"speaker":"ヘラ","content":"ここに住んでること、誰も知るはずないのに！待って……まさかナインちゃんが！！！！","style":1,"background":105,"log_type":1,"src_id":320102066,"trial_step":66},{"step":74,"speaker":"ヘラ","content":"いつそんなことを学んだの！告げ口するなんて！","style":1,"background":105,"log_type":1,"src_id":320102067,"trial_step":67},{"step":75,"speaker":"ヘラ","content":"帰ったらとっちめてやる！あっ……！","style":1,"background":105,"log_type":1,"src_id":320102068,"trial_step":68},{"step":76,"content":"口を滑らせてしまったことに気づき、ヘラは慌てて口を塞いだ。","style":3,"background":105,"log_type":1,"src_id":320102069,"trial_step":69},{"step":77,"content":"あなたはため息をつく。","style":3,"background":105,"log_type":1,"src_id":320102070,"trial_step":70},{"step":78,"content":"だから、一体何をしに来た？","style":2,"background":105,"log_type":1,"src_id":320102071,"trial_step":71},{"step":79,"speaker":"ヘラ","content":"もちろん、荷造りして高飛びするためよ！","style":1,"background":105,"log_type":1,"src_id":320102072,"trial_step":72},{"step":80,"content":"高飛び？君一人でどこに行くんだ？","style":2,"background":105,"log_type":1,"src_id":320102073,"trial_step":73},{"step":81,"content":"あなたは彼女に近づいたが、ヘラはウサギのように慌てて後ろに飛び跳ねる。","style":3,"background":105,"log_type":1,"src_id":320102074,"trial_step":74},{"step":82,"speaker":"ヘラ","content":"知らない！","style":1,"background":105,"log_type":1,"src_id":320102075,"trial_step":75},{"step":83,"content":"そうか。では、あなたはともかく、ナインティナインはどうする？大切な家族を捨てて、一人で逃げるのか？","style":2,"background":105,"log_type":1,"src_id":320102076,"trial_step":76},{"step":84,"speaker":"ヘラ","content":"逃げるんじゃないよ！！そりゃ……そりゃ……","style":1,"background":105,"log_type":1,"src_id":320102077,"trial_step":77},{"step":85,"content":"ヘラは顔を真っ赤にして、必死に言い訳を考え悩んでいるのを見て、あなたは軽く笑った。","style":3,"background":105,"log_type":1,"src_id":320102078,"trial_step":78},{"step":86,"speaker":"ヘラ","content":"あたしは……前もって荷造りしてるだけよ！ナインちゃんはあまりに目立つから。知ってるでしょ！街に連れて行けば、すぐに大勢の人がケンカを吹っ掛けてくるの。","style":1,"background":105,"log_type":1,"src_id":320102079,"trial_step":79},{"step":87,"speaker":"ヘラ","content":"その常識のない頭でどんだけ迷惑かけて、どんだけの人を怒らせてきたか、あたしよりもあんたの方がよく知ってるでしょ！","style":1,"background":105,"log_type":1,"src_id":320102080,"trial_step":80},{"step":88,"content":"ああ、その通りだな。","style":2,"background":105,"log_type":1,"src_id":320102081,"trial_step":81},{"step":89,"content":"で、今はどうする？抵抗するのか？それとも、一緒に管理局に戻るか？","style":2,"background":105,"log_type":1,"src_id":320102082,"trial_step":82},{"step":90,"content":"ヘラは口を尖らせた。","style":3,"background":105,"log_type":1,"src_id":320102083,"trial_step":83},{"step":91,"speaker":"ヘラ","content":"フンッ！このヘラ様が負けを認めるよ……付き合ってあげる！","style":1,"background":105,"log_type":1,"src_id":320102084,"trial_step":84},{"step":92,"speaker":"ヘラ","content":"い、一緒に管理局に戻るから……","style":1,"background":105,"log_type":1,"src_id":320102085,"trial_step":85},{"step":93,"content":"ヘラが了承したのを見て、あなたは扉の傍に立ち、彼女をエスコートするように手を伸ばした。","style":3,"background":105,"log_type":1,"src_id":320102086,"trial_step":86},{"step":94,"content":"ヘラはその誘いを無視して、再びスーツケースに荷物を詰め込み、スーツケースの上に乗って全身の体重をかけて、ようやくスーツケースを閉じることに成功した。","style":3,"background":105,"log_type":1,"src_id":320102087,"trial_step":87},{"step":95,"speaker":"ヘラ","content":"ああ、そうだ！言っておくけど。","style":1,"background":105,"log_type":1,"src_id":320102088,"trial_step":88},{"step":96,"speaker":"ヘラ","content":"あんたのところにしばらく泊まるだけ！これは一時的なものよ！分かる？","style":1,"background":105,"log_type":1,"src_id":320102089,"trial_step":89},{"step":97,"speaker":"ヘラ","content":"あたしによく仕えるように！聞いてる？じゃないと、いつまでも今日のように逃げ出すんだから！","style":1,"background":105,"log_type":1,"src_id":320102090,"trial_step":90},{"step":98,"options":["はいはい、仰せのままに","質問してもいいか？"],"style":6,"background":105,"log_type":1,"src_id":320102091,"trial_step":91,"course":3,"choices":[{"text":"はいはい、仰せのままに","goto":92},{"text":"質問してもいいか？","goto":94}]},{"step":99,"speaker":"ヘラ","content":"フンッ、そうでないと！","style":1,"background":105,"log_type":1,"src_id":320102092,"trial_step":92},{"step":100,"speaker":"ヘラ","content":"なに！なんか言いたそうな顔してる。","style":1,"background":105,"log_type":1,"src_id":320102093,"trial_step":93,"next":[94]},{"step":101,"speaker":"ヘラ","content":"言いたいなら早く言ってよ！あたしがご機嫌なうちに！","style":1,"background":105,"log_type":1,"src_id":320102094,"trial_step":94},{"step":102,"content":"制服を正し、咳払いをして、ヘラに改めて尋ねた。","style":3,"background":105,"log_type":1,"src_id":320102095,"trial_step":95},{"step":103,"content":"「一時的に」うちに来てくれるというのは……それはもう友達になった、ということだよな？","style":2,"background":105,"log_type":1,"src_id":320102096,"trial_step":96},{"step":104,"content":"あなたの言葉を聞き、ヘラの頬が茹でたエビより赤くなった。","style":3,"background":105,"log_type":1,"src_id":320102097,"trial_step":97},{"step":105,"content":"彼女は頭を下げ、小声で何かを呟いた。","style":3,"background":105,"log_type":1,"src_id":320102098,"trial_step":98},{"step":106,"content":"どうした？よく聞こえないが。","style":2,"background":105,"log_type":1,"src_id":320102099,"trial_step":99},{"step":107,"content":"少女は顔を上げ、唇を小さく動かしたが、やはり声は聞こえない。","style":3,"background":105,"log_type":1,"src_id":320102100,"trial_step":100},{"step":108,"content":"うん——？","style":2,"background":105,"log_type":1,"src_id":320102101,"trial_step":101},{"step":109,"content":"わざと声を伸ばしてみる。","style":3,"background":105,"log_type":1,"src_id":320102102,"trial_step":102},{"step":110,"speaker":"ヘラ","content":"あのね……","style":1,"background":105,"log_type":1,"src_id":320102103,"trial_step":103},{"step":111,"content":"聞いてるよ。","style":2,"background":105,"log_type":1,"src_id":320102104,"trial_step":104},{"step":112,"content":"やがて、ヘラはあなたのからかいに耐え切れず、不機嫌に声を上げた。","style":3,"background":105,"log_type":1,"src_id":320102105,"trial_step":105},{"step":113,"speaker":"ヘラ","content":"あのさ！ありがとう！助けてくれて！ナインちゃんの感染を制御してくれてありがとう！！","style":1,"background":105,"log_type":1,"src_id":320102106,"trial_step":106},{"step":114,"content":"そう言ってヘラはスーツケースを引っ張り、後ろを振り返らずに外に飛び出していった。","style":3,"background":105,"log_type":1,"src_id":320102107,"trial_step":107},{"step":115,"content":"本当に……素直じゃないな。","style":2,"background":105,"log_type":1,"src_id":320102108,"trial_step":108},{"step":116,"content":"その時、扉をノックする音がした。振り返ると、ナイチンゲールが腕を組んだまま冷ややかにこちらを見つめていた。","style":3,"background":105,"log_type":1,"src_id":320102109,"trial_step":109},{"step":117,"speaker":"ナイチンゲール","content":"局長。ターゲットがあなたの指差した方向と反対方向にある建物の中にいる理由を教えていただけますか？","style":1,"background":105,"log_type":1,"src_id":320102110,"trial_step":110},{"step":118,"content":"心の中で「やばい」と叫んで、自分への言い訳を考える。","style":3,"background":105,"log_type":1,"src_id":320102111,"trial_step":111},{"step":119,"content":"えっと……おそらく、この前のナインティナインとの戦いで身体の回復に支障をきたしたようでな、方向感覚をまだ取り戻せていないんだ。","style":2,"background":105,"log_type":1,"src_id":320102112,"trial_step":112},{"step":120,"speaker":"ナイチンゲール","content":"……","style":1,"background":105,"log_type":1,"src_id":320102113,"trial_step":113},{"step":121,"speaker":"ナイチンゲール","content":"「ターゲットが追跡から逃れるために一時的に居場所を変え、処理が遅れることを懸念した局長が自ら捕えた」——正式な報告書にはこのように記載します。","style":1,"background":105,"log_type":1,"src_id":320102114,"trial_step":114},{"step":122,"content":"ありがとう、ナイチンゲール。","style":2,"background":105,"log_type":1,"src_id":320102115,"trial_step":115},{"step":123,"content":"結局、茶番に近い脱獄は半日もかからずに解決した。","style":3,"background":105,"log_type":1,"src_id":320102116,"trial_step":116},{"step":124,"content":"提出した報告書では、脱獄したヘラを逮捕し、シンジケートの南区にある隠れ家を発見したことを詳細に記録した。","style":3,"background":105,"log_type":1,"src_id":320102117,"trial_step":117},{"step":125,"content":"中にある盗品や証拠品は、ナイチンゲールと警備員たちが全て梱包して管理局に持ち帰った。","style":3,"background":105,"log_type":1,"src_id":320102118,"trial_step":118}]}