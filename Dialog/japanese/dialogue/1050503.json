{"id":1050503,"chapter_id":1050503,"scene_id":1,"steps":[{"step":1,"content":"ギィーッ——","style":3,"background":1041,"log_type":1,"src_id":150503001,"trial_step":1},{"step":2,"content":"背筋の凍りつくような音と共に、書斎のドアが開かれた。","style":3,"background":1041,"log_type":1,"src_id":150503002,"trial_step":2},{"step":3,"content":"数えきれないほどの写真や切り抜き、雑誌が目に入ってくる。それらは十台以上の本棚いっぱいに詰められていた。","style":3,"background":1041,"log_type":1,"src_id":150503003,"trial_step":3},{"step":4,"content":"その広さはMBCCの記録室の四分の一ほどに達する。","style":3,"background":1041,"log_type":1,"src_id":150503004,"trial_step":4},{"step":5,"speaker":"プレイヤー","content":"これが全部……","style":2,"background":1041,"log_type":1,"src_id":150503005,"trial_step":5},{"step":6,"content":"あなたが一冊のノートを手に取り、埃を振り落としてから開いた。","style":3,"background":1041,"log_type":1,"src_id":150503006,"trial_step":6},{"step":7,"speaker":"クロウ","content":"全部シンジケートの歴史だ。N.F.81年からN.F.114年までの出来事が記録されている。私や他の人の手によって、ね。","voice":["vo_trial_50503_1_7"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503007,"trial_step":7},{"step":8,"speaker":"クロウ","content":"シンジケートの英雄譚を消させないため、私は一生懸命残された資料を集めていた。","voice":["vo_trial_50503_1_8"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503008,"trial_step":8},{"step":9,"options":["いつからこれだけの資料を集めていた？"],"style":6,"background":1041,"log_type":1,"src_id":150503009,"trial_step":9,"course":3,"choices":[{"text":"いつからこれだけの資料を集めていた？","goto":10}]},{"step":10,"speaker":"クロウ","content":"ニューシティに来てからしばらくした後かな。私がまだ小さい時、家族と共にニューシティへと引っ越した。","voice":["vo_trial_50503_1_10"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503010,"trial_step":10},{"step":11,"speaker":"プレイヤー","content":"どうりで子供時代の写真の何枚かは、嬉しくない顔をしているわけだ。","style":2,"background":1041,"log_type":1,"src_id":150503011,"trial_step":11},{"step":12,"content":"書斎の壁を見ると、沈んだ顔をしたクロウの写真が何枚か目立っている。","style":3,"background":1041,"log_type":1,"src_id":150503012,"trial_step":12},{"step":13,"speaker":"クロウ","content":"そうだ！ニューシティは一見賑やかに見えるが、住んでみるととても退屈だからな！","voice":["vo_trial_50503_1_13"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503013,"trial_step":13},{"step":14,"speaker":"クロウ","content":"そしてテレビで危険に立ち向かう英雄たちや暗闇の中で燃える命を見た私は——","voice":["vo_trial_50503_1_14"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503014,"trial_step":14},{"step":15,"speaker":"クロウ","content":"ついに気づいたのだ。それこそがこの私、クロウが求めていたものだと。","voice":["vo_trial_50503_1_15"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503015,"trial_step":15},{"step":16,"speaker":"クロウ","content":"それからは文章を書くのが好きになって、そして十数年が過ぎた。","voice":["vo_trial_50503_1_16"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503016,"trial_step":16},{"step":17,"speaker":"クロウ","content":"ニューシティでの生活があまりにも退屈だからか、それとも久しぶりに故郷を見たかったのか。","voice":["vo_trial_50503_1_17"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503017,"trial_step":17},{"step":18,"speaker":"クロウ","content":"いつの間にか私は柳生の新聞社に入って、公式アカウントの専門ライターになっていた。","voice":["vo_trial_50503_1_18"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503018,"trial_step":18},{"step":19,"speaker":"クロウ","content":"はは……面白いことに、あそこではミーハーな内容もくだらない記事を書くのも、私より上手な人は誰もいなかったよ。","voice":["vo_trial_50503_1_19"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503019,"trial_step":19},{"step":20,"content":"クロウが指を一本立てて、興奮した顔で栄光の過去を喋り始めた。","style":3,"background":1041,"log_type":1,"src_id":150503020,"trial_step":20},{"step":21,"speaker":"クロウ","content":"そして一年が過ぎた。103年に私はシンジケートに派遣されたが、あそこはもう子供の頃のシンジケートではなくなっていた。","voice":["vo_trial_50503_1_21"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503021,"trial_step":21},{"step":22,"speaker":"クロウ","content":"ただ廃墟や戦火が広がり、無残な光景しか残っていなかった。","voice":["vo_trial_50503_1_22"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503022,"trial_step":22},{"step":23,"speaker":"クロウ","content":"その時、私はこの目で暗闇の中に燃える火を目撃したのだ。","voice":["vo_trial_50503_1_23"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503023,"trial_step":23},{"step":24,"options":["錆火に出会ったのか？"],"style":6,"background":1041,"log_type":1,"src_id":150503024,"trial_step":24,"course":3,"choices":[{"text":"錆火に出会ったのか？","goto":25}]},{"step":25,"speaker":"クロウ","content":"そうだ、よく分かったな！そして私は記者としてタダ飯を……いや、密着取材をさせてもらった。","voice":["vo_trial_50503_1_25"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503025,"trial_step":25},{"step":26,"speaker":"クロウ","content":"だがその時は不穏な空気が漂っていた。鉱山の作業員と涅槃が一触即発の状況となっていたからだ。涅槃は採掘機材を廃棄しようとしたから、従業員たちが反発するのも当然だ。","voice":["vo_trial_50503_1_26"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503026,"trial_step":26},{"step":27,"speaker":"クロウ","content":"全力で反抗した彼らは相手の計画を中止させ、あの威張っていた涅槃を交渉せざるを得ない状況まで追い込んだ。","voice":["vo_trial_50503_1_27"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503027,"trial_step":27},{"step":28,"speaker":"クロウ","content":"もちろん私も見ているだけではなかった。横断幕を作ってスローガンを書き、彼らと共に何台もの機械を取り戻したのだ。","voice":["vo_trial_50503_1_28"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503028,"trial_step":28},{"step":29,"speaker":"クロウ","content":"まさに完璧な物語だと、そう思わないか？","voice":["vo_trial_50503_1_29"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503029,"trial_step":29},{"step":30,"content":"あなたは頷いた。","style":3,"background":1041,"log_type":1,"src_id":150503030,"trial_step":30},{"step":31,"speaker":"プレイヤー","content":"しかし物語はこれで終わらなかった。","style":2,"background":1041,"log_type":1,"src_id":150503031,"trial_step":31},{"step":32,"speaker":"クロウ","content":"そうだ……英雄は悪者を退治し、微かな光が燃え盛る炎となって、暗闇に覆われた夜を照らした。","voice":["vo_trial_50503_1_32"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503032,"trial_step":32},{"step":33,"speaker":"クロウ","content":"残念ながら、どんなに猛る炎であっても嵐を前に消えるのが運命だ。W-31の一件の後、ブラックリングが爆発し、リーダーも行方不明となった。","voice":["vo_trial_50503_1_33"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503033,"trial_step":33},{"step":34,"speaker":"クロウ","content":"ニューシティに戻った私は英雄たちの偉業を宣伝し、彼らのことを全ての人が記憶しておくように尽力した。","voice":["vo_trial_50503_1_34"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503034,"trial_step":34},{"step":35,"speaker":"クロウ","content":"でも知っての通り、当時のニューシティでは涅槃に関する記事をいくら発表しても、すぐに消されてしまう。","voice":["vo_trial_50503_1_35"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503035,"trial_step":35},{"step":36,"speaker":"クロウ","content":"そして連中に呼び出され、「善意のアドバイス」を聞かされるのが日常茶飯事になった。","voice":["vo_trial_50503_1_36"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503036,"trial_step":36},{"step":37,"options":["何回呼び出されたんだ？"],"style":6,"background":1041,"log_type":1,"src_id":150503037,"trial_step":37,"course":3,"choices":[{"text":"何回呼び出されたんだ？","goto":38}]},{"step":38,"speaker":"クロウ","content":"ふっ、そうだな。家に戻る回数よりも多かったよ。ニューシティ治安局のオフィスなんか、目をつぶったままで自由に歩き回れるくらいだ。","voice":["vo_trial_50503_1_38"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503038,"trial_step":38},{"step":39,"content":"クロウが肩をすくめ、仕方ないという表情を見せた。","style":3,"background":1041,"log_type":1,"src_id":150503039,"trial_step":39},{"step":40,"speaker":"クロウ","content":"そりゃ連中にとって、英雄の記事を書いている私は目障りな存在だ。だから彼らはすぐ排除するように動き始めた。","voice":["vo_trial_50503_1_40"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503040,"trial_step":40},{"step":41,"speaker":"クロウ","content":"W-31に関する情報を数多く把握した私は、涅槃の特別部署「DRD」に狙われ、「ニューシティの治安かく乱」「度重なる公序良俗に反する行為」「偽情報の流布」などの罪を着せられた。","voice":["vo_trial_50503_1_41"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503041,"trial_step":41},{"step":42,"options":["それで？大丈夫だったのか？"],"style":6,"background":1041,"log_type":1,"src_id":150503042,"trial_step":42,"course":3,"choices":[{"text":"それで？大丈夫だったのか？","goto":43}]},{"step":43,"speaker":"クロウ","content":"大丈夫に決まっている。連中如き相手にしてもかすり傷で済むさ。","voice":["vo_trial_50503_1_43"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503043,"trial_step":43},{"step":44,"content":"クロウは何もなかったかのように、平然とした顔で手を振った。","style":3,"background":1041,"log_type":1,"src_id":150503044,"trial_step":44},{"step":45,"content":"果たしてそうだろうか。涅槃の秘密機関がそう簡単にターゲットを逃がすとは考えられない。","style":3,"background":1041,"log_type":1,"src_id":150503045,"trial_step":45},{"step":46,"speaker":"？？","content":"さっさと罪を認めたらどうだ？","voice":["vo_trial_50503_1_47"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503047,"trial_step":47},{"step":47,"speaker":"レイヴン","content":"ははっ。英雄の勇姿を記録することが「罪」ということなのだな？","voice":["vo_trial_50503_1_48"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503048,"trial_step":48},{"step":48,"speaker":"？？","content":"どうやら頭が悪いようだな。お前ら、罪を認める方法をそいつに教えてやれ。","voice":["vo_trial_50503_1_49"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503049,"trial_step":49},{"step":49,"speaker":"レイヴン","content":"ふっ、このような真似を繰り返せば繰り返すほど、彼らが英雄であることを証明するだけだ！","voice":["vo_trial_50503_1_50"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503050,"trial_step":50},{"step":50,"speaker":"？？","content":"連れて行け、頭を冷やさせろ。","voice":["vo_trial_50503_1_51"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503051,"trial_step":51},{"step":51,"speaker":"？？","content":"さっさと罪を認めたらどうだ？","voice":["vo_trial_50503_1_53"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503053,"trial_step":53},{"step":52,"speaker":"レイヴン","content":"私は記録した……彼らの偉業を……","voice":["vo_trial_50503_1_54"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503054,"trial_step":54},{"step":53,"speaker":"？？","content":"まったく、これほど愚かな者がいるとは。","voice":["vo_trial_50503_1_55"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503055,"trial_step":55},{"step":54,"speaker":"レイヴン","content":"あは、あははは……","voice":["vo_trial_50503_1_56"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503056,"trial_step":56},{"step":55,"speaker":"？？","content":"何を笑っている。正気を失ったのか？","voice":["vo_trial_50503_1_57"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503057,"trial_step":57},{"step":56,"speaker":"レイヴン","content":"そうだ……私が記録したのは英雄の物語だから……","voice":["vo_trial_50503_1_58"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503058,"trial_step":58},{"step":57,"speaker":"レイヴン","content":"お前らのような汚いネズミも……欠かせない存在なんだ……彼らの偉大さを、引き立てるからな……","voice":["vo_trial_50503_1_59"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503059,"trial_step":59},{"step":58,"speaker":"？？","content":"本当に狂ったようだ。","voice":["vo_trial_50503_1_60"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503060,"trial_step":60},{"step":59,"speaker":"？？","content":"死なない程度にやっておけ。","voice":["vo_trial_50503_1_61"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503061,"trial_step":61},{"step":60,"speaker":"？？","content":"さっさと罪を認めたらどうだ？","voice":["vo_trial_50503_1_63"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503063,"trial_step":63},{"step":61,"speaker":"レイヴン","content":"……","voice":["vo_trial_50503_1_64"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503064,"trial_step":64},{"step":62,"speaker":"レイヴン","content":"……ふ、ははは。お前らはシンジケートの英雄を恐れている……錆火に燃やされるのが怖いのだ……","voice":["vo_trial_50503_1_65"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503065,"trial_step":65},{"step":63,"speaker":"？？","content":"アバラも折られたのに、喚く気力が残っているとはな。","voice":["vo_trial_50503_1_66"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503066,"trial_step":66},{"step":64,"speaker":"？？","content":"これ以上相手をしても無駄だ。そいつを牢に入れておけ。","voice":["vo_trial_50503_1_67"],"voice_bank":"vo_raven_trial","style":1,"background":1030,"log_type":1,"src_id":150503067,"trial_step":67},{"step":65,"content":"そのような目に遭ってもこうしてあなたの前に立てる彼女は、まさに戦う詩人というべきだろう。","style":3,"background":1041,"log_type":1,"src_id":150503069,"trial_step":69},{"step":66,"speaker":"クロウ","content":"そんなに真剣な顔で読んでいるとは、何か興味深いものでも見つかったのかな？","voice":["vo_trial_50503_1_70"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503070,"trial_step":70},{"step":67,"content":"傍に居たクロウが近寄ってきたので、あなたは慌ててノートのページをめくった。","style":3,"background":1041,"log_type":1,"src_id":150503071,"trial_step":71},{"step":68,"speaker":"プレイヤー","content":"ただの記録だ。それより、なぜ先生になりたくなった？そういう職業に興味があるようには見えないが。","style":2,"background":1041,"log_type":1,"src_id":150503072,"trial_step":72},{"step":69,"speaker":"クロウ","content":"そうだな。DRDがあそこまでしつこくなかったら、私もそういう気持ちにならなかったかもしれない。","voice":["vo_trial_50503_1_73"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503073,"trial_step":73},{"step":70,"speaker":"クロウ","content":"打つ手をなくした連中は、私をニューシティとシンジケート近くの拘置所に閉じ込めた。","voice":["vo_trial_50503_1_74"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503074,"trial_step":74},{"step":71,"options":["居心地の悪い場所だろう？"],"style":6,"background":1041,"log_type":1,"src_id":150503075,"trial_step":75,"course":3,"choices":[{"text":"居心地の悪い場所だろう？","goto":76}]},{"step":72,"speaker":"クロウ","content":"そうだ！その環境はともかく、話し相手がいないのが一番辛かった。食事を持ってくる係でさえ、遠く離れた場所から飯を寄越すのだよ。","voice":["vo_trial_50503_1_76"],"voice_bank":"vo_raven_trial","style":1,"background":1041,"log_type":1,"src_id":150503076,"trial_step":76},{"step":7