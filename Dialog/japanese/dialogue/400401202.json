{"id":400401202,"chapter_id":50016,"scene_id":51620,"steps":[{"step":1,"speaker":"ガオ","content":"そこで、ガオ大魔王はもう一度手下をよこして村を襲ったアル——","voice":["vo_event_400401202_2"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":2,"speaker":"ガオ","content":"今度の規模はでかくて、村人たちはまーーったくガオ様の攻撃に抵抗できないアル。","voice":["vo_event_400401202_3"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":3,"speaker":"ガオ","content":"フフンッ、こんな時はどうするアルか……彼らを救うのかナ？それとも逃げるのかナ？","voice":["vo_event_400401202_4"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":4,"speaker":"ガオ","content":"なぁ、勇敢なヒロイン？","voice":["vo_event_400401202_5"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":5,"speaker":"リン","content":"わ……わたし……","voice":["vo_event_400401202_6"],"voice_bank":"vo_event_04012","style":1,"background":4039,"log_type":1},{"step":6,"speaker":"村人","content":"俺たちのことは気にするな。リン、飴を探しに行くのだ。頼んだぞ！","voice":["vo_event_400401202_8"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":7,"speaker":"リン","content":"で、でも……","voice":["vo_event_400401202_9"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":8,"speaker":"村人","content":"早く行け——絶対に勇気の飴を見つけ出せ！あんたが俺たちの希望なんだ！","voice":["vo_event_400401202_10"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":9,"speaker":"村人","content":"頑張って！リン！","voice":["vo_event_400401202_11"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":10,"speaker":"村人","content":"あなたを頼りにしているわ！","voice":["vo_event_400401202_12"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":11,"speaker":"リン","content":"……わ……分かりました！必ず勇気のアメを見つけてきます！","voice":["vo_event_400401202_13"],"voice_bank":"vo_event_04012","style":1,"background":4040,"log_type":1},{"step":12,"speaker":"リン","content":"必ず、みんなを助けに戻ってきます！","voice":["vo_event_400401202_14"],"voice_bank":"vo_event_0