{"id":400401301,"chapter_id":50016,"scene_id":51621,"steps":[{"step":1,"speaker":"ガオ","content":"逃げ出したオマエは謎の洞窟を見つけたアル——洞窟の中からは村人の泣き声、そしてガオ大魔王の叫び声が聞こえてきたネ。","voice":["vo_event_400401301_2"],"voice_bank":"vo_event_04013","style":1,"background":4041,"log_type":1},{"step":2,"speaker":"リン","content":"みんなはどうしていますか？もしかして、大魔王が彼らを——","voice":["vo_event_400401301_3"],"voice_bank":"vo_event_04013","style":1,"background":4041,"log_type":1},{"step":3,"speaker":"ガオ","content":"彼らを救いに行くアルか～なぁ、勇敢なヒロイン？","voice":["vo_event_400401301_4"],"voice_bank":"vo_event_04013","style":1,"background":4041,"log_type":1},{"step":4,"speaker":"リン","content":"わたし……","voice":["vo_event_400401301_5"],"voice_bank":"vo_event_04013","style":1,"background":4041,"log_type":1}]}