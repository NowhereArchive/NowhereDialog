{"id":400704101,"chapter_id":50019,"scene_id":51905,"steps":[{"step":1,"content":"シャキン、シャキン。","style":3,"background":10000,"log_type":1},{"step":2,"content":"シャキン、シャキン。","style":3,"background":10000,"log_type":1},{"step":3,"content":"「それ」は呪いのように纏わりついて離れない。何を試そうとも、この漆黒の霧の中で出口を見つけることはできない。","style":3,"background":2080,"log_type":1},{"step":4,"content":"その音は次第に近づいてくる。少しずつ、霧の中の姿がはっきりとし始める。","style":3,"background":2080,"log_type":1},{"step":5,"content":"シャキン、シャキン。","style":3,"background":2080,"log_type":1},{"step":6,"content":"狭く薄暗い路地の中、隠れる場所は何処にもない。","style":3,"background":2080,"log_type":1},{"step":7,"content":"完全に行き詰まった、そう思われた時——","style":3,"background":2080,"log_type":1},{"step":8,"content":"トントンと。","style":3,"background":2080,"log_type":1},{"step":9,"content":"肩に何かが触れる感覚があった。","style":3,"background":2080,"log_type":1},{"step":10,"speaker":"？？","content":"早く……こっちに来て……","voice":["vo_event_400704101_10"],"voice_bank":"vo_event_07041","style":1,"background":2080,"log_type":1},{"step":11,"options":["！！"],"jump":[12],"style":6,"background":2080,"log_type":1},{"step":12,"content":"あなたは慌てて振り返ったが、目の前には一つの明かりがあるだけだ。","style":3,"background":2080,"log_type":1},{"step":13,"content":"灯火が霧の中から現れ、あなたの目の前で止まった。まるでついてきてほしいようにも思える。","style":3,"background":2080,"log_type":1},{"step":14,"options":["灯火についていく"],"jump":[15],"style":6,"background":2080,"log_type":1},{"step":15,"content":"それが敵か味方かは分からないが、少なくともその存在は霧の中で自由に動けるようだ。","style":3,"background":2080,"log_type":1},{"step":16,"content":"あなたは賭けに出ることにした。それについていけば、ここから脱出できるかもしれない。","style":3,"background":2080,"log_type":1}]}