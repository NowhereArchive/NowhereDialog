{"id":1160501,"name":"トト・取り調べⅠ","type":"trial","scenes":[{"id":1,"name":"トト・取り調べⅠ","code_name":"","dialogue_ids":[1160501]}],"trial":{"trial_id":160501,"stage":"段階1","unlock_time":"2023-03-07 14:00:00","diary1":"流民要塞での作戦終了後、MBCCはコンビクトのトトを収容した。しかし、時や場所を選ばず自由気ままにチャルメラを吹く彼女の行為が、管理局の秩序を著しく乱しているため、あなたは頭を悩ませている。","diary2":"取り調べ中、トトは流民要塞についてよく知っていることをアピールしていた。流民要塞に帰りたいという要求は断ったが、あなたはそこで得た情報の一部を彼女に共有すると約束する。その代わり、トトも管理局のルールを守ることを約束してくれた。\n　これでやっと、連日あなたを困らせていた問題が解決した。","evidence":[{"ID":260313,"Num":1}],"usable_items":[{"ID":260314,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":260501001,"next":null},{"step":2,"course":2,"dialogue_id":260501002,"next":null},{"step":3,"course":2,"dialogue_id":260501003,"next":null},{"step":4,"course":2,"dialogue_id":260501004,"next":null},{"step":5,"course":2,"dialogue_id":260501005,"next":null},{"step":6,"course":2,"dialogue_id":260501006,"next":null},{"step":7,"course":2,"dialogue_id":260501007,"next":null},{"step":8,"course":2,"dialogue_id":260501008,"next":null},{"step":9,"course":16,"dialogue_id":260501009,"next":null},{"step":10,"course":1,"dialogue_id":260501010,"next":null},{"step":11,"course":2,"dialogue_id":260501011,"next":null},{"step":12,"course":2,"dialogue_id":260501012,"next":null},{"step":13,"course":2,"dialogue_id":260501013,"next":null},{"step":14,"course":2,"dialogue_id":260501014,"next":null},{"step":15,"course":2,"dialogue_id":260501015,"next":null},{"step":16,"course":2,"dialogue_id":260501016,"next":null},{"step":17,"course":3,"dialogue_id":260501017,"next":[18,23]},{"step":18,"course":2,"dialogue_id":260501018,"next":null},{"step":19,"course":2,"dialogue_id":260501019,"next":null},{"step":20,"course":3,"dialogue_id":260501020,"next":[21]},{"step":21,"course":2,"dialogue_id":260501021,"next":null},{"step":22,"course":2,"dialogue_id":260501022,"next":[31]},{"step":23,"course":2,"dialogue_id":260501023,"next":null},{"step":24,"cour