{"id":1050801,"name":"ヴァトゥール・取り調べⅠ","type":"Interrogation","scenes":[{"id":1,"name":"ヴァトゥール・取り調べⅠ","code_name":"","dialogue_ids":[1050801]}],"trial":{"trial_id":50801,"stage":"段階1","unlock_time":"2024-12-31 14:00:00","diary1":"砂の海から大きな荷物と古い友人からの手紙が届いた。\n　荷物には特別な芸術品が入っており、手紙には古い友人からの取引手付金と密航者に関する情報が含まれていた。","diary2":"ディヒルを去り、砂の海に戻ったヴァトゥールは、以前の商隊事業を再開し、相変わらず繁盛しているようだ。しかし、これで彼女があなたに情報を送った理由がもっと説明できなくなった——\n　商人は損をする取引をしない。あなたとの取引で彼女は何を得たいのだろうか？あなたは手付金を受け入れ、対応する手配をしたが、心の中にはまだ疑問が残っていた。","evidence":[{"ID":260673,"Num":1},{"ID":260675,"Num":1}],"usable_items":[{"ID":260674,"Num":1},{"ID":260676,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":150801001,"next":null},{"step":2,"course":2,"dialogue_id":150801002,"next":null},{"step":3,"course":2,"dialogue_id":150801003,"next":null},{"step":4,"course":2,"dialogue_id":150801004,"next":null},{"step":5,"course":2,"dialogue_id":150801005,"next":null},{"step":6,"course":2,"dialogue_id":150801006,"next":null},{"step":7,"course":2,"dialogue_id":150801007,"next":null},{"step":8,"course":2,"dialogue_id":150801008,"next":null},{"step":9,"course":2,"dialogue_id":150801009,"next":null},{"step":10,"course":2,"dialogue_id":150801010,"next":null},{"step":11,"course":2,"dialogue_id":150801011,"next":null},{"step":12,"course":2,"dialogue_id":150801012,"next":null},{"step":13,"course":2,"dialogue_id":150801013,"next":null},{"step":14,"course":2,"dialogue_id":150801014,"next":null},{"step":15,"course":2,"dialogue_id":150801015,"next":null},{"step":16,"course":2,"dialogue_id":150801016,"next":null},{"step":17,"course":2,"dialogue_id":150801017,"next":null},{"step":18,"course":2,"dialogue_id":150801018,"next":null},{"step":19,"course":2,"dialogue_id":150801019,"next":null},{"step":20,"course":2,"dialogue_id":150801020,"next":null},{"step":21,"course":2,"dialogue_id":150801021,"next":null},{"step":22,"course":2,"dialogue_id":150801022,"next":null},{"step":23,"co