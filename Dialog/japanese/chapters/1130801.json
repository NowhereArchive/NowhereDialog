{"id":1130801,"name":"エウレカ・取り調べⅠ","type":"Interrogation","scenes":[{"id":1,"name":"エウレカ・取り調べⅠ","code_name":"","dialogue_ids":[1130801]}],"trial":{"trial_id":130801,"stage":"段階1","unlock_time":"2024-01-12 14:00:00","diary1":"最近ニューシティでは、改造された危険な家電が市場に出回り、多くの市民が怪我を負っている。あなたはエウレカの能力や過去の経験が、この事件の解決に役立つかもしれないと考えた。","diary2":"取り調べ中、押収した家電製品に残っていた爆弾が突然爆発し、エウレカは自身の発明品を使ってあなたを守った。その後、彼女はこの事件の黒幕と、かつて自身を騙して闇工房で働かせた人物が同一人物である可能性を指摘した——エウレカのかつての親友、ジェシーだ。","evidence":[{"ID":260487,"Num":1}],"usable_items":[{"ID":260488,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":230801001,"next":null},{"step":2,"course":2,"dialogue_id":230801002,"next":null},{"step":3,"course":2,"dialogue_id":230801003,"next":null},{"step":4,"course":2,"dialogue_id":230801004,"next":null},{"step":5,"course":2,"dialogue_id":230801005,"next":null},{"step":6,"course":2,"dialogue_id":230801006,"next":null},{"step":7,"course":2,"dialogue_id":230801007,"next":null},{"step":8,"course":2,"dialogue_id":230801008,"next":null},{"step":9,"course":2,"dialogue_id":230801009,"next":null},{"step":10,"course":2,"dialogue_id":230801010,"next":null},{"step":11,"course":2,"dialogue_id":230801011,"next":null},{"step":12,"course":3,"dialogue_id":230801012,"next":[13]},{"step":13,"course":2,"dialogue_id":230801013,"next":null},{"step":14,"course":2,"dialogue_id":230801014,"next":null},{"step":15,"course":2,"dialogue_id":230801015,"next":null},{"step":16,"course":2,"dialogue_id":230801016,"next":null},{"step":17,"course":2,"dialogue_id":230801017,"next":null},{"step":18,"course":1,"dialogue_id":230801018,"next":null},{"step":19,"course":2,"dialogue_id":230801019,"next":null},{"step":20,"course":3,"dialogue_id":230801020,"next":[21]},{"step":21,"course":2,"dialogue_id":230801021,"next":null},{"step":22,"course":2,"dialogue_id":230801022,"next":null},{"step":23,"course":2,"dialogue_id":230801023,"next":null},{"step":24,"course":2,"dialogue_id":230