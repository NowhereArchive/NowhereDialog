{"id":1150703,"name":"アイカ・取り調べⅢ","type":"trial","scenes":[{"id":1,"name":"アイカ・取り調べⅢ","code_name":"","dialogue_ids":[1150703]}],"trial":{"trial_id":150703,"stage":"段階3","unlock_time":"2024-03-12 14:00:00","diary1":"チャリティーコンサート当日、あなたは出発前に緊急の任務を受けたため、アイカを一人で出発させるしかなかった。あなたは、コンサートが始まる前に必ず到着すると彼女に約束した。","diary2":"かつて奇跡的なサックスの旋律が、寒く厳しい冬の夜に瀕死の少女を救った。そして今、夢にまで見たステージで彼女の心を再び救ったのは、昔聞いた音色より温かな声だった。\n　その声は彼女に教えた。甘い夢の泡が弾けても構わない。人は勇気さえあれば、最初からやり直せると。","evidence":[{"ID":260543,"Num":1}],"usable_items":[{"ID":260544,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":250703001,"next":null},{"step":2,"course":2,"dialogue_id":250703002,"next":null},{"step":3,"course":2,"dialogue_id":250703003,"next":null},{"step":4,"course":2,"dialogue_id":250703004,"next":null},{"step":5,"course":2,"dialogue_id":250703005,"next":null},{"step":6,"course":2,"dialogue_id":250703006,"next":null},{"step":7,"course":2,"dialogue_id":250703007,"next":null},{"step":8,"course":2,"dialogue_id":250703008,"next":null},{"step":9,"course":2,"dialogue_id":250703009,"next":null},{"step":10,"course":2,"dialogue_id":250703010,"next":null},{"step":11,"course":2,"dialogue_id":250703011,"next":null},{"step":12,"course":2,"dialogue_id":250703012,"next":null},{"step":13,"course":2,"dialogue_id":250703013,"next":null},{"step":14,"course":2,"dialogue_id":250703014,"next":null},{"step":15,"course":2,"dialogue_id":250703015,"next":null},{"step":16,"course":2,"dialogue_id":250703016,"next":null},{"step":17,"course":2,"dialogue_id":250703017,"next":null},{"step":18,"course":2,"dialogue_id":250703018,"next":null},{"step":19,"course":2,"dialogue_id":250703019,"next":null},{"step":20,"course":2,"dialogue_id":250703020,"next":null},{"step":21,"course":2,"dialogue_id":250703021,"next":null},{"step":22,"course":2,"dialogue_id":250703022,"next":null},{"step":23,"course":2,"dialogue_id":250703023,"next":null},{"step":24,"course":2,"dialogue_id":2507030