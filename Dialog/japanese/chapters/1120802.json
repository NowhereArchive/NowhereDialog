{"id":1120802,"name":"クリスティナ・取り調べⅡ","type":"Interrogation","scenes":[{"id":1,"name":"クリスティナ・取り調べⅡ","code_name":"","dialogue_ids":[1120802]}],"trial":{"trial_id":120802,"stage":"段階2","unlock_time":"2023-10-27 14:00:00","diary1":"クリスティナが立てた調査計画により、あなたたちは最初の調査場所——猫の盗難事件が起きた猫カフェへ向かった。","diary2":"調査を重ねた結果、本物のヘンリーは当初の予想とは全く異なっていた。一見単純に見える猫の盗難の裏には、別の何かが隠されているようだ。\n　あなたたちは無事に猫を見つけたが、ヘンリーは未だ行方不明のままだ。しかし同時にあなたたちは、ヘンリーが猫を使って手がかりを残したと推理した。その手がかりとは——モルグ街4番地。","evidence":[{"ID":260443,"Num":1}],"usable_items":[{"ID":260444,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":220802001,"next":null},{"step":2,"course":2,"dialogue_id":220802002,"next":null},{"step":3,"course":2,"dialogue_id":220802003,"next":null},{"step":4,"course":2,"dialogue_id":220802004,"next":null},{"step":5,"course":2,"dialogue_id":220802005,"next":null},{"step":6,"course":2,"dialogue_id":220802006,"next":null},{"step":7,"course":2,"dialogue_id":220802007,"next":null},{"step":8,"course":2,"dialogue_id":220802008,"next":null},{"step":9,"course":2,"dialogue_id":220802009,"next":null},{"step":10,"course":2,"dialogue_id":220802010,"next":null},{"step":11,"course":2,"dialogue_id":220802011,"next":null},{"step":12,"course":2,"dialogue_id":220802012,"next":null},{"step":13,"course":2,"dialogue_id":220802013,"next":null},{"step":14,"course":2,"dialogue_id":220802014,"next":null},{"step":15,"course":2,"dialogue_id":220802015,"next":null},{"step":16,"course":2,"dialogue_id":220802016,"next":null},{"step":17,"course":2,"dialogue_id":220802017,"next":null},{"step":18,"course":2,"dialogue_id":220802018,"next":null},{"step":19,"course":2,"dialogue_id":220802019,"next":null},{"step":20,"course":2,"dialogue_id":220802020,"next":null},{"step":21,"course":2,"dialogue_id":220802021,"next":null},{"step":22,"course":2,"dialogue_id":220802022,"next":null},{"step":23,"course":2,"dialogue_id":220802023,"next":null},{"step":24,"course":2,"dialogue_id