{"id":1130602,"name":"リン・取り調べⅡ","type":"trial","scenes":[{"id":1,"name":"リン・取り調べⅡ","code_name":"","dialogue_ids":[1130602]}],"trial":{"trial_id":130602,"stage":"段階2","unlock_time":"2023-04-11 14:00:00","diary1":"あなたは外出許可を得て、リンとシンジケートへ行くことにした。懐かしい景色が、彼女の心を解きほぐすことに期待して。","diary2":"リンのカメラを通してあなたは普段と違うシンジケートを目にし、彼女の大切な友人、クッキーにも会うことができた。しかしそうした出来事も、彼女にヘルメットを脱がせることはできなかった。\n　そのため、あなたは枷でリンの能力を制御して一時的に普通の少女に戻し、やり直せることを伝えた。リンはようやく勇気のアメを食べ、自分を奮い立たせてみるとあなたに告げた。","evidence":[{"ID":260323,"Num":1}],"usable_items":[{"ID":260324,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":230602001,"next":null},{"step":2,"course":2,"dialogue_id":230602002,"next":null},{"step":3,"course":2,"dialogue_id":230602003,"next":null},{"step":4,"course":2,"dialogue_id":230602004,"next":null},{"step":5,"course":2,"dialogue_id":230602005,"next":null},{"step":6,"course":2,"dialogue_id":230602006,"next":null},{"step":7,"course":2,"dialogue_id":230602007,"next":null},{"step":8,"course":2,"dialogue_id":230602008,"next":null},{"step":9,"course":2,"dialogue_id":230602009,"next":null},{"step":10,"course":2,"dialogue_id":230602010,"next":null},{"step":11,"course":2,"dialogue_id":230602011,"next":null},{"step":12,"course":2,"dialogue_id":230602012,"next":null},{"step":13,"course":3,"dialogue_id":230602013,"next":[14]},{"step":14,"course":2,"dialogue_id":230602014,"next":null},{"step":15,"course":2,"dialogue_id":230602015,"next":null},{"step":16,"course":2,"dialogue_id":230602016,"next":null},{"step":17,"course":2,"dialogue_id":230602017,"next":null},{"step":18,"course":2,"dialogue_id":230602018,"next":null},{"step":19,"course":2,"dialogue_id":230602019,"next":null},{"step":20,"course":2,"dialogue_id":230602020,"next":null},{"step":21,"course":2,"dialogue_id":230602021,"next":null},{"step":22,"course":2,"dialogue_id":230602022,"next":null},{"step":23,"course":2,"dialogue_id":230602023,"next":null},{"step":24,"course":2,"dialog