{"id":1061404,"name":"シーリン・取り調べⅣ","type":"Interrogation","scenes":[{"id":1,"name":"シーリン・取り調べⅣ","code_name":"","dialogue_ids":[1061404]}],"trial":{"trial_id":61404,"stage":"段階4","unlock_time":"2026-08-07 14:00:00","diary1":"シーリンから与えられた権限を使い、中央図書館を訪れたあなたは、書庫の最深部でシーリンと彼女の戦利品たちを見つけ出す。恐らくこの瞬間、あなたも盤上に足を踏み入れたということだろう――","diary2":"「わたしは歴史の中でたくさんの人と出会ってきました。彼らは狭間の中で真実を書き記し、身を粉にしてでも、時代という長河へ身を投じていったのです」\n　「わたしは彼らを観察し、見つめ、見送り、そして最後には、わたし自身も彼らのようになりたいと願うようになりましたわ」\n　「時の流れは雄大で、果てがありません。いつの日かその流れの一部となり、貴方と再び巡り会えますように」","evidence":[{"ID":260961,"Num":1}],"usable_items":[{"ID":260962,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":161404001,"next":null},{"step":2,"course":2,"dialogue_id":161404002,"next":null},{"step":3,"course":2,"dialogue_id":161404003,"next":null},{"step":4,"course":2,"dialogue_id":161404004,"next":null},{"step":5,"course":2,"dialogue_id":161404005,"next":null},{"step":6,"course":2,"dialogue_id":161404006,"next":null},{"step":7,"course":2,"dialogue_id":161404007,"next":null},{"step":8,"course":2,"dialogue_id":161404008,"next":null},{"step":9,"course":2,"dialogue_id":161404009,"next":null},{"step":10,"course":2,"dialogue_id":161404010,"next":null},{"step":11,"course":2,"dialogue_id":161404011,"next":null},{"step":12,"course":2,"dialogue_id":161404012,"next":null},{"step":13,"course":2,"dialogue_id":161404013,"next":null},{"step":14,"course":2,"dialogue_id":161404014,"next":null},{"step":15,"course":2,"dialogue_id":161404015,"next":null},{"step":16,"course":2,"dialogue_id":161404016,"next":null},{"step":17,"course":2,"dialogue_id":161404017,"next":null},{"step":18,"course":2,"dialogue_id":161404018,"next":null},{"step":19,"course":2,"dialogue_id":161404019,"next":null},{"step":20,"course":2,"dialogue_id":161404020,"next":null},{"step":21,"course":2,"dialogue_id":161404021,"next":null},{"step":22,"course":2,"dialogue_id":161404022,"next":null},{"step":23,"course":2,"dialogue_i