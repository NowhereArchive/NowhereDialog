{"id":1031301,"name":"ファルル・取り調べⅠ","type":"Interrogation","scenes":[{"id":1,"name":"ファルル・取り調べⅠ","code_name":"","dialogue_ids":[1031301]}],"trial":{"trial_id":31301,"stage":"段階1","unlock_time":"2026-10-08 14:00:00","diary1":"空心病患者に関する調査は最終段階に入っている。しかし、この事件を巡る世論は未だ拡大を続けており、懸念すべきことに、その矛先の一部は管理局へ向けられ始めていた。","diary2":"ファルルはすでに拘束され、管理局へ連行された。だが、彼女は重要な記憶の一部を失ったと主張しており、現時点では有効な手掛かりを得られていない。彼女は本当に記憶を失ったのだろうか？取り調べの結果がその可能性を示唆しているが、さらなる確認が必要だ。\n　何しろ、白紙を責める者はいないのだから。","evidence":[{"ID":260969,"Num":1},{"ID":260971,"Num":1}],"usable_items":[{"ID":260970,"Num":1},{"ID":260972,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":131301001,"next":null},{"step":2,"course":2,"dialogue_id":131301002,"next":null},{"step":3,"course":2,"dialogue_id":131301003,"next":null},{"step":4,"course":2,"dialogue_id":131301004,"next":null},{"step":5,"course":2,"dialogue_id":131301005,"next":null},{"step":6,"course":2,"dialogue_id":131301006,"next":null},{"step":7,"course":2,"dialogue_id":131301007,"next":null},{"step":8,"course":2,"dialogue_id":131301008,"next":null},{"step":9,"course":2,"dialogue_id":131301009,"next":null},{"step":10,"course":2,"dialogue_id":131301010,"next":null},{"step":11,"course":2,"dialogue_id":131301011,"next":null},{"step":12,"course":2,"dialogue_id":131301012,"next":null},{"step":13,"course":2,"dialogue_id":131301013,"next":null},{"step":14,"course":2,"dialogue_id":131301014,"next":null},{"step":15,"course":2,"dialogue_id":131301015,"next":null},{"step":16,"course":2,"dialogue_id":131301016,"next":null},{"step":17,"course":2,"dialogue_id":131301017,"next":null},{"step":18,"course":2,"dialogue_id":131301018,"next":null},{"step":19,"course":2,"dialogue_id":131301019,"next":null},{"step":20,"course":2,"dialogue_id":131301020,"next":null},{"step":21,"course":2,"dialogue_id":131301021,"next":null},{"step":22,"course":2,"dialogue_id":131301022,"next":null},{"step":23,"course":2,"dialogue_id":1313