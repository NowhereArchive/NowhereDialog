{"id":1160701,"name":"カシア・取り調べⅠ","type":"trial","scenes":[{"id":1,"name":"カシア・取り調べⅠ","code_name":"","dialogue_ids":[1160701]}],"trial":{"trial_id":160701,"stage":"段階1","unlock_time":"2023-11-28 14:00:00","diary1":"突然流行り出した人名香水から狂瞳病の成分が検出された。そこから、未解決のニューシティ少女連続失踪事件と、その香水を作った謎の調香師が結びつく。あなたは調香師が営む香水サロンに潜入し、調香師の正体と目的を探ることにした。","diary2":"香水サロンで、あなたは被害者の父親だと自称する調査記者のルーカスと出会う。更に、調香師に枷をかけ、次の被害者が出ないようにした。\n　ルーカスから託された娘の写真は単なる手がかりではなく、彼の切実な願いでもある。あなたは、それを持って正式に調香師の取り調べを行う。","evidence":[{"ID":260455,"Num":1},{"ID":260457,"Num":1}],"usable_items":[{"ID":260456,"Num":1},{"ID":260458,"Num":1}],"reward":[{"ID":240001,"Num":50}],"obey_award":100,"qte_failure":0,"failure_step":0,"graph":[{"step":1,"course":2,"dialogue_id":260701001,"next":null},{"step":2,"course":6,"dialogue_id":1,"next":null},{"step":3,"course":2,"dialogue_id":260701003,"next":null},{"step":4,"course":2,"dialogue_id":260701004,"next":null},{"step":5,"course":2,"dialogue_id":260701005,"next":null},{"step":6,"course":2,"dialogue_id":260701006,"next":null},{"step":7,"course":2,"dialogue_id":260701007,"next":null},{"step":8,"course":2,"dialogue_id":260701008,"next":null},{"step":9,"course":2,"dialogue_id":260701009,"next":null},{"step":10,"course":2,"dialogue_id":260701010,"next":null},{"step":11,"course":2,"dialogue_id":260701011,"next":null},{"step":12,"course":2,"dialogue_id":260701012,"next":null},{"step":13,"course":2,"dialogue_id":260701013,"next":null},{"step":14,"course":2,"dialogue_id":260701014,"next":null},{"step":15,"course":2,"dialogue_id":260701015,"next":null},{"step":16,"course":2,"dialogue_id":260701016,"next":null},{"step":17,"course":2,"dialogue_id":260701017,"next":null},{"step":18,"course":2,"dialogue_id":260701018,"next":null},{"step":19,"course":6,"dialogue_id":2,"next":null},{"step":20,"course":2,"dialogue_id":260701020,"next":null},{"step":21,"course":2,"dialogue_id":260701021,"next":null},{"step":22,"course":2,"dialogue_id":260701022,"next":null},{"step":23,"course":2,"dialogue_id":260701023,"