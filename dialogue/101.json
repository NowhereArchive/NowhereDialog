{"id":101,"chapter_id":0,"scene_id":1,"steps":[{"step":2,"content":"...Can you only remember these? Fate is so cruel...","voice":["vo_cgplot_101001"],"voice_bank":"vo_cgplot_00","style":3,"background":10000,"log_type":1},{"step":3,"content":"But, it doesn't matter... As long as you still remember who you are, you won't lose everything...","voice":["vo_cgplot_101002"],"voice_bank":"vo_cgplot_00","style":3,"background":10000,"log_type":1},{"step":4,"content":"Come. Come back to me... Your battle has begun.","voice":["vo_cgplot_101003"],"voice_bank":"vo_cgplot_00","style":3,"background":10000,"log_type":1},{"step":5,"content":"...I will ...wait for you...","voice":["vo_cgplot_101004"],"voice_bank":"vo_cgplot_00","style":3,"background":10000,"log_type":1}]}