{"id":114,"chapter_id":0,"scene_id":3,"steps":[{"step":2,"content":"Whenever they unleash that stranger power, the shackles in your hand will throb, like some kind of frantic power is burning.","style":3,"background":10000,"log_type":1},{"step":3,"content":"\r\nYour vision gradually blurs, and your consciousness returns to that dream again.\nIn the dream, \"you\" are whispering to someone...","style":3,"background":54,"log_type":1},{"step":4,"content":"Come here, <color=#fb9259>Hecate</color>. This isn't over.","voice":["vo_cgplot_108003","vo_cgplot_108003f"],"voice_bank":"vo_cgplot_00","style":2,"background":54,"log_type":1},{"step":5,"content":"We agreed...","voice":["vo_cgplot_108004","vo_cgplot_108004f"],"voice_bank":"vo_cgplot_00","style":2,"background":54,"log_type":1},{"step":6,"content":"After a brief silence, someone reaches out to you. That person wants to move closer to you with intense emotions.","style":3,"background":55,"log_type":1},{"step":7,"content":"You try to take that hand, but the fractured dream pushes you away...","style":3,"background":55,"log_type":1},{"step":9,"speaker":"S-019","content":"It's over.","voice":["vo_cgplot_108006"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":10,"speaker":"S-019","content":"Chief, are you hurt?","voice":["vo_cgplot_108007"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":11,"content":"You shake your head, but your mind is still very confused. You don't know if those images happened in reality. Could they be the memories you lost?","style":3,"background":10000,"log_type":1},{"step":12,"speaker":"Choice","content":"Have we met before?","options":["Have we met before?"],"jump":[13],"style":6,"background":10000,"log_type":1},{"step":13,"speaker":"S-019","content":"No.","voice":["vo_cgplot_108010"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":14,"speaker":"Choice","content":"But I know your name.","options":["But I know your name."],"jump":[15],"style":6,"background":10000,"log_type":1},{"step":15,"speaker":"${PlayerName}","content":"Your name isn't S-019... It's <color=#fb9259>Hecate</color>.","style":2,"background":10000,"log_type":1},{"step":16,"speaker":"S-019","content":"...I don't need that name anymore.","voice":["vo_cgplot_108013"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":17,"speaker":"S-019","content":"But if that's what you want, then call me by that name, Chief.","voice":["vo_cgplot_108014"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1},{"step":18,"speaker":"Hecate","content":"It's time to go. Adjutant Nightingale is waiting for you.","voice":["vo_cgplot_108015"],"voice_bank":"vo_cgplot_00","style":1,"background":10000,"log_type":1}]}