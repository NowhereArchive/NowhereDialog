{"id":401540001,"chapter_id":50045,"scene_id":45002,"steps":[{"step":1,"speaker":"Bard","content":"~~~~","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":2,"speaker":"Bard","content":"\"In your fineries, a night so grand.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":3,"speaker":"Bard","content":"\"A mystic theater here to stand.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":4,"speaker":"Bard","content":"\"Is it the snow or the moonlight dance?\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":5,"speaker":"Bard","content":"\"I see your despair form a band.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":6,"speaker":"Bard","content":"\"Symphony whispers behind the door.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":7,"speaker":"Bard","content":"\"Is it release you're looking for?\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":8,"speaker":"Bard","content":"\"Fear no more, fear no more.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":9,"speaker":"Bard","content":"\"Golden tassels sweep the floor.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":10,"speaker":"Bard","content":"\"Fear no more, fear no more.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":11,"speaker":"Bard","content":"\"Curtain's drawn for the first score.\"","style":1,"background":1069,"is_centered":true,"log_type":1}]}