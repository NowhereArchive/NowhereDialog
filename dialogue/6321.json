ntent":"<color=#dg1f1f><size=44>You can't go anywhere!</size></color>","voice":["vo_cgplot_6221011"],"voice_bank":"vo_cgplot_06","style":1,"background":10000,"log_type":1},{"step":12,"speaker":"Zoya","content":"Get off!","voice":["vo_cgplot_6221012"],"voice_bank":"vo_cgplot_06","style":1,"background":10000,"log_type":1}]}