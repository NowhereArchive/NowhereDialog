{"id":401540004,"chapter_id":50045,"scene_id":45015,"steps":[{"step":1,"speaker":"Echo","content":"~~~~","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":2,"speaker":"Echo","content":"\"Our ragged tent leaves no trace.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":3,"speaker":"Echo","content":"Sally","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":4,"speaker":"Echo","content":"\"Ruby wine goes with that steak.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":5,"speaker":"Echo","content":"\"The blonde lady hears our pray.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":6,"speaker":"Echo","content":"\"She might be poison or a snake.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":7,"speaker":"Echo","content":"\"She has our hearts anyway.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":8,"speaker":"Echo","content":"\"Brand new cloak and crown of gold.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":9,"speaker":"Echo","content":"\"She crowned our King as she spoke.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":10,"speaker":"Echo","content":"\"Trust her folks. Trust her folks.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":11,"speaker":"Echo","content":"\"But what is our quid pro quo?\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":12,"speaker":"Echo","content":"\"Trust her folks. Trust her, folks?\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":13,"speaker":"Echo","content":"\"Fortuna is doomed down the road.\"","style":1,"background":2173,"is_centered":true,"log_type":1}]}