{"id":401540002,"chapter_id":50045,"scene_id":45007,"steps":[{"step":1,"speaker":"Bard","content":"~~~~","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":2,"speaker":"Bard","content":"\"Shabby cloak and a paper crown\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":3,"speaker":"Bard","content":"\"Flashy ribbon is a hand-me-down.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":4,"speaker":"Bard","content":"\"Place is ragged yet so renowned.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":5,"speaker":"Bard","content":"\"Funny the King whose face meltdown.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":6,"speaker":"Bard","content":"\"We have no office only a box.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":7,"speaker":"Bard","content":"\"Five nickels and that's the stock!\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":8,"speaker":"Bard","content":"\"That's a lot, that's a lot.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":9,"speaker":"Bard","content":"\"Five of us with bread so hot.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":10,"speaker":"Bard","content":"\"That's a lot, that's a lot.\"","style":1,"background":1069,"is_centered":true,"log_type":1},{"step":11,"speaker":"Bard","content":"\"Sing some tunes and dance in flock.\"","style":1,"background":1069,"is_centered":true,"log_type":1}]}