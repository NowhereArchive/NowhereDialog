{"id":401540005,"chapter_id":50045,"scene_id":45017,"steps":[{"step":1,"speaker":"Echo","content":"~~~~","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":2,"speaker":"Echo","content":"\"Grand palace stands to fall.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":3,"speaker":"Echo","content":"\"The future's bleak for us all.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":4,"speaker":"Echo","content":"\"I want steaks soft and raw.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":5,"speaker":"Echo","content":"\"Not some bread like drywall.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":6,"speaker":"Echo","content":"\"I need my crown gold and tall.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":7,"speaker":"Echo","content":"\"Nothing else will fit my skull.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":8,"speaker":"Echo","content":"\"Please dear Lady help us out.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":9,"speaker":"Echo","content":"\"Fortuna needs her savior now.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":10,"speaker":"Echo","content":"\"The blonde lady takes her part.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":11,"speaker":"Echo","content":"\"She has your interest at her heart.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":12,"speaker":"Echo","content":"\"Fortuna, Fortuna.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":13,"speaker":"Echo","content":"\"Be tempted and evil's not so far.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":14,"speaker":"Echo","content":"\"Fortuna, Fortuna.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":15,"speaker":"Echo","content":"\"Set a flame, get a new start.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":16,"speaker":"Echo","content":"~~~~","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":17,"speaker":"Echo","content":"\"Blonde lady takes the crown.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":18,"speaker":"Echo","content":"\"In the box she settles down.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":19,"speaker":"Echo","content":"\"A perfect way to end the show.\"","style":1,"background":2173,"is_centered":true,"log_type":1},{"step":20,"speaker":"Echo","content":"\"Welcome to Fortuna. I'll be around.\"","style":1,"background":2173,"is_centered":true,"log_type":1}]}